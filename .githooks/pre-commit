#!/bin/sh

set -e

do_not_edit_files=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -n "$do_not_edit_files" ]; then
	printf '%s\n' "$do_not_edit_files" | ./scripts/check-do-not-edit.sh
fi

js_staged_files=$(git diff --cached --name-only --diff-filter=ACMR -- 'package/thingino-webui/files/www/a/*.js')

if [ -n "$js_staged_files" ]; then
	echo "pre-commit: formatting staged web UI JavaScript files with Prettier"

	echo "$js_staged_files" | while IFS= read -r file; do
		[ -n "$file" ] || continue
		npx --yes prettier --write -- "$file"
		git add -- "$file"
	done
fi

defconfig_staged_files=$(git diff --cached --name-only --diff-filter=ACMR -- 'configs/cameras/*defconfig*' 'configs/cameras-exp/*defconfig*')

if [ -n "$defconfig_staged_files" ]; then
	echo "pre-commit: sorting staged camera defconfig files"

	echo "$defconfig_staged_files" | while IFS= read -r file; do
		[ -n "$file" ] || continue
		./scripts/sort_defconfig.py "$file"
		git add -- "$file"
	done
fi

shell_staged_files=$(
	git diff --cached --name-only --diff-filter=ACMR | while IFS= read -r file; do
		[ -f "$file" ] || continue

		# Never format generated/vendored patch files
		case "$file" in
			*.patch) continue ;;
		esac

		if git show ":$file" 2>/dev/null | rg -q '^#!/bin/sh'; then
			printf '%s\n' "$file"
		fi
	done
)

if [ -n "$shell_staged_files" ]; then
	if ! command -v shfmt >/dev/null 2>&1; then
		echo "pre-commit: shfmt is required to format /bin/sh scripts"
		echo "Install shfmt, then commit again"
		exit 1
	fi

	echo "pre-commit: formatting staged /bin/sh scripts with shfmt (tabs indentation)"

	echo "$shell_staged_files" | while IFS= read -r file; do
		[ -n "$file" ] || continue
		shfmt -w -i 0 -ci "$file"
		git add -- "$file"
	done
fi

# --- shellcheck -----------------------------------------------------

shellcheck_staged_files=$(
	git diff --cached --name-only --diff-filter=ACMR | while IFS= read -r file; do
		[ -f "$file" ] || continue

		if git show ":$file" 2>/dev/null | head -1 | grep -qE '^#!.*/(ba)?sh'; then
			printf '%s\n' "$file"
		fi
	done
)

if [ -n "$shellcheck_staged_files" ]; then
	if ! command -v shellcheck >/dev/null 2>&1; then
		echo "pre-commit: shellcheck is required to lint shell scripts"
		echo "Install shellcheck (apt install shellcheck), then commit again"
		exit 1
	fi

	echo "pre-commit: linting staged shell scripts with shellcheck"

	# shellcheck disable=SC2086
	# $shellcheck_staged_files is newline-separated; word-splitting
	# is required to pass each filename as a separate argument.
	shellcheck -x $shellcheck_staged_files || {
		echo
		echo "pre-commit: shellcheck found warnings. Fix them and commit again."
		echo "Use '# shellcheck disable=SCxxxx' with a comment for intentional suppressions."
		exit 1
	}
fi
