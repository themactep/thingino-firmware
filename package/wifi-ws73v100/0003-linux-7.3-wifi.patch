 }
 
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 1, 0))
+static void pm_board_remove(struct platform_device *pdev)
+{
+    (void)pdev;
+    pm_board_gpio_deinit();
+}
+#else
 static osal_s32 pm_board_remove(struct platform_device *pdev)
 {
     pm_board_gpio_deinit();
 
     return BOARD_SUCC;
 }
+#endif
 
