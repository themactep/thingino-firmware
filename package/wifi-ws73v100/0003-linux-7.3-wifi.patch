 {
 #if defined(LINUX_VERSION_CODE) && (LINUX_VERSION_CODE < KERNEL_VERSION(5, 10, 0))
     set_fs(fs);
@@ -33,7 +39,7 @@
 #ifdef CONFIG_SET_FS
     set_fs(fs);
 #else
-    force_uaccess_end(fs);
+    (void)fs;
 #endif
 #endif
 }
@@ -48,7 +54,7 @@
 #ifdef CONFIG_SET_FS
     os_set_fs(KERNEL_DS);
 #else
-    force_uaccess_begin();
