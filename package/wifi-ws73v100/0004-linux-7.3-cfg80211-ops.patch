+    return uapi_cfg80211_add_station(wiphy, wdev->netdev, mac, sta_parms);
+}
+
+OAL_STATIC osal_s32 uapi_cfg80211_del_station_7_3(struct wiphy *wiphy,
+    struct wireless_dev *wdev, struct station_del_parameters *params)
+{
