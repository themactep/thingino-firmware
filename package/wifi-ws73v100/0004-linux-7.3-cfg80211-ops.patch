+}
+
+OAL_STATIC osal_s32 uapi_cfg80211_remain_on_channel_7_3(struct wiphy *wiphy,
+    struct wireless_dev *wdev, struct ieee80211_channel *chan, unsigned int duration,
+    u64 cookie, const u8 *rx_addr)
+{
+    u64 c = cookie;
+    (void)rx_addr;
+    return uapi_cfg80211_remain_on_channel(wiphy, wdev, chan, duration, &c);
+}
+
+OAL_STATIC osal_s32 uapi_cfg80211_mgmt_tx_7_3(struct wiphy *wiphy,
+    struct wireless_dev *wdev, struct cfg80211_mgmt_tx_params *params, u64 cookie)
+{
+    u64 c = cookie;
+    return uapi_cfg80211_mgmt_tx(wiphy, wdev, params, &c);
+}
+
+OAL_STATIC osal_s32 uapi_cfg80211_set_bitrate_mask_7_3(struct wiphy *wiphy,
+    struct net_device *dev, unsigned int link_id, const u8 *peer,
+    const struct cfg80211_bitrate_mask *mask)
