+}
+
+OAL_STATIC osal_s32 uapi_cfg80211_change_station_7_3(struct wiphy *wiphy,
+    struct wireless_dev *wdev, const u8 *mac, struct station_parameters *sta_parms)
+{
+    return uapi_cfg80211_change_station(wiphy, wdev->netdev, mac, sta_parms);
+}
+
+OAL_STATIC osal_s32 uapi_cfg80211_get_station_7_3(struct wiphy *wiphy,
+    struct wireless_dev *wdev, const u8 *mac, struct station_info *sta_info)
+{
