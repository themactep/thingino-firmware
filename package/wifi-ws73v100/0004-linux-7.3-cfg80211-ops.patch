+#else
+    (void)link_id;
+    return uapi_cfg80211_set_bitrate_mask_etc(wiphy, dev, peer, mask);
+#endif
+}
+#endif
+
 OAL_STATIC oal_cfg80211_ops_stru  g_wal_cfg80211_ops = {
