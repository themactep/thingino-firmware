+    return uapi_cfg80211_set_wiphy_params(wiphy, changed);
+}
+
+OAL_STATIC osal_s32 uapi_cfg80211_change_beacon_7_3(struct wiphy *wiphy,
+    struct net_device *netdev, struct cfg80211_ap_update *info)
+{
