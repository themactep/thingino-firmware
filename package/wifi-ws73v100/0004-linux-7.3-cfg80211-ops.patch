+OAL_STATIC osal_s32 uapi_cfg80211_add_key_7_3(struct wiphy *wiphy, struct wireless_dev *wdev,
+    int link_id, u8 key_index, bool pairwise, const u8 *mac_addr, struct key_params *params)
+{
+#ifdef CONTROLLER_CUSTOMIZATION
+    return uapi_cfg80211_add_key(wiphy, wdev->netdev, link_id, key_index, pairwise, mac_addr, params);
+#else
+    (void)link_id;
+    return uapi_cfg80211_add_key(wiphy, wdev->netdev, key_index, pairwise, mac_addr, params);
+#endif
+}
+
+OAL_STATIC osal_s32 uapi_cfg80211_get_key_7_3(struct wiphy *wiphy, struct wireless_dev *wdev,
+    int link_id, u8 key_index, bool pairwise, const u8 *mac_addr, void *cookie,
+    void (*callback)(void *cookie, struct key_params *params))
+{
+#ifdef CONTROLLER_CUSTOMIZATION
+    return uapi_cfg80211_get_key(wiphy, wdev->netdev, link_id, key_index, pairwise, mac_addr, cookie, callback);
+#else
+    (void)link_id;
+    return uapi_cfg80211_get_key(wiphy, wdev->netdev, key_index, pairwise, mac_addr, cookie, callback);
+#endif
+}
+
+OAL_STATIC osal_s32 uapi_cfg80211_del_key_7_3(struct wiphy *wiphy, struct wireless_dev *wdev,
+    int link_id, u8 key_index, bool pairwise, const u8 *mac_addr)
+{
+#ifdef CONTROLLER_CUSTOMIZATION
+    return uapi_cfg80211_remove_key(wiphy, wdev->netdev, link_id, key_index, pairwise, mac_addr);
+#else
+    (void)link_id;
+    return uapi_cfg80211_remove_key(wiphy, wdev->netdev, key_index, pairwise, mac_addr);
+#endif
+}
+
+OAL_STATIC osal_s32 uapi_cfg80211_set_default_key_7_3(struct wiphy *wiphy,
+    struct net_device *netdev, int link_id, u8 key_index, bool unicast, bool multicast)
+{
+#ifdef CONTROLLER_CUSTOMIZATION
+    return uapi_cfg80211_set_default_key(wiphy, netdev, link_id, key_index, unicast, multicast);
+#else
+    (void)link_id;
+    return uapi_cfg80211_set_default_key(wiphy, netdev, key_index, unicast, multicast);
+#endif
+}
+
+OAL_STATIC osal_s32 uapi_cfg80211_set_default_mgmt_key_7_3(struct wiphy *wiphy,
+    struct wireless_dev *wdev, int link_id, u8 key_index)
