+#endif
     .cancel_remain_on_channel = uapi_cfg80211_cancel_remain_on_channel,
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(7, 3, 0))
+    .mgmt_tx                  = uapi_cfg80211_mgmt_tx_7_3,
+#else
