+#else
+    (void)link_id;
+    return uapi_cfg80211_set_default_mgmt_key_etc(wiphy, wdev->netdev, key_index);
+#endif
+}
+
+OAL_STATIC osal_s32 uapi_cfg80211_set_wiphy_params_7_3(struct wiphy *wiphy, int radio_idx, u32 changed)
+{
