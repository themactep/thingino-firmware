FAAC 3.0 renames the encoder configuration fields and changes bit_rate
from a per-channel rate to a whole-stream rate. The old names are gone
with no compatibility shim.

Map the fields to the ABI 3 names, disable TNS through the flag word,
and scale the configured bitrate by the channel count so the encoder
keeps producing the same total stream rate as before.

--- a/src/audio/codec/AACEncoder.cpp
+++ b/src/audio/codec/AACEncoder.cpp
@@ -27,17 +27,17 @@ int AACEncoder::open() {
   }
 
   params.sample_rate = sampleRate;
-  params.num_channels = numChn;
-  params.mpeg_version = FAAC_MPEG4;
-  params.object_type = FAAC_OBJ_LOW;
+  params.channels = numChn;
+  params.object_type = FAAC_OBJ_LC;
   params.input_format = FAAC_INPUT_16BIT;
-  params.output_format = FAAC_STREAM_RAW;
+  params.stream_format = FAAC_STREAM_RAW;
   // Raw AUs, no ADTS (RFC 3640 mode=AAC-hbr); ASC goes out of band: RTSP
   // config=, MP4 esds, WS header.  Backchannel playback still parses ADTS.
-  params.bit_rate = cfg->audio.mic_bitrate_kbps() * 1000;
+  // FAAC 3 bit_rate is the whole-stream rate; the config value was per channel.
+  params.bit_rate = cfg->audio.mic_bitrate_kbps() * 1000 * numChn;
   params.bandwidth = 0;
-  params.use_tns = false;
-  params.joint_mode = FAAC_JOINT_NONE;
+  params.flags &= ~FAAC_FLAG_TNS;
+  params.stereo_mode = FAAC_STEREO_LR;
 
   st = faac_encoder_open(&params, &handle);
   if (st != FAAC_OK) {
