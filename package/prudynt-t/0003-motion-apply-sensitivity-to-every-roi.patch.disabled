@@ -691,10 +691,15 @@ void handle_motion(JsonValue *obj, std::string &out, bool &sep) {
   add_key(out, sep, "motion", "{");
   bool s2 = false;
   bool wrote = false;
-  auto add_int = [&](const char *key, const char *path) {
+  auto add_int = [&](const char *key, const char *path,
+                     bool restart_video_on_change = false) {
     if (JsonValue *v = obj_get(obj, key)) {
