		stream0.osd.privacy.stroke_size \
		stream0.osd.privacy.text; do
		agent_persist_if_present "$source_file" "$field"
	done
	agent_persist_if_present "$source_file" stream1.enabled
	agent_persist_if_present "$source_file" stream1.audio_enabled
	agent_persist_if_present "$source_file" stream1.bitrate
	agent_persist_if_present "$source_file" stream1.width
