		daynight/enabled)
			value=$(agent_setting_value "$body_file" enabled) || return 1
			agent_validate_bool "$value" || return 1
			if agent_has_daynightd; then
				if [ "$value" = true ]; then
					agent_daynightd_set_mode auto || return 1
				else
					mode=$(agent_daynight_running_mode)
					case "$mode" in
						day | night) ;;
						*) mode=day ;;
					esac
					agent_daynightd_set_mode "$mode" || return 1
				fi
			else
				agent_apply_payload "{\"daynight\":{\"enabled\":$value}}" || return 1
				agent_persist_value daynight.enabled "$value"
			fi
			agent_print_setting_update "$path" enabled "$value"
			;;
		daynight/force-mode)
			value=$(agent_setting_value "$body_file" force_mode) || return 1
			case "$value" in
				"day" | "night") ;;
