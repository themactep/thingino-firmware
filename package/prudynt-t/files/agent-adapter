	agent_persist_if_present "$source_file" motion.send2telegram
	agent_persist_if_present "$source_file" motion.send2webhook
	if agent_has_daynightd; then
		value=$(agent_json_config_value "$source_file" daynight.enabled)
		case "$value" in
			true) agent_daynightd_set_mode auto || true ;;
			false)
				force=$(agent_json_config_value "$source_file" daynight.force_mode | tr -d '"')
				case "$force" in
					day | night) agent_daynightd_set_mode "$force" || true ;;
				esac
				;;
		esac
	else
		agent_persist_if_present "$source_file" daynight.enabled
		agent_persist_if_present "$source_file" daynight.force_mode
	fi
	agent_persist_if_present "$source_file" recorder.autostart
	agent_persist_if_present "$source_file" recorder.channel
	agent_persist_if_present "$source_file" recorder.device_path
	agent_persist_if_present "$source_file" recorder.duration
	agent_persist_if_present "$source_file" recorder.filename
	agent_persist_if_present "$source_file" recorder.mount
