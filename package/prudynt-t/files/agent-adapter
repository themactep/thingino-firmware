agent_heartbeat_brightness() {
	awk 'NR == 1 { print $1 }' /run/prudynt/daynight_brightness 2>/dev/null | tr -d '\n'
}

agent_heartbeat_hw_state() {
	cmd=${1%% *}
	command -v "$cmd" >/dev/null 2>&1 || {
		printf 'null'
		return 0
	}
	value=$(eval "$1 read" 2>/dev/null)
	case "$value" in
		'' | *[!0-9]*) printf 'null' ;;
		*) printf '%s' "$value" ;;
	esac
}

agent_heartbeat_wg_status() {
	if command -v wg >/dev/null 2>&1; then
		case "$(wg show wg0 2>/dev/null)" in
			*"latest handshake"*) printf '1' ;;
			*) printf '0' ;;
		esac
	else
		printf '0'
	fi
}

