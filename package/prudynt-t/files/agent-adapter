		stream0.osd.uptime.stroke_color \
		stream0.osd.usertext.enabled \
		stream0.osd.usertext.fill_color \
		stream0.osd.usertext.format \
		stream0.osd.usertext.position \
		stream0.osd.usertext.rotation \
		stream0.osd.usertext.stroke_color \
