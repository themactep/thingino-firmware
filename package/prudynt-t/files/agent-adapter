agent_get_events() {
	retry_ms=3000
	printf 'retry: %s\n\n' "$retry_ms" || exit 0
	agent_sse_emit hello "$(agent_sse_payload hello '"backend":"prudynt","stream":"agent"')" || exit 0

	last_motion_active=$(agent_motion_active)
	last_streamer_running=$(agent_streamer_running)
	last_health_status=$(agent_health_status)
	last_firmware_action=$(agent_firmware_pending_action)
	last_stream0_recording=$(agent_stream_recording_active 0)
	last_stream1_recording=$(agent_stream_recording_active 1)
	last_stream0_healthy=$(agent_stream_healthy 0)
	last_stream1_healthy=$(agent_stream_healthy 1)
	last_active_file=$(agent_recording_active_file)
	if [ -n "$last_active_file" ]; then
		last_recording_active=true
		last_recording_channel=$(agent_recording_active_channel "$last_active_file")
		last_recording_duration=$(agent_recording_active_value "$last_active_file" dur)
		last_recording_path=$(agent_recording_active_value "$last_active_file" path)
	else
		last_recording_active=false
		last_recording_channel=
		last_recording_duration=
		last_recording_path=
	fi
	keepalive_counter=0

	while true; do
		sleep 2 || exit 0
		keepalive_counter=$((keepalive_counter + 1))
		changed_paths=

		current_motion_active=$(agent_motion_active)
		if [ "$current_motion_active" != "$last_motion_active" ]; then
			changed_paths=$(agent_event_append_path "$changed_paths" motion.active)
			if [ "$current_motion_active" = true ]; then
				agent_sse_emit motion.started "$(agent_sse_payload motion.started '"active":true')" || exit 0
			else
				agent_sse_emit motion.stopped "$(agent_sse_payload motion.stopped '"active":false')" || exit 0
			fi
		fi

		current_streamer_running=$(agent_streamer_running)
		if [ "$current_streamer_running" != "$last_streamer_running" ]; then
			changed_paths=$(agent_event_append_path "$changed_paths" system.streamer_running)
			changed_paths=$(agent_event_append_path "$changed_paths" services.streaming.running)
			changed_paths=$(agent_event_append_path "$changed_paths" services.streaming.healthy)
			if [ "$last_streamer_running" != true ] && [ "$current_streamer_running" = true ]; then
				agent_sse_emit streamer.restarted "$(agent_sse_payload streamer.restarted '"service":"streaming"')" || exit 0
			fi
		fi

		current_stream0_recording=$(agent_stream_recording_active 0)
		if [ "$current_stream0_recording" != "$last_stream0_recording" ]; then
			changed_paths=$(agent_event_append_path "$changed_paths" streams.0.recording_active)
		fi
		current_stream1_recording=$(agent_stream_recording_active 1)
		if [ "$current_stream1_recording" != "$last_stream1_recording" ]; then
			changed_paths=$(agent_event_append_path "$changed_paths" streams.1.recording_active)
		fi

		current_stream0_healthy=$(agent_stream_healthy 0)
		if [ "$current_stream0_healthy" != "$last_stream0_healthy" ]; then
			changed_paths=$(agent_event_append_path "$changed_paths" streams.0.healthy)
		fi
		current_stream1_healthy=$(agent_stream_healthy 1)
		if [ "$current_stream1_healthy" != "$last_stream1_healthy" ]; then
			changed_paths=$(agent_event_append_path "$changed_paths" streams.1.healthy)
		fi

		current_active_file=$(agent_recording_active_file)
		if [ -n "$current_active_file" ]; then
			current_recording_active=true
			current_recording_channel=$(agent_recording_active_channel "$current_active_file")
			current_recording_duration=$(agent_recording_active_value "$current_active_file" dur)
			current_recording_path=$(agent_recording_active_value "$current_active_file" path)
		else
			current_recording_active=false
			current_recording_channel=
			current_recording_duration=
			current_recording_path=
		fi

		if [ "$current_recording_active" != "$last_recording_active" ]; then
			changed_paths=$(agent_event_append_path "$changed_paths" recording.active)
			changed_paths=$(agent_event_append_path "$changed_paths" recording.current_channel)
			changed_paths=$(agent_event_append_path "$changed_paths" recording.current_duration_seconds)
			changed_paths=$(agent_event_append_path "$changed_paths" recording.current_path)
			if [ "$last_recording_active" = true ] && [ "$current_recording_active" != true ]; then
				record_fields=$(printf '"stream_id":%s,"path":%s,"duration_seconds":%s' \
					"$(agent_json_value_or "$last_recording_channel" null)" \
					"$(agent_json_string_or_null "$last_recording_path")" \
					"$(agent_json_value_or "$last_recording_duration" null)")
				agent_sse_emit record.completed "$(agent_sse_payload record.completed "$record_fields")" || exit 0
			fi
		else
			if [ "$current_recording_channel" != "$last_recording_channel" ]; then
				changed_paths=$(agent_event_append_path "$changed_paths" recording.current_channel)
			fi
			if [ "$current_recording_duration" != "$last_recording_duration" ]; then
				changed_paths=$(agent_event_append_path "$changed_paths" recording.current_duration_seconds)
			fi
			if [ "$current_recording_path" != "$last_recording_path" ]; then
				changed_paths=$(agent_event_append_path "$changed_paths" recording.current_path)
			fi
		fi

		current_firmware_action=$(agent_firmware_pending_action)
		if [ "$current_firmware_action" != "$last_firmware_action" ]; then
			changed_paths=$(agent_event_append_path "$changed_paths" firmware.pending_action)
			changed_paths=$(agent_event_append_path "$changed_paths" firmware.pending_full)
			changed_paths=$(agent_event_append_path "$changed_paths" firmware.pending_partial)
			case "$current_firmware_action" in
				none) firmware_phase=idle ;;
				*) firmware_phase=pending ;;
			esac
			firmware_fields=$(printf '"action":%s,"phase":%s' \
				"$(agent_json_string "$current_firmware_action")" \
				"$(agent_json_string "$firmware_phase")")
			agent_sse_emit firmware.progress "$(agent_sse_payload firmware.progress "$firmware_fields")" || exit 0
		fi

		current_health_status=$(agent_health_status)
		if [ "$current_health_status" != "$last_health_status" ] && [ "$current_health_status" != ok ]; then
			health_fields=$(printf '"status":%s,"network_online":%s,"streamer_running":%s' \
				"$(agent_json_string "$current_health_status")" \
				"$(agent_json_bool "$(agent_network_online)")" \
				"$(agent_json_bool "$current_streamer_running")")
			agent_sse_emit health.warning "$(agent_sse_payload health.warning "$health_fields")" || exit 0
		fi

		if [ -n "$changed_paths" ]; then
			agent_sse_emit state.changed "$(agent_sse_payload state.changed "\"paths\":[${changed_paths}]")" || exit 0
			keepalive_counter=0
		elif [ "$keepalive_counter" -ge 3 ]; then
			agent_sse_emit keepalive "$(agent_sse_payload keepalive '')" || exit 0
			# Best-effort sensor sample from daynight runtime files when present.
			daynight_mode=$(agent_daynight_running_mode 2>/dev/null || true)
			total_gain=
			[ -f /run/prudynt/total_gain ] && total_gain=$(awk 'NR==1{print $1}' /run/prudynt/total_gain 2>/dev/null)
			ae_luma=
			[ -f /run/prudynt/ae_luma ] && ae_luma=$(awk 'NR==1{print $1}' /run/prudynt/ae_luma 2>/dev/null)
			brightness=
			[ -f /run/prudynt/daynight_brightness ] && brightness=$(awk 'NR==1{print $1}' /run/prudynt/daynight_brightness 2>/dev/null)
			sensor_fields=$(printf '"time_now":%s,"ae_luma":%s,"daynight_brightness":%s,"total_gain":%s,"ev":null,"daynight_mode":%s' \
				"$(date +%s)" \
				"$(agent_json_value_or "$ae_luma" null)" \
				"$(agent_json_value_or "$brightness" null)" \
				"$(agent_json_value_or "$total_gain" null)" \
				"$(agent_json_string_or_null "$daynight_mode")")
			agent_sse_emit sensor.sample "$(agent_sse_payload sensor.sample "$sensor_fields")" || exit 0
			keepalive_counter=0
		fi

		last_motion_active=$current_motion_active
		last_streamer_running=$current_streamer_running
		last_health_status=$current_health_status
		last_firmware_action=$current_firmware_action
		last_stream0_recording=$current_stream0_recording
		last_stream1_recording=$current_stream1_recording
		last_stream0_healthy=$current_stream0_healthy
		last_stream1_healthy=$current_stream1_healthy
		last_recording_active=$current_recording_active
		last_recording_channel=$current_recording_channel
		last_recording_duration=$current_recording_duration
		last_recording_path=$current_recording_path
	done
}

