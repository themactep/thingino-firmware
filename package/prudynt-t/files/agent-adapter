#!/bin/sh
# shellcheck disable=SC2018,SC2019,SC2086  # tr a-z/A-Z on ASCII values; deliberate IFS word-splits into positional params

AGENT_CONFIG="${AGENT_CONFIG:-/etc/prudynt.json}"
THINGINO_AGENT_SEND2_CONFIG="${THINGINO_AGENT_SEND2_CONFIG:-/etc/send2.json}"

agent_name() {
	printf 'prudynt'
}

agent_raw() {
	agent_json_config_value "$AGENT_CONFIG" "$1"
}

agent_text() {
	agent_raw "$1" | tr -d '"'
}

agent_streamer_running() {
	pidof prudynt >/dev/null 2>&1 && printf 'true' || printf 'false'
}

agent_network_ip() {
	agent_default_ip
}

agent_network_online() {
	ip_addr=$(agent_network_ip)
	[ -n "$ip_addr" ] && printf 'true' || printf 'false'
}

agent_health_status() {
	if [ "$(agent_streamer_running)" = true ] && [ "$(agent_network_online)" = true ]; then
		printf 'ok'
	else
		printf 'degraded'
	fi
}

agent_service_script() {
	[ -f /etc/init.d/S31prudynt ] && printf '/etc/init.d/S31prudynt'
}

agent_streaming_controllable() {
	[ -n "$(agent_service_script)" ] && printf 'true' || printf 'false'
}

agent_has_snapshot() {
	command -v prudyntctl >/dev/null 2>&1 && printf 'true' || printf 'false'
}

agent_has_clip() {
	[ -e /run/prudynt/mp4ctl ] && printf 'true' || printf 'false'
}

agent_has_privacy() {
	if command -v privacy >/dev/null 2>&1 || [ -e /run/prudynt/video_ctrl ]; then
		printf 'true'
	else
		printf 'false'
	fi
}

agent_has_daynight() {
	if agent_has_daynightd || command -v prudyntctl >/dev/null 2>&1 || [ -f /run/prudynt/daynight_mode ] || [ -f "$AGENT_CONFIG" ]; then
		printf 'true'
	else
		printf 'false'
	fi
}

agent_has_ptz() {
	command -v motors >/dev/null 2>&1 && printf 'true' || printf 'false'
}

agent_stream_count() {
	printf '2'
}

agent_send2_service_supported() {
	case "$1" in
		email | ftp | gphotos | mqtt | ntfy | storage | telegram | webhook) return 0 ;;
		*)
			echo "unsupported send2 service: $1" >&2
			return 1
			;;
	esac
}

agent_send2_service_has_send_video() {
	case "$1" in
		email | ftp | gphotos | mqtt | ntfy | storage | telegram | webhook) return 0 ;;
		*) return 1 ;;
	esac
}

agent_send2_motion_key() {
	printf 'motion.send2%s' "$1"
}

agent_send2_motion_enabled() {
	service=$1
	agent_json_value_or "$(agent_raw "$(agent_send2_motion_key "$service")")" false
}

agent_send2_raw() {
	service=$1
	field=$2
	agent_json_config_value "$THINGINO_AGENT_SEND2_CONFIG" "$service.$field"
}

agent_recorder_raw() {
	agent_raw "recorder.$1"
}

agent_recorder_text() {
	agent_text "recorder.$1"
}

agent_storage_spec() {
	case "$1" in
		autostart) printf 'autostart|autostart|bool\n' ;;
		channel) printf 'channel|channel|int\n' ;;
		device-path) printf 'device_path|device_path|text\n' ;;
		duration) printf 'duration|duration|int\n' ;;
		filename) printf 'filename|filename|text\n' ;;
		mount) printf 'mount|mount|text\n' ;;
		*) return 1 ;;
	esac
}

agent_parse_storage_path() {
	relative=${1#storage/}
	[ "$relative" != "$1" ] || return 1
	spec=$(agent_storage_spec "$relative") || return 1
	printf '%s|%s\n' "$relative" "$spec"
}

agent_storage_json_value() {
	value_type=$1
	raw_value=$2
	case "$value_type" in
		bool)
			agent_validate_bool "$raw_value" || return 1
			printf '%s' "$raw_value"
			;;
		int)
			agent_validate_int "$raw_value" || return 1
			printf '%s' "$raw_value"
			;;
		text)
			printf '%s' "$(agent_json_string "$(agent_unquote_string "$raw_value")")"
			;;
		*)
			echo "unsupported storage value type: $value_type" >&2
			return 1
			;;
	esac
}

agent_print_storage_setting() {
	parsed=$(agent_parse_storage_path "$1") || {
		echo "unsupported setting path: $1" >&2
		return 1
	}
	OLDIFS=$IFS
	IFS='|'
	set -- $parsed
	IFS=$OLDIFS
	config_key=$2
	response_key=$3
	value_type=$4
	if [ "$value_type" = text ]; then
		printf '{"%s":%s}\n' "$response_key" "$(agent_json_string_or_null "$(agent_recorder_text "$config_key")")"
	else
		agent_print_setting_leaf "$response_key" "$(agent_recorder_raw "$config_key")"
	fi
}

agent_set_storage_setting() {
	storage_path=$1
	body_file=$2
	parsed=$(agent_parse_storage_path "$storage_path") || {
		echo "unsupported setting path: $storage_path" >&2
		return 1
	}
	OLDIFS=$IFS
	IFS='|'
	set -- $parsed
	IFS=$OLDIFS
	config_key=$2
	response_key=$3
	value_type=$4
	if [ "$value_type" = text ]; then
		raw_value=$(agent_json_config_value "$body_file" "$response_key")
		if [ -z "$raw_value" ]; then
			if grep -q '"'"$response_key"'"[[:space:]]*:[[:space:]]*""' "$body_file"; then
				raw_value='""'
			else
				echo "missing field '$response_key'" >&2
				return 1
			fi
		fi
	else
		raw_value=$(agent_setting_value "$body_file" "$response_key") || return 1
	fi
	json_value=$(agent_storage_json_value "$value_type" "$raw_value") || return 1
	agent_apply_payload "{\"recorder\":{\"$config_key\":$json_value}}" || return 1
	agent_persist_value "recorder.$config_key" "$json_value"
	agent_print_setting_update "$storage_path" "$response_key" "$json_value"
}

agent_storage_mount_type() {
	mount_path=$(agent_recorder_text mount)
	[ -n "$mount_path" ] || return 0
	mount | awk -v mount_path="$mount_path" '$3 == mount_path { print $5; exit }' | tr -d '\n'
}

agent_storage_is_mounted() {
	[ -n "$(agent_storage_mount_type)" ] && printf 'true' || printf 'false'
}

agent_storage_resolved_root() {
	mount_path=$(agent_recorder_text mount)
	[ -n "$mount_path" ] || return 0
	device_path=$(agent_recorder_text device_path)
	hostname=$(agent_hostname)
	device_path=$(printf '%s' "$device_path" | sed "s/%hostname/$hostname/g")
	case "$device_path" in
		'') printf '%s' "$mount_path" ;;
		*) printf '%s/%s' "$mount_path" "$device_path" ;;
	esac
}

agent_print_runtime_storage() {
	mount_path=$(agent_recorder_text mount)
	mount_type=$(agent_storage_mount_type)
	mounted=$(agent_json_bool "$(agent_storage_is_mounted)")
	resolved_root=$(agent_storage_resolved_root)
	writable=false
	total_kib=null
	used_kib=null
	available_kib=null
	if [ -n "$mount_type" ]; then
		[ -w "$mount_path" ] && writable=true
		df_line=$(df -k "$mount_path" 2>/dev/null | awk 'NR == 2 { print $2 "|" $3 "|" $4; exit }')
		if [ -n "$df_line" ]; then
			OLDIFS=$IFS
			IFS='|'
			set -- $df_line
			IFS=$OLDIFS
			total_kib=$1
			used_kib=$2
			available_kib=$3
		fi
	fi
	printf '{'
	printf '"configured_mount":%s,' "$(agent_json_string_or_null "$mount_path")"
	printf '"mounted":%s,' "$mounted"
	printf '"filesystem":%s,' "$(agent_json_string_or_null "$mount_type")"
	printf '"record_root":%s,' "$(agent_json_string_or_null "$resolved_root")"
	printf '"writable":%s,' "$(agent_json_bool "$writable")"
	printf '"total_kib":%s,' "$total_kib"
	printf '"used_kib":%s,' "$used_kib"
	printf '"available_kib":%s' "$available_kib"
	printf '}'
}

agent_recording_active_file() {
	for active_file in /run/prudynt/mp4ctl-ch*.active; do
		[ -f "$active_file" ] || continue
		printf '%s' "$active_file"
		return 0
	done
	return 1
}

agent_recording_active_value() {
	active_file=$1
	key=$2
	[ -f "$active_file" ] || return 0
	active_line=$(sed -n '1p' "$active_file" 2>/dev/null | tr '\r\n' ' ')
	[ -n "$active_line" ] || return 0
	printf '%s\n' "$active_line" | tr ' ' '\n' | awk -F= -v key="$key" '$1 == key { print substr($0, index($0, "=") + 1); exit }' | tr -d '\n'
}

agent_recording_active_channel() {
	active_file=$1
	active_channel=$(agent_recording_active_value "$active_file" ch)
	if [ -n "$active_channel" ]; then
		printf '%s' "$active_channel"
		return 0
	fi
	printf '%s' "$active_file" | sed -n 's|.*/mp4ctl-ch\([0-9][0-9]*\)\.active|\1|p' | tr -d '\n'
}

agent_print_runtime_recording() {
	supported=$(agent_json_bool "$(agent_has_clip)")
	configured_autostart=$(agent_json_value_or "$(agent_recorder_raw autostart)" false)
	configured_channel=$(agent_json_value_or "$(agent_recorder_raw channel)" null)
	configured_duration=$(agent_json_value_or "$(agent_recorder_raw duration)" null)
	configured_mount=$(agent_recorder_text mount)
	record_root=$(agent_storage_resolved_root)
	storage_writable=$(agent_json_bool "$([ "$(agent_storage_is_mounted)" = true ] && [ -n "$configured_mount" ] && [ -w "$configured_mount" ] && printf true || printf false)")
	active=false
	current_channel=null
	current_duration=null
	current_path=
	current_mount=
	current_directory=
	current_name_template=
	loop=null
	active_file=$(agent_recording_active_file)
	if [ -n "$active_file" ]; then
		active=true
		active_channel=$(agent_recording_active_channel "$active_file")
		active_duration=$(agent_recording_active_value "$active_file" dur)
		active_path=$(agent_recording_active_value "$active_file" path)
		active_mount=$(agent_recording_active_value "$active_file" mount)
		active_directory=$(agent_recording_active_value "$active_file" dir)
		active_name=$(agent_recording_active_value "$active_file" name)
		active_loop=$(agent_recording_active_value "$active_file" loop)
		[ -n "$active_channel" ] && current_channel=$active_channel
		[ -n "$active_duration" ] && current_duration=$active_duration
		current_path=$active_path
		current_mount=$active_mount
		current_directory=$active_directory
		current_name_template=$active_name
		case "$active_loop" in
			1 | true) loop=true ;;
			0 | false) loop=false ;;
			*) loop=null ;;
		esac
	fi
	printf '{'
	printf '"supported":%s,' "$supported"
	printf '"active":%s,' "$(agent_json_bool "$active")"
	printf '"configured_autostart":%s,' "$configured_autostart"
	printf '"configured_channel":%s,' "$configured_channel"
	printf '"configured_duration_seconds":%s,' "$configured_duration"
	printf '"configured_mount":%s,' "$(agent_json_string_or_null "$configured_mount")"
	printf '"record_root":%s,' "$(agent_json_string_or_null "$record_root")"
	printf '"writable":%s,' "$storage_writable"
	printf '"current_channel":%s,' "$current_channel"
	printf '"current_duration_seconds":%s,' "$current_duration"
	printf '"current_path":%s,' "$(agent_json_string_or_null "$current_path")"
	printf '"current_mount":%s,' "$(agent_json_string_or_null "$current_mount")"
	printf '"current_directory":%s,' "$(agent_json_string_or_null "$current_directory")"
	printf '"current_name_template":%s,' "$(agent_json_string_or_null "$current_name_template")"
	printf '"loop":%s' "$loop"
	printf '}'
}

agent_print_send2_capabilities() {
	printf '{'
	sep=''
	for service in email ftp gphotos mqtt ntfy storage telegram webhook; do
		printf '%s"%s":{"enabled":true,"send_photo":true,"send_video":%s}' \
			"$sep" "$service" \
			"$(agent_json_bool "$(agent_send2_service_has_send_video "$service" && printf true || printf false)")"
		sep=,
	done
	printf '}'
}

agent_print_service_capabilities() {
	streaming_service=false
	[ -n "$(agent_service_script)" ] && streaming_service=true
	printf '{"streaming":{"start":%s,"stop":%s,"restart":%s}}' \
		"$(agent_json_bool "$streaming_service")" \
		"$(agent_json_bool "$streaming_service")" \
		"$(agent_json_bool "$streaming_service")"
}

agent_print_firmware_capabilities() {
	printf '{"upgrade":%s}' "$(agent_json_bool "$(command -v sysupgrade >/dev/null 2>&1 && printf true || printf false)")"
}

agent_firmware_upgrade_supported() {
	command -v sysupgrade >/dev/null 2>&1 && printf 'true' || printf 'false'
}

agent_firmware_pending_full() {
	[ -f /tmp/upgrade.me ] && printf 'true' || printf 'false'
}

agent_firmware_pending_partial() {
	[ -f /tmp/update.me ] && printf 'true' || printf 'false'
}

agent_firmware_boot_marked_complete() {
	if command -v fw_printenv >/dev/null 2>&1; then
		value=$(fw_printenv -n sysupgrade_complete 2>/dev/null | tr -d '\n')
		case "$value" in
			1 | true | TRUE | yes | on) printf 'true' ;;
			0 | false | FALSE | no | off) printf 'false' ;;
			'') printf 'null' ;;
			*) printf 'null' ;;
		esac
	else
		printf 'null'
	fi
}

agent_firmware_pending_action() {
	if [ "$(agent_firmware_pending_full)" = true ]; then
		printf 'full'
	elif [ "$(agent_firmware_pending_partial)" = true ]; then
		printf 'partial'
	else
		printf 'none'
	fi
}

agent_print_runtime_firmware() {
	printf '{'
	printf '"upgrade_supported":%s,' "$(agent_json_bool "$(agent_firmware_upgrade_supported)")"
	printf '"pending_full":%s,' "$(agent_json_bool "$(agent_firmware_pending_full)")"
	printf '"pending_partial":%s,' "$(agent_json_bool "$(agent_firmware_pending_partial)")"
	printf '"pending_action":%s,' "$(agent_json_string "$(agent_firmware_pending_action)")"
	printf '"boot_marked_complete":%s,' "$(agent_firmware_boot_marked_complete)"
	printf '"current_version":%s' "$(agent_json_string_or_null "$(agent_firmware_version)")"
	printf '}'
}

agent_motion_enabled() {
	agent_json_value_or "$(agent_raw motion.enabled)" false
}

agent_motion_active() {
	if [ -f /run/prudynt/motion.active ] || [ -f /run/prudynt/motion_detected.active ]; then
		printf 'true'
	else
		printf 'false'
	fi
}

agent_daynight_enabled() {
	if agent_has_daynightd; then
		agent_daynightd_enabled
		return 0
	fi
	agent_json_value_or "$(agent_raw daynight.enabled)" false
}

agent_daynight_force_mode() {
	if agent_has_daynightd; then
		agent_daynightd_force_mode
		return 0
	fi
	agent_json_value_or "$(agent_raw daynight.force_mode)" null
}

agent_daynight_running_mode() {
	if agent_has_daynightd; then
		agent_daynightd_running_mode
		return 0
	fi
	if [ -f /run/prudynt/daynight_mode ]; then
		mode=$(awk 'NR == 1 { print $1 }' /run/prudynt/daynight_mode 2>/dev/null | tr -d '\n')
		[ -n "$mode" ] && {
			printf '%s' "$mode"
			return 0
		}
	fi
	if command -v prudyntctl >/dev/null 2>&1; then
		state=$(
			prudyntctl json - 2>/dev/null <<'EOF'
{"image":{"running_mode":null}}
EOF
		)
		running=$(printf '%s' "$state" | grep -o '"running_mode":[^,}]*' | head -n 1 | cut -d: -f2 | tr -d ' "')
		case "$running" in
			0)
				printf 'day'
				return 0
				;;
			1)
				printf 'night'
				return 0
				;;
		esac
	fi
	printf 'unknown'
}

agent_daynight_target_mode() {
	if agent_has_daynightd; then
		agent_daynightd_target_mode
		return 0
	fi
	enabled=$(agent_daynight_enabled)
	if [ "$enabled" = "true" ]; then
		printf 'auto'
	else
		mode=$(agent_text daynight.force_mode)
		[ -n "$mode" ] || mode=$(agent_daynight_running_mode)
		printf '%s' "$mode"
	fi
}

agent_privacy_enabled() {
	[ -f /run/prudynt/privacy.active ] && printf 'true' || printf 'false'
}

agent_stream_field() {
	stream_id=$1
	field=$2
	agent_raw "stream${stream_id}.${field}"
}

agent_stream_text_field() {
	stream_id=$1
	field=$2
	agent_text "stream${stream_id}.${field}"
}

# Return the runtime value of a stream field (width/height/fps) by querying the
# running prudynt process via prudyntctl. Falls back to the static config value
# when prudyntctl is unavailable or returns 0.
agent_runtime_stream_field() {
	stream_id=$1
	field=$2
	if command -v prudyntctl >/dev/null 2>&1; then
		_rt_tmp=$(mktemp)
		prudyntctl json "{\"stream${stream_id}\":{\"${field}\":null}}" >"$_rt_tmp" 2>/dev/null
		_rt_val=$(agent_json_config_value "$_rt_tmp" "stream${stream_id}.${field}")
		rm -f "$_rt_tmp"
		if [ -n "$_rt_val" ] && [ "$_rt_val" != "0" ] && [ "$_rt_val" != "null" ]; then
			printf '%s' "$_rt_val"
			return
		fi
	fi
	agent_raw "stream${stream_id}.${field}"
}

agent_rtsp_port() {
	rtsp_port=$(agent_text rtsp.port)
	[ -n "$rtsp_port" ] || rtsp_port=554
	printf '%s' "$rtsp_port"
}

agent_rtsp_listening() {
	rtsp_port=$(agent_rtsp_port)
	if netstat -lnt 2>/dev/null | awk -v port=":$rtsp_port" 'index($4, port) { found=1; exit } END { exit(found ? 0 : 1) }'; then
		printf 'true'
	else
		printf 'false'
	fi
}

agent_stream_recording_active() {
	stream_id=$1
	[ -f "/run/prudynt/mp4ctl-ch${stream_id}.active" ] && printf 'true' || printf 'false'
}

agent_stream_healthy() {
	stream_id=$1
	enabled=$(agent_json_value_or "$(agent_stream_field "$stream_id" enabled)" false)
	video_enabled=$(agent_json_value_or "$(agent_stream_field "$stream_id" video_enabled)" false)
	rtsp_listener_up=$(agent_rtsp_listening)
	if [ "$(agent_streamer_running)" = true ] &&
		[ "$enabled" = true ] &&
		[ "$video_enabled" = true ] &&
		[ "$rtsp_listener_up" = true ]; then
		printf 'true'
	else
		printf 'false'
	fi
}

agent_event_append_path() {
	paths_json=$1
	path=$2
	path_json=$(agent_json_string "$path")
	if [ -n "$paths_json" ]; then
		printf '%s,%s' "$paths_json" "$path_json"
	else
		printf '%s' "$path_json"
	fi
}

agent_stream_rtsp_url() {
	stream_id=$1
	endpoint=$(agent_stream_text_field "$stream_id" rtsp_endpoint)
	[ -n "$endpoint" ] || return 0
	printf 'rtsp://127.0.0.1:%s/%s' "$(agent_rtsp_port)" "$endpoint"
}

