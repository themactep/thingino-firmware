}

agent_snapshot() {
	channel=${1:-0}
	command -v prudyntctl >/dev/null 2>&1 || {
		echo "snapshot is not supported on this camera" >&2
		return 1
	}
	prudyntctl snapshot -c "$channel"
}

agent_record() {
	# Usage:
	#   record stop [channel]
	#   record continuous [channel]
	#   record [duration] [channel] [path]   # timed clip (existing)
	arg1=${1:-10}
	channel=${2:-0}
	file=${3:-/tmp/clip_$(date +%Y%m%d_%H%M%S).mp4}

	case "$arg1" in
		stop)
			[ -e /run/prudynt/mp4ctl ] || {
				echo "record action is not supported on this camera" >&2
				return 1
			}
			printf 'STOP\n' >/run/prudynt/mp4ctl || {
				echo "failed to stop recording" >&2
				return 1
			}
			printf '{"status":"accepted","action":"stop","stream_id":%s}\n' \
				"$(agent_json_value_or "$channel" 0)"
			return 0
			;;
		continuous)
			[ -e /run/prudynt/mp4ctl ] || {
				echo "record action is not supported on this camera" >&2
				return 1
			}
			# Prefer the record helper when present (looping storage path).
			if command -v record >/dev/null 2>&1; then
				record start -c "$channel" >/dev/null 2>&1 || {
					echo "failed to start continuous recording" >&2
					return 1
				}
			else
				mount_path=$(agent_recorder_text mount)
				[ -n "$mount_path" ] || mount_path=/tmp
				file="${mount_path%/}/rec_ch${channel}_$(date +%Y%m%d_%H%M%S).mp4"
				# Long duration approximates continuous until STOP.
				echo "START $file 86400 $channel" >/run/prudynt/mp4ctl || {
					echo "failed to start continuous recording" >&2
					return 1
				}
			fi
			printf '{"status":"accepted","action":"continuous","stream_id":%s}\n' \
				"$(agent_json_value_or "$channel" 0)"
			return 0
			;;
	esac

	duration=$arg1
	[ -e /run/prudynt/mp4ctl ] || {
		echo "record action is not supported on this camera" >&2
		return 1
	}
	echo "START $file $duration $channel" >/run/prudynt/mp4ctl
	printf '{"status":"accepted","result":{"path":%s}}\n' "$(agent_json_string "$file")"
}

agent_privacy() {
	state=$1
	channel=${2:-all}
	[ -n "$state" ] || {
		echo "usage: agentctl privacy <on|off> [channel]" >&2
		return 1
	}
	if ! command -v privacy >/dev/null 2>&1 && [ ! -e /run/prudynt/video_ctrl ]; then
		echo "privacy action is not supported on this camera" >&2
		return 1
	fi
	if command -v privacy >/dev/null 2>&1 && [ "$channel" = "all" ]; then
		privacy "$state"
	else
		printf 'PRIVACY ch=%s value=%s\n' "$channel" "$state" >/run/prudynt/video_ctrl
	fi
	printf '{"status":"accepted"}\n'
}

agent_daynight() {
	mode=$(printf '%s' "$1" | tr 'A-Z' 'a-z')
	[ -n "$mode" ] || {
		echo "usage: agentctl daynight <auto|day|night>" >&2
		return 1
	}
	case "$mode" in
		auto)
			if agent_has_daynightd; then
				agent_daynightd_set_mode auto || return 1
			else
				agent_apply_payload '{"daynight":{"enabled":true}}' || return 1
				agent_persist_value daynight.enabled true
			fi
			printf '{"status":"accepted","mode":"auto"}\n'
			;;
		day | night)
			if agent_has_daynightd; then
				agent_daynightd_set_mode "$mode" || return 1
			else
				agent_apply_payload "{\"daynight\":{\"enabled\":false,\"force_mode\":\"$mode\"}}" || return 1
				agent_persist_value daynight.enabled false
				agent_persist_value daynight.force_mode "\"$mode\""
			fi
			printf '{"status":"accepted","mode":%s}\n' "$(agent_json_string "$mode")"
			;;
		*)
			echo "daynight mode must be auto, day, or night" >&2
			return 1
			;;
	esac
}

agent_service() {
	service_name=$(printf '%s' "$1" | tr 'A-Z' 'a-z')
	action_name=$(printf '%s' "$2" | tr 'A-Z' 'a-z')
	case "$service_name" in
		streaming)
			script=$(agent_service_script)
			;;
		*)
			echo "unsupported service: $service_name" >&2
			return 1
			;;
	esac
	[ -n "$script" ] || {
		echo "$service_name service control is not supported on this camera" >&2
		return 1
	}
	case "$action_name" in
		start | stop | restart) ;;
		*)
			echo "service action must be start, stop, or restart" >&2
			return 1
			;;
	esac
	"$script" "$action_name" >/dev/null 2>&1 || {
		echo "failed to $action_name $service_name service" >&2
		return 1
	}
	printf '{"status":"accepted","service":%s,"operation":%s}\n' \
		"$(agent_json_string "$service_name")" "$(agent_json_string "$action_name")"
}

agent_reboot() {
	(
		sleep 1
		reboot -f
	) >/dev/null 2>&1 &
	printf '{"status":"accepted","operation":"reboot"}\n'
}

agent_send2_test() {
	service=$(printf '%s' "${1:-}" | tr 'A-Z' 'a-z')
	action=$(printf '%s' "${2:-test}" | tr 'A-Z' 'a-z')
	[ -n "$service" ] || {
		echo "send2-test: service name required" >&2
		return 1
	}
	tool="/usr/sbin/send2${service}"
	[ -x "$tool" ] || {
		echo "send2-test: unsupported service '$service'" >&2
		return 1
	}
	# Suppress all tool output: the agent listener merges stderr into the
	# response body, which would break JSON parsing. Report success/failure
	# via exit code instead.
	_send2_ok=true
	case "$action" in
		test) "$tool" -S >/dev/null 2>&1 || _send2_ok=false ;;
		test-photo) "$tool" -S >/dev/null 2>&1 || _send2_ok=false ;;
		test-video) "$tool" -V >/dev/null 2>&1 || _send2_ok=false ;;
		*)
			echo "send2-test: unsupported action '$action'" >&2
			return 1
			;;
	esac
	if [ "$_send2_ok" = "false" ]; then
		printf '{"status":"error","service":%s,"action":%s,"message":"send2 test failed"}\n' \
			"$(agent_json_string "$service")" \
			"$(agent_json_string "$action")"
		return 1
	fi
	printf '{"status":"ok","service":%s,"action":%s}\n' \
		"$(agent_json_string "$service")" \
		"$(agent_json_string "$action")"
}
