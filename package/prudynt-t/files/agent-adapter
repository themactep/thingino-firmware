agent_persist_if_present() {
	source_file=$1
	path=$2
	value=$(agent_json_config_value "$source_file" "$path")
	[ -n "$value" ] || return 0
	agent_persist_value "$path" "$value"
}

agent_persist_send2_if_present() {
	source_file=$1
	path=$2
	value=$(agent_json_config_value "$source_file" "$path")
	[ -n "$value" ] || return 0
	if command -v jct >/dev/null 2>&1 && [ -f "$THINGINO_AGENT_SEND2_CONFIG" ]; then
		jct "$THINGINO_AGENT_SEND2_CONFIG" set "$path" "$value" >/dev/null 2>&1 || true
	fi
}

agent_apply_config() {
	source_file=$1
	[ -n "$source_file" ] || {
		echo "usage: agentctl apply-config <json-file>" >&2
		return 1
	}
	[ -s "$source_file" ] || {
		echo "configuration payload is empty" >&2
		return 1
	}
	if ! command -v prudyntctl >/dev/null 2>&1; then
		echo "prudyntctl is not available" >&2
		return 1
	fi
	if ! cat "$source_file" | prudyntctl json - >/dev/null 2>&1; then
		echo "failed to apply runtime configuration" >&2
		return 1
	fi
	agent_persist_if_present "$source_file" image.brightness
