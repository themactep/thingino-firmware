	agent_persist_if_present "$source_file" stream0.fps
	agent_persist_if_present "$source_file" stream0.format
	agent_persist_if_present "$source_file" stream0.mode
	for field in \
		stream0.osd.enabled \
		stream0.osd.font_path \
		stream0.osd.font_size \
		stream0.osd.start_delay \
		stream0.osd.stroke_size \
		stream0.osd.brightness.enabled \
		stream0.osd.brightness.fill_color \
		stream0.osd.brightness.format \
		stream0.osd.brightness.position \
		stream0.osd.brightness.rotation \
		stream0.osd.brightness.stroke_color \
		stream0.osd.time.enabled \
		stream0.osd.time.fill_color \
		stream0.osd.time.format \
		stream0.osd.time.position \
