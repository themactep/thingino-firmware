#!/bin/sh
# shellcheck disable=SC1091,SC2034,SC2086
# Triggered on a motion event

. /usr/share/prudynt-helpers

[ "$1" != "stop" ] && singleton "$0"

MOTION_ALARM="/run/motion/motion_alarm"
MOTION_ALARM_DIR=$(dirname "$MOTION_ALARM")
[ -d "$MOTION_ALARM_DIR" ] || mkdir -p "$MOTION_ALARM_DIR"

MOTOR_ACTIVE_FLAG="/run/motors-active"

MOTION_VIDEO_CHANNEL=0
MOTION_VIDEO_LENGTH=$(prudynt-config get motion.video_length 2>/dev/null)
[ -z "$MOTION_VIDEO_LENGTH" ] && MOTION_VIDEO_LENGTH=$(prudynt-config get recorder.duration 2>/dev/null)
[ -z "$MOTION_VIDEO_LENGTH" ] && MOTION_VIDEO_LENGTH=10
[ "$MOTION_VIDEO_LENGTH" -eq "$MOTION_VIDEO_LENGTH" ] 2>/dev/null || MOTION_VIDEO_LENGTH=10

domain=motion

get_value() {
	prudynt-config get "motion.$1" 2>/dev/null
}

set_enabled() {
	echo "{ \"motion\": { \"enabled\": $1 } }" | prudyntctl json -
	prudynt-config set "motion.enabled" $1
}

# Invoke one send2 service. Captured media paths, when present, are read
# from the environment by the service script.
run_service() {
	case "$1" in
		email) echo_info "Send alert to email" ;;
		ftp) echo_info "Send alert to FTP" ;;
		mqtt) echo_info "Send alert to MQTT" ;;
		ntfy) echo_info "Send alert to Ntfy" ;;
		storage) echo_info "Save to storage" ;;
		gphotos) echo_info "Upload to Google Photos" ;;
		gotify) echo_info "Send alert to Gotify" ;;
		pushover) echo_info "Send alert to Pushover" ;;
		webhook) echo_info "Send alert to WebHook" ;;
		xmpp) echo_info "Send alert to XMPP" ;;
		telegram) echo_info "Send alert to Telegram" ;;
	esac

	case "$1" in
		xmpp)
			if [ -n "$MOTION_PHOTO_FILE" ] && [ -f "$MOTION_PHOTO_FILE" ]; then
				send2xmpp -i "$MOTION_PHOTO_FILE" -m "Motion detected on $(hostname) at $(date)" &
			else
				send2xmpp -m "Motion detected on $(hostname) at $(date)" &
			fi
			;;
		telegram)
			MOTION_PHOTO_FILE="$MOTION_PHOTO_FILE" MOTION_VIDEO_FILE="$MOTION_VIDEO_FILE" \
				send2telegram -v >>/tmp/send2telegram.log 2>&1 &
			;;
		*)
			MOTION_PHOTO_FILE="$MOTION_PHOTO_FILE" MOTION_VIDEO_FILE="$MOTION_VIDEO_FILE" "send2$1" &
			;;
	esac
	send2_pids="$send2_pids $!"
}

start() {
	echo_info "Start motion"
	if [ -f "$MOTOR_ACTIVE_FLAG" ]; then
		echo_info "Motors active; suppressing motion event."
		exit 0
	fi

	# Generate timestamp for this motion event
	MOTION_TIMESTAMP=$(date +%Y%m%d_%H%M%S)
	MOTION_PHOTO_FILE="/tmp/motion_${MOTION_TIMESTAMP}.jpg"
	MOTION_VIDEO_FILE="/tmp/motion_${MOTION_TIMESTAMP}.mp4"
	# Captured-state markers consumed by send2storage
	SEND2_SKIP_VIDEO=false

	echo_info "Set $MOTION_ALARM"
	touch "$MOTION_ALARM"

	# Notify Home Assistant immediately (if installed)
	[ -x /usr/sbin/ha-event ] && ha-event motion ON &

	# Trigger the Wyze Floodlight v1 night-time motion lamp (if installed)
	[ -x /usr/sbin/floodlight_ctl ] && floodlight_ctl motion &

	# Audible alert needs no captured media: fire it before the capture so a
	# long clip does not delay it.
	if [ "true" = "$(get_value playonspeaker)" ]; then
		echo_info "Send alert to play on speaker"
		playonspeaker motiondetectionactivated &
	fi

	# Split the send2 services by whether they attach the captured media.
	# Text-only ones fire now; media-bound ones wait for the capture.
	send2_pids=""
	send2_deferred=""
	need_photo=false
	need_video=false
	other_video=false

	for service in email ftp gphotos gotify mqtt ntfy pushover storage telegram webhook xmpp; do
		[ "true" = "$(get_value send2${service})" ] || continue
		want_photo=false
		want_video=false
		[ "true" = "$(jct /etc/send2.json get ${service}.send_photo 2>/dev/null)" ] && want_photo=true
		[ "true" = "$(jct /etc/send2.json get ${service}.send_video 2>/dev/null)" ] && want_video=true
		# XMPP carries photos only, never video.
		[ "$service" = "xmpp" ] && want_video=false

		if [ "$want_photo" = "true" ] || [ "$want_video" = "true" ]; then
			send2_deferred="$send2_deferred $service"
			[ "$want_photo" = "true" ] && need_photo=true
			[ "$want_video" = "true" ] && need_video=true
			[ "$want_video" = "true" ] && [ "$service" != "storage" ] && other_video=true
		elif [ "$service" != "telegram" ]; then
			run_service "$service"
		fi
	done

	# Capture snapshot only if needed
	if [ "$need_photo" = "true" ]; then
		echo_info "Capture snapshot $MOTION_PHOTO_FILE"
		prudyntctl snapshot -c $MOTION_VIDEO_CHANNEL >"$MOTION_PHOTO_FILE"
		export MOTION_PHOTO_FILE
	else
		echo_info "Skipping snapshot (not needed by any send2 service)"
		unset MOTION_PHOTO_FILE
	fi

	# A busy channel rejects a second START; gate the whole capture on
	# the channel's .active flag before any START is attempted.
	active_flag="/run/prudynt/mp4ctl-ch${MOTION_VIDEO_CHANNEL}.active"
	if [ "$need_video" = "true" ] && [ -f "$active_flag" ]; then
		echo_info "Channel ${MOTION_VIDEO_CHANNEL} is busy; skipping motion video"
		need_video=false
		unset MOTION_VIDEO_FILE
		SEND2_SKIP_VIDEO=true
	fi

	# When storage is the only video consumer, record onto the mount
	# itself (send2storage renames into place). A rejected START would
	# wedge the wait below, so the mount must prove itself first.
	use_sd=false
	if [ "$need_video" = "true" ] && [ "$other_video" != "true" ]; then
		sd_mount=$(jct /etc/send2.json get storage.mount 2>/dev/null)
		if [ -n "$sd_mount" ] && [ "$sd_mount" != "/" ] &&
			mountpoint -q "$sd_mount" 2>/dev/null &&
			[ "$(id -u)" = "0" ] &&
			touch "$sd_mount/.motion_write_test" 2>/dev/null; then
			rm -f "$sd_mount/.motion_write_test"
			# Busy was checked above; a race in between means keep /tmp
			# rather than steal the channel.
			if [ ! -f "$active_flag" ]; then
				MOTION_VIDEO_FILE="$sd_mount/.motion_${MOTION_TIMESTAMP}.mp4"
				use_sd=true
				echo_info "Recording to the storage mount instead of /tmp: $sd_mount/.motion_${MOTION_TIMESTAMP}.mp4"
			fi
		fi
	fi

	# Record video only if needed
	if [ "$need_video" = "true" ]; then
		echo_info "Start recording $MOTION_VIDEO_FILE"
		echo "START $MOTION_VIDEO_FILE $MOTION_VIDEO_LENGTH $MOTION_VIDEO_CHANNEL" >/run/prudynt/mp4ctl

		# Wait for the file to appear, bounded — a rejected START never
		# creates the file, and motion holds the singleton lock.
		start_timeout=10
		while [ ! -f "$MOTION_VIDEO_FILE" ] && [ $start_timeout -gt 0 ]; do
			sleep 1
			start_timeout=$((start_timeout - 1))
		done

		if [ ! -f "$MOTION_VIDEO_FILE" ]; then
			# Stop only a recorder we own (.active records path=); a foreign
			# recorder wins a check→START race and must be left alone.
			if grep -qx "path=$MOTION_VIDEO_FILE" "$active_flag" 2>/dev/null; then
				printf 'STOP ch=%s\n' "$MOTION_VIDEO_CHANNEL" >/run/prudynt/mp4ctl
			fi
			if [ "$use_sd" = "true" ]; then
				# Mount refused the recording; degrade to the /tmp path.
				rm -f "$MOTION_VIDEO_FILE"
				MOTION_VIDEO_FILE="/tmp/motion_${MOTION_TIMESTAMP}.mp4"
				echo_info "Storage mount refused the recording, falling back to /tmp: $MOTION_VIDEO_FILE"
				echo "START $MOTION_VIDEO_FILE $MOTION_VIDEO_LENGTH $MOTION_VIDEO_CHANNEL" >/run/prudynt/mp4ctl
				start_timeout=10
				while [ ! -f "$MOTION_VIDEO_FILE" ] && [ $start_timeout -gt 0 ]; do
					sleep 1
					start_timeout=$((start_timeout - 1))
				done
			fi
		fi

		# .active is the end-of-recording signal (docs/mp4-control.md).
		if [ -f "$MOTION_VIDEO_FILE" ]; then
			active_flag="/run/prudynt/mp4ctl-ch${MOTION_VIDEO_CHANNEL}.active"
			finish_timeout=$((MOTION_VIDEO_LENGTH + 10))
			[ $finish_timeout -lt 20 ] && finish_timeout=20
			while [ -f "$active_flag" ] && [ $finish_timeout -gt 0 ]; do
				sleep 1
				finish_timeout=$((finish_timeout - 1))
			done

			# Final settle: require the size to stop growing while
			# .active persists (a slow card can outlast the wait above).
			sleep 1
			prev_size=$(stat -c%s "$MOTION_VIDEO_FILE" 2>/dev/null || echo 0)
			stability=5
			while [ -f "$active_flag" ] && [ $stability -gt 0 ]; do
				sleep 1
				cur_size=$(stat -c%s "$MOTION_VIDEO_FILE" 2>/dev/null || echo 0)
				[ "$cur_size" = "$prev_size" ] && break
				prev_size=$cur_size
				stability=$((stability - 1))
			done

			# A write-aborted recording leaves a truncated or empty
			# file; do not hand a corpse to the send2 services.
			[ -s "$MOTION_VIDEO_FILE" ] || unset MOTION_VIDEO_FILE

			echo_info "Motion video is ready."
			export MOTION_VIDEO_FILE
		else
			echo_info "Recording did not start, skipping motion video"
			unset MOTION_VIDEO_FILE
		fi
	else
		echo_info "Skipping video recording (not needed by any send2 service)"
		unset MOTION_VIDEO_FILE
	fi

	export SEND2_SKIP_VIDEO

	# Media-bound send2 actions, after the capture above.
	for service in $send2_deferred; do
		run_service "$service"
	done

	# Wait for all send2 processes to complete in background, then cleanup
	if [ -n "$send2_pids" ]; then
		(
			# Wait for each send2 process to complete
			for pid in $send2_pids; do
				# Use kill -0 to check if process exists, then wait
				while kill -0 $pid 2>/dev/null; do
					sleep 1
				done
			done
			echo_info "Cleaning up motion files"
			[ -f "$MOTION_PHOTO_FILE" ] && rm -f "$MOTION_PHOTO_FILE"
			[ -f "$MOTION_VIDEO_FILE" ] && rm -f "$MOTION_VIDEO_FILE"
		) &
	fi
}

stop() {
	echo_info "Stop motion"

	if [ -f "$MOTION_ALARM" ]; then
		echo_info "Remove $MOTION_ALARM"
		rm -f "$MOTION_ALARM"

		# Notify Home Assistant immediately (if installed)
		[ -x /usr/sbin/ha-event ] && ha-event motion OFF &
	fi
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	enable)
		set_enabled true
		;;
	disable)
		set_enabled false
		;;
	*)
		start
		;;
esac

exit 0
