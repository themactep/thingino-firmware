#!/bin/sh

PATH=/bin:/sbin:/usr/bin:/usr/sbin${PATH:+:$PATH}
export PATH

DAEMON="/usr/bin/prudynt"
PIDFILE="/run/prudynt.pid"
HEARTBEAT_INIT="/etc/init.d/S99heartbeat"

restart_heartbeat() {
	if [ -x "$HEARTBEAT_INIT" ]; then
		"$HEARTBEAT_INIT" restart >/dev/null 2>&1
	fi
}

stop_heartbeat() {
	if [ -x "$HEARTBEAT_INIT" ]; then
		"$HEARTBEAT_INIT" stop >/dev/null 2>&1
	fi
}

# Returns 0 if prudynt process is alive (by PID file or name match).
is_alive() {
	if [ -f "$PIDFILE" ]; then
		kill -0 "$(cat "$PIDFILE")" 2>/dev/null && return 0
	fi
	pidof "$DAEMON" >/dev/null 2>&1 && return 0
	return 1
}

start_daemon() {
	start-stop-daemon -S -b -m -p "$PIDFILE" -x "$DAEMON"
}

stop_daemon() {
	if [ -f "$PIDFILE" ]; then
		start-stop-daemon -K -p "$PIDFILE" -x "$DAEMON" 2>/dev/null
		status=$?
		rm -f "$PIDFILE"
	fi

	# Fallback: kill by name if PID file approach didn't work.
	if is_alive; then
		killall "$DAEMON" 2>/dev/null || killall -9 "$DAEMON" 2>/dev/null
	fi
}

start() {
	echo -c 15 "Starting Prudynt"
	start_daemon
	status=$?
	if [ "$status" -eq 0 ]; then
		restart_heartbeat
	fi
	return "$status"
}

stop() {
	echo -c 15 "Stopping Prudynt"
	stop_heartbeat
	stop_daemon

	# Wait up to 5 s for the process to actually exit.
	i=0
	while is_alive && [ $i -lt 50 ]; do
		usleep 100000
		i=$((i + 1))
	done

	# Force-kill if still alive after timeout.
	if is_alive; then
		echo -c 15 "Prudynt did not stop, force-killing"
		if [ -f "$PIDFILE" ]; then
			start-stop-daemon -K -s KILL -p "$PIDFILE"
		else
			start-stop-daemon -K -s KILL -x "$DAEMON"
		fi
		usleep 500000
	fi
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart)
		stop || true
		sleep 2
		# Retry start up to 3 times if the first attempt fails.
		r=0
		while [ $r -lt 3 ]; do
			if start; then
				exit 0
			fi
			r=$((r + 1))
			echo -c 15 "Prudynt start failed (attempt $r), retrying..."
			sleep 2
		done
		echo -c 15 "Prudynt failed to start after 3 attempts"
		exit 1
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac

exit 0
