+
+    // Resolve the previously deferred fragment now that the next PTS is known.
+    // Its trun sample_duration is the delta to this sample; non-increasing
+    // deltas fall back to the default duration so the stream stays monotonic.
+    std::vector<uint8_t> resolved_out;
