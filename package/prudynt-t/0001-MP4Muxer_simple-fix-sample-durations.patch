+                                : static_cast<uint32_t>(delta);
+      } else {
+        resolved_duration = t.default_duration_ticks;
+        if (resolved_duration == 0) {
+          resolved_duration =
+              isVideo ? (t.timescale / 30) : (t.timescale / 50);
+          if (resolved_duration == 0) {
+            resolved_duration = 1;
+          }
+        }
+      }
+      if (t.pending_duration_pos != 0 &&
+          t.pending_duration_pos + 4 <= t.pending.size()) {
+        t.pending[t.pending_duration_pos + 0] =
