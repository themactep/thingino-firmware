+namespace {
+// Per-thread: every IPC client is handled in its own thread.
+thread_local bool t_runtime_only = false;
+} // namespace
+
+void CFG::set_runtime_only(bool on) { t_runtime_only = on; }
+
 void CFG::mark_dirty_path(const std::string &path) {
+  // Runtime-only callers must not leave a path behind for the next persist.
+  if (t_runtime_only)
+    return;
   dirty_ = true;
   std::lock_guard<std::mutex> lock(configMutex);
   dirty_paths_.insert(path);
