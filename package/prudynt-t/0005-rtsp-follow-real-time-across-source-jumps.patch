+// Next RTP timestamp after last_ts, given new_ts derived from the source clock.
+// The source can change its time base under a running session (the encoder is
+// recreated by a video restart, the audio input by a mic restart). A jump that
+// the real time elapsed since last_ts does not explain is absorbed into the
+// session anchor (anchorShiftUs), so the RTP clock keeps following real time
+// instead of replaying the jump in capped steps that clients render as a
+// freeze. A jump that matches the elapsed time is a real gap and is kept.
+static uint32_t followSourceClock(uint32_t new_ts, uint32_t last_ts, int rate,
+                                  int64_t elapsedUs, int64_t &anchorShiftUs) {
+    static const int64_t kSlackUs = 500000;
+    anchorShiftUs = 0;
+    int64_t diff = rtpTsDelta(new_ts, last_ts);
+    int64_t jumpUs = diff * 1000000LL / rate;
+    if (elapsedUs >= 0 &&
+        (jumpUs > elapsedUs + kSlackUs || jumpUs < -kSlackUs)) {
+        anchorShiftUs = jumpUs - elapsedUs;
+        int64_t step = elapsedUs * rate / 1000000LL;
+        return last_ts + static_cast<uint32_t>(step > 0 ? step : 1);
+    }
+    if (diff <= 0)
+        return last_ts + 1;
+    return new_ts;
+}
