+static inline bool atbm_accsii_to_hex_V2(const char *pos,int len,u32 *res)
+{
+    int index = 0;
+    int     got_hex = false;
+    unsigned int  d = 0;
+	const char *accsii = pos;
+
+    for(;index<len;index++)
+    {
+        char    ch;
+
+        ch = accsii[index];
+        if (ch == 0)
+        {
+            break;
+        }
+        if (ch >= '0' && ch <= '9')
+        {
+            d = (d<<4) | (ch - '0');
+        }
+        else if (ch >= 'a' && ch <= 'f')
+        {
+            d = (d<<4) | (ch - 'a' + 10);
+        }
+        else if (ch >= 'A' && ch <= 'F')
+        {
+            d = (d<<4) | (ch - 'A' + 10);
+        }
+        else
+        {
+            got_hex = 0;
+            break;
+        }
+        got_hex = true;
+    }
+    if (got_hex)
+    {
+        *res = d;
+    }
+
+    return got_hex;
+}
