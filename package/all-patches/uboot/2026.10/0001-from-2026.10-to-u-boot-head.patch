-    char disk_revision[4];
-    char controller_vendor[8];
-    char controller_product[16];
-    char controller_revision[4];
-
-    u32 reserved_5[10];
-};
-
-/*
- * Each partition on this drive is defined by such a block
- */
-
-struct partition_block
-{
-    u32 id;
-    u32 summed_longs;
-    s32 chk_sum;
-    u32 host_id;
-    u32 next;
