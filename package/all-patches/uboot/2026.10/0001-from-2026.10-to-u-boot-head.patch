-    /* Physical drive geometry */
-    u32 cylinders;
-    u32 sectors;
-    u32 heads;
-    u32 interleave;
-    u32 park;
-    u32 reserved_2[3];
-    u32 write_pre_comp;
-    u32 reduced_write;
-    u32 step_rate;
-    u32 reserved_3[5];
-
-    /* logical drive geometry */
-    u32 rdb_blocks_lo;
-    u32 rdb_blocks_hi;
-    u32 lo_cylinder;
-    u32 hi_cylinder;
