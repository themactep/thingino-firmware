+	    !fit_props_equal(fdt, ncipher, tcipher, FIT_KEY_HINT)) {
+		fprintf(stderr,
+			"Error: image '%s' shares data with image '%s' but their cipher settings differ\n",
+			name, ref);
+		return -EINVAL;
