-    info->type[3] = '\\';
-    info->type[4] = (disk_type & 0x000000FF) + '0';
-    info->type[5] = 0;
-
-    return 0;
-}
-
-static void part_print_amiga(struct blk_desc *desc)
-{
-    struct rigid_disk_block *rdb;
