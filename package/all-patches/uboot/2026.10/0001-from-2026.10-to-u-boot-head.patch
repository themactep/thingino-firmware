-	ulong res;
-
-	PRINTF("Trying to load block #0x%X\n", block);
-
-	res = blk_dread(desc, block, 1, (ulong *)block_buffer);
-	if (res == 1)
-	{
-	    p = (struct partition_block *)block_buffer;
