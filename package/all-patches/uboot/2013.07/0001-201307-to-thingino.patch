+extern int jz_net_initialize(bd_t *bis);
+struct cgu_clk_src cgu_clk_src[] = {
+	{VPU, MPLL},
+	{GMAC, APLL},
+	{MACPHY, APLL},
+	{LCD, APLL},
+	{MSC, APLL},
+	{SSI, MPLL},
+	{CIM, APLL},
+	{PCM, MPLL},
+	{ISP, APLL},
+	{BCH, MPLL},
+	{I2S, MPLL},
+	{SRC_EOF,SRC_EOF}
+};
+
+#ifdef CONFIG_BOOT_ANDROID
+extern void boot_mode_select(void);
+#endif
+
+
+
+int board_early_init_f(void)
+{
+
+	return 0;
+}
+
+#ifdef CONFIG_USB_GADGET
+int jz_udc_probe(void);
+void board_usb_init(void)
+{
+	printf("USB_udc_probe\n");
+	jz_udc_probe();
+}
+#endif /* CONFIG_USB_GADGET */
+
+int misc_init_r(void)
+{
+#if 0 /* TO DO */
+	uint8_t mac[6] = { 0x12, 0x34, 0x56, 0x78, 0x9a, 0xbc };
+
+	/* set MAC address */
+	eth_setenv_enetaddr("ethaddr", mac);
+#endif
+	/* used for usb_dete */
+	gpio_set_pull_dir(GPIO_PB(22), 1);
+	return 0;
+}
+
+
+
+#ifdef CONFIG_MMC
+int board_mmc_init(bd_t *bd)
+{
+	jz_mmc_init();
+	return 0;
+}
+#endif
+
+int board_eth_init(bd_t *bis)
+{
+	return jz_net_initialize(bis);
+}
+
+#ifdef CONFIG_SPL_NAND_SUPPORT
+void nand_init(void)
+{
+}
+
+int nand_spl_load_image(uint32_t offs, unsigned int size, void *dst)
+{
+	return 0;
+}
+
+void nand_deselect(void)
+{
+}
+#endif
+
+#ifdef CONFIG_SPL_NOR_SUPPORT
+int spl_start_uboot(void)
+{
+	return 1;
+}
+#endif
+/* U-Boot common routines */
+int checkboard(void)
+{
+	puts("Board: bootes (Ingenic XBurst T15 SoC)\n");
+	return 0;
+}
+
+#ifdef CONFIG_SPL_BUILD
+
+void spl_board_init(void)
+{
+}
+
+#endif /* CONFIG_SPL_BUILD */
