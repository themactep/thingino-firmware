diff --git a/tools/ingenic-tools/nand_device/ato_nand.c b/tools/ingenic-tools/nand_device/ato_nand.c
new file mode 100644
index 0000000..1583f8a
--- /dev/null
+++ b/tools/ingenic-tools/nand_device/ato_nand.c
@@ -0,0 +1,21 @@
+#include <stdio.h>
+#include "nand_common.h"
+
+#define ATO_MID			    0x9B
+#define ATO_NAND_DEVICD_COUNT	    1
+
