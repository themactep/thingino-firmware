+	ecc_status = sfc_get_sta_rt(flash->sfc);
+
+	switch(device_id) {
+		case 0xE4 ... 0xE5:
+			switch((ret = ((ecc_status >> 4) & 0x3))) {
+				case 0x0 ... 0x1:
+					ret = 0;
+					break;
+				default:
+					ret = -EBADMSG;
+			}
+			break;
+		default:
+			printf("device_id err, it maybe don`t support this device, check your device id: device_id = 0x%02x\n", device_id);
+			ret = -EIO;   //notice!!!
+
+	}
+	return ret;
+}
