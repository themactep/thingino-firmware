+
+void char_xor ( unsigned char p_data[4][4], unsigned char q_data[4][4] )
+{
+	unsigned int i, j;
+	for(i=0;i<4;i++){
+		for(j=0;j<4;j++)
+			p_data[i][j]=p_data[i][j]^q_data[i][j];
+	}
+}
