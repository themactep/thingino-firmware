+	/* MAX Busytime for chip erase, unit: ms */
+	unsigned int ce_maxbusy;
+
+	/* Flash status register num, Max support 3 register */
+	int st_regnum;
+	/* Some NOR flash has different blocksize and block erase command,
+	 *          * One command with One blocksize. */
