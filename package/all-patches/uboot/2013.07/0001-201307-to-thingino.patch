+#elif (WDT_DIV == 64)
+#define TCSR_PRESCALE			TCSR_PRESCALE_64
+#elif (WDT_DIV == 256)
+#define TCSR_PRESCALE			TCSR_PRESCALE_256
+#elif (WDT_DIV == 1024)
+#define TCSR_PRESCALE			TCSR_PRESCALE_1024
+#endif
+
+#define RESET_DELAY_MS			4
+#define RTC_FREQ			32768
+
+#endif /* __WDT_H__ */
