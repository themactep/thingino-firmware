+ * SPDX-License-Identifier:	GPL-2.0+
+ */
+
+#ifndef __CLK_H__
+#define __CLK_H__
+
+#include <asm/arch/base.h>
+
+enum clk_id {
+	DDR,
+	HELIX,
+	MACPHY,
+	LCD,
+//	OTG,
+	I2S,
+	MSC,
+	MSC0 = MSC,
+	MSC1,
+	SSI,
+	CIM,
+	ISP,
+	CGU_CNT,
+	CPU = CGU_CNT,
+	H2CLK,
+	APLL,
+	MPLL,
+	VPLL,
+	EPLL,
+	EXCLK,
+	USBPHY,
+};
+
+struct cgu {
+	unsigned en:8;
+	unsigned off:8;
+	unsigned sel_bit:8;
+	unsigned sel_src:8;
+	unsigned char sel[4];
+	unsigned ce;
+	unsigned busy;
+	unsigned stop;
+};
+
+struct cgu_clk_src {
+	unsigned int cgu_clk;
+	unsigned int src;
+};
+#define SRC_EOF -1
+
+typedef union cpm_cpxpcr {
+	/** raw register data */
+	uint32_t d32;
+	/** register bits */
+	struct {
+		unsigned PLLEN:1;
+		unsigned reserved1:1;
+		unsigned LOCK:1;
+		unsigned PLL_ON:1;
+		unsigned reserved4:1;
+		unsigned PLLRG:3;
+		unsigned reserved8:3;
+		unsigned PLLOD:3;
+		unsigned PLLN:6;
+		unsigned PLLM:9;
+		unsigned reserved29:3;
+	} b; /* CPAPCR */
+} cpm_cpxpcr_t;
+
+unsigned int clk_get_rate(int clk);
