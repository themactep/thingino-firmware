+/* SLCD Status Register */
+#define SLCDC_STATE_BUSY			(1 << 0)
+
+/* SLCD Data Register */
+#define SLCDC_DATA_RS_DATA			(0 << 30)
+#define SLCDC_DATA_RS_COMMAND			(1 << 30)
+
+
+
+/*************************************************************************
+ * LCDC (LCD Controller)
+ *************************************************************************/
+
+#define LCDC_CFG				(LCDC0_BASE + 0x00)
