+
+#include <asm/arch/base.h>
+#include <linux/types.h>
+
+enum clk_id {
+	DDR,
+	AVPU,
+//	HELIX,
+	MACPHY,
+	RSA,
+	LCD,
+//	OTG,
+	I2S_SPK,
+	I2S_MIC,
+	MSC,
+	MSC0 = MSC,
+	MSC1,
+	SSI,
+	CIM,
+	ISP,
+	CGU_CNT,
+	CPU = CGU_CNT,
+	H2CLK,
+	APLL,
+	MPLL,
+	EXCLK,
+	USBPHY,
+};
+
+struct cgu {
+	unsigned en:8;
+	unsigned off:8;
+	unsigned sel_bit:8;
+	unsigned sel_src:8;
+	unsigned char sel[4];
+	unsigned ce;
+	unsigned busy;
+	unsigned stop;
+};
+
+struct cgu_clk_src {
+	unsigned int cgu_clk;
+	unsigned int src;
+};
+#define SRC_EOF -1
+
+typedef union cpm_cpxpcr {
+	/** raw register data */
+	uint32_t d32;
+	/** register bits */
+	struct {
+		unsigned PLLEN:1;
+		unsigned reserved1:1;
+		unsigned LOCK:1;
+		unsigned PLL_ON:1;
+		unsigned VCOPD:1;
+		unsigned POSTDIVPD:1;
+		unsigned PHASEPD:1;
+		unsigned DSMPD:1;
+		unsigned PLLOD0:3;
+		unsigned PLLOD1:3;
+		unsigned PLLN:6;
+		unsigned PLLM:12;
+	} b; /* CPAPCR */
+} cpm_cpxpcr_t;
+
