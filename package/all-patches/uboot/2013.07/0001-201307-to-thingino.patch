+#define LCDC_CFG_PALBP				(1 << 27)
+#define LCDC_CFG_TVEN				(1 << 26)
+#define LCDC_CFG_RECOVER			(1 << 25)
+#define LCDC_CFG_PSM				(1 << 23)
+#define LCDC_CFG_CLSM				(1 << 22)
+#define LCDC_CFG_SPLM				(1 << 21)
