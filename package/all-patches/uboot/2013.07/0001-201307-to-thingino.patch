+		unsigned tMINSR:4;
+		unsigned reserved12_15:4;
+		unsigned tCKE:3;
+		unsigned tRWCOV:2;
+		unsigned tEXTRW:3;
+		unsigned tRFC:6;
+		unsigned reserved30_31:2;
+	} b;
+} ddrc_timing4_t;
+
+typedef union ddrc_timing5 {
