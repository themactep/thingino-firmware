+	DDR,
+	AVPU,
+//	HELIX,
+	MACPHY,
+	RSA,
+	LCD,
+//	OTG,
+	I2S_SPK,
+	I2S_MIC,
+	MSC,
+	MSC0 = MSC,
+	MSC1,
+	SSI,
+	CIM,
