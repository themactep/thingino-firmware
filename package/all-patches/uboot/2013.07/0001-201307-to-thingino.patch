+
+/* ADC Status Register */
+#define SADC_ADSTATE_SLP_RDY	(1 << 7) // T31 delete
+#define SADC_ADSTATE_SLPEND	(1 << 5) // T31 delete
+#define SADC_ADSTATE_ARDY4	(1 << 4)
+#define SADC_ADSTATE_ARDY3	(1 << 3)
+#define SADC_ADSTATE_ARDY2	(1 << 2)
