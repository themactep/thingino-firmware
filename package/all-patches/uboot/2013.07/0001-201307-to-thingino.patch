+#define LCDC_CPOS_BPP_30			(7 << LCDC_CPOS_BPP_BIT)
+#define LCDC_CPOS_PREMULTI			(1 << 26)
+#define LCDC_CPOS_COEF_SLE_BIT			24
+#define LCDC_CPOS_COEF_SLE_MASK			(0x3 << LCDC_CPOS_COEF_SLE_BIT)
