+
+/*-------------------------------------------------------------------------*/
+/* DMA bounce buffer size, 16K is enough even for mass storage */
+enum {
+	SETUP_STAGE = 0,
+	DATA_STAGE,
+	STATUS_STAGE,
+};
+
+#define EP_FIFO_SIZE		4096
+#define EP_FIFO0_SIZE		64
