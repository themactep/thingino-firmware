+#define RECE_REQ		(1 << 2)
+#define OVER			(1 << 1)
+#define UNDER			(1 << 0)
+
+//For SFC_SCR
+#define	CLR_END			(1 << 4)
+#define CLR_TREQ		(1 << 3)
+#define CLR_RREQ		(1 << 2)
+#define CLR_OVER		(1 << 1)
+#define CLR_UNDR		(1 << 0)
