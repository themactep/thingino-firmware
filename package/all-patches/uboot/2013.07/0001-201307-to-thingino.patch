+		for (index = 0; index < total_nand; index++){
+			printf("the nand id is %x extid is %x  total_nand =%d\n",nand_info_table[index].id,nand_info_table[index].extid,total_nand);
+		}
+	}
+	return &nand_info_table[index];
+}
