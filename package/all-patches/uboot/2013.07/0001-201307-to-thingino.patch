diff --git a/arch/mips/cpu/xburst/t30/ddr_selfrefresh.c b/arch/mips/cpu/xburst/t30/ddr_selfrefresh.c
new file mode 100644
index 0000000..6dd32e2
--- /dev/null
+++ b/arch/mips/cpu/xburst/t30/ddr_selfrefresh.c
@@ -0,0 +1,148 @@
+#include <config.h>
+#include <common.h>
+#include <ddr/ddr_common.h>
+#include <generated/ddr_reg_values.h>
+
+#include <asm/io.h>
+#include <asm/arch/clk.h>
+
+
+static unsigned int * test_data;
+static unsigned int * test_data_uncache;
+
+void dump_reg()
