+// add: A=A+b, return A's new len
+int bi_add1 (int a_len, unsigned long *a_data, unsigned long b_d)
+{
+	unsigned long carry, sum;
+	int i, len_min;
+
+	if (a_len == 0) {
+		a_data[0] = b_d;
+		a_len = 1;
+	} else {
+		carry = b_d;
+		for (i=0; i<a_len; i++) {
+			sum = a_data[i] + carry;
+			carry = sum < a_data[i];
+			//printf("i=%d, sum=%lu, carry=%lu\n", i, sum, carry);
+			a_data[i] = sum;
+			if (carry==0) break;
+		}
+		if (carry) {
+			a_data[a_len] = carry;
+			a_len += carry;
+		}
+	}
+	return a_len;
+}
