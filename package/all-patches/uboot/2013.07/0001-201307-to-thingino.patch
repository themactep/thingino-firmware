+
+/* MCU of PDMA */
+#define DMCS	0x1030
+#define DMNMB	0x1034
+#define DMSMB	0x1038
+#define DMINT	0x103C
+#define NORMAL_MAILBOX_BIT 16
+
+/*channel n base*/
+#define DSA_N     0x0
+#define DTA_N     0x4
+#define DTC_N     0x8
+#define DRT_N     0xc
+#define DCS_N     0x10
+#define DCM_N     0x14
+#define DDA_N     0x18
+#define DSD_N     0x1c
