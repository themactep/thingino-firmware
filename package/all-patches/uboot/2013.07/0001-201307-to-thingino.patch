@@ -0,0 +1,412 @@
+#include <common.h>
+#include <malloc.h>
+#include <linux/types.h>
+#include <linux/string.h>
+#include <asm/io.h>
+#include <asm/gpio.h>
+#include <asm/errno.h>
+#include <asm/arch/base.h>
+#include <asm/arch/clk.h>
