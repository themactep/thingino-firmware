+
+typedef struct partition {
+        u8 boot_ind;         /* 0x80 - active */
+        u8 head;             /* starting head */
+        u8 sector;           /* starting sector */
+        u8 cyl;              /* starting cylinder */
+        u8 sys_ind;          /* What partition type */
+        u8 end_head;         /* end head */
