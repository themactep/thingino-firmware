+		unsigned LOCK:1;
+		unsigned PLL_ON:1;
+		unsigned VCOPD:1;
+		unsigned POSTDIVPD:1;
+		unsigned PHASEPD:1;
+		unsigned DSMPD:1;
+		unsigned PLLOD0:3;
+		unsigned PLLOD1:3;
+		unsigned PLLN:6;
+		unsigned PLLM:12;
+	} b; /* CPAPCR */
+} cpm_cpxpcr_t;
