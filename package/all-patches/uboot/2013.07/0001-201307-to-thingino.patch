+void w_iv ( FILE *fp, unsigned char iv[4][4])	// 	write iv to file
+{
+	unsigned char buff[32];
+	unsigned char tmp;
+	int i, j;
+	fprintf (fp, "@%08x\n", IV_ADDR);
+	for(i=0;i<4;i++)
+		for(j=0;j<4;j++)
+		{
+			tmp = iv[3-j][i] ;
+			sprintf(buff,"%02x\n",tmp);
+			fwrite(buff,1,3,fp);
+		}
+}
+void w_key128 ( FILE *fp, unsigned char key[4][4])	//	write key to file
+{
+	int i, j;
