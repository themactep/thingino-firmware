+
+static int column_bak __attribute__((unused));
+static int page_addr_bak __attribute__((unused));
+
+typedef enum{
+	TRANSFER,
+	RECEIVE,
+}tran_dir;
+
+#define DISABLE			0
+#define ENABLE			1
+#define RDID_NUM		2
+
+struct sfc_xfer{
+	int cmd;
+	int tran_dir;
