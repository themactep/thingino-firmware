+dsih_error_t mipi_dsih_hal_dpi_null_packet_size(struct dsi_device * dsi,
+						unsigned short size)
+{
+	if (size < 0x3ff) {	/* 10-bit field */
+		mipi_dsih_write_part(dsi, R_DSI_HOST_VID_NULL_SIZE, size, 0,
