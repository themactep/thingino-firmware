+#define TCSR_PCK_EN			(1 << 0)
+
+#define TCER_TCEN			(1 << 0)
+
+#define WDT_DIV				64
+#if (WDT_DIV == 1)
+#define TCSR_PRESCALE			TCSR_PRESCALE_1
+#elif (WDT_DIV == 4)
+#define TCSR_PRESCALE			TCSR_PRESCALE_4
