+* return 0 : it isn't inherent badblock
+* return -1 : it is inherent badblock
+*/
+static int is_inherent_badblock(nand_data *nddata, nand_flash *ndflash, unsigned int cs, unsigned int blockid, int rb_ready)
+{
+	return 0;
+}
