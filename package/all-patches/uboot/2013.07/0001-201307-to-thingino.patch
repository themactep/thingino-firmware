+// compare if A = B
+int bi_eq (int a_len, unsigned long *a_data, int b_len, unsigned long *b_data)
+{
+	int i;
+	if (a_len != b_len) return 0;
+	for (i=a_len-1; i>=0; i--)
+		if (a_data[i] != b_data[i]) return 0;
+
+	return 1;
+}
