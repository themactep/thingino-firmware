+	printf("#define	DDRP_MR3_VALUE			0x%08x\n", ddrp->mr3.d32);
+	printf("#define	DDRP_PTR0_VALUE			0x%08x\n", ddrp->ptr0.d32);
+	printf("#define	DDRP_PTR1_VALUE			0x%08x\n", ddrp->ptr1.d32);
