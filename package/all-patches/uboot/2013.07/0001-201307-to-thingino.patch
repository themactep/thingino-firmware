+	for (i=0; i<a_len; i++) {
+		carry = 0;
+		len = b_len;
+		for (j=0; j<b_len; j++) {
+			mul = b_data[j];
+			mul = mul * (unsigned long long)a_data[i] + carry;
+			data[j] = (unsigned long)(mul & (BIT_BASE-1));
+			carry = (unsigned long)(mul >> BIT_SHIFT);
