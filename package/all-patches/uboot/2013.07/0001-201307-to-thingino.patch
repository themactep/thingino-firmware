+
+/*PC0  SPI_CS   */
+#define CS(n)\
+     gpio_direction_output(byd_8991_pdata.gpio_spi_cs, n)
+
+/*PC1  SPI_CLK   */
+#define SCK(n)\
+     gpio_direction_output(byd_8991_pdata.gpio_spi_clk, n)
+
+/*PC10 SPI_MOSI */
+#define SDO(n)\
+	 gpio_direction_output(byd_8991_pdata.gpio_spi_mosi, n)
+
+/*PC11 SPI_MISO */
+#define SDI()\
+	gpio_get_value(byd_8991_pdata.gpio_spi_miso)
