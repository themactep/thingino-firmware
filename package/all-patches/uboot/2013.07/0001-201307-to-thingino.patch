+ * @cspnemc: soc cs count of nemc
+ * @bch_cnt: soc bch count
+ * @pdma_cnt: soc pdma count
+ * @ops_context: the context of nand_ops
+ **/
+typedef struct __nand_data {
+	unsigned short eccsize;
+	unsigned short spl_eccsize;
+	chip_info *cinfo;
+	io_base *base;
+	rb_info *rbinfo;
+	cs_info *csinfo;
