+
+//For SFC_DEV_CONF
+#define	SMP_DELAY_OFFSET	    (16)
+#define	SMP_DELAY_MSK		    (0x3 << SMP_DELAY_OFFSET)
+#define CMD_TYPE		        (1 << 15)
