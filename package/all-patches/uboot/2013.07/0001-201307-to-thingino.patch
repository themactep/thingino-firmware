+
+/* D2041_HP_NG2_REG */
+#define D2041_HP_NG2_RMS                    (3<<3)
+#define D2041_HP_NG2_RMS_SHIFT              3
+#define D2041_HP_NG2_REL                    (7<<0)
+#define D2041_HP_NG2_REL_SHIFT              0
