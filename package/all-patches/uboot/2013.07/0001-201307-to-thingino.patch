+
+//For SFC_SR
+#define FIFONUM_OFFSET	(16)
+#define FIFONUM_MSK		(0x7f << FIFONUM_OFFSET)
+#define BUSY_OFFSET		(5)
+#define BUSY_MSK		(0x3 << BUSY_OFFSET)
+#define END			    (1 << 4)
