+	memset(&cmd, 0, sizeof(cmd));
+
+	cmd.cmd = command;
+	cmd.dataen = ENABLE;
+	transfer.addr_len = addr_size;
+	transfer.data_dummy_bits = dummy_byte;
+	transfer.addr = addr;
+	transfer.len = len;
