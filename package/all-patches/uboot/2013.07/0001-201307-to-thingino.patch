+#define TCSR_PRESCALE			TCSR_PRESCALE_256
+#elif (WDT_DIV == 1024)
+#define TCSR_PRESCALE			TCSR_PRESCALE_1024
+#endif
+
+#define RESET_DELAY_MS			4
+#define RTC_FREQ			32768
+
+#endif /* __WDT_H__ */
diff --git a/arch/mips/include/asm/arch-jz4740/jz4740.h b/arch/mips/include/asm/arch-jz4740/jz4740.h
