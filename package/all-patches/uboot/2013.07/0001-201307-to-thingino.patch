+static int str2hex(const char *p, unsigned int *hex)
+{
+	int i = 0;
+	int ret = 0;
+	for (; i < 8; i++) {
+	//	printf("p[%d] = %c\n", i, p[i]);
+		*hex = *hex * 16;
+		if (p[i] >= '0' && p[i] <= '9')
+			*hex += (p[i] - '0');
+		else if (p[i] >= 'a' && p[i] <= 'f')
+			*hex += (p[i] - 'a' + 10);
+		else if (p[i] >= 'A' && p[i] <= 'F')
+			*hex += (p[i] - 'A' + 10);
+		else
+			ret = -1;
+	//	printf("result = %x\n", *hex);
+	}
+	return ret;
+}
