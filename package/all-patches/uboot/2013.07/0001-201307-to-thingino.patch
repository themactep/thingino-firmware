+#define	PT_RA		(REGS_OFFSET + 0x00)
+#define	PT_FP		(REGS_OFFSET + 0x04)
+#define	PT_T9		(REGS_OFFSET + 0x08)
+#define	PT_T8		(REGS_OFFSET + 0x0c)
+#define	PT_S7		(REGS_OFFSET + 0x10)
+#define	PT_S6		(REGS_OFFSET + 0x14)
