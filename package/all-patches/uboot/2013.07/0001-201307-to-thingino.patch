+#define NAND_BUSWIDTH_16    0x00000002
+#define NAND_BUSWIDTH_8      0x00000001
+
+enum {
+    VALUE_SET,
+    VALUE_CLR,
+};
+
+#define OPERAND_CONTROL(action, val, ret) do{                                   \
+    if (action == VALUE_SET)                                                    \
+        ret |= val;                                                             \
+    else                                                                        \
+        ret &= ~val;                                                            \
+} while(0)
