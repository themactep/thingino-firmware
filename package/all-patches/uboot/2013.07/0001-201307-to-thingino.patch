+{
+	char *id_9  = CONFIG_LCD_REGULATOR_9;
+	char *id_10 = CONFIG_LCD_REGULATOR_10;
+	struct regulator *lcd_regulator_9 = regulator_get(id_9);
+	struct regulator *lcd_regulator_10 = regulator_get(id_10);
