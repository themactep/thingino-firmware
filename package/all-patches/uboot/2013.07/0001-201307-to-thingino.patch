diff --git a/board/ingenic/burner_t15/u-boot-spl.lds b/board/ingenic/burner_t15/u-boot-spl.lds
new file mode 100644
index 0000000..36340ad
--- /dev/null
+++ b/board/ingenic/burner_t15/u-boot-spl.lds
@@ -0,0 +1,52 @@
+MEMORY { .sram : ORIGIN = CONFIG_SPL_TEXT_BASE,\
+		LENGTH = CONFIG_SPL_MAX_SIZE }
+
+MEMORY { .ginfo : ORIGIN = CONFIG_SPL_GINFO_BASE,\
+		LENGTH = CONFIG_SPL_GINFO_SIZE }
+
+OUTPUT_ARCH(mips)
+ENTRY(_start)
+SECTIONS
+{
+	.text      :
+	{
+		__start = .;
+		*(.start_section*)
+		*(.text*)
+	} >.sram
+
+	. = ALIGN(4);
+	.rodata : { *(SORT_BY_ALIGNMENT(.rodata*)) } >.sram
+
+	. = ALIGN(4);
+	.data : { *(SORT_BY_ALIGNMENT(.data*)) } >.sram
+
+	. = ALIGN(4);
+	__image_copy_end = .;
+
+	.bss : {
+		. = ALIGN(4);
+		__bss_start = .;
+		*(.sbss.*)
+		*(.bss.*)
+		*(COMMON)
+		. = ALIGN(4);
+		__bss_end = .;
+	} >.sram
+
+	. = ALIGN(4);
+	.ginfo : { *(SORT_BY_ALIGNMENT(.ginfo*)) } >.ginfo
+
+	/DISCARD/ : {
+		*(.dynbss)
+		*(.dynstr)
+		*(.dynamic)
+		*(.interp)
+		*(.hash)
+		*(.gnu.*)
+		*(.plt)
+		*(.got.plt)
+		*(.rel.plt)
+		*(.rel.dyn)
+	}
+}
