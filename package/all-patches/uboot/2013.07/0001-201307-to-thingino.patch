+static void __send_cmd_to_nand(void *cmdport, unsigned char cmd, unsigned int dly_f,unsigned int dly_b, unsigned char busy)
+{
+	unsigned int reg = NAND_NFCM_DLYF(dly_f) | NAND_NFCM_DLYB(dly_b) | NAND_NFCM_CMD(cmd);
+	if(busy)
