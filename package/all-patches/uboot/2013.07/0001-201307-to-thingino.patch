+	if (speed == USB_SPEED_HIGH) {
+		ep0_fifo_size = 64;
+		ep_fifo_size = 512;
+		/* ep_fifo_size2 = 1024; */
+		dev->gadget.speed = USB_SPEED_HIGH;
