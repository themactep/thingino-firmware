+		char_cpy ( iv, data );
+		w_encrypt_data ( fp, data, ii );
+#ifdef DISPLAY_ON
+		printf ( "<<encrypt  data%d:\n", ii );
+		print_char44 ( data );
+#endif
+	}
+	fclose ( fp );
+}
