+#define ZM_MEMORY_SIZE  (8*1024*1024)
+struct Ghandle{
+	int pagesize;
+	int pageperblock;
+	int nd_rbcnt;
+	unsigned int  sectorid;
+	int zm_handle;
+	int  pphandle[MAX_PARTITION_NUM];
