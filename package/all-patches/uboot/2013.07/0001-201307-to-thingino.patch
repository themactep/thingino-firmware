+static int jz_ep_disable(struct usb_ep *_ep)
+{
+	struct jz_ep *ep;
+	unsigned long flags;
+
+	printf("%s: %p\n", __func__, _ep);
+
+	ep = container_of(_ep, struct jz_ep, ep);
+	if (!_ep || !ep->desc) {
+		printf("%s: %s not enabled\n", __func__,
+		      _ep ? ep->ep.name : NULL);
