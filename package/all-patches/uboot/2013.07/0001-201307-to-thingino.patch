+		.name = "OUT8",
+		.id = act8600_out8,
+		.n_voltages = ACT8600_NUM_LODX,
+		.ops = &act8600_ops,
+#if defined(CONFIG_PMU_ACT8600_OUT8_MIN) && defined(CONFIG_PMU_ACT8600_OUT8_MAX)
+		.min_uV = CONFIG_PMU_ACT8600_OUT8_MIN,
+		.max_uV = CONFIG_PMU_ACT8600_OUT8_MAX,
+#else
