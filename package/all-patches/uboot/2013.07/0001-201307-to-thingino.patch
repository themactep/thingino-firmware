+#ifdef CONFIG_BATTERYDET_LED
+extern void show_led_status_charge_full(void);
+extern void show_led_status_charging(void);
+extern void show_led_status_low_power(void);
+#endif
+#ifdef CONFIG_BATTERYDET_LED
+void show_charging_led_status(void)
+{
+	int ret = 0;
+	int reg_val_status;
+	int reg_val_usb;
+	int reg_val;
+	int count_n = 0;
+
+	while(1) {
