+	unsigned en:8;
+	unsigned off:8;
+	unsigned sel_bit:8;
+	unsigned sel_src:8;
+	unsigned char sel[4];
+	unsigned ce;
+	unsigned busy;
+	unsigned stop;
+};
+
+struct cgu_clk_src {
+	unsigned int cgu_clk;
+	unsigned int src;
+};
+#define SRC_EOF -1
+
+typedef union cpm_cpxpcr {
+	/** raw register data */
+	uint32_t d32;
