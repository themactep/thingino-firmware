+	fs_nand->id_manufactory = 0xA1;
+	fs_nand->id_device_list = device_id;
+	fs_nand->id_device_count = FM_DEVICES_NUM;
+
+	fs_nand->ops.nand_read_ops.get_feature = fm_get_read_feature;
