+int utils_dbg_level = DUG_LEVEL_WARNING;
+int libops_dbg_level = DUG_LEVEL_WARNING;
+
+extern int vsprintf(char *str,char *fmt,va_list ap);
+extern void serial_putc (const char c);
+
+char buf[256];
+int __ndprint(char *fmt, ...)
+{
+	char *p = buf;
+	va_list ap;
+
+	va_start(ap, fmt);
+	vsprintf(p, fmt, ap);
+	va_end(ap);
+	while(*p)
+		serial_putc(*p++);
+
+	return 0;
+}
