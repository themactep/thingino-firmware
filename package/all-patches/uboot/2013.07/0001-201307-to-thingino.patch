+	nfi->clk_enable = nfi_clk_enable;
+	nfi->clk_disable = nfi_clk_disable;
+
+	/* bch callbacks */
+	bch->readl = bch_readl;
+	bch->writel = bch_writel;
+	bch->clk_enable = bch_clk_enable;
+	bch->clk_disable = bch_clk_disable;
+
+	return 0;
