+static uint32_t local_crc32(uint32_t crc,unsigned char *buffer, uint32_t size)
+{
+	uint32_t i;
+	for (i = 0; i < size; i++) {
+		crc = crc_table[(crc ^ buffer[i]) & 0xff] ^ (crc >> 8);
+	}
+	return crc ;
+}
