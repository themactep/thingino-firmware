+
+
+//For SFC_GLB
+#define	TRAN_DIR		        (1 << 13)
+#define TRAN_DIR_OFFSET         (13)
+#define GLB_TRAN_DIR_WRITE      (1)
+#define GLB_TRAN_DIR_READ       (0)
+#define	THRESHOLD_OFFSET	    (7)
