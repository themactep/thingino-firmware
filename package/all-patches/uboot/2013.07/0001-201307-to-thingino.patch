+	unsigned char buff[32];
+	fprintf(fp,"@%08x\n",KEY_ADDR);
+	for(i=0;i<4;i++)
+		for(j=0;j<4;j++)
+		{
+			tmp = key[3-j][i] ;
+			sprintf(buff,"%02x\n",tmp);
+			fwrite(buff,1,3,fp);
