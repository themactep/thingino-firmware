+static void MD5_memcpy (output, input, len)
+POINTER output;
+POINTER input;
+unsigned int len;
+{
+  unsigned int i;
+  for (i = 0; i < len; i++)
+  	output[i] = input[i];
+}
+
+static void MD5_memset (output, value, len)
+POINTER output;
+int value;
+unsigned int len;
+{
+  unsigned int i;
+  for (i = 0; i < len; i++)
+  	((char *)output)[i] = (char)value;
+}
