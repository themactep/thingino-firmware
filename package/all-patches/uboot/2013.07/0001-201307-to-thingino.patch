+ * \return returns the count value of collision.
+ */
+u32 synopGMAC_get_tx_collision_count(u32 status)
+{
+	return ((status & DescTxCollMask) >> DescTxCollShift);
+}
+u32 synopGMAC_is_exc_tx_collisions(u32 status)
+{
