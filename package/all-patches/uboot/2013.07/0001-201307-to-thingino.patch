+void clk_prepare(void);
+void clk_init(void);
+void enable_uart_clk(void);
+enum otg_mode_t {
+	OTG_MODE = 0,
+	DEVICE_ONLY_MODE,
+	HOST_ONLY_MODE,
+};
+void otg_phy_init(enum otg_mode_t mode,unsigned extclk);
