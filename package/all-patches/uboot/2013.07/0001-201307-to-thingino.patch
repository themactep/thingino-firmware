+		goto err;
+	}
+	ret = nand_bch_decode_complete(bch_context, &pipenode);
+err:
+	nand_bch_close(bch_context);
+	nand_io_chip_deselect(nd_errpt_info.io_context, chip_index);
+	ndd_debug("%s ret= %d\n",__func__,ret);
