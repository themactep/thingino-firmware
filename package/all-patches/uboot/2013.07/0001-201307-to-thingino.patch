+#define R_DSI_HOST_VERSION                0x000
+#define R_DSI_HOST_PWR_UP                 0x004
+#define R_DSI_HOST_CLKMGR_CFG             0x008
+#define R_DSI_HOST_DPI_VCID               0x00c
