+	xtx_nand->id_device_count = XTX_DEVICES_NUM;
+
+	xtx_nand->ops.nand_read_ops.get_feature = xtx_get_read_feature;
+	return jz_spinand_register(xtx_nand);
+}
+SPINAND_MOUDLE_INIT(xtx_nand_init);
