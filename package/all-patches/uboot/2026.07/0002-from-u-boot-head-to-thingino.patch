diff --git a/Makefile b/Makefile
index c5cc8276fa..987d8bb6f7 100644
--- a/Makefile
+++ b/Makefile
@@ -1369,7 +1369,13 @@ quiet_cmd_pad_cat = CAT     $@
 cmd_pad_cat = $(cmd_objcopy) && $(append) || { rm -f $@; false; }
 
 quiet_cmd_lzma = LZMA    $@
-cmd_lzma = lzma -c -z -k -9 $< > $@
+# Use lzma-utils preset -3: it writes the *known* uncompressed size in
+# the .lzma header (U-Boot's LzmaTools rejects xz's "unknown size"
+# streams) and uses only a 512 KiB dictionary, so the SPL LZMA
+# decoder's malloc(dictSize) stays small. -3 is within 0.01x of -9's
+# ratio for a U-Boot-sized image. (Plain 'lzma -9' would declare a
+# 64 MiB dict and OOM the SPL heap.)
+cmd_lzma = lzma -c -z -k -3 $< > $@
 
 cfg: u-boot.cfg
 
diff --git a/arch/mips/Kconfig b/arch/mips/Kconfig
index 75913d4f1a..78564f7ebb 100644
--- a/arch/mips/Kconfig
+++ b/arch/mips/Kconfig
@@ -95,6 +95,27 @@ config ARCH_JZ47XX
 	select OF_CONTROL
 	select DM
 
+config ARCH_XBURST
+	bool "Support Ingenic XBurst T-Series"
+	select SUPPORT_SPL
+	select HAS_FIXED_TIMER_FREQUENCY
+	select OF_CONTROL
+	select DM
+	select SPL_DM if SPL
+	# Ingenic vendor kernels read CP0_EBASE rather than forcing the base
+	# to 0x80000000 (the XBurst1 3.10 kernel faults very early; XBurst2 SMP
+	# secondaries vector off it), so U-Boot must restore the exception
+	# vector base before booting Linux - otherwise the kernel's early
+	# exceptions land in U-Boot's handler. Generic mechanism, handled in
+	# arch/mips/lib/{traps,bootm}.c via trap_restore().
+	select RESTORE_EXCEPTION_VECTOR_BASE
+	help
+	  Support for Ingenic XBurst T-Series SoCs - XBurst1 (T10/T20/T21/
