+#define reg_a_l_cs0_dq3_invdelaysel		(DDRPAPB_BASE + 0x21c), 17, 9
+#define reg_a_l_cs0_dq3_invdelayselrx		(DDRPAPB_BASE + 0x22c), 7 , 0
