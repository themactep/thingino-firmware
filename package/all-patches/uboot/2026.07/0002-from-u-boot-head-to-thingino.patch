+static int t41_clk_gate(struct clk *clk, bool enable)
+{
+	struct t41_cgu_priv *p = dev_get_priv(clk->dev);
+	const struct t41_clk_desc *d;
+
+	if (clk->id >= T41_CLK_COUNT)
+		return -EINVAL;
+
+	d = &t41_clks[clk->id];
+	if (d->gate_reg == NO_GATE || !d->gate_reg)
+		return 0;
