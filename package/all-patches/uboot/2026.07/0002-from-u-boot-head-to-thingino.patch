+
+&msc0 {
+	status = "okay";
+	bus-width = <4>;
+	broken-cd;
+};
+
+&otg {
+	status = "okay";
+	dr_mode = "peripheral";		/* gadget bind for DFU/g_dnl */
+};
+
+/*
+ * Ethernet in the DFU loader, like the other XBurst1 loaders: the
+ * MAC-PHY clock derives from the per-variant MPLL via the CGU clk
+ * driver. No PHY reset GPIO here - board-specific; a wired-ethernet
+ * board DT declares its own ingenic,reset-gpio.
+ */
+&gmac {
+	status = "okay";
+};
diff --git a/arch/mips/dts/t20-isvp-uboot-common.dtsi b/arch/mips/dts/t20-isvp-uboot-common.dtsi
new file mode 100644
index 0000000000..99e7b4eb03
--- /dev/null
+++ b/arch/mips/dts/t20-isvp-uboot-common.dtsi
@@ -0,0 +1,186 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Shared U-Boot overlay for the Ingenic ISVP-T20 SFC-NOR leaf DTs.
+ * Each per-SKU <leaf>-u-boot.dtsi is a one-line include of this file.
+ *
+ * Provides the binman image description for the SFC-NOR boot. The T20
+ * mask ROM SFC-NOR boot path is the common XBurst1 one (the 2 KiB header
+ * CRC7+length finalized by the ingenic-t31-spl binman etype - that header
+ * format is family-generic, emitted by the shared start.S, not
+ * T31-specific):
+ *
+ *   u-boot-spl-t20.bin       : SPL with the finalized boot header.
+ *   u-boot-with-spl-lzma.bin : headered SPL at offset 0 and LZMA U-Boot
+ *                              at the SPL-loader offset.
+ *
+ * Also tags the SPL-needed nodes bootph-all so they survive into the SPL
+ * devicetree: the SPL probes the DDR node (UCLASS_RAM) and loads U-Boot
+ * proper from NOR via the DM SFC driver. T20 has only PA..PC (no PD).
+ */
+
+/ {
+	binman: binman {
+		multiple-images;
+	};
+};
+
+&binman {
+#if defined(CONFIG_SPL_MMC)
+	/*
+	 * MSC/SD-card boot image (isvp_t20n_msc0). The XBurst1 SD ROM reads the
+	 * headered first stage (the TPL) off the card, checks the MSPL magic and
+	 * jumps to it - no INGE/descriptor block needed; the reader sets the SD
+	 * clock itself (see mach-xburst/msc.c). So the image is just the plain
+	 * MSPL-headered TPL + SPL, like the XBurst2 T40/T41. SD layout: TPL at
+	 * sector 34 (0x4400), the DRAM-resident SPL at 0x10000 (the TPL reads it
+	 * bare-metal), U-Boot at SYS_MMCSD_RAW_MODE_U_BOOT_SECTOR (0x180 = 0x30000).
+	 */
+	u-boot-tpl-t20-msc {
+		filename = "u-boot-tpl-t20-msc.bin";
+
+		ingenic-t31-spl {
+			filename = "tpl/u-boot-tpl.bin";
+		};
+	};
+
+	mmc {
+		filename = "u-boot-with-tpl-mmc-lzma.bin";
+		pad-byte = <0x00>;
+
+		tpl {
+			type = "blob";
+			offset = <0x4400>;
+			filename = "u-boot-tpl-t20-msc.bin";
+		};
+
+		spl {
+			type = "blob";
+			offset = <0x10000>;
+			filename = "spl/u-boot-spl.bin";
+		};
+
+		u-boot {
+			type = "blob";
+			offset = <0x30000>;
+			filename = "u-boot-lzma.img";
+		};
+	};
+#elif defined(CONFIG_TPL)
+	/*
+	 * TPL boot chain (all within the 320 KiB / 0x50000 bootloader budget
+	 * before the environment): the mask ROM loads the headered TPL at
+	 * offset 0; the TPL brings up DDR and reads the DRAM-resident SPL from
+	 * 0x8000 (= T20_TPL_SPL_NOR_OFFS); the SPL reads U-Boot from 0x18000
+	 * (= CONFIG_SYS_SPI_U_BOOT_OFFS). Env stays at 0x50000.
+	 */
+	u-boot-tpl-t20 {
+		filename = "u-boot-tpl-t20.bin";
+
+		ingenic-t31-spl {
+			filename = "tpl/u-boot-tpl.bin";
+		};
+	};
+
+	flash {
+		filename = "u-boot-with-tpl-lzma.bin";
+		pad-byte = <0xff>;
+
+		tpl {
+			type = "blob";
+			offset = <0x0>;
+			filename = "u-boot-tpl-t20.bin";
+		};
+
+		spl {
+			type = "blob";
+			offset = <0x8000>;
+			filename = "spl/u-boot-spl.bin";
+		};
+
+		u-boot {
+			type = "blob";
+			offset = <0x18000>;
+			filename = "u-boot-lzma.img";
+		};
+	};
+#else
+	u-boot-spl-t20 {
+		filename = "u-boot-spl-t20.bin";
+
+		ingenic-t31-spl {
+			filename = "spl/u-boot-spl.bin";
+		};
+	};
+
+	flash {
+		filename = "u-boot-with-spl-lzma.bin";
+		pad-byte = <0xff>;
+
+		spl {
+			type = "blob";
+			offset = <0x0>;
+			filename = "u-boot-spl-t20.bin";
+		};
+
+		u-boot {
+			type = "blob";
+			offset = <0x10000>;
+			filename = "u-boot-lzma.img";
+		};
+	};
+#endif
+};
+
+/*
+ * Phase tags. The SPL/TPL devicetrees are fdtgrep-filtered out of the single
+ * U-Boot dt.dtb by these bootph tags (TPL keeps bootph-all + bootph-pre-sram;
+ * SPL keeps bootph-all + bootph-pre-ram) - they are NOT re-preprocessed per
+ * phase, so the split must be expressed in the tags, not with #ifdef.
+ *
+ * The TPL is a cache-as-RAM DDR loader whose ONLY DM device is the DDR
+ * controller: its probe brings up PLL + DDR, then it hand-loads the SPL with
+ * bare-metal SFC/serial helpers (no DM SFC/pinctrl/gpio/uart). So &ddr is the
+ * only node tagged for all phases; tagging the full NOR/console set for the
+ * TPL would pull in uclasses the minimal TPL doesn't build and fail the
+ * OF_PLATDATA scan with -EINVAL.
+ *
+ * Every other node is tagged bootph-pre-ram + bootph-some-ram (= bootph-all
+ * minus the TPL/pre-sram phase): present in the SPL DM NOR boot and bound
+ * pre-relocation in U-Boot proper exactly as before, absent from the TPL.
+ */
+&ddr { bootph-all; };		/* the TPL's only DM device */
+
+&exclk { bootph-pre-ram; bootph-some-ram; };
+&rtclk { bootph-pre-ram; bootph-some-ram; };
+&cgu { bootph-pre-ram; bootph-some-ram; };
+&pinctrl { bootph-pre-ram; bootph-some-ram; };
+&gpa { bootph-pre-ram; bootph-some-ram; };
+&gpb { bootph-pre-ram; bootph-some-ram; };
+&gpc { bootph-pre-ram; bootph-some-ram; };
+&uart1 { bootph-pre-ram; bootph-some-ram; };
+
+#if defined(CONFIG_SPL_MMC)
+/*
+ * MSC/SD boot: the SPL probes the native jz_mmc controller (the TPL's SD read
+ * is bare-metal, so the TPL devicetree still needs only &ddr). msc0 is
+ * status="disabled" in t20.dtsi - the NOR boards never use it - so enable it
+ * here and tag it + its pins for the SPL and pre-reloc U-Boot phases.
+ */
+&msc0 {
+	bootph-pre-ram;
+	bootph-some-ram;
+	broken-cd;		/* the SD is the boot medium - always present */
+	status = "okay";
+};
+&pins_mmc0 { bootph-pre-ram; bootph-some-ram; };
+#else
+&pins_sfc { bootph-pre-ram; bootph-some-ram; };
+&sfc {
+	bootph-pre-ram;
+	bootph-some-ram;
+	flash@0 {
+		bootph-pre-ram;
+		bootph-some-ram;
+	};
+};
+#endif
diff --git a/arch/mips/dts/t20-isvp.dtsi b/arch/mips/dts/t20-isvp.dtsi
new file mode 100644
index 0000000000..b5ec2b2fb3
--- /dev/null
+++ b/arch/mips/dts/t20-isvp.dtsi
@@ -0,0 +1,68 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Ingenic ISVP-T20 shared board body (SFC-NOR, USB host).
+ *
+ * The per-SKU leaf .dts files (t20n-isvp.dts, t20l-isvp.dts,
+ * t20x-isvp.dts) include this and supply the DDR node's per-SKU
+ * "ingenic,sdram-params" array, consumed by the shared DWC DDR driver
+ * (ddr_t20.c). The matching <leaf>-u-boot.dtsi pulls in
+ * t20-isvp-uboot-common.dtsi (binman image + SPL bootph).
+ */
+
+#include <dt-bindings/gpio/gpio.h>
+#include "t20.dtsi"
+
+/ {
+	compatible = "ingenic,isvp-t20", "ingenic,t20";
+	model = "Ingenic ISVP-T20 (SFC NOR)";
+
+	aliases {
+		serial1 = &uart1;
+	};
+
+	chosen {
+		stdout-path = "serial1:115200n8";
+	};
+
+	memory@0 {
+		device_type = "memory";
+		reg = <0x0 0x04000000>;	/* 64 MB DDR2 (T20N); real size from dram_init */
+	};
+};
+
+&uart1 {
+	status = "okay";
+};
+
+&sfc {
+	status = "okay";
+
+	flash@0 {
+		compatible = "jedec,spi-nor";
+		reg = <0>;
+		spi-max-frequency = <50000000>;
+	};
+};
+
+&msc0 {
+	status = "okay";
+	bus-width = <4>;
+	broken-cd;	/* no card-detect line wired on the ISVP board */
+};
+
+&otg {
+	status = "okay";
+};
+
+&aic {
+	status = "okay";
+};
+
+&codec {
+	status = "okay";
+	ingenic,spk-gpio = <&gpb 31 GPIO_ACTIVE_HIGH>;
+};
+
+&sound {
+	status = "okay";
+};
diff --git a/arch/mips/dts/t20.dtsi b/arch/mips/dts/t20.dtsi
new file mode 100644
index 0000000000..5652d5b192
--- /dev/null
+++ b/arch/mips/dts/t20.dtsi
@@ -0,0 +1,270 @@
+// SPDX-License-Identifier: GPL-2.0+
+
+#include <dt-bindings/clock/ingenic,t20-cgu.h>
+
+/ {
+	#address-cells = <1>;
+	#size-cells = <1>;
+	compatible = "ingenic,t20";
+
+	cpus {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		cpu0: cpu@0 {
+			device_type = "cpu";
+			compatible = "ingenic,xburst", "mips,mips32r2";
+			reg = <0>;
+		};
+	};
+
+	cpuintc: interrupt-controller {
+		#address-cells = <0>;
+		#interrupt-cells = <1>;
+		interrupt-controller;
+		compatible = "mti,cpu-interrupt-controller";
+	};
+
+	exclk: exclk {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <24000000>;
+	};
+
+	rtclk: rtclk {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <32768>;
+	};
+
+	/*
+	 * CGU (Clock/Power Manager). Same XBurst1 leaf-clock map as T31
+	 * (with VPLL, like T31); the PLL register encoding differs
+	 * (cpm_cpxpcr_t) and the clk-t20 driver handles that. The SPL
+	 * programs the PLLs/dividers; this driver runs in U-Boot proper
+	 * and recalculates PLL rates + provides rate/gate for the leaf
+	 * clocks (SFC, MMC, GMAC). Driver accesses CPM via KSEG1.
+	 */
+	cgu: clock-controller@10000000 {
+		compatible = "ingenic,t20-cgu", "simple-mfd";
+		reg = <0x10000000 0x1000>;
+		#clock-cells = <1>;
+		clocks = <&exclk>, <&rtclk>;
+		clock-names = "ext", "rtc";
+		bootph-pre-ram;
+		/*
+		 * Pin the kernel-consumed leaf muxes to the vendor
+		 * contract, measured on silicon (bench Wyze V2 T20X,
+		 * legacy loader): VPU and ISP from MPLL, CIM from VPLL
+		 * (the cgu probe brings VPLL up at 1200 MHz with the
+		 * measured vendor word). The 3.10 kernel computes leaf
+		 * rates on whatever parent it inherits, so the inherited
+		 * selector is the contract. Parents only, no rates.
+		 */
+		assigned-clocks = <&cgu T20_CLK_VPU>,
+				  <&cgu T20_CLK_ISP>,
+				  <&cgu T20_CLK_CIM>,
+				  <&cgu T20_CLK_GMAC>;
+		assigned-clock-parents = <&cgu T20_CLK_MPLL>,
+					 <&cgu T20_CLK_MPLL>,
+					 <&cgu T20_CLK_VPLL>,
+					 <&cgu T20_CLK_MPLL>;
+	};
+
+	/*
+	 * DDR controller (Synopsys DWC PHY - the only XBurst1 camera SoC
+	 * that is not Innophy). One compatible for every T20 SKU; the board
+	 * leaf .dts supplies the per-SKU "ingenic,sdram-params" u32 array
+	 * (26 cells = struct ingenic_t20_ddr_params, drivers/ram/ingenic/
+	 * ddr_t20.h; shared with T10), serialized in this order:
+	 *   [0..2]   SPL PLL setpoints: CPAPCR, CPMPCR, CPCCR
+	 *   [3]      total DRAM size in bytes
+	 *   [4..6]   DDRC_CFG, DDRC_MMAP0, DDRC_MMAP1
+	 *   [7..12]  DDRC_TIMING1..6
+	 *   [13..15] DWC PHY DCR, DTPR0, DTPR1
+	 *   [16..20] DDRC_REMAP1..5
+	 *   [21]     CPM_DDRCDR divider (DDR = MPLL/(cdr+1))
+	 *   [22..25] DDRC_REFCNT, DWC PHY MR0, PTR0, PTR1
+	 * bootph-all is added by the leaf's shared u-boot.dtsi.
+	 */
+	ddr: memory-controller@134f0000 {
+		compatible = "ingenic,t20-ddr-dwc";
+		reg = <0x134f0000 0x1000>;
+	};
+
+	/*
+	 * TCU container; U-Boot only needs the watchdog (for sysreset).
+	 * The generic jz4760-tcu / jz4780-watchdog fallbacks bind on
+	 * T20 (same IP as T31). The watchdog self-clocks from the 32 kHz
+	 * RTC.
+	 */
+	tcu: timer@10002000 {
+		compatible = "ingenic,t20-tcu", "ingenic,jz4760-tcu",
+			     "simple-mfd";
+		reg = <0x10002000 0x1000>;
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges = <0x0 0x10002000 0x1000>;
+
+		watchdog: watchdog@0 {
+			compatible = "ingenic,t20-watchdog",
+				     "ingenic,jz4780-watchdog";
+			reg = <0x0 0x10>;
+		};
+	};
+
+	uart1: serial@10031000 {
+		compatible = "ingenic,jz4780-uart";
+		reg = <0x10031000 0x100>;
+		reg-shift = <2>;
+		clock-frequency = <24000000>;
+		status = "disabled";
+	};
+
+	/*
+	 * SFC SPI-NOR controller - identical IP to T31; the in-tree
+	 * ingenic_sfc driver matches "ingenic,t31-sfc" (kept as the
+	 * compatible since that is the only match string; the block and
+	 * register map are the same on T20).
+	 */
+	sfc: spi@13440000 {
+		compatible = "ingenic,t31-sfc";
+		reg = <0x13440000 0x10000>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+		clocks = <&cgu T20_CLK_SFC>;
+		spi-max-frequency = <50000000>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pins_sfc>;
+		status = "disabled";
+	};
+
+	msc0: mmc@13450000 {
+		compatible = "ingenic,t31-mmc";
+		reg = <0x13450000 0x1000>;
+		clocks = <&cgu T20_CLK_MSC0>;
+		clock-names = "mmc";
+		cap-sd-highspeed;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pins_mmc0>;
+		status = "disabled";
+	};
+
+	/*
+	 * Pin controller + GPIO. Same XBurst1 engine as T31 but only
+	 * three banks PA..PC (T20 has no PD), 0x1000 stride; the
+	 * ingenic,t20-pinctrl/-gpio compatibles are
+	 * handled by the shared pinctrl-ingenic driver.
+	 */
+	pinctrl: pinctrl@10010000 {
+		compatible = "ingenic,t20-pinctrl";
+		reg = <0x10010000 0x1000>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		gpa: gpio@0 {
+			compatible = "ingenic,t20-gpio";
+			reg = <0>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		gpb: gpio@1 {
+			compatible = "ingenic,t20-gpio";
+			reg = <1>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		gpc: gpio@2 {
+			compatible = "ingenic,t20-gpio";
+			reg = <2>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		pins_sfc: sfc {
+			function = "sfc";
+			groups = "sfc-data";
+		};
+
+		pins_mmc0: mmc0 {
+			function = "mmc0";
+			groups = "mmc0-1bit", "mmc0-4bit";
+		};
+
+		pins_mac: mac {
+			function = "mac";
+			groups = "mac-rmii";
+		};
+	};
+
+	/*
+	 * GMAC: Synopsys DesignWare MAC. ingenic,mode-reg is the CPM
+	 * GMAC-PHY-control register (CPM + 0xe8). Same glue as T31.
+	 */
+	gmac: ethernet@134b0000 {
+		compatible = "ingenic,t20-gmac";
+		reg = <0x134b0000 0x2000>;
+		phy-mode = "rmii";
+		max-speed = <100>;
+		clocks = <&cgu T20_CLK_GMAC>;
+		ingenic,mode-reg = <0x100000e8>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pins_mac>;
+		status = "disabled";
+	};
+
+	/*
+	 * DWC2 USB OTG. Production default dr_mode = "host" (the dwc2
+	 * host data-path fixes gate on dr_mode=="host"). The DFU/flash
+	 * loader uses a separate DT (t20-isvp-dfu) that overrides this
+	 * to "peripheral" for the dwc2_udc_otg gadget - one DM bind per
+	 * node; dual-role is a deliberate per-build DT choice.
+	 */
+	otg: usb@13500000 {
+		compatible = "snps,dwc2";
+		reg = <0x13500000 0x40000>;
+		dr_mode = "host";
+		clocks = <&cgu T20_CLK_OTG>;
+		g-rx-fifo-size = <512>;
+		g-np-tx-fifo-size = <16>;
+		g-tx-fifo-size = <256 256 16 16 16>;
+		status = "disabled";
+	};
+
+	/*
+	 * Audio: AIC (I2S) controller + on-chip codec. The codec is the
+	 * I2S master and self-clocks; the AIC runs PIO playback for the
+	 * `sound` command. The speaker-amp enable GPIO is board-specific
+	 * (set in the board .dts; SDK default is PB31 active-high).
+	 */
+	aic: audio-controller@10020000 {
+		compatible = "ingenic,t20-aic";
+		clocks = <&cgu T20_CLK_MPLL>;
+		clock-names = "mpll";
+		reg = <0x10020000 0x100>;
+		#sound-dai-cells = <0>;
+		status = "disabled";
+	};
+
+	codec: audio-codec@10021000 {
+		compatible = "ingenic,t20-codec";
+		reg = <0x10021000 0x140>;
+		#sound-dai-cells = <0>;
+		status = "disabled";
+	};
+
+	sound: sound {
+		compatible = "ingenic,t20-sound";
+		status = "disabled";
+
+		cpu {
+			sound-dai = <&aic>;
+		};
+
+		codec {
+			sound-dai = <&codec>;
+		};
+	};
+};
diff --git a/arch/mips/dts/t20l-isvp-dfu-u-boot.dtsi b/arch/mips/dts/t20l-isvp-dfu-u-boot.dtsi
new file mode 100644
index 0000000000..88e33d941b
--- /dev/null
+++ b/arch/mips/dts/t20l-isvp-dfu-u-boot.dtsi
@@ -0,0 +1,2 @@
+// SPDX-License-Identifier: GPL-2.0+
+#include "t20-isvp-dfu-uboot-common.dtsi"
diff --git a/arch/mips/dts/t20l-isvp-dfu.dts b/arch/mips/dts/t20l-isvp-dfu.dts
new file mode 100644
index 0000000000..db51d46324
--- /dev/null
+++ b/arch/mips/dts/t20l-isvp-dfu.dts
@@ -0,0 +1,31 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Ingenic ISVP-T20L, DFU/USB-boot loader variant (lowest T20 SKU; all T20
+ * are DDR2, so the one loader flashes every T20 SKU).
+ */
+
+/dts-v1/;
+
+#include "t20-isvp-dfu.dtsi"
+
+/ {
+	model = "Ingenic ISVP-T20L (DFU loader)";
+};
+
+&ddr {
+	/* T20L: DDR2 64 MB M14D5121632A (4-bank), CPU 712 / DDR 500 MHz. */
+	ingenic,sdram-params = <
+		0x03b08900 0x07d0c900 0x9a094410	/* APLL712 MPLL1000 CPCCR */
+		0x04000000				/* 64 MB */
+		0x0a688a40 0x000020fc 0x00002400	/* CFG MMAP0 MMAP1 */
+		0x040e0806 0x02170707 0x2007051e	/* TIMING1..3 */
+		0x1a240031 0xff060505 0x32170505	/* TIMING4..6 */
+		0x00000002 0x3cb7779a 0x003500b8	/* DCR DTPR0 DTPR1 */
+		0x03020d0c 0x07060504 0x0b0a0908	/* REMAP1..3 */
+		0x0f0e0100 0x13121110			/* REMAP4..5 */
+		1					/* cdr (DDR = MPLL/2 = 500) */
+		0x00f20001				/* REFCNT */
+		0x00000e73 0x00228019 0x064186a0	/* MR0 PTR0 PTR1 */
+		0x00645a1c				/* APLL frac -> 712.704 MHz */
+	>;
+};
diff --git a/arch/mips/dts/t20l-isvp-u-boot.dtsi b/arch/mips/dts/t20l-isvp-u-boot.dtsi
new file mode 100644
index 0000000000..450a12450e
--- /dev/null
