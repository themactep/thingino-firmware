diff --git a/arch/mips/dts/t32-isvp-dfu-uboot-common.dtsi b/arch/mips/dts/t32-isvp-dfu-uboot-common.dtsi
new file mode 100644
index 0000000000..44af40f462
--- /dev/null
+++ b/arch/mips/dts/t32-isvp-dfu-uboot-common.dtsi
@@ -0,0 +1,54 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Shared U-Boot overlay for the Ingenic ISVP-T32 DFU/USB-boot leaf DTs.
+ * Each per-SKU <leaf>-u-boot.dtsi is a one-line #include of this file.
+ *
+ * The USB-boot path uploads spl/u-boot-spl.bin + u-boot-lzma.img via
+ * the mask ROM (the XBurst1-generic t31-usbboot protocol), so the
+ * binman flash image here is not used in the USB-boot flow; it is kept
+ * for a sensible `make` artifact.
+ *
+ * The DFU-loader SPL returns to the mask ROM (it does not load U-Boot
+ * from NOR), so only the DDR controller + its clock tree need to
+ * survive into the SPL devicetree for the UCLASS_RAM probe; without
+ * these bootph-all tags the DDR node is stripped and the SPL hangs
+ * before DDR is up.
+ */
+
+/ {
+	binman: binman {
+		multiple-images;
+	};
+};
+
+&binman {
+	u-boot-spl-t32 {
+		filename = "u-boot-spl-t32.bin";
+
+		ingenic-t31-spl {
+			filename = "spl/u-boot-spl.bin";
+		};
+	};
+
+	flash {
+		filename = "u-boot-with-spl-lzma.bin";
+		pad-byte = <0xff>;
+
+		spl {
+			type = "blob";
+			offset = <0x0>;
+			filename = "u-boot-spl-t32.bin";
+		};
+
+		u-boot {
+			type = "blob";
+			offset = <0x14000>;
+			filename = "u-boot-lzma.img";
+		};
+	};
+};
+
+&exclk { bootph-all; };
+&rtclk { bootph-all; };
+&cgu { bootph-all; };
+&ddr { bootph-all; };		/* leaf .dts supplies ingenic,sdram-params */
diff --git a/arch/mips/dts/t32-isvp-dfu.dtsi b/arch/mips/dts/t32-isvp-dfu.dtsi
new file mode 100644
index 0000000000..ef3c45002c
--- /dev/null
+++ b/arch/mips/dts/t32-isvp-dfu.dtsi
@@ -0,0 +1,70 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Ingenic ISVP-T32 shared DFU/USB-boot board body.
+ *
+ * Identical to t32-isvp.dtsi except the DWC2 OTG is dr_mode =
+ * "peripheral" so the dwc2_udc_otg gadget binds (dwc2_udc_otg_bind
+ * rejects "host"), and the audio nodes stay off. Used by the usbboot
+ * defconfigs - the dev/flash loader that USB-boots and auto-enters
+ * DFU. Production NOR uses t32-isvp.dtsi (dr_mode="host" for USB
+ * host + USB-NIC).
+ *
+ * The per-SKU leaf .dts files (t32lq-isvp-dfu.dts, ...) include this
+ * and supply the DDR node's per-SKU "ingenic,sdram-params" array; the matching
+ * <leaf>-u-boot.dtsi pulls in t32-isvp-dfu-uboot-common.dtsi.
+ */
+
+#include <dt-bindings/gpio/gpio.h>
+#include "t32.dtsi"
+
+/ {
+	compatible = "ingenic,isvp-t32", "ingenic,t32";
+	model = "Ingenic ISVP-T32 (DFU loader)";
+
+	aliases {
+		serial1 = &uart1;
+	};
+
+	chosen {
+		stdout-path = "serial1:115200n8";
+	};
+
+	memory@0 {
+		device_type = "memory";
+		/* Placeholder; the DDR driver reports the real per-SKU size. */
+		reg = <0x0 0x04000000>;
+	};
+};
+
+&uart1 {
+	status = "okay";
+};
+
+&sfc {
+	status = "okay";
+
+	flash@0 {
+		compatible = "jedec,spi-nor";
+		reg = <0>;
+		spi-max-frequency = <50000000>;
+	};
+};
+
+&msc0 {
+	status = "okay";
+};
+
+&otg {
+	status = "okay";
+	dr_mode = "peripheral";		/* gadget bind for DFU/g_dnl */
+};
+
+/*
+ * Ethernet in the DFU loader, like the other loaders: the MAC-PHY
+ * clock derives from the per-variant MPLL via the CGU clk driver.
+ * No PHY reset GPIO here - board-specific; a wired-ethernet board DT
+ * declares its own ingenic,reset-gpio.
+ */
+&gmac {
+	status = "okay";
+};
diff --git a/arch/mips/dts/t32-isvp-uboot-common.dtsi b/arch/mips/dts/t32-isvp-uboot-common.dtsi
new file mode 100644
index 0000000000..7800785b87
--- /dev/null
+++ b/arch/mips/dts/t32-isvp-uboot-common.dtsi
@@ -0,0 +1,171 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Shared U-Boot overlay for the Ingenic ISVP-T32 SFC-NOR leaf DTs.
+ * Each per-SKU <leaf>-u-boot.dtsi is a one-line #include of this file
+ * (the U-Boot build auto-appends <leaf>-u-boot.dtsi to <leaf>.dts).
+ *
+ * T32 boots a TPL chain. Its NOR mask ROM is uncapped, but the SD-card ROM
+ * runs the first stage in a cache-lock window that cannot hold the SPL once it
+ * carries the DM + SFC/MMC stack - so, like every XBurst1 SoC, the bring-up is
+ * split: the ROM loads the headered TPL (NOR offset 0, or SD sector 34); the
+ * TPL brings up DDR in cache-as-RAM and reads the DRAM-resident SPL (NOR 0x8000,
+ * or SD 0x10000); the SPL reads U-Boot (NOR 0x18000 = CONFIG_SYS_SPI_U_BOOT_OFFS,
+ * or SD 0x30000). The 2 KiB header CRC7+length is finalized by the family-
+ * generic ingenic-t31-spl binman etype - the T31 mask-ROM contract, shared
+ * verbatim by the T32 bootrom.
+ *
+ * Phase tags: the TPL/SPL devicetrees are fdtgrep-filtered out of the single
+ * dt.dtb by bootph tags (TPL keeps bootph-all + bootph-pre-sram; SPL keeps
+ * bootph-all + bootph-pre-ram), NOT re-preprocessed per phase. The TPL's only
+ * DM device is &ddr (its probe brings up PLL + DDR, then it hand-loads the SPL
+ * with bare-metal SFC2/serial helpers), so only &ddr is tagged for all phases;
+ * every other node is bootph-pre-ram + bootph-some-ram (present in the SPL DM
+ * boot and U-Boot pre-reloc, absent from the minimal TPL).
+ */
+
+/ {
+	binman: binman {
+		multiple-images;
+	};
+};
+
+&binman {
+#if defined(CONFIG_SPL_MMC)
+	/*
+	 * MSC/SD-card boot image. The XBurst1 SD ROM reads the headered first
+	 * stage (the TPL) off the card, checks the MSPL magic and jumps to it.
+	 * The TPL reprograms MSC0CDR for its own bare-metal SPL read (the shared
+	 * xburst_tpl_msc_read), brings up DDR, loads the DRAM-resident SPL and
+	 * jumps; the SPL then probes DM MMC to load U-Boot. The T32 mask ROM reads
+	 * the MSPL first stage from SD sector 34 (0x4400), same as T31 - the vendor
+	 * SDK flashes it with dd seek=17 (17408 bytes = 0x4400 = sector 34). SD
+	 * layout: TPL at 0x4400, the DRAM-resident SPL at 0x10000, U-Boot at
+	 * SYS_MMCSD_RAW_MODE_U_BOOT_SECTOR (0x180 = 0x30000).
+	 */
+	u-boot-tpl-t32-msc {
+		filename = "u-boot-tpl-t32-msc.bin";
+
+		ingenic-t31-spl {
+			filename = "tpl/u-boot-tpl.bin";
+		};
+	};
+
+	mmc {
+		filename = "u-boot-with-tpl-mmc-lzma.bin";
+		pad-byte = <0x00>;
+
+		tpl {
+			type = "blob";
+			offset = <0x4400>;
+			filename = "u-boot-tpl-t32-msc.bin";
+		};
+
+		spl {
+			type = "blob";
+			offset = <0x10000>;
+			filename = "spl/u-boot-spl.bin";
+		};
+
+		u-boot {
+			type = "blob";
+			offset = <0x30000>;
+			filename = "u-boot-lzma.img";
+		};
+	};
+#elif defined(CONFIG_TPL)
+	u-boot-tpl-t32 {
+		filename = "u-boot-tpl-t32.bin";
+
+		ingenic-t31-spl {
+			filename = "tpl/u-boot-tpl.bin";
+		};
+	};
+
+	flash {
+		filename = "u-boot-with-tpl-lzma.bin";
+		pad-byte = <0xff>;
+
+		tpl {
+			type = "blob";
+			offset = <0x0>;
+			filename = "u-boot-tpl-t32.bin";
+		};
+
+		spl {
+			type = "blob";
+			offset = <0x8000>;
+			filename = "spl/u-boot-spl.bin";
+		};
+
+		u-boot {
+			type = "blob";
+			offset = <0x18000>;
+			filename = "u-boot-lzma.img";
+		};
+	};
+#else
+	u-boot-spl-t32 {
+		filename = "u-boot-spl-t32.bin";
+
+		ingenic-t31-spl {
+			filename = "spl/u-boot-spl.bin";
+		};
+	};
+
+	flash {
+		filename = "u-boot-with-spl-lzma.bin";
+		pad-byte = <0xff>;
+
+		spl {
+			type = "blob";
+			offset = <0x0>;
+			filename = "u-boot-spl-t32.bin";
+		};
+
+		u-boot {
+			type = "blob";
+			offset = <0x14000>;
+			filename = "u-boot-lzma.img";
+		};
+	};
+#endif
+};
+
+&exclk { bootph-pre-ram; bootph-some-ram; };
+&rtclk { bootph-pre-ram; bootph-some-ram; };
+&cgu { bootph-pre-ram; bootph-some-ram; };
+&ddr { bootph-all; };		/* the TPL's only DM device; leaf supplies params */
+&pinctrl { bootph-pre-ram; bootph-some-ram; };
+&gpa { bootph-pre-ram; bootph-some-ram; };
+&gpb { bootph-pre-ram; bootph-some-ram; };
+&gpc { bootph-pre-ram; bootph-some-ram; };
+&gpd { bootph-pre-ram; bootph-some-ram; };
+&uart1 { bootph-pre-ram; bootph-some-ram; };
+
+#if defined(CONFIG_SPL_MMC)
+/*
+ * MSC/SD boot: the SPL probes the native ingenic,t32-mmc controller (the TPL's
+ * SD read is bare-metal, so the TPL devicetree still needs only &ddr). msc0 is
+ * status="disabled" in t32.dtsi - the NOR boards never use it - so enable it
+ * here and tag it + its pins for the SPL and pre-reloc U-Boot phases. T32's
+ * msc0 pinctrl-0 also references pins_sfc1 (the adjacent pads it drives to keep
+ * noise off the data lines), so that pin group is tagged too.
+ */
+&msc0 {
+	bootph-pre-ram;
+	bootph-some-ram;
+	status = "okay";
+};
+&pins_mmc0 { bootph-pre-ram; bootph-some-ram; };
+&pins_sfc1 { bootph-pre-ram; bootph-some-ram; };
+#else
+&pins_sfc { bootph-pre-ram; bootph-some-ram; };
+&sfc {
+	bootph-pre-ram;
+	bootph-some-ram;
+	flash@0 {
+		bootph-pre-ram;
+		bootph-some-ram;
+	};
+};
+#endif
diff --git a/arch/mips/dts/t32-isvp.dtsi b/arch/mips/dts/t32-isvp.dtsi
new file mode 100644
index 0000000000..bcbd594bce
--- /dev/null
+++ b/arch/mips/dts/t32-isvp.dtsi
@@ -0,0 +1,77 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Ingenic ISVP-T32 shared board body (SFC-NOR, USB host).
+ *
+ * The per-SKU leaf .dts files (t32lq-isvp.dts, ...) include this and
+ * supply the DDR node's per-SKU "ingenic,sdram-params" array, consumed
+ * by the DDR driver (ddr_t32.c). The matching <leaf>-u-boot.dtsi pulls
+ * in t32-isvp-uboot-common.dtsi (binman image + SPL bootph).
+ */
+
+#include <dt-bindings/gpio/gpio.h>
+#include "t32.dtsi"
+
+/ {
+	compatible = "ingenic,isvp-t32", "ingenic,t32";
+	model = "Ingenic ISVP-T32 (SFC NOR)";
+
+	aliases {
+		serial1 = &uart1;
+	};
+
+	chosen {
+		stdout-path = "serial1:115200n8";
+	};
+
+	memory@0 {
+		device_type = "memory";
+		/* Placeholder; the DDR driver reports the real per-SKU size. */
+		reg = <0x0 0x04000000>;
+	};
+};
+
+&uart1 {
+	status = "okay";
+};
+
+&sfc {
+	status = "okay";
+
+	flash@0 {
+		compatible = "jedec,spi-nor";
+		reg = <0>;
+		spi-max-frequency = <50000000>;
+	};
+};
+
+&msc0 {
+	status = "okay";
+};
+
+&gmac {
+	status = "okay";
+	/* No PHY reset line by default (the driver falls back to an MDIO
+	 * BMCR soft-reset). Boards that wire one add ingenic,reset-gpio
+	 * here, like T31 (vendor T32 reference: PB26 active-low). */
+};
+
+&otg {
+	status = "okay";
+	/* Host by default; USB-NIC and mass-storage commands need a
+	 * host controller. Switch to "peripheral" via the dedicated
+	 * isvp_t32*_usbboot defconfigs + DT pairs for DFU loads. */
+	dr_mode = "host";
+};
+
+&aic {
+	status = "okay";
+};
+
+&codec {
+	status = "okay";
+	ingenic,spk-gpio = <&gpb 31 GPIO_ACTIVE_LOW>;
+};
+
+&sound {
+	status = "okay";
+};
diff --git a/arch/mips/dts/t32.dtsi b/arch/mips/dts/t32.dtsi
new file mode 100644
index 0000000000..133ccd79a5
--- /dev/null
+++ b/arch/mips/dts/t32.dtsi
@@ -0,0 +1,290 @@
+// SPDX-License-Identifier: GPL-2.0+
+
+#include <dt-bindings/clock/ingenic,t32-cgu.h>
+
+/ {
+	#address-cells = <1>;
+	#size-cells = <1>;
+	compatible = "ingenic,t32";
+
+	cpus {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		cpu0: cpu@0 {
+			device_type = "cpu";
+			compatible = "ingenic,xburst", "mips,mips32r2";
+			reg = <0>;
+		};
+	};
+
+	cpuintc: interrupt-controller {
+		#address-cells = <0>;
+		#interrupt-cells = <1>;
+		interrupt-controller;
+		compatible = "mti,cpu-interrupt-controller";
+	};
+
+	exclk: exclk {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <24000000>;
+	};
+
+	rtclk: rtclk {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <32768>;
+	};
+
+	/*
+	 * CGU. The SPL programs the PLLs/dividers; this driver runs in
+	 * U-Boot proper, recalculates the PLL rates and provides
+	 * rate/gate control for the leaf clocks. T32 (PRJ007) is NOT
+	 * CGU-bit-compatible with T31 (own clk-t32 driver / binding).
+	 */
+	cgu: clock-controller@10000000 {
+		compatible = "ingenic,t32-cgu", "simple-mfd";
+		reg = <0x10000000 0x1000>;
+		#clock-cells = <1>;
+		clocks = <&exclk>, <&rtclk>;
+		clock-names = "ext", "rtc";
+		bootph-pre-ram;
+		/*
+		 * Pin the kernel-consumed leaf muxes to the vendor
+		 * contract, measured from the shipping stock loader on
+		 * T32LQ silicon: HELIX (VPU), ISPM and CIM all from MPLL
+		 * (T32 stock parks CIM on MPLL, unlike the VPLL parking
+		 * of the other XBurst1 parts). The vendor kernels compute
+		 * leaf rates on whatever parent they inherit, so the
+		 * inherited selector is the contract. GMAC pins to APLL:
+		 * the stock loader parks MACPHY on APLL and the stock
+		 * kernel runs the internal ePHY at APLL/36 = 25 MHz
+		 * (measured; T21-style ePHY, not 50 MHz RMII). Parents
+		 * only.
+		 */
+		assigned-clocks = <&cgu T32_CLK_VPU>,
+				  <&cgu T32_CLK_ISP>,
+				  <&cgu T32_CLK_CIM>,
+				  <&cgu T32_CLK_GMAC>;
+		assigned-clock-parents = <&cgu T32_CLK_MPLL>,
+					 <&cgu T32_CLK_MPLL>,
+					 <&cgu T32_CLK_MPLL>,
+					 <&cgu T32_CLK_APLL>;
+	};
+
+	/*
+	 * DDR: Synopsys uMCTL2-class controller + Innophy training PHY,
+	 * each with its own APB aperture. The per-SKU register/timing block
+	 * is supplied as the leaf .dts's "ingenic,sdram-params" array,
+	 * consumed by drivers/ram/ingenic/ddr_t32.c (the rk3328 DMC model).
+	 * bootph-all is added by the leaf's shared U-Boot overlay so the
+	 * node survives into the SPL devicetree.
+	 */
+	ddr: memory-controller@13012000 {
+		compatible = "ingenic,t32-ddr-innophy";
+		reg = <0x13012000 0x1000>,	/* uMCTL2 controller APB */
+		      <0x13011000 0x1000>;	/* Innophy PHY APB */
+	};
+
+	/*
+	 * TCU container (mirrors the Linux ingenic tcu/simple-mfd
+	 * binding) so the watchdog child binds; U-Boot only needs the
+	 * watchdog for sysreset (it self-clocks from the 32 kHz RTC).
+	 */
+	tcu: timer@10002000 {
+		compatible = "ingenic,t32-tcu", "ingenic,jz4760-tcu",
+			     "simple-mfd";
+		reg = <0x10002000 0x1000>;
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges = <0x0 0x10002000 0x1000>;
+
+		watchdog: watchdog@0 {
+			compatible = "ingenic,t32-watchdog",
+				     "ingenic,jz4780-watchdog";
+			reg = <0x0 0x10>;
+		};
+	};
+
+	uart1: serial@10031000 {
+		compatible = "ingenic,jz4780-uart";
+		reg = <0x10031000 0x100>;
+		reg-shift = <2>;
+		clock-frequency = <24000000>;
+		status = "disabled";
+	};
+
+	/*
+	 * SFC2 (descriptor-capable SPI-NOR controller), driven by the DM
+	 * SFC driver (drivers/spi/ingenic_sfc.c) in both the SPL (the
+	 * standard SPL_SPI U-Boot load) and U-Boot proper. Status
+	 * disabled here, enabled per-board.
+	 */
+	sfc: spi@13440000 {
+		compatible = "ingenic,t32-sfc";
+		reg = <0x13440000 0x10000>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+		clocks = <&cgu T32_CLK_SFC>;
+		spi-max-frequency = <50000000>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pins_sfc>;
+		status = "disabled";
+	};
+
+	msc0: mmc@13060000 {
+		compatible = "ingenic,t32-mmc";
+		reg = <0x13060000 0x10000>;
+		clocks = <&cgu T32_CLK_MSC0>;
+		clock-names = "mmc";
+		bus-width = <4>;
+		broken-cd;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pins_mmc0 &pins_sfc1>;
+		status = "disabled";
+	};
+
+	/*
+	 * GMAC: Synopsys DesignWare MAC, same base/glue as T31
+	 * (vendor PRJ.dtsi mac@0x134b0000, mode-reg 0x100000e8) and the
+	 * same RMII pad set (PB6-11/PB13-16 func 0). ingenic,mode-reg is
+	 * the CPM GMAC-PHY-control register used to select the PHY
+	 * interface; the glue also ungates the GMAC clock and programs
+	 * CPM_MACCDR off the live MPLL (per-SKU 1200/1400 MHz).
+	 */
+	gmac: ethernet@134b0000 {
+		compatible = "ingenic,t32-gmac";
+		reg = <0x134b0000 0x2000>;
+		phy-mode = "rmii";
+		max-speed = <100>;
+		clocks = <&cgu T32_CLK_GMAC>;
+		ingenic,mode-reg = <0x100000e8>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pins_mac>;
+		status = "disabled";
+	};
+
+	/*
+	 * DWC2 USB OTG. T32 puts the controller at the same base as
+	 * T31 (0x13500000). The host/peripheral split is per-board:
+	 * production NOR boots use dr_mode = "host" so the host can
+	 * see a USB-NIC; the t32-isvp-dfu.dts overlay flips dr_mode
+	 * to "peripheral" for the DFU loader. Status disabled here,
+	 * enabled per-board.
+	 */
+	otg: usb@13500000 {
+		compatible = "snps,dwc2";
+		reg = <0x13500000 0x40000>;
+		dr_mode = "host";
+		clocks = <&cgu T32_CLK_OTG>;
+		g-rx-fifo-size = <512>;
+		g-np-tx-fifo-size = <16>;
+		g-tx-fifo-size = <256 256 16 16 16>;
+		status = "disabled";
+	};
+
+	/*
+	 * Audio: AIC (I2S) controller + on-chip codec. PIO playback
+	 * driven by U-Boot's `sound` command. The T32 codec is a
+	 * different silicon block from the jz_t10 family used on
+	 * T10..T31/C100 - different register set, separate driver
+	 * (t32_codec). Speaker-amp enable GPIO is per-board (set via
+	 * ingenic,spk-gpio on the codec node when needed - boards that
+	 * hardwire the amp omit it).
+	 */
+	aic: audio-controller@10020000 {
+		compatible = "ingenic,t32-aic";
+		clocks = <&cgu T32_CLK_MPLL>;
+		clock-names = "mpll";
+		reg = <0x10020000 0x100>;
+		#sound-dai-cells = <0>;
+		status = "disabled";
+	};
+
+	codec: audio-codec@10021000 {
+		compatible = "ingenic,t32-codec";
+		reg = <0x10021000 0x140>;
+		#sound-dai-cells = <0>;
+		status = "disabled";
+	};
+
+	sound: sound {
+		compatible = "ingenic,t32-sound";
+		status = "disabled";
+
+		cpu {
+			sound-dai = <&aic>;
+		};
+
+		codec {
+			sound-dai = <&codec>;
+		};
+	};
+
+	/*
+	 * Pin controller + GPIO. T32 reuses the shared XBurst1
+	 * GPIO/pinmux engine and group tables (same rationale as T23/
+	 * T30); only the controller/gpio compatibles are T32-specific.
+	 */
+	pinctrl: pinctrl@10010000 {
+		compatible = "ingenic,t32-pinctrl";
+		reg = <0x10010000 0x1000>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		gpa: gpio@0 {
+			compatible = "ingenic,t32-gpio";
+			reg = <0>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		gpb: gpio@1 {
+			compatible = "ingenic,t32-gpio";
+			reg = <1>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		gpc: gpio@2 {
+			compatible = "ingenic,t32-gpio";
+			reg = <2>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		gpd: gpio@3 {
+			compatible = "ingenic,t32-gpio";
+			reg = <3>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		pins_sfc: sfc {
+			function = "sfc";
+			groups = "sfc-data";
+		};
+
+		pins_mmc0: mmc0 {
+			function = "mmc0";
+			groups = "mmc0-1bit", "mmc0-4bit";
+		};
+
+		pins_mac: mac {
+			function = "mac";
+			groups = "mac-rmii";
+		};
+
+		/*
+		 * Idle the second SPI-NOR pin block: the T32LQ wires it to
+		 * PC2..PC7 immediately next to the MSC0 data lines. Left as
+		 * GPIO, the floating drivers couple noise into MSC0 and
+		 * break SD card init.
+		 */
+		pins_sfc1: sfc1 {
+			function = "sfc1";
+			groups = "sfc1-data";
+		};
+	};
+};
