diff --git a/arch/mips/dts/t21-isvp-dfu-uboot-common.dtsi b/arch/mips/dts/t21-isvp-dfu-uboot-common.dtsi
new file mode 100644
index 0000000000..ad76b7819c
--- /dev/null
+++ b/arch/mips/dts/t21-isvp-dfu-uboot-common.dtsi
@@ -0,0 +1,54 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Shared U-Boot overlay for the Ingenic ISVP-T21 DFU/USB-boot leaf DTs.
+ * Each per-SKU <leaf>-u-boot.dtsi is a one-line include of this file.
+ *
+ * USB-boot is a TPL chain: the mask ROM uploads the cache-as-RAM TPL (its only
+ * DM device is &ddr; the probe brings up PLL + DDR), the TPL returns into the
+ * ROM's USB loop, and the ROM uploads U-Boot proper to DRAM. So the binman
+ * flash image here is not used in the USB-boot flow (kept for a sensible `make`
+ * artifact); thingino-dfu uploads tpl/u-boot-tpl.bin + u-boot.bin directly.
+ *
+ * &ddr is the only node tagged for the TPL phase (bootph-all); everything else
+ * is bootph-pre-ram + bootph-some-ram (present pre-relocation in U-Boot proper,
+ * absent from the minimal TPL - tagging the clock tree bootph-all would pull the
+ * clk uclass into the TPL's OF_PLATDATA scan and fail it).
+ */
+
+/ {
+	binman: binman {
+		multiple-images;
+	};
+};
+
+&binman {
+	u-boot-spl-t21 {
+		filename = "u-boot-spl-t21.bin";
+
+		ingenic-t31-spl {
+			filename = "spl/u-boot-spl.bin";
+		};
+	};
+
+	flash {
+		filename = "u-boot-with-spl-lzma.bin";
+		pad-byte = <0xff>;
+
+		spl {
+			type = "blob";
+			offset = <0x0>;
+			filename = "u-boot-spl-t21.bin";
+		};
+
+		u-boot {
+			type = "blob";
+			offset = <0x10000>;
+			filename = "u-boot-lzma.img";
+		};
+	};
+};
+
+&ddr { bootph-all; };		/* the TPL's only DM device */
+&exclk { bootph-pre-ram; bootph-some-ram; };
+&rtclk { bootph-pre-ram; bootph-some-ram; };
+&cgu { bootph-pre-ram; bootph-some-ram; };
diff --git a/arch/mips/dts/t21-isvp-dfu.dtsi b/arch/mips/dts/t21-isvp-dfu.dtsi
new file mode 100644
index 0000000000..b1a6dc7a8f
--- /dev/null
+++ b/arch/mips/dts/t21-isvp-dfu.dtsi
@@ -0,0 +1,70 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Ingenic ISVP-T21 shared DFU/USB-boot board body.
+ *
+ * Identical to t21-isvp.dtsi except the DWC2 OTG is dr_mode =
+ * "peripheral" so the dwc2_udc_otg gadget binds (dwc2_udc_otg_bind
+ * rejects "host"), and the audio nodes stay off. Used by the usbboot
+ * defconfig - the dev/flash loader that USB-boots and auto-enters
+ * DFU. Production NOR uses t21-isvp.dtsi (dr_mode="host" for USB
+ * host + USB-NIC).
+ *
+ * The per-SKU leaf .dts files (t21n-isvp-dfu.dts, ...) include this
+ * and supply the DDR node's per-SKU "ingenic,sdram-params" array; the matching
+ * <leaf>-u-boot.dtsi pulls in t21-isvp-dfu-uboot-common.dtsi.
+ */
+
+#include <dt-bindings/gpio/gpio.h>
+#include "t21.dtsi"
+
+/ {
+	compatible = "ingenic,isvp-t21", "ingenic,t21";
+	model = "Ingenic ISVP-T21 (DFU loader)";
+
+	aliases {
+		serial1 = &uart1;
+	};
+
+	chosen {
+		stdout-path = "serial1:115200n8";
+	};
+
+	memory@0 {
+		device_type = "memory";
+		reg = <0x0 0x04000000>;	/* 64 MB DDR2 (T21N) */
+	};
+};
+
+&uart1 {
+	status = "okay";
+};
+
+&sfc {
+	status = "okay";
+
+	flash@0 {
+		compatible = "jedec,spi-nor";
+		reg = <0>;
+		spi-max-frequency = <50000000>;
+	};
+};
+
+&msc0 {
+	status = "okay";
+	bus-width = <4>;
+	broken-cd;
+};
+
+&otg {
+	status = "okay";
+	dr_mode = "peripheral";		/* gadget bind for DFU/g_dnl */
+};
+
+/*
+ * Ethernet in the DFU loader, like the T31 loaders: the per-variant
+ * loader carries its own MPLL plan, and the MAC-PHY clock derives from
+ * it at runtime. T21 embedded ePHY: no external PHY chip, no reset GPIO.
+ */
+&gmac {
+	status = "okay";
+};
diff --git a/arch/mips/dts/t21-isvp-uboot-common.dtsi b/arch/mips/dts/t21-isvp-uboot-common.dtsi
new file mode 100644
index 0000000000..441761b300
--- /dev/null
+++ b/arch/mips/dts/t21-isvp-uboot-common.dtsi
@@ -0,0 +1,164 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Shared U-Boot overlay for the Ingenic ISVP-T21 SFC-NOR leaf DTs.
+ * Each per-SKU <leaf>-u-boot.dtsi is a one-line include of this file.
+ *
+ * T21 is a capped SoC (the T20-generation mask ROM loads only 0x6800 of the
+ * first stage from NOR), so it boots a TPL chain: the mask ROM loads the
+ * headered TPL at offset 0; the TPL brings up DDR in cache-as-RAM and reads the
+ * DRAM-resident SPL from 0x8000 (= T21_TPL_SPL_NOR_OFFS); the SPL reads U-Boot
+ * from 0x18000 (= CONFIG_SYS_SPI_U_BOOT_OFFS). The 2 KiB header CRC7+length is
+ * finalized by the family-generic ingenic-t31-spl binman etype.
+ *
+ * Phase tags: the SPL/TPL devicetrees are fdtgrep-filtered out of the single
+ * dt.dtb by bootph tags (TPL keeps bootph-all + bootph-pre-sram; SPL keeps
+ * bootph-all + bootph-pre-ram), NOT re-preprocessed per phase - so the split is
+ * in the tags, not #ifdef. The TPL's only DM device is &ddr (its probe brings
+ * up PLL + DDR, then it hand-loads the SPL with bare-metal SFC/serial helpers),
+ * so only &ddr is tagged for all phases; every other node is bootph-pre-ram +
+ * bootph-some-ram (present in the SPL DM NOR boot and U-Boot pre-reloc, absent
+ * from the minimal TPL).
+ */
+
+/ {
+	binman: binman {
+		multiple-images;
+	};
+};
+
+&binman {
+#if defined(CONFIG_SPL_MMC)
+	/*
+	 * MSC/SD-card boot image (isvp_t21n_msc0). The XBurst1 SD ROM reads the
+	 * headered first stage (the TPL) off the card, checks the MSPL magic and
+	 * jumps to it - no INGE/descriptor block needed; the reader sets the SD
+	 * clock itself (see mach-xburst/msc.c). So the image is just the plain
+	 * MSPL-headered TPL + SPL, like the XBurst2 T40/T41. SD layout: TPL at
+	 * sector 34 (0x4400), the DRAM-resident SPL at 0x10000 (the TPL reads it
+	 * bare-metal), U-Boot at SYS_MMCSD_RAW_MODE_U_BOOT_SECTOR (0x180 = 0x30000).
+	 */
+	u-boot-tpl-t21-msc {
+		filename = "u-boot-tpl-t21-msc.bin";
+
+		ingenic-t31-spl {
+			filename = "tpl/u-boot-tpl.bin";
+		};
+	};
+
+	mmc {
+		filename = "u-boot-with-tpl-mmc-lzma.bin";
+		pad-byte = <0x00>;
+
+		tpl {
+			type = "blob";
+			offset = <0x4400>;
+			filename = "u-boot-tpl-t21-msc.bin";
+		};
+
+		spl {
+			type = "blob";
+			offset = <0x10000>;
+			filename = "spl/u-boot-spl.bin";
+		};
+
+		u-boot {
+			type = "blob";
+			offset = <0x30000>;
+			filename = "u-boot-lzma.img";
+		};
+	};
+#elif defined(CONFIG_TPL)
+	u-boot-tpl-t21 {
+		filename = "u-boot-tpl-t21.bin";
+
+		ingenic-t31-spl {
+			filename = "tpl/u-boot-tpl.bin";
+		};
+	};
+
+	flash {
+		filename = "u-boot-with-tpl-lzma.bin";
+		pad-byte = <0xff>;
+
+		tpl {
+			type = "blob";
+			offset = <0x0>;
+			filename = "u-boot-tpl-t21.bin";
+		};
+
+		spl {
+			type = "blob";
+			offset = <0x8000>;
+			filename = "spl/u-boot-spl.bin";
+		};
+
+		u-boot {
+			type = "blob";
+			offset = <0x18000>;
+			filename = "u-boot-lzma.img";
+		};
+	};
+#else
+	u-boot-spl-t21 {
+		filename = "u-boot-spl-t21.bin";
+
+		ingenic-t31-spl {
+			filename = "spl/u-boot-spl.bin";
+		};
+	};
+
+	flash {
+		filename = "u-boot-with-spl-lzma.bin";
+		pad-byte = <0xff>;
+
+		spl {
+			type = "blob";
+			offset = <0x0>;
+			filename = "u-boot-spl-t21.bin";
+		};
+
+		u-boot {
+			type = "blob";
+			offset = <0x10000>;
+			filename = "u-boot-lzma.img";
+		};
+	};
+#endif
+};
+
+&exclk { bootph-pre-ram; bootph-some-ram; };
+&rtclk { bootph-pre-ram; bootph-some-ram; };
+&cgu { bootph-pre-ram; bootph-some-ram; };
+&ddr { bootph-all; };		/* the TPL's only DM device */
+&pinctrl { bootph-pre-ram; bootph-some-ram; };
+&gpa { bootph-pre-ram; bootph-some-ram; };
+&gpb { bootph-pre-ram; bootph-some-ram; };
+&gpc { bootph-pre-ram; bootph-some-ram; };
+&gpd { bootph-pre-ram; bootph-some-ram; };
+&uart1 { bootph-pre-ram; bootph-some-ram; };
+
+#if defined(CONFIG_SPL_MMC)
+/*
+ * MSC/SD boot: the SPL probes the native jz_mmc controller (the TPL's SD read
+ * is bare-metal, so the TPL devicetree still needs only &ddr). msc0 is
+ * status="disabled" in t21.dtsi - the NOR boards never use it - so enable it
+ * here and tag it + its pins for the SPL and pre-reloc U-Boot phases.
+ */
+&msc0 {
+	bootph-pre-ram;
+	bootph-some-ram;
+	broken-cd;		/* the SD is the boot medium - always present */
+	status = "okay";
+};
+&pins_mmc0 { bootph-pre-ram; bootph-some-ram; };
+#else
+&pins_sfc { bootph-pre-ram; bootph-some-ram; };
+&sfc {
+	bootph-pre-ram;
+	bootph-some-ram;
+	flash@0 {
+		bootph-pre-ram;
+		bootph-some-ram;
+	};
+};
+#endif
diff --git a/arch/mips/dts/t21-isvp.dtsi b/arch/mips/dts/t21-isvp.dtsi
new file mode 100644
index 0000000000..2d1daac952
--- /dev/null
+++ b/arch/mips/dts/t21-isvp.dtsi
@@ -0,0 +1,75 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Ingenic ISVP-T21 shared board body (SFC-NOR, USB host).
+ *
+ * The per-SKU leaf .dts files (t21n-isvp.dts, t21hp-isvp.dts) include
+ * this and supply the DDR node's per-SKU "ingenic,sdram-params"
+ * array, consumed by the shared Innophy DDR driver (ddr_t31.c). The
+ * matching <leaf>-u-boot.dtsi pulls in t21-isvp-uboot-common.dtsi
+ * (binman image + SPL bootph).
+ */
+
+#include <dt-bindings/gpio/gpio.h>
+#include "t21.dtsi"
+
+/ {
+	compatible = "ingenic,isvp-t21", "ingenic,t21";
+	model = "Ingenic ISVP-T21 (SFC NOR)";
+
+	aliases {
+		serial1 = &uart1;
+	};
+
+	chosen {
+		stdout-path = "serial1:115200n8";
+	};
+
+	memory@0 {
+		device_type = "memory";
+		reg = <0x0 0x04000000>;	/* 64 MB DDR2 (T21N) */
+	};
+};
+
+&uart1 {
+	status = "okay";
+};
+
+&sfc {
+	status = "okay";
+
+	flash@0 {
+		compatible = "jedec,spi-nor";
+		reg = <0>;
+		spi-max-frequency = <50000000>;
+	};
+};
+
+&msc0 {
+	status = "okay";
+	bus-width = <4>;
+	broken-cd;	/* no card-detect line wired on the ISVP board */
+};
+
+&gmac {
+	/* T21 embedded ePHY: no external PHY chip, no reset GPIO. */
+	status = "okay";
+};
+
+&otg {
+	status = "okay";
+};
+
+&aic {
+	status = "okay";
+};
+
+&codec {
+	status = "okay";
+	/* Speaker-amp enable: SDK default PB31, active-high. Override
+	 * here per board if the amp is on a different pin/polarity. */
+	ingenic,spk-gpio = <&gpb 31 GPIO_ACTIVE_HIGH>;
+};
+
+&sound {
+	status = "okay";
+};
diff --git a/arch/mips/dts/t21.dtsi b/arch/mips/dts/t21.dtsi
new file mode 100644
index 0000000000..730020f77f
--- /dev/null
+++ b/arch/mips/dts/t21.dtsi
@@ -0,0 +1,271 @@
+// SPDX-License-Identifier: GPL-2.0+
+
+#include <dt-bindings/clock/ingenic,t21-cgu.h>
+
+/ {
+	#address-cells = <1>;
+	#size-cells = <1>;
+	compatible = "ingenic,t21";
+
+	cpus {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		cpu0: cpu@0 {
+			device_type = "cpu";
+			compatible = "ingenic,xburst", "mips,mips32r2";
+			reg = <0>;
+		};
+	};
+
+	cpuintc: interrupt-controller {
+		#address-cells = <0>;
+		#interrupt-cells = <1>;
+		interrupt-controller;
+		compatible = "mti,cpu-interrupt-controller";
+	};
+
+	exclk: exclk {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <24000000>;
+	};
+
+	rtclk: rtclk {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <32768>;
+	};
+
+	/*
+	 * CGU (Clock/Power Manager). Same XBurst1 leaf-clock map as T31
+	 * (with VPLL, like T31); the PLL register encoding differs
+	 * (cpm_cpxpcr_t) and the clk-t21 driver handles that. The SPL
+	 * programs the PLLs/dividers; this driver runs in U-Boot proper
+	 * and recalculates PLL rates + provides rate/gate for the leaf
+	 * clocks (SFC, MMC, GMAC). Driver accesses CPM via KSEG1.
+	 */
+	cgu: clock-controller@10000000 {
+		compatible = "ingenic,t21-cgu", "simple-mfd";
+		reg = <0x10000000 0x1000>;
+		#clock-cells = <1>;
+		clocks = <&exclk>, <&rtclk>;
+		clock-names = "ext", "rtc";
+		bootph-pre-ram;
+		/*
+		 * Pin the kernel-consumed leaf muxes to the vendor
+		 * contract, measured on silicon (bench T21N, legacy
+		 * loader): HELIX (VPU) and ISP from MPLL, CIM from
+		 * VPLL (the cgu probe brings VPLL up at 1200 MHz like
+		 * the vendor loader; sensor drivers retune it for
+		 * 27 MHz MCLKs). The 3.10 kernel computes leaf rates
+		 * on whatever parent it inherits, so the inherited
+		 * selector is the contract. Parents only, no rates.
+		 */
+		assigned-clocks = <&cgu T21_CLK_VPU>,
+				  <&cgu T21_CLK_ISP>,
+				  <&cgu T21_CLK_CIM>,
+				  <&cgu T21_CLK_GMAC>;
+		assigned-clock-parents = <&cgu T21_CLK_MPLL>,
+					 <&cgu T21_CLK_MPLL>,
+					 <&cgu T21_CLK_VPLL>,
+					 <&cgu T21_CLK_MPLL>;
+	};
+
+	/*
+	 * DDR2 controller + Innophy PHY - the same legacy XBurst1 IP as T31,
+	 * so the shared drivers/ram/ingenic/ddr_t31.c driver binds under one
+	 * compatible; the leaf .dts supplies the per-SKU "ingenic,sdram-params"
+	 * u32 array (see t31.dtsi for the field order). bootph-all is added by
+	 * the leaf's shared U-Boot overlay so the node survives into the SPL
+	 * devicetree.
+	 */
+	ddr: memory-controller@134f0000 {
+		compatible = "ingenic,t31-ddr-innophy";
+		reg = <0x134f0000 0x1000>;
+	};
+
+	/*
+	 * TCU container; U-Boot only needs the watchdog (for sysreset).
+	 * The generic jz4760-tcu / jz4780-watchdog fallbacks bind on
+	 * T21 (same IP as T31). The watchdog self-clocks from the 32 kHz
+	 * RTC.
+	 */
+	tcu: timer@10002000 {
+		compatible = "ingenic,t21-tcu", "ingenic,jz4760-tcu",
+			     "simple-mfd";
+		reg = <0x10002000 0x1000>;
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges = <0x0 0x10002000 0x1000>;
+
+		watchdog: watchdog@0 {
+			compatible = "ingenic,t21-watchdog",
+				     "ingenic,jz4780-watchdog";
+			reg = <0x0 0x10>;
+		};
+	};
+
+	uart1: serial@10031000 {
+		compatible = "ingenic,jz4780-uart";
+		reg = <0x10031000 0x100>;
+		reg-shift = <2>;
+		clock-frequency = <24000000>;
+		status = "disabled";
+	};
+
+	/*
+	 * SFC SPI-NOR controller - identical IP to T31; the in-tree
+	 * ingenic_sfc driver matches "ingenic,t31-sfc" (kept as the
+	 * compatible since that is the only match string; the block and
+	 * register map are the same on T21).
+	 */
+	sfc: spi@13440000 {
+		compatible = "ingenic,t31-sfc";
+		reg = <0x13440000 0x10000>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+		clocks = <&cgu T21_CLK_SFC>;
+		spi-max-frequency = <50000000>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pins_sfc>;
+		status = "disabled";
+	};
+
+	msc0: mmc@13450000 {
+		compatible = "ingenic,t31-mmc";
+		reg = <0x13450000 0x1000>;
+		clocks = <&cgu T21_CLK_MSC0>;
+		clock-names = "mmc";
+		cap-sd-highspeed;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pins_mmc0>;
+		status = "disabled";
+	};
+
+	/*
+	 * Pin controller + GPIO. Same XBurst1 engine as T31 (PA..PD,
+	 * 0x1000 stride); the ingenic,t21-pinctrl/-gpio compatibles are
+	 * handled by the shared pinctrl-ingenic driver.
+	 */
+	pinctrl: pinctrl@10010000 {
+		compatible = "ingenic,t21-pinctrl";
+		reg = <0x10010000 0x1000>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		gpa: gpio@0 {
+			compatible = "ingenic,t21-gpio";
+			reg = <0>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		gpb: gpio@1 {
+			compatible = "ingenic,t21-gpio";
+			reg = <1>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		gpc: gpio@2 {
+			compatible = "ingenic,t21-gpio";
+			reg = <2>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		gpd: gpio@3 {
+			compatible = "ingenic,t21-gpio";
+			reg = <3>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		pins_sfc: sfc {
+			function = "sfc";
+			groups = "sfc-data";
+		};
+
+		pins_mmc0: mmc0 {
+			function = "mmc0";
+			groups = "mmc0-1bit", "mmc0-4bit";
+		};
+
+		pins_mac: mac {
+			function = "mac";
+			groups = "mac-rmii";
+		};
+	};
+
+	/*
+	 * GMAC: Synopsys DesignWare MAC with the T21 embedded ("OMNI")
+	 * ePHY - no external PHY chip, no reset GPIO, no external RMII
+	 * pins. The dwmac_ingenic "ingenic,t21-gmac" path powers/resets
+	 * the inner PHY via the CPM GMAC-PHY-control register (CPM+0xe8)
+	 * and runs the MAC<->ePHY link in MII at a 25 MHz MAC-PHY clock.
+	 */
+	gmac: ethernet@134b0000 {
+		compatible = "ingenic,t21-gmac";
+		reg = <0x134b0000 0x2000>;
+		phy-mode = "mii";
+		max-speed = <100>;
+		clocks = <&cgu T21_CLK_GMAC>;
+		ingenic,mode-reg = <0x100000e8>;
+		status = "disabled";
+	};
+
+	/*
+	 * DWC2 USB OTG. Production default dr_mode = "host" (the dwc2
+	 * host data-path fixes gate on dr_mode=="host"). The DFU/flash
+	 * loader uses a separate DT (t21-isvp-dfu) that overrides this
+	 * to "peripheral" for the dwc2_udc_otg gadget - one DM bind per
+	 * node; dual-role is a deliberate per-build DT choice.
+	 */
+	otg: usb@13500000 {
+		compatible = "snps,dwc2";
+		reg = <0x13500000 0x40000>;
+		dr_mode = "host";
+		clocks = <&cgu T21_CLK_OTG>;
+		g-rx-fifo-size = <512>;
+		g-np-tx-fifo-size = <16>;
+		g-tx-fifo-size = <256 256 16 16 16>;
+		status = "disabled";
+	};
+
+	/*
+	 * Audio: AIC (I2S) controller + on-chip codec. PIO playback driven
+	 * by U-Boot's `sound` command. Speaker-amp enable GPIO is per-board
+	 * (set in the board .dts via ingenic,spk-gpio; SDK default PB31
+	 * active-high). Compatible split: T20 -> A-block codec; T31/C100/T23
+	 * -> B-block codec (jz_t10_codec handles both via driver_data).
+	 */
+	aic: audio-controller@10020000 {
+		compatible = "ingenic,t21-aic";
+		clocks = <&cgu T21_CLK_MPLL>;
+		clock-names = "mpll";
+		reg = <0x10020000 0x100>;
+		#sound-dai-cells = <0>;
+		status = "disabled";
+	};
+
+	codec: audio-codec@10021000 {
+		compatible = "ingenic,t21-codec";
+		reg = <0x10021000 0x140>;
+		#sound-dai-cells = <0>;
+		status = "disabled";
+	};
+
+	sound: sound {
+		compatible = "ingenic,t21-sound";
+		status = "disabled";
+
+		cpu {
+			sound-dai = <&aic>;
+		};
+
+		codec {
+			sound-dai = <&codec>;
+		};
+	};
+};
