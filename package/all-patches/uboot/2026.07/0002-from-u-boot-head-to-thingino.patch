+#endif
+
+int board_init(void)
+{
+#if defined(CONFIG_USB) || defined(CONFIG_USB_GADGET)
+	/*
+	 * The DM USB stack's dwc2_usb_probe() does not call
+	 * board_usb_init(), so the PHY must be brought up here.
