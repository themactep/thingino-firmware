+	v = cpm_r(p, d->cdr);
+	v &= ~(CDR_SRC_MASK | BIT(d->stop) | BIT(d->busy) | CDR_DIV_MASK);
+	if (d->msc) {
+		v &= ~MSC_CDR_EXT_SEL;
+		v |= MSC_CDR_H_FREQ;
+	}
+	v |= ((u32)d->src << CDR_SRC_SHIFT) | BIT(d->ce) | (div - 1);
+	cpm_w(p, d->cdr, v);
+
+	while (cpm_r(p, d->cdr) & BIT(d->busy))
+		;
+
+	return parent / div / (d->msc ? 4 : 1);
+}
