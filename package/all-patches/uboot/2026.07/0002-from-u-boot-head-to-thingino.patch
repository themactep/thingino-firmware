--- /dev/null
+++ b/tools/mkt31spl.c
@@ -0,0 +1,115 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * mkt31spl - finalize an Ingenic T31 SFC-NOR SPL image.
+ *
+ * The T31 mask ROM SFC-NOR boot path reads a fixed 2048-byte header at
+ * the start of the SPL: word0/1 are the boot magic (emitted by
+ * start.S), byte 9 is a CRC7 of the SPL body (offset 2048..EOF) and
+ * bytes 12..15 are the total image length (little-endian). The mask
+ * ROM uses the length to know how many bytes to copy from flash.
+ *
+ * This is a faithful reimplementation of the vendor
+ * tools/ingenic-tools/spi_checksum.c (CONFIG_T31 / CONFIG_SPL_SFC
+ * path: SKIP_SIZE=2048, CRC_POSITION=9, SPL_LENGTH_POSITION=12).
+ *
+ * Usage: mkt31spl <spl-image>   (patched in place)
+ */
+
+#include <stdio.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <fcntl.h>
+#include <unistd.h>
+
+#define SKIP_SIZE		2048
+#define CRC_POSITION		9
+#define SPL_LENGTH_POSITION	12
+
+static const uint8_t crc7_syndrome_table[256] = {
+	0x00, 0x09, 0x12, 0x1b, 0x24, 0x2d, 0x36, 0x3f,
+	0x48, 0x41, 0x5a, 0x53, 0x6c, 0x65, 0x7e, 0x77,
+	0x19, 0x10, 0x0b, 0x02, 0x3d, 0x34, 0x2f, 0x26,
+	0x51, 0x58, 0x43, 0x4a, 0x75, 0x7c, 0x67, 0x6e,
+	0x32, 0x3b, 0x20, 0x29, 0x16, 0x1f, 0x04, 0x0d,
+	0x7a, 0x73, 0x68, 0x61, 0x5e, 0x57, 0x4c, 0x45,
+	0x2b, 0x22, 0x39, 0x30, 0x0f, 0x06, 0x1d, 0x14,
+	0x63, 0x6a, 0x71, 0x78, 0x47, 0x4e, 0x55, 0x5c,
+	0x64, 0x6d, 0x76, 0x7f, 0x40, 0x49, 0x52, 0x5b,
+	0x2c, 0x25, 0x3e, 0x37, 0x08, 0x01, 0x1a, 0x13,
+	0x7d, 0x74, 0x6f, 0x66, 0x59, 0x50, 0x4b, 0x42,
+	0x35, 0x3c, 0x27, 0x2e, 0x11, 0x18, 0x03, 0x0a,
+	0x56, 0x5f, 0x44, 0x4d, 0x72, 0x7b, 0x60, 0x69,
+	0x1e, 0x17, 0x0c, 0x05, 0x3a, 0x33, 0x28, 0x21,
+	0x4f, 0x46, 0x5d, 0x54, 0x6b, 0x62, 0x79, 0x70,
+	0x07, 0x0e, 0x15, 0x1c, 0x23, 0x2a, 0x31, 0x38,
+	0x41, 0x48, 0x53, 0x5a, 0x65, 0x6c, 0x77, 0x7e,
+	0x09, 0x00, 0x1b, 0x12, 0x2d, 0x24, 0x3f, 0x36,
+	0x58, 0x51, 0x4a, 0x43, 0x7c, 0x75, 0x6e, 0x67,
+	0x10, 0x19, 0x02, 0x0b, 0x34, 0x3d, 0x26, 0x2f,
+	0x73, 0x7a, 0x61, 0x68, 0x57, 0x5e, 0x45, 0x4c,
+	0x3b, 0x32, 0x29, 0x20, 0x1f, 0x16, 0x0d, 0x04,
+	0x6a, 0x63, 0x78, 0x71, 0x4e, 0x47, 0x5c, 0x55,
+	0x22, 0x2b, 0x30, 0x39, 0x06, 0x0f, 0x14, 0x1d,
+	0x25, 0x2c, 0x37, 0x3e, 0x01, 0x08, 0x13, 0x1a,
+	0x6d, 0x64, 0x7f, 0x76, 0x49, 0x40, 0x5b, 0x52,
+	0x3c, 0x35, 0x2e, 0x27, 0x18, 0x11, 0x0a, 0x03,
+	0x74, 0x7d, 0x66, 0x6f, 0x50, 0x59, 0x42, 0x4b,
+	0x17, 0x1e, 0x05, 0x0c, 0x33, 0x3a, 0x21, 0x28,
+	0x5f, 0x56, 0x4d, 0x44, 0x7b, 0x72, 0x69, 0x60,
+	0x0e, 0x07, 0x1c, 0x15, 0x2a, 0x23, 0x38, 0x31,
+	0x46, 0x4f, 0x54, 0x5d, 0x62, 0x6b, 0x70, 0x79
+};
+
+static uint8_t crc7(uint8_t crc, const uint8_t *buf, int len)
+{
+	while (len--)
+		crc = crc7_syndrome_table[(crc << 1) ^ *buf++];
+	return crc;
+}
+
+int main(int argc, char *argv[])
+{
+	uint8_t buf[4];
+	uint8_t crc = 0;
+	int fd, n, t = 0, count = 0;
+
+	if (argc != 2) {
+		fprintf(stderr, "Usage: %s <spl-image>\n", argv[0]);
+		return 1;
+	}
+
+	fd = open(argv[1], O_RDWR);
+	if (fd < 0) {
+		perror(argv[1]);
+		return 1;
+	}
+
+	while ((n = read(fd, buf, sizeof(buf))) > 0) {
+		if (t >= SKIP_SIZE)
+			crc = crc7(crc, buf, n);
+		else
+			t += sizeof(buf);
+		count += n;
+	}
+
+	printf("mkt31spl: %s: size=%#x crc7=%#x\n", argv[1], count, crc);
+
+	lseek(fd, CRC_POSITION, SEEK_SET);
+	if (write(fd, &crc, 1) != 1) {
+		perror("write crc");
+		return 1;
+	}
+
+	buf[0] = count & 0xff;
+	buf[1] = (count >> 8) & 0xff;
+	buf[2] = (count >> 16) & 0xff;
+	buf[3] = (count >> 24) & 0xff;
+	lseek(fd, SPL_LENGTH_POSITION, SEEK_SET);
+	if (write(fd, buf, 4) != 4) {
+		perror("write length");
+		return 1;
+	}
+
+	close(fd);
+	return 0;
+}
