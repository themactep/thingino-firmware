+static int k3_pll_clk_of_xlate(struct clk *clk, struct ofnode_phandle_args *args)
+{
+	if (args->args_count > 1) {
+		debug("Invalid args_count: %d\n", args->args_count);
+		return -EINVAL;
+	}
+
+	if (args->args_count)
+		clk->id = K3_PLL_ID + args->args[0];
+	else
+		clk->id = K3_PLL_ID;
+
+	return 0;
