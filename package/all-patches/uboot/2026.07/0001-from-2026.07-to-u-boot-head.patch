+      bm:2
+      usb_init : enter 3296,3072
+      usb_core_init : enter
+      DWC3_GRXTHRCFG:0x4400000
+      ROM: usb download handler
+       rst
+      done H
+      setup= 0x1000680 0x400000,
+       rst
+      done H
+      setup= 0x290500 0x0,
