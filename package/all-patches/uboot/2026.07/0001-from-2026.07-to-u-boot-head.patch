+ast2700_soc1_pinctrl_get_pin_name(struct udevice *dev, unsigned int selector)
+{
+	if (selector >= ARRAY_SIZE(ast2700_soc1_pin_names))
+		return NULL;
+
+	return ast2700_soc1_pin_names[selector];
+}
