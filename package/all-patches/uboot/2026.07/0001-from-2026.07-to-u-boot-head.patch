+		plat->bitmask = CLKMGR_MAINPLLGRP_EN_L4MAINCLK_MASK;
+		break;
+	case N5X_L4_MP_CLK:
+	case N5X_NAND_X_CLK:
+		plat->pllgrp = CLKMGR_MAINPLL_EN;
