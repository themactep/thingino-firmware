+		    MT6358_BUCK_VDRAM1_DBG0, GENMASK(6, 0)),
+	MT6366_BUCK("vcore", VCORE, 500000, 1293750, 6250,
+		    MT6358_BUCK_VCORE_CON0, MT6358_BUCK_VCORE_ELR0, GENMASK(6, 0),
