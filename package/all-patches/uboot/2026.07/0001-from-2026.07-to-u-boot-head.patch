-			dest = efi_get_next_mem_desc(dest, desc_size);
-		}
-		addr = desc->physical_start + (desc->num_pages <<
-				EFI_PAGE_SHIFT);
-	}
-
-	/* Mark the end */
-	dest->type = EFI_MAX_MEMORY_TYPE;
-
-	return base;
-}
