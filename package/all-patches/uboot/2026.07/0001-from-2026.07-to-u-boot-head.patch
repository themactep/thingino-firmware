+int board_phys_sdram_size(phys_size_t *size)
+{
+	if (!size)
+		return -EINVAL;
+
+	/*
+	 * check various RAM sizes (1, 2 and 4 GB) otherwise
+	 * return the default of 2GB
+	 */
+	*size = get_ram_size((void *)PHYS_SDRAM,
