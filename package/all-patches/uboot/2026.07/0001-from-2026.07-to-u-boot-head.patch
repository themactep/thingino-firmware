+		"mdio list\0"						\
+	"PS1=nbxv3> \0"							\
+	"ps_refresh="							\
+		"setenv PS1 \"nbxv3 ${ethact} ${ipaddr}> \"\0"		\
+	"preboot=run mdio_list ; run ps_refresh\0"
