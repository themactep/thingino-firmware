+		"sf write ${kernel_addr_r} ${fit_nor_offset} ${filesize} && "\
+		"reset\0"						\
+	"xspi_bootcmd="							\
+		"cp.b 0x21000000 ${kernel_addr_r} ${fit_nor_size} && "	\
+		"bootm ${kernel_addr_r}#conf-${carrier}\0"		\
+	"fsl_bootcmd_mcinitcmd_set=y\0"					\
+	"bootcmd=run mc_init || run provision_openocd_fit\0"		\
