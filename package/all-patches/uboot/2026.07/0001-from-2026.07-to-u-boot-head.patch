-	writel(0x00C03F3F, &ccm->CCGR0);
-	writel(0x0030FC03, &ccm->CCGR1);
-	writel(0x0FFFC000, &ccm->CCGR2);
-	writel(0x3FF00000, &ccm->CCGR3);
-	writel(0xFFFFF300, &ccm->CCGR4);
-	writel(0x0F0000F3, &ccm->CCGR5);
-	writel(0x00000FFF, &ccm->CCGR6);
-}
