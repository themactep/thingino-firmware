+&verdin_gpio_keys {
+	status = "okay";
+};
diff --git a/dts/upstream/src/arm64/freescale/imx95-verdin-ivy.dtsi b/dts/upstream/src/arm64/freescale/imx95-verdin-ivy.dtsi
