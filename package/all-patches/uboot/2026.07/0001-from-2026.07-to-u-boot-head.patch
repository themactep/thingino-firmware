diff --git a/dts/upstream/src/arm64/ti/k3-am625-verdin-panel-cap-touch-10inch-dsi.dtso b/dts/upstream/src/arm64/ti/k3-am625-verdin-panel-cap-touch-10inch-dsi.dtso
