diff --git a/arch/mips/dts/t30a-isvp-dfu.dts b/arch/mips/dts/t30a-isvp-dfu.dts
new file mode 100644
index 00000000..b843ad51
--- /dev/null
+++ b/arch/mips/dts/t30a-isvp-dfu.dts
@@ -0,0 +1,28 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Ingenic ISVP-T30A, DFU/USB-boot loader variant (DDR2 128 MB, CPU 864 MHz;
+ * param-identical to T30X). Per-variant: do not reuse a loader across variants.
+ */
+
+/dts-v1/;
+
+#include "t30-isvp-dfu.dtsi"
+
+/ {
+	model = "Ingenic ISVP-T30A (DFU loader)";
+};
+
+&ddr {
+	/* T30A: DDR2 128 MB M14D1G1664A (8-bank), CPU 864 / DDR 500 MHz. */
+	ingenic,sdram-params = <
+		0x09508820 0x09508820 0x9a0b5510	/* APLL1200 MPLL1200 CPCCR */
+		0 0					/* ddr_cdr (MPLL/2); DDR2 */
+		13 10 1 1 0 0				/* row col bank8 cs0 cs1 dw32 */
+		0x08000000				/* 128 MB */
+		0x0aa88a42 0x0000d91e			/* DDRC_CFG DDRC_CTRL */
+		0x000020f8 0x00002800 0x00910003	/* MMAP0 MMAP1 REFCNT */
+		0x050f0a06 0x021c0a07 0x200a0722	/* TIMING1..3 */
+		0x26240031 0xff060405 0x321c0505	/* TIMING4..6 */
+		0x00000e73				/* MR0 */
+	>;
+};
