diff --git a/arch/mips/dts/t31-isvp-dfu-uboot-common.dtsi b/arch/mips/dts/t31-isvp-dfu-uboot-common.dtsi
new file mode 100644
index 00000000..3cd67916
--- /dev/null
+++ b/arch/mips/dts/t31-isvp-dfu-uboot-common.dtsi
@@ -0,0 +1,53 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Shared U-Boot overlay for the Ingenic ISVP-T31 DFU/USB-boot leaf DTs.
+ * Each per-SKU <leaf>-u-boot.dtsi is a one-line #include of this file.
+ *
+ * The USB-boot path uploads spl/u-boot-spl.bin + u-boot-lzma.img via the
+ * mask ROM (t31-usbboot.py), so the binman flash image here is not used
+ * in the USB-boot flow; it is kept for a sensible `make` artifact.
+ *
+ * The DFU-loader SPL returns to the mask ROM (it does not load U-Boot
+ * from NOR), so only the DDR controller + its clock tree need to survive
+ * into the SPL devicetree for the UCLASS_RAM probe; without these
+ * bootph-all tags the DDR node is stripped and the SPL hangs before DDR
+ * is up.
+ */
+
+/ {
+	binman: binman {
+		multiple-images;
+	};
+};
+
+&binman {
+	u-boot-spl-t31 {
+		filename = "u-boot-spl-t31.bin";
+
+		ingenic-t31-spl {
+			filename = "spl/u-boot-spl.bin";
+		};
+	};
+
+	flash {
+		filename = "u-boot-with-spl-lzma.bin";
+		pad-byte = <0xff>;
+
+		spl {
+			type = "blob";
+			offset = <0x0>;
+			filename = "u-boot-spl-t31.bin";
+		};
+
+		u-boot {
+			type = "blob";
+			offset = <0x14000>;
+			filename = "u-boot-lzma.img";
+		};
+	};
+};
+
+&exclk { bootph-all; };
+&rtclk { bootph-all; };
+&cgu { bootph-all; };
+&ddr { bootph-all; };		/* leaf .dts supplies ingenic,sdram-params */
diff --git a/arch/mips/dts/t31-isvp-dfu.dtsi b/arch/mips/dts/t31-isvp-dfu.dtsi
new file mode 100644
index 00000000..6fa722b3
--- /dev/null
+++ b/arch/mips/dts/t31-isvp-dfu.dtsi
@@ -0,0 +1,73 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Ingenic ISVP-T31 shared DFU/USB-boot board body.
+ *
+ * Identical to t31-isvp.dtsi except the DWC2 OTG is dr_mode =
+ * "peripheral" so the dwc2_udc_otg gadget binds (dwc2_udc_otg_bind
+ * rejects "host"). Used by the usbboot defconfigs - the dev/flash
+ * loader that USB-boots and auto-enters DFU. Production NOR uses
+ * t31-isvp.dtsi (dr_mode="host" for USB host + USB-NIC).
+ *
+ * The per-SKU leaf .dts files (t31l-isvp-dfu.dts, t31a-isvp-dfu.dts)
+ * include this and supply the DDR node's per-SKU "ingenic,sdram-params" array; the matching
+ * <leaf>-u-boot.dtsi pulls in t31-isvp-dfu-uboot-common.dtsi.
+ */
+
+#include <dt-bindings/gpio/gpio.h>
+#include "t31.dtsi"
+
+/ {
+	compatible = "ingenic,isvp-t31", "ingenic,t31";
+	model = "Ingenic ISVP-T31 (DFU loader)";
+
+	aliases {
+		serial1 = &uart1;
+	};
+
+	chosen {
+		stdout-path = "serial1:115200n8";
+	};
+
+	memory@0 {
+		device_type = "memory";
+		/* Placeholder; the DDR driver reports the real per-SKU size. */
+		reg = <0x0 0x08000000>;
+	};
+};
+
+&uart1 {
+	status = "okay";
+};
+
+&sfc {
+	status = "okay";
+
+	flash@0 {
+		compatible = "jedec,spi-nor";
+		reg = <0>;
+		spi-max-frequency = <50000000>;
+	};
+};
+
+&msc0 {
+	status = "okay";
+	bus-width = <4>;
+	broken-cd;
+};
+
+&otg {
+	status = "okay";
+	dr_mode = "peripheral";		/* gadget bind for DFU/g_dnl */
+};
+
+/*
+ * Onboard RMII ethernet, enabled in the loader for tftp/dhcp recovery.
+ * Same PHY as the SFC-NOR boards; the 50 MHz RMII reference is derived
+ * from the per-variant MPLL, so each leaf DFU .dts supplies its own
+ * clocks (ingenic,sdram-params) - never share one loader across variants.
+ */
+&gmac {
+	status = "okay";
+	/* IP101G PHY reset (ISVP reference default = GPIO PB28). */
+	ingenic,reset-gpio = <&gpb 28 GPIO_ACTIVE_LOW>;
+};
diff --git a/arch/mips/dts/t31-isvp-uboot-common.dtsi b/arch/mips/dts/t31-isvp-uboot-common.dtsi
new file mode 100644
index 00000000..d28f9794
--- /dev/null
+++ b/arch/mips/dts/t31-isvp-uboot-common.dtsi
@@ -0,0 +1,166 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Shared U-Boot overlay for the Ingenic ISVP-T31 SFC-NOR leaf DTs.
+ * Each per-SKU <leaf>-u-boot.dtsi is a one-line #include of this file
+ * (the U-Boot build auto-appends <leaf>-u-boot.dtsi to <leaf>.dts).
+ *
+ * T31 boots a TPL chain. Its NOR mask ROM is uncapped, but the SD-card ROM
+ * runs the first stage in a cache-lock window that cannot hold the SPL once it
+ * carries the DM + SFC/MMC stack - so, like every XBurst1 SoC, the bring-up is
+ * split: the ROM loads the headered TPL (NOR offset 0, or SD sector 34); the
+ * TPL brings up DDR in cache-as-RAM and reads the DRAM-resident SPL (NOR 0x8000,
+ * or SD 0x10000); the SPL reads U-Boot (NOR 0x18000 = CONFIG_SYS_SPI_U_BOOT_OFFS,
+ * or SD 0x30000). The 2 KiB header CRC7+length is finalized by the family-
+ * generic ingenic-t31-spl binman etype.
+ *
+ * Phase tags: the TPL/SPL devicetrees are fdtgrep-filtered out of the single
+ * dt.dtb by bootph tags (TPL keeps bootph-all + bootph-pre-sram; SPL keeps
+ * bootph-all + bootph-pre-ram), NOT re-preprocessed per phase. The TPL's only
+ * DM device is &ddr (its probe brings up PLL + DDR, then it hand-loads the SPL
+ * with bare-metal SFC/serial helpers), so only &ddr is tagged for all phases;
+ * every other node is bootph-pre-ram + bootph-some-ram (present in the SPL DM
+ * boot and U-Boot pre-reloc, absent from the minimal TPL).
+ */
+
+/ {
+	binman: binman {
+		multiple-images;
+	};
+};
+
+&binman {
+#if defined(CONFIG_SPL_MMC)
+	/*
+	 * MSC/SD-card boot image (isvp_t31x_msc0). The XBurst1 SD ROM reads the
+	 * headered first stage (the TPL) off the card, checks the MSPL magic and
+	 * jumps to it. The TPL reprograms MSC0CDR for its own bare-metal SPL read
+	 * (the shared xburst_tpl_msc_read), brings up DDR, loads the DRAM-resident
+	 * SPL and jumps; the SPL then probes DM MMC to load U-Boot. SD layout: TPL
+	 * at sector 34 (0x4400), the DRAM-resident SPL at 0x10000, U-Boot at
+	 * SYS_MMCSD_RAW_MODE_U_BOOT_SECTOR (0x180 = 0x30000).
+	 */
+	u-boot-tpl-t31-msc {
+		filename = "u-boot-tpl-t31-msc.bin";
+
+		ingenic-t31-spl {
+			filename = "tpl/u-boot-tpl.bin";
+		};
+	};
+
+	mmc {
+		filename = "u-boot-with-tpl-mmc-lzma.bin";
+		pad-byte = <0x00>;
+
+		tpl {
+			type = "blob";
+			offset = <0x4400>;
+			filename = "u-boot-tpl-t31-msc.bin";
+		};
+
+		spl {
+			type = "blob";
+			offset = <0x10000>;
+			filename = "spl/u-boot-spl.bin";
+		};
+
+		u-boot {
+			type = "blob";
+			offset = <0x30000>;
+			filename = "u-boot-lzma.img";
+		};
+	};
+#elif defined(CONFIG_TPL)
+	u-boot-tpl-t31 {
+		filename = "u-boot-tpl-t31.bin";
+
+		ingenic-t31-spl {
+			filename = "tpl/u-boot-tpl.bin";
+		};
+	};
+
+	flash {
+		filename = "u-boot-with-tpl-lzma.bin";
+		pad-byte = <0xff>;
+
+		tpl {
+			type = "blob";
+			offset = <0x0>;
+			filename = "u-boot-tpl-t31.bin";
+		};
+
+		spl {
+			type = "blob";
+			offset = <0x8000>;
+			filename = "spl/u-boot-spl.bin";
+		};
+
+		u-boot {
+			type = "blob";
+			offset = <0x18000>;
+			filename = "u-boot-lzma.img";
+		};
+	};
+#else
+	u-boot-spl-t31 {
+		filename = "u-boot-spl-t31.bin";
+
+		ingenic-t31-spl {
+			filename = "spl/u-boot-spl.bin";
+		};
+	};
+
+	flash {
+		filename = "u-boot-with-spl-lzma.bin";
+		pad-byte = <0xff>;
+
+		spl {
+			type = "blob";
+			offset = <0x0>;
+			filename = "u-boot-spl-t31.bin";
+		};
+
+		u-boot {
+			type = "blob";
+			offset = <0x14000>;
+			filename = "u-boot-lzma.img";
+		};
+	};
+#endif
+};
+
+&exclk { bootph-pre-ram; bootph-some-ram; };
+&rtclk { bootph-pre-ram; bootph-some-ram; };
+&cgu { bootph-pre-ram; bootph-some-ram; };
+&ddr { bootph-all; };		/* the TPL's only DM device; leaf supplies params */
+&pinctrl { bootph-pre-ram; bootph-some-ram; };
+&gpa { bootph-pre-ram; bootph-some-ram; };
+&gpb { bootph-pre-ram; bootph-some-ram; };
+&gpc { bootph-pre-ram; bootph-some-ram; };
+&gpd { bootph-pre-ram; bootph-some-ram; };
+&uart1 { bootph-pre-ram; bootph-some-ram; };
+
+#if defined(CONFIG_SPL_MMC)
+/*
+ * MSC/SD boot: the SPL probes the native jz_mmc controller (the TPL's SD
+ * read is bare-metal, so the TPL devicetree still needs only &ddr). msc0 is
+ * status="disabled" in t31.dtsi - the NOR boards never use it - so enable it
+ * here and tag it + its pins for the SPL and pre-reloc U-Boot phases.
+ */
+&msc0 {
+	bootph-pre-ram;
+	bootph-some-ram;
+	broken-cd;		/* the SD is the boot medium - always present */
+	status = "okay";
+};
+&pins_mmc0 { bootph-pre-ram; bootph-some-ram; };
+#else
+&pins_sfc { bootph-pre-ram; bootph-some-ram; };
+&sfc {
+	bootph-pre-ram;
+	bootph-some-ram;
+	flash@0 {
+		bootph-pre-ram;
+		bootph-some-ram;
+	};
+};
+#endif
diff --git a/arch/mips/dts/t31-isvp.dtsi b/arch/mips/dts/t31-isvp.dtsi
new file mode 100644
index 00000000..8c050944
--- /dev/null
+++ b/arch/mips/dts/t31-isvp.dtsi
@@ -0,0 +1,78 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Ingenic ISVP-T31 shared board body (SFC-NOR, USB host).
+ *
+ * The per-SKU leaf .dts files (t31x-isvp.dts, t31n-isvp.dts,
+ * t31l-isvp.dts, t31a-isvp.dts) include this and supply the DDR node's
+ * per-SKU "ingenic,sdram-params" array, consumed by the shared Innophy
+ * DDR driver (ddr_t31.c). The matching <leaf>-u-boot.dtsi pulls in
+ * t31-isvp-uboot-common.dtsi (binman image + SPL bootph).
+ */
+
+#include <dt-bindings/gpio/gpio.h>
+#include "t31.dtsi"
+
+/ {
+	compatible = "ingenic,isvp-t31", "ingenic,t31";
+	model = "Ingenic ISVP-T31 (SFC NOR)";
+
+	aliases {
+		serial1 = &uart1;
+	};
+
+	chosen {
+		stdout-path = "serial1:115200n8";
+	};
+
+	memory@0 {
+		device_type = "memory";
+		/* Placeholder; the DDR driver reports the real per-SKU size. */
+		reg = <0x0 0x08000000>;
+	};
+};
+
+&uart1 {
+	status = "okay";
+};
+
+&sfc {
+	status = "okay";
+
+	flash@0 {
+		compatible = "jedec,spi-nor";
+		reg = <0>;
+		spi-max-frequency = <50000000>;
+	};
+};
+
+&msc0 {
+	status = "okay";
+	bus-width = <4>;
+	broken-cd;	/* no card-detect line wired on the ISVP board */
+};
+
+&gmac {
+	status = "okay";
+	/* IP101G PHY reset (ISVP reference default = GPIO PB28). The
+	 * exact pin varies per board; override per device as needed. */
+	ingenic,reset-gpio = <&gpb 28 GPIO_ACTIVE_LOW>;
+};
+
+&otg {
+	status = "okay";
+};
+
+&aic {
+	status = "okay";
+};
+
+&codec {
+	status = "okay";
+	/* Speaker-amp enable: SDK default PB31, active-high. Override
+	 * here per board if the amp is on a different pin/polarity. */
+	ingenic,spk-gpio = <&gpb 31 GPIO_ACTIVE_HIGH>;
+};
+
+&sound {
+	status = "okay";
+};
diff --git a/arch/mips/dts/t31.dtsi b/arch/mips/dts/t31.dtsi
new file mode 100644
index 00000000..ee95c91b
--- /dev/null
+++ b/arch/mips/dts/t31.dtsi
@@ -0,0 +1,261 @@
+// SPDX-License-Identifier: GPL-2.0+
+
+#include <dt-bindings/clock/ingenic,t31-cgu.h>
+
+/ {
+	#address-cells = <1>;
+	#size-cells = <1>;
+	compatible = "ingenic,t31";
+
+	cpus {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		cpu0: cpu@0 {
+			device_type = "cpu";
+			compatible = "ingenic,xburst", "mips,mips32r2";
+			reg = <0>;
+		};
+	};
+
+	cpuintc: interrupt-controller {
+		#address-cells = <0>;
+		#interrupt-cells = <1>;
+		interrupt-controller;
+		compatible = "mti,cpu-interrupt-controller";
+	};
+
+	exclk: exclk {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <24000000>;
+	};
+
+	rtclk: rtclk {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <32768>;
+	};
+
+	/*
+	 * CGU (Clock/Power Manager). The SPL programs the PLLs and the
+	 * CPU/DDR/bus dividers; this driver runs in U-Boot proper and
+	 * recalculates the PLL rates and provides rate/gate control for
+	 * the leaf peripheral clocks (SFC, MMC, GMAC). Binding mirrors
+	 * the mainline Linux port (ingenic,t31-cgu) so one device tree is
+	 * valid on both. The driver accesses the CPM block via KSEG1.
+	 */
+	cgu: clock-controller@10000000 {
+		compatible = "ingenic,t31-cgu", "simple-mfd";
+		reg = <0x10000000 0x1000>;
+		#clock-cells = <1>;
+		clocks = <&exclk>, <&rtclk>;
+		clock-names = "ext", "rtc";
+		bootph-pre-ram;
+	};
+
+	/*
+	 * DDR2/DDR3 controller + Innophy PHY. One compatible for every SKU
+	 * (the shared drivers/ram/ingenic/ddr_t31.c also serves T23/T21/T30);
+	 * the board leaf .dts supplies the per-SKU "ingenic,sdram-params" u32
+	 * array (struct ingenic_t31_ddr_params, drivers/ram/ingenic/ddr_t31.h),
+	 * serialized in this order:
+	 *   [0..2]   SPL PLL setpoints: CPAPCR, CPMPCR, CPCCR
+	 *   [3]      CPM_DDRCDR divider (0 = MPLL/2)
+	 *   [4]      DDR type (0 = DDR2, 1 = DDR3)
+	 *   [5..10]  row, col, bank8, cs0, cs1, dw32
+	 *   [11]     total DRAM size in bytes
+	 *   [12..16] DDRC_CFG, CTRL, MMAP0, MMAP1, REFCNT
+	 *   [17..22] DDRC_TIMING1..6
+	 *   [23]     MR0
+	 * bootph-all is added by the leaf's shared U-Boot overlay so the node
+	 * survives into the SPL devicetree.
+	 */
+	ddr: memory-controller@134f0000 {
+		compatible = "ingenic,t31-ddr-innophy";
+		reg = <0x134f0000 0x1000>;
+	};
+
+	/*
+	 * TCU (timer/counter unit). Container node mirroring the mainline
+	 * Linux binding (ingenic,t31-tcu / simple-mfd) so the watchdog
+	 * child binds; U-Boot only needs the watchdog (for sysreset).
+	 * The watchdog driver self-clocks from the 32 kHz RTC, so the
+	 * TCU clock provider is not required here.
+	 */
+	tcu: timer@10002000 {
+		compatible = "ingenic,t31-tcu", "ingenic,jz4760-tcu",
+			     "simple-mfd";
+		reg = <0x10002000 0x1000>;
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges = <0x0 0x10002000 0x1000>;
+
+		watchdog: watchdog@0 {
+			compatible = "ingenic,t31-watchdog",
+				     "ingenic,jz4780-watchdog";
+			reg = <0x0 0x10>;
+		};
+	};
+
+	uart1: serial@10031000 {
+		compatible = "ingenic,jz4780-uart";
+		reg = <0x10031000 0x100>;
+		reg-shift = <2>;
+		clock-frequency = <24000000>;
+		status = "disabled";
+	};
+
+	sfc: spi@13440000 {
+		compatible = "ingenic,t31-sfc";
+		reg = <0x13440000 0x10000>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+		clocks = <&cgu T31_CLK_SFC>;
+		spi-max-frequency = <50000000>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pins_sfc>;
+		status = "disabled";
+	};
+
+	msc0: mmc@13450000 {
+		compatible = "ingenic,t31-mmc";
+		reg = <0x13450000 0x1000>;
+		clocks = <&cgu T31_CLK_MSC0>;
+		clock-names = "mmc";
+		cap-sd-highspeed;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pins_mmc0>;
+		status = "disabled";
+	};
+
+	/*
+	 * Pin controller + GPIO. Mirrors the mainline Linux
+	 * ingenic,t31-pinctrl binding: the pin-controller owns the
+	 * register block and has four ingenic,t31-gpio child banks
+	 * (PA..PD). Consumers select a function via the standard pinmux
+	 * binding (pinctrl-0 -> a node with function/groups).
+	 */
+	pinctrl: pinctrl@10010000 {
+		compatible = "ingenic,t31-pinctrl";
+		reg = <0x10010000 0x1000>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		gpa: gpio@0 {
+			compatible = "ingenic,t31-gpio";
+			reg = <0>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		gpb: gpio@1 {
+			compatible = "ingenic,t31-gpio";
+			reg = <1>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		gpc: gpio@2 {
+			compatible = "ingenic,t31-gpio";
+			reg = <2>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		gpd: gpio@3 {
+			compatible = "ingenic,t31-gpio";
+			reg = <3>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		pins_sfc: sfc {
+			function = "sfc";
+			groups = "sfc-data";
+		};
+
+		pins_mmc0: mmc0 {
+			function = "mmc0";
+			groups = "mmc0-1bit", "mmc0-4bit";
+		};
+
+		pins_mac: mac {
+			function = "mac";
+			groups = "mac-rmii";
+		};
+	};
+
+	/*
+	 * GMAC: Synopsys DesignWare MAC. ingenic,mode-reg is the CPM
+	 * GMAC-PHY-control register (CPM 0xb0000000 + 0xe8) used to
+	 * select the PHY interface and speed; the glue also ungates the
+	 * GMAC clock and programs CPM_MACCDR for the MAC-PHY rate.
+	 */
+	gmac: ethernet@134b0000 {
+		compatible = "ingenic,t31-gmac";
+		reg = <0x134b0000 0x2000>;
+		phy-mode = "rmii";
+		max-speed = <100>;
+		clocks = <&cgu T31_CLK_GMAC>;
+		ingenic,mode-reg = <0x100000e8>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pins_mac>;
+		status = "disabled";
+	};
+
+	/*
+	 * DWC2 USB OTG. One controller, one DM bind: host (usb start ->
+	 * USB ethernet/storage) OR gadget (dfu/ums) - not both at once.
+	 * Production default is host so USB networking works out of the
+	 * box; entering DFU for field firmware update is a deliberate
+	 * role switch on a recovery trigger (TODO, see memory). The
+	 * USB-boot dev loop uses a separate gadget build for flashing.
+	 */
+	otg: usb@13500000 {
+		compatible = "snps,dwc2";
+		reg = <0x13500000 0x40000>;
+		dr_mode = "host";
+		clocks = <&cgu T31_CLK_OTG>;
+		g-rx-fifo-size = <512>;
+		g-np-tx-fifo-size = <16>;
+		g-tx-fifo-size = <256 256 16 16 16>;
+		status = "disabled";
+	};
+
+	/*
+	 * Audio: AIC (I2S) controller + on-chip codec. PIO playback driven
+	 * by U-Boot's `sound` command. Speaker-amp enable GPIO is per-board
+	 * (set in the board .dts via ingenic,spk-gpio; SDK default PB31
+	 * active-high). Compatible split: T20 -> A-block codec; T31/C100/T23
+	 * -> B-block codec (jz_t10_codec handles both via driver_data).
+	 */
+	aic: audio-controller@10020000 {
+		compatible = "ingenic,t31-aic";
+		clocks = <&cgu T31_CLK_MPLL>;
+		clock-names = "mpll";
+		reg = <0x10020000 0x100>;
+		#sound-dai-cells = <0>;
+		status = "disabled";
+	};
+
+	codec: audio-codec@10021000 {
+		compatible = "ingenic,t31-codec";
+		reg = <0x10021000 0x140>;
+		#sound-dai-cells = <0>;
+		status = "disabled";
+	};
+
+	sound: sound {
+		compatible = "ingenic,t31-sound";
+		status = "disabled";
+
+		cpu {
+			sound-dai = <&aic>;
+		};
+
+		codec {
+			sound-dai = <&codec>;
+		};
+	};
+};
