diff --git a/arch/sandbox/Makefile b/arch/sandbox/Makefile
index 5bbf9f1f..0360d2bd 100644
--- a/arch/sandbox/Makefile
+++ b/arch/sandbox/Makefile
@@ -1,13 +1,4 @@
