+#include <dt-bindings/gpio/gpio.h>
+#include "t32.dtsi"
+
+/ {
+	compatible = "ingenic,isvp-t32", "ingenic,t32";
+	model = "Ingenic ISVP-T32 (SFC NOR)";
+
+	aliases {
+		serial1 = &uart1;
+	};
+
+	chosen {
+		stdout-path = "serial1:115200n8";
+	};
+
+	memory@0 {
+		device_type = "memory";
+		/* Placeholder; the DDR driver reports the real per-SKU size. */
+		reg = <0x0 0x04000000>;
+	};
+};
+
+&uart1 {
+	status = "okay";
+};
+
+&sfc {
+	status = "okay";
+
+	flash@0 {
+		compatible = "jedec,spi-nor";
+		reg = <0>;
+		spi-max-frequency = <50000000>;
+	};
+};
+
+&msc0 {
+	status = "okay";
+};
+
+&gmac {
+	status = "okay";
+	/* No PHY reset line by default (the driver falls back to an MDIO
+	 * BMCR soft-reset). Boards that wire one add ingenic,reset-gpio
+	 * here, like T31 (vendor T32 reference: PB26 active-low). */
+};
+
+&otg {
+	status = "okay";
+	/* Host by default; USB-NIC and mass-storage commands need a
+	 * host controller. Switch to "peripheral" via the dedicated
+	 * isvp_t32*_usbboot defconfigs + DT pairs for DFU loads. */
+	dr_mode = "host";
+};
+
+&aic {
+	status = "okay";
+};
+
+&codec {
+	status = "okay";
+	ingenic,spk-gpio = <&gpb 31 GPIO_ACTIVE_LOW>;
+};
+
+&sound {
+	status = "okay";
+};
diff --git a/arch/mips/dts/t32.dtsi b/arch/mips/dts/t32.dtsi
new file mode 100644
index 00000000..b9c3112f
--- /dev/null
+++ b/arch/mips/dts/t32.dtsi
@@ -0,0 +1,269 @@
+// SPDX-License-Identifier: GPL-2.0+
+
+#include <dt-bindings/clock/ingenic,t32-cgu.h>
+
+/ {
+	#address-cells = <1>;
+	#size-cells = <1>;
+	compatible = "ingenic,t32";
+
+	cpus {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		cpu0: cpu@0 {
+			device_type = "cpu";
+			compatible = "ingenic,xburst", "mips,mips32r2";
+			reg = <0>;
+		};
+	};
+
+	cpuintc: interrupt-controller {
+		#address-cells = <0>;
+		#interrupt-cells = <1>;
+		interrupt-controller;
+		compatible = "mti,cpu-interrupt-controller";
+	};
+
+	exclk: exclk {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <24000000>;
+	};
+
+	rtclk: rtclk {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <32768>;
+	};
+
+	/*
+	 * CGU. The SPL programs the PLLs/dividers; this driver runs in
+	 * U-Boot proper, recalculates the PLL rates and provides
+	 * rate/gate control for the leaf clocks. T32 (PRJ007) is NOT
+	 * CGU-bit-compatible with T31 (own clk-t32 driver / binding).
+	 */
+	cgu: clock-controller@10000000 {
+		compatible = "ingenic,t32-cgu", "simple-mfd";
+		reg = <0x10000000 0x1000>;
+		#clock-cells = <1>;
+		clocks = <&exclk>, <&rtclk>;
+		clock-names = "ext", "rtc";
+		bootph-pre-ram;
+	};
+
+	/*
+	 * DDR: Synopsys uMCTL2-class controller + Innophy training PHY,
+	 * each with its own APB aperture. The per-SKU register/timing block
+	 * is supplied as the leaf .dts's "ingenic,sdram-params" array,
+	 * consumed by drivers/ram/ingenic/ddr_t32.c (the rk3328 DMC model).
+	 * bootph-all is added by the leaf's shared U-Boot overlay so the
+	 * node survives into the SPL devicetree.
+	 */
+	ddr: memory-controller@13012000 {
+		compatible = "ingenic,t32-ddr-innophy";
+		reg = <0x13012000 0x1000>,	/* uMCTL2 controller APB */
+		      <0x13011000 0x1000>;	/* Innophy PHY APB */
+	};
+
+	/*
+	 * TCU container (mirrors the Linux ingenic tcu/simple-mfd
+	 * binding) so the watchdog child binds; U-Boot only needs the
+	 * watchdog for sysreset (it self-clocks from the 32 kHz RTC).
+	 */
+	tcu: timer@10002000 {
+		compatible = "ingenic,t32-tcu", "ingenic,jz4760-tcu",
+			     "simple-mfd";
+		reg = <0x10002000 0x1000>;
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges = <0x0 0x10002000 0x1000>;
+
+		watchdog: watchdog@0 {
+			compatible = "ingenic,t32-watchdog",
+				     "ingenic,jz4780-watchdog";
+			reg = <0x0 0x10>;
+		};
+	};
+
+	uart1: serial@10031000 {
+		compatible = "ingenic,jz4780-uart";
+		reg = <0x10031000 0x100>;
+		reg-shift = <2>;
+		clock-frequency = <24000000>;
+		status = "disabled";
+	};
+
+	/*
+	 * SFC2 (descriptor-capable SPI-NOR controller), driven by the DM
+	 * SFC driver (drivers/spi/ingenic_sfc.c) in both the SPL (the
+	 * standard SPL_SPI U-Boot load) and U-Boot proper. Status
+	 * disabled here, enabled per-board.
+	 */
+	sfc: spi@13440000 {
+		compatible = "ingenic,t32-sfc";
+		reg = <0x13440000 0x10000>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+		clocks = <&cgu T32_CLK_SFC>;
+		spi-max-frequency = <50000000>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pins_sfc>;
+		status = "disabled";
+	};
+
+	msc0: mmc@13060000 {
+		compatible = "ingenic,t32-mmc";
+		reg = <0x13060000 0x10000>;
+		clocks = <&cgu T32_CLK_MSC0>;
+		clock-names = "mmc";
+		bus-width = <4>;
+		broken-cd;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pins_mmc0 &pins_sfc1>;
+		status = "disabled";
+	};
+
+	/*
+	 * GMAC: Synopsys DesignWare MAC, same base/glue as T31
+	 * (vendor PRJ.dtsi mac@0x134b0000, mode-reg 0x100000e8) and the
+	 * same RMII pad set (PB6-11/PB13-16 func 0). ingenic,mode-reg is
+	 * the CPM GMAC-PHY-control register used to select the PHY
+	 * interface; the glue also ungates the GMAC clock and programs
+	 * CPM_MACCDR off the live MPLL (per-SKU 1200/1400 MHz).
+	 */
+	gmac: ethernet@134b0000 {
+		compatible = "ingenic,t32-gmac";
+		reg = <0x134b0000 0x2000>;
+		phy-mode = "rmii";
+		max-speed = <100>;
+		clocks = <&cgu T32_CLK_GMAC>;
+		ingenic,mode-reg = <0x100000e8>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pins_mac>;
+		status = "disabled";
+	};
+
+	/*
+	 * DWC2 USB OTG. T32 puts the controller at the same base as
+	 * T31 (0x13500000). The host/peripheral split is per-board:
+	 * production NOR boots use dr_mode = "host" so the host can
+	 * see a USB-NIC; the t32-isvp-dfu.dts overlay flips dr_mode
+	 * to "peripheral" for the DFU loader. Status disabled here,
+	 * enabled per-board.
+	 */
+	otg: usb@13500000 {
+		compatible = "snps,dwc2";
+		reg = <0x13500000 0x40000>;
+		dr_mode = "host";
+		clocks = <&cgu T32_CLK_OTG>;
+		g-rx-fifo-size = <512>;
+		g-np-tx-fifo-size = <16>;
+		g-tx-fifo-size = <256 256 16 16 16>;
+		status = "disabled";
+	};
+
+	/*
+	 * Audio: AIC (I2S) controller + on-chip codec. PIO playback
+	 * driven by U-Boot's `sound` command. The T32 codec is a
+	 * different silicon block from the jz_t10 family used on
+	 * T10..T31/C100 - different register set, separate driver
+	 * (t32_codec). Speaker-amp enable GPIO is per-board (set via
+	 * ingenic,spk-gpio on the codec node when needed - boards that
+	 * hardwire the amp omit it).
+	 */
+	aic: audio-controller@10020000 {
+		compatible = "ingenic,t32-aic";
+		clocks = <&cgu T32_CLK_MPLL>;
+		clock-names = "mpll";
+		reg = <0x10020000 0x100>;
+		#sound-dai-cells = <0>;
+		status = "disabled";
+	};
+
+	codec: audio-codec@10021000 {
+		compatible = "ingenic,t32-codec";
+		reg = <0x10021000 0x140>;
+		#sound-dai-cells = <0>;
+		status = "disabled";
+	};
+
+	sound: sound {
+		compatible = "ingenic,t32-sound";
+		status = "disabled";
+
+		cpu {
+			sound-dai = <&aic>;
+		};
+
+		codec {
+			sound-dai = <&codec>;
+		};
+	};
+
+	/*
+	 * Pin controller + GPIO. T32 reuses the shared XBurst1
+	 * GPIO/pinmux engine and group tables (same rationale as T23/
+	 * T30); only the controller/gpio compatibles are T32-specific.
+	 */
+	pinctrl: pinctrl@10010000 {
+		compatible = "ingenic,t32-pinctrl";
+		reg = <0x10010000 0x1000>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		gpa: gpio@0 {
+			compatible = "ingenic,t32-gpio";
+			reg = <0>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		gpb: gpio@1 {
+			compatible = "ingenic,t32-gpio";
+			reg = <1>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		gpc: gpio@2 {
+			compatible = "ingenic,t32-gpio";
+			reg = <2>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		gpd: gpio@3 {
+			compatible = "ingenic,t32-gpio";
+			reg = <3>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		pins_sfc: sfc {
+			function = "sfc";
+			groups = "sfc-data";
+		};
+
+		pins_mmc0: mmc0 {
+			function = "mmc0";
+			groups = "mmc0-1bit", "mmc0-4bit";
+		};
+
+		pins_mac: mac {
+			function = "mac";
+			groups = "mac-rmii";
+		};
+
+		/*
+		 * Idle the second SPI-NOR pin block: the T32LQ wires it to
+		 * PC2..PC7 immediately next to the MSC0 data lines. Left as
+		 * GPIO, the floating drivers couple noise into MSC0 and
+		 * break SD card init.
+		 */
+		pins_sfc1: sfc1 {
+			function = "sfc1";
+			groups = "sfc1-data";
+		};
+	};
+};
