+
+static uint8_t crc7(uint8_t crc, const uint8_t *buf, int len)
+{
+	while (len--)
+		crc = crc7_syndrome_table[(crc << 1) ^ *buf++];
+	return crc;
+}
+
+int main(int argc, char *argv[])
+{
+	uint8_t buf[4];
+	uint8_t crc = 0;
+	int fd, n, t = 0, count = 0;
+
+	if (argc != 2) {
+		fprintf(stderr, "Usage: %s <spl-image>\n", argv[0]);
+		return 1;
+	}
+
+	fd = open(argv[1], O_RDWR);
+	if (fd < 0) {
+		perror(argv[1]);
+		return 1;
+	}
+
+	while ((n = read(fd, buf, sizeof(buf))) > 0) {
+		if (t >= SKIP_SIZE)
+			crc = crc7(crc, buf, n);
+		else
+			t += sizeof(buf);
+		count += n;
+	}
+
+	printf("mkt31spl: %s: size=%#x crc7=%#x\n", argv[1], count, crc);
+
+	lseek(fd, CRC_POSITION, SEEK_SET);
+	if (write(fd, &crc, 1) != 1) {
+		perror("write crc");
+		return 1;
+	}
+
+	buf[0] = count & 0xff;
+	buf[1] = (count >> 8) & 0xff;
+	buf[2] = (count >> 16) & 0xff;
+	buf[3] = (count >> 24) & 0xff;
+	lseek(fd, SPL_LENGTH_POSITION, SEEK_SET);
+	if (write(fd, buf, 4) != 4) {
+		perror("write length");
+		return 1;
+	}
+
+	close(fd);
+	return 0;
+}
