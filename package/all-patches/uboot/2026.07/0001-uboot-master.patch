 ifneq ($(CONFIG_SPL_MULTI_DTB_FIT),y)
 FINAL_DTB_CONTAINER = $(obj)/$(SPL_BIN).dtb
 else ifeq ($(CONFIG_SPL_MULTI_DTB_FIT_LZO),y)
