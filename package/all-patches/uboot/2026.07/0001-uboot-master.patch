index 00000000..0c076852
--- /dev/null
+++ b/dts/upstream/src/arm64/qcom/apq8096-db820c.dtsi
@@ -0,0 +1,1133 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
