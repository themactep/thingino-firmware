+{
+	return 0;
+}
+#endif
+
+int checkboard(void)
+{
+	/*
+	 * No "Variant:" line: the SKU is carried by the leaf-DT Model: string
+	 * (params-in-DT, no compile-time variant). DM-SPL boards do not re-add it.
+	 */
+	return 0;
+}
