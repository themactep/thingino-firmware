diff --git a/arch/mips/dts/a1-isvp-dfu.dtsi b/arch/mips/dts/a1-isvp-dfu.dtsi
new file mode 100644
index 00000000..05ff4ef2
--- /dev/null
+++ b/arch/mips/dts/a1-isvp-dfu.dtsi
@@ -0,0 +1,181 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Ingenic ISVP-A1 USB-boot DFU-loader board body, shared by every A1
+ * SKU. Identical to a1-isvp.dtsi except OTG0 is dr_mode = "peripheral"
+ * so the dwc2_udc_otg gadget binds to it (dwc2_udc_otg_bind rejects
+ * "host"). OTG0 is the mask-ROM USB-boot port, so the DFU gadget comes
+ * up on the same connector the loader is USB-booted over. The leaf
+ * .dts sets the per-SKU compatible on &ddr.
+ */
+
+#include <dt-bindings/clock/ingenic,a1-cgu.h>
+
+/ {
+	compatible = "ingenic,a1";
+	#address-cells = <1>;
+	#size-cells = <1>;
+
+	aliases {
+		serial1 = &uart1;
+	};
+
+	chosen {
+		stdout-path = "serial1:115200n8";
+	};
+
+	memory@0 {
+		device_type = "memory";
+		reg = <0x0 0x10000000>;
+	};
+
+	ddr: memory-controller@b34f0000 {
+		compatible = "ingenic,a1-ddr-innophy";
+		reg = <0xb34f0000 0x3000>;
+		/* the leaf .dts supplies the per-SKU ingenic,sdram-params array. */
+	};
+
+	cgu: clock-controller@b0000000 {
+		compatible = "ingenic,a1-cgu";
+		reg = <0xb0000000 0x1000>;
+		#clock-cells = <1>;
+	};
+
+	pinctrl: pinctrl@b0010000 {
+		compatible = "ingenic,a1-pinctrl";
+		reg = <0xb0010000 0x8000>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		gpa: gpio@0 {
+			compatible = "ingenic,a1-gpio";
+			reg = <0>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		gpb: gpio@1 {
+			compatible = "ingenic,a1-gpio";
+			reg = <1>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		gpc: gpio@2 {
+			compatible = "ingenic,a1-gpio";
+			reg = <2>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		gpd: gpio@3 {
+			compatible = "ingenic,a1-gpio";
+			reg = <3>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		gpe: gpio@4 {
+			compatible = "ingenic,a1-gpio";
+			reg = <4>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		pins_uart1: uart1 {
+			function = "uart1";
+			groups = "uart1-data";
+		};
+
+		pins_sfc: sfc {
+			function = "sfc";
+			groups = "sfc-data";
+		};
+
+		pins_mac0: mac0 {
+			function = "mac0";
+			groups = "mac0-data";
+		};
+	};
+
+	uart1: serial@b0031000 {
+		compatible = "ingenic,jz4780-uart", "ns16550a";
+		reg = <0xb0031000 0x100>;
+		reg-shift = <2>;
+		clock-frequency = <24000000>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pins_uart1>;
+		status = "okay";
+	};
+
+	sfc: spi@b3440000 {
+		compatible = "ingenic,a1-sfc";
+		reg = <0xb3440000 0x10000>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+		clocks = <&cgu A1_CLK_SFC>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pins_sfc>;
+		spi-max-frequency = <50000000>;
+		status = "okay";
+
+		/*
+		 * flash@0 declared spi-nand so the NAND stack binds on NAND
+		 * boards; the loader's board_late_init() (mach-xburst/dfu.c)
+		 * auto-detects NOR vs NAND - on a NOR board the spi-nand probe
+		 * fails, the node is unbound, and a SPI-NOR is probed on CS0.
+		 */
+		flash@0 {
+			compatible = "spi-nand";
+			reg = <0>;
+			spi-max-frequency = <50000000>;
+		};
+	};
+
+	gmac0: ethernet@b30b0000 {
+		compatible = "ingenic,a1-gmac";
+		reg = <0xb30b0000 0x10000>;
+		clocks = <&cgu A1_CLK_GMAC0>,
+			 <&cgu A1_CLK_GMAC0_TX>,
+			 <&cgu A1_CLK_GMAC0_PTP>;
+		phy-mode = "rmii";
+		phy-handle = <&gmac0_phy>;
+		ingenic,mode-reg = <0xb00000c8>;
+		max-speed = <100>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pins_mac0>;
+		status = "okay";
+
+		mdio {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			gmac0_phy: ethernet-phy@0 {
+				reg = <0>;
+			};
+		};
+	};
+
+	otg0: usb@b3600000 {
+		compatible = "snps,dwc2";
+		reg = <0xb3600000 0x40000>;
+		clocks = <&cgu A1_CLK_OTG0>;
+		dr_mode = "peripheral";		/* gadget bind for DFU/g_dnl */
+		status = "okay";
+	};
+
+	otg1: usb@b3640000 {
+		compatible = "snps,dwc2";
+		reg = <0xb3640000 0x40000>;
+		clocks = <&cgu A1_CLK_OTG1>;
+		dr_mode = "host";
+		status = "okay";
+	};
+
+	otg2: usb@b3680000 {
+		compatible = "snps,dwc2";
+		reg = <0xb3680000 0x40000>;
+		clocks = <&cgu A1_CLK_OTG2>;
+		dr_mode = "host";
+		status = "okay";
+	};
+};
diff --git a/arch/mips/dts/a1-isvp.dtsi b/arch/mips/dts/a1-isvp.dtsi
new file mode 100644
index 00000000..34664b2e
--- /dev/null
+++ b/arch/mips/dts/a1-isvp.dtsi
@@ -0,0 +1,231 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Ingenic ISVP-A1 board body, shared by every A1 SKU. The per-SKU
+ * leaf .dts (a1n-isvp.dts, ...) includes this file and sets the
+ * per-SKU compatible on &ddr. A1 is SFC-NOR only today; if a NAND A1
+ * board appears, split the flash node into boot-media fragments like
+ * T40.
+ */
+
+#include <dt-bindings/clock/ingenic,a1-cgu.h>
+
+/ {
+	compatible = "ingenic,a1";
+	#address-cells = <1>;
+	#size-cells = <1>;
+
+	aliases {
+		serial1 = &uart1;
+	};
+
+	chosen {
+		stdout-path = "serial1:115200n8";
+	};
+
+	memory@0 {
+		device_type = "memory";
+		reg = <0x0 0x10000000>;
+	};
+
+	ddr: memory-controller@b34f0000 {
+		compatible = "ingenic,a1-ddr-innophy";
+		reg = <0xb34f0000 0x3000>;
+		/* the leaf .dts supplies the per-SKU ingenic,sdram-params array. */
+	};
+
+	cgu: clock-controller@b0000000 {
+		compatible = "ingenic,a1-cgu";
+		reg = <0xb0000000 0x1000>;
+		#clock-cells = <1>;
+	};
+
+	pinctrl: pinctrl@b0010000 {
+		compatible = "ingenic,a1-pinctrl";
+		reg = <0xb0010000 0x8000>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		gpa: gpio@0 {
+			compatible = "ingenic,a1-gpio";
+			reg = <0>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		gpb: gpio@1 {
+			compatible = "ingenic,a1-gpio";
+			reg = <1>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		gpc: gpio@2 {
+			compatible = "ingenic,a1-gpio";
+			reg = <2>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		gpd: gpio@3 {
+			compatible = "ingenic,a1-gpio";
+			reg = <3>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		gpe: gpio@4 {
+			compatible = "ingenic,a1-gpio";
+			reg = <4>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		pins_uart1: uart1 {
+			function = "uart1";
+			groups = "uart1-data";
+		};
+
+		pins_sfc: sfc {
+			function = "sfc";
+			groups = "sfc-data";
+		};
+
+		pins_mac0: mac0 {
+			function = "mac0";
+			groups = "mac0-data";
+		};
+	};
+
+	uart1: serial@b0031000 {
+		compatible = "ingenic,jz4780-uart", "ns16550a";
+		reg = <0xb0031000 0x100>;
+		reg-shift = <2>;
+		clock-frequency = <24000000>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pins_uart1>;
+		status = "okay";
+	};
+
+	/*
+	 * TCU (timer/counter unit) container mirroring T31/T41's binding.
+	 * U-Boot only needs the watchdog child for sysreset; the WDT
+	 * self-clocks from the 32 kHz RTC so no TCU clock provider is
+	 * required. Replaces the hand-rolled a1/soc.c _machine_restart().
+	 */
+	tcu: timer@b0002000 {
+		compatible = "ingenic,a1-tcu", "ingenic,jz4760-tcu",
+			     "simple-mfd";
+		reg = <0xb0002000 0x1000>;
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges = <0x0 0xb0002000 0x1000>;
+
+		watchdog: watchdog@0 {
+			compatible = "ingenic,a1-watchdog",
+				     "ingenic,jz4780-watchdog";
+			reg = <0x0 0x10>;
+		};
+	};
+
+	/*
+	 * AIC (audio interface controller) + on-chip codec. PIO/DMA playback
+	 * driven by U-Boot's `sound` command, handled by the self-contained
+	 * drivers/sound/a1_audio.c (the A1 codec is its own register block at
+	 * 0xb0022000, distinct from T41's; the AIC is T41-like). Addresses
+	 * confirmed against the A1-1.7.0 kernel soc/base.h.
+	 */
+	aic: audio-controller@b0020000 {
+		compatible = "ingenic,a1-aic";
+		reg = <0xb0020000 0x100>;
+		clocks = <&cgu A1_CLK_APLL>;
+		clock-names = "apll";
+		#sound-dai-cells = <0>;
+		status = "okay";
+	};
+
+	codec: audio-codec@b0022000 {
+		compatible = "ingenic,a1-codec";
+		reg = <0xb0022000 0x140>;
+		#sound-dai-cells = <0>;
+		status = "okay";
+	};
+
+	sound: sound {
+		compatible = "ingenic,a1-sound";
+		status = "okay";
+
+		cpu {
+			sound-dai = <&aic>;
+		};
+
+		codec {
+			sound-dai = <&codec>;
+		};
+	};
+
+	sfc: spi@b3440000 {
+		compatible = "ingenic,a1-sfc";
+		reg = <0xb3440000 0x10000>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+		clocks = <&cgu A1_CLK_SFC>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pins_sfc>;
+		spi-max-frequency = <50000000>;
+		status = "okay";
+
+		flash@0 {
+			compatible = "jedec,spi-nor";
+			reg = <0>;
+			spi-max-frequency = <50000000>;
+		};
+	};
+
+	gmac0: ethernet@b30b0000 {
+		compatible = "ingenic,a1-gmac";
+		reg = <0xb30b0000 0x10000>;
+		clocks = <&cgu A1_CLK_GMAC0>,
+			 <&cgu A1_CLK_GMAC0_TX>,
+			 <&cgu A1_CLK_GMAC0_PTP>;
+		phy-mode = "rmii";
+		phy-handle = <&gmac0_phy>;
+		ingenic,mode-reg = <0xb00000c8>;
+		max-speed = <100>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pins_mac0>;
+		status = "okay";
+
+		mdio {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			gmac0_phy: ethernet-phy@0 {
+				reg = <0>;
+			};
+		};
+	};
+
+	otg0: usb@b3600000 {
+		compatible = "snps,dwc2";
+		reg = <0xb3600000 0x40000>;
+		clocks = <&cgu A1_CLK_OTG0>;
+		dr_mode = "host";
+		status = "okay";
+	};
+
+	otg1: usb@b3640000 {
+		compatible = "snps,dwc2";
+		reg = <0xb3640000 0x40000>;
+		clocks = <&cgu A1_CLK_OTG1>;
+		dr_mode = "host";
+		status = "okay";
+	};
+
+	otg2: usb@b3680000 {
+		compatible = "snps,dwc2";
+		reg = <0xb3680000 0x40000>;
+		clocks = <&cgu A1_CLK_OTG2>;
+		dr_mode = "host";
+		status = "okay";
+	};
+};
diff --git a/arch/mips/dts/a1n-isvp-dfu-u-boot.dtsi b/arch/mips/dts/a1n-isvp-dfu-u-boot.dtsi
new file mode 100644
index 00000000..7f63f9cb
--- /dev/null
+++ b/arch/mips/dts/a1n-isvp-dfu-u-boot.dtsi
@@ -0,0 +1,58 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Binman image description for the Ingenic ISVP-A1 DFU loader.
+ *
+ * The USB-boot path uploads spl/u-boot-spl.bin + u-boot.bin directly
+ * via the mask ROM (tools/t31-usbboot.py - the protocol is generic
+ * across XBurst1 and XBurst2), so the binman flash images here are
+ * not used in the USB-boot flow. They are kept consistent with the
+ * production a1-isvp layout (headered SPL at 0, LZMA U-Boot at
+ * 0x14000) so a stray 'make' still produces a sensible flash image.
+ * U-Boot sits at 0x14000 because the DM-in-SPL + SPL_SPI SPL is
+ * ~64 KiB, past the old 0x8000/0x10000 boundaries.
+ */
+
+/ {
+	binman: binman {
+		multiple-images;
+	};
+};
+
+&binman {
+	u-boot-spl-a1 {
+		filename = "u-boot-spl-a1.bin";
+
+		ingenic-t31-spl {
+			filename = "spl/u-boot-spl.bin";
+		};
+	};
+
+	flash {
+		filename = "u-boot-with-spl-lzma.bin";
+		pad-byte = <0xff>;
+
+		spl {
+			type = "blob";
+			offset = <0x0>;
+			filename = "u-boot-spl-a1.bin";
+		};
+
+		u-boot {
+			type = "blob";
+			offset = <0x14000>;
+			filename = "u-boot-lzma.img";
+		};
+	};
+};
+
+/* SPL phase tags relocated from a1-isvp-dfu.dtsi (see a1n-isvp-u-boot.dtsi). */
+&ddr { bootph-all; };
+&cgu { bootph-all; };
+&pinctrl { bootph-all; };
+&gpa { bootph-all; };
+&gpb { bootph-all; };
+&gpc { bootph-all; };
+&gpd { bootph-all; };
+&gpe { bootph-all; };
+&pins_uart1 { bootph-all; };
+&uart1 { bootph-all; };
diff --git a/arch/mips/dts/a1n-isvp-dfu.dts b/arch/mips/dts/a1n-isvp-dfu.dts
new file mode 100644
index 00000000..36fe4365
--- /dev/null
+++ b/arch/mips/dts/a1n-isvp-dfu.dts
@@ -0,0 +1,27 @@
+// SPDX-License-Identifier: GPL-2.0+
+/dts-v1/;
+#include "a1-isvp-dfu.dtsi"
+
+/ {
+	model = "Ingenic ISVP-A1N (DFU loader)";
+};
+
+/* A1N: DDR3 W632GU6NG, 256 MiB. DFU loader, SFC-NOR target. */
+&ddr {
+	ingenic,sdram-params = <
+		0x00000000 0x00000002	/* type family */
+		0x00000010 0x10000000 0x00000000	/* bus_width chip0_size chip1_size */
+		0x5f5e1000 0x2faf0800	/* mpll_hz ddr_hz */
+		0x05c05100 0x08605100 0x00000000	/* apll mpll vpll _mnod */
+		0x4a004a35 0x0000b092 0x00000002 0x000020f0 0x00003000 0x41c30081	/* cfg ctrl dlmr mmap0 mmap1 refcnt */
+		0x07130d08 0x0809070b 0x030c040c 0x252b1f07 0x80069055	/* timing1..5 */
+		0x40000c41 0x00000000 0x00000001 0x00000001	/* autosr_cnt autosr_en hregpro pregpro */
+		0x11111111 0x00000113	/* cguc0 cguc1 */
+		0x0000000a 0x0000000b 0x00000008	/* memcfg cl cwl */
+		0x00001f70 0x00010006 0x00020018 0x00030000 0x00000000 0x00000000	/* mr0 mr1 mr2 mr3 mr10 mr63 */
+		0x030f0e0d 0x07060504 0x0b0a0908 0x0201000c 0x13121110	/* remap1..5 */
+		0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000	/* par[19] (efuse drive/ODT/skew) */
+		0x00000001 0x00000000 0x0000000e 0x0000000e 0x0000000e 0x0000000e	/* a1_phy odt/drvcmd */
+		0x00000014 0x00000014 0x00000014 0x00000014 0x00000010 0x00000007 0x00000080 0x00000020 0x00000020	/* a1_phy dq/vref/dqs */
+	>;
+};
diff --git a/arch/mips/dts/a1n-isvp-u-boot.dtsi b/arch/mips/dts/a1n-isvp-u-boot.dtsi
new file mode 100644
index 00000000..b67032fc
--- /dev/null
+++ b/arch/mips/dts/a1n-isvp-u-boot.dtsi
@@ -0,0 +1,86 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Binman image description for the Ingenic ISVP-A1 SFC-NOR boot.
+ *
+ * The A1 mask ROM boots from SPI-NOR by reading a headered SPL at
+ * flash offset 0, which then loads U-Boot proper from a fixed offset.
+ * The SFC-NOR boot header is the same format the T31 uses - CRC7 of
+ * the SPL body at byte 9, image length at bytes 12..15 - so the
+ * ingenic-t31-spl binman etype applies unchanged (the vendor
+ * tools/ingenic-tools/spi_checksum.c handles CONFIG_A1 and CONFIG_T31
+ * with one shared SFC code path, SKIP_SIZE 2048).
+ *
+ * 'make' produces:
+ *   u-boot-spl-a1.bin        : SPL with the finalized SFC-NOR boot
+ *                              header, bootable standalone.
+ *   u-boot-with-spl-lzma.bin : headered SPL at offset 0 + LZMA U-Boot
+ *                              at 0x14000 (= CONFIG_SYS_SPI_U_BOOT_OFFS;
+ *                              the DM-in-SPL + SPL_SPI SPL is ~64 KiB,
+ *                              past the 0x10000 boundary) - flash at 0.
+ */
+
+/ {
+	binman: binman {
+		multiple-images;
+	};
+};
+
+&binman {
+	/*
+	 * Standalone headered SPL: take the freshly built
+	 * spl/u-boot-spl.bin through the SFC-NOR boot-header finalizer.
+	 */
+	u-boot-spl-a1 {
+		filename = "u-boot-spl-a1.bin";
+
+		ingenic-t31-spl {
+			filename = "spl/u-boot-spl.bin";
+		};
+	};
+
+	/*
+	 * Combined SFC-NOR flash image: headered SPL at offset 0, LZMA
+	 * U-Boot at 0x14000 (DM-in-SPL + standard SPL_SPI load makes the
+	 * SPL ~64 KB, past the 0x10000 boundary). Trimmed to the end of the
+	 * last entry; erased flash reads 0xff so the rest of the chip is
+	 * fine to leave alone after flashing at offset 0.
+	 */
+	flash {
+		filename = "u-boot-with-spl-lzma.bin";
+		pad-byte = <0xff>;
+
+		spl {
+			type = "blob";
+			offset = <0x0>;
+			filename = "u-boot-spl-a1.bin";
+		};
+
+		u-boot {
+			type = "blob";
+			offset = <0x14000>;
+			filename = "u-boot-lzma.img";
+		};
+	};
+};
+
+/*
+ * SPL phase tags: bootph is U-Boot build-phase control (which nodes
+ * survive fdtgrep into the SPL DTB), not hardware - so it lives in the
+ * U-Boot overlay beside binman, keeping a1-isvp.dtsi a clean hardware
+ * description (mirrors the XBurst1 SoCs).
+ */
+&ddr { bootph-all; };
+&cgu { bootph-all; };
+&pinctrl { bootph-all; };
+&gpa { bootph-all; };
+&gpb { bootph-all; };
+&gpc { bootph-all; };
+&gpd { bootph-all; };
+&gpe { bootph-all; };
+&pins_uart1 { bootph-all; };
+&pins_sfc { bootph-all; };
+&uart1 { bootph-all; };
+&sfc {
+	bootph-all;
+	flash@0 { bootph-all; };
+};
diff --git a/arch/mips/dts/a1n-isvp.dts b/arch/mips/dts/a1n-isvp.dts
new file mode 100644
index 00000000..1746b8dc
--- /dev/null
+++ b/arch/mips/dts/a1n-isvp.dts
@@ -0,0 +1,27 @@
+// SPDX-License-Identifier: GPL-2.0+
+/dts-v1/;
+#include "a1-isvp.dtsi"
+
+/ {
+	model = "Ingenic ISVP-A1N (SFC NOR)";
+};
+
+/* A1N: DDR3 W632GU6NG, 256 MiB, SFC-NOR. */
+&ddr {
+	ingenic,sdram-params = <
+		0x00000000 0x00000002	/* type family */
+		0x00000010 0x10000000 0x00000000	/* bus_width chip0_size chip1_size */
+		0x5f5e1000 0x2faf0800	/* mpll_hz ddr_hz */
+		0x05c05100 0x08605100 0x00000000	/* apll mpll vpll _mnod */
+		0x4a004a35 0x0000b092 0x00000002 0x000020f0 0x00003000 0x41c30081	/* cfg ctrl dlmr mmap0 mmap1 refcnt */
+		0x07130d08 0x0809070b 0x030c040c 0x252b1f07 0x80069055	/* timing1..5 */
+		0x40000c41 0x00000000 0x00000001 0x00000001	/* autosr_cnt autosr_en hregpro pregpro */
+		0x11111111 0x00000113	/* cguc0 cguc1 */
+		0x0000000a 0x0000000b 0x00000008	/* memcfg cl cwl */
+		0x00001f70 0x00010006 0x00020018 0x00030000 0x00000000 0x00000000	/* mr0 mr1 mr2 mr3 mr10 mr63 */
+		0x030f0e0d 0x07060504 0x0b0a0908 0x0201000c 0x13121110	/* remap1..5 */
+		0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000	/* par[19] (efuse drive/ODT/skew) */
+		0x00000001 0x00000000 0x0000000e 0x0000000e 0x0000000e 0x0000000e	/* a1_phy odt/drvcmd */
+		0x00000014 0x00000014 0x00000014 0x00000014 0x00000010 0x00000007 0x00000080 0x00000020 0x00000020	/* a1_phy dq/vref/dqs */
+	>;
+};
diff --git a/arch/mips/dts/t10-isvp-dfu-uboot-common.dtsi b/arch/mips/dts/t10-isvp-dfu-uboot-common.dtsi
new file mode 100644
index 00000000..cb12ed72
--- /dev/null
+++ b/arch/mips/dts/t10-isvp-dfu-uboot-common.dtsi
@@ -0,0 +1,54 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Shared U-Boot overlay for the Ingenic ISVP-T10 DFU/USB-boot leaf DTs.
+ * Each per-SKU <leaf>-u-boot.dtsi is a one-line include of this file.
+ *
+ * USB-boot is a TPL chain: the mask ROM uploads the cache-as-RAM TPL (its only
+ * DM device is &ddr; the probe brings up PLL + DDR), the TPL returns into the
+ * ROM's USB loop, and the ROM uploads U-Boot proper to DRAM. So the binman
+ * flash image here is not used in the USB-boot flow (kept for a sensible `make`
+ * artifact); thingino-dfu uploads tpl/u-boot-tpl.bin + u-boot.bin directly.
+ *
+ * &ddr is the only node tagged for the TPL phase (bootph-all); everything else
+ * is bootph-pre-ram + bootph-some-ram (present pre-relocation in U-Boot proper,
+ * absent from the minimal TPL - tagging the clock tree bootph-all would pull the
+ * clk uclass into the TPL's OF_PLATDATA scan and fail it).
+ */
+
+/ {
+	binman: binman {
+		multiple-images;
+	};
+};
+
+&binman {
+	u-boot-spl-t10 {
+		filename = "u-boot-spl-t10.bin";
+
+		ingenic-t31-spl {
+			filename = "spl/u-boot-spl.bin";
+		};
+	};
+
+	flash {
+		filename = "u-boot-with-spl-lzma.bin";
+		pad-byte = <0xff>;
+
+		spl {
+			type = "blob";
+			offset = <0x0>;
+			filename = "u-boot-spl-t10.bin";
+		};
+
+		u-boot {
+			type = "blob";
+			offset = <0x10000>;
+			filename = "u-boot-lzma.img";
+		};
+	};
+};
+
+&ddr { bootph-all; };		/* the TPL's only DM device */
+&exclk { bootph-pre-ram; bootph-some-ram; };
+&rtclk { bootph-pre-ram; bootph-some-ram; };
+&cgu { bootph-pre-ram; bootph-some-ram; };
diff --git a/arch/mips/dts/t10-isvp-uboot-common.dtsi b/arch/mips/dts/t10-isvp-uboot-common.dtsi
new file mode 100644
index 00000000..07193c24
--- /dev/null
+++ b/arch/mips/dts/t10-isvp-uboot-common.dtsi
@@ -0,0 +1,164 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Shared U-Boot overlay for the Ingenic ISVP-T10 SFC-NOR leaf DTs.
+ * Each per-SKU <leaf>-u-boot.dtsi is a one-line include of this file.
+ *
+ * T10 is a capped SoC (the T20-generation mask ROM loads only 0x6800 of the
+ * first stage from NOR), so it boots a TPL chain: the mask ROM loads the
+ * headered TPL at offset 0; the TPL brings up DDR in cache-as-RAM and reads the
+ * DRAM-resident SPL from 0x8000 (= T10_TPL_SPL_NOR_OFFS); the SPL reads U-Boot
+ * from 0x18000 (= CONFIG_SYS_SPI_U_BOOT_OFFS). The 2 KiB header CRC7+length is
+ * finalized by the family-generic ingenic-t31-spl binman etype.
+ *
+ * Phase tags: the SPL/TPL devicetrees are fdtgrep-filtered out of the single
+ * dt.dtb by bootph tags (TPL keeps bootph-all + bootph-pre-sram; SPL keeps
+ * bootph-all + bootph-pre-ram), NOT re-preprocessed per phase - so the split is
+ * in the tags, not #ifdef. The TPL's only DM device is &ddr (its probe brings
+ * up PLL + DDR, then it hand-loads the SPL with bare-metal SFC/serial helpers),
+ * so only &ddr is tagged for all phases; every other node is bootph-pre-ram +
+ * bootph-some-ram (present in the SPL DM NOR boot and U-Boot pre-reloc, absent
+ * from the minimal TPL).
+ */
+
+/ {
+	binman: binman {
+		multiple-images;
+	};
+};
+
+&binman {
+#if defined(CONFIG_SPL_MMC)
+	/*
+	 * MSC/SD-card boot image (isvp_t10n_msc0). The XBurst1 SD ROM reads the
+	 * headered first stage (the TPL) off the card, checks the MSPL magic and
+	 * jumps to it - no INGE/descriptor block needed; the reader sets the SD
+	 * clock itself (see mach-xburst/msc.c). So the image is just the plain
+	 * MSPL-headered TPL + SPL, like the XBurst2 T40/T41. SD layout: TPL at
+	 * sector 34 (0x4400), the DRAM-resident SPL at 0x10000 (the TPL reads it
+	 * bare-metal), U-Boot at SYS_MMCSD_RAW_MODE_U_BOOT_SECTOR (0x180 = 0x30000).
+	 */
+	u-boot-tpl-t10-msc {
+		filename = "u-boot-tpl-t10-msc.bin";
+
+		ingenic-t31-spl {
+			filename = "tpl/u-boot-tpl.bin";
+		};
+	};
+
+	mmc {
+		filename = "u-boot-with-tpl-mmc-lzma.bin";
+		pad-byte = <0x00>;
+
+		tpl {
+			type = "blob";
+			offset = <0x4400>;
+			filename = "u-boot-tpl-t10-msc.bin";
+		};
+
+		spl {
+			type = "blob";
+			offset = <0x10000>;
+			filename = "spl/u-boot-spl.bin";
+		};
+
+		u-boot {
+			type = "blob";
+			offset = <0x30000>;
+			filename = "u-boot-lzma.img";
+		};
+	};
+#elif defined(CONFIG_TPL)
+	u-boot-tpl-t10 {
+		filename = "u-boot-tpl-t10.bin";
+
+		ingenic-t31-spl {
+			filename = "tpl/u-boot-tpl.bin";
+		};
+	};
+
+	flash {
+		filename = "u-boot-with-tpl-lzma.bin";
+		pad-byte = <0xff>;
+
+		tpl {
+			type = "blob";
+			offset = <0x0>;
+			filename = "u-boot-tpl-t10.bin";
+		};
+
+		spl {
+			type = "blob";
+			offset = <0x8000>;
+			filename = "spl/u-boot-spl.bin";
+		};
+
+		u-boot {
+			type = "blob";
+			offset = <0x18000>;
+			filename = "u-boot-lzma.img";
+		};
+	};
+#else
+	u-boot-spl-t10 {
+		filename = "u-boot-spl-t10.bin";
+
+		ingenic-t31-spl {
+			filename = "spl/u-boot-spl.bin";
+		};
+	};
+
+	flash {
+		filename = "u-boot-with-spl-lzma.bin";
+		pad-byte = <0xff>;
+
+		spl {
+			type = "blob";
+			offset = <0x0>;
+			filename = "u-boot-spl-t10.bin";
+		};
+
+		u-boot {
+			type = "blob";
+			offset = <0x10000>;
+			filename = "u-boot-lzma.img";
+		};
+	};
+#endif
+};
+
+&exclk { bootph-pre-ram; bootph-some-ram; };
+&rtclk { bootph-pre-ram; bootph-some-ram; };
+&cgu { bootph-pre-ram; bootph-some-ram; };
+&ddr { bootph-all; };		/* the TPL's only DM device */
+&pinctrl { bootph-pre-ram; bootph-some-ram; };
+&gpa { bootph-pre-ram; bootph-some-ram; };
+&gpb { bootph-pre-ram; bootph-some-ram; };
+&gpc { bootph-pre-ram; bootph-some-ram; };
+&gpd { bootph-pre-ram; bootph-some-ram; };
+&uart1 { bootph-pre-ram; bootph-some-ram; };
+
+#if defined(CONFIG_SPL_MMC)
+/*
+ * MSC/SD boot: the SPL probes the native jz_mmc controller (the TPL's SD read
+ * is bare-metal, so the TPL devicetree still needs only &ddr). msc0 is
+ * status="disabled" in t10.dtsi - the NOR boards never use it - so enable it
+ * here and tag it + its pins for the SPL and pre-reloc U-Boot phases.
+ */
+&msc0 {
+	bootph-pre-ram;
+	bootph-some-ram;
+	broken-cd;		/* the SD is the boot medium - always present */
+	status = "okay";
+};
+&pins_mmc0 { bootph-pre-ram; bootph-some-ram; };
+#else
+&pins_sfc { bootph-pre-ram; bootph-some-ram; };
+&sfc {
+	bootph-pre-ram;
+	bootph-some-ram;
+	flash@0 {
+		bootph-pre-ram;
+		bootph-some-ram;
+	};
+};
+#endif
diff --git a/arch/mips/dts/t10.dtsi b/arch/mips/dts/t10.dtsi
new file mode 100644
index 00000000..7dfa40ff
--- /dev/null
+++ b/arch/mips/dts/t10.dtsi
@@ -0,0 +1,277 @@
+// SPDX-License-Identifier: GPL-2.0+
+
+#include <dt-bindings/clock/ingenic,t10-cgu.h>
+
+/ {
+	#address-cells = <1>;
+	#size-cells = <1>;
+	compatible = "ingenic,t10";
+
+	cpus {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		cpu0: cpu@0 {
+			device_type = "cpu";
+			compatible = "ingenic,xburst", "mips,mips32r2";
+			reg = <0>;
+		};
+	};
+
+	cpuintc: interrupt-controller {
+		#address-cells = <0>;
+		#interrupt-cells = <1>;
+		interrupt-controller;
+		compatible = "mti,cpu-interrupt-controller";
+	};
+
+	exclk: exclk {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <24000000>;
+	};
+
+	rtclk: rtclk {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <32768>;
+	};
+
+	/*
+	 * CGU (Clock/Power Manager). Same XBurst1 leaf-clock map as T31
+	 * (with VPLL, like T31); the PLL register encoding differs
+	 * (cpm_cpxpcr_t) and the clk-t10 driver handles that. The SPL
+	 * programs the PLLs/dividers; this driver runs in U-Boot proper
+	 * and recalculates PLL rates + provides rate/gate for the leaf
+	 * clocks (SFC, MMC, GMAC). Driver accesses CPM via KSEG1.
+	 */
+	cgu: clock-controller@10000000 {
+		compatible = "ingenic,t10-cgu", "simple-mfd";
+		reg = <0x10000000 0x1000>;
+		#clock-cells = <1>;
+		clocks = <&exclk>, <&rtclk>;
+		clock-names = "ext", "rtc";
+		bootph-pre-ram;
+		/*
+		 * Pin the kernel-consumed leaf muxes to the vendor
+		 * contract (vendor cgu_clk_sel: VPU, ISP, CIM and MACPHY
+		 * all from MPLL; single-bit muxes, no VPLL routing). The
+		 * 3.10 kernel computes leaf rates on whatever parent it
+		 * inherits, so the inherited selector is the contract.
+		 * Parents only, no rates.
+		 */
+		assigned-clocks = <&cgu T10_CLK_VPU>,
+				  <&cgu T10_CLK_ISP>,
+				  <&cgu T10_CLK_CIM>,
+				  <&cgu T10_CLK_GMAC>;
+		assigned-clock-parents = <&cgu T10_CLK_MPLL>,
+					 <&cgu T10_CLK_MPLL>,
+					 <&cgu T10_CLK_MPLL>,
+					 <&cgu T10_CLK_MPLL>;
+	};
+
+	/*
+	 * DDR controller (Synopsys DWC PHY - T10 and T20 are the only XBurst1
+	 * camera SoCs that are not Innophy, so they share drivers/ram/ingenic/
+	 * ddr_t20.c under one compatible). The board leaf .dts supplies the
+	 * per-SKU "ingenic,sdram-params" u32 array (26 cells = struct
+	 * ingenic_t20_ddr_params), serialized in this order:
+	 *   [0..2]   SPL PLL setpoints: CPAPCR, CPMPCR, CPCCR
+	 *   [3]      total DRAM size in bytes
+	 *   [4..6]   DDRC_CFG, DDRC_MMAP0, DDRC_MMAP1
+	 *   [7..12]  DDRC_TIMING1..6
+	 *   [13..15] DWC PHY DCR, DTPR0, DTPR1
+	 *   [16..20] DDRC_REMAP1..5
+	 *   [21]     CPM_DDRCDR divider (DDR = MPLL/(cdr+1))
+	 *   [22..25] DDRC_REFCNT, DWC PHY MR0, PTR0, PTR1
+	 * bootph-all is added by the leaf's shared u-boot.dtsi so the node
+	 * survives into the SPL/TPL devicetree.
+	 */
+	ddr: memory-controller@134f0000 {
+		compatible = "ingenic,t20-ddr-dwc";
+		reg = <0x134f0000 0x1000>;
+	};
+
+	/*
+	 * TCU container; U-Boot only needs the watchdog (for sysreset).
+	 * The generic jz4760-tcu / jz4780-watchdog fallbacks bind on
+	 * T10 (same IP as T31). The watchdog self-clocks from the 32 kHz
+	 * RTC.
+	 */
+	tcu: timer@10002000 {
+		compatible = "ingenic,t10-tcu", "ingenic,jz4760-tcu",
+			     "simple-mfd";
+		reg = <0x10002000 0x1000>;
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges = <0x0 0x10002000 0x1000>;
+
+		watchdog: watchdog@0 {
+			compatible = "ingenic,t10-watchdog",
+				     "ingenic,jz4780-watchdog";
+			reg = <0x0 0x10>;
+		};
+	};
+
+	uart1: serial@10031000 {
+		compatible = "ingenic,jz4780-uart";
+		reg = <0x10031000 0x100>;
+		reg-shift = <2>;
+		clock-frequency = <24000000>;
+		status = "disabled";
+	};
+
+	/*
+	 * SFC SPI-NOR controller - identical IP to T31; the in-tree
+	 * ingenic_sfc driver matches "ingenic,t31-sfc" (kept as the
+	 * compatible since that is the only match string; the block and
+	 * register map are the same on T10).
+	 */
+	sfc: spi@13440000 {
+		compatible = "ingenic,t31-sfc";
+		reg = <0x13440000 0x10000>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+		clocks = <&cgu T10_CLK_SFC>;
+		spi-max-frequency = <50000000>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pins_sfc>;
+		status = "disabled";
+	};
+
+	msc0: mmc@13450000 {
+		compatible = "ingenic,t31-mmc";
+		reg = <0x13450000 0x1000>;
+		clocks = <&cgu T10_CLK_MSC0>;
+		clock-names = "mmc";
+		cap-sd-highspeed;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pins_mmc0>;
+		status = "disabled";
+	};
+
+	/*
+	 * Pin controller + GPIO. Same XBurst1 engine as T31 (PA..PD,
+	 * 0x1000 stride); the ingenic,t10-pinctrl/-gpio compatibles are
+	 * handled by the shared pinctrl-ingenic driver.
+	 */
+	pinctrl: pinctrl@10010000 {
+		compatible = "ingenic,t10-pinctrl";
+		reg = <0x10010000 0x1000>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		gpa: gpio@0 {
+			compatible = "ingenic,t10-gpio";
+			reg = <0>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		gpb: gpio@1 {
+			compatible = "ingenic,t10-gpio";
+			reg = <1>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		gpc: gpio@2 {
+			compatible = "ingenic,t10-gpio";
+			reg = <2>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		gpd: gpio@3 {
+			compatible = "ingenic,t10-gpio";
+			reg = <3>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		pins_sfc: sfc {
+			function = "sfc";
+			groups = "sfc-data";
+		};
+
+		pins_mmc0: mmc0 {
+			function = "mmc0";
+			groups = "mmc0-1bit", "mmc0-4bit";
+		};
+
+		pins_mac: mac {
+			function = "mac";
+			groups = "mac-rmii";
+		};
+	};
+
+	/*
+	 * GMAC: Synopsys DesignWare MAC. ingenic,mode-reg is the CPM
+	 * GMAC-PHY-control register (CPM + 0xe8). Same glue as T31.
+	 */
+	gmac: ethernet@134b0000 {
+		compatible = "ingenic,t10-gmac";
+		reg = <0x134b0000 0x2000>;
+		phy-mode = "rmii";
+		max-speed = <100>;
+		clocks = <&cgu T10_CLK_GMAC>;
+		ingenic,mode-reg = <0x100000e8>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pins_mac>;
+		status = "disabled";
+	};
+
+	/*
+	 * DWC2 USB OTG. Production default dr_mode = "host" (the dwc2
+	 * host data-path fixes gate on dr_mode=="host"). The DFU/flash
+	 * loader uses a separate DT (t10-isvp-dfu) that overrides this
+	 * to "peripheral" for the dwc2_udc_otg gadget - one DM bind per
+	 * node; dual-role is a deliberate per-build DT choice.
+	 */
+	otg: usb@13500000 {
+		compatible = "snps,dwc2";
+		reg = <0x13500000 0x40000>;
+		dr_mode = "host";
+		clocks = <&cgu T10_CLK_OTG>;
+		g-rx-fifo-size = <512>;
+		g-np-tx-fifo-size = <16>;
+		g-tx-fifo-size = <256 256 16 16 16>;
+		status = "disabled";
+	};
+
+	/*
+	 * Audio: AIC (I2S) controller + on-chip codec. PIO playback driven
+	 * by U-Boot's `sound` command. Speaker-amp enable GPIO is per-board
+	 * (set in the board .dts via ingenic,spk-gpio; SDK default PB31
+	 * active-high). Compatible split: T20 -> A-block codec; T31/C100/T23
+	 * -> B-block codec (jz_t10_codec handles both via driver_data).
+	 */
+	aic: audio-controller@10020000 {
+		compatible = "ingenic,t10-aic";
+		clocks = <&cgu T10_CLK_MPLL>;
+		clock-names = "mpll";
+		reg = <0x10020000 0x100>;
+		#sound-dai-cells = <0>;
+		status = "disabled";
+	};
+
+	codec: audio-codec@10021000 {
+		compatible = "ingenic,t10-codec";
+		reg = <0x10021000 0x140>;
+		#sound-dai-cells = <0>;
+		status = "disabled";
+	};
+
+	sound: sound {
+		compatible = "ingenic,t10-sound";
+		status = "disabled";
+
+		cpu {
+			sound-dai = <&aic>;
+		};
+
+		codec {
+			sound-dai = <&codec>;
+		};
+	};
+};
