+		setbits_le32(cpm + CPM_OPCR, OPCR_SPENDN0);
+		setbits_le32(cpm + CPM_USBPCR, USBPCR_POR);
+		udelay(30);
+		clrbits_le32(cpm + CPM_USBPCR, USBPCR_POR);
+		udelay(300);
+		clrbits_le32(cpm + CPM_CLKGR0, CPM_CLKGR0_OTG);
