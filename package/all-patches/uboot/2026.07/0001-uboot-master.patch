diff --git a/arch/mips/dts/t41-isvp-dfu-uboot-common.dtsi b/arch/mips/dts/t41-isvp-dfu-uboot-common.dtsi
new file mode 100644
index 00000000..60032641
--- /dev/null
+++ b/arch/mips/dts/t41-isvp-dfu-uboot-common.dtsi
@@ -0,0 +1,58 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Binman image description for the Ingenic ISVP-T41 DFU loader.
+ *
+ * The USB-boot path uploads spl/u-boot-spl.bin + u-boot.bin directly
+ * via the mask ROM (tools/t31-usbboot.py - the protocol is generic
+ * across XBurst1 and XBurst2), so the binman flash images here are
+ * not used in the USB-boot flow. They are kept consistent with the
+ * t41-isvp SFC-NOR layout (headered SPL at 0, LZMA U-Boot at 0x10000)
+ * so a stray 'make' still produces a sensible flash image. The DFU
+ * loader SPL is ~34 KiB, so U-Boot must sit at 0x10000 (not 0x8000)
+ * or binman reports an overlap and the build fails.
+ */
+
+/ {
+	binman: binman {
+		multiple-images;
+	};
+};
+
+&binman {
+	u-boot-spl-t41 {
+		filename = "u-boot-spl-t41.bin";
+
+		ingenic-t31-spl {
+			filename = "spl/u-boot-spl.bin";
+		};
+	};
+
+	flash {
+		filename = "u-boot-with-spl-lzma.bin";
+		pad-byte = <0xff>;
+
+		spl {
+			type = "blob";
+			offset = <0x0>;
+			filename = "u-boot-spl-t41.bin";
+		};
+
+		u-boot {
+			type = "blob";
+			offset = <0x14000>;
+			filename = "u-boot-lzma.img";
+		};
+	};
+};
+
+/* SPL phase tags relocated from t41-isvp-dfu.dtsi (see t41-isvp-uboot-common.dtsi). */
+&ddr { bootph-all; };
+&cgu { bootph-all; };
+&pinctrl { bootph-all; };
+&gpa { bootph-all; };
+&gpb { bootph-all; };
+&gpc { bootph-all; };
+&gpd { bootph-all; };
+&gpe { bootph-all; };
+&pins_uart1 { bootph-all; };
+&uart1 { bootph-all; };
diff --git a/arch/mips/dts/t41-isvp-dfu.dtsi b/arch/mips/dts/t41-isvp-dfu.dtsi
new file mode 100644
index 00000000..78ce8eda
--- /dev/null
+++ b/arch/mips/dts/t41-isvp-dfu.dtsi
@@ -0,0 +1,204 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Ingenic ISVP-T41 USB-boot DFU-loader board body, shared by every
+ * T41 SKU. Trimmed sibling of t41-isvp.dtsi (no audio; OTG in gadget
+ * mode for DFU/g_dnl). The leaf .dts sets the per-SKU compatible on
+ * &ddr.
+ */
+
+#include <dt-bindings/clock/ingenic,t41-cgu.h>
+
+/ {
+	compatible = "ingenic,t41";
+	#address-cells = <1>;
+	#size-cells = <1>;
+
+	aliases {
+		serial1 = &uart1;
+	};
+
+	chosen {
+		stdout-path = "serial1:115200n8";
+	};
+
+	memory@0 {
+		device_type = "memory";
+		reg = <0x0 0x10000000>;
+	};
+
+	ddr: memory-controller@b34f0000 {
+		compatible = "ingenic,t41-ddr-innophy";
+		reg = <0xb34f0000 0x3000>;
+		/* the leaf .dts supplies the per-SKU ingenic,sdram-params array. */
+	};
+
+	cgu: clock-controller@b0000000 {
+		compatible = "ingenic,t41-cgu";
+		reg = <0xb0000000 0x1000>;
+		#clock-cells = <1>;
+	};
+
+	pinctrl: pinctrl@b0010000 {
+		compatible = "ingenic,t41-pinctrl";
+		reg = <0xb0010000 0x8000>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		gpa: gpio@0 {
+			compatible = "ingenic,t41-gpio";
+			reg = <0>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		gpb: gpio@1 {
+			compatible = "ingenic,t41-gpio";
+			reg = <1>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		gpc: gpio@2 {
+			compatible = "ingenic,t41-gpio";
+			reg = <2>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		gpd: gpio@3 {
+			compatible = "ingenic,t41-gpio";
+			reg = <3>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		gpe: gpio@4 {
+			compatible = "ingenic,t41-gpio";
+			reg = <4>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		pins_uart1: uart1 {
+			function = "uart1";
+			groups = "uart1-data";
+		};
+
+		pins_sfc: sfc {
+			function = "sfc";
+			groups = "sfc-data";
+		};
+
+		pins_mac0: mac0 {
+			function = "mac0";
+			groups = "mac0-data";
+		};
+
+		pins_mmc0: mmc0 {
+			function = "mmc0";
+			groups = "mmc0-1bit", "mmc0-4bit";
+		};
+	};
+
+	uart1: serial@b0031000 {
+		compatible = "ingenic,jz4780-uart", "ns16550a";
+		reg = <0xb0031000 0x100>;
+		reg-shift = <2>;
+		clock-frequency = <24000000>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pins_uart1>;
+		status = "okay";
+	};
+
+	/*
+	 * TCU (timer/counter unit) container mirroring T31's binding. U-Boot
+	 * only needs the watchdog child for sysreset; the WDT self-clocks
+	 * from the 32 kHz RTC so the TCU clock provider is not required.
+	 */
+	tcu: timer@b0002000 {
+		compatible = "ingenic,t41-tcu", "ingenic,jz4760-tcu",
+			     "simple-mfd";
+		reg = <0xb0002000 0x1000>;
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges = <0x0 0xb0002000 0x1000>;
+
+		watchdog: watchdog@0 {
+			compatible = "ingenic,t41-watchdog",
+				     "ingenic,jz4780-watchdog";
+			reg = <0x0 0x10>;
+		};
+	};
+
+	sfc: spi@b3440000 {
+		compatible = "ingenic,t41-sfc";
+		reg = <0xb3440000 0x10000>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+		clocks = <&cgu T41_CLK_SFC>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pins_sfc>;
+		spi-max-frequency = <50000000>;
+		status = "okay";
+
+		/*
+		 * flash@0 declared spi-nand so the NAND stack binds on NAND
+		 * boards; the loader's board_late_init() (mach-xburst/dfu.c)
+		 * auto-detects NOR vs NAND - on a NOR board the spi-nand probe
+		 * fails, the node is unbound, and a SPI-NOR is probed on CS0.
+		 * (T41 also has a second SFC at 0xb3450000; the autodetect is
+		 * dual-SFC-ready, but the SFC1 flash node + its pinmux are added
+		 * per-board once a T41 SFC1-NAND board is available to validate.)
+		 */
+		flash@0 {
+			compatible = "spi-nand";
+			reg = <0>;
+			spi-max-frequency = <50000000>;
+		};
+	};
+
+	msc0: mmc@b3060000 {
+		compatible = "ingenic,t41-mmc";
+		reg = <0xb3060000 0x10000>;
+		clocks = <&cgu T41_CLK_MSC0>;
+		clock-names = "mmc";
+		bus-width = <4>;
+		broken-cd;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pins_mmc0>;
+		status = "okay";
+	};
+
+	gmac0: ethernet@b34b0000 {
+		compatible = "ingenic,t41-gmac";
+		reg = <0xb34b0000 0x2000>;
+		clocks = <&cgu T41_CLK_GMAC0>;
+		phy-mode = "rmii";
+		phy-handle = <&gmac0_phy>;
+		ingenic,mode-reg = <0xb00000e8>;
+		max-speed = <100>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pins_mac0>;
+		status = "okay";
+
+		mdio {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			gmac0_phy: ethernet-phy@0 {
+				reg = <0>;
+			};
+		};
+	};
+
+	/*
+	 * T41 has a single DWC2 USB OTG at 0xb3500000 (A1 has three).
+	 */
+	otg0: usb@b3500000 {
+		compatible = "snps,dwc2";
+		reg = <0xb3500000 0x40000>;
+		clocks = <&cgu T41_CLK_OTG0>;
+		dr_mode = "peripheral";		/* gadget bind for DFU/g_dnl */
+		status = "okay";
+	};
+};
diff --git a/arch/mips/dts/t41-isvp-nand.dtsi b/arch/mips/dts/t41-isvp-nand.dtsi
new file mode 100644
index 00000000..e9f01bc6
--- /dev/null
+++ b/arch/mips/dts/t41-isvp-nand.dtsi
@@ -0,0 +1,47 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Ingenic ISVP-T41 SFC-NAND boot-media fragment: re-declare the SFC
+ * flash@0 node as SPI-NAND (the shared t41-isvp.dtsi declares it as
+ * jedec,spi-nor for the NOR SKUs) and add the partition map. Included
+ * by NAND-boot leaf .dts files after t41-isvp.dtsi.
+ */
+
+&sfc {
+	flash@0 {
+		compatible = "spi-nand";
+		reg = <0>;
+		spi-max-frequency = <50000000>;
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			/*
+			 * Layout (SPI-NAND, 128 KiB erase block):
+			 *   boot 1 MiB : raw SPL @ 0 + raw U-Boot @ 0x80000
+			 *                (matches binman u-boot-with-spl-lzma.bin;
+			 *                the SPL reads U-Boot from T41_NAND_UBOOT_OFFSET)
+			 *   ubi  rest  : UBI container - holds uboot-env, kernel
+			 *                (FIT), rootfs (squashfs) and overlay (UBIFS)
+			 *                as named volumes.
+			 * The U-Boot env lives in the UBI volume "uboot-env"
+			 * (CONFIG_ENV_IS_IN_UBI) so it survives bad blocks via UBI
+			 * wear-leveling.
+			 *
+			 * The "ubi" size below assumes a 256 MiB SPI-NAND; adjust
+			 * it to the board's actual chip (thingino also overrides the
+			 * runtime mtdparts via its sfc0_nand layout).
+			 */
+			partition@0 {
+				label = "boot";
+				reg = <0x0 0x100000>;
+			};
+
+			partition@100000 {
+				label = "ubi";
+				reg = <0x100000 0xff00000>;
+			};
+		};
+	};
+};
diff --git a/arch/mips/dts/t41-isvp-uboot-common.dtsi b/arch/mips/dts/t41-isvp-uboot-common.dtsi
new file mode 100644
index 00000000..0081a0d6
--- /dev/null
+++ b/arch/mips/dts/t41-isvp-uboot-common.dtsi
@@ -0,0 +1,110 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Binman image description for the Ingenic ISVP-T41 SFC-NOR boot.
+ *
+ * Mirrors the T40 SFC-NOR binman layout - T41 is the XBurst2 sibling of
+ * T40 and uses the same vendor `0x03040506 / 0x55aa5502 / 0x000000aa`
+ * SFC-NOR boot header at flash offset 0, with LZMA U-Boot at 0x10000
+ * (the DM-in-SPL SPL is ~62 KiB, past the old 0x8000 ceiling).
+ *
+ * The SPL header is a plain CRC + SPL_LENGTH header (no INGE block).
+ * Earlier T41 builds carried an `ingenic,inge-descriptors` table to
+ * program PLLs/CPCCR/SFC before SPL entry; with DM-in-SPL the SPL sets
+ * its own clocks in board_init_f before any clock-dependent work, so
+ * the INGE pre-programming is redundant. HW-verified 2026-05-28: T41NQ
+ * cold-boots cleanly to U-Boot without it (the only difference is a
+ * single pre-clk 0x00 byte on the UART before the SPL's clk driver
+ * runs). See the etype for the dormant opt-in property.
+ *
+ * 'make' produces:
+ *   u-boot-spl-t41.bin       : SPL with the finalized SFC-NOR boot
+ *                              header.
+ *   u-boot-with-spl-lzma.bin : headered SPL at offset 0 + LZMA U-Boot
+ *                              at 0x10000 - flash at offset 0 of NOR.
+ */
+
+/ {
+	binman: binman {
+		multiple-images;
+	};
+};
+
+&binman {
+#if defined(CONFIG_SPL_MMC)
+	/*
+	 * MSC/SD-card boot image (isvp_t41*_msc0). The SPL carries the
+	 * mask-ROM "MSPL" magic (arch/mips/mach-xburst/start.S, gated on
+	 * SPL_MMC) at offset 0, so it is used as a plain blob - the MSPL
+	 * header needs no CRC/length finalization (the mask ROM defaults the
+	 * load size). The ROM reads the SPL from SD sector 34 (0x4400); the
+	 * SPL then loads U-Boot from SYS_MMCSD_RAW_MODE_U_BOOT_SECTOR
+	 * (0x100 = byte 0x20000). Write u-boot-with-spl-mmc-lzma.bin to the SD
+	 * starting at sector 0.
+	 */
+	mmc {
+		filename = "u-boot-with-spl-mmc-lzma.bin";
+		pad-byte = <0x00>;
+
+		spl {
+			type = "blob";
+			offset = <0x4400>;
+			filename = "spl/u-boot-spl.bin";
+		};
+
+		u-boot {
+			type = "blob";
+			offset = <0x20000>;
+			filename = "u-boot-lzma.img";
+		};
+	};
+#else
+	u-boot-spl-t41 {
+		filename = "u-boot-spl-t41.bin";
+
+		ingenic-t31-spl {
+			filename = "spl/u-boot-spl.bin";
+		};
+	};
+
+	flash {
+		filename = "u-boot-with-spl-lzma.bin";
+		pad-byte = <0xff>;
+
+		spl {
+			type = "blob";
+			offset = <0x0>;
+			filename = "u-boot-spl-t41.bin";
+		};
+
+		u-boot {
+			type = "blob";
+			offset = <0x14000>;
+			filename = "u-boot-lzma.img";
+		};
+	};
+#endif
+};
+
+/*
+ * SPL phase tags: bootph is U-Boot build-phase control (which nodes
+ * survive fdtgrep into the SPL DTB), not hardware - so it lives in the
+ * U-Boot overlay beside binman, keeping t41-isvp.dtsi a clean hardware
+ * description (mirrors the XBurst1 SoCs).
+ */
+&ddr { bootph-all; };
+&cgu { bootph-all; };
+&pinctrl { bootph-all; };
+&gpa { bootph-all; };
+&gpb { bootph-all; };
+&gpc { bootph-all; };
+&gpd { bootph-all; };
+&gpe { bootph-all; };
+&pins_uart1 { bootph-all; };
+&pins_sfc { bootph-all; };
+&pins_mmc0 { bootph-all; };
+&uart1 { bootph-all; };
+&sfc {
+	bootph-all;
+	flash@0 { bootph-all; };
+};
+&msc0 { bootph-all; };
diff --git a/arch/mips/dts/t41-isvp.dtsi b/arch/mips/dts/t41-isvp.dtsi
new file mode 100644
index 00000000..c8f88dfb
--- /dev/null
+++ b/arch/mips/dts/t41-isvp.dtsi
@@ -0,0 +1,250 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Ingenic ISVP-T41 SFC-NOR board body, shared by every T41 SKU.
+ * The per-SKU leaf .dts (t41nq-isvp.dts, t41lq-isvp.dts, ...) includes
+ * this file and sets the per-SKU compatible on &ddr - the only thing
+ * that differs between SKUs is the soldered DDR part (DDR2 vs DDR3).
+ */
+
+#include <dt-bindings/clock/ingenic,t41-cgu.h>
+#include <dt-bindings/gpio/gpio.h>
+
+/ {
+	compatible = "ingenic,t41";
+	#address-cells = <1>;
+	#size-cells = <1>;
+
+	aliases {
+		serial1 = &uart1;
+	};
+
+	chosen {
+		stdout-path = "serial1:115200n8";
+	};
+
+	memory@0 {
+		device_type = "memory";
+		reg = <0x0 0x10000000>;
+	};
+
+	/*
+	 * DDR controller + Innophy PHY. ddr_innophy.c picks the per-SKU
+	 * timing/type table from the &ddr node's compatible (set by the
+	 * leaf .dts). SPL probes this off DT and runs sdram_init() with
+	 * hardware DQS calibration enabled.
+	 */
+	ddr: memory-controller@b34f0000 {
+		compatible = "ingenic,t41-ddr-innophy";
+		reg = <0xb34f0000 0x3000>;
+		/* the leaf .dts supplies the per-SKU ingenic,sdram-params array. */
+	};
+
+	cgu: clock-controller@b0000000 {
+		compatible = "ingenic,t41-cgu";
+		reg = <0xb0000000 0x1000>;
+		#clock-cells = <1>;
+	};
+
+	pinctrl: pinctrl@b0010000 {
+		compatible = "ingenic,t41-pinctrl";
+		reg = <0xb0010000 0x8000>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		gpa: gpio@0 {
+			compatible = "ingenic,t41-gpio";
+			reg = <0>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		gpb: gpio@1 {
+			compatible = "ingenic,t41-gpio";
+			reg = <1>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		gpc: gpio@2 {
+			compatible = "ingenic,t41-gpio";
+			reg = <2>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		gpd: gpio@3 {
+			compatible = "ingenic,t41-gpio";
+			reg = <3>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		gpe: gpio@4 {
+			compatible = "ingenic,t41-gpio";
+			reg = <4>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		pins_uart1: uart1 {
+			function = "uart1";
+			groups = "uart1-data";
+		};
+
+		pins_sfc: sfc {
+			function = "sfc";
+			groups = "sfc-data";
+		};
+
+		pins_mac0: mac0 {
+			function = "mac0";
+			groups = "mac0-data";
+		};
+
+		pins_mmc0: mmc0 {
+			function = "mmc0";
+			groups = "mmc0-1bit", "mmc0-4bit";
+		};
+	};
+
+	/*
+	 * AIC (audio interface controller) + on-chip codec. PIO playback
+	 * driven by U-Boot's `sound` command. T41 codec is the "E-block":
+	 * registers were renamed/relaid from T40's D-block (no _XX suffix,
+	 * new CDCFGR/CACR1, DAC analog path on CANACR1/CHR/CHPOUTLGR).
+	 * AIC IP is closer to T31/T32 - no AICCR1/AICCR2 extension that
+	 * T40 has; AICFR uses RMASTER/TMASTER (T32-style) for master sel.
+	 */
+	aic: audio-controller@b0020000 {
+		compatible = "ingenic,t41-aic";
+		reg = <0xb0020000 0x100>;
+		clocks = <&cgu T41_CLK_APLL>;
+		clock-names = "apll";
+		#sound-dai-cells = <0>;
+		status = "okay";
+	};
+
+	codec: audio-codec@b0021000 {
+		compatible = "ingenic,t41-codec";
+		reg = <0xb0021000 0x130>;
+		#sound-dai-cells = <0>;
+		/* Speaker-amp enable: vendor codec.c default PB31,
+		 * active-high. Override per board if the amp is on a
+		 * different pin/polarity. */
+		ingenic,spk-gpio = <&gpb 31 GPIO_ACTIVE_HIGH>;
+		status = "okay";
+	};
+
+	sound: sound {
+		compatible = "ingenic,t41-sound";
+		status = "okay";
+
+		cpu {
+			sound-dai = <&aic>;
+		};
+
+		codec {
+			sound-dai = <&codec>;
+		};
+	};
+
+	uart1: serial@b0031000 {
+		compatible = "ingenic,jz4780-uart", "ns16550a";
+		reg = <0xb0031000 0x100>;
+		reg-shift = <2>;
+		clock-frequency = <24000000>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pins_uart1>;
+		status = "okay";
+	};
+
+	/*
+	 * TCU (timer/counter unit) container mirroring T31's binding. U-Boot
+	 * only needs the watchdog child for sysreset; the WDT self-clocks
+	 * from the 32 kHz RTC so the TCU clock provider is not required.
+	 */
+	tcu: timer@b0002000 {
+		compatible = "ingenic,t41-tcu", "ingenic,jz4760-tcu",
+			     "simple-mfd";
+		reg = <0xb0002000 0x1000>;
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges = <0x0 0xb0002000 0x1000>;
+
+		watchdog: watchdog@0 {
+			compatible = "ingenic,t41-watchdog",
+				     "ingenic,jz4780-watchdog";
+			reg = <0x0 0x10>;
+		};
+	};
+
+	sfc: spi@b3440000 {
+		compatible = "ingenic,t41-sfc";
+		reg = <0xb3440000 0x10000>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+		clocks = <&cgu T41_CLK_SFC>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pins_sfc>;
+		spi-max-frequency = <50000000>;
+		status = "okay";
+
+		flash@0 {
+			compatible = "jedec,spi-nor";
+			reg = <0>;
+			spi-max-frequency = <50000000>;
+		};
+	};
+
+	msc0: mmc@b3060000 {
+		compatible = "ingenic,t41-mmc";
+		reg = <0xb3060000 0x10000>;
+		clocks = <&cgu T41_CLK_MSC0>;
+		clock-names = "mmc";
+		bus-width = <4>;
+		broken-cd;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pins_mmc0>;
+		status = "okay";
+	};
+
+	gmac0: ethernet@b34b0000 {
+		compatible = "ingenic,t41-gmac";
+		reg = <0xb34b0000 0x2000>;
+		clocks = <&cgu T41_CLK_GMAC0>;
+		phy-mode = "rmii";
+		phy-handle = <&gmac0_phy>;
+		ingenic,mode-reg = <0xb00000e8>;
+		max-speed = <100>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pins_mac0>;
+		status = "okay";
+
+		mdio {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			gmac0_phy: ethernet-phy@0 {
+				reg = <0>;
+			};
+		};
+	};
+
+	/*
+	 * T41 has a single DWC2 USB OTG at 0xb3500000 (XBurst2 layout shared
+	 * with T40 / A1). NOR-boot DT runs the port as a USB host so the
+	 * board can enumerate ASIX-style USB ethernet without DFU.
+	 */
+	otg0: usb@b3500000 {
+		compatible = "snps,dwc2";
+		reg = <0xb3500000 0x40000>;
+		clocks = <&cgu T41_CLK_OTG0>;
+		dr_mode = "host";
+		/* Same CONIDSTS=1 quirk as T40: the OTG port enumerates as a
+		 * B-device even on A-receptacle wiring, so the dwc2 host
+		 * driver never powers the port. hnp-srp-disable forces
+		 * GUSBCFG.FORCEHOSTMODE, bypassing the ID-pin check. */
+		hnp-srp-disable;
+		status = "okay";
+	};
+};
