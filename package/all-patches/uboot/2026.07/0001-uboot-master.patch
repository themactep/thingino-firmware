+			gpios = <3 GPIO_ACTIVE_LOW>;
+			output-low;
+			line-name = "leds-en";
+			bootph-pre-ram;
+		};
+
+		flg0 {
+			gpio-hog;
+			gpios = <4 GPIO_ACTIVE_LOW>;
+			output-low;
+			line-name = "flg0_loop";
+			bootph-pre-ram;
