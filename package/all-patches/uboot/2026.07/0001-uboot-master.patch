diff --git a/arch/mips/dts/t32lq-isvp-dfu.dts b/arch/mips/dts/t32lq-isvp-dfu.dts
new file mode 100644
index 00000000..bcb92b49
--- /dev/null
+++ b/arch/mips/dts/t32lq-isvp-dfu.dts
@@ -0,0 +1,48 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Ingenic ISVP-T32LQ DFU/USB-boot loader (DDR2 64 MB, CPU 900 MHz).
+ *
+ * The LQ DDR2-64M init brings up any DDR2 T32 part (LQ/VL/ZL are
+ * param-identical), so this loader doubles as the universal DDR2 DFU
+ * loader. DDR3/LPDDR3 parts (NQ/VN/XQ/VX/ZN/ZX/VNP) need their own
+ * loader.
+ */
+
+/dts-v1/;
+
+#include "t32-isvp-dfu.dtsi"
+
+/ {
+	model = "Ingenic ISVP-T32LQ (DFU loader)";
+};
+
+&ddr {
+	ingenic,sdram-params = <
+		0 0x04000000 300000000	/* type size ddr_ck_hz */
+		0x04b05101 0x06405101 0x557b5510 0x9a7b5510	/* cpapcr cpmpcr cpccr_div cpccr_sel */
+		0x00040000	/* mstr */
+		0x0001003b 0x00000007 0x01130000 0x00000000 0x00000000	/* init0 init1 init3 init4 init5 */
+		0x0a01140e 0x00020312 0x00000408 0x00001000 0x04010405	/* timing0..4 */
+		0x01010202 0x00000000 0x00000101 0x00000402 0x00000000	/* timing5 timing6 timing7 timing8 timing14 */
+		0x003f0808 0x00000000 0x00000000 0x00001f1f 0x06060606 0x0f0f0f06	/* addrmap1..6 */
+		0x00000002 0x00490020 0x07020708	/* rfshctl3 rfshtmg odtcfg */
+		0x06020002 0x00080307 0x80400003	/* dfitmg0 dfitmg1 dfiupd0 */
+		0x00000003 0x00000007 0x00000008 0x00000000	/* phy: channel_en cwl cl al */
+		0x00000020 0x00000925 0x00000000	/* phy: trfc trefi mem_sel */
+		0x00000001 0x00000001	/* phy: pllpostdiven pllpostdiv */
+	>;
+};
+
+/*
+ * flash@0 declared spi-nand so the NAND stack binds on NAND boards.
+ * board_late_init() (arch/mips/mach-xburst/dfu.c) auto-detects NOR vs
+ * NAND: on a NOR board the spi-nand probe fails, the node is unbound,
+ * and a SPI-NOR is probed on CS0 instead - one loader flashes either.
+ */
+&sfc {
+	flash@0 {
+		compatible = "spi-nand";
+		reg = <0>;
+		spi-max-frequency = <50000000>;
+	};
+};
