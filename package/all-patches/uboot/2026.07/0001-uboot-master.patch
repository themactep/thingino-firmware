-	.name		= "spacemit,k1-reset",
-	.id		= UCLASS_RESET,
-	.ops		= &k1_reset_ops,
-	.of_match	= k1_reset_ids,
-	.probe		= spacemit_k1_reset_probe,
-	.priv_auto	= sizeof(struct spacemit_reset),
-};
