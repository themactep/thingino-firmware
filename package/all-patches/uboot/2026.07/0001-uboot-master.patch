diff --git a/arch/mips/dts/t33-isvp-dfu-u-boot.dtsi b/arch/mips/dts/t33-isvp-dfu-u-boot.dtsi
new file mode 100644
index 00000000..29130880
--- /dev/null
+++ b/arch/mips/dts/t33-isvp-dfu-u-boot.dtsi
@@ -0,0 +1,49 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Binman image description for the Ingenic ISVP-T33 DFU loader.
+ *
+ * The USB-boot path uploads spl/u-boot-spl.bin + u-boot.bin
+ * directly via the mask ROM, so the binman flash images here are
+ * not used in the USB-boot flow. They are kept consistent with
+ * the production t33-isvp layout (LZMA U-Boot at 0x10000) so a
+ * stray `make` still produces a sensible flash image. Outputs:
+ *
+ *   u-boot-spl-t33.bin       : SPL with the finalized SFC-NOR boot
+ *                              header (CRC7 + image length).
+ *   u-boot-with-spl-lzma.bin : headered SPL at offset 0 + LZMA
+ *                              U-Boot at the SPL-loader offset
+ *                              (no 0xff padding).
+ */
+
+/ {
+	binman: binman {
+		multiple-images;
+	};
+};
+
+&binman {
+	u-boot-spl-t33 {
+		filename = "u-boot-spl-t33.bin";
+
+		ingenic-t31-spl {
+			filename = "spl/u-boot-spl.bin";
+		};
+	};
+
+	flash {
+		filename = "u-boot-with-spl-lzma.bin";
+		pad-byte = <0xff>;
+
+		spl {
+			type = "blob";
+			offset = <0x0>;
+			filename = "u-boot-spl-t33.bin";
+		};
+
+		u-boot {
+			type = "blob";
+			offset = <0x10000>;
+			filename = "u-boot-lzma.img";
+		};
+	};
+};
diff --git a/arch/mips/dts/t33-isvp-dfu.dts b/arch/mips/dts/t33-isvp-dfu.dts
new file mode 100644
index 00000000..08f72947
--- /dev/null
+++ b/arch/mips/dts/t33-isvp-dfu.dts
@@ -0,0 +1,60 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Ingenic ISVP-T33, DFU/USB-boot loader variant.
+ *
+ * Identical to t33-isvp.dts except the DWC2 OTG is dr_mode =
+ * "peripheral" so the dwc2_udc_otg gadget binds (dwc2_udc_otg_bind
+ * rejects "host"). Used only by isvp_t33_usbboot_defconfig - the
+ * dev/flash loader that USB-boots and auto-enters DFU. Production
+ * NOR uses t33-isvp.dts (dr_mode="host" for USB host).
+ *
+ * Memory: 64 MB - matches the DDR2 M14D5121632A default
+ * (T33_DDR_SIZE in t33-ddr.h). DDR3-128M variants would need
+ * their own DFU DT + defconfig pair.
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include "t33.dtsi"
+
+/ {
+	compatible = "ingenic,isvp-t33", "ingenic,t33";
+	model = "Ingenic ISVP-T33 (DFU loader)";
+
+	aliases {
+		serial1 = &uart1;
+	};
+
+	chosen {
+		stdout-path = "serial1:115200n8";
+	};
+
+	memory {
+		device_type = "memory";
+		reg = <0x0 0x04000000>;	/* 64 MB DDR2 (M14D5121632A) */
+	};
+};
+
+&uart1 {
+	status = "okay";
+};
+
+&sfc {
+	status = "okay";
+
+	flash@0 {
+		compatible = "jedec,spi-nor";
+		reg = <0>;
+		spi-max-frequency = <50000000>;
+	};
+};
+
+&msc0 {
+	status = "okay";
+};
+
+&otg {
+	status = "okay";
+	dr_mode = "peripheral";		/* gadget bind for DFU/g_dnl */
+};
diff --git a/arch/mips/dts/t33-isvp-u-boot.dtsi b/arch/mips/dts/t33-isvp-u-boot.dtsi
new file mode 100644
index 00000000..5a4a5cd2
--- /dev/null
+++ b/arch/mips/dts/t33-isvp-u-boot.dtsi
@@ -0,0 +1,51 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Binman image description for the Ingenic ISVP-T33 SFC-NOR boot.
+ *
+ * The T33 mask ROM (and the QEMU ingenic-t33 model, which emulates
+ * it) boots SPI-NOR by reading the 2 KiB SPL header at flash offset
+ * 0: magic 0x03040506 (emitted by start.S), total image length at
+ * byte 12. It then copies header+SPL and enters at offset 0x800.
+ * The ingenic-t31-spl entry finalizes that header (CRC7 + length);
+ * it is the T31 mask-ROM contract, shared verbatim by the T33
+ * bootrom / QEMU model, so it is reused as-is.
+ *
+ *   u-boot-spl-t33.bin : SPL with the finalized boot header.
+ *   u-boot-t33.bin     : 16 MB flash image - headered SPL at 0,
+ *                        LZMA U-Boot at 0x10000, 0xff-padded.
+ *   u-boot-t33-min.bin : same layout, trimmed to the last entry.
+ */
+
+/ {
+	binman: binman {
+		multiple-images;
+	};
+};
+
+&binman {
+	/* Standalone headered SPL (CRC7 + image length finalized). */
+	u-boot-spl-t33 {
+		filename = "u-boot-spl-t33.bin";
+
+		ingenic-t31-spl {
+			filename = "spl/u-boot-spl.bin";
+		};
+	};
+
+	flash {
+		filename = "u-boot-with-spl-lzma.bin";
+		pad-byte = <0xff>;
+
+		spl {
+			type = "blob";
+			offset = <0x0>;
+			filename = "u-boot-spl-t33.bin";
+		};
+
+		u-boot {
+			type = "blob";
+			offset = <0x10000>;
+			filename = "u-boot-lzma.img";
+		};
+	};
+};
diff --git a/arch/mips/dts/t33-isvp.dts b/arch/mips/dts/t33-isvp.dts
new file mode 100644
index 00000000..53f98b5a
--- /dev/null
+++ b/arch/mips/dts/t33-isvp.dts
@@ -0,0 +1,38 @@
+// SPDX-License-Identifier: GPL-2.0+
+
+/dts-v1/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include "t33.dtsi"
+
+/ {
+	compatible = "ingenic,isvp-t33", "ingenic,t33";
+	model = "Ingenic ISVP-T33 (SFC NOR)";
+
+	aliases {
+		serial1 = &uart1;
+	};
+
+	chosen {
+		stdout-path = "serial1:115200n8";
+	};
+
+	memory {
+		device_type = "memory";
+		reg = <0x0 0x04000000>;	/* 64 MB DDR2 (M14D5121632A) */
+	};
+};
+
+&uart1 {
+	status = "okay";
+};
+
+&sfc {
+	status = "okay";
+
+	flash@0 {
+		compatible = "jedec,spi-nor";
+		reg = <0>;
+		spi-max-frequency = <50000000>;
+	};
+};
diff --git a/arch/mips/dts/t33.dtsi b/arch/mips/dts/t33.dtsi
new file mode 100644
index 00000000..af818037
--- /dev/null
+++ b/arch/mips/dts/t33.dtsi
@@ -0,0 +1,180 @@
+// SPDX-License-Identifier: GPL-2.0+
+
+#include <dt-bindings/clock/ingenic,t33-cgu.h>
+
+/ {
+	#address-cells = <1>;
+	#size-cells = <1>;
+	compatible = "ingenic,t33";
+
+	cpus {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		cpu0: cpu@0 {
+			device_type = "cpu";
+			compatible = "ingenic,xburst", "mips,mips32r2";
+			reg = <0>;
+		};
+	};
+
+	cpuintc: interrupt-controller {
+		#address-cells = <0>;
+		#interrupt-cells = <1>;
+		interrupt-controller;
+		compatible = "mti,cpu-interrupt-controller";
+	};
+
+	exclk: exclk {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <24000000>;
+	};
+
+	rtclk: rtclk {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <32768>;
+	};
+
+	/*
+	 * CGU. The SPL programs the PLLs/dividers; this driver runs in
+	 * U-Boot proper, recalculates the PLL rates and provides
+	 * rate/gate control for the leaf clocks. T33 (PRJ008) is NOT
+	 * CGU-bit-compatible with T31 (own clk-t33 driver / binding).
+	 */
+	cgu: clock-controller@10000000 {
+		compatible = "ingenic,t33-cgu", "simple-mfd";
+		reg = <0x10000000 0x1000>;
+		#clock-cells = <1>;
+		clocks = <&exclk>, <&rtclk>;
+		clock-names = "ext", "rtc";
+		u-boot,dm-pre-reloc;
+	};
+
+	/*
+	 * TCU container (mirrors the Linux ingenic tcu/simple-mfd
+	 * binding) so the watchdog child binds; U-Boot only needs the
+	 * watchdog for sysreset (it self-clocks from the 32 kHz RTC).
+	 */
+	tcu: timer@10002000 {
+		compatible = "ingenic,t33-tcu", "ingenic,jz4760-tcu",
+			     "simple-mfd";
+		reg = <0x10002000 0x1000>;
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges = <0x0 0x10002000 0x1000>;
+
+		watchdog: watchdog@0 {
+			compatible = "ingenic,t33-watchdog",
+				     "ingenic,jz4780-watchdog";
+			reg = <0x0 0x10>;
+		};
+	};
+
+	uart1: serial@10031000 {
+		compatible = "ingenic,jz4780-uart";
+		reg = <0x10031000 0x100>;
+		reg-shift = <2>;
+		clock-frequency = <24000000>;
+		status = "disabled";
+	};
+
+	/*
+	 * SFC2 (descriptor-capable SPI-NOR controller). The SPL uses it
+	 * to load U-Boot proper; a U-Boot-proper DM SPI driver for the
+	 * SFC2 register model is a follow-up, so this node stays
+	 * disabled (env is not in flash in the initial T33 profile).
+	 */
+	sfc: spi@13440000 {
+		compatible = "ingenic,t33-sfc";
+		reg = <0x13440000 0x10000>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+		clocks = <&cgu T33_CLK_SFC>;
+		spi-max-frequency = <50000000>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pins_sfc>;
+		status = "disabled";
+	};
+
+	msc0: mmc@13450000 {
+		compatible = "ingenic,t31-mmc";
+		reg = <0x13450000 0x1000>;
+		clocks = <&cgu T33_CLK_MSC0>;
+		clock-names = "mmc";
+		cap-sd-highspeed;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pins_mmc0>;
+		status = "disabled";
+	};
+
+	/*
+	 * DWC2 USB OTG. T33 puts the controller at the same base as
+	 * T31/T32 (0x13500000). The host/peripheral split is per-board:
+	 * the production NOR DTS sets dr_mode = "host" (USB-NIC, mass
+	 * storage etc.); the DFU loader DT overlay flips dr_mode to
+	 * "peripheral" so the dwc2_udc_otg gadget binds. Status
+	 * disabled here, enabled per-board.
+	 */
+	otg: usb@13500000 {
+		compatible = "snps,dwc2";
+		reg = <0x13500000 0x40000>;
+		dr_mode = "host";
+		clocks = <&cgu T33_CLK_OTG>;
+		g-rx-fifo-size = <512>;
+		g-np-tx-fifo-size = <16>;
+		g-tx-fifo-size = <256 256 16 16 16>;
+		status = "disabled";
+	};
+
+	/*
+	 * Pin controller + GPIO. T33 reuses the shared XBurst1
+	 * GPIO/pinmux engine and group tables (same rationale as T23/
+	 * T30); only the controller/gpio compatibles are T33-specific.
+	 */
+	pinctrl: pinctrl@10010000 {
+		compatible = "ingenic,t33-pinctrl";
+		reg = <0x10010000 0x1000>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		gpa: gpio@0 {
+			compatible = "ingenic,t33-gpio";
+			reg = <0>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		gpb: gpio@1 {
+			compatible = "ingenic,t33-gpio";
+			reg = <1>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		gpc: gpio@2 {
+			compatible = "ingenic,t33-gpio";
+			reg = <2>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		gpd: gpio@3 {
+			compatible = "ingenic,t33-gpio";
+			reg = <3>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		pins_sfc: sfc {
+			function = "sfc";
+			groups = "sfc-data";
+		};
+
+		pins_mmc0: mmc0 {
+			function = "mmc0";
+			groups = "mmc0-1bit", "mmc0-4bit";
+		};
+	};
+};
diff --git a/arch/mips/dts/t40-isvp-dfu-uboot-common.dtsi b/arch/mips/dts/t40-isvp-dfu-uboot-common.dtsi
new file mode 100644
index 00000000..eacce116
--- /dev/null
+++ b/arch/mips/dts/t40-isvp-dfu-uboot-common.dtsi
@@ -0,0 +1,24 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Shared T40 DFU-loader SPL phase tags.
+ *
+ * bootph-* is U-Boot build-phase control (which nodes survive fdtgrep
+ * into the SPL DTB), not hardware - so it lives in the U-Boot overlay
+ * beside binman, keeping t40-isvp-dfu.dtsi a clean hardware description
+ * (mirrors the XBurst1 SoCs and the T41 sibling).
+ *
+ * Included by the per-SKU DFU-loader overlays (t40n-isvp-dfu-u-boot.dtsi,
+ * t40xp-isvp-dfu-u-boot.dtsi). The DFU loader's SPL returns to the mask
+ * ROM, so the boot-media (sfc/flash) tags differ from the cold-boot DT
+ * and are carried per-leaf, not here.
+ */
+&ddr { bootph-all; };
+&cgu { bootph-all; };
+&pinctrl { bootph-all; };
+&gpa { bootph-all; };
+&gpb { bootph-all; };
+&gpc { bootph-all; };
+&gpd { bootph-all; };
+&gpe { bootph-all; };
+&pins_uart1 { bootph-all; };
+&uart1 { bootph-all; };
diff --git a/arch/mips/dts/t40-isvp-dfu.dtsi b/arch/mips/dts/t40-isvp-dfu.dtsi
new file mode 100644
index 00000000..7e6099c8
--- /dev/null
+++ b/arch/mips/dts/t40-isvp-dfu.dtsi
@@ -0,0 +1,193 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Ingenic ISVP-T40 USB-boot DFU-loader board body, shared by every
+ * T40 SKU. Trimmed sibling of t40-isvp.dtsi (no audio/MMC; OTG in
+ * gadget mode for DFU/g_dnl). The leaf .dts sets the per-SKU
+ * compatible on &ddr and adds its flash@0 node on &sfc (the DFU
+ * loader's SPL returns to the mask ROM, so the boot-media bootph tags
+ * differ from the cold-boot DT and are carried by the leaf).
+ */
+
+#include <dt-bindings/clock/ingenic,t40-cgu.h>
+
+/ {
+	compatible = "ingenic,t40";
+	#address-cells = <1>;
+	#size-cells = <1>;
+
+	aliases {
+		serial1 = &uart1;
+	};
+
+	chosen {
+		stdout-path = "serial1:115200n8";
+	};
+
+	memory@0 {
+		device_type = "memory";
+		reg = <0x0 0x10000000>;
+	};
+
+	ddr: memory-controller@b34f0000 {
+		compatible = "ingenic,t40-ddr-innophy";
+		reg = <0xb34f0000 0x3000>;
+		/* the leaf .dts supplies the per-SKU ingenic,sdram-params array. */
+	};
+
+	cgu: clock-controller@b0000000 {
+		compatible = "ingenic,t40-cgu";
+		reg = <0xb0000000 0x1000>;
+		#clock-cells = <1>;
+	};
+
+	pinctrl: pinctrl@b0010000 {
+		compatible = "ingenic,t40-pinctrl";
+		reg = <0xb0010000 0x8000>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		gpa: gpio@0 {
+			compatible = "ingenic,t40-gpio";
+			reg = <0>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		gpb: gpio@1 {
+			compatible = "ingenic,t40-gpio";
+			reg = <1>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		gpc: gpio@2 {
+			compatible = "ingenic,t40-gpio";
+			reg = <2>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		gpd: gpio@3 {
+			compatible = "ingenic,t40-gpio";
+			reg = <3>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		gpe: gpio@4 {
+			compatible = "ingenic,t40-gpio";
+			reg = <4>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		pins_uart1: uart1 {
+			function = "uart1";
+			groups = "uart1-data";
+		};
+
+		pins_sfc: sfc {
+			function = "sfc";
+			groups = "sfc-data";
+		};
+
+		pins_mac0: mac0 {
+			function = "mac0";
+			groups = "mac0-data";
+		};
+
+		pins_mmc0: mmc0 {
+			function = "mmc0";
+			groups = "mmc0-1bit", "mmc0-4bit";
+		};
+	};
+
+	uart1: serial@b0031000 {
+		compatible = "ingenic,jz4780-uart", "ns16550a";
+		reg = <0xb0031000 0x100>;
+		reg-shift = <2>;
+		clock-frequency = <24000000>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pins_uart1>;
+		status = "okay";
+	};
+
+	/*
+	 * TCU (timer/counter unit) container mirroring T31's binding. U-Boot
+	 * only needs the watchdog child for sysreset; the WDT self-clocks
+	 * from the 32 kHz RTC so the TCU clock provider is not required.
+	 */
+	tcu: timer@b0002000 {
+		compatible = "ingenic,t40-tcu", "ingenic,jz4760-tcu",
+			     "simple-mfd";
+		reg = <0xb0002000 0x1000>;
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges = <0x0 0xb0002000 0x1000>;
+
+		watchdog: watchdog@0 {
+			compatible = "ingenic,t40-watchdog",
+				     "ingenic,jz4780-watchdog";
+			reg = <0x0 0x10>;
+		};
+	};
+
+	sfc: spi@b3440000 {
+		compatible = "ingenic,t40-sfc";
+		reg = <0xb3440000 0x10000>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+		clocks = <&cgu T40_CLK_SFC>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pins_sfc>;
+		spi-max-frequency = <50000000>;
+		status = "okay";
+
+		/* flash@0 comes from the per-SKU leaf .dts. */
+	};
+
+	msc0: mmc@b3060000 {
+		compatible = "ingenic,t40-mmc";
+		reg = <0xb3060000 0x10000>;
+		clocks = <&cgu T40_CLK_MSC0>;
+		clock-names = "mmc";
+		bus-width = <4>;
+		broken-cd;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pins_mmc0>;
+		status = "okay";
+	};
+
+	gmac0: ethernet@b34b0000 {
+		compatible = "ingenic,t40-gmac";
+		reg = <0xb34b0000 0x2000>;
+		clocks = <&cgu T40_CLK_GMAC0>;
+		phy-mode = "rmii";
+		phy-handle = <&gmac0_phy>;
+		ingenic,mode-reg = <0xb00000e8>;
+		max-speed = <100>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pins_mac0>;
+		status = "okay";
+
+		mdio {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			gmac0_phy: ethernet-phy@0 {
+				reg = <0>;
+			};
+		};
+	};
+
+	/*
+	 * T40 has a single DWC2 USB OTG at 0x13500000 (A1 has three).
+	 */
+	otg0: usb@b3500000 {
+		compatible = "snps,dwc2";
+		reg = <0xb3500000 0x40000>;
+		clocks = <&cgu T40_CLK_OTG0>;
+		dr_mode = "peripheral";		/* gadget bind for DFU/g_dnl */
+		status = "okay";
+	};
+};
diff --git a/arch/mips/dts/t40-isvp-nand.dtsi b/arch/mips/dts/t40-isvp-nand.dtsi
new file mode 100644
index 00000000..163f4ace
--- /dev/null
+++ b/arch/mips/dts/t40-isvp-nand.dtsi
@@ -0,0 +1,41 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Ingenic ISVP-T40 SFC-NAND boot-media fragment: the SPI-NAND flash
+ * node + partition map on the SFC controller. Included by NAND-boot
+ * leaf .dts files.
+ */
+
+&sfc {
+	flash@0 {
+		compatible = "spi-nand";
+		reg = <0>;
+		spi-max-frequency = <50000000>;
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			/*
+			 * Layout (SPI-NAND, 256 MiB, 128 KiB erase block):
+			 *   boot 1 MiB : raw SPL @ 0 + raw U-Boot @ 0x8000
+			 *                (matches binman u-boot-with-spl-lzma.bin)
+			 *   ubi  rest  : UBI container - holds uboot-env,
+			 *                kernel (FIT), rootfs (squashfs), and
+			 *                overlay (UBIFS) as named volumes.
+			 * U-Boot env lives in the UBI volume "uboot-env"
+			 * (CONFIG_ENV_IS_IN_UBI) so it survives bad blocks
+			 * via UBI wear-leveling.
+			 */
+			partition@0 {
+				label = "boot";
+				reg = <0x0 0x100000>;
+			};
+
+			partition@100000 {
+				label = "ubi";
+				reg = <0x100000 0xff00000>;
+			};
+		};
+	};
+};
diff --git a/arch/mips/dts/t40-isvp-nor.dtsi b/arch/mips/dts/t40-isvp-nor.dtsi
new file mode 100644
index 00000000..22e474be
--- /dev/null
+++ b/arch/mips/dts/t40-isvp-nor.dtsi
@@ -0,0 +1,13 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Ingenic ISVP-T40 SFC-NOR boot-media fragment: the SPI-NOR flash node
+ * on the SFC controller. Included by NOR-boot leaf .dts files.
+ */
+
+&sfc {
+	flash@0 {
+		compatible = "jedec,spi-nor";
+		reg = <0>;
+		spi-max-frequency = <50000000>;
+	};
+};
diff --git a/arch/mips/dts/t40-isvp-uboot-common.dtsi b/arch/mips/dts/t40-isvp-uboot-common.dtsi
new file mode 100644
index 00000000..2d3ed2f3
--- /dev/null
+++ b/arch/mips/dts/t40-isvp-uboot-common.dtsi
@@ -0,0 +1,29 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Shared T40 normal-boot SPL phase tags.
+ *
+ * bootph-* is U-Boot build-phase control (which nodes survive fdtgrep
+ * into the SPL DTB), not hardware - so it lives in the U-Boot overlay
+ * beside binman, keeping t40-isvp.dtsi a clean hardware description
+ * (mirrors the XBurst1 SoCs and the T41 sibling).
+ *
+ * Included by the per-SKU normal-boot overlays (t40n-isvp-u-boot.dtsi,
+ * t40xp-isvp-u-boot.dtsi, t40xp-nor-isvp-u-boot.dtsi); each carries its
+ * own binman image (the NOR/NAND layouts differ) but shares these tags.
+ * The boot-media flash@0 node is NOR-only, so its tag lives in the NOR
+ * overlays, not here (the NAND t40xp flash@0 is not an SPL node).
+ */
+&ddr { bootph-all; };
+&cgu { bootph-all; };
+&pinctrl { bootph-all; };
+&gpa { bootph-all; };
+&gpb { bootph-all; };
+&gpc { bootph-all; };
+&gpd { bootph-all; };
+&gpe { bootph-all; };
+&pins_uart1 { bootph-all; };
+&pins_sfc { bootph-all; };
+&pins_mmc0 { bootph-all; };
+&uart1 { bootph-all; };
+&sfc { bootph-all; };
+&msc0 { bootph-all; };
diff --git a/arch/mips/dts/t40-isvp.dtsi b/arch/mips/dts/t40-isvp.dtsi
new file mode 100644
index 00000000..8e7c478c
--- /dev/null
+++ b/arch/mips/dts/t40-isvp.dtsi
@@ -0,0 +1,256 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Ingenic ISVP-T40 board body, shared by every T40 SKU and boot mode.
+ * A per-SKU leaf .dts (t40n-isvp.dts, t40xp-isvp.dts, ...) includes
+ * this file, one boot-media fragment (t40-isvp-nor.dtsi /
+ * t40-isvp-nand.dtsi) for the flash node, and sets the per-SKU
+ * compatible on &ddr.
+ */
+
+#include <dt-bindings/clock/ingenic,t40-cgu.h>
+#include <dt-bindings/gpio/gpio.h>
+
+/ {
+	compatible = "ingenic,t40";
+	#address-cells = <1>;
+	#size-cells = <1>;
+
+	aliases {
+		serial1 = &uart1;
+	};
+
+	chosen {
+		stdout-path = "serial1:115200n8";
+	};
+
+	memory@0 {
+		device_type = "memory";
+		reg = <0x0 0x10000000>;
+	};
+
+	/*
+	 * DDR controller + Innophy PHY. ddr_innophy.c picks the per-SKU
+	 * timing/type table from the &ddr node's compatible (set by the
+	 * leaf .dts).
+	 */
+	ddr: memory-controller@b34f0000 {
+		compatible = "ingenic,t40-ddr-innophy";
+		reg = <0xb34f0000 0x3000>;
+		/* the leaf .dts supplies the per-SKU ingenic,sdram-params array. */
+	};
+
+	cgu: clock-controller@b0000000 {
+		compatible = "ingenic,t40-cgu";
+		reg = <0xb0000000 0x1000>;
+		#clock-cells = <1>;
+	};
+
+	pinctrl: pinctrl@b0010000 {
+		compatible = "ingenic,t40-pinctrl";
+		reg = <0xb0010000 0x8000>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		gpa: gpio@0 {
+			compatible = "ingenic,t40-gpio";
+			reg = <0>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		gpb: gpio@1 {
+			compatible = "ingenic,t40-gpio";
+			reg = <1>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		gpc: gpio@2 {
+			compatible = "ingenic,t40-gpio";
+			reg = <2>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		gpd: gpio@3 {
+			compatible = "ingenic,t40-gpio";
+			reg = <3>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		gpe: gpio@4 {
+			compatible = "ingenic,t40-gpio";
+			reg = <4>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		pins_uart1: uart1 {
+			function = "uart1";
+			groups = "uart1-data";
+		};
+
+		pins_sfc: sfc {
+			function = "sfc";
+			groups = "sfc-data";
+		};
+
+		pins_mac0: mac0 {
+			function = "mac0";
+			groups = "mac0-data";
+		};
+
+		pins_mmc0: mmc0 {
+			function = "mmc0";
+			groups = "mmc0-1bit", "mmc0-4bit";
+		};
+	};
+
+	uart1: serial@b0031000 {
+		compatible = "ingenic,jz4780-uart", "ns16550a";
+		reg = <0xb0031000 0x100>;
+		reg-shift = <2>;
+		clock-frequency = <24000000>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pins_uart1>;
+		status = "okay";
+	};
+
+	/*
+	 * AIC (audio interface controller) + on-chip codec. PIO playback
+	 * driven by U-Boot's `sound` command. T40 has the same B-block
+	 * codec layout as T31 (extended with extra CHR/CMR/CTR regs for
+	 * the 2nd ADC channel; for tone playback we touch only the
+	 * T31-shared subset).
+	 */
+	aic: audio-controller@b0020000 {
+		compatible = "ingenic,t40-aic";
+		clocks = <&cgu T40_CLK_MPLL>;
+		clock-names = "mpll";
+		reg = <0xb0020000 0x100>;
+		#sound-dai-cells = <0>;
+		status = "disabled";
+	};
+
+	codec: audio-codec@b0021000 {
+		compatible = "ingenic,t40-codec";
+		reg = <0xb0021000 0x170>;
+		#sound-dai-cells = <0>;
+		status = "disabled";
+	};
+
+	sound: sound {
+		compatible = "ingenic,t40-sound";
+		status = "disabled";
+
+		cpu {
+			sound-dai = <&aic>;
+		};
+
+		codec {
+			sound-dai = <&codec>;
+		};
+	};
+
+	/*
+	 * TCU (timer/counter unit) container mirroring T31's binding. U-Boot
+	 * only needs the watchdog child for sysreset; the WDT self-clocks
+	 * from the 32 kHz RTC so the TCU clock provider is not required.
+	 */
+	tcu: timer@b0002000 {
+		compatible = "ingenic,t40-tcu", "ingenic,jz4760-tcu",
+			     "simple-mfd";
+		reg = <0xb0002000 0x1000>;
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges = <0x0 0xb0002000 0x1000>;
+
+		watchdog: watchdog@0 {
+			compatible = "ingenic,t40-watchdog",
+				     "ingenic,jz4780-watchdog";
+			reg = <0x0 0x10>;
+		};
+	};
+
+	sfc: spi@b3440000 {
+		compatible = "ingenic,t40-sfc";
+		reg = <0xb3440000 0x10000>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+		clocks = <&cgu T40_CLK_SFC>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pins_sfc>;
+		spi-max-frequency = <50000000>;
+		status = "okay";
+
+		/* flash@0 comes from the boot-media fragment (nor/nand). */
+	};
+
+	msc0: mmc@b3060000 {
+		compatible = "ingenic,t40-mmc";
+		reg = <0xb3060000 0x10000>;
+		clocks = <&cgu T40_CLK_MSC0>;
+		clock-names = "mmc";
+		bus-width = <4>;
+		broken-cd;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pins_mmc0>;
+		status = "okay";
+	};
+
+	gmac0: ethernet@b34b0000 {
+		compatible = "ingenic,t40-gmac";
+		reg = <0xb34b0000 0x2000>;
+		clocks = <&cgu T40_CLK_GMAC0>;
+		phy-mode = "rmii";
+		phy-handle = <&gmac0_phy>;
+		ingenic,mode-reg = <0xb00000e8>;
+		max-speed = <100>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pins_mac0>;
+		status = "okay";
+
+		mdio {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			gmac0_phy: ethernet-phy@0 {
+				reg = <0>;
+			};
+		};
+	};
+
+	/*
+	 * T40 has a single DWC2 USB OTG at 0x13500000 (A1 has three).
+	 */
+	otg0: usb@b3500000 {
+		compatible = "snps,dwc2";
+		reg = <0xb3500000 0x40000>;
+		clocks = <&cgu T40_CLK_OTG0>;
+		dr_mode = "host";
+		/* The T40 DWC2 OTG port comes up with CONIDSTS = 1
+		 * (B-device) even when wired to an A-receptacle, so the
+		 * dwc2 host driver never enables port power and `usb
+		 * start` only enumerates the root hub. hnp-srp-disable
+		 * tells the driver to set GUSBCFG.FORCEHOSTMODE,
+		 * bypassing the ID-pin check. Safe on a host-only port. */
+		hnp-srp-disable;
+		status = "okay";
+	};
+};
+
+&aic {
+	status = "okay";
+};
+
+&codec {
+	status = "okay";
+	/* Speaker-amp enable: SDK default PB31, active-high. Override
+	 * here per board if the amp is on a different pin/polarity. */
+	ingenic,spk-gpio = <&gpb 31 GPIO_ACTIVE_HIGH>;
+};
+
+&sound {
+	status = "okay";
+};
diff --git a/arch/mips/dts/t40n-isvp-dfu-u-boot.dtsi b/arch/mips/dts/t40n-isvp-dfu-u-boot.dtsi
new file mode 100644
index 00000000..09bb4871
--- /dev/null
+++ b/arch/mips/dts/t40n-isvp-dfu-u-boot.dtsi
@@ -0,0 +1,46 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Binman image description for the Ingenic ISVP-T40 DFU loader.
+ *
+ * The USB-boot path uploads spl/u-boot-spl.bin + u-boot.bin directly
+ * via the mask ROM (tools/t31-usbboot.py - the protocol is generic
+ * across XBurst1 and XBurst2), so the binman flash images here are
+ * not used in the USB-boot flow. They are kept consistent with the
+ * production t40-isvp layout (headered SPL at 0, LZMA U-Boot at
+ * 0x8000) so a stray 'make' still produces a sensible flash image.
+ */
+
+#include "t40-isvp-dfu-uboot-common.dtsi"
+
+/ {
+	binman: binman {
+		multiple-images;
+	};
+};
+
+&binman {
+	u-boot-spl-t40 {
+		filename = "u-boot-spl-t40.bin";
+
+		ingenic-t31-spl {
+			filename = "spl/u-boot-spl.bin";
+		};
+	};
+
+	flash {
+		filename = "u-boot-with-spl-lzma.bin";
+		pad-byte = <0xff>;
+
+		spl {
+			type = "blob";
+			offset = <0x0>;
+			filename = "u-boot-spl-t40.bin";
+		};
+
+		u-boot {
+			type = "blob";
+			offset = <0x14000>;
+			filename = "u-boot-lzma.img";
+		};
+	};
+};
diff --git a/arch/mips/dts/t40n-isvp-dfu.dts b/arch/mips/dts/t40n-isvp-dfu.dts
new file mode 100644
index 00000000..79928d41
--- /dev/null
+++ b/arch/mips/dts/t40n-isvp-dfu.dts
@@ -0,0 +1,36 @@
+// SPDX-License-Identifier: GPL-2.0+
+/dts-v1/;
+#include "t40-isvp-dfu.dtsi"
+
+/ {
+	model = "Ingenic ISVP-T40N (DFU loader)";
+};
+
+/* T40N (T40NN): DDR2, 128 MiB. DFU loader.
+ * flash@0 is spi-nand so the NAND stack binds on NAND boards; the loader's
+ * board_late_init() auto-detects NOR vs NAND - on a NOR board the spi-nand
+ * probe fails, the device is unbound, and a SPI-NOR is probed on CS0. */
+&ddr {
+	ingenic,sdram-params = <
+		0x00000004 0x00000001	/* type family */
+		0x00000020 0x08000000 0x00000000	/* bus_width chip0_size chip1_size */
+		0x3b9aca00 0x1dcd6500	/* mpll_hz ddr_hz */
+		0x04c05100 0x07d05900 0x00000000	/* apll mpll vpll _mnod */
+		0x28002825 0x00008092 0x00000000 0x000020f8 0x00002800 0x21f20081	/* cfg ctrl dlmr mmap0 mmap1 refcnt */
+		0x050c0806 0x04060407 0x03080208 0x1e1e1705 0x46000055	/* timing1..5 */
+		0x20000f3c 0x00000000 0x00000001 0x00000001	/* autosr_cnt autosr_en hregpro pregpro */
+		0x11111111 0x00000113	/* cguc0 cguc1 */
+		0x00000011 0x00000007 0x00000005	/* memcfg cl cwl */
+		0x00000f73 0x00002040 0x00004000 0x00006000 0x00000000 0x00000000	/* mr0 mr1 mr2 mr3 mr10 mr63 */
+		0x00000000 0x00000000 0x00000000 0x00000000 0x00000000	/* remap1..5 */
+		0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000	/* par[19] (efuse drive/ODT/skew; 0 on T40) */
+	>;
+};
+
+&sfc {
+	flash@0 {
+		compatible = "spi-nand";
+		reg = <0>;
+		spi-max-frequency = <50000000>;
+	};
+};
diff --git a/arch/mips/dts/t40n-isvp-u-boot.dtsi b/arch/mips/dts/t40n-isvp-u-boot.dtsi
new file mode 100644
index 00000000..a247e6e4
--- /dev/null
+++ b/arch/mips/dts/t40n-isvp-u-boot.dtsi
@@ -0,0 +1,122 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Binman image description for the Ingenic ISVP-T40 SFC-NOR boot.
+ *
+ * Mirrors the A1 binman layout - T40 is the XBurst2 sibling of A1 and
+ * uses the same vendor `0x03040506 / 0x55aa5502 / 0x000000aa` SFC-NOR
+ * boot header at flash offset 0, with LZMA U-Boot at 0x10000 (the SPL
+ * grew past the prior 0x8000 ceiling once DM-in-SPL + UCLASS_RAM
+ * landed; 0x10000 = 64 KiB SPL window matches T41 and stays inside
+ * the vendor BIG_SPL 100 KiB load limit). The bootrom's FUN_bfc02070
+ * Port-A SFC path scans for the 0x55aa5502 marker in the first sector.
+ *
+ * The SPL header is a plain CRC + SPL_LENGTH header (no INGE block).
+ * Earlier T40 builds carried an `ingenic,inge-descriptors` table here
+ * to make the bootrom program APLL/MPLL/CPCCR/SFC before SPL entry -
+ * needed only while the SPL printed pre-PLL debug banners against a
+ * hard-coded baud divisor. With DM-in-SPL the SPL programs its own
+ * clocks in board_init_f before any UART output, so the INGE pre-
+ * programming is redundant: HW-verified 2026-05-28 that T40NN cold-
+ * boots identically with and without it. The etype still supports the
+ * property (tools/binman/etype/ingenic_t31_spl.py) for a vendor-style
+ * SPL that needs clocks set before its own init.
+ *
+ * 'make' produces:
+ *   u-boot-spl-t40.bin       : SPL with the finalized SFC-NOR boot
+ *                              header, bootable standalone.
+ *   u-boot-with-spl-lzma.bin : headered SPL at offset 0 + LZMA U-Boot
+ *                              at 0x10000 - flash at offset 0.
+ */
+
+#include "t40-isvp-uboot-common.dtsi"
+
+/ {
+	binman: binman {
+		multiple-images;
+	};
+};
+
+&binman {
+#if defined(CONFIG_SPL_MMC)
+	/*
+	 * MSC/SD-card boot image (isvp_t40n_msc0). Plain SPL blob with the
+	 * mask-ROM "MSPL" magic from start.S; the ROM defaults the SD load
+	 * to 0x19000, which covers BSS. SPL at SD sector 34 (0x4400); U-Boot
+	 * from SYS_MMCSD_RAW_MODE_U_BOOT_SECTOR (0x100 = byte 0x20000).
+	 */
+	mmc {
+		filename = "u-boot-with-spl-mmc-lzma.bin";
+		pad-byte = <0x00>;
+
+		spl {
+			type = "blob";
+			offset = <0x4400>;
+			filename = "spl/u-boot-spl.bin";
+		};
+
+		u-boot {
+			type = "blob";
+			offset = <0x20000>;
+			filename = "u-boot-lzma.img";
+		};
+	};
+#else
+	u-boot-spl-t40 {
+		filename = "u-boot-spl-t40.bin";
+
+		ingenic-t31-spl {
+			filename = "spl/u-boot-spl.bin";
+
+			/*
+			 * Cold-boot SRAM coverage. The bootrom locks cache lines
+			 * as SRAM only for MIN(SPL_LENGTH, _DAT_80000000) bytes
+			 * starting at CONFIG_SPL_TEXT_BASE. With DM-in-SPL the
+			 * SPL file (~60 KB) ends WELL before our SPL_BSS_START_ADDR
+			 * (0x80014000), so BSS accesses miss the cache-locked
+			 * region and fault on uninitialised DRAM. Tell the etype
+			 * to stamp SPL_LENGTH up to BSS_MAX (= 0x16000 from
+			 * SPL_TEXT_BASE, covering BSS_START_ADDR 0x80014000 +
+			 * BSS_MAX_SIZE 0x2000); the bootrom overloads past file-
+			 * EOF into the U-Boot proper region (junk bytes land in
+			 * BSS area which gets zeroed at SPL startup anyway).
+			 * Empirical: cold-boot SFC NOR is silent without this
+			 * stamp, clean to => prompt with it (verified on T40NN
+			 * 2026-05-28).
+			 */
+			ingenic,min-spl-length = <0x16000>;
+		};
+	};
+
+	flash {
+		filename = "u-boot-with-spl-lzma.bin";
+		pad-byte = <0xff>;
+
+		spl {
+			type = "blob";
+			offset = <0x0>;
+			filename = "u-boot-spl-t40.bin";
+		};
+
+		u-boot {
+			type = "blob";
+			offset = <0x14000>;
+			filename = "u-boot-lzma.img";
+		};
+	};
+#endif
+};
+
+#if defined(CONFIG_SPL_MMC)
+/ {
+	model = "Ingenic ISVP-T40N (MMC0)";
+};
+#endif
+
+/*
+ * The SFC-NOR flash@0 is an SPL node on the NOR boards, so tag it here
+ * (not in t40-isvp-uboot-common.dtsi - the NAND t40xp flash@0 is not an
+ * SPL node). Relocated from t40-isvp-nor.dtsi.
+ */
+&sfc {
+	flash@0 { bootph-all; };
+};
diff --git a/arch/mips/dts/t40n-isvp.dts b/arch/mips/dts/t40n-isvp.dts
