+		if (ret) {
+			dev_err(dev, "failed to add child domain: %s\n",
+				ofnode_get_name(subnode));
+			continue;
+		}
+
+		ret = mtk_scpsys_add_subdomain(dev, subnode);
+		if (ret) {
+			dev_err(dev, "failed to add sub domain: %s\n",
+				ofnode_get_name(subnode));
+			return ret;
+		}
+	}
+
+	return 0;
+}
 
