diff --git a/arch/mips/dts/t10l-isvp.dts b/arch/mips/dts/t10l-isvp.dts
new file mode 100644
index 00000000..5d73e18c
--- /dev/null
+++ b/arch/mips/dts/t10l-isvp.dts
@@ -0,0 +1,80 @@
+// SPDX-License-Identifier: GPL-2.0+
+
+/dts-v1/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include "t10.dtsi"
+
+/ {
+	compatible = "ingenic,isvp-t10", "ingenic,t10";
+	model = "Ingenic ISVP-T10L (SFC NOR)";
+
+	aliases {
+		serial1 = &uart1;
+	};
+
+	chosen {
+		stdout-path = "serial1:115200n8";
+	};
+
+	memory@0 {
+		device_type = "memory";
+		reg = <0x0 0x04000000>;	/* 64 MB DDR2 (T10L) */
+	};
+};
+
+&uart1 {
+	status = "okay";
+};
+
+&sfc {
+	status = "okay";
+
+	flash@0 {
+		compatible = "jedec,spi-nor";
+		reg = <0>;
+		spi-max-frequency = <50000000>;
+	};
+};
+
+&msc0 {
+	status = "okay";
+	bus-width = <4>;
+	broken-cd;	/* no card-detect line wired on the ISVP board */
+};
+
+&otg {
+	status = "okay";
+};
+
+&aic {
+	status = "okay";
+};
+
+&codec {
+	status = "okay";
+	/* Speaker-amp enable: SDK default PB31, active-high. Override
+	 * here per board if the amp is on a different pin/polarity. */
+	ingenic,spk-gpio = <&gpb 31 GPIO_ACTIVE_HIGH>;
+};
+
+&sound {
