+		v &= ~USBPCR_USB_MODE_ORG;
+		v |= USBPCR_VBUSVLDEXTSEL | USBPCR_VBUSVLDEXT |
+		     USBPCR_OTG_DISABLE;
+		writel(v, cpm + CPM_USBPCR);
