+// SPDX-License-Identifier: GPL-2.0+
+/dts-v1/;
+#include "t40-isvp.dtsi"
+#include "t40-isvp-nor.dtsi"
+
+/ {
+	model = "Ingenic ISVP-T40N (SFC NOR)";
+};
+
+/* T40N (lab silkscreen T40NN): DDR2 M14D5121632A, 128 MiB, SFC-NOR. */
+&ddr {
+	ingenic,sdram-params = <
+		0x00000004 0x00000001	/* type family */
+		0x00000020 0x08000000 0x00000000	/* bus_width chip0_size chip1_size */
+		0x3b9aca00 0x1dcd6500	/* mpll_hz ddr_hz */
+		0x04c05100 0x07d05900 0x00000000	/* apll mpll vpll _mnod */
+		0x28002825 0x00008092 0x00000000 0x000020f8 0x00002800 0x21f20081	/* cfg ctrl dlmr mmap0 mmap1 refcnt */
+		0x050c0806 0x04060407 0x03080208 0x1e1e1705 0x46000055	/* timing1..5 */
+		0x20000f3c 0x00000000 0x00000001 0x00000001	/* autosr_cnt autosr_en hregpro pregpro */
+		0x11111111 0x00000113	/* cguc0 cguc1 */
+		0x00000011 0x00000007 0x00000005	/* memcfg cl cwl */
+		0x00000f73 0x00002040 0x00004000 0x00006000 0x00000000 0x00000000	/* mr0 mr1 mr2 mr3 mr10 mr63 */
+		0x00000000 0x00000000 0x00000000 0x00000000 0x00000000	/* remap1..5 */
+		0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000	/* par[19] (efuse drive/ODT/skew; 0 on T40) */
+	>;
+};
diff --git a/arch/mips/dts/t40xp-isvp-dfu-u-boot.dtsi b/arch/mips/dts/t40xp-isvp-dfu-u-boot.dtsi
new file mode 100644
index 00000000..79eeca5e
--- /dev/null
+++ b/arch/mips/dts/t40xp-isvp-dfu-u-boot.dtsi
@@ -0,0 +1,54 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Binman image description for the Ingenic ISVP-T40XP DFU loader.
+ *
+ * The USB-boot path uploads spl/u-boot-spl.bin + u-boot.bin directly
+ * via the mask ROM (tools/t31-usbboot.py); the binman flash image
+ * here is not used. Kept consistent with the SFC-NAND layout
+ * (headered SPL at 0, LZMA U-Boot at 0x80000) so a stray 'make'
+ * still produces a sensible flash image.
+ */
+
+#include "t40-isvp-dfu-uboot-common.dtsi"
+
+/ {
+	binman: binman {
+		multiple-images;
+	};
+};
+
+&binman {
+	u-boot-spl-t40xp {
+		filename = "u-boot-spl-t40xp.bin";
+
+		ingenic-t31-spl {
+			filename = "spl/u-boot-spl.bin";
+			ingenic,no-inge;
+			ingenic,min-spl-length = <0x16000>;
+		};
+	};
+
+	flash {
+		filename = "u-boot-with-spl-lzma.bin";
+		pad-byte = <0xff>;
+
+		spl {
+			type = "blob";
+			offset = <0x0>;
+			filename = "u-boot-spl-t40xp.bin";
+		};
+
+		u-boot {
+			type = "blob";
+			offset = <0x80000>;
+			filename = "u-boot-lzma.img";
+		};
+	};
+};
+
+/* NAND SPL (mach-xburst/t40/sfc_nand.c) reads the flash in SPL, so the
+ * SFC pins must be configured there. Relocated from t40xp-isvp-dfu.dts.
+ */
+&pins_sfc {
+	bootph-all;
+};
diff --git a/arch/mips/dts/t40xp-isvp-dfu.dts b/arch/mips/dts/t40xp-isvp-dfu.dts
new file mode 100644
index 00000000..e09f0493
--- /dev/null
+++ b/arch/mips/dts/t40xp-isvp-dfu.dts
@@ -0,0 +1,33 @@
+// SPDX-License-Identifier: GPL-2.0+
+/dts-v1/;
+#include "t40-isvp-dfu.dtsi"
+
+/ {
+	model = "Ingenic ISVP-T40XP (DFU loader)";
+};
+
+/* T40XP: DDR3, 256 MiB. DFU loader, SFC-NAND target. */
+&ddr {
+	ingenic,sdram-params = <
+		0x00000000 0x00000001	/* type family */
+		0x00000020 0x10000000 0x00000000	/* bus_width chip0_size chip1_size */
+		0x47868c00 0x23c34600	/* mpll_hz ddr_hz */
+		0x05405100 0x06405100 0x00000000	/* apll mpll vpll _mnod */
+		0x2a002a35 0x0000b092 0x00000002 0x000020f0 0x00003000 0x62910083	/* cfg ctrl dlmr mmap0 mmap1 refcnt */
+		0x07110a08 0x0809050b 0x03090409 0x1c201705 0x80057054	/* timing1..5 */
+		0x21001249 0x00000000 0x00000001 0x00000001	/* autosr_cnt autosr_en hregpro pregpro */
+		0x11111111 0x00000113	/* cguc0 cguc1 */
+		0x00000010 0x0000000b 0x00000009	/* memcfg cl cwl */
+		0x00001b70 0x00010042 0x00020018 0x00030000 0x00000000 0x00000000	/* mr0 mr1 mr2 mr3 mr10 mr63 */
+		0x030f0e0d 0x07060504 0x0b0a0908 0x0201000c 0x13121110	/* remap1..5 */
+		0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000	/* par[19] (efuse drive/ODT/skew; 0 on T40) */
+	>;
+};
+
+&sfc {
+	flash@0 {
+		compatible = "spi-nand";
+		reg = <0>;
+		spi-max-frequency = <50000000>;
+	};
+};
diff --git a/arch/mips/dts/t40xp-isvp-u-boot.dtsi b/arch/mips/dts/t40xp-isvp-u-boot.dtsi
new file mode 100644
index 00000000..c750293c
--- /dev/null
+++ b/arch/mips/dts/t40xp-isvp-u-boot.dtsi
@@ -0,0 +1,99 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Binman image description for the Ingenic ISVP-T40XP SFC-NAND boot.
+ *
+ * T40XP uses SPI-NAND (DDR3 256 MiB, vs T40NN's DDR2 NOR + 128 MiB).
+ * The bootrom's NAND boot path expects no INGE block at SPL offset
+ * 0x100 (vendor SPI-NAND SPL ships with all zeros there). Since the
+ * etype now defaults to no-INGE (only emits when
+ * `ingenic,inge-descriptors` is supplied), we simply omit
+ * descriptors. The `ingenic,no-inge` boolean below is retained as
+ * the NAND-style 64-byte block alignment switch (the vendor
+ * `spl_pad_to_block.c` rule for the secure-boot hash module).
+ *
+ * The custom NAND U-Boot loader in arch/mips/mach-xburst/t40/sfc_nand.c
+ * reads the legacy mkimage header + LZMA payload from NAND offset
+ * T40_NAND_UBOOT_OFFSET (0x80000), so keep U-Boot at 0x80000 here.
+ * The 64 KiB SPL window is comfortable for DM-in-SPL builds.
+ *
+ * `ingenic,min-spl-length` covers the BSS region: with DM-in-SPL the
+ * SPL ends before SPL_BSS_START_ADDR + SPL_BSS_MAX_SIZE = 0x80016000,
+ * so we pad the SPL file (with 0xff) to that length, so the bootrom
+ * caches enough SRAM to back BSS during board_init_f.
+ */
+
+#include "t40-isvp-uboot-common.dtsi"
+
+/ {
+	binman: binman {
+		multiple-images;
+	};
+};
+
+&binman {
+#if defined(CONFIG_SPL_MMC)
+	/*
+	 * MSC/SD-card boot image (isvp_t40xp_msc0). The SPL carries the
+	 * mask-ROM "MSPL" magic (start.S, gated on SPL_MMC) at offset 0 and
+	 * is used as a plain blob - no etype, no INGE/min-spl-length: the
+	 * mask ROM defaults the SD load to 0x19000, which already covers
+	 * BSS. The ROM reads the SPL from SD sector 34 (0x4400); the SPL
+	 * loads U-Boot from SYS_MMCSD_RAW_MODE_U_BOOT_SECTOR (0x100 = byte
+	 * 0x20000).
+	 */
+	mmc {
+		filename = "u-boot-with-spl-mmc-lzma.bin";
+		pad-byte = <0x00>;
+
+		spl {
+			type = "blob";
+			offset = <0x4400>;
+			filename = "spl/u-boot-spl.bin";
+		};
+
+		u-boot {
+			type = "blob";
+			offset = <0x20000>;
+			filename = "u-boot-lzma.img";
+		};
+	};
+#else
+	u-boot-spl-t40xp {
+		filename = "u-boot-spl-t40xp.bin";
+
+		ingenic-t31-spl {
+			filename = "spl/u-boot-spl.bin";
+			ingenic,no-inge;
+			ingenic,min-spl-length = <0x16000>;
+		};
+	};
+
+	flash {
+		filename = "u-boot-with-spl-lzma.bin";
+		pad-byte = <0xff>;
+
+		spl {
+			type = "blob";
+			offset = <0x0>;
+			filename = "u-boot-spl-t40xp.bin";
+		};
+
+		u-boot {
+			type = "blob";
+			offset = <0x80000>;
+			filename = "u-boot-lzma.img";
+		};
+	};
+#endif
+};
+
+#if defined(CONFIG_SPL_MMC)
+/ {
+	/*
+	 * The MSC/SD-card boot config (isvp_t40xp_msc0) reuses the SFC-NAND
+	 * board .dts, whose model is annotated "(SFC NAND)". Correct it to
+	 * reflect the actual boot medium.
+	 */
+	model = "Ingenic ISVP-T40XP (MMC0)";
+};
+#endif
diff --git a/arch/mips/dts/t40xp-isvp.dts b/arch/mips/dts/t40xp-isvp.dts
