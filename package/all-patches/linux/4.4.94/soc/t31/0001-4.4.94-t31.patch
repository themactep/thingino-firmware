+static void clk_div_table_generate(void)
+{
+	int i;
+	for (i = 0; i < ARRAY_SIZE(t31_clk_div_table); i++) {
+		t31_clk_div_table[i].val = i;
+		t31_clk_div_table[i].div = (i + 1) * 4;
+	}
+
+}
