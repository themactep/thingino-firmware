diff -ruN --no-dereference '--exclude=.git' common/drivers/misc/logger.c tree-t31/drivers/misc/logger.c
--- common/drivers/misc/logger.c	1969-12-31 19:00:00.000000000 -0500
+++ tree-t31/drivers/misc/logger.c	2026-10-09 03:36:50.707332028 -0400
@@ -0,0 +1,851 @@
+/*
+ * drivers/misc/logger.c
+ *
+ * A Logging Subsystem
+ *
+ * Copyright (C) 2007-2008 Google, Inc.
+ *
+ * Robert Love <rlove@google.com>
+ *
