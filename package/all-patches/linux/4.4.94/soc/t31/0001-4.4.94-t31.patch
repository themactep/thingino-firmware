+struct resource dhd_wlan_resources = {
+	.name	= "bcmdhd_wlan_irq",
+	.start	= 0,
+	.end	= 0,
+	.flags	= IORESOURCE_IRQ | IORESOURCE_IRQ_SHAREABLE |
