+static uint16
+wl_cfgnan_gen_rand_cluster_id(uint16 low_val, uint16 high_val)
+{
+	uint16 random_id;
+	ulong random_seed;
+
+	/* In negative case also, assigning to cluster_high value */
+	if (low_val >= high_val)
+	{
+		random_id = high_val;
+	} else {
+		RANDOM_BYTES(&random_seed, sizeof(random_seed));
+		random_id = (uint16)((random_seed % ((high_val + 1) -
+				low_val)) + low_val);
+	}
+	return random_id;
+}
