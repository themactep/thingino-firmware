+	token = strsep((char**)&pos, " ");
+	if (!token) {
+		ANDROID_ERROR(("flow ID  not provided, using default\n"));
+	} else {
+		val32 = htod32((u32)bcm_atoi(token));
+		if (val32 != -1) {
