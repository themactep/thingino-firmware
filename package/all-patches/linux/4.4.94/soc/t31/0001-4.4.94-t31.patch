+static void
+wl_cfgvendor_apply_cmd_policy(struct wiphy *wiphy)
+{
+	int i;
+	u32 n_cmds = wiphy->n_vendor_commands;
+
+	WL_INFORM(("Apply CMD_RAW_DATA policy\n"));
+	for (i = 0; i < n_cmds; i++) {
+		if (wl_vendor_cmds[i].policy == NULL) {
+			wl_vendor_cmds[i].policy = VENDOR_CMD_RAW_DATA;
+		}
+	}
+}
