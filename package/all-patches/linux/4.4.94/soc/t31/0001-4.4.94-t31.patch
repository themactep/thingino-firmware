+#ifdef DHD_FWTRACE
+void
+dhd_event_logtrace_enqueue_fwtrace(dhd_pub_t *dhdp)
+{
+	dhd_info_t *dhd = (dhd_info_t *) dhdp->info;
+
+	/* Schedule a kernel thread */
+	dhd_schedule_logtrace(dhd);
+
+	return;
+}
