+static bool
+wl_ext_associated(struct net_device *dev)
+{
+	struct ether_addr bssid;
+	int ret = 0;
+
+	ret = wldev_ioctl(dev, WLC_GET_BSSID, &bssid, sizeof(bssid), 0);
+	if (ret != BCME_NOTASSOCIATED && memcmp(&ether_null, &bssid, ETHER_ADDR_LEN)) {
+		return TRUE;
+	}
+
+	return FALSE;
+}
