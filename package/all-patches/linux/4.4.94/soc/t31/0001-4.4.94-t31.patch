+#ifndef _ASM_MXU_H
+#define _ASM_MXU_H
+
+#include <asm/cpu.h>
+#include <asm/cpu-features.h>
+#include <asm/hazards.h>
+#include <asm/mipsregs.h>
+
+#include <mxu_media.h>
+
+static inline void __init_mxu(void)
+{
+	unsigned int register val asm("t0");
+	val = 3;
+	asm volatile(".word	0x7008042f \n\t"::"r"(val));
+}
+
+void __save_mxu(void *);
+void __restore_mxu(void * tsk_void);
+
+static inline void init_mxu(void)
+{
+	if(cpu_has_mxu)
+		__init_mxu();
+}
+
+
+#define save_mxu(tsk)							\
+	do {										\
+		if (cpu_has_mxu)						\
+			__save_mxu(tsk);					\
+	} while (0)
+
+#define restore_mxu(tsk)						\
+	do {										\
+		if (cpu_has_mxu)						\
+			__restore_mxu(tsk);					\
+	} while (0)
+
+#define __get_mxu_regs(tsk)						\
+	({											\
+		if (tsk == current)						\
+			__save_mxu(current);				\
+												\
+		tsk->thread.mxu.regs;					\
+	})
+
+#define __let_mxu_regs(tsk,regs)				\
+	do{											\
+		int i;									\
+		for(i = 0; i < NUM_MXU_REGS;i++)		\
+			tsk->thread.mxu.regs[i] = regs[i];	\
+		if (tsk == current)						\
+			__save_mxu(current);				\
+	}while(0)
+
+#endif /* _ASM_MXU_H */
