+
+#endif	/* #ifdef __KERNEL__ */
+
+///////////////////////////////////////////
+
+/* Data Format Register, export to libipu */
+#define RGB_888_OUT_FMT				( 1 << 25 )
+
+#define RGB_OUT_OFT_BIT				( 22 )
