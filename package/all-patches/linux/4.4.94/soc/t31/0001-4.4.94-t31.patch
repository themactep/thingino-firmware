diff -ruN --no-dereference '--exclude=.git' common/drivers/clocksource/ingenic_core_ost.c tree-t31/drivers/clocksource/ingenic_core_ost.c
--- common/drivers/clocksource/ingenic_core_ost.c	1969-12-31 19:00:00.000000000 -0500
+++ tree-t31/drivers/clocksource/ingenic_core_ost.c	2026-10-09 03:36:50.314852209 -0400
@@ -0,0 +1,560 @@
