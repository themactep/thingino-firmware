+/*
+ * LOGTRACEINFO = .logtrace.info
+ *  - logtrace = 1            => Enable LOGTRACE Event
+ *  - logtrace = 0            => Disable LOGTRACE Event
+ *  - file not exist          => Disable LOGTRACE Event
+ */
+int dhd_logtrace_from_file(dhd_pub_t *dhd)
+{
+#ifndef DHD_EXPORT_CNTL_FILE
+	struct file *fp = NULL;
+	int ret = -1;
+	uint32 logtrace = 0;
