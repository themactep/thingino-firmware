+#define ASCR_DECE(m)  ((m) << 4)
+
+
+#define ASCR_AESS     (1 << 3)
+#define ASCR_KEYS     (1 << 2)
+#define ASCR_INIT_IV  (1 << 1)
+#define ASCR_EN       (1 << 0)
