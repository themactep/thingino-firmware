diff -ruN --no-dereference '--exclude=.git' common/drivers/mtd/devices/Kconfig tree-t31/drivers/mtd/devices/Kconfig
--- common/drivers/mtd/devices/Kconfig	2026-10-09 03:37:13.152763198 -0400
+++ tree-t31/drivers/mtd/devices/Kconfig	2026-10-09 03:36:50.722637473 -0400
@@ -233,4 +233,53 @@
 	default 4
 endif
 
+config INGENIC_SFC
+	tristate "Ingenic series SFC driver"
+	depends on MACH_XBURST || MACH_XBURST2
+	help
+		SFC driver for Ingenic series SoCs
+
+if INGENIC_SFC
+
+choice
+	prompt "the SFC external memory (nor or nand)"
+	help
+	  Select the SFC external memory
+
+config MTD_INGENIC_SFC_NORFLASH
+	bool "Support ingenic sfc-nor"
+	depends on INGENIC_SFC
+
+config MTD_INGENIC_SFC_NANDFLASH
+	bool "Support ingenic sfc-nand"
+	depends on INGENIC_SFC
+
+endchoice
+
+choice
+	prompt "sfc Mode"
+	help
+	  Select sfc Mode
+
+config SPI_STANDARD_MODE
+	bool "standard spi mode"
+	depends on INGENIC_SFC
+	help
+	  Say Y here to enable spi standard mode
+
+config SPI_QUAD_MODE
+	bool "quad spi mode"
+	depends on INGENIC_SFC
+	help
+	  Say Y Here to enable spi QUAD MODE
+endchoice
+
+config SFC_NOR_INTERFACE_USE
+	bool "Ingenic JZ SFC nor interface use"
+	depends on MTD_INGENIC_SFC_NORFLASH
+	help
+		You can directly use the read and write norfalsh related interfaces in the kernel space
+
+endif
+
 endmenu
