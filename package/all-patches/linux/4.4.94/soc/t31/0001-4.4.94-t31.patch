+	DHD_IF_TYPE_P2P_DISC	= 7,
+	DHD_IF_TYPE_IBSS	= 8,
+	DHD_IF_TYPE_MONITOR	= 9,
+	DHD_IF_TYPE_AIBSS	= 10,
+	DHD_IF_TYPE_MAX
+} dhd_iftype_t;
+
+typedef struct dhd_iface_mgmt_data {
+	uint8 policy;
+	uint8 priority[DHD_IF_TYPE_MAX];
+} dhd_iface_mgmt_data_t;
+
+typedef enum dhd_iface_mgmt_policy {
