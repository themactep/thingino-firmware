diff -ruN --no-dereference '--exclude=.git' common/drivers/watchdog/ingenic_wdt.c tree-t31/drivers/watchdog/ingenic_wdt.c
--- common/drivers/watchdog/ingenic_wdt.c	1969-12-31 19:00:00.000000000 -0500
+++ tree-t31/drivers/watchdog/ingenic_wdt.c	2026-10-09 03:36:51.451071657 -0400
@@ -0,0 +1,580 @@
