+static int
+wl_mesh_escan_attach(dhd_pub_t *dhd, struct wl_if_info *mesh_if)
+{
+	IAPSTA_TRACE(mesh_if->dev->name, "Enter\n");
+
+	mesh_if->escan = dhd->escan;
+	wl_timer_register(mesh_if->dev, &mesh_if->delay_scan, wl_mesh_timer);
+
+	return 0;
+}
