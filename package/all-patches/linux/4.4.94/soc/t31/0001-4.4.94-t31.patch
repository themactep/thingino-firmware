+static __maybe_unused int writeback_align_address(struct l2c_test_thread *data)
+{
+	unsigned char *src;
+	unsigned char *src_org;
+	unsigned char *p;
+	unsigned char *unc_p;
+	int i,j;
+	src_org = (unsigned char*)kmalloc(L2C_LINESIZE * 4,GFP_KERNEL);
