+static void dump_desc(struct ingenicfb_device *fbdev)
+{
+	int i, j;
+	for(i = 0; i < CONFIG_FB_INGENIC_NR_FRAMES*2; i++) {
+		for(j = 0; j < DPU_SUPPORT_MAX_LAYERS; j++) {
+			dump_layer_desc(fbdev->layerdesc[i][j], i, j);
+		}
+		dump_frm_desc(fbdev->framedesc[i], i);
+	}
