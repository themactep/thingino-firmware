+/* SSI Interval Time Control Register (SSI_ITR) */
+#define	ITR_CNTCLK		(1 << 15)
+#define ITR_IVLTM_BIT		0
+#define ITR_IVLTM_MASK		(0x7fff << ITR_IVLTM_BIT)
+
+
+
+#define R_MODE			0x1
+#define W_MODE			0x2
+#define RW_MODE			(R_MODE | W_MODE)
