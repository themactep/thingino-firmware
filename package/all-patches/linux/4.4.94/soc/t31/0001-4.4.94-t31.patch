+		case BCM4376_CHIP_GRPID :
+		case BCM4378_CHIP_GRPID :
+			{
+				if (!gci_gpio) {
+					chipcontrol = (1 << GCI_GPIO_CHIPCTRL_ENAB_EXT_GPIO_BIT);
