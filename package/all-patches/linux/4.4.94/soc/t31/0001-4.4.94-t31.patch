+		*((uint32 *)dst + 2) = *((uint32 *)src + 2); \
+		*((uint32 *)dst + 3) = *((uint32 *)src + 3); \
+		*((uint32 *)dst + 4) = *((uint32 *)src + 4); \
+		*(uint16 *)((uint32 *)dst + 5) = *(uint16 *)((uint32 *)src + 5); \
+	} while (0)
