+int wl_android_exit(void)
+{
+	int ret = 0;
+	struct io_cfg *cur, *q;
+
+#ifdef WL_GENL
+	wl_genl_deinit();
+#endif /* WL_GENL */
+#ifdef WL_RELMCAST
+	wl_netlink_deinit();
+#endif /* WL_RELMCAST */
+
+	GCC_DIAGNOSTIC_PUSH_SUPPRESS_CAST();
+	list_for_each_entry_safe(cur, q, &miracast_resume_list, list) {
+		GCC_DIAGNOSTIC_POP();
+		list_del(&cur->list);
+		kfree(cur);
+	}
+
+	return ret;
+}
