+void
+dhdpcie_induce_cbp_hang(dhd_pub_t *dhd)
+{
+	uint32 addr, val;
+	uint32 apb2_wrapper_reg = 0x18106000;
+	uint32 apb2_reset_ctrl_offset = 0x800;
+	addr = apb2_wrapper_reg + apb2_reset_ctrl_offset;
+	val = 1;
+	dhd_sbreg_op(dhd, addr, &val, FALSE);
+}
