--- common/arch/mips/xburst/soc-x1000/pm.c	1969-12-31 19:00:00.000000000 -0500
+++ tree-t31/arch/mips/xburst/soc-x1000/pm.c	2026-10-09 03:36:50.060784532 -0400
@@ -0,0 +1,217 @@
+/*
+ * linux/arch/mips/xburst/soc-m200/common/pm_p0.c
+ *
+ *  M200 Power Management Routines
+ *  Copyright (C) 2006 - 2012 Ingenic Semiconductor Inc.
+ *
