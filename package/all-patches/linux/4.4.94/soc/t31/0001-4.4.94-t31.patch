+#define U_IOBASE (UART0_IOBASE + 0xa0000000)
+#define TCSM_PCHAR(x)                                                   \
+	*((volatile unsigned int*)(U_IOBASE+OFF_TDR)) = x;              \
+while ((*((volatile unsigned int*)(U_IOBASE + OFF_LSR)) & (LSR_TDRQ | LSR_TEMT)) != (LSR_TDRQ | LSR_TEMT))
+#else
