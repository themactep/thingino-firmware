diff -ruN --no-dereference '--exclude=.git' common/arch/mips/xburst2/common/cpu_ddr_test/cpu_watch_test.c tree-t31/arch/mips/xburst2/common/cpu_ddr_test/cpu_watch_test.c
--- common/arch/mips/xburst2/common/cpu_ddr_test/cpu_watch_test.c	1969-12-31 19:00:00.000000000 -0500
+++ tree-t31/arch/mips/xburst2/common/cpu_ddr_test/cpu_watch_test.c	2026-10-09 03:36:50.061361428 -0400
@@ -0,0 +1,200 @@
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/err.h>
+#include <linux/module.h>
+#include <linux/slab.h>
+#include <linux/irq.h>
+#include <linux/interrupt.h>
+#include <linux/delay.h>
+#include <linux/random.h>
+#include <linux/syscore_ops.h>
+#include <linux/debugfs.h>
