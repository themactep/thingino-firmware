+static int ingenic_mdio_phy_read(struct net_device *dev, int phy_id, int location)
+{
+	struct ingenic_mac_local *lp = netdev_priv(dev);
+	return ingenic_mdiobus_read(lp->mii_bus, phy_id, location);
+}
