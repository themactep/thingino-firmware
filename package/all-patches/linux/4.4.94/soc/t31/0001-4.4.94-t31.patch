+static int
+wl_android_ch_res_rl(struct net_device *dev, bool change)
+{
+	int error = 0;
+	s32 srl = 7;
+	s32 lrl = 4;
+	ANDROID_ERROR(("wl_android_ch_res_rl: enter\n"));
+	if (change) {
