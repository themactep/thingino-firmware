+	} else if (svc_inst_id) {
+		for (i = 0; i < NAN_MAX_SVC_INST; i++) {
+			if (nancfg->svc_info[i].svc_id == svc_inst_id) {
+				return &nancfg->svc_info[i];
+			}
+		}
+
+	}
