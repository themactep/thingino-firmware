+	DHD_IF_POLICY_FCFS		= 1,
+	DHD_IF_POLICY_LP		= 2,
+	DHD_IF_POLICY_ROLE_PRIORITY	= 3,
+	DHD_IF_POLICY_CUSTOM		= 4,
+	DHD_IF_POLICY_INVALID		= 5
+} dhd_iface_mgmt_policy_t;
