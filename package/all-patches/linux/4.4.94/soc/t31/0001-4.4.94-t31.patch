+int wl_cfg80211_scan_stop(struct bcm_cfg80211 *cfg, bcm_struct_cfgdev *cfgdev)
+{
+	int ret = 0;
+
+	WL_TRACE(("Enter\n"));
+
+	if (!cfg || !cfgdev) {
+		return -EINVAL;
+	}
+
+	/* cancel scan and notify scan status */
+	wl_cfgscan_cancel_scan(cfg);
+
+	return ret;
