+static void
+wl_mesh_escan_detach(dhd_pub_t *dhd, struct wl_if_info *mesh_if)
+{
+	IAPSTA_TRACE(mesh_if->dev->name, "Enter\n");
+	wl_timer_deregister(mesh_if->dev, &mesh_if->delay_scan);
+	if (mesh_if->escan) {
+		mesh_if->escan = NULL;
+	}
