+#define IEEE80211_RADIOTAP_MCS_BW_MASK          0x03
+#define IEEE80211_RADIOTAP_MCS_BW_20		0
+#define IEEE80211_RADIOTAP_MCS_BW_40		1
+#define IEEE80211_RADIOTAP_MCS_BW_20L		2
