+#ifndef CONFIG_I2C_INGENICV10_WAIT_MS
+#define DEF_INGENIC_I2C_WAIT_TIMEOUT_MS (1000)
+#else
+#define DEF_INGENIC_I2C_WAIT_TIMEOUT_MS (CONFIG_I2C_INGENICV10_WAIT_MS)
+#endif
