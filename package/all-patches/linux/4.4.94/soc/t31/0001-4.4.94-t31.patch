+		bcm_bprintf(b, " clk_ctl_st: 0x%x\n", psmwd->i32_clk_ctl_st);
+		if (psmwd->version == 1) {
+			dump_psmwd_v1(tlv, b);
+		}
+		if (psmwd->version == 2) {
+			dump_psmwd_v2(tlv, b);
+		}
+	}
+/* PHY TxErr MacDump */
+	tlv = bcm_parse_tlvs(hdr->data, hdr->len, TAG_TRAP_PHYTXERR_THRESH);
