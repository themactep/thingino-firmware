+			len, write, 0, NULL, NULL);
+	vma->vm_page_prot = __pgprot(vm_page_prot);
+	if (ret < 0) {
+		printk("dmmu_make_present get_user_pages error(%d). addr=%lx len=%lx\n",0-ret,addr,end-addr);
+		return ret;
