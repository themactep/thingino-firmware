+
+	/* Invalid public key length */
+	BCM_CRYPTO_E_ASN1_INVALID_PKLEN		= -7172,
+
+	/* Unsupported elliptic curve group */
+	BCM_CRYPTO_E_ASN1_UNSUPPORTED_ECG	= -7173
+};
+
+#endif	/* BCMUTILS_ERR_CODES */
+
+#endif	/* _bcmerror_h_ */
