+static void sfc_threshold(struct sfc *sfc, uint32_t value)
+{
+	uint32_t tmp = sfc_readl(sfc, SFC_GLB0);
+	tmp &= ~GLB0_THRESHOLD_MSK;
+	tmp |= value << GLB0_THRESHOLD_OFFSET;
+	sfc_writel(sfc, SFC_GLB0, tmp);
+}
