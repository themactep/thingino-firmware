+		bcopy(&int_val, arg, val_size);
+		break;
+
+#if defined(DHD_HTPUT_TUNABLES)
+	case IOV_SVAL(IOV_H2D_HTPUT_TXPOST_MAX_ITEM):
+		if (bus->dhd->busstate != DHD_BUS_DOWN) {
+			DHD_ERROR(("%s: Can change only when bus down (before FW download)\n",
