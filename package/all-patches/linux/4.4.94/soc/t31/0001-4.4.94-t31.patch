+#define BCM_TS_MAGIC	0xB055B055
+#define BCM_TS_MAGIC_V2	0xB055B056
+#define BCM_TS_TX	 1u
+#define BCM_TS_RX	 2u
+#define BCM_TS_UTX	 3u /* ucode tx timestamps */
