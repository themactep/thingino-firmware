+	mfc0	k1,CP0_CONFIG3
+	sw	k1,84(k0)
+	mfc0	k1,CP0_CONFIG7
+	sw	k1,88(k0)
+	mfc0	k1,CP0_LLADDR
+	sw	k1,92(k0)
+	mfc0	k1,PMON_CSR
+	sw	k1,96(k0)
+	mfc0	k1,PMON_HIGH
+	sw	k1,100(k0)
+	mfc0	k1,PMON_LC
+	sw	k1,104(k0)
+	mfc0	k1,PMON_RC
