+						varbuf_append(&b, vstr_pdatah,
+							(cis[i + (j*12) + 12] << 24) |
+							(cis[i + (j*12) + 11] << 16) |
+							(cis[i + (j*12) + 10] << 8) |
+							cis[i + (j*12) + 9]);
