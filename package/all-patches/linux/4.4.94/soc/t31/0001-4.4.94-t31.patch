+static int badblk_check(int len, unsigned char *buf)
+{
+	int  j;
+	unsigned char *check_buf = buf;
+
+	for(j = 0; j < len; j++){
+		if(check_buf[j] != 0xff){
+			return 1;
+		}
+	}
+	return 0;
+}
