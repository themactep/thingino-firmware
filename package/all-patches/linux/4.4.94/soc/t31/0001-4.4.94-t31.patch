+static int ingenicfb_blank(int blank_mode, struct fb_info *info)
+{
+	struct ingenicfb_device *fbdev = info->par;
+
+	if (blank_mode == FB_BLANK_UNBLANK) {
+		ingenicfb_do_resume(fbdev);
+	} else {
+		ingenicfb_do_suspend(fbdev);
+	}
+
+	return 0;
+}
