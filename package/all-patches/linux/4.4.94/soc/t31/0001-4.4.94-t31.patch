+  } while (0)
+
+#define S32MSUBU(xra,xrd,rs,rt)	\
+  do { 	\
+    __asm__ __volatile ("S32MSUBU xr%0,xr%1,%z2,%z3"	\
+			: 		\
+ 	        :"K"(xra),"K"(xrd),"d" (rs),"d"(rt));\
+  } while (0)
+
+#endif /*_MXU_H_*/
