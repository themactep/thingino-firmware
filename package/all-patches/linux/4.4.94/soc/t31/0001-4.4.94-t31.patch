+static int panel_resume(struct mipi_dsim_lcd_device *dsim_dev)
+{
+	struct board_gpio *vdd_en = &panel->vdd_en;
+
+	gpio_direction_output(vdd_en->gpio, vdd_en->active_level);
+
+	return 0;
+}
