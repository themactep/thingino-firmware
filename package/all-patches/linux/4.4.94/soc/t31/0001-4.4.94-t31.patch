+static const char *ingenic_pinmux_get_function_name(struct pinctrl_dev *pctldev,
+		unsigned selector)
+{
+	struct ingenic_pinctrl *pctl = pinctrl_dev_get_drvdata(pctldev);
+	return pctl->functions[selector].name;
+}
