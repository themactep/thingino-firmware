+		if (dhd->conf->chip == BCM4359_CHIP_ID) {
+			struct file *fp;
+			// compatible for AP6398S and AP6398SA
+			fp = dhd_filp_open(nv_path, O_RDONLY, 0);
+			if (IS_ERR(fp) || (fp == NULL)) {
