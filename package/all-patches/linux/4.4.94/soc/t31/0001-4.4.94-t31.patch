+static uint8
+BCMATTACHFN(fastlpo_dis_get)(void)
+{
+	uint8 fastlpo_dis = 1;
+
+#if defined(BCM_FASTLPO_PMU) && !defined(BCM_FASTLPO_PMU_DISABLED)
+	if (FASTLPO_ENAB()) {
+		fastlpo_dis = 0;
+		if (getvar(NULL, rstr_fastlpo_dis) != NULL) {
+			fastlpo_dis = (uint8)getintvar(NULL, rstr_fastlpo_dis);
+		}
+	}
+#endif  /* BCM_FASTLPO_PMU */
+	return fastlpo_dis;
+}
