+	sub_cmd->len = sizeof(sub_cmd->u.options) + sizeof(uint8);
+	sub_cmd->u.options = htol32(BCM_XTLV_OPTION_ALIGN32);
+	ret = memcpy_s(sub_cmd->data, sizeof(uint8),
+			(uint8*)&val, sizeof(uint8));
+	if (ret != BCME_OK) {
+		WL_ERR(("Failed to copy enab value\n"));
