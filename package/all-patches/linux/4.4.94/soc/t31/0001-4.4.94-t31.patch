+static int wl_android_bandstr_to_fwband(char *band, u8 *fw_band)
+{
+	int err = BCME_OK;
+
+	if (!strcasecmp(band, "a")) {
+		*fw_band = WLC_BAND_5G;
+	} else if (!strcasecmp(band, "b")) {
+		*fw_band = WLC_BAND_2G;
+#ifdef WL_6G_BAND
+	} else if (!strcasecmp(band, "6g")) {
+		*fw_band = WLC_BAND_6G;
+#endif /* WL_6G_BAND */
+	} else if (!strcasecmp(band, "all")) {
+		*fw_band = WLC_BAND_ALL;
+	} else {
+		err = BCME_BADBAND;
+	}
+
+	return err;
+}
