+BCMPOSTTRAPFN(vsprintf)(char *buf, const char *fmt, va_list ap)
+{
+	if (FWSIGN_ENAB()) {
+		return 0;
+	}
+	return (vsnprintf(buf, INT_MAX, fmt, ap));
