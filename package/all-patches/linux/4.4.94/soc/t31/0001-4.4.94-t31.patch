+#ifdef BTLOG
+/** called on MSG_TYPE_BT_LOG_CMPLT message received from dongle */
+static void
+BCMFASTPATH(dhd_prot_process_btlog_complete)(dhd_pub_t *dhd, void* buf)
+{
+	info_buf_resp_t *resp;
