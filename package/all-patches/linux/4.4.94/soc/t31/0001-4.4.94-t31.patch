+dhd_bus_db0_addr_2_get(struct dhd_bus *bus)
+{
+	return ((DAR_ACTIVE(bus->dhd)) ? DAR_PCIH2D_DB2_0(bus->sih->buscorerev) : PCIH2D_MailBox_2);
+}
