+	}
+	ASSERT(pmu != NULL);
+
+	AND_REG(osh, &pmu->pmuintmask0, ~PMU_INT_STAT_TIMER_INT_MASK);
+
+	/* Return to original core */
+	si_setcoreidx(sih, origidx);
