+		pwdn-gpios	= <&gpe 4 GPIO_ACTIVE_HIGH INGENIC_GPIO_NOBIAS>;
+		vcc-en-gpios	= <&gpe 3 GPIO_ACTIVE_HIGH INGENIC_GPIO_NOBIAS>;
