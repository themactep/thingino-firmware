+static void clk_div_table_generate(void)
+{
+	int i;
+	for (i = 0; i < ARRAY_SIZE(x2000_clk_div_table); i++) {
+		x2000_clk_div_table[i].val = i;
+		x2000_clk_div_table[i].div = (i + 1) * 4;
+	}
+
+}
