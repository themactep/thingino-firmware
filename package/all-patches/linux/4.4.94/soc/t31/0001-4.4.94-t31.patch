+		for (i = 0; i < NAN_MAX_SVC_INST; i++) {
+			for (j = 0; j < NAN_MAX_SVC_INST; j++) {
+				if (nancfg->svc_info[i].ndp_id[j] == ndp_id) {
+					return &nancfg->svc_info[i];
+				}
