+/* EHT EVEVNT_LOG_TAG */
+#define EVENT_LOG_TAG_WL_EHT_INFO		381
+#define EVENT_LOG_TAG_WL_EHT_TRACE		382
+#define EVENT_LOG_TAG_WL_EHT_WARN		383
