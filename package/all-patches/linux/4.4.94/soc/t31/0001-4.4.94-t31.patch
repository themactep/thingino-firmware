+			if (on) {
+				si_corereg(sih, coreidx, LHL_REG_OFF(lhl_lp_main_ctl1_adr),
+						BCM_MASK32(23, 0), 0x9E9F9F);
+			} else {
+				si_corereg(sih, coreidx, LHL_REG_OFF(lhl_lp_main_ctl1_adr),
+						BCM_MASK32(23, 0), 0x9E9F97);
