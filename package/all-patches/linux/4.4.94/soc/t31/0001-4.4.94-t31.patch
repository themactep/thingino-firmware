+void
+dhd_prot_clearcounts(dhd_pub_t *dhd)
+{
+	dhd_prot_t *prot = dhd->prot;
+#ifdef AGG_H2D_DB
+	agg_h2d_db_info_t *agg_db_info = &prot->agg_h2d_db_info;
+	if (agg_db_info->inflight_histo) {
+		memset(agg_db_info->inflight_histo, 0, DHD_INFLIGHT_HISTO_SIZE);
