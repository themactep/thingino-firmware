+static void clk_div_table_generate(void)
+{
+	int i;
+	for (i = 0; i < ARRAY_SIZE(c100_clk_div_table); i++) {
+		c100_clk_div_table[i].val = i;
+		c100_clk_div_table[i].div = (i + 1) * 2;
+	}
+
+}
