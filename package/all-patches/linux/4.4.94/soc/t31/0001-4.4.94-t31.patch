+/*-------------------------------------------------------------------------*/
+
+static struct usb_function *f_acm;
+static struct usb_function_instance *fi_serial;
+/*
+ * We _always_ have both CDC ECM and CDC ACM functions.
+ */
+int  ucam_bind_acm(struct usb_configuration *c)
+{
+	int	status;
+
+	/*
+	 *if (gadget_is_otg(c->cdev->gadget)) {
+	 *        c->descriptors = otg_desc;
+	 *        c->bmAttributes |= USB_CONFIG_ATT_WAKEUP;
+	 *}
+	 */
+
+	/**********************ACM*************/
+	fi_serial=usb_get_function_instance("acm");
+	if (IS_ERR(fi_serial))
+		return PTR_ERR(fi_serial);
+
+	f_acm = usb_get_function(fi_serial);
+	if (IS_ERR(f_acm)) {
+		status = PTR_ERR(f_acm);
+		goto err_acm_func;
+	}
+
+	status = usb_add_function(c, f_acm);
+	if (status)
+		goto err_acm_conf;
+
+	return 0;
+
+
+err_acm_conf:
+	usb_put_function(f_acm);
+
+err_acm_func:
+	usb_put_function_instance(fi_serial);
+
+	return status;
+}
+EXPORT_SYMBOL(ucam_bind_acm);
+
+int  acm_cleanup(void)
+{
+	usb_put_function(f_acm);
+	usb_put_function_instance(fi_serial);
+
+	return 0;
+}
+EXPORT_SYMBOL(acm_cleanup);
+
+int acm_mod_init(void)
+{
+	int ret = -1;
+	ret =  userial_init();
+	if(ret)
+		printk("userial_init if false\n");
+
+	return usb_function_register(&acmusb_func);
+}
+EXPORT_SYMBOL(acm_mod_init);
+
+void  acm_mod_exit(void)
+{
+	return usb_function_unregister(&acmusb_func);
+}
