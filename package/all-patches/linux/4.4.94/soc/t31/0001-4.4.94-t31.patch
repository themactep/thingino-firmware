+	uint32	tcamcmdreg;		/* 0x70 */
+	uint32	tcamdatareg;		/* 0x74 */
+	uint32	tcambankxmaskreg;	/* 0x78 */
+	uint32	PAD[5];
+	uint32  mpucontrol;		/* 0x90 */
+	uint32  mpucapabilities;	/* 0x94 */
