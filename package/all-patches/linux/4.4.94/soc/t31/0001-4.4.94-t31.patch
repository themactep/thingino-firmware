+static void reg_bit_set(struct jz_ipu *ipu, int offset, unsigned int bit)
+{
+	unsigned int reg = 0;
+	reg = ipu_reg_read(ipu, offset);
+	reg |= bit;
+	ipu_reg_write(ipu, offset, reg);
+}
+
+static void reg_bit_clr(struct jz_ipu *ipu, int offset, unsigned int bit)
+{
+	unsigned int reg = 0;
+	reg= ipu_reg_read(ipu, offset);
+	reg &= ~(bit);
+	ipu_reg_write(ipu, offset, reg);
+}
