+	char *ptr;
+#ifdef ROAM_ENABLE
+	uint roamvar = 0;
+#ifdef ROAM_AP_ENV_DETECTION
+	int roam_env_mode = 0;
+#endif /* ROAM_AP_ENV_DETECTION */
