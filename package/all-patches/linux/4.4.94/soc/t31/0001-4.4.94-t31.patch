+			ANDROID_INFO(("wl_android_set_suspendopt: Suspend Flag %d -> %d\n",
+				ret_now, suspend_flag));
+		} else {
+			ANDROID_ERROR(("wl_android_set_suspendopt: failed %d\n", ret));
+		}
+	}
+
+	return ret;
+}
