+vsync_skip_r(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct ingenicfb_device *fbdev = dev_get_drvdata(dev);
+	mutex_lock(&fbdev->lock);
+	snprintf(buf, 3, "%d\n", fbdev->vsync_skip_ratio);
