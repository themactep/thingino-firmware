+				chipcontrol |= (1 << GCI_GPIO_CHIPCTRL_INVERT_BIT);
+				si_gci_gpio_chipcontrol(sih, gpio_n,
+					(chipcontrol | (1 << GCI_GPIO_CHIPCTRL_ENAB_IN_BIT)));
+
