+						varbuf_append(&b, vstr_paddr,
+							(cis[i + (j*12) + 4] << 24) |
+							(cis[i + (j*12) + 3] << 16) |
+							(cis[i + (j*12) + 2] << 8) |
+							cis[i + (j*12) + 1]);
+
+						varbuf_append(&b, vstr_pdatal,
+							(cis[i + (j*12) + 8] << 24) |
+							(cis[i + (j*12) + 7] << 16) |
