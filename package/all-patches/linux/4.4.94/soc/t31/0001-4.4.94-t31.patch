+{
+	return uvc2_alloc_callback(fi);
+}
+#endif
+
+DECLARE_USB_FUNCTION_INIT(uvc, uvc_alloc_inst, uvc_alloc);
+#ifdef CONFIG_DUAL_VIDEO
+DECLARE_USB_FUNCTION_INIT(uvc2, uvc2_alloc_inst, uvc2_alloc);
+#endif
+MODULE_LICENSE("GPL");
+MODULE_AUTHOR("Laurent Pinchart");
