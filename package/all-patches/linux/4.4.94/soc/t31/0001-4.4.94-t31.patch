+	uint type;   /**< tx/rx type */
+	uint flowid; /**< 5 tuple checksum */
+	uint prec; /**< ip precedence (IP_PREC) */
+	uint8 xbytes[16]; /**< 16bytes info from pkt offset */
+} bcm_to_info_hdr_t;
+
+/* Firmware tx timestamp payload structure */
+typedef struct bcm_to_info_tx_ts {
