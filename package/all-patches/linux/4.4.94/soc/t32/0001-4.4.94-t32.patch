+
+	if (soc_vpu_release(sc, &cnode) < 0) {
+		ret = -1;
+		dev_err(sc->mdev.this_device, "[fun:%s,line:%d] release vpu failed\n", __func__, __LINE__);
+		goto err_vpu_release_vpu;
