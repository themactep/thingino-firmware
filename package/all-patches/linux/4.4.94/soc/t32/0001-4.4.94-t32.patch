+	printk("PWM_BUSY  addr %08x  = %08x\n", (unsigned int)(ingenic_pwm->iomem + PWM_BUSY),pwm_readl(ingenic_pwm, PWM_BUSY));
+	for(i = 0; i < 16; i++) {
