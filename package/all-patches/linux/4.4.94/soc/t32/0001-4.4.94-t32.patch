-	doc_setup_addr_sector(docg3, sector);
-	doc_delay(docg3, 1);
-
-	doc_flash_command(docg3, DOC_CMD_ERASECYCLE2);
-	doc_delay(docg3, 2);
-
-	if (is_prot_seq_error(docg3)) {
-		doc_err("Erase blocks %d,%d error\n", block0, block1);
