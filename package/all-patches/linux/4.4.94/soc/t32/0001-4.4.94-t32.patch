+	bus-width = <8>;
+	non-removable;
+	pinctrl-0 = <&msc0_8bit_low>,<&msc0_8bit_high>;
+	ingenic,poc-v1.8;*/
+
+	/*mmc-hs400-1_8v;
+	bus-width = <8>;
+	non-removable;
+	pinctrl-0 = <&msc0_8bit_low>,<&msc0_8bit_high>,<&msc0_ds>;
+	ingenic,poc-v1.8;*/
+
+	//pio-mode;
+};
+
+&msc1 {
+	status = "disable";
+	pinctrl-names = "default", "active";
+	/*mmc-hs200-1_8v;*/
+	cap-mmc-highspeed;
+	max-frequency = <50000000>;
+	bus-width = <4>;
+	voltage-ranges = <1800 3300>;
+	non-removable;
+
+	/* special property */
+	ingenic,wp-gpios = <0>;
+	ingenic,rst-gpios = <0>;
+	pinctrl-0 = <&msc1_pc_lolvl>;
+	pinctrl-1 = <&msc1_pc_func>;
+};
+
+&mac0 {
+	pinctrl-names = "default", "reset";
+	pinctrl-0 = <&mac0_rmii_p0_normal>, <&mac0_rmii_p1_normal>;
+	pinctrl-1 = <&mac0_rmii_p0_rst>, <&mac0_rmii_p1_normal>;
+	status = "okay";
+	ingenic,rst-gpio = <&gpb 26 GPIO_ACTIVE_LOW INGENIC_GPIO_NOBIAS>;
+	ingenic,rst-ms = <10>;
+	ingenic,mac-mode = <RMII>;
+	ingenic,mode-reg = <0xb00000e8>;
+	ingenic,phy-clk-freq = <25000000>;
+};
+
