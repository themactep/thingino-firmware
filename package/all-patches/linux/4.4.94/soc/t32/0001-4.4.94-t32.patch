+static ssize_t audio_aic_debug_write(struct file *file, const char __user *user_buffer, size_t count, loff_t *ppos)
+{
+	char kbuffer[BUFFER_SIZE_AIC];
+	ssize_t bytes_read;
+	if (count >= BUFFER_SIZE_AIC) {
+		printk("audio_aic_debug_write: input too large (%zu bytes)\n", count);
+		return -EINVAL;
+	}
+	bytes_read = copy_from_user(kbuffer, user_buffer, count);
+	if (bytes_read) {
+		printk("audio_aic_debug_write: failed to copy from user space (%zd bytes)\n", bytes_read);
+		return -EFAULT;
+	}
+	kbuffer[count] = '\0';
+	if (strncasecmp(kbuffer, "reg", 3) == 0) {
+		dump_aic_regs();
+	}
+	else if(strncasecmp(kbuffer, "timestamp_on", 12) == 0) {
+		dump_time_stamp = 1;
+	}
+	else if(strncasecmp(kbuffer, "timestamp_no", 12) == 0) {
+		dump_time_stamp = 0;
+	}
+	return count - bytes_read;
+}
