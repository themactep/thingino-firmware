+    /* unsigned long tmp; */
+    return 0;
+}
+
+    /* 12 34 56 78 ... */
+static int smash_mode3(unsigned long (*base)[2], unsigned int len)
+{
+    unsigned int i;
+    unsigned long tmp;
+if (len >= 4) {
+        for (i=0; i<len/2-1; i++) {
+            tmp = base[i][1];
+            base[i][1] = base[len-1-i][1];
+            base[len-1-i][1] = tmp;
+        }
+        for (i=0; i<len; i += 2) {
+            tmp = base[i][1];
+            base[i][1] = base[i+1][1];
+            base[i+1][1] = tmp;
+        }
+    }
+    return 0;
