+static int find_max_height(void) {
+	int max_height = frame_channel_height[0];
+	int i = 0,height = 0;;
+	for (i = 0; i < sensor_number; i++) {
+		height = frame_channel_height[i * 3];
+		if (height > max_height) {
+			max_height = height;
+		}
+	}
+	return max_height;
+}
