+#define PWMENC    0x014
+#define PWMEN     0x018
+#define PWMUPDATE 0x020
+#define PWMBUSYR  0x024
+#define PWMLVL    0x030
+#define PWMWCFG   0x0B0
+#define PWMDES    0x100
+#define PWMDEC    0x104
+#define PWMDE     0x108
