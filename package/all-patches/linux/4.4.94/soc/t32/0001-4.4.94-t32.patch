-static int stfsm_n25q_config(struct stfsm *fsm)
-{
-	uint32_t flags = fsm->info->flags;
-	uint8_t vcr;
-	int ret = 0;
-	bool soc_reset;
-
-	/* Configure 'READ' sequence */
-	if (flags & FLASH_FLAG_32BIT_ADDR)
-		ret = stfsm_search_prepare_rw_seq(fsm, &fsm->stfsm_seq_read,
-						  n25q_read4_configs);
