+         aic->incodec->record->set_endpoint(CODEC_MIC_START);
+         __i2s_flush_rfifo(aic);
+         __i2s_read_rfifo(aic);
+         __i2s_enable_receive_dma(aic);
+         __i2s_enable_record(aic);
+         __i2s_enable_tloop(aic);
+         __i2s_enable_etfl(aic);
+     }
+     //play
+     if(play_flag){
