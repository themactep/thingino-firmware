+    __i2s_disable(aic);
+    schedule_timeout(5);
+    __i2s_disable(aic);
+    //__i2s_master_clkset(aic);
+
+    __i2s_external_master_mic_clkset(aic);
+    __i2s_external_master_spk_clkset(aic);
+     __i2s_reset(aic);
+
+     while((i2s_read_reg(aic, AICFR) & I2S_FIFO_RESET_STAT) != 0)
+         msleep(1);
+     __aic_select_i2s(aic);
+     __i2s_select_i2s(aic);
+
+	if(codec_use == 0){
+		//aic: slave mode, codec master mode
+		__i2s_only_internal_codec(aic);
+		__i2s_internal_slave_mic_clkset(aic);
