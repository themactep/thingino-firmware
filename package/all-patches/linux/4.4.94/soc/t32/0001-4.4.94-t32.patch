+	.set_ios		= ingenic_mmc_set_ios,
+	.get_ro			= ingenic_mmc_get_read_only,
+	.get_cd			= ingenic_mmc_get_card_detect,
+	.enable_sdio_irq	= ingenic_mmc_enable_sdio_irq,
+};
