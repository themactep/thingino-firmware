+static int set_codec_mic_mute(struct audio_aic_device *aic, void *data)
+{
+	int ret = 0;
+	int channel = *(int *)data;
+
+	struct codec_attributes *livingcodec;
+	if ((stream_select == 1) || (stream_select == 2))
+		livingcodec = aic->incodec;
