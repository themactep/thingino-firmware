+unsigned char i264e_cabac_contexts[4][QP_MAX_SPEC+1][1024];
+
+void i264e_cabac_init()
+{
+	int i = 0, j = 0, qp = 0;
+	int ctx_count = 460;
+	for( i = 0; i < 4; i++ )
+	{
+		const char (*cabac_context_init)[1024][2] = i == 0 ? &i264e_cabac_context_init_I
+			: &i264e_cabac_context_init_PB[i-1];
+		for( qp = 0; qp <= QP_MAX_SPEC; qp++ )
+			for( j = 0; j < ctx_count; j++ )
+			{
+				i264e_cabac_contexts[i][qp][j] = c_clip3(1, 126, (((*cabac_context_init)[j][0] * qp) >> 4) + (*cabac_context_init)[j][1]);
+			}
+	}
+}
+
+void i264e_cabac_context_init(void *state, int i_slice_type, int i_qp, int i_model)
+{
+	memcpy(state, i264e_cabac_contexts[i_slice_type == I264E_SLICE_TYPE_I ? 0 : i_model + 1][i_qp], 460);
+}
