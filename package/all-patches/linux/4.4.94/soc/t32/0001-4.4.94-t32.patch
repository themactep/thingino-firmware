+/dts-v1/;
+
+#include <dt-bindings/input/input.h>
+#include "PRJ007.dtsi"
+#include <dt-bindings/interrupt-controller/irq.h>
+
+/ {
+	compatible = "ingenic,zeratul", "ingenic,PRJ007";
+};
+
+&rtc {
+	status = "okay";
+};
+
+&uart0 {
+	status = "okay";
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart0_pb>;
+};
+
+&uart1 {
+	status = "okay";
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart1_pb>;
+};
+
+&uart2 {
+	status = "okay";
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart2_pc>;
+};
+
+&i2c0 {
+	pinctrl-0 = <&i2c0_pa>;
+	pinctrl-names = "default";
+	clock-frequency = <400000>;
+	status = "okay";
+};
+
+&i2c1 {
+	pinctrl-0 = <&i2c1_pa>;
+	pinctrl-names = "default";
+	clock-frequency = <400000>;
+	status = "okay";
+};
+
+&i2c2 {
+    pinctrl-0 = <&i2c2_pc>;
+    //pinctrl-0 = <&i2c2_pa>;
+    //pinctrl-0 = <&i2c2_pb>;
+    pinctrl-names = "default";
+	clock-frequency = <400000>;
+    status = "okay";
+};
+
+&cpufreq {
+	status = "okay";
+	operating-points = <
+		/*KHZ uV */
+		1200000	900000
+		750000	900000
+		600000	900000
+		500000	900000
+		400000	900000
+		375000	900000
+		300000	900000
+		200000	900000
+			>;
+
+};
+
+//&pwm {
+//	ingenic,pwm-outputs = <0>; /* <0 - 15> select which pwms are really used */
+//}
+
+&pdma {
+	status = "okay";
+};
+
+&msc0 {
+	status = "okay";
+	pinctrl-names = "default", "active";
+	max-frequency = <25000000>;
+	voltage-ranges = <1800 3300>;
+
+	cap-mmc-highspeed;
+	//sd-uhs-sdr50;
+	bus-width = <4>;
+	cd-inverted;
+	//ingenic,removal-removable = <1>;
+	//ingenic,sdr-gpios = <&gpa 17 GPIO_ACTIVE_HIGH INGENIC_GPIO_NOBIAS>;
+	ingenic,cd-gpios = <&gpb 28 GPIO_ACTIVE_LOW INGENIC_GPIO_NOBIAS>;
+	ingenic,wp-gpios = <0>;
+	pinctrl-0 = <&msc0_pb_lolvl>;
+	pinctrl-1 = <&msc0_pb_func>;
+	ingenic,rst-gpios = <0>;
+
