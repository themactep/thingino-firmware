+	get_or_set = 0;//0 set 1 get
+	isp_core_tunning_unlocked_ioctl_fast(vi_num, get_or_set, IMAGE_TUNING_CID_AWB_ATTR, (unsigned long)&awb_attr);
+
+
+	struct AE_start ae_attr;
+	get_or_set = 1;//0 set 1 get
