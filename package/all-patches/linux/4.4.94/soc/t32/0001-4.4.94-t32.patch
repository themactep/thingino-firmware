+	//__i2s_reset(aic);
+
+	//call funtion:registe_aic_to_dsp in dsp module to init dsp route
+	if (AUDIO_SUCCESS != register_audio_pipe(aic->mic_pipe, AUDIO_ROUTE_AMIC_ID)) {
