+			break;
+		}
+	}
+	si->rm.mce_resi_thr[0][0][0]   = tup_resi_thr_score;
+	si->rm.mce_resi_thr[0][0][1]   = 32;
+	si->rm.mce_resi_thr[0][0][2]   = tup_resi_thr_score;
+	si->rm.mce_resi_thr[0][0][3]   = 256;
+
