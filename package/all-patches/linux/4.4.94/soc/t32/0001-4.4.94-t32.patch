+static ssize_t audio_bind_store(struct device *dev, struct device_attribute *attr, const char *buf, size_t size)
+{
+    struct audio_dsp_device* dsp = globe_dspdev;
+    int ret = -1;
+    if(strncmp(buf, "suspend",7)) {
+        pr_alert("Please  use suspend instead of %s \n",buf);
+        return size;
+    }
+    if(audio_sleep == 0)
+        audio_sleep = 1;
+    else{
+        pr_alert("Please operate unbind first\n");
+        return size;
+    }
+
+    set_suspend_config();
+
+    //disable hrtimer
+    atomic_set(&dsp->timer_stopped, 1);
+    hrtimer_cancel(&dsp->hr_timer);
+    cancel_work_sync(&dsp->workqueue);
+    if (dsp->routes[AUDIO_ROUTE_AMIC_ID].state == AUDIO_BUSY_STATE) {
+        dmaengine_terminate_all(dsp->routes[AUDIO_ROUTE_AMIC_ID].pipe->dma_chan);
+        dma_release_channel(dsp->routes[AUDIO_ROUTE_AMIC_ID].pipe->dma_chan);
+    }else{
+        dma_release_channel(dsp->routes[AUDIO_ROUTE_AMIC_ID].pipe->dma_chan);
+    }
+
+    if (dsp->routes[AUDIO_ROUTE_AEC_ID].state == AUDIO_BUSY_STATE) {
+        dmaengine_terminate_all(dsp->routes[AUDIO_ROUTE_AEC_ID].pipe->dma_chan);
+        dma_release_channel(dsp->routes[AUDIO_ROUTE_AEC_ID].pipe->dma_chan);
+    }else {
+        dma_release_channel(dsp->routes[AUDIO_ROUTE_AEC_ID].pipe->dma_chan);
+    }
+    if (dsp->routes[AUDIO_ROUTE_SPK_ID].state == AUDIO_BUSY_STATE) {
+        dmaengine_terminate_all(dsp->routes[AUDIO_ROUTE_SPK_ID].pipe->dma_chan);
+        dma_release_channel(dsp->routes[AUDIO_ROUTE_SPK_ID].pipe->dma_chan);
+    }else {
+        dma_release_channel(dsp->routes[AUDIO_ROUTE_SPK_ID].pipe->dma_chan);
+    }
+    return size;
+}
+
+void set_dma_param(struct audio_route *route)
+{
+    struct dsp_data_manage *manage = NULL;
+    struct audio_pipe *pipe = NULL;
+    struct dma_async_tx_descriptor *desc;
+    unsigned long flags = DMA_CTRL_ACK;
+    unsigned long lock_flags;
+
+    spin_lock_irqsave(&globe_dspdev->slock, lock_flags);
+    if(route->index == AUDIO_ROUTE_AMIC_ID)
+    {
+        route->manage.dma_tracer = 0;
+        route->manage.new_dma_tracer = 0;
+        route->manage.io_tracer = route->manage.fragment_cnt - AUDIO_IO_LEADING_DMA;
+        route->manage.aec_dma_tracer = 0;
+    }
+    if(route->index == AUDIO_ROUTE_AEC_ID)
+    {
+        route->manage.dma_tracer = 0;
+        route->manage.new_dma_tracer = 0;
+        route->manage.io_tracer = route->manage.fragment_cnt - AUDIO_IO_LEADING_DMA;
+    }
+    if(route->index == AUDIO_ROUTE_SPK_ID)
+    {
+        route->manage.dma_tracer = 0;
+        route->manage.new_dma_tracer = 0;
+        route->manage.io_tracer = AUDIO_IO_LEADING_DMA;
+    }
+    spin_unlock_irqrestore(&globe_dspdev->slock, lock_flags);
+    manage = &route->manage;
+    pipe = route->pipe;
+
+    if (manage == NULL || pipe == NULL) {
+        audio_err_print("%s, %d manage or pipe is NULL.\n", __func__, __LINE__);
+        //return ;
+    }
+    memset(pipe->vaddr, 0, manage->buffersize);
+    dmaengine_slave_config(pipe->dma_chan, &pipe->dma_config);
+#if defined(CONFIG_KERNEL_4_4_94) || defined(CONFIG_KERNEL_5_15)
+    desc = pipe->dma_chan->device->device_prep_dma_cyclic(pipe->dma_chan,
+                        pipe->paddr,
+                        manage->buffersize,
+                        manage->buffersize,
+                        pipe->dma_config.direction,
+                        flags);
+#endif
+#ifdef CONFIG_KERNEL_3_10
+    desc = pipe->dma_chan->device->device_prep_dma_cyclic(pipe->dma_chan,
+                        pipe->paddr,
+                        manage->buffersize,
+                        manage->buffersize,
+                        pipe->dma_config.direction,
+                        flags,
+                        NULL);
+#endif
+    if (!desc) {
+        dev_err(NULL, "cannot prepare slave dma\n");
+    }
+    dmaengine_submit(desc);
+    dma_async_issue_pending(route->pipe->dma_chan);
+}
+
+static ssize_t audio_unbind_store(struct device *dev, struct device_attribute *attr, const char *buf, size_t size)
+{
+    int ret = -1;
+    if(strncmp(buf, "resume",6)){
+        pr_alert("Please use resume instead of %s \n",buf);
+        return size;
+    }
+    if(audio_sleep == 1)
+        audio_sleep = 0;
+    else {
+        pr_alert("Please operate bind first\n");
+        return size;
+    }
+    struct audio_dsp_device* dsp = globe_dspdev;
+    dma_set_config(dsp->routes[AUDIO_ROUTE_AMIC_ID].pipe);
+    dma_set_config(dsp->routes[AUDIO_ROUTE_AEC_ID].pipe);
+    dma_set_config(dsp->routes[AUDIO_ROUTE_SPK_ID].pipe);
+    if (dsp->routes[AUDIO_ROUTE_AMIC_ID].state == AUDIO_BUSY_STATE)
+        set_dma_param(&(dsp->routes[AUDIO_ROUTE_AMIC_ID]));
+    if (dsp->routes[AUDIO_ROUTE_AEC_ID].state == AUDIO_BUSY_STATE)
+        set_dma_param(&(dsp->routes[AUDIO_ROUTE_AEC_ID]));
+    if (dsp->routes[AUDIO_ROUTE_SPK_ID].state == AUDIO_BUSY_STATE)
+        set_dma_param(&(dsp->routes[AUDIO_ROUTE_SPK_ID]));
+    /* enable hrtimer */
+    hrtimer_init(&dsp->hr_timer, CLOCK_MONOTONIC, HRTIMER_MODE_REL);
+    dsp->hr_timer.function = jz_audio_hrtimer_callback;
+    dsp->expires = ns_to_ktime(1000*1000*fragment_time*10*2);   // the time section is default 40ms.
+    INIT_WORK(&dsp->workqueue, dsp_workqueue_handle);
+
+    /* enable hrtimer */
+    if(atomic_read(&dsp->timer_stopped)){
+        atomic_set(&dsp->timer_stopped, 0);
+        hrtimer_start(&dsp->hr_timer, dsp->expires , HRTIMER_MODE_REL);
+    }
+    set_resume_config();
+    return size;
+}
+static DEVICE_ATTR(audio_bind, S_IWUSR, NULL, audio_bind_store);
+static DEVICE_ATTR(audio_unbind, S_IWUSR, NULL, audio_unbind_store);
+
+static int audio_dsp_probe(struct platform_device *pdev)
+{
+	struct audio_dsp_device* dspdev = NULL;
+	struct platform_device **subdevs = NULL;
+	int ret = AUDIO_SUCCESS;
+
+	dspdev = (struct audio_dsp_device*)kzalloc(sizeof(*dspdev), GFP_KERNEL);
+	if (!dspdev) {
+		audio_err_print("Failed to allocate camera device\n");
+		ret = -ENOMEM;
+		goto exit;
+	}
+
+	/* init self */
+	spin_lock_init(&dspdev->slock);
+	mutex_init(&dspdev->mlock);
+
+	dspdev->proc = jz_proc_mkdir("audio");
+	if (!dspdev->proc) {
+		dspdev->proc = NULL;
+		audio_err_print("Failed to create debug directory of tx-isp!\n");
+		goto failed_to_proc;
+	}
+
+	atomic_set(&dspdev->timer_stopped, 1);
+	hrtimer_init(&dspdev->hr_timer, CLOCK_MONOTONIC, HRTIMER_MODE_REL);
+	dspdev->hr_timer.function = jz_audio_hrtimer_callback;
+	dspdev->expires = ns_to_ktime(1000*1000*fragment_time*10*2);	// the time section is default 40ms.
+	INIT_WORK(&dspdev->workqueue, dsp_workqueue_handle);
+
+	globe_dspdev = dspdev;
+	/* register subdev,AIC*/
+	subdevs = pdev->dev.platform_data;
+	if(aic_enable){
+		platform_driver_register(&audio_aic_driver);
+		platform_device_register(subdevs[0]);
+	}
+
+#ifdef CONFIG_SOC_PRJ007
+	if(dmic_enable){
+		if(0 != platform_driver_register(&ingenic_dmic_platform_driver))
+		{
+			printk("platform_driver_register: &ingenic_dmic_platform_driver is fail\n");
+		}
+
+		if(0 !=platform_device_register(subdevs[1]))
+		{
+			printk("platform_device_register: &ingenic_dmic_device is fail\n");
+		}
+	}
+#endif
+
+#ifdef CONFIG_ZERATUL
+	dspdev->miscdev.minor = 79;
+#else
+	dspdev->miscdev.minor = MISC_DYNAMIC_MINOR;
+#endif
+	dspdev->miscdev.name = "dsp";
+	dspdev->miscdev.fops = &audio_dsp_fops;
+	ret = misc_register(&dspdev->miscdev);
+	if (ret < 0) {
+		ret = -ENOENT;
+		audio_err_print("Failed to register tx-isp miscdev!\n");
+		goto failed_misc_register;
+	}
+	platform_set_drvdata(pdev, dspdev);
+	globe_dspdev = dspdev;
+	dspdev->refcnt = 0;
+	dspdev->version = AUDIO_DRIVER_VERSION;
+	ret = device_create_file(&pdev->dev, &dev_attr_audio_bind);
+	if (ret) {
+		audio_err_print("sys file creation failed!\n");
+		//goto failed_create_file;
+	}
+	ret = device_create_file(&pdev->dev, &dev_attr_audio_unbind);
+	if (ret) {
+		audio_err_print("sys file creation failed!\n");
+		//goto failed_create_file;
+	}
+	printk("@@@@ audio driver ok(version %s) @@@@@\n", dspdev->version);
+	return 0;
+
+failed_to_proc:
+	misc_deregister(&dspdev->miscdev);
+failed_misc_register:
+	kfree(dspdev);
+exit:
+	return ret;
+}
+
+static int __exit audio_dsp_remove(struct platform_device *pdev)
+{
+	struct audio_dsp_device* dspdev = platform_get_drvdata(pdev);
+	struct platform_device **subdevs = NULL;
+
+	misc_deregister(&dspdev->miscdev);
+	proc_remove(dspdev->proc);
+	subdevs = pdev->dev.platform_data;
+
+	if(aic_enable){
+		platform_device_unregister(subdevs[0]);
+		platform_driver_unregister(&audio_aic_driver);
+	}
+#ifdef CONFIG_SOC_PRJ007
+	if(dmic_enable){
+		platform_device_unregister(subdevs[1]);
+		platform_driver_unregister(&ingenic_dmic_platform_driver);
+	}
+#endif
+	hrtimer_cancel(&dspdev->hr_timer);
+	cancel_work_sync(&dspdev->workqueue);
+	platform_set_drvdata(pdev, NULL);
+
+	kfree(dspdev);
+	globe_dspdev = NULL;
+	device_remove_file(&pdev->dev,&dev_attr_audio_bind);
+	device_remove_file(&pdev->dev,&dev_attr_audio_unbind);
+	return 0;
+}
