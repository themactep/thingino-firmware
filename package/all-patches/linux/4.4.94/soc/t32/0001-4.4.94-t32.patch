+#define IN_OFT_Y1VY0U				( 1 << IN_OFT_BIT )
+#define IN_OFT_UY1VY0				( 2 << IN_OFT_BIT )
+#define IN_OFT_VY1UY0				( 3 << IN_OFT_BIT )
+
+#define IN_FMT_BIT					( 0 )
+#define IN_FMT_MASK					( 7 << IN_FMT_BIT )
