+static ssize_t dmic_debug_write(struct file *file, const char __user *user_buffer, size_t count, loff_t *ppos)
+{
+	int i = 0;
+	char kbuffer[BUFFER_SIZE_DMIC];
+	ssize_t bytes_read;
+	if (count >= BUFFER_SIZE_DMIC) {
+		printk("dmic_debug_write: input too large (%zu bytes)\n", count);
+		return -EINVAL;
+	}
+	bytes_read = copy_from_user(kbuffer, user_buffer, count);
+	if (bytes_read) {
+		printk("dmic_debug_write: failed to copy from user space (%zd bytes)\n", bytes_read);
+		return -EFAULT;
+	}
+	kbuffer[count] = '\0';
+	if (strncasecmp(kbuffer, "reg", 3) == 0) {
+		//dump dmic regs
+		printk("\nDump Dmic Regs:\n");
+		for (i = 0  ; i <= 0x20; i+=4)
+			printk("reg[%04x], value = %04x\n", i, readl(globe_dmic->io_base + i));
+		printk("reg[%04x], value = %04x\n", 0x30, readl(globe_dmic->io_base + 0x30));
+		printk("reg[%04x], value = %04x\n", 0x34, readl(globe_dmic->io_base + 0x34));
+		printk("reg[%04x], value = %04x\n", 0x38, readl(globe_dmic->io_base + 0x38));
+		printk("reg[%04x], value = %04x\n", 0x50, readl(globe_dmic->io_base + 0x50));
+		printk("Dump Dmic Regs End.\n");
+	}
+	return count - bytes_read;
+}
