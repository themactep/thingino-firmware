+		dev_err(sc->mdev.this_device, "[fun:%s,line:%d] copy_to_user failed\n", __func__, __LINE__);
+		goto err_copy_to_user;
+	}
+
+	return ret;
+
+err_copy_to_user:
+err_vpu_release_vpu:
+	copy_to_user((void *)usr_arg, &cnode, sizeof(struct channel_node));
+err_vpu_start_vpu:
+err_vpu_reset:
+	soc_vpu_release(sc, &cnode);
+err_vpu_request:
+err_copy_from_user:
