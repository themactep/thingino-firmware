+static void clk_div_table_generate(void)
+{
+	int i;
+	for (i = 0; i < ARRAY_SIZE(PRJ007_clk_div_table); i++) {
+		PRJ007_clk_div_table[i].val = i;
+		PRJ007_clk_div_table[i].div = (i + 1) * 4;
+	}
+
+}
+
+static void clk_div_table_sfc(void __iomem *cpm_base)
+{
+	int i;
+	unsigned int sfc_ori = 0;
+	sfc_ori = readl(cpm_base + CPM_SFCCDR) >> 8;
+	sfc_ori &= 0x3;
+	for (i = 0; i < ARRAY_SIZE(PRJ007_sfc_clk_div_table); i++) {
+		PRJ007_sfc_clk_div_table[i].val = i;
+		if(sfc_ori == 0x2)
+			PRJ007_sfc_clk_div_table[i].div = (i + 1) * 4;
+		else
+			PRJ007_sfc_clk_div_table[i].div = (i + 1) * 2;
+	}
+	return;
+}
