+
+/* tx rx threshold from 0x0 to 0xF */
+#define SSI_FULL_THRESHOLD		0xF
+#define SSI_TX_FIFO_THRESHOLD		0x1
+#define SSI_RX_FIFO_THRESHOLD		(SSI_FULL_THRESHOLD - SSI_TX_FIFO_THRESHOLD)
