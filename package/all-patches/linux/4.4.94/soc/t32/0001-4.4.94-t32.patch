+	RADIX_WRITE_CHN_EFE( RADIX_REG_EFE_CPLX_THRD,         0, frm_cplx_thrd);
+
+	/*     //efe wr row_smd_ram  */
+	/*     for (i=0; i<64; i++) */
+	/*       RADIX_WRITE_CHN_EFE( RADIX_REG_EFE_SMD_WR_BASE_ADDR+i*4 ,       0, i); */
