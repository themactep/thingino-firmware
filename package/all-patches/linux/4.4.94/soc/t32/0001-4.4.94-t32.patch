+	int ret ;
+	/* printk("======truly_tft240320_power_init==============\n"); */
+
+	ret = gpio_request(GPIO_LCD_RST, "lcd rst");
+	if (ret) {
+		printk(KERN_ERR "can's request lcd rst\n");
+		return ret;
+	}
