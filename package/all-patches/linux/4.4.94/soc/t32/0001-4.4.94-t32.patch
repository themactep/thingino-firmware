-			   SEQ_OPC_OPCODE(SPINOR_OP_WREN) |
-			   SEQ_OPC_CSDEASSERT);
-
-	seq->seq[0] = STFSM_INST_CMD2;
-	seq->seq[1] = STFSM_INST_CMD1;
-	seq->seq[2] = STFSM_INST_WAIT;
