+
+module_platform_driver(sdhci_ingenic_driver);
+
+
+MODULE_DESCRIPTION("Ingenic SDHCI (MSC) driver");
+MODULE_AUTHOR("Large Dipper <wangquan.shao@ingenic.cn>");
