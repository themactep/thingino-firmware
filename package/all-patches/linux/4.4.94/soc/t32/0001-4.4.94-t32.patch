+static void CODEC_CAGR2_init(struct timer_list *t)
+{
+	if(time_status <= 7) {
+        	value_cagr2 |= value_cagr2<<1 | 0x01;
+		codec_reg_set(CODEC_CAGR2, 0, 7, value_cagr2);
+		mod_timer(timer,jiffies + HZ/50);
+	}else {
+		codec_reg_set(CODEC_CAGR2, 0, 7, 0x02);
+		mod_timer(timer,jiffies + HZ/50);
+	}
+	time_status++;
+	return 0;
+}
+
+static void CODEC_CAADCR1_init(struct timer_list *t)
+{
