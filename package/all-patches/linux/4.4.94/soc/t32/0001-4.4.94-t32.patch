+#define OSTCCR 0x00
+#define OSTER  0x04
+#define OSTCR  0x08
+#define OSTFR  0x0C
+#define OSTMR  0x10
+#define OSTDFR 0x14
+#define OSTCNT 0x18
+
+#define G_OSTCCR   0x00
+#define G_OSTER    0x04
+#define G_OSTCR    0x08
+#define G_OSTCNTH  0x0C
+#define G_OSTCNTL  0x10
+#define G_OSTCNTB  0x14
+#define CLKSOURCE_DIV   16
+#define CLKEVENT_DIV    16
+#define CLKSOURCE_CH	1
+#define CLKEVENT_CH	0
