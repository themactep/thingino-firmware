+	GPIO_INT_HI 	= 0x0d,  //1101, High Level trigger interrupt
+	GPIO_INT_FE 	= 0x0e,  //1110, Fall Edge trigger interrupt
+	GPIO_INT_RE 	= 0x0f,  //1111, Rise Edge trigger interrupt
