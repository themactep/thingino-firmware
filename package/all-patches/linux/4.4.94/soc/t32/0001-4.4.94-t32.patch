+	int enable = 0;
+	int channel = 0;
+	long ret = -EINVAL;
+
+	/* O_RDWR mode operation, do not allowed */
+	if ((file->f_mode & FMODE_READ) && (file->f_mode & FMODE_WRITE))
+		return -EPERM;
+
+	if(dsp->state == AUDIO_IDLE_STATE){
+		audio_warn_print("please open /dev/dsp firstly!\n");
+		return -EPERM;
+	};
+
+	switch (cmd) {
