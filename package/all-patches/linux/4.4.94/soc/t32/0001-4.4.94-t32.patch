+enum nal_priority_e
+{
+	I264E_NAL_PRIORITY_DISPOSABLE = 0,
+	I264E_NAL_PRIORITY_LOW        = 1,
+	I264E_NAL_PRIORITY_HIGH       = 2,
+	I264E_NAL_PRIORITY_HIGHEST    = 3,
+};
+
+typedef struct h264_nal
+{
