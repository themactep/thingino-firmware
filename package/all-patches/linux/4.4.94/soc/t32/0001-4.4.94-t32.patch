+        ["CP0_LLADDR","$17","0"],
+        ["CP0_WATCHLo","$18","0"],
+        ["CP0_WATCHHI","$19","0"],
+        ["CP0_ERRCTL","$26","0"],
+        ["CP0_CONTEXT","$4","0"],
+        ["CP0_KSCRATCH1","$31","2"],
+        ["CP0_KSCRATCH2","$31","3"],
