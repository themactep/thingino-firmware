+static int codec_playback_set_datatype(struct audio_data_type *type)
+{
+    int ret = 0;
+    struct audio_data_type *this = NULL;
+    if(!type || !g_codec_dev)
+        return -AUDIO_EPARAM;
+    this = &g_codec_dev->playback_type;
