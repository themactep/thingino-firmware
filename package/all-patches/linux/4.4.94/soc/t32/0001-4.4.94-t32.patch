+};
+
+#define PLL_DESC(_regoff, _m, _m_w, _n, _n_w, _od1, _od1_w, _od0, _od0_w, _on, _en, _bs)	\
+{				\
+	.regoff = _regoff,	\
+	.m_sft = _m,		\
+	.m_width = _m_w,	\
+	.n_sft = _n,		\
+	.n_width = _n_w,	\
+	.od1_sft = _od1,		\
+	.od1_width = _od1_w,	\
+	.od0_sft = _od0,		\
+	.od0_width = _od0_w,	\
+	.on_bit = _on,		\
+	.en_bit =  _en,		\
+	.bs_bit = _bs,	\
+}
+
+struct ingenic_pll_hwdesc {
+	u32 regoff;
+	u8 m_sft;
+	u8 m_width;
+	u8 n_sft;
+	u8 n_width;
+	u8 od1_sft;
+	u8 od1_width;
+	u8 od0_sft;
+	u8 od0_width;
+	u8 on_bit;
+	u8 en_bit;
+	s8 bs_bit;
+};
+
+#endif /*__INGENIC_CLK_PLLV1_H__*/
