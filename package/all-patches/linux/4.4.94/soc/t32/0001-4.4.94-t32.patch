+int32_t set_flash_timing(struct sfc *sfc, uint32_t t_hold, uint32_t t_setup, uint32_t t_shslrd, uint32_t t_shslwr)
+{
+	uint32_t c_hold = 0;
+	uint32_t c_setup = 0;
+	uint32_t t_in = 0, c_in = 0;
+	uint32_t tmp;
+	unsigned long cycle;
+	unsigned long long ns;
+
+	ns = 1000000000ULL;
+	//T32 T33: (2*t_xx + cycle -1) / cycle - 1;
+	cycle = do_div(ns, clk_get_rate(sfc->clk_gate));
+	cycle = ns;
+
+	tmp = sfc_readl(sfc, SFC_DEV_CONF);
+	tmp &= ~(DEV_CONF_THOLD_MSK | DEV_CONF_TSETUP_MSK | DEV_CONF_TSH_MSK);
+
+	c_hold = (2*t_hold + cycle - 1) / cycle;
+	if(c_hold > 0)
+		c_hold -= 1;
+	if(c_hold > 3)
+		c_hold = 3;
+
+	c_setup = (2*t_setup + cycle -1)  / cycle;
+	if(c_setup > 0)
+		c_setup -= 1;
+	if(c_setup > 3)
+		c_setup = 3;
+
+	t_in = max(t_shslrd, t_shslwr);
+	c_in = (2*t_in + cycle - 1) / cycle;
+	if(c_in > 0)
+		c_in -= 1;
+	if(c_in > 15)
+		c_in = 15;
+
+	tmp |= (c_hold << DEV_CONF_THOLD_OFFSET) | \
+		  (c_setup << DEV_CONF_TSETUP_OFFSET) | \
+		  (c_in << DEV_CONF_TSH_OFFSET);
+
+	sfc_writel(sfc, SFC_DEV_CONF, tmp);
+	return 0;
+}
