+	(host->flags & (1 << INGENIC_MMC_USE_PIO))
+#define enable_pio_mode(host)					\
+	(host->flags |= (1 << INGENIC_MMC_USE_PIO))
+#define disable_pio_mode(host)					\
+	(host->flags &= ~(1 << INGENIC_MMC_USE_PIO))
+
+static LIST_HEAD(manual_list);
