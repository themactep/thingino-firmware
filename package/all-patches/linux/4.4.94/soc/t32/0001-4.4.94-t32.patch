diff -ruN --no-dereference '--exclude=.git' common/arch/mips/xburst/core/include/mxuv3.h tree-t32/arch/mips/xburst/core/include/mxuv3.h
--- common/arch/mips/xburst/core/include/mxuv3.h	1969-12-31 19:00:00.000000000 -0500
+++ tree-t32/arch/mips/xburst/core/include/mxuv3.h	2026-10-09 03:36:53.285512620 -0400
@@ -0,0 +1,42 @@
+/*
