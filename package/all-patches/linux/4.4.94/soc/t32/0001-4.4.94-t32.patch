+	//			alg_name);
+	//		EXIT();
+	//		return PTR_ERR(tctx->fallback);
+	//	}
+	crypto_ahash_set_reqsize(__crypto_ahash_cast(tfm),
+			sizeof(struct ingenic_hash_reqctx) +
+			HASH_BUFFER_LEN + SHA512_BLOCK_SIZE);
+	EXIT();
+	return 0;
+}
