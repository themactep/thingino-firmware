+void prep_sgdata(struct scatterlist *sg)
+{
+	int i;
+	unsigned int *d =  sg_virt(sg);
+	unsigned int dat;
+	for(i = 0;i < sg->length;i += 4)
+	{
+		dat = d[i/4];
+		d[i/4] = __be32_to_cpu(dat);
+	}
+}
