+static int set_codec_spk_start(struct audio_aic_device *aic, void *data)
+{
+	int ret = 0;
+
+	struct codec_attributes *livingcodec;
+	if ((stream_select == 1) || (stream_select == 3))
+		livingcodec = aic->excodec;
+	else
+		livingcodec = aic->incodec;
+	if (NULL == aic || NULL == livingcodec) {
+		audio_err_print("aic is null or livingcodec is null.\n");
+		return -1;
+	}
+
+	__i2s_enable(aic);
+	ret = livingcodec->playback->set_endpoint(CODEC_SPK_START);
+	{
+		__i2s_flush_tfifo(aic);
+		__i2s_enable_transmit_dma(aic);
+		__i2s_enable_replay(aic);
+	}
+	play_flag = 1;
+	return ret;
+}
+
+
+static int set_codec_spk_stop(struct audio_aic_device *aic, void *data)
+{
+	int ret = 0;
+
+	struct codec_attributes *livingcodec;
+	if ((stream_select == 1) || (stream_select == 3))
+		livingcodec = aic->excodec;
+	else
+		livingcodec = aic->incodec;
+	if (NULL == aic || NULL == livingcodec) {
+		audio_err_print("aic is null or livingcodec is null.\n");
+		return -1;
+	}
+
+	__i2s_disable_transmit_dma(aic);
+	__i2s_disable_replay(aic);
+
+	{
+		//avoid pop
+		__i2s_write_tfifo(aic, 0);
+		__i2s_write_tfifo(aic, 0);
+		__i2s_write_tfifo(aic, 0);
+		__i2s_write_tfifo(aic, 0);
+		__i2s_enable_replay(aic);
+		msleep(2);
+		__i2s_disable_replay(aic);
+	}
+
+	ret = livingcodec->playback->set_endpoint(CODEC_SPK_STOP);
+	play_flag = 0;
+	return ret;
+}
