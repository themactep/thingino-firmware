+#define OUT_FMT_GRBA				( 0x11 <<  OUT_FMT_BIT )
+#define OUT_FMT_GBRA				( 0x12 <<  OUT_FMT_BIT )
+#define OUT_FMT_BRGA				( 0x13 <<  OUT_FMT_BIT )
