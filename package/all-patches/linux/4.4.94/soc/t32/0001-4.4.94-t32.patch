+		get_or_set = 0;//0 set 1 get
+		isp_core_tunning_unlocked_ioctl_fast(i, get_or_set, IMAGE_TUNING_CID_AE_ANTIFLICKER_ATTR, (unsigned long)&flicker_attr);
+	}
+#endif
+
+	// IRCUT switch back to idle state
+	ircut_gpio_init();
+
+	// create ir_status node
