+static bool dma_chan_filter(struct dma_chan *chan, void *filter_param)
+{
+	struct audio_pipe *pipe = filter_param;
+	unsigned int type = (unsigned int)chan->private;
+	//printk("private:%d, type:%d\n", type, pipe->dma_type);
+	return (unsigned int)pipe->dma_type == type;
+}
