+	PM_RESUME_PAT0,
+	PM_RESUME_PAT1,
+	PM_RESUME_PULL_UP,
+	PM_RESUME_PULL_DOWN,
+	PM_STATE_CNT,
+} ingenic_gpio_pm_arr_t;
