+static const struct file_operations ingenic_sfc_ops = {
+       .owner = THIS_MODULE,
+       .open = ingenic_sfc_open,
+       .release = ingenic_sfc_release,
+       .unlocked_ioctl = ingenic_sfc_ioctl,
+};
