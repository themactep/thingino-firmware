+static int PRJ008_suspend_prepare(void)
+{
+	return regulator_suspend_prepare(PM_SUSPEND_MEM);
+}
+static void PRJ008_suspend_finish(void)
+{
+	if (regulator_suspend_finish())
+		pr_err("%s: Suspend finish failed\n", __func__);
+}
+#endif
+
+static int ingenic_pm_valid(suspend_state_t state)
+{
+	switch (state) {
+	case PM_SUSPEND_ON:
+	case PM_SUSPEND_STANDBY:
+	case PM_SUSPEND_MEM:
+		return 1;
+
+	default:
+		return 0;
+	}
+}
+static const struct platform_suspend_ops PRJ008_pm_ops = {
+	.valid		= ingenic_pm_valid,
+	.begin		= PRJ008_pm_begin,
+	.enter		= PRJ008_pm_enter,
+	.end		= PRJ008_pm_end,
+#if defined CONFIG_KP_AXP
+	.prepare = PRJ008_suspend_prepare,
+	.finish = PRJ008_suspend_finish,
+#endif
+};
+
+static int __init suspend_console_setup(char *str)
+{
+	char buf[32];
+	char *s;
+	strncpy(buf, str, sizeof(buf) - 1);
+
+	for (s = buf; *s; s++)
+		if (isdigit(*s) || *s == ',')
+			break;
+	if(*s == ','){
+		bc_idx = 1;
+	}else{
+		bc_idx = simple_strtoul(s, NULL, 10);
+	}
+	return 0;
+}
+__setup("console=", suspend_console_setup);
+
+/*
+ * Initialize suspend interface
+ */
+static int __init pm_init(void)
+{
+
+	int ret = 0;
+#ifdef CONFIG_PM
+	suspend_set_ops(&PRJ008_pm_ops);
+	ret = ingenic_fastboot_init();
+	if(ret != 0){
+		printk("pm init failed\n");
+	}
+
+#endif /* ifdef CONFIG_PM */
+
+#ifdef CONFIG_INGENIC_ZBOOST
+	ret = ingenic_zboost_init();
+	if(ret != 0){
+		printk("pm init failed\n");
+	}
+#endif/*CONFIG_INGENIC_ZBOOST*/
+	pr_info("PM Init success\n");
+	return 0;
+}
+static void __exit pm_deinit(void)
+{
+#ifdef CONFIG_PM
+	if(mem_test_rgn)
+		kfree(mem_test_rgn);
+	ingenic_fastboot_deinit();
+#endif /* ifdef CONFIG_PM */
+
+#ifdef CONFIG_INGENIC_ZBOOST
+	ingenic_zboost_exit();
+#endif /*CONFIG_INGENIC_ZBOOST*/
+}
+late_initcall(pm_init);
+module_exit(pm_deinit);
