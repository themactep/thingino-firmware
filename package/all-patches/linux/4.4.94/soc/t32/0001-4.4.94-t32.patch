+int ingenic_tcu_counter_begin(struct ingenic_tcu_chn *chn)
+{
+	int ret = 0;
+
+	if (chn->is_pwm) {
+		printk("%s[%d]: tcu don't support pwm\n",__func__,__LINE__);
+	}
+	tcu_enable_counter(chn->cib.id);
+	return ret;
+}
