+
+STEP:
+	//6.wait at least 1ms ,configure ADENA.TSENSOR_EN as 1 to enalbe the temperature channel
+	msleep(1);
+	ret = stemp_read(stemp_ope,ADENA);
+	stemp_write(stemp_ope, ADENA, ret | 1<<3);
