+static int ingenicfb_release(struct fb_info *info, int user)
+{
+	struct ingenicfb_device *fbdev = info->par;
+
+	dev_dbg(info->dev, "####close count : %d\n", fbdev->open_cnt--);
+	if(!fbdev->open_cnt) {
+//		fbdev->timestamp.rp = 0;
+//		fbdev->timestamp.wp = 0;
+	}
+	return 0;
+}
