-#define ADR_CFG_PADS_1_ADD2		(0x0 << (6+16))
-#define ADR_CFG_PADS_2_ADD2		(0x1 << (6+16))
-#define ADR_CFG_PADS_4_ADD2		(0x3 << (6+16))
