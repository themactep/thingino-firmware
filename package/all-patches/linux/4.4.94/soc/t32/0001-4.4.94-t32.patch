+#define IOCTL_KERN_ENC_RELEASE			_IOWR(KERN_ENC_MAGIC, 22, struct kern_enc_node)
+#define IOCTL_KERN_ENC_GET_STATUS		_IOWR(KERN_ENC_MAGIC, 23, struct kern_enc_node)
+
+#define NUM_MAX_STREAM 128
