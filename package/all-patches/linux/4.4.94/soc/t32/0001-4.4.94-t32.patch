+		}else{
+			if (livingcodec->record->set_mute)
+				ret = livingcodec->record->set_mute(channel);
+			aic->codec_mic_info->lchannel_mute_en = 1;
+		}
+	}else{
+		if(aic->codec_mic_info->rchannel_mute_en){
+			ret = livingcodec->record->set_dgain(channel,aic->codec_mic_info->rdgain);
+			aic->codec_mic_info->rchannel_mute_en = 0;
+		}else{
+			if (livingcodec->record->set_mute)
+				ret = livingcodec->record->set_mute(channel);
+			aic->codec_mic_info->rchannel_mute_en = 1;
+		}
+	}
+
+	return ret;
+}
