-#define DOC_CONFIGURATION		0x100e
-#define DOC_INTERRUPTCONTROL		0x1010
-#define DOC_READADDRESS			0x101a
-#define DOC_DATAEND			0x101e
-#define DOC_INTERRUPTSTATUS		0x1020
-
-#define DOC_FLASHSEQUENCE		0x1032
