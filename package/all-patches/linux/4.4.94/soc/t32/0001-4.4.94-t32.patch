-/**
- * doc_page_finish - Ends reading/writing of a flash page
- * @docg3: the device
- */
-static void doc_page_finish(struct docg3 *docg3)
-{
-	doc_writeb(docg3, 0, DOC_DATAEND);
-	doc_delay(docg3, 2);
