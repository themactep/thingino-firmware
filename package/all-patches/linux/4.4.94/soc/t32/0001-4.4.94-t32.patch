+&el150 {
+	status = "disable";
+};
+*/
+
+/*
+&dpu {
+	status = "okay";
+};
+*/
+/* t31 not have
+/ {
+	display-dpi {
+		compatible = "simple-bus";
+		#interrupt-cells = <1>;
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges = <>;
+		panel_bm8766@0 {
+			compatible = "ingenic,bm8766";
+			pinctrl-names = "default";
+			pinctrl-0 = <&tft_lcd_pd>;
+			ingenic,bl-gpio = <&gpb 25 GPIO_ACTIVE_HIGH INGENIC_GPIO_NOBIAS>;
+		};
+
+	};
+};
+*/
+/* t31 not have
+/ {
+	display-dbi {
+		compatible = "simple-bus";
