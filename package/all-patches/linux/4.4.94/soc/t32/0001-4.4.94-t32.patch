+/* get_buf_share_cfg */
+	if(si->buf_share_en) {
+		frame_idx = si->frm_num_gop;
+		ddr_y_base = (unsigned int)(io->rds_y_phyaddr + 255) & ~255;
+		ddr_c_base = (unsigned int)(io->rds_c_phyaddr + 255) & ~255;
+
+		//align
+		frame_width   = (si->frame_width  + 63) & ~63;
+#ifdef CONFIG_SOC_PRJ007
