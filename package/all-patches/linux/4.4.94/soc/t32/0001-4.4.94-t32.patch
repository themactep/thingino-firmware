+static ssize_t pwm_store_channel(struct device *dev, struct device_attribute *attr, const char *buf, size_t count)
+{
+	struct ingenic_pwm_chip *ingenic_pwm = dev_get_drvdata(dev);
+	const char *str = buf;
+	int ret_count = 0;
+	int pwm_id = 0;
+	int gpio_id = 0;
+	int gpio_func = 0;
+	struct pwm_device *pwm = NULL;
+	char name[16];
+
+	while (!isxdigit(*str)) {
+		str++;
+		if(++ret_count >= count)
+			return count;
+	}
+	pwm_id = simple_strtoul(str, (char **)&str, 10);
+	pwm = pwm_request(pwm_id, "pwm_request_test");
+	if (IS_ERR(pwm)) {
+		printk("unable to request pwm\n");
+		return -1;
+	}
+
+	while (!isxdigit(*str)) {
+		str++;
+		if(++ret_count >= count)
+			goto out;
+	}
+	gpio_id = simple_strtoul(str, (char **)&str, 10);
+	while (!isxdigit(*str)) {
+		str++;
+		if(++ret_count >= count)
+			goto out;
+	}
+	gpio_func = simple_strtoul(str, (char **)&str, 10);
+	if(gpio_func > 3){
+		printk("The gpio function is invalid!\n");
+		goto out;
+	}
+
+	memset(name, 0, sizeof(name));
+	sprintf(name, "pwm-%d", pwm_id);
+	if(gpio_request(gpio_id, name) < 0){
+		printk("Failed to request gpio of %s\n", name);
+		goto out;
+	}
+
+	jzgpio_set_func(gpio_id/32, gpio_func + GPIO_FUNC_0, 1<<(gpio_id%32));
+	ingenic_pwm->debug_pwm[pwm_id] = pwm;
+	ingenic_pwm->gpio_sel[pwm_id] = gpio_id;
+	ingenic_pwm->debug_current_id = pwm_id;
+	printk("channel = %d\n", ingenic_pwm->debug_current_id);
+	return count;
+out:
+	pwm_put(pwm);
+	return count;
+}
