+#define USBPCR_POR                      BIT(USBPCR_POR_BIT)
+
+/*USB Reset Detect Timer Register*/
+#define USBRDT_RESUME_INTEEN            BIT(31) /*RW*/
+#define USBRDT_RESUME_INTERCLR          BIT(30) /*W0*/
+#define USBRDT_RESUME_SPEED_BIT         28  /*RW*/
