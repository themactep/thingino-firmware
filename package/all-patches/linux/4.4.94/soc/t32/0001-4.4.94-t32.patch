+#ifndef _ASM_MXU_V3_H
+#define _ASM_MXU_V3_H
+
+#include <asm/cpu.h>
+#include <asm/cpu-features.h>
+#include <asm/hazards.h>
+#include <asm/mipsregs.h>
+#include <linux/printk.h>
+
+void __init_mxuv3(void);
+void __save_mxuv3(void *tsk_void);
+void __restore_mxuv3(void *tsk_void);
+
+static inline void init_mxuv3(void)
+{
+	if(cpu_has_mxuv3)
+		__init_mxuv3();
+}
+
+
+#define save_mxuv3(tsk)							\
+	do {										\
+		if (cpu_has_mxuv3)						\
+			__save_mxuv3(tsk);					\
+	} while (0)
+
+#define restore_mxuv3(tsk)						\
+	do {										\
+		if (cpu_has_mxuv3)						\
+			__restore_mxuv3(tsk);					\
+	} while (0)
+
+#endif /* _ASM_MXU_V3_H */
diff -ruN --no-dereference '--exclude=.git' common/arch/mips/xburst/core/Kconfig tree-t32/arch/mips/xburst/core/Kconfig
--- common/arch/mips/xburst/core/Kconfig	1969-12-31 19:00:00.000000000 -0500
+++ tree-t32/arch/mips/xburst/core/Kconfig	2026-10-09 03:36:53.285235167 -0400
@@ -0,0 +1,14 @@
+choice
+    prompt "Select cache refresh mode"
+    default CACHE_REFRESH_NON_LINKED
+
+    config CACHE_REFRESH_LINKED
+        bool "Linked cache refresh"
+        help
+            Refresh multiple caches together.
+
+    config CACHE_REFRESH_NON_LINKED
+        bool "Non-linked cache refresh"
+        help
+            Refresh each cache independently.
+endchoice
