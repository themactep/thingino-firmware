+	cpm_set_bit(CPM_RADIX_STP(vpu->vpu.idx), CPM_SRBC);
+	while (!(cpm_inl(CPM_SRBC) & (1 << CPM_RADIX_ACK(vpu->vpu.idx)) && --timeout)) {
+		udelay(20);
+	}
+
+	if (timeout == 0) {
+		dev_warn(vpu->vpu.dev, "[%d:%d] wait stop ack timeout\n",
+				current->tgid, current->pid);
