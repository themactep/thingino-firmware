+int vpu_wrap_write_reg(unsigned int reg, unsigned int val);
+int vpu_wrap_read_reg(unsigned int reg);
+void vpu_wrap_usleep(unsigned int usec);
+int c_clip3(int v, int i_min, int i_max);
+#endif //_VPU_COMMON_H_
