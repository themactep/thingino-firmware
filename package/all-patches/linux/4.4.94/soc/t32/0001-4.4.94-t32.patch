+	si->mf_sel_sech_skip32_en       = si->srd_en ? 1 : 0;
+	si->mf_sel_sech_skip16_en       = si->srd_en ? 1 : 0;
+	si->sech_force_mv0_mode     = si->srd_en ? 1 : 1;
