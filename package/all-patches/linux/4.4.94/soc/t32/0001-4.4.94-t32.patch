-
-/*
- * Register: SPI_FAST_SEQ_ADD_CFG
- */
-#define ADR_CFG_CYCLES_ADD1(x)		((x) << 0)
-#define ADR_CFG_PADS_1_ADD1		(0x0 << 6)
-#define ADR_CFG_PADS_2_ADD1		(0x1 << 6)
-#define ADR_CFG_PADS_4_ADD1		(0x3 << 6)
-#define ADR_CFG_CSDEASSERT_ADD1		(1   << 8)
