+int isp_printf(unsigned int level, unsigned char *fmt, ...)
+{
+	struct va_format vaf;
+	va_list args;
+	int r = 0;
+
+	if(level >= print_level){
+		va_start(args, fmt);
+
+		vaf.fmt = fmt;
+		vaf.va = &args;
+
+		r = printk("%pV",&vaf);
+		va_end(args);
+		if(level >= ISP_ERROR_LEVEL)
+			dump_stack();
+	}
+	return r;
+}
