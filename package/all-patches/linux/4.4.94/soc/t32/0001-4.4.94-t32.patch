+/* I/O Driver Strength Types */
+#define INGENIC_TYPE_0  0x0		//30
+#define INGENIC_TYPE_1  0x1		//50
+#define INGENIC_TYPE_2  0x2		//66
+#define INGENIC_TYPE_3  0x3		//100
+
+static int sdhci_ingenic_select_drive_strength(struct sdhci_host *host,
+		struct mmc_card *card,
+		unsigned int max_dtr,
+		int host_drv, int card_drv, int *drv_type)
+{
+	int drive_strength, type;
+
+	type = INGENIC_TYPE_1;
+
+	switch (type) {
+		case INGENIC_TYPE_0:
+			/* Type 0: 50 */
+			*(volatile unsigned int*)(0xb0010500 + 0xb8) |= 0xfff;
+			*(volatile unsigned int*)(0xb0010500 + 0xb4) |= 0x555;
+			drive_strength = 0;
+			break;
+		case INGENIC_TYPE_1:
+			/* Type 1: 33 */
+			*(volatile unsigned int*)(0xb0010500 + 0xb8) |= 0xfff;
+			*drv_type = MMC_CAP_DRIVER_TYPE_A; // GPIO DRV_STR
+			drive_strength = 1;
+			break;
+		case INGENIC_TYPE_2:
+			/* Type 2: 66 */
+			*(volatile unsigned int*)(0xb0010500 + 0xb8) |= 0xfff;
+			*(volatile unsigned int*)(0xb0010500 + 0xb4) |= 0xaaa;
+			*drv_type = MMC_CAP_DRIVER_TYPE_C; // GPIO DRV_STR
+			drive_strength = 2;
+			break;
+		case INGENIC_TYPE_3:
+			/* Type 3: 100 */
+			*(volatile unsigned int*)(0xb0010500 + 0xb8) |= 0xfff;
+			*(volatile unsigned int*)(0xb0010500 + 0xb4) |= 0xfff;
+			*drv_type = MMC_CAP_DRIVER_TYPE_D; // GPIO DRV_STR
+			drive_strength = 3;
+			break;
+	}
+
+	return drive_strength;
+}
+
+static void sdhci_ingenic_set_driver_strength(struct sdhci_ingenic *sdhci_ing)
+{
+	struct sdhci_ingenic_pdata *pdata = sdhci_ing->pdata;
+	int strength,i,pull_flag;
+
+	if(pdata->driver_strength == 0 && pdata->gpio_pull_flag == 0)
+		return;
+
+	switch(pdata->driver_strength){
+#ifdef CONFIG_SOC_PRJ008
+		case 4:
+			strength = GPIO_DRIVE_STRENGTH_MODE_2;
+			break;
+		case 8:
+			strength = GPIO_DRIVE_STRENGTH_MODE_3;
+			break;
+		case 12:
+			strength = GPIO_DRIVE_STRENGTH_MODE_4;
+			break;
+		default:
+			strength = GPIO_DRIVE_STRENGTH_MODE_2;
+			break;
+#else
+		case 4:
+			strength = GPIO_DRIVE_STRENGTH_4;
+			break;
+		case 8:
+			strength = GPIO_DRIVE_STRENGTH_8;
+			break;
+		case 12:
+			strength = GPIO_DRIVE_STRENGTH_12;
+			break;
+		default:
+			strength = GPIO_DRIVE_STRENGTH_4;
+			break;
+#endif
+	}
+
+	switch(pdata->gpio_pull_flag){
+		case 0:
+			pull_flag = GPIO_PULL_HIZ;
+			break;
+		case 1:
+			pull_flag = GPIO_PULL_UP;
+			break;
+		case 2:
+			pull_flag = GPIO_PULL_DOWN;
+			break;
+		default:
+			pull_flag = GPIO_PULL_HIZ;
+			break;
+	}
+
+	if(sdhci_ing->pdev->id == 0 && !strcmp(pdata->gpio_group_name, "gpb")){
+		for(i = 0; i < 6; i++){
+			jzgpio_set_func(GPIO_PORT_B, strength, i);
+			if (i != 4)
+				jzgpio_set_func(GPIO_PORT_B, pull_flag, 1 << i);
+		}
+	}else if(sdhci_ing->pdev->id == 1 && !strcmp(pdata->gpio_group_name, "gpc")){
+		for(i = 2; i < 8; i++){
+			jzgpio_set_func(GPIO_PORT_C, strength, i);
+			if (i != 2)
+				jzgpio_set_func(GPIO_PORT_C, pull_flag, 1 << i);
+		}
+	}else if(sdhci_ing->pdev->id == 1 && !strcmp(pdata->gpio_group_name, "gpa")){
+		for(i = 14; i < 23; i++) {
+			if ((i > 13 && i < 16) || (i == 17) || (i > 19 && i < 23)){
+				jzgpio_set_func(GPIO_PORT_A, strength, i);
+				if (i != 17)
+					jzgpio_set_func(GPIO_PORT_A, pull_flag, 1 << i);
+			}
+		}
+	}else if(sdhci_ing->pdev->id == 1 && !strcmp(pdata->gpio_group_name, "gpb")){
+		for(i = 8; i < 15; i++) {
+			if ((i > 7 && i < 12) || (i > 12 && i < 15)){
+				jzgpio_set_func(GPIO_PORT_B, strength, i);
+				if (i != 8)
+					jzgpio_set_func(GPIO_PORT_B, pull_flag, 1 <<  i);
+			}
+		}
+	}
+
+	return;
+}
