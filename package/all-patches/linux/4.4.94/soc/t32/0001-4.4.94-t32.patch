+/* Register PRJ007 clocks. */
+static void __init PRJ007_clk_init(struct device_node *np, void __iomem *base)
+{
+	void __iomem *reg_base;
+
+	printk("PRJ007 Clock Power Management Unit init!\n");
+
+	reg_base = base;
+
+	if (np) {
+		reg_base = of_iomap(np, 0);
+		if (!reg_base)
+			panic("%s: failed to map registers\n", __func__);
+	}
+
+
+	ctx = ingenic_clk_init(np, reg_base, NR_CLKS);
+	if (!ctx)
+		panic("%s: unable to allocate context.\n", __func__);
+
+	/* Register Ext Clocks From DT */
+	ingenic_clk_of_register_fixed_ext(ctx, PRJ007_fixed_rate_ext_clks,
+			                        ARRAY_SIZE(PRJ007_fixed_rate_ext_clks), ext_clk_match);
+
+	/* Register PLLs. */
+	ingenic_clk_register_pll(ctx, PRJ007_pll_clks,
+				ARRAY_SIZE(PRJ007_pll_clks), reg_base);
+
+
+	/* Register Muxs */
+	ingenic_clk_register_mux(ctx, PRJ007_mux_clks, ARRAY_SIZE(PRJ007_mux_clks));
+
+	/* Register Bus Divs */
+	ingenic_clk_register_bus_div(ctx, PRJ007_bus_div_clks, ARRAY_SIZE(PRJ007_bus_div_clks));
+#ifdef CONFIG_PM
+	ingenic_clk_sleep_init(reg_base, PRJ007_clk_reg_sleep, PRJ007_nr_clk_reg_sleep);
+#endif
+	/* Register Divs */
+	clk_div_table_generate();
+	clk_div_table_sfc(reg_base);
+	ingenic_clk_register_cgu_div(ctx, PRJ007_div_clks, ARRAY_SIZE(PRJ007_div_clks));
+
+	/* Register Fractional Divs */
+	ingenic_clk_register_fra_div(ctx, PRJ007_fdiv_clks, ARRAY_SIZE(PRJ007_fdiv_clks));
+
+	/* Register Gates */
+	ingenic_clk_register_gate(ctx, PRJ007_gate_clks, ARRAY_SIZE(PRJ007_gate_clks));
+
+	/* Register Powers */
+//	ingenic_power_register_gate(ctx, PRJ007_gate_power, ARRAY_SIZE(PRJ007_gate_power));
+
+	ingenic_clk_of_add_provider(np, ctx);
+
+
+	//ingenic_clk_of_dump(ctx);
+
+
+#if 0
+	pr_info("=========== PRJ007 clocks: =============\n"
+		"\tapll     = %lu , mpll     = %lu\n"
+		"\tcpu_clk  = %lu , l2c_clk  = %lu\n"
+		"\tahb0_clk = %lu , ahb2_clk = %lu\n"
+		"\tapb_clk  = %lu , ext_clk  = %lu, ddr_clk  = %lu\n\n",
+		_get_rate("apll"),	_get_rate("mpll"),
+		_get_rate("div_cpu"), _get_rate("div_l2c"),
+		_get_rate("div_ahb0"), _get_rate("div_ahb2"),
+		_get_rate("div_apb"), _get_rate("ext"), _get_rate("div_ddr"));
+#endif
+
+}
+
+CLK_OF_DECLARE(PRJ007_clk, "ingenic,PRJ007-clocks", PRJ007_clk_init);
