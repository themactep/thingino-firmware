diff -ruN --no-dereference '--exclude=.git' common/drivers/mtd/devices/ingenic_sfc_v2/sfc_flash.h tree-t32/drivers/mtd/devices/ingenic_sfc_v2/sfc_flash.h
--- common/drivers/mtd/devices/ingenic_sfc_v2/sfc_flash.h	1969-12-31 19:00:00.000000000 -0500
+++ tree-t32/drivers/mtd/devices/ingenic_sfc_v2/sfc_flash.h	2026-10-09 03:36:53.986227661 -0400
@@ -0,0 +1,36 @@
+#ifndef __SFC_FLASH_H
+#define __SFC_FLASH_H
+#include <linux/device.h>
+#include <linux/mutex.h>
+#include <linux/mtd/mtd.h>
