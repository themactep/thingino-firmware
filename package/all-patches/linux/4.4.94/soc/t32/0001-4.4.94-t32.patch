diff -ruN --no-dereference '--exclude=.git' common/drivers/pinctrl/pinctrl-ingenic.c tree-t32/drivers/pinctrl/pinctrl-ingenic.c
--- common/drivers/pinctrl/pinctrl-ingenic.c	1969-12-31 19:00:00.000000000 -0500
+++ tree-t32/drivers/pinctrl/pinctrl-ingenic.c	2026-10-09 03:36:54.318530748 -0400
@@ -0,0 +1,1840 @@
+/*
+ * pinctrl/ingenic/pinctrl-ingenic.c
+ *
+ * Copyright 2015 Ingenic Semiconductor Co.,Ltd
+ *
+ * Author: cli <chen.li@ingenic.com>
+ *
