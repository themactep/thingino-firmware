+    unsigned long tmp;
+    if (len >= 4) {
+        for (i=0; i<len; i += 2) {
+            tmp = base[i][1];
+            base[i][1] = base[i+1][1];
+            base[i+1][1] = tmp;
+        }
+    }
+    return 0;
+}
