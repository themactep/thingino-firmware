+static struct platform_driver audio_dsp_driver = {
+	.probe = audio_dsp_probe,
+	.remove = __exit_p(audio_dsp_remove),
+	.driver = {
+		.name = "jz-dsp",
+		.owner = THIS_MODULE,
+#ifdef CONFIG_PM
+		.pm = &audio_dsp_pm_ops,
+#endif
+	},
+};
