+static struct vpu_ops vpu_ops = {
+	.owner		= THIS_MODULE,
+	.open		= vpu_open,
+	.release	= vpu_release,
+	.start_vpu	= vpu_start,
+	.wait_complete	= vpu_wait_complete,
