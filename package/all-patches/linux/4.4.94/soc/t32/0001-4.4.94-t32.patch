+	switch(device_id) {
+		case 0xB1 ... 0xB4:
+		case 0xA1:
+			gd_nand->cdt_params.standard_r.addr_nbyte = 3;
+			gd_nand->cdt_params.quad_r.addr_nbyte = 3;
+			break;
+		case 0xD1 ... 0xD4:
+			break;
+		case 0x51 ... 0x52:
+			break;
+		case 0x91 ... 0x92:
+			break;
+		case 0x01: // esmt nand F50L1G41LB
+			break;
+		case 0x21: // ISSI nand IS37SML01G
+			break;
+		case 0x95:
