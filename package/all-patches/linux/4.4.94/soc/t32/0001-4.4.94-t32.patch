+
+typedef struct rsa_data {
+	unsigned int *e_or_d;
+    unsigned int *n;
+    unsigned int rsa_mode;
+    unsigned int *input;
+    unsigned int inlen;
+    unsigned int *output;
+    unsigned int mode;
+}rsa_data_t;
