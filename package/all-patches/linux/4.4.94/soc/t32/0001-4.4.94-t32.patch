+#define I2S_ASVTSU_MASK        (0x1 << I2S_ASVTSU_OFFSET)
+#define I2S_ENDSW_OFFSET       (10)
+#define I2S_ENDSW_MASK         (0x1 << I2S_ENDSW_OFFSET)
+#define I2S_M2S_OFFSET         (11)
+#define I2S_M2S_MASK           (0x1 << I2S_M2S_OFFSET)
