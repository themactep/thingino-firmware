+static int set_codec_spk_again(struct audio_aic_device *aic, void *data)
+{
+	int ret = 0;
+	struct volume again = *(struct volume*)data;
+	if (NULL == aic || NULL == aic->livingcodec) {
+		audio_err_print("aic is null or livingcodec is null.\n");
