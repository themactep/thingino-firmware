+#ifdef CONFIG_JZ_VPU_KERN_ENCODE_H264
+int vpu_h264_buf_exit(struct vpu_inst *chn)
+{
+	vpu_wrap_free_linear(chn->stream_buffer, chn->buf_size);
+	return 0;
+}
+#endif
