+		if(cnt > 10)
+		reg_write(fbdev, DC_CMPW_PCFG_CTRL, 0 << 10 | 30);
+		spin_unlock(&fbdev->irq_lock);
+		return IRQ_HANDLED;
+	}
+#endif
+
+	dev_err(fbdev->dev, "DPU irq nothing do, please check!!! DC_ST = 0x%lx\n",reg_read(fbdev,DC_ST));
+	spin_unlock(&fbdev->irq_lock);
+	return IRQ_HANDLED;
+}
