+    seq_printf(m, "channel : %d\n", info->record_channel);
+    seq_printf(m, "format : %d\n", info->record_format);
+    seq_printf(m, "gain : %u\n", info->gain);
+	seq_printf(m, "frame rate : %d\n", dmic_debug.frame_rate / 2);
