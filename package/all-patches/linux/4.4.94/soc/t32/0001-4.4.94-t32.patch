+static void ingenic_aes_finish_req(struct ingenic_aes_dev *aes, int err)
+{
+	struct ablkcipher_request *req = aes->req;
+	pr_debug("err: %d\n", err);
+
+	aes->flags &= ~FLAGS_BUSY;
+	req->base.complete(&req->base, err);
+	unsigned int mode = (aes->flags & FLAGS_DECRYPT) == FLAGS_DECRYPT ? DECRYPTO_MODE : ENCRYPTO_MODE;
+	if(mode == ENCRYPTO_MODE){
+		memcpy(aes->ctx->updateiv, sg_virt(&aes->out_sgl)+ aes->out_sgl.length - 16, 16);
+	}
+	mutex_unlock(&aes->mlock);
+
+}
