+static inline u32 pin_bitmap(u32 from, u32 to)
+{
+	if (to == 31)
+		return ~((1<<(from))-1);
+	return ((~((1<<(from))-1))&((1 << ((to)+1))-1));
+}
+
+static inline unsigned bit_count(unsigned v)
+{
+	unsigned int c;
+	for (c = 0; v; c++)
+		v &= v - 1;
+	return c;
+}
