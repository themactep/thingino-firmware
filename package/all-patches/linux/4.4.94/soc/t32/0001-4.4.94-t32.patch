+	printk("LDC_ADDR_Y_DMAIN_STRIDE  = 0x%08x\n",reg_read(ldc, LDC_ADDR_Y_DMAIN_STRIDE));
+    reg_write(ldc, LDC_ADDR_Y_DMAOT_ADDR, ldc_init->out_addr);
+	printk("LDC_ADDR_Y_DMAOT_ADDR  = 0x%08x\n",reg_read(ldc, LDC_ADDR_Y_DMAOT_ADDR));
+    reg_write(ldc, LDC_ADDR_Y_DMAOT_STRIDE, ldc_default_params[sheet].y_str);
+	printk("LDC_ADDR_Y_DMAOT_STRIDE = 0x%08x\n",reg_read(ldc, LDC_ADDR_Y_DMAOT_STRIDE));
+
+    //set uv
+    reg_write(ldc, LDC_ADDR_UV_DMAIN_ADDR, ldc_init->in_addr + offset);
+	printk("LDC_ADDR_UV_DMAIN_ADDR  = 0x%08x\n",reg_read(ldc, LDC_ADDR_UV_DMAIN_ADDR));
+    reg_write(ldc, LDC_ADDR_UV_DMAIN_STRIDE, ldc_default_params[sheet].uv_str);
+	printk("LDC_ADDR_UV_DMAIN_STRIDE  = 0x%08x\n",reg_read(ldc, LDC_ADDR_UV_DMAIN_STRIDE));
+    reg_write(ldc, LDC_ADDR_UV_DMAOT_ADDR, ldc_init->out_addr + offset);
+	printk("LDC_ADDR_UV_DMAOT_ADDR  = 0x%08x\n",reg_read(ldc, LDC_ADDR_UV_DMAOT_ADDR));
+    reg_write(ldc, LDC_ADDR_UV_DMAOT_STRIDE, ldc_default_params[sheet].uv_str);
+	printk("LDC_ADDR_UV_DMAOT_STRIDE  = 0x%08x\n",reg_read(ldc, LDC_ADDR_UV_DMAOT_STRIDE));
+
+    reg_write(ldc, LDC_ADDR_LEN_COEF, ldc_default_params[sheet].len_cofe);
+	printk("LDC_ADDR_LEN_COEF = 0x%08x\n",reg_read(ldc, LDC_ADDR_LEN_COEF));
+    return ret;
+}
