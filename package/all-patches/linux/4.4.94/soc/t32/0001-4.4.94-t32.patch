+         __i2s_disable_signadj(aic);
+         __i2s_disable_byteswap(aic);
+         aic->incodec->playback->set_datatype(&aic->codec_spk_info->data_type);
+         //aic->livingcodec->set_sign(&aic->codec_spk_info->transfer_info);
+         aic->incodec->playback->set_again(MONO_LEFT,aic->codec_spk_info->lagain);
+         aic->incodec->playback->set_endpoint(CODEC_SPK_START);
+         __i2s_flush_tfifo(aic);
+         __i2s_enable_transmit_dma(aic);
+         __i2s_enable_replay(aic);
+     }
+     return 0;
+#if defined(CONFIG_KERNEL_4_4_94) || defined(CONFIG_KERNEL_5_15)
+err_get_aic_clk:
+    devm_clk_put(&pdev->dev, aic->mic_clock);
+err_get_i2s_mic:
