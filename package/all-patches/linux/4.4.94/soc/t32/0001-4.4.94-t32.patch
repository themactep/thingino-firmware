+	TFT_LCD_COLOR_ODD_RBG = (1 << 2),
+	TFT_LCD_COLOR_ODD_BGR = (2 << 2),
+	TFT_LCD_COLOR_ODD_BRG = (3 << 2),
+	TFT_LCD_COLOR_ODD_GBR = (4 << 2),
