+int osd_thread_create(IMP_Sample_OsdParam *ipuosdparam)
+{
+	int err;
+	struct task_struct *osd_task;
+	ipuosdparam->osd_task = kthread_run(update_thread, ipuosdparam, "ipu_osd_update");
+	osd_task = ipuosdparam->osd_task;
