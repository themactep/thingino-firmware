+void dump_sgdata(struct scatterlist *sg)
+{
+	int i;
+	unsigned int *d =  sg_virt(sg);
+	for(i = 0;i < sg->length;i += 4)
+	{
+		printk("%5d:0x%08x\n",i,d[i/4]);
+	}
+}
