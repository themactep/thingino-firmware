+#ifdef CONFIG_JZ_VPU_KERN_ENCODE_JPEG
+int vpu_jpeg_buf_exit(struct vpu_inst *chn)
+{
+	vpu_wrap_free_linear(chn->stream_buffer, chn->buf_size);
+	return 0;
+}
