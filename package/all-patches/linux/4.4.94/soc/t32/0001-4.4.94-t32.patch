+            c32 = 0xFFFFFFFF;
+            _c32 = 0x0000FF00;
+            c16 = 0xFFFF;
+            _c16 = 0x07E0;
+            switch (bpp) {
+            case 32:
+                *p32++ = c32;
+                *_p32++ = _c32;
