+static int desc_list_init(struct ingenic_mac_local *lp)
+{
+	if (desc_list_init_rx(lp) < 0)
+		goto init_error;
+
+	if (desc_list_init_tx(lp) < 0)
+		goto init_error;
+
+	//ingenic_mac_dump_all_desc(lp);
+	return 0;
+
+init_error:
+	desc_list_free(lp);
+	printk(KERN_ERR INGENIC_MAC_DRV_NAME ": kmalloc failed\n");
+	return -ENOMEM;
+}
