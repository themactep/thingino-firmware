+					ret = -EBADMSG;
+					break;
+				default:
+					ret = 0;
+					break;
+			}
+			break;
+		case 0x01: //esmt nand F50L1G41LB
+		case 0x21: //ISSI nand IS37SML01G
+			switch ((ecc_status >> 4) & 0x3){
+				case 0x2:
+					dev_err(flash->dev, "SFC ECC:Bit errors greater than %d bits detected and not corrected.\n", gd_param[10].ecc_max);
+					ret = -EBADMSG;
+					break;
+				default:
+					ret = 0x0;
+			}
+			break;
+		case 0x95:
+			switch((ecc_status >> 4) & 0x3) {
+				case 0x2:
+					dev_err(flash->dev, "SFC ECC:Bit errors greater than %d bits detected and not corrected.\n", gd_param[13].ecc_max);
