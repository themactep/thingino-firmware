+static int set_codec_type(struct audio_aic_device *aic, void *data)
+{
+	int ret = 0;
+	int codec = *(int *)data;
+	if(codec_type_select == codec)
+		return ret;
+
+	if (NULL == aic->incodec || NULL == aic->excodec) {
+		audio_err_print("if you want switch internal or external codec, you need enable both(codec_use=2)\n");
+		return -1;
+	}
+
+	switch (codec_type_select) {
+		case INNER_CODEC_ONLY:
+			set_codec_mic_stop(aic,NULL);
+			aic->incodec->set_power(CODEC_POWER_DOWN);
+			aic->incodec->spk_gpio_free();
+			break;
+		case EXTERNAL_CODEC_ONLY:
+			set_codec_mic_stop(aic,NULL);
+			aic->excodec->set_power(CODEC_POWER_DOWN);
+			aic->excodec->spk_gpio_free();
+			break;
+		case INNER_MIC_EXTERNAL_SPK:
+			set_codec_mic_stop(aic,NULL);
+			aic->incodec->set_power(CODEC_POWER_DOWN);
+			aic->excodec->set_power(CODEC_POWER_DOWN);
+			aic->excodec->spk_gpio_free();
+			break;
+		case INNER_SPK_EXTERNAL_MIC:
+			set_codec_mic_stop(aic,NULL);
+			aic->incodec->set_power(CODEC_POWER_DOWN);
+			aic->excodec->set_power(CODEC_POWER_DOWN);
+			aic->incodec->spk_gpio_free();
+			break;
+		default:
+			audio_err_print("Invalid codec type: %d\n", codec_type_select);
+			break;
+	}
+
+
+	if (INNER_CODEC_ONLY == codec || INNER_SPK_EXTERNAL_MIC == codec) {
+		aic->incodec->spk_gpio_request();
+	}else {
+		aic->excodec->spk_gpio_request();
+	}
+	printk("the codec type is %d \n",codec);
+
+	if (EXTERNAL_CODEC_ONLY == codec) {
+		__i2s_only_external_codec(aic);
+
+		if(CODEC_IS_MASTER_MODE == aic->excodec->mode) {
+			//set codec master mode, AIC slave mode
+			__i2s_external_slave_mic_clkset(aic);
+			__i2s_external_slave_spk_clkset(aic);
+		}else if(CODEC_IS_SLAVE_MODE == aic->excodec->mode) {
+			__i2s_external_master_mic_clkset(aic);
+			__i2s_external_master_spk_clkset(aic);
+		}
+
+		if(CODEC_IS_4_LINES == aic->excodec->pins) {
+			__i2s_select_share_clk(aic);
+		}
+		else if(CODEC_IS_6_LINES == aic->excodec->pins||CODEC_IS_0_LINES == aic->excodec->pins) {
+			__i2s_select_spilt_clk(aic);
+		}
+
+		if(DATA_RIGHT_JUSTIFIED_MODE == aic->excodec->transfer_protocol ||
+				DATA_LEFT_JUSTIFIED_MODE == aic->excodec->transfer_protocol) {
+			__i2s_select_msbjustified(aic);
+			printk("excodec use msbjustified mode\n");
+		}else {
+			__i2s_select_i2s(aic);
+			printk("excodec use i2s mode\n");
+		}
+		stream_select = 3;
+		aic->excodec->set_power(CODEC_POWER_UP);
+		printk("@@@@@ excodec codec power up@@@@@@\n");
+	} else if(INNER_CODEC_ONLY == codec) {
+		//aic: slave mode, codec master mode
+		__i2s_only_internal_codec(aic);
+		__i2s_internal_slave_mic_clkset(aic);
+		__i2s_internal_slave_spk_clkset(aic);
+		__i2s_select_share_clk(aic);
+		__i2s_select_i2s(aic);
+		printk("incodec use i2s mode\n");
+		stream_select = 2;
+		aic->incodec->set_power(CODEC_POWER_UP);
+		printk("@@@@@ inner codec power up@@@@@@\n");
+	}else if(INNER_MIC_EXTERNAL_SPK == codec) {
+		__i2s_external_dac_codec(aic);//incodecå½•éŸ³ï¼Œexcodecæ”¾éŸ³
+		__i2s_internal_slave_mic_clkset(aic);
+
+		if(CODEC_IS_MASTER_MODE == aic->excodec->mode) {
+			__i2s_external_slave_spk_clkset(aic);
+		}else {
+			__i2s_external_master_spk_clkset(aic);
+		}
+
+		if(CODEC_IS_4_LINES == aic->excodec->pins) {
+			__i2s_select_share_clk(aic);
+		}
+		else if(CODEC_IS_6_LINES == aic->excodec->pins || CODEC_IS_0_LINES == aic->excodec->pins) {
+			__i2s_select_spilt_clk(aic);
+		}
+
+		if(DATA_RIGHT_JUSTIFIED_MODE == aic->excodec->transfer_protocol ||
+				DATA_LEFT_JUSTIFIED_MODE == aic->excodec->transfer_protocol) {
+			__i2s_select_msbjustified(aic);
+			printk("incodec and excodec use msbjustified mode\n");
+		}else {
+			__i2s_select_i2s(aic);
+			printk("incodec and excodec use i2s mode\n");
+		}
+		stream_select = 1;
+		aic->incodec->set_power(CODEC_POWER_UP);
+		aic->excodec->set_power(CODEC_POWER_UP);
+		printk("@@@@@ incodec & excodec power up@@@@@@\n");
+	}else if(INNER_SPK_EXTERNAL_MIC == codec) {
+		__i2s_external_adc_codec(aic);//excodecå½•éŸ³ï¼Œincodecæ”¾éŸ³
+		__i2s_internal_slave_spk_clkset(aic);
+
+		if(CODEC_IS_MASTER_MODE == aic->excodec->mode) {
+			__i2s_external_slave_mic_clkset(aic);
+		}else {
+			__i2s_external_master_mic_clkset(aic);
+		}
+
+		if(CODEC_IS_4_LINES == aic->excodec->pins) {
+			__i2s_select_share_clk(aic);
+		}
+		else if(CODEC_IS_6_LINES == aic->excodec->pins || CODEC_IS_0_LINES == aic->excodec->pins) {
+			__i2s_select_spilt_clk(aic);
+		}
+
+		if(DATA_RIGHT_JUSTIFIED_MODE == aic->excodec->transfer_protocol ||
+				DATA_LEFT_JUSTIFIED_MODE == aic->excodec->transfer_protocol) {
+			__i2s_select_msbjustified(aic);
+			printk("incodec and excodec use msbjustified mode\n");
+		}else {
+			__i2s_select_i2s(aic);
+			printk("incodec and excodec use i2s mode\n");
+		}
+		stream_select = 0;
+		aic->incodec->set_power(CODEC_POWER_UP);
+		aic->excodec->set_power(CODEC_POWER_UP);
+		printk("@@@@@ incodec & excodec power up@@@@@@\n");
+	}
+
+	set_codec_mic_datatype(aic, &micparam);
+	set_codec_mic_start(aic, NULL);
+	set_codec_mic_again(aic, &gain_bk);
+	codec_type_select = codec;
+	return 0;
+}
