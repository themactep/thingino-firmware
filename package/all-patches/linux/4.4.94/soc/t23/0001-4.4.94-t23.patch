+static void ingenic_mdio_phy_write(struct net_device *dev, int phy_id, int location, int value)
+{
+	struct ingenic_mac_local *lp = netdev_priv(dev);
+
+	ingenic_mdiobus_write(lp->mii_bus, phy_id, location, value);
+}
