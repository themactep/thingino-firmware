+
+	//VMAU
+	printk("-----------VMAU_REG------------\n");
+	dump_helix_state(vpu, vmau_base, 31);
+
+	//SDE
+	printk("-----------SDE_REG-------------\n");
+	dump_helix_state(vpu, sde_base, 7);
+	printk("----------------helix_show_internal_state end------------\n");
+}
+#endif
