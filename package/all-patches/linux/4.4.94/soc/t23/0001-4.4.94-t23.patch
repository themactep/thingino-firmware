+static inline void sfc_init(struct sfc *sfc)
+{
+	sfc_writel(sfc, SFC_TRIG, TRIG_STOP);
+	sfc_writel(sfc, SFC_DEV_CONF, 0);
+
+	/* X1000 need set to 0,but X2000 can be set to 1*/
+	sfc_writel(sfc, SFC_CGE, 0);
+
