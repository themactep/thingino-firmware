+static int create_debug_sysfs_interface(struct device *dev)
+{
+	int i;
+	for (i = 0; i < ARRAY_SIZE(attributes); i++)
+		if (device_create_file(dev, attributes + i))
+			goto err;
+	return 0;
+
+err:
+	for( ; i >= 0; i--)
+		device_remove_file(dev, attributes + i);
+	return -1;
+}
+#endif
