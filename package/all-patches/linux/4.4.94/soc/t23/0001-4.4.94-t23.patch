+
+	/* set transfer config */
+	xfer.dataen = DISABLE;
+
+	if(sfc_sync_cdt(flash->sfc, &xfer)) {
+		printk("sfc_sync error! %s %s %d\n", __FILE__, __func__, __LINE__);
+		ret = -EIO;
+	}
+
+	return ret;
+}
