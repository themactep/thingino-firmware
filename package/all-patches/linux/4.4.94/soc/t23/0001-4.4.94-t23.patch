+		o = (n) % 32;			\
+		REG_GPIO_PXIMS(p) = (1 << o);	\
+		REG_GPIO_PXTRGS(p) = (1 << o);	\
+		REG_GPIO_PXFUNC(p) = (1 << o);	\
+		REG_GPIO_PXSELS(p) = (1 << o);	\
+		REG_GPIO_PXDIRS(p) = (1 << o);	\
+		REG_GPIO_PXFLGC(p) = (1 << o);	\
