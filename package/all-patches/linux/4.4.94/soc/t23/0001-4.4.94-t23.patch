+static void handle_add_map(struct device *dev,struct dmmu_handle *h,unsigned long vaddr,unsigned long len)
+{
+	struct map_node *n = kmalloc(sizeof(*n),GFP_KERNEL);
+	n->dev = dev;
+	n->start = vaddr;
+	n->len = len;
