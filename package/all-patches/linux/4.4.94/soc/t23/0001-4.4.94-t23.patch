+	} else {
+		dev_info(&pdev->dev, "lcd device(TRULY TFT240320) register success\n");
+	}
+
+	if (dev->ctrl->power_on) {
+		dev->ctrl->power_on(dev->lcd, 1);
+		dev->lcd_power = FB_BLANK_UNBLANK;
+	}
+
