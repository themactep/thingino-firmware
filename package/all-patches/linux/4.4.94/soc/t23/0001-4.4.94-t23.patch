+#define TPP		500
+#define TBE		3
+
+static struct ingenic_sfcnand_device *ato_nand;
+
+static struct ingenic_sfcnand_base_param ato25d1ga_param = {
+
+	.pagesize = 2 * 1024,
+	.oobsize = 64,
+	.blocksize = 2 * 1024 * 64,
+	.flashsize = 2 * 1024 * 64 * 1024,
+
+	.tSETUP = TSETUP,
+	.tHOLD  = THOLD,
+	.tSHSL_R = TSHSL_R,
+	.tSHSL_W = TSHSL_W,
+
+	.tRD = TRD,
+	.tPP = TPP,
+	.tBE = TBE,
+
+	.plane_select = 0,
+	.ecc_max = 0,//0x3,
+#ifdef SPI_STANDARD_MODE
+	.need_quad = 0,
+#else
+	.need_quad = 1,
+#endif
+
+};
+
+static struct device_id_struct device_id[ATO_DEVICES_NUM] = {
+	DEVICE_ID_STRUCT(0x12, "ATO25D1GA", &ato25d1ga_param),
+};
