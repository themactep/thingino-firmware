+static int32_t sfc_stop(struct sfc *sfc)
+{
+	int32_t timeout = 0xffff;
+	sfc_writel(sfc, SFC_TRIG, TRIG_STOP);
+
+	while((sfc_readl(sfc, SFC_SR) & SFC_BUSY) && timeout--);
+	if(timeout < 0)
+		return -EIO;
+	return 0;
+}
