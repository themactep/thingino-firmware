+
+
+	if(unlikely(irq_flag & DC_TFT_UNDR)) {
+		reg_write(fbdev, DC_CLR_ST, DC_CLR_TFT_UNDR);
+		dbg_irqcnt_inc(fbdev->dbg_irqcnt, tft_under);
+		fbdev->tft_undr_cnt++;
+#ifdef CONFIG_FPGA_TEST
+		if (!(fbdev->tft_undr_cnt % 100000)) //FIXME:
+#endif
