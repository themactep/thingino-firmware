--- common/drivers/pwm/pwm-ingenic.c	1969-12-31 19:00:00.000000000 -0500
+++ tree-t23/drivers/pwm/pwm-ingenic.c	2026-10-09 03:36:47.615756470 -0400
@@ -0,0 +1,487 @@
