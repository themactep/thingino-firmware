+#define I2C_STA_RFF		(1 << 4)	/* RFIFO if full */
+#define I2C_STA_RFNE		(1 << 3)	/* RFIFO is not empty */
+#define I2C_STA_TFE		(1 << 2)	/* TFIFO is empty */
+#define I2C_STA_TFNF		(1 << 1)	/* TFIFO is not full  */
