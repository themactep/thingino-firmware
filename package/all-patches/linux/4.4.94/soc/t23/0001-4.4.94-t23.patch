+void helix_show_internal_state(struct jz_vpu_helix *vpu)
+{
+	unsigned int cfgc_base = 0;
+	unsigned int vdma_base = 0x10000;
+	unsigned int efe_base = 0x40000;
+	unsigned int vmau_base = 0x80000;
