+	.owner= THIS_MODULE,
+	.open= ingenic_adc_aux_open,
+	.release= ingenic_adc_aux_release,
+	.read= ingenic_adc_aux_read,
+	.unlocked_ioctl= ingenic_adc_aux_ioctl,
+};
