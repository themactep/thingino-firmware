+#define I2C_INTM_MTXEMP		(1 << 4)
+#define I2C_INTM_MTXOF		(1 << 3)
+#define I2C_INTM_MRXFL		(1 << 2)
+#define I2C_INTM_MRXOF		(1 << 1)
+#define I2C_INTM_MRXUF		(1 << 0)
