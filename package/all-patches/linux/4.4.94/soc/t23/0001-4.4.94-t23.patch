+static int enter_4byte(struct sfc_flash *flash)
+{
+	struct sfc_cdt_xfer xfer;
+	int32_t ret = 0;
+
+	memset(&xfer, 0, sizeof(xfer));
+
+	/* set index */
+	xfer.cmd_index = NOR_EN_4BYTE;
+
+	/* set addr */
