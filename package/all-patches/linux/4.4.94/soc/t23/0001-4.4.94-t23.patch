+static ssize_t pwm_show_enable(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct ingenic_pwm_chip *ingenic_pwm = dev_get_drvdata(dev);
+	return sprintf(buf, "%x", pwm_enable_status(ingenic_pwm));
+}
