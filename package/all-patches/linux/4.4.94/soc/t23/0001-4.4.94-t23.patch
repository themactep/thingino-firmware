+++ tree-t23/drivers/pinctrl/pinctrl-ingenic.c	2026-10-09 03:36:47.591018343 -0400
@@ -0,0 +1,1800 @@
+/*
+ * pinctrl/ingenic/pinctrl-ingenic.c
+ *
+ * Copyright 2015 Ingenic Semiconductor Co.,Ltd
+ *
+ * Author: cli <chen.li@ingenic.com>
+ *
