+static int __init ato_nand_init(void) {
+	struct ingenic_sfcnand_device *ato_nand;
+	ato_nand = kzalloc(sizeof(*ato_nand), GFP_KERNEL);
+	if(!ato_nand) {
+		pr_err("alloc ato_nand struct fail\n");
+		return -ENOMEM;
+	}
+
+	ato_nand->id_manufactory = 0x9B;
