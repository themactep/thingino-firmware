+__attribute__((__unused__)) static int get_tx_index_by_desc(struct ingenic_mac_local *lp, DmaDesc *desc) {
+	int i = 0;
+
+	for (i = 0; i < INGENIC_MAC_TX_DESC_COUNT; i++) {
+		if ( (lp->tx_ring.desc + i) == desc)
+			return i;
+	}
+
+	BUG_ON(i == INGENIC_MAC_TX_DESC_COUNT);
+	return -1;
+}
