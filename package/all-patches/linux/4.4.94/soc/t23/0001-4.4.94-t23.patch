+static void wait_busy()
+{
+    int count = 10000;
+    while ((reg_read(jzfb, LCDC_SLCD_ST) & SLCD_ST_BUSY)
+           && count--) {
+        udelay(10);
+    }
+    if (count < 0) {
+        dev_err(jzfb->dev,
+                "SLCDC wait busy state wrong");
+    }
+}
