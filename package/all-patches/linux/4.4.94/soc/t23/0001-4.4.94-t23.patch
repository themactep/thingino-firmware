+void prom_printk(const char *fmt, ...) {
+	va_list args;
+
+	va_start(args, fmt);
+	vsnprintf(pbuffer, 4096, fmt, args);
+	va_end(args);
+
+	prom_putstr(pbuffer);
+}
+#endif
