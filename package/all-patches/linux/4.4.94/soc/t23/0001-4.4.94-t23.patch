+#ifdef CONFIG_OF
+static const struct of_device_id ingenic_wdt_of_matches[] = {
+	{ .compatible = "ingenic,watchdog", },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, ingenic_wdt_of_matches)
+#endif
