+int ingenic_adc_aux_open(struct inode *inode, struct file *filp)
+{
+	//struct miscdevice *dev = filp->private_data;
+	//struct ingenic_adc_aux *axu = container_of(dev, struct ingenic_adc_aux, mdev);
+	return 0;
+}
