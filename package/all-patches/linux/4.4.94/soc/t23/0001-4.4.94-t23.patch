+		.attrs = lcd_layer2_attrs,
+};
+static struct attribute_group lcd_layer3_group = {
+		.name = "layer3",
+		.attrs = lcd_layer3_attrs,
+};
+
+static const struct attribute_group *lcd_layerx_groups[] = {
+	&lcd_layer0_group,
+	&lcd_layer1_group,
+	&lcd_layer2_group,
+	&lcd_layer3_group,
+	NULL,
+};
