From: Thingino <dev@thingino.com>
Subject: [PATCH] mmc: jz4740: keep the SD clock running for ingenic,sdio_clk hosts

The vendor Ingenic trees treat SDIO hosts specially: jzmmc_set_ios()
writes CTRL_CLOCK_START and never LPM_LPM, keeps the SD clock running
across transfers instead of stopping it after every command, and keeps the
CGU gate open across power transitions. The mainline jz4740_mmc driver
ignores all of that (and enables LPM above 25 MHz, which stops the clock).

Parse `ingenic,sdio_clk` and, when set:
 - skip the LPM programming;
 - do not gate the MSC clock between transfers (jz4740_mmc_clock_disable);
 - leave the MSC clock enabled on MMC_POWER_OFF;
 - enable the MSC clock at probe and keep it running.

Boards that already carry the property (the cinnado_d1 fragment sets it to
<1>) then get the vendor's SDIO clock behaviour.

--- a/drivers/mmc/host/jz4740_mmc.c
+++ b/drivers/mmc/host/jz4740_mmc.c
@@ -162,6 +162,10 @@ struct jz4740_mmc_host {
 
 	bool vqmmc_enabled;
 
+	/* SDIO needs the clock kept out of low-power mode (vendor
+	 * "ingenic,sdio_clk" property). */
+	bool sdio_clk;
+
 	unsigned long waiting;
 
 	uint32_t cmdat;
@@ -435,6 +439,16 @@ static void jz4740_mmc_clock_disable(struct jz4740_mmc_host *host)
 	uint32_t status;
 	unsigned int timeout = 1000;
 
+	/*
+	 * SDIO cards need a continuously running SD clock (the vendor driver
+	 * writes CTRL_CLOCK_START and never stops it for sdio_clk hosts), so
+	 * do not gate the clock between transfers.
+	 */
+	if (host->sdio_clk) {
+		writew(JZ_MMC_STRPCL_CLOCK_START, host->base + JZ_REG_MMC_STRPCL);
+		return;
+	}
+
 	writew(JZ_MMC_STRPCL_CLOCK_STOP, host->base + JZ_REG_MMC_STRPCL);
 	do {
 		status = readl(host->base + JZ_REG_MMC_STATUS);
@@ -903,7 +917,7 @@ static int jz4740_mmc_set_clock_rate(struct jz4740_mmc_host *host, int rate)
 
 	writew(div, host->base + JZ_REG_MMC_CLKRT);
 
-	if (real_rate > 25000000) {
+	if (real_rate > 25000000 && !host->sdio_clk) {
 		if (host->version >= JZ_MMC_JZ4780) {
 			writel(JZ_MMC_LPM_DRV_RISING_QTR_PHASE_DLY |
 				   JZ_MMC_LPM_SMP_RISING_QTR_OR_HALF_PHASE_DLY |
@@ -969,7 +983,13 @@ static void jz4740_mmc_set_ios(struct mmc_host *mmc, struct mmc_ios *ios)
 			regulator_disable(mmc->supply.vqmmc);
 			host->vqmmc_enabled = false;
 		}
-		clk_disable_unprepare(host->clk);
+		/*
+		 * SDIO hosts keep the MSC clock gated open across power
+		 * transitions (the vendor never gates it), otherwise the card
+		 * loses its clock and stops answering.
+		 */
+		if (!host->sdio_clk)
+			clk_disable_unprepare(host->clk);
 		break;
 	default:
 		break;
@@ -1061,6 +1081,14 @@ static int jz4740_mmc_probe(struct platform_device *pdev)
 
 	mmc_regulator_get_supply(mmc);
 
+	{
+		u32 sdio_clk = 0;
+
+		if (!of_property_read_u32(pdev->dev.of_node, "ingenic,sdio_clk",
+					  &sdio_clk))
+			host->sdio_clk = !!sdio_clk;
+	}
+
 	host->irq = platform_get_irq(pdev, 0);
 	if (host->irq < 0)
 		return host->irq;
@@ -1074,6 +1102,10 @@ static int jz4740_mmc_probe(struct platform_device *pdev)
 	if (IS_ERR(host->base))
 		return PTR_ERR(host->base);
 
+	/* SDIO hosts keep the MSC clock running from probe on. */
+	if (host->sdio_clk)
+		clk_prepare_enable(host->clk);
+
 	mmc->ops = &jz4740_mmc_ops;
 	if (!mmc->f_max)
 		mmc->f_max = JZ_MMC_CLK_RATE;
