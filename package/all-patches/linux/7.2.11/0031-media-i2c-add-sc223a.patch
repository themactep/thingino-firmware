+static int sc223a_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+
+	dev_info(dev, "sc223a: probe at i2c 0x%02x\n", client->addr);
+	struct sc223a *sc223a;
+	unsigned int i;
+	unsigned long xclk_freq;
+	int ret;
+
+	sc223a = devm_kzalloc(dev, sizeof(*sc223a), GFP_KERNEL);
+	if (!sc223a)
+		return -ENOMEM;
+
+	v4l2_i2c_subdev_init(&sc223a->sd, client, &sc223a_subdev_ops);
+	sc223a->sd.internal_ops = &sc223a_subdev_internal_ops;
+
+	ret = sc223a_check_hwcfg(dev);
+	if (ret)
+		return ret;
+
+	sc223a->xclk = devm_v4l2_sensor_clk_get(dev, NULL);
+	if (IS_ERR(sc223a->xclk))
+		return dev_err_probe(dev, PTR_ERR(sc223a->xclk),
+				     "failed to get xclk\n");
+
+	xclk_freq = clk_get_rate(sc223a->xclk);
+	if (xclk_freq != SC223A_XCLK_FREQ)
+		return dev_err_probe(dev, -EINVAL,
+				     "xclk frequency %lu Hz not supported\n",
+				     xclk_freq);
+
+	for (i = 0; i < ARRAY_SIZE(sc223a->supplies); i++)
+		sc223a->supplies[i].supply = sc223a_supply_names[i];
+
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(sc223a->supplies),
+				      sc223a->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get regulators\n");
+
+	sc223a->reset_gpio = devm_gpiod_get_optional(dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(sc223a->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(sc223a->reset_gpio),
+				     "failed to get reset gpio\n");
+
+	sc223a->powerdown_gpio = devm_gpiod_get_optional(dev, "powerdown",
+							 GPIOD_OUT_HIGH);
+	if (IS_ERR(sc223a->powerdown_gpio))
+		return dev_err_probe(dev, PTR_ERR(sc223a->powerdown_gpio),
+				     "failed to get powerdown gpio\n");
+
+	sc223a->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(sc223a->regmap))
+		return dev_err_probe(dev, PTR_ERR(sc223a->regmap),
+				     "failed to get cci regmap\n");
+
+	ret = sc223a_power_on(dev);
+	if (ret)
+		return ret;
+
+	ret = sc223a_identify_module(sc223a);
+	if (ret)
+		goto err_power_off;
+
+	sc223a->mode = &sc223a_modes[0];
+
+	ret = sc223a_init_controls(sc223a);
+	if (ret)
+		goto err_power_off;
+
+	sc223a->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	sc223a->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	sc223a->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&sc223a->sd.entity, 1, &sc223a->pad);
+	if (ret)
+		goto err_handler_free;
+
+	sc223a->sd.state_lock = sc223a->ctrls.handler.lock;
+	ret = v4l2_subdev_init_finalize(&sc223a->sd);
+	if (ret)
+		goto err_media_entity;
+
+	pm_runtime_set_active(dev);
+	pm_runtime_get_noresume(dev);
+	pm_runtime_enable(dev);
+	pm_runtime_set_autosuspend_delay(dev, 1000);
+	pm_runtime_use_autosuspend(dev);
+	pm_runtime_put_autosuspend(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&sc223a->sd);
+	if (ret)
+		goto err_subdev_cleanup;
+
+	return 0;
+
+err_subdev_cleanup:
+	v4l2_subdev_cleanup(&sc223a->sd);
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+err_media_entity:
+	media_entity_cleanup(&sc223a->sd.entity);
+err_handler_free:
+	v4l2_ctrl_handler_free(&sc223a->ctrls.handler);
+err_power_off:
+	sc223a_power_off(dev);
+
+	return ret;
+}
+
+static void sc223a_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct sc223a *sc223a = to_sc223a(sd);
+
+	v4l2_subdev_cleanup(sd);
+	v4l2_async_unregister_subdev(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&sc223a->ctrls.handler);
+
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev))
+		sc223a_power_off(&client->dev);
+	pm_runtime_set_suspended(&client->dev);
+}
+
+static const struct of_device_id sc223a_dt_ids[] = {
+	{ .compatible = "smartens,sc223a" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, sc223a_dt_ids);
+
+static const struct i2c_device_id sc223a_id[] = {
+	{ .name = "sc223a" },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, sc223a_id);
+
+static const struct dev_pm_ops sc223a_pm_ops = {
+	RUNTIME_PM_OPS(sc223a_power_off, sc223a_power_on, NULL)
+};
+
+static struct i2c_driver sc223a_i2c_driver = {
+	.driver = {
+		.name = "sc223a",
+		.of_match_table = sc223a_dt_ids,
+		.pm = pm_ptr(&sc223a_pm_ops),
+	},
+	.probe = sc223a_probe,
+	.remove = sc223a_remove,
+	.id_table = sc223a_id,
+};
+
+module_i2c_driver(sc223a_i2c_driver);
+
+MODULE_DESCRIPTION("SmartSens SC223A sensor driver");
+MODULE_LICENSE("GPL");
