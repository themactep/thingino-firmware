+static const struct sc223a_mode sc223a_modes[] = {
+	{
+		.width = SC223A_NATIVE_WIDTH,
+		.height = SC223A_NATIVE_HEIGHT,
+		.hblank = SC223A_HTS_MIN - SC223A_NATIVE_WIDTH,
+		.vblank = 1440 - SC223A_NATIVE_HEIGHT,
+		.regs = sc223a_1920h25_regs,
+		.regs_num = ARRAY_SIZE(sc223a_1920h25_regs),
+	},
+};
+
+struct sc223a_ctrls {
+	struct v4l2_ctrl_handler handler;
+	struct v4l2_ctrl *pixel_rate;
+	struct v4l2_ctrl *link_freq;
+	struct v4l2_ctrl *hblank;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *gain;
+	struct v4l2_ctrl *vflip;
+};
+
+struct sc223a {
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+
+	struct regmap *regmap;
+	struct clk *xclk;
+
+	struct gpio_desc *reset_gpio;
+	struct gpio_desc *powerdown_gpio;
+	struct regulator_bulk_data supplies[3];
+
+	struct sc223a_ctrls ctrls;
+
+	const struct sc223a_mode *mode;
+};
+
+static inline struct sc223a *to_sc223a(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct sc223a, sd);
+}
+
+static inline struct v4l2_subdev *sc223a_ctrl_to_sd(struct v4l2_ctrl *ctrl)
+{
+	return &container_of(ctrl->handler, struct sc223a, ctrls.handler)->sd;
+}
+
+static void sc223a_fill_format(const struct sc223a_mode *mode,
+			       struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->code = MEDIA_BUS_FMT_SBGGR10_1X10;
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	fmt->quantization = V4L2_QUANTIZATION_DEFAULT;
+	fmt->xfer_func = V4L2_XFER_FUNC_DEFAULT;
+}
+
+static int sc223a_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct v4l2_mbus_framefmt *fmt;
+	struct v4l2_rect *crop;
+
+	fmt = v4l2_subdev_state_get_format(state, 0);
+	sc223a_fill_format(&sc223a_modes[0], fmt);
+
+	crop = v4l2_subdev_state_get_crop(state, 0);
+	crop->left = 0;
+	crop->top = 0;
+	crop->width = sc223a_modes[0].width;
+	crop->height = sc223a_modes[0].height;
+
+	return 0;
+}
+
+static int sc223a_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index != 0)
+		return -EINVAL;
+
+	code->code = MEDIA_BUS_FMT_SBGGR10_1X10;
+
+	return 0;
+}
+
+static int sc223a_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index >= ARRAY_SIZE(sc223a_modes))
+		return -EINVAL;
+
+	if (fse->code != MEDIA_BUS_FMT_SBGGR10_1X10)
+		return -EINVAL;
+
+	fse->min_width = sc223a_modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = sc223a_modes[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+static int sc223a_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		sel->r = *v4l2_subdev_state_get_crop(state, 0);
+		return 0;
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = SC223A_NATIVE_WIDTH;
+		sel->r.height = SC223A_NATIVE_HEIGHT;
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static int sc223a_set_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct sc223a *sc223a = to_sc223a(sd);
+	const struct sc223a_mode *mode;
+	struct v4l2_mbus_framefmt *framefmt;
+	struct v4l2_rect *crop;
+
+	mode = v4l2_find_nearest_size(sc223a_modes, ARRAY_SIZE(sc223a_modes),
+				      width, height,
+				      fmt->format.width, fmt->format.height);
+
+	sc223a_fill_format(mode, &fmt->format);
+	framefmt = v4l2_subdev_state_get_format(state, fmt->pad);
+	*framefmt = fmt->format;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_ACTIVE) {
+		sc223a->mode = mode;
+		__v4l2_ctrl_s_ctrl(sc223a->ctrls.hblank, mode->hblank);
+		__v4l2_ctrl_s_ctrl(sc223a->ctrls.vblank, mode->vblank);
+	}
+
+	crop = v4l2_subdev_state_get_crop(state, fmt->pad);
+	crop->left = 0;
+	crop->top = 0;
+	crop->width = mode->width;
+	crop->height = mode->height;
+
+	return 0;
+}
+
+static void sc223a_exposure_update(struct sc223a *sc223a)
+{
+	unsigned int exposure_max;
+
+	exposure_max = sc223a->ctrls.vblank->val + sc223a->mode->height -
+		       SC223A_EXPOSURE_OFFSET;
+	exposure_max = min(exposure_max, 0xfffffU >> 5);
+
+	__v4l2_ctrl_modify_range(sc223a->ctrls.exposure, 1, exposure_max, 1,
+				 exposure_max);
+}
+
+static int sc223a_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct sc223a *sc223a = to_sc223a(sc223a_ctrl_to_sd(ctrl));
+
+	dev_dbg(sc223a->sd.dev, "sc223a: ctrl 0x%x = %d\n", ctrl->id, ctrl->val);
+	u32 hts;
+	int ret = 0;
+
+	if (ctrl->flags & V4L2_CTRL_FLAG_READ_ONLY)
+		return 0;
+
+	if (ctrl->id == V4L2_CID_VBLANK)
+		sc223a_exposure_update(sc223a);
+
+	if (!pm_runtime_get_if_in_use(sc223a->sd.dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		ret = cci_write(sc223a->regmap, SC223A_REG_EXPOSURE,
+				(u32)ctrl->val << 5, NULL);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+	{
+		const struct sc223a_gain *gain = &sc223a_gains[ctrl->val];
+
+		ret = cci_write(sc223a->regmap, SC223A_REG_GAIN_3E07,
+				gain->reg_3e07, NULL);
+		ret = cci_write(sc223a->regmap, SC223A_REG_GAIN_3E09,
+				gain->reg_3e09, &ret);
+		break;
+	}
+		break;
+	case V4L2_CID_HBLANK:
+		hts = ctrl->val + sc223a->mode->width;
+		ret = cci_write(sc223a->regmap, SC223A_REG_HTS, hts, NULL);
+		break;
+	case V4L2_CID_VBLANK:
+		ret = cci_write(sc223a->regmap, SC223A_REG_VTS,
+				ctrl->val + sc223a->mode->height, NULL);
+		break;
+	case V4L2_CID_VFLIP:
+		ret = cci_update_bits(sc223a->regmap, SC223A_REG_FLIP,
+				      SC223A_FLIP_BOTH,
+				      ctrl->val ? SC223A_FLIP_BOTH : 0,
+				      NULL);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put_autosuspend(sc223a->sd.dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops sc223a_ctrl_ops = {
+	.s_ctrl = sc223a_set_ctrl,
+};
+
+static int sc223a_init_controls(struct sc223a *sc223a)
+{
+	struct v4l2_ctrl_handler *hdl = &sc223a->ctrls.handler;
+	struct v4l2_fwnode_device_properties props;
+	const struct v4l2_ctrl_ops *ops = &sc223a_ctrl_ops;
+	unsigned int hblank_max = SC223A_HTS_MAX - SC223A_NATIVE_WIDTH;
+	unsigned int vblank_max = SC223A_VTS_MAX - SC223A_NATIVE_HEIGHT;
+	int ret;
+
+	ret = v4l2_ctrl_handler_init(hdl, 10);
+	if (ret)
+		return ret;
+
+	sc223a->ctrls.pixel_rate =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_PIXEL_RATE,
+				  SC223A_PIXEL_RATE, SC223A_PIXEL_RATE, 1,
+				  SC223A_PIXEL_RATE);
+
+	sc223a->ctrls.link_freq =
+		v4l2_ctrl_new_int_menu(hdl, ops, V4L2_CID_LINK_FREQ, 0, 0,
+				       sc223a_link_freqs);
+	if (sc223a->ctrls.link_freq)
+		sc223a->ctrls.link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	sc223a->ctrls.exposure =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_EXPOSURE, 1,
+				  sc223a_modes[0].vblank +
+				  sc223a_modes[0].height -
+				  SC223A_EXPOSURE_OFFSET, 1,
+				  sc223a_modes[0].vblank +
+				  sc223a_modes[0].height -
+				  SC223A_EXPOSURE_OFFSET);
+
+	sc223a->ctrls.gain =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_ANALOGUE_GAIN, 0,
+				  ARRAY_SIZE(sc223a_gains) - 1, 1, 0);
+
+	sc223a->ctrls.hblank =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_HBLANK,
+				  SC223A_HTS_MIN - SC223A_NATIVE_WIDTH,
+				  hblank_max, 1,
+				  sc223a_modes[0].hblank);
+
+	sc223a->ctrls.vblank =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_VBLANK,
+				  sc223a_modes[0].vblank, vblank_max, 1,
+				  sc223a_modes[0].vblank);
+
+	sc223a->ctrls.vflip = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_VFLIP,
+						0, 1, 1, 0);
+
+	if (hdl->error) {
+		ret = hdl->error;
+		goto error;
+	}
+
+	ret = v4l2_fwnode_device_parse(sc223a->sd.dev, &props);
+	if (ret)
+		goto error;
+
+	ret = v4l2_ctrl_new_fwnode_properties(hdl, ops, &props);
+	if (ret)
+		goto error;
+
+	sc223a->sd.ctrl_handler = hdl;
+
+	return 0;
+
+error:
+	v4l2_ctrl_handler_free(hdl);
+
+	return ret;
+}
+
+static int sc223a_check_hwcfg(struct device *dev)
+{
+	struct v4l2_fwnode_endpoint ep = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	struct fwnode_handle *endpoint;
+	unsigned int i;
+	int ret;
+
+	endpoint = fwnode_graph_get_next_endpoint(dev_fwnode(dev), NULL);
+	if (!endpoint) {
+		dev_err(dev, "endpoint node not found\n");
+		return -EINVAL;
+	}
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(endpoint, &ep);
+	fwnode_handle_put(endpoint);
+	if (ret)
+		return ret;
+
+	if (ep.bus.mipi_csi2.num_data_lanes != 2) {
+		dev_err(dev, "only 2 data lanes are currently supported\n");
+		ret = -EINVAL;
+		goto out;
+	}
+
+	if (!ep.nr_of_link_frequencies) {
+		dev_err(dev, "link-frequency property not found in DT\n");
+		ret = -EINVAL;
+		goto out;
+	}
+
+	for (i = 0; i < ep.nr_of_link_frequencies; i++) {
+		if (ep.link_frequencies[i] == SC223A_LINK_FREQ)
+			break;
+	}
+
+	if (i == ep.nr_of_link_frequencies) {
+		dev_err(dev, "expected link frequency %u\n", SC223A_LINK_FREQ);
+		ret = -EINVAL;
+	}
+
+out:
+	v4l2_fwnode_endpoint_free(&ep);
+
+	return ret;
+}
+
+static int sc223a_power_on(struct device *dev)
+{
+	dev_dbg(dev, "sc223a: power on\n");
+	struct sc223a *sc223a = to_sc223a(dev_get_drvdata(dev));
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(sc223a->supplies),
+				    sc223a->supplies);
+	if (ret)
+		return ret;
+
+	ret = clk_prepare_enable(sc223a->xclk);
+	if (ret)
+		goto err_regulators;
+
+	/* The sensor needs MCLK while reset is released. */
+	gpiod_set_value_cansleep(sc223a->powerdown_gpio, 0);
+	gpiod_set_value_cansleep(sc223a->reset_gpio, 0);
+	msleep(20);
+
+	return 0;
+
+err_regulators:
+	regulator_bulk_disable(ARRAY_SIZE(sc223a->supplies), sc223a->supplies);
+
+	return ret;
+}
+
+static int sc223a_power_off(struct device *dev)
+{
+	dev_dbg(dev, "sc223a: power off\n");
+	struct sc223a *sc223a = to_sc223a(dev_get_drvdata(dev));
+
+	gpiod_set_value_cansleep(sc223a->reset_gpio, 1);
+	gpiod_set_value_cansleep(sc223a->powerdown_gpio, 1);
+	clk_disable_unprepare(sc223a->xclk);
+	regulator_bulk_disable(ARRAY_SIZE(sc223a->supplies), sc223a->supplies);
+
+	return 0;
+}
+
+static int sc223a_identify_module(struct sc223a *sc223a)
+{
+	u64 id_h, id_l;
+	int ret;
+
+	ret = cci_read(sc223a->regmap, SC223A_REG_CHIP_ID_H, &id_h, NULL);
+	if (ret)
+		return ret;
+
+	ret = cci_read(sc223a->regmap, SC223A_REG_CHIP_ID_L, &id_l, NULL);
+	if (ret)
+		return ret;
+
+	if (id_h != SC223A_CHIP_ID_H || id_l != SC223A_CHIP_ID_L) {
+		dev_err(sc223a->sd.dev, "chip id mismatch: %x%x != %x%x\n",
+			(u8)id_h, (u8)id_l, SC223A_CHIP_ID_H, SC223A_CHIP_ID_L);
+		return -EIO;
+	}
+
+	dev_info(sc223a->sd.dev, "sc223a: chip id %02x%02x\n", (u8)id_h, (u8)id_l);
+	return 0;
+}
+
+static int sc223a_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state, u32 pad,
+				 u64 streams_mask)
+{
+	struct sc223a *sc223a = to_sc223a(sd);
+
+	dev_info(sd->dev, "sc223a: stream on\n");
+	int ret;
+
+	ret = pm_runtime_resume_and_get(sd->dev);
+	if (ret)
+		return ret;
+
+	cci_multi_reg_write(sc223a->regmap, sc223a->mode->regs,
+			    sc223a->mode->regs_num, &ret);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = __v4l2_ctrl_handler_setup(&sc223a->ctrls.handler);
+	if (ret)
+		goto err_rpm_put;
+
+	cci_write(sc223a->regmap, SC223A_REG_STREAM, SC223A_STREAM_ON, &ret);
+	if (ret)
+		goto err_rpm_put;
+
+	return 0;
+
+err_rpm_put:
+	pm_runtime_put_autosuspend(sd->dev);
+
+	return ret;
+}
+
+static int sc223a_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	dev_info(sd->dev, "sc223a: stream off\n");
+	struct sc223a *sc223a = to_sc223a(sd);
+	int ret = 0;
+
+	cci_write(sc223a->regmap, SC223A_REG_STREAM, 0x00, &ret);
+	if (ret)
+		dev_err(sd->dev, "failed to stop streaming: %d\n", ret);
+
+	pm_runtime_put_autosuspend(sd->dev);
+
+	return ret;
+}
