From: Paul Philippov <paul@themactep.com>
Subject: [PATCH] media: i2c: add the SmartSens SC223A sensor driver

Add a mainline V4L2 subdev driver for the SmartSens SC223A image
sensor. The mode register sequence and gain table are adapted from the
Ingenic vendor sensor driver (sensor_sc223a_t31).

The driver uses the CCI register helpers, runtime PM, and the current
state-based subdev pad API. It exposes the full-resolution mode with
HBLANK/VBLANK, exposure, analogue gain, and mirror/flip controls where
the vendor driver provides them.

Signed-off-by: Paul Philippov <paul@themactep.com>
---
--- /dev/null
+++ b/drivers/media/i2c/sc223a.c
@@ -0,0 +1,1145 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * SmartSens SC223A CMOS Image Sensor Driver
+ *
+ * The register sequences and gain table are adapted from the Ingenic
+ * vendor sensor driver (sensor_sc223a_t31).
+ *
+ * WARNING: this driver has not been validated on hardware.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+#include <linux/units.h>
+
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-mediabus.h>
+
+#define SC223A_CHIP_ID_H			0xcb
+#define SC223A_CHIP_ID_L			0x3e
+
+#define SC223A_REG_CHIP_ID_H		CCI_REG8(0x3107)
+#define SC223A_REG_CHIP_ID_L		CCI_REG8(0x3108)
+
+#define SC223A_REG_SOFTWARE_RESET		CCI_REG8(0x0103)
+#define SC223A_REG_STREAM			CCI_REG8(0x0100)
+
+/* HTS/VTS are big-endian 16-bit values. */
+#define SC223A_REG_HTS			CCI_REG16(0x320c)
+#define SC223A_REG_VTS			CCI_REG16(0x320e)
+
+/*
+ * Exposure is a 20-bit value in units of half lines, laid out
+ * big-endian over 0x3e00..0x3e02.
+ */
+#define SC223A_REG_EXPOSURE		CCI_REG24(0x3e00)
+
+#define SC223A_REG_GAIN_3E07		CCI_REG8(0x3e07)
+#define SC223A_REG_GAIN_3E09		CCI_REG8(0x3e09)
+#define SC223A_REG_FLIP			CCI_REG8(0x3221)
+#define SC223A_FLIP_BOTH		0x60
+
+#define SC223A_STREAM_ON			0x01
+
+/* External clock is 24 MHz. */
+#define SC223A_XCLK_FREQ			(24 * HZ_PER_MHZ)
+
+#define SC223A_NATIVE_WIDTH		1920U
+#define SC223A_NATIVE_HEIGHT		1080U
+
+/* 2 lanes, 405 Mbit/s per lane. */
+#define SC223A_LINK_FREQ			202500000
+/* 2250 x 1440 pixels at 25 fps. */
+#define SC223A_PIXEL_RATE			81000000
+
+static const s64 sc223a_link_freqs[] = {
+	SC223A_LINK_FREQ,
+};
+
+#define SC223A_HTS_MIN			2250U
+#define SC223A_HTS_MAX			0xffffU
+#define SC223A_VTS_MAX			0xffffU
+
+/* Number of lines by which exposure must be less than VTS. */
+#define SC223A_EXPOSURE_OFFSET		5
+
+struct sc223a_gain {
+	u8 reg_3e07; u8 reg_3e09;
+};
