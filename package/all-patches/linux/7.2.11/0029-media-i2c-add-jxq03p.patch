+
+static const struct jxq03p_mode jxq03p_modes[] = {
+	{
+		.width = JXQ03P_NATIVE_WIDTH,
+		.height = JXQ03P_NATIVE_HEIGHT,
+		.hblank = JXQ03P_HTS_MIN - JXQ03P_NATIVE_WIDTH,
+		.vblank = 1600 - JXQ03P_NATIVE_HEIGHT,
+		.regs = jxq03p_1296p25_regs,
+		.regs_num = ARRAY_SIZE(jxq03p_1296p25_regs),
+	},
+};
+
+struct jxq03p_ctrls {
+	struct v4l2_ctrl_handler handler;
+	struct v4l2_ctrl *pixel_rate;
+	struct v4l2_ctrl *link_freq;
+	struct v4l2_ctrl *hblank;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *gain;
+	struct v4l2_ctrl *vflip;
+};
+
+struct jxq03p {
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+
+	struct regmap *regmap;
+	struct clk *xclk;
+
+	struct gpio_desc *reset_gpio;
+	struct gpio_desc *powerdown_gpio;
+	struct regulator_bulk_data supplies[3];
+
+	struct jxq03p_ctrls ctrls;
+
+	const struct jxq03p_mode *mode;
+};
+
+static inline struct jxq03p *to_jxq03p(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct jxq03p, sd);
+}
+
+static inline struct v4l2_subdev *jxq03p_ctrl_to_sd(struct v4l2_ctrl *ctrl)
+{
+	return &container_of(ctrl->handler, struct jxq03p, ctrls.handler)->sd;
+}
+
+static void jxq03p_fill_format(const struct jxq03p_mode *mode,
+			       struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->code = MEDIA_BUS_FMT_SRGGB10_1X10;
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	fmt->quantization = V4L2_QUANTIZATION_DEFAULT;
+	fmt->xfer_func = V4L2_XFER_FUNC_DEFAULT;
+}
+
+static int jxq03p_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct v4l2_mbus_framefmt *fmt;
+	struct v4l2_rect *crop;
+
+	fmt = v4l2_subdev_state_get_format(state, 0);
+	jxq03p_fill_format(&jxq03p_modes[0], fmt);
+
+	crop = v4l2_subdev_state_get_crop(state, 0);
+	crop->left = 0;
+	crop->top = 0;
+	crop->width = jxq03p_modes[0].width;
+	crop->height = jxq03p_modes[0].height;
+
+	return 0;
+}
+
+static int jxq03p_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index != 0)
+		return -EINVAL;
+
+	code->code = MEDIA_BUS_FMT_SRGGB10_1X10;
+
+	return 0;
+}
+
+static int jxq03p_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index >= ARRAY_SIZE(jxq03p_modes))
+		return -EINVAL;
+
+	if (fse->code != MEDIA_BUS_FMT_SRGGB10_1X10)
+		return -EINVAL;
+
+	fse->min_width = jxq03p_modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = jxq03p_modes[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+static int jxq03p_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		sel->r = *v4l2_subdev_state_get_crop(state, 0);
+		return 0;
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = JXQ03P_NATIVE_WIDTH;
+		sel->r.height = JXQ03P_NATIVE_HEIGHT;
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static int jxq03p_set_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct jxq03p *jxq03p = to_jxq03p(sd);
+	const struct jxq03p_mode *mode;
+	struct v4l2_mbus_framefmt *framefmt;
+	struct v4l2_rect *crop;
+
+	mode = v4l2_find_nearest_size(jxq03p_modes, ARRAY_SIZE(jxq03p_modes),
+				      width, height,
+				      fmt->format.width, fmt->format.height);
+
+	jxq03p_fill_format(mode, &fmt->format);
+	framefmt = v4l2_subdev_state_get_format(state, fmt->pad);
+	*framefmt = fmt->format;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_ACTIVE) {
+		jxq03p->mode = mode;
+		__v4l2_ctrl_s_ctrl(jxq03p->ctrls.hblank, mode->hblank);
+		__v4l2_ctrl_s_ctrl(jxq03p->ctrls.vblank, mode->vblank);
+	}
+
+	crop = v4l2_subdev_state_get_crop(state, fmt->pad);
+	crop->left = 0;
+	crop->top = 0;
+	crop->width = mode->width;
+	crop->height = mode->height;
+
+	return 0;
+}
+
+static void jxq03p_exposure_update(struct jxq03p *jxq03p)
+{
+	unsigned int exposure_max;
+
+	exposure_max = jxq03p->ctrls.vblank->val + jxq03p->mode->height -
+		       JXQ03P_EXPOSURE_OFFSET;
+	exposure_max = min(exposure_max, 0x3fffU);
+
+	__v4l2_ctrl_modify_range(jxq03p->ctrls.exposure, 1, exposure_max, 1,
+				 exposure_max);
+}
+
+static int jxq03p_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct jxq03p *jxq03p = to_jxq03p(jxq03p_ctrl_to_sd(ctrl));
+	u32 hts;
+	u8 code;
+	u64 val, r0c, r82;
+	int ret = 0;
+
+	if (ctrl->flags & V4L2_CTRL_FLAG_READ_ONLY)
+		return 0;
+
+	if (ctrl->id == V4L2_CID_VBLANK)
+		jxq03p_exposure_update(jxq03p);
+
+	if (!pm_runtime_get_if_in_use(jxq03p->sd.dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		ret = cci_write(jxq03p->regmap, JXQ03P_REG_EXPOSURE_L,
+				ctrl->val & 0xff, NULL);
+		ret = cci_write(jxq03p->regmap, JXQ03P_REG_EXPOSURE_H,
+				(ctrl->val >> 8) & 0xff, &ret);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		code = jxq03p_gains[ctrl->val].code;
+		ret = cci_write(jxq03p->regmap, JXQ03P_REG_GAIN, code & 0x7f, NULL);
+		break;
+	case V4L2_CID_HBLANK:
+		hts = ctrl->val + jxq03p->mode->width;
+		ret = cci_write(jxq03p->regmap, JXQ03P_REG_HTS_L, (hts / 2) & 0xff, NULL);
+		ret = cci_write(jxq03p->regmap, JXQ03P_REG_HTS_H, ((hts / 2) >> 8) & 0xff, &ret);
+		break;
+	case V4L2_CID_VBLANK:
+		ret = cci_write(jxq03p->regmap, JXQ03P_REG_VTS_L,
+				(ctrl->val + jxq03p->mode->height) & 0xff, NULL);
+		ret = cci_write(jxq03p->regmap, JXQ03P_REG_VTS_H,
+				((ctrl->val + jxq03p->mode->height) >> 8) & 0xff, &ret);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put_autosuspend(jxq03p->sd.dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops jxq03p_ctrl_ops = {
+	.s_ctrl = jxq03p_set_ctrl,
+};
+
+static int jxq03p_init_controls(struct jxq03p *jxq03p)
+{
+	struct v4l2_ctrl_handler *hdl = &jxq03p->ctrls.handler;
+	struct v4l2_fwnode_device_properties props;
+	const struct v4l2_ctrl_ops *ops = &jxq03p_ctrl_ops;
+	unsigned int hblank_max = JXQ03P_HTS_MAX - JXQ03P_NATIVE_WIDTH;
+	unsigned int vblank_max = JXQ03P_VTS_MAX - JXQ03P_NATIVE_HEIGHT;
+	int ret;
+
+	ret = v4l2_ctrl_handler_init(hdl, 10);
+	if (ret)
+		return ret;
+
+	jxq03p->ctrls.pixel_rate =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_PIXEL_RATE,
+				  JXQ03P_PIXEL_RATE, JXQ03P_PIXEL_RATE, 1,
+				  JXQ03P_PIXEL_RATE);
+
+	jxq03p->ctrls.link_freq =
+		v4l2_ctrl_new_int_menu(hdl, ops, V4L2_CID_LINK_FREQ, 0, 0,
+				       jxq03p_link_freqs);
+	if (jxq03p->ctrls.link_freq)
+		jxq03p->ctrls.link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	jxq03p->ctrls.exposure =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_EXPOSURE, 1,
+				  jxq03p_modes[0].vblank +
+				  jxq03p_modes[0].height -
+				  JXQ03P_EXPOSURE_OFFSET, 1,
+				  jxq03p_modes[0].vblank +
+				  jxq03p_modes[0].height -
+				  JXQ03P_EXPOSURE_OFFSET);
+
+	jxq03p->ctrls.gain =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_ANALOGUE_GAIN, 0,
+				  ARRAY_SIZE(jxq03p_gains) - 1, 1, 0);
+
+	jxq03p->ctrls.hblank =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_HBLANK,
+				  JXQ03P_HTS_MIN - JXQ03P_NATIVE_WIDTH,
+				  hblank_max, 1,
+				  jxq03p_modes[0].hblank);
+
+	jxq03p->ctrls.vblank =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_VBLANK,
+				  jxq03p_modes[0].vblank, vblank_max, 1,
+				  jxq03p_modes[0].vblank);
+
+	jxq03p->ctrls.vflip = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_VFLIP,
+						0, 1, 1, 0);
+
+
+	if (hdl->error) {
+		ret = hdl->error;
+		goto error;
+	}
+
+	ret = v4l2_fwnode_device_parse(jxq03p->sd.dev, &props);
+	if (ret)
+		goto error;
+
+	ret = v4l2_ctrl_new_fwnode_properties(hdl, ops, &props);
+	if (ret)
+		goto error;
+
+	jxq03p->sd.ctrl_handler = hdl;
+
+	return 0;
+
+error:
+	v4l2_ctrl_handler_free(hdl);
+
+	return ret;
+}
+
+static int jxq03p_check_hwcfg(struct device *dev)
+{
+	struct v4l2_fwnode_endpoint ep = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	struct fwnode_handle *endpoint;
+	unsigned int i;
+	int ret;
+
+	endpoint = fwnode_graph_get_next_endpoint(dev_fwnode(dev), NULL);
+	if (!endpoint) {
+		dev_err(dev, "endpoint node not found\n");
+		return -EINVAL;
+	}
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(endpoint, &ep);
+	fwnode_handle_put(endpoint);
+	if (ret)
+		return ret;
+
+	if (ep.bus.mipi_csi2.num_data_lanes != 2) {
+		dev_err(dev, "only 2 data lanes are currently supported\n");
+		ret = -EINVAL;
+		goto out;
+	}
+
+	if (!ep.nr_of_link_frequencies) {
+		dev_err(dev, "link-frequency property not found in DT\n");
+		ret = -EINVAL;
+		goto out;
+	}
+
+	for (i = 0; i < ep.nr_of_link_frequencies; i++) {
+		if (ep.link_frequencies[i] == JXQ03P_LINK_FREQ)
+			break;
+	}
+
+	if (i == ep.nr_of_link_frequencies) {
+		dev_err(dev, "expected link frequency %u\n", JXQ03P_LINK_FREQ);
+		ret = -EINVAL;
+	}
+
+out:
+	v4l2_fwnode_endpoint_free(&ep);
+
+	return ret;
+}
+
+static int jxq03p_power_on(struct device *dev)
+{
+	struct jxq03p *jxq03p = to_jxq03p(dev_get_drvdata(dev));
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(jxq03p->supplies),
+				    jxq03p->supplies);
+	if (ret)
+		return ret;
+
+	ret = clk_prepare_enable(jxq03p->xclk);
+	if (ret)
+		goto err_regulators;
+
+	/* The sensor needs MCLK while reset is released. */
+	gpiod_set_value_cansleep(jxq03p->powerdown_gpio, 0);
+	gpiod_set_value_cansleep(jxq03p->reset_gpio, 0);
+	msleep(20);
+
+	return 0;
+
+err_regulators:
+	regulator_bulk_disable(ARRAY_SIZE(jxq03p->supplies), jxq03p->supplies);
+
+	return ret;
+}
+
+static int jxq03p_power_off(struct device *dev)
+{
+	struct jxq03p *jxq03p = to_jxq03p(dev_get_drvdata(dev));
+
+	gpiod_set_value_cansleep(jxq03p->reset_gpio, 1);
+	gpiod_set_value_cansleep(jxq03p->powerdown_gpio, 1);
+	clk_disable_unprepare(jxq03p->xclk);
+	regulator_bulk_disable(ARRAY_SIZE(jxq03p->supplies), jxq03p->supplies);
+
+	return 0;
+}
+
+static int jxq03p_identify_module(struct jxq03p *jxq03p)
+{
+	u64 id_h, id_l;
+	int ret;
+
+	ret = cci_read(jxq03p->regmap, JXQ03P_REG_CHIP_ID_H, &id_h, NULL);
+	if (ret)
+		return ret;
+
+	ret = cci_read(jxq03p->regmap, JXQ03P_REG_CHIP_ID_L, &id_l, NULL);
+	if (ret)
+		return ret;
+
+	if (id_h != JXQ03P_CHIP_ID_H || id_l != JXQ03P_CHIP_ID_L) {
+		dev_err(jxq03p->sd.dev, "chip id mismatch: %x%x != %x%x\n",
+			(u8)id_h, (u8)id_l, JXQ03P_CHIP_ID_H, JXQ03P_CHIP_ID_L);
+		return -EIO;
+	}
+
+	return 0;
+}
+
+static int jxq03p_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state, u32 pad,
+				 u64 streams_mask)
+{
+	struct jxq03p *jxq03p = to_jxq03p(sd);
+	int ret;
+
+	ret = pm_runtime_resume_and_get(sd->dev);
+	if (ret)
+		return ret;
+
+	cci_multi_reg_write(jxq03p->regmap, jxq03p_1296p25_regs,
+			    ARRAY_SIZE(jxq03p_1296p25_regs), &ret);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = __v4l2_ctrl_handler_setup(&jxq03p->ctrls.handler);
+	if (ret)
+		goto err_rpm_put;
+
+	return 0;
+
+err_rpm_put:
+	pm_runtime_put_autosuspend(sd->dev);
+
+	return ret;
+}
+
+static int jxq03p_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	pm_runtime_put_autosuspend(sd->dev);
+
+	return 0;
+}
+
+static const struct v4l2_subdev_video_ops jxq03p_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops jxq03p_pad_ops = {
+	.enum_mbus_code = jxq03p_enum_mbus_code,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = jxq03p_set_pad_format,
+	.get_selection = jxq03p_get_selection,
+	.enum_frame_size = jxq03p_enum_frame_size,
+	.enable_streams = jxq03p_enable_streams,
+	.disable_streams = jxq03p_disable_streams,
+};
+
+static const struct v4l2_subdev_ops jxq03p_subdev_ops = {
+	.video = &jxq03p_video_ops,
+	.pad = &jxq03p_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops jxq03p_subdev_internal_ops = {
+	.init_state = jxq03p_init_state,
+};
+
+static const char * const jxq03p_supply_names[] = {
+	"iovdd",
+	"avdd",
+	"dvdd",
+};
+
+static int jxq03p_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct jxq03p *jxq03p;
+	unsigned int i;
+	unsigned long xclk_freq;
+	int ret;
+
+	jxq03p = devm_kzalloc(dev, sizeof(*jxq03p), GFP_KERNEL);
+	if (!jxq03p)
+		return -ENOMEM;
+
+	v4l2_i2c_subdev_init(&jxq03p->sd, client, &jxq03p_subdev_ops);
+	jxq03p->sd.internal_ops = &jxq03p_subdev_internal_ops;
+
+	ret = jxq03p_check_hwcfg(dev);
+	if (ret)
+		return ret;
+
+	jxq03p->xclk = devm_v4l2_sensor_clk_get(dev, NULL);
+	if (IS_ERR(jxq03p->xclk))
+		return dev_err_probe(dev, PTR_ERR(jxq03p->xclk),
+				     "failed to get xclk\n");
+
+	xclk_freq = clk_get_rate(jxq03p->xclk);
+	if (xclk_freq != JXQ03P_XCLK_FREQ)
+		return dev_err_probe(dev, -EINVAL,
+				     "xclk frequency %lu Hz not supported\n",
+				     xclk_freq);
+
+	for (i = 0; i < ARRAY_SIZE(jxq03p->supplies); i++)
+		jxq03p->supplies[i].supply = jxq03p_supply_names[i];
+
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(jxq03p->supplies),
+				      jxq03p->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get regulators\n");
+
+	jxq03p->reset_gpio = devm_gpiod_get_optional(dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(jxq03p->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(jxq03p->reset_gpio),
+				     "failed to get reset gpio\n");
+
+	jxq03p->powerdown_gpio = devm_gpiod_get_optional(dev, "powerdown",
+							 GPIOD_OUT_HIGH);
+	if (IS_ERR(jxq03p->powerdown_gpio))
+		return dev_err_probe(dev, PTR_ERR(jxq03p->powerdown_gpio),
+				     "failed to get powerdown gpio\n");
+
+	jxq03p->regmap = devm_cci_regmap_init_i2c(client, 8);
+	if (IS_ERR(jxq03p->regmap))
+		return dev_err_probe(dev, PTR_ERR(jxq03p->regmap),
+				     "failed to get cci regmap\n");
+
+	ret = jxq03p_power_on(dev);
+	if (ret)
+		return ret;
+
+	ret = jxq03p_identify_module(jxq03p);
+	if (ret)
+		goto err_power_off;
+
+	jxq03p->mode = &jxq03p_modes[0];
+
+	ret = jxq03p_init_controls(jxq03p);
+	if (ret)
+		goto err_power_off;
+
+	jxq03p->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	jxq03p->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	jxq03p->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&jxq03p->sd.entity, 1, &jxq03p->pad);
+	if (ret)
+		goto err_handler_free;
+
+	jxq03p->sd.state_lock = jxq03p->ctrls.handler.lock;
+	ret = v4l2_subdev_init_finalize(&jxq03p->sd);
+	if (ret)
+		goto err_media_entity;
+
+	pm_runtime_set_active(dev);
+	pm_runtime_get_noresume(dev);
+	pm_runtime_enable(dev);
+	pm_runtime_set_autosuspend_delay(dev, 1000);
+	pm_runtime_use_autosuspend(dev);
+	pm_runtime_put_autosuspend(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&jxq03p->sd);
+	if (ret)
+		goto err_subdev_cleanup;
+
+	return 0;
+
+err_subdev_cleanup:
+	v4l2_subdev_cleanup(&jxq03p->sd);
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+err_media_entity:
+	media_entity_cleanup(&jxq03p->sd.entity);
+err_handler_free:
+	v4l2_ctrl_handler_free(&jxq03p->ctrls.handler);
+err_power_off:
+	jxq03p_power_off(dev);
+
+	return ret;
+}
+
+static void jxq03p_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct jxq03p *jxq03p = to_jxq03p(sd);
+
+	v4l2_subdev_cleanup(sd);
+	v4l2_async_unregister_subdev(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&jxq03p->ctrls.handler);
+
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev))
+		jxq03p_power_off(&client->dev);
+	pm_runtime_set_suspended(&client->dev);
+}
+
+static const struct of_device_id jxq03p_dt_ids[] = {
+	{ .compatible = "jxf,jxq03p" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, jxq03p_dt_ids);
+
+static const struct i2c_device_id jxq03p_id[] = {
+	{ .name = "jxq03p" },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, jxq03p_id);
+
+static const struct dev_pm_ops jxq03p_pm_ops = {
+	RUNTIME_PM_OPS(jxq03p_power_off, jxq03p_power_on, NULL)
+};
+
+static struct i2c_driver jxq03p_i2c_driver = {
+	.driver = {
+		.name = "jxq03p",
+		.of_match_table = jxq03p_dt_ids,
+		.pm = pm_ptr(&jxq03p_pm_ops),
+	},
+	.id_table = jxq03p_id,
+	.probe = jxq03p_probe,
+	.remove = jxq03p_remove,
+};
+
+module_i2c_driver(jxq03p_i2c_driver);
+
+MODULE_DESCRIPTION("JXQ03P sensor driver");
+MODULE_LICENSE("GPL");
