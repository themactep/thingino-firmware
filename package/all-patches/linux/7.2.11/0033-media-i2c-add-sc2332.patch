+
+static const struct sc2332_mode sc2332_modes[] = {
+	{
+		.width = SC2332_NATIVE_WIDTH,
+		.height = SC2332_NATIVE_HEIGHT,
+		.hblank = SC2332_HTS_MIN - SC2332_NATIVE_WIDTH,
+		.vblank = 1350 - SC2332_NATIVE_HEIGHT,
+		.regs = sc2332_1080p25_regs,
+		.regs_num = ARRAY_SIZE(sc2332_1080p25_regs),
+	},
+};
+
+struct sc2332_ctrls {
+	struct v4l2_ctrl_handler handler;
+	struct v4l2_ctrl *pixel_rate;
+	struct v4l2_ctrl *link_freq;
+	struct v4l2_ctrl *hblank;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *gain;
+	struct v4l2_ctrl *vflip;
+};
+
+struct sc2332 {
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+
+	struct regmap *regmap;
+	struct clk *xclk;
+
+	struct gpio_desc *reset_gpio;
+	struct gpio_desc *powerdown_gpio;
+	struct regulator_bulk_data supplies[3];
+
+	struct sc2332_ctrls ctrls;
+
+	const struct sc2332_mode *mode;
+};
+
+static inline struct sc2332 *to_sc2332(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct sc2332, sd);
+}
+
+static inline struct v4l2_subdev *sc2332_ctrl_to_sd(struct v4l2_ctrl *ctrl)
+{
+	return &container_of(ctrl->handler, struct sc2332, ctrls.handler)->sd;
+}
+
+static void sc2332_fill_format(const struct sc2332_mode *mode,
+			       struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->code = MEDIA_BUS_FMT_SBGGR10_1X10;
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	fmt->quantization = V4L2_QUANTIZATION_DEFAULT;
+	fmt->xfer_func = V4L2_XFER_FUNC_DEFAULT;
+}
+
+static int sc2332_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct v4l2_mbus_framefmt *fmt;
+	struct v4l2_rect *crop;
+
+	fmt = v4l2_subdev_state_get_format(state, 0);
+	sc2332_fill_format(&sc2332_modes[0], fmt);
+
+	crop = v4l2_subdev_state_get_crop(state, 0);
+	crop->left = 0;
+	crop->top = 0;
+	crop->width = sc2332_modes[0].width;
+	crop->height = sc2332_modes[0].height;
+
+	return 0;
+}
+
+static int sc2332_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index != 0)
+		return -EINVAL;
+
+	code->code = MEDIA_BUS_FMT_SBGGR10_1X10;
+
+	return 0;
+}
+
+static int sc2332_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index >= ARRAY_SIZE(sc2332_modes))
+		return -EINVAL;
+
+	if (fse->code != MEDIA_BUS_FMT_SBGGR10_1X10)
+		return -EINVAL;
+
+	fse->min_width = sc2332_modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = sc2332_modes[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+static int sc2332_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		sel->r = *v4l2_subdev_state_get_crop(state, 0);
+		return 0;
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = SC2332_NATIVE_WIDTH;
+		sel->r.height = SC2332_NATIVE_HEIGHT;
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static int sc2332_set_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct sc2332 *sc2332 = to_sc2332(sd);
+	const struct sc2332_mode *mode;
+	struct v4l2_mbus_framefmt *framefmt;
+	struct v4l2_rect *crop;
+
+	mode = v4l2_find_nearest_size(sc2332_modes, ARRAY_SIZE(sc2332_modes),
+				      width, height,
+				      fmt->format.width, fmt->format.height);
+
+	sc2332_fill_format(mode, &fmt->format);
+	framefmt = v4l2_subdev_state_get_format(state, fmt->pad);
+	*framefmt = fmt->format;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_ACTIVE) {
+		sc2332->mode = mode;
+		__v4l2_ctrl_s_ctrl(sc2332->ctrls.hblank, mode->hblank);
+		__v4l2_ctrl_s_ctrl(sc2332->ctrls.vblank, mode->vblank);
+	}
+
+	crop = v4l2_subdev_state_get_crop(state, fmt->pad);
+	crop->left = 0;
+	crop->top = 0;
+	crop->width = mode->width;
+	crop->height = mode->height;
+
+	return 0;
+}
+
+static void sc2332_exposure_update(struct sc2332 *sc2332)
+{
+	unsigned int exposure_max;
+
+	exposure_max = sc2332->ctrls.vblank->val + sc2332->mode->height -
+		       SC2332_EXPOSURE_OFFSET;
+	/* 16-bit register written as value * 2. */
+	exposure_max = min(exposure_max, 0x7fffU);
+
+	__v4l2_ctrl_modify_range(sc2332->ctrls.exposure, 1, exposure_max, 1,
+				 exposure_max);
+}
+
+static int sc2332_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct sc2332 *sc2332 = to_sc2332(sc2332_ctrl_to_sd(ctrl));
+	const struct sc2332_gain *gain;
+	u32 hts, vts, it;
+	int ret = 0;
+
+	if (ctrl->flags & V4L2_CTRL_FLAG_READ_ONLY)
+		return 0;
+
+	if (ctrl->id == V4L2_CID_VBLANK)
+		sc2332_exposure_update(sc2332);
+
+	if (!pm_runtime_get_if_in_use(sc2332->sd.dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		it = (u32)ctrl->val * 2;
+		ret = cci_write(sc2332->regmap, SC2332_REG_EXPOSURE_0,
+				(it >> 12) & 0x0f, NULL);
+		ret = cci_write(sc2332->regmap, SC2332_REG_EXPOSURE_1,
+				(it >> 4) & 0xff, &ret);
+		ret = cci_write(sc2332->regmap, SC2332_REG_EXPOSURE_2,
+				(it & 0x0f) << 4, &ret);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		gain = &sc2332_gains[ctrl->val];
+		ret = cci_write(sc2332->regmap, SC2332_REG_GAIN_L,
+				gain->reg_3e09, NULL);
+		ret = cci_write(sc2332->regmap, SC2332_REG_GAIN_H,
+				gain->reg_3e08, &ret);
+		break;
+	case V4L2_CID_HBLANK:
+		hts = ctrl->val + sc2332->mode->width;
+		ret = cci_write(sc2332->regmap, SC2332_REG_HTS, hts, NULL);
+		break;
+	case V4L2_CID_VBLANK:
+		vts = ctrl->val + sc2332->mode->height;
+		ret = cci_write(sc2332->regmap, SC2332_REG_GROUP_HOLD,
+				SC2332_GROUP_HOLD_OPEN, NULL);
+		ret = cci_write(sc2332->regmap, SC2332_REG_VTS_L,
+				vts & 0xff, &ret);
+		ret = cci_write(sc2332->regmap, SC2332_REG_VTS_H,
+				(vts >> 8) & 0xff, &ret);
+		ret = cci_write(sc2332->regmap, SC2332_REG_GROUP_HOLD,
+				SC2332_GROUP_HOLD_CLOSE, &ret);
+		break;
+	case V4L2_CID_VFLIP:
+		ret = cci_update_bits(sc2332->regmap, SC2332_REG_FLIP,
+				      SC2332_FLIP_MASK,
+				      ctrl->val ? SC2332_FLIP_MASK : 0, NULL);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put_autosuspend(sc2332->sd.dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops sc2332_ctrl_ops = {
+	.s_ctrl = sc2332_set_ctrl,
+};
+
+static int sc2332_init_controls(struct sc2332 *sc2332)
+{
+	struct v4l2_ctrl_handler *hdl = &sc2332->ctrls.handler;
+	struct v4l2_fwnode_device_properties props;
+	const struct v4l2_ctrl_ops *ops = &sc2332_ctrl_ops;
+	unsigned int hblank_max = SC2332_HTS_MAX - SC2332_NATIVE_WIDTH;
+	unsigned int vblank_max = SC2332_VTS_MAX - SC2332_NATIVE_HEIGHT;
+	unsigned int exposure_max;
+	int ret;
+
+	ret = v4l2_ctrl_handler_init(hdl, 10);
+	if (ret)
+		return ret;
+
+	exposure_max = min(sc2332_modes[0].vblank + sc2332_modes[0].height -
+			   SC2332_EXPOSURE_OFFSET, 0x7fffU);
+
+	sc2332->ctrls.pixel_rate =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_PIXEL_RATE,
+				  SC2332_PIXEL_RATE, SC2332_PIXEL_RATE, 1,
+				  SC2332_PIXEL_RATE);
+
+	sc2332->ctrls.link_freq =
+		v4l2_ctrl_new_int_menu(hdl, ops, V4L2_CID_LINK_FREQ, 0, 0,
+				       sc2332_link_freqs);
+	if (sc2332->ctrls.link_freq)
+		sc2332->ctrls.link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	sc2332->ctrls.exposure =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_EXPOSURE, 1,
+				  exposure_max, 1, exposure_max);
+
+	sc2332->ctrls.gain =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_ANALOGUE_GAIN, 0,
+				  ARRAY_SIZE(sc2332_gains) - 1, 1, 0);
+
+	sc2332->ctrls.hblank =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_HBLANK,
+				  SC2332_HTS_MIN - SC2332_NATIVE_WIDTH,
+				  hblank_max, 1,
+				  sc2332_modes[0].hblank);
+
+	sc2332->ctrls.vblank =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_VBLANK,
+				  sc2332_modes[0].vblank, vblank_max, 1,
+				  sc2332_modes[0].vblank);
+
+	sc2332->ctrls.vflip = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_VFLIP,
+						0, 1, 1, 0);
+
+	if (hdl->error) {
+		ret = hdl->error;
+		goto error;
+	}
+
+	ret = v4l2_fwnode_device_parse(sc2332->sd.dev, &props);
+	if (ret)
+		goto error;
+
+	ret = v4l2_ctrl_new_fwnode_properties(hdl, ops, &props);
+	if (ret)
+		goto error;
+
+	sc2332->sd.ctrl_handler = hdl;
+
+	return 0;
+
+error:
+	v4l2_ctrl_handler_free(hdl);
+
+	return ret;
+}
+
+static int sc2332_check_hwcfg(struct device *dev)
+{
+	struct v4l2_fwnode_endpoint ep = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	struct fwnode_handle *endpoint;
+	unsigned int i;
+	int ret;
+
+	endpoint = fwnode_graph_get_next_endpoint(dev_fwnode(dev), NULL);
+	if (!endpoint) {
+		dev_err(dev, "endpoint node not found\n");
+		return -EINVAL;
+	}
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(endpoint, &ep);
+	fwnode_handle_put(endpoint);
+	if (ret)
+		return ret;
+
+	if (ep.bus.mipi_csi2.num_data_lanes != 2) {
+		dev_err(dev, "only 2 data lanes are currently supported\n");
+		ret = -EINVAL;
+		goto out;
+	}
+
+	if (!ep.nr_of_link_frequencies) {
+		dev_err(dev, "link-frequency property not found in DT\n");
+		ret = -EINVAL;
+		goto out;
+	}
+
+	for (i = 0; i < ep.nr_of_link_frequencies; i++) {
+		if (ep.link_frequencies[i] == SC2332_LINK_FREQ)
+			break;
+	}
+
+	if (i == ep.nr_of_link_frequencies) {
+		dev_err(dev, "expected link frequency %u\n", SC2332_LINK_FREQ);
+		ret = -EINVAL;
+	}
+
+out:
+	v4l2_fwnode_endpoint_free(&ep);
+
+	return ret;
+}
+
+static int sc2332_power_on(struct device *dev)
+{
+	struct sc2332 *sc2332 = to_sc2332(dev_get_drvdata(dev));
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(sc2332->supplies),
+				    sc2332->supplies);
+	if (ret)
+		return ret;
+
+	ret = clk_prepare_enable(sc2332->xclk);
+	if (ret)
+		goto err_regulators;
+
+	/* The sensor needs MCLK while reset is released. */
+	gpiod_set_value_cansleep(sc2332->powerdown_gpio, 0);
+	gpiod_set_value_cansleep(sc2332->reset_gpio, 0);
+	msleep(20);
+
+	return 0;
+
+err_regulators:
+	regulator_bulk_disable(ARRAY_SIZE(sc2332->supplies), sc2332->supplies);
+
+	return ret;
+}
+
+static int sc2332_power_off(struct device *dev)
+{
+	struct sc2332 *sc2332 = to_sc2332(dev_get_drvdata(dev));
+
+	gpiod_set_value_cansleep(sc2332->reset_gpio, 1);
+	gpiod_set_value_cansleep(sc2332->powerdown_gpio, 1);
+	clk_disable_unprepare(sc2332->xclk);
+	regulator_bulk_disable(ARRAY_SIZE(sc2332->supplies), sc2332->supplies);
+
+	return 0;
+}
+
+static int sc2332_identify_module(struct sc2332 *sc2332)
+{
+	u64 id_h, id_l;
+	int ret;
+
+	ret = cci_read(sc2332->regmap, SC2332_REG_CHIP_ID_H, &id_h, NULL);
+	if (ret)
+		return ret;
+
+	ret = cci_read(sc2332->regmap, SC2332_REG_CHIP_ID_L, &id_l, NULL);
+	if (ret)
+		return ret;
+
+	if (id_h != SC2332_CHIP_ID_H || id_l != SC2332_CHIP_ID_L) {
+		dev_err(sc2332->sd.dev, "chip id mismatch: %x%x != %x%x\n",
+			(u8)id_h, (u8)id_l, SC2332_CHIP_ID_H, SC2332_CHIP_ID_L);
+		return -EIO;
+	}
+
+	return 0;
+}
+
+static int sc2332_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state, u32 pad,
+				 u64 streams_mask)
+{
+	struct sc2332 *sc2332 = to_sc2332(sd);
+	int ret;
+
+	ret = pm_runtime_resume_and_get(sd->dev);
+	if (ret)
+		return ret;
+
+	cci_multi_reg_write(sc2332->regmap, sc2332->mode->regs,
+			    sc2332->mode->regs_num, &ret);
+	if (ret)
+		goto err_rpm_put;
+
+	/* Legacy sequence delays 22 ms after the final stream-on write. */
+	msleep(SC2332_INIT_DELAY_MS);
+
+	ret = __v4l2_ctrl_handler_setup(&sc2332->ctrls.handler);
+	if (ret)
+		goto err_rpm_put;
+
+	cci_write(sc2332->regmap, SC2332_REG_STREAM, SC2332_STREAM_ON, &ret);
+	if (ret)
+		goto err_rpm_put;
+
+	return 0;
+
+err_rpm_put:
+	pm_runtime_put_autosuspend(sd->dev);
+
+	return ret;
+}
+
+static int sc2332_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	struct sc2332 *sc2332 = to_sc2332(sd);
+	int ret = 0;
+
+	cci_write(sc2332->regmap, SC2332_REG_STREAM, 0x00, &ret);
+	if (ret)
+		dev_err(sd->dev, "failed to stop streaming: %d\n", ret);
+
+	pm_runtime_put_autosuspend(sd->dev);
+
+	return ret;
+}
+
+static const struct v4l2_subdev_video_ops sc2332_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops sc2332_pad_ops = {
+	.enum_mbus_code = sc2332_enum_mbus_code,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = sc2332_set_pad_format,
+	.get_selection = sc2332_get_selection,
+	.enum_frame_size = sc2332_enum_frame_size,
+	.enable_streams = sc2332_enable_streams,
+	.disable_streams = sc2332_disable_streams,
+};
+
+static const struct v4l2_subdev_ops sc2332_subdev_ops = {
+	.video = &sc2332_video_ops,
+	.pad = &sc2332_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops sc2332_subdev_internal_ops = {
+	.init_state = sc2332_init_state,
+};
+
+static const char * const sc2332_supply_names[] = {
+	"iovdd",
+	"avdd",
+	"dvdd",
+};
+
+static int sc2332_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct sc2332 *sc2332;
+	unsigned int i;
+	unsigned long xclk_freq;
+	int ret;
+
+	sc2332 = devm_kzalloc(dev, sizeof(*sc2332), GFP_KERNEL);
+	if (!sc2332)
+		return -ENOMEM;
+
+	v4l2_i2c_subdev_init(&sc2332->sd, client, &sc2332_subdev_ops);
+	sc2332->sd.internal_ops = &sc2332_subdev_internal_ops;
+
+	ret = sc2332_check_hwcfg(dev);
+	if (ret)
+		return ret;
+
+	sc2332->xclk = devm_v4l2_sensor_clk_get(dev, NULL);
+	if (IS_ERR(sc2332->xclk))
+		return dev_err_probe(dev, PTR_ERR(sc2332->xclk),
+				     "failed to get xclk\n");
+
+	xclk_freq = clk_get_rate(sc2332->xclk);
+	if (xclk_freq != SC2332_XCLK_FREQ)
+		return dev_err_probe(dev, -EINVAL,
+				     "xclk frequency %lu Hz not supported\n",
+				     xclk_freq);
+
+	for (i = 0; i < ARRAY_SIZE(sc2332->supplies); i++)
+		sc2332->supplies[i].supply = sc2332_supply_names[i];
+
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(sc2332->supplies),
+				      sc2332->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get regulators\n");
+
+	sc2332->reset_gpio = devm_gpiod_get_optional(dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(sc2332->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(sc2332->reset_gpio),
+				     "failed to get reset gpio\n");
+
+	sc2332->powerdown_gpio = devm_gpiod_get_optional(dev, "powerdown",
+							 GPIOD_OUT_HIGH);
+	if (IS_ERR(sc2332->powerdown_gpio))
+		return dev_err_probe(dev, PTR_ERR(sc2332->powerdown_gpio),
+				     "failed to get powerdown gpio\n");
+
+	sc2332->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(sc2332->regmap))
+		return dev_err_probe(dev, PTR_ERR(sc2332->regmap),
+				     "failed to get cci regmap\n");
+
+	ret = sc2332_power_on(dev);
+	if (ret)
+		return ret;
+
+	ret = sc2332_identify_module(sc2332);
+	if (ret)
+		goto err_power_off;
+
+	sc2332->mode = &sc2332_modes[0];
+
+	ret = sc2332_init_controls(sc2332);
+	if (ret)
+		goto err_power_off;
+
+	sc2332->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	sc2332->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	sc2332->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&sc2332->sd.entity, 1, &sc2332->pad);
+	if (ret)
+		goto err_handler_free;
+
+	sc2332->sd.state_lock = sc2332->ctrls.handler.lock;
+	ret = v4l2_subdev_init_finalize(&sc2332->sd);
+	if (ret)
+		goto err_media_entity;
+
+	pm_runtime_set_active(dev);
+	pm_runtime_get_noresume(dev);
+	pm_runtime_enable(dev);
+	pm_runtime_set_autosuspend_delay(dev, 1000);
+	pm_runtime_use_autosuspend(dev);
+	pm_runtime_put_autosuspend(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&sc2332->sd);
+	if (ret)
+		goto err_subdev_cleanup;
+
+	return 0;
+
+err_subdev_cleanup:
+	v4l2_subdev_cleanup(&sc2332->sd);
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+err_media_entity:
+	media_entity_cleanup(&sc2332->sd.entity);
+err_handler_free:
+	v4l2_ctrl_handler_free(&sc2332->ctrls.handler);
+err_power_off:
+	sc2332_power_off(dev);
+
+	return ret;
+}
+
+static void sc2332_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct sc2332 *sc2332 = to_sc2332(sd);
+
+	v4l2_subdev_cleanup(sd);
+	v4l2_async_unregister_subdev(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&sc2332->ctrls.handler);
+
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev))
+		sc2332_power_off(&client->dev);
+	pm_runtime_set_suspended(&client->dev);
+}
+
+static const struct of_device_id sc2332_dt_ids[] = {
+	{ .compatible = "smartens,sc2332" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, sc2332_dt_ids);
+
+static const struct i2c_device_id sc2332_id[] = {
+	{ .name = "sc2332" },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, sc2332_id);
+
+static const struct dev_pm_ops sc2332_pm_ops = {
+	RUNTIME_PM_OPS(sc2332_power_off, sc2332_power_on, NULL)
+};
+
+static struct i2c_driver sc2332_i2c_driver = {
+	.driver = {
+		.name = "sc2332",
+		.of_match_table = sc2332_dt_ids,
+		.pm = pm_ptr(&sc2332_pm_ops),
+	},
+	.probe = sc2332_probe,
+	.remove = sc2332_remove,
+	.id_table = sc2332_id,
+};
+
+module_i2c_driver(sc2332_i2c_driver);
+
+MODULE_DESCRIPTION("SmartSens SC2332 sensor driver");
+MODULE_LICENSE("GPL");
