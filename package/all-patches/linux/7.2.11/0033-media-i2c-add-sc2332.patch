From: Paul Philippov <paul@themactep.com>
Subject: [PATCH] media: i2c: add the SmartSens SC2332 sensor driver

Add a mainline V4L2 subdev driver for the SmartSens SC2332 image
sensor. The mode register sequence and gain table are adapted from the
Ingenic vendor sensor driver (sensor_sc2332_t31).

The driver uses the CCI register helpers, runtime PM, and the current
state-based subdev pad API. It exposes the full-resolution mode with
HBLANK/VBLANK, exposure, analogue gain, and mirror/flip controls where
the vendor driver provides them.

Signed-off-by: Paul Philippov <paul@themactep.com>
---
--- /dev/null
+++ b/drivers/media/i2c/sc2332.c
@@ -0,0 +1,913 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * SmartSens SC2332 CMOS Image Sensor Driver
+ *
+ * The register sequences and gain table are adapted from the Ingenic
+ * vendor sensor driver (sensor_sc2332_t31).
+ *
+ * WARNING: this driver has not been validated on hardware. Only the SC2336
+ * driver has been tested on a camera.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+#include <linux/units.h>
+
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-mediabus.h>
+
+#define SC2332_CHIP_ID_H			0xcb
+#define SC2332_CHIP_ID_L			0x17
+
+#define SC2332_REG_CHIP_ID_H			CCI_REG8(0x3107)
+#define SC2332_REG_CHIP_ID_L			CCI_REG8(0x3108)
+
+#define SC2332_REG_STREAM			CCI_REG8(0x0100)
+
+/* HTS/VTS are big-endian 16-bit values. */
+#define SC2332_REG_HTS				CCI_REG16(0x320c)
+#define SC2332_REG_VTS_H			CCI_REG8(0x320e)
+#define SC2332_REG_VTS_L			CCI_REG8(0x320f)
+
+/* Exposure is a 16-bit value in units of 1/2 line, split 4/8/4 bits. */
+#define SC2332_REG_EXPOSURE_0			CCI_REG8(0x3e00)
+#define SC2332_REG_EXPOSURE_1			CCI_REG8(0x3e01)
+#define SC2332_REG_EXPOSURE_2			CCI_REG8(0x3e02)
+
+#define SC2332_REG_GAIN_L			CCI_REG8(0x3e09)
+#define SC2332_REG_GAIN_H			CCI_REG8(0x3e08)
+
+/* 0x320e/0x320f updates are latched by 0x3812. */
+#define SC2332_REG_GROUP_HOLD			CCI_REG8(0x3812)
+#define SC2332_GROUP_HOLD_OPEN			0x00
+#define SC2332_GROUP_HOLD_CLOSE			0x30
+
+#define SC2332_REG_FLIP				CCI_REG8(0x3221)
+#define SC2332_FLIP_MASK			0x60
+
+#define SC2332_STREAM_ON			0x01
+
+/* External clock is 24 MHz. */
+#define SC2332_XCLK_FREQ			(24 * HZ_PER_MHZ)
+
+#define SC2332_NATIVE_WIDTH			1920U
+#define SC2332_NATIVE_HEIGHT			1080U
+
+/* 2 lanes, 384 Mbit/s per lane. */
+#define SC2332_LINK_FREQ			192000000
+/* 2132 x 1350 pixels at 25 fps. */
+#define SC2332_PIXEL_RATE			71955000
+
+static const s64 sc2332_link_freqs[] = {
+	SC2332_LINK_FREQ,
+};
+
+#define SC2332_HTS_MIN				2132U
+#define SC2332_HTS_MAX				0xffffU
+#define SC2332_VTS_MAX				0xffffU
+
+/* Number of lines by which exposure must be less than VTS. */
+#define SC2332_EXPOSURE_OFFSET			2
+
+/* The legacy init sequence ends with a 22 ms delay after stream on. */
+#define SC2332_INIT_DELAY_MS			22
+
+struct sc2332_gain {
+	u8 reg_3e09;
+	u8 reg_3e08;
+};
