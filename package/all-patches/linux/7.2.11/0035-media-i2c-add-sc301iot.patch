From: Paul Philippov <paul@themactep.com>
Subject: [PATCH] media: i2c: add the SmartSens SC301IOT sensor driver

Add a mainline V4L2 subdev driver for the SmartSens SC301IOT image
sensor. The mode register sequence and gain table are adapted from the
Ingenic vendor sensor driver (sensor_sc301iot_t31).

The driver uses the CCI register helpers, runtime PM, and the current
state-based subdev pad API. It exposes the full-resolution mode with
HBLANK/VBLANK, exposure, analogue gain, and mirror/flip controls where
the vendor driver provides them.

Signed-off-by: Paul Philippov <paul@themactep.com>
---
--- /dev/null
+++ b/drivers/media/i2c/sc301iot.c
@@ -0,0 +1,1057 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * SmartSens SC301IOT CMOS Image Sensor Driver
+ *
+ * The register sequences and gain table are adapted from the Ingenic
+ * vendor sensor driver (sensor_sc301iot_t31).
+ *
+ * WARNING: this driver has not been validated on hardware. Only the SC2336
+ * driver has been tested on a camera.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+#include <linux/units.h>
+
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-mediabus.h>
+
+#define SC301IOT_CHIP_ID_H			0xcc
+#define SC301IOT_CHIP_ID_L			0x40
+
+#define SC301IOT_REG_CHIP_ID_H		CCI_REG8(0x3107)
+#define SC301IOT_REG_CHIP_ID_L		CCI_REG8(0x3108)
+
+#define SC301IOT_REG_SOFTWARE_RESET		CCI_REG8(0x0103)
+#define SC301IOT_REG_STREAM			CCI_REG8(0x0100)
+
+/* HTS/VTS are big-endian 16-bit values. */
+#define SC301IOT_REG_HTS			CCI_REG16(0x320c)
+#define SC301IOT_REG_VTS			CCI_REG16(0x320e)
+
+/*
+ * Exposure is a 20-bit value in units of half lines, laid out
+ * big-endian over 0x3e00..0x3e02.
+ */
+#define SC301IOT_REG_EXPOSURE		CCI_REG24(0x3e00)
+
+#define SC301IOT_REG_GAIN_3E09		CCI_REG8(0x3e09)
+#define SC301IOT_REG_GAIN_3E07		CCI_REG8(0x3e07)
+#define SC301IOT_REG_FLIP		CCI_REG8(0x3221)
+#define SC301IOT_FLIP_BOTH		0x60
+
+#define SC301IOT_STREAM_ON			0x01
+
+/* External clock is 24 MHz. */
+#define SC301IOT_XCLK_FREQ			(24 * HZ_PER_MHZ)
+
+#define SC301IOT_NATIVE_WIDTH		2048U
+#define SC301IOT_NATIVE_HEIGHT		1536U
+
+/* 2 lanes, 540 Mbit/s per lane. */
+#define SC301IOT_LINK_FREQ			270000000
+/* 2250 x 1920 pixels at 25 fps. */
+#define SC301IOT_PIXEL_RATE			108000000
+
+static const s64 sc301iot_link_freqs[] = {
+	SC301IOT_LINK_FREQ,
+};
+
+#define SC301IOT_HTS_MIN			2250U
+#define SC301IOT_HTS_MAX			0xffffU
+#define SC301IOT_VTS_MAX			0xffffU
+
+/* Number of lines by which exposure must be less than VTS. */
+#define SC301IOT_EXPOSURE_OFFSET		5
+
+struct sc301iot_gain {
+	u8 reg_3e09; u8 reg_3e07;
+};
