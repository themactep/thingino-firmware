+	struct v4l2_ctrl *hblank;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *gain;
+	struct v4l2_ctrl *vflip;
+};
+
+struct sc301iot {
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+
+	struct regmap *regmap;
+	struct clk *xclk;
+
+	struct gpio_desc *reset_gpio;
+	struct gpio_desc *powerdown_gpio;
+	struct regulator_bulk_data supplies[3];
+
+	struct sc301iot_ctrls ctrls;
+
+	const struct sc301iot_mode *mode;
+};
+
+static inline struct sc301iot *to_sc301iot(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct sc301iot, sd);
+}
+
+static inline struct v4l2_subdev *sc301iot_ctrl_to_sd(struct v4l2_ctrl *ctrl)
+{
+	return &container_of(ctrl->handler, struct sc301iot, ctrls.handler)->sd;
+}
+
+static void sc301iot_fill_format(const struct sc301iot_mode *mode,
+			       struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->code = MEDIA_BUS_FMT_SBGGR10_1X10;
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	fmt->quantization = V4L2_QUANTIZATION_DEFAULT;
+	fmt->xfer_func = V4L2_XFER_FUNC_DEFAULT;
+}
+
+static int sc301iot_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct v4l2_mbus_framefmt *fmt;
+	struct v4l2_rect *crop;
+
+	fmt = v4l2_subdev_state_get_format(state, 0);
+	sc301iot_fill_format(&sc301iot_modes[0], fmt);
+
+	crop = v4l2_subdev_state_get_crop(state, 0);
+	crop->left = 0;
+	crop->top = 0;
+	crop->width = sc301iot_modes[0].width;
+	crop->height = sc301iot_modes[0].height;
+
+	return 0;
+}
+
+static int sc301iot_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index != 0)
+		return -EINVAL;
+
+	code->code = MEDIA_BUS_FMT_SBGGR10_1X10;
+
+	return 0;
+}
+
+static int sc301iot_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index >= ARRAY_SIZE(sc301iot_modes))
+		return -EINVAL;
+
+	if (fse->code != MEDIA_BUS_FMT_SBGGR10_1X10)
+		return -EINVAL;
+
+	fse->min_width = sc301iot_modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = sc301iot_modes[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+static int sc301iot_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		sel->r = *v4l2_subdev_state_get_crop(state, 0);
+		return 0;
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = SC301IOT_NATIVE_WIDTH;
+		sel->r.height = SC301IOT_NATIVE_HEIGHT;
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static int sc301iot_set_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct sc301iot *sc301iot = to_sc301iot(sd);
+	const struct sc301iot_mode *mode;
+	struct v4l2_mbus_framefmt *framefmt;
+	struct v4l2_rect *crop;
+
+	mode = v4l2_find_nearest_size(sc301iot_modes, ARRAY_SIZE(sc301iot_modes),
+				      width, height,
+				      fmt->format.width, fmt->format.height);
+
+	sc301iot_fill_format(mode, &fmt->format);
+	framefmt = v4l2_subdev_state_get_format(state, fmt->pad);
+	*framefmt = fmt->format;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_ACTIVE) {
+		sc301iot->mode = mode;
+		__v4l2_ctrl_s_ctrl(sc301iot->ctrls.hblank, mode->hblank);
+		__v4l2_ctrl_s_ctrl(sc301iot->ctrls.vblank, mode->vblank);
+	}
+
+	crop = v4l2_subdev_state_get_crop(state, fmt->pad);
+	crop->left = 0;
+	crop->top = 0;
+	crop->width = mode->width;
+	crop->height = mode->height;
+
+	return 0;
+}
+
+static void sc301iot_exposure_update(struct sc301iot *sc301iot)
+{
+	unsigned int exposure_max;
+
+	exposure_max = sc301iot->ctrls.vblank->val + sc301iot->mode->height -
+		       SC301IOT_EXPOSURE_OFFSET;
+	exposure_max = min(exposure_max, 0xfffffU >> 4);
+
+	__v4l2_ctrl_modify_range(sc301iot->ctrls.exposure, 1, exposure_max, 1,
+				 exposure_max);
+}
+
+static int sc301iot_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct sc301iot *sc301iot = to_sc301iot(sc301iot_ctrl_to_sd(ctrl));
+	u32 hts;
+	int ret = 0;
+
+	if (ctrl->flags & V4L2_CTRL_FLAG_READ_ONLY)
+		return 0;
+
+	if (ctrl->id == V4L2_CID_VBLANK)
+		sc301iot_exposure_update(sc301iot);
+
+	if (!pm_runtime_get_if_in_use(sc301iot->sd.dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		ret = cci_write(sc301iot->regmap, SC301IOT_REG_EXPOSURE,
+				(u32)ctrl->val << 4, NULL);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+	{
+		const struct sc301iot_gain *gain = &sc301iot_gains[ctrl->val];
+
+		ret = cci_write(sc301iot->regmap, SC301IOT_REG_GAIN_3E09,
+				gain->reg_3e09, NULL);
+		ret = cci_write(sc301iot->regmap, SC301IOT_REG_GAIN_3E07,
+				gain->reg_3e07, &ret);
+		break;
+	}
+		break;
+	case V4L2_CID_HBLANK:
+		hts = ctrl->val + sc301iot->mode->width;
+		ret = cci_write(sc301iot->regmap, SC301IOT_REG_HTS, hts / 2, NULL);
+		break;
+	case V4L2_CID_VBLANK:
+		ret = cci_write(sc301iot->regmap, SC301IOT_REG_VTS,
+				ctrl->val + sc301iot->mode->height, NULL);
+		break;
+	case V4L2_CID_VFLIP:
+		ret = cci_update_bits(sc301iot->regmap, SC301IOT_REG_FLIP,
+				      SC301IOT_FLIP_BOTH,
+				      ctrl->val ? SC301IOT_FLIP_BOTH : 0,
+				      NULL);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put_autosuspend(sc301iot->sd.dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops sc301iot_ctrl_ops = {
+	.s_ctrl = sc301iot_set_ctrl,
+};
+
+static int sc301iot_init_controls(struct sc301iot *sc301iot)
+{
+	struct v4l2_ctrl_handler *hdl = &sc301iot->ctrls.handler;
+	struct v4l2_fwnode_device_properties props;
+	const struct v4l2_ctrl_ops *ops = &sc301iot_ctrl_ops;
+	unsigned int hblank_max = SC301IOT_HTS_MAX - SC301IOT_NATIVE_WIDTH;
+	unsigned int vblank_max = SC301IOT_VTS_MAX - SC301IOT_NATIVE_HEIGHT;
+	int ret;
+
+	ret = v4l2_ctrl_handler_init(hdl, 10);
+	if (ret)
+		return ret;
+
+	sc301iot->ctrls.pixel_rate =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_PIXEL_RATE,
+				  SC301IOT_PIXEL_RATE, SC301IOT_PIXEL_RATE, 1,
+				  SC301IOT_PIXEL_RATE);
+
+	sc301iot->ctrls.link_freq =
+		v4l2_ctrl_new_int_menu(hdl, ops, V4L2_CID_LINK_FREQ, 0, 0,
+				       sc301iot_link_freqs);
+	if (sc301iot->ctrls.link_freq)
+		sc301iot->ctrls.link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	sc301iot->ctrls.exposure =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_EXPOSURE, 1,
+				  sc301iot_modes[0].vblank +
+				  sc301iot_modes[0].height -
+				  SC301IOT_EXPOSURE_OFFSET, 1,
+				  sc301iot_modes[0].vblank +
+				  sc301iot_modes[0].height -
+				  SC301IOT_EXPOSURE_OFFSET);
+
+	sc301iot->ctrls.gain =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_ANALOGUE_GAIN, 0,
+				  ARRAY_SIZE(sc301iot_gains) - 1, 1, 0);
+
+	sc301iot->ctrls.hblank =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_HBLANK,
+				  SC301IOT_HTS_MIN - SC301IOT_NATIVE_WIDTH,
+				  hblank_max, 1,
+				  sc301iot_modes[0].hblank);
+
+	sc301iot->ctrls.vblank =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_VBLANK,
+				  sc301iot_modes[0].vblank, vblank_max, 1,
+				  sc301iot_modes[0].vblank);
+
+	sc301iot->ctrls.vflip = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_VFLIP,
+						  0, 1, 1, 0);
+
+	if (hdl->error) {
+		ret = hdl->error;
+		goto error;
+	}
+
+	ret = v4l2_fwnode_device_parse(sc301iot->sd.dev, &props);
+	if (ret)
+		goto error;
+
+	ret = v4l2_ctrl_new_fwnode_properties(hdl, ops, &props);
+	if (ret)
+		goto error;
+
+	sc301iot->sd.ctrl_handler = hdl;
+
+	return 0;
+
+error:
+	v4l2_ctrl_handler_free(hdl);
+
+	return ret;
+}
+
+static int sc301iot_check_hwcfg(struct device *dev)
+{
+	struct v4l2_fwnode_endpoint ep = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	struct fwnode_handle *endpoint;
+	unsigned int i;
+	int ret;
+
+	endpoint = fwnode_graph_get_next_endpoint(dev_fwnode(dev), NULL);
+	if (!endpoint) {
+		dev_err(dev, "endpoint node not found\n");
+		return -EINVAL;
+	}
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(endpoint, &ep);
+	fwnode_handle_put(endpoint);
+	if (ret)
+		return ret;
+
+	if (ep.bus.mipi_csi2.num_data_lanes != 2) {
+		dev_err(dev, "only 2 data lanes are currently supported\n");
+		ret = -EINVAL;
+		goto out;
+	}
+
+	if (!ep.nr_of_link_frequencies) {
+		dev_err(dev, "link-frequency property not found in DT\n");
+		ret = -EINVAL;
+		goto out;
+	}
+
+	for (i = 0; i < ep.nr_of_link_frequencies; i++) {
+		if (ep.link_frequencies[i] == SC301IOT_LINK_FREQ)
+			break;
+	}
+
+	if (i == ep.nr_of_link_frequencies) {
+		dev_err(dev, "expected link frequency %u\n", SC301IOT_LINK_FREQ);
+		ret = -EINVAL;
+	}
+
+out:
+	v4l2_fwnode_endpoint_free(&ep);
+
+	return ret;
+}
+
+static int sc301iot_power_on(struct device *dev)
+{
+	struct sc301iot *sc301iot = to_sc301iot(dev_get_drvdata(dev));
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(sc301iot->supplies),
+				    sc301iot->supplies);
+	if (ret)
+		return ret;
+
+	ret = clk_prepare_enable(sc301iot->xclk);
+	if (ret)
+		goto err_regulators;
+
+	/* The sensor needs MCLK while reset is released. */
+	gpiod_set_value_cansleep(sc301iot->powerdown_gpio, 0);
+	gpiod_set_value_cansleep(sc301iot->reset_gpio, 0);
+	msleep(20);
+
+	return 0;
+
+err_regulators:
+	regulator_bulk_disable(ARRAY_SIZE(sc301iot->supplies), sc301iot->supplies);
+
+	return ret;
+}
+
+static int sc301iot_power_off(struct device *dev)
+{
+	struct sc301iot *sc301iot = to_sc301iot(dev_get_drvdata(dev));
+
+	gpiod_set_value_cansleep(sc301iot->reset_gpio, 1);
+	gpiod_set_value_cansleep(sc301iot->powerdown_gpio, 1);
+	clk_disable_unprepare(sc301iot->xclk);
+	regulator_bulk_disable(ARRAY_SIZE(sc301iot->supplies), sc301iot->supplies);
+
+	return 0;
+}
+
+static int sc301iot_identify_module(struct sc301iot *sc301iot)
+{
+	u64 id_h, id_l;
+	int ret;
+
+	ret = cci_read(sc301iot->regmap, SC301IOT_REG_CHIP_ID_H, &id_h, NULL);
+	if (ret)
+		return ret;
+
+	ret = cci_read(sc301iot->regmap, SC301IOT_REG_CHIP_ID_L, &id_l, NULL);
+	if (ret)
+		return ret;
+
+	if (id_h != SC301IOT_CHIP_ID_H || id_l != SC301IOT_CHIP_ID_L) {
+		dev_err(sc301iot->sd.dev, "chip id mismatch: %x%x != %x%x\n",
+			(u8)id_h, (u8)id_l, SC301IOT_CHIP_ID_H, SC301IOT_CHIP_ID_L);
+		return -EIO;
+	}
+
+	return 0;
+}
+
+static int sc301iot_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state, u32 pad,
+				 u64 streams_mask)
+{
+	struct sc301iot *sc301iot = to_sc301iot(sd);
+	int ret;
+
+	ret = pm_runtime_resume_and_get(sd->dev);
+	if (ret)
+		return ret;
+
+	cci_multi_reg_write(sc301iot->regmap, sc301iot->mode->regs,
+			    sc301iot->mode->regs_num, &ret);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = __v4l2_ctrl_handler_setup(&sc301iot->ctrls.handler);
+	if (ret)
+		goto err_rpm_put;
+
+	cci_write(sc301iot->regmap, SC301IOT_REG_STREAM, SC301IOT_STREAM_ON, &ret);
+	if (ret)
+		goto err_rpm_put;
+
+	return 0;
+
+err_rpm_put:
+	pm_runtime_put_autosuspend(sd->dev);
+
+	return ret;
+}
+
+static int sc301iot_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	struct sc301iot *sc301iot = to_sc301iot(sd);
+	int ret = 0;
+
+	cci_write(sc301iot->regmap, SC301IOT_REG_STREAM, 0x00, &ret);
+	if (ret)
+		dev_err(sd->dev, "failed to stop streaming: %d\n", ret);
+
+	pm_runtime_put_autosuspend(sd->dev);
+
+	return ret;
+}
+
+static const struct v4l2_subdev_video_ops sc301iot_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops sc301iot_pad_ops = {
+	.enum_mbus_code = sc301iot_enum_mbus_code,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = sc301iot_set_pad_format,
+	.get_selection = sc301iot_get_selection,
+	.enum_frame_size = sc301iot_enum_frame_size,
+	.enable_streams = sc301iot_enable_streams,
+	.disable_streams = sc301iot_disable_streams,
+};
+
+static const struct v4l2_subdev_ops sc301iot_subdev_ops = {
+	.video = &sc301iot_video_ops,
+	.pad = &sc301iot_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops sc301iot_subdev_internal_ops = {
+	.init_state = sc301iot_init_state,
+};
+
+static const char * const sc301iot_supply_names[] = {
+	"iovdd",
+	"avdd",
+	"dvdd",
+};
+
+static int sc301iot_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct sc301iot *sc301iot;
+	unsigned int i;
+	unsigned long xclk_freq;
+	int ret;
+
+	sc301iot = devm_kzalloc(dev, sizeof(*sc301iot), GFP_KERNEL);
+	if (!sc301iot)
+		return -ENOMEM;
+
+	v4l2_i2c_subdev_init(&sc301iot->sd, client, &sc301iot_subdev_ops);
+	sc301iot->sd.internal_ops = &sc301iot_subdev_internal_ops;
+
+	ret = sc301iot_check_hwcfg(dev);
+	if (ret)
+		return ret;
+
+	sc301iot->xclk = devm_v4l2_sensor_clk_get(dev, NULL);
+	if (IS_ERR(sc301iot->xclk))
+		return dev_err_probe(dev, PTR_ERR(sc301iot->xclk),
+				     "failed to get xclk\n");
+
+	xclk_freq = clk_get_rate(sc301iot->xclk);
+	if (xclk_freq != SC301IOT_XCLK_FREQ)
+		return dev_err_probe(dev, -EINVAL,
+				     "xclk frequency %lu Hz not supported\n",
+				     xclk_freq);
+
+	for (i = 0; i < ARRAY_SIZE(sc301iot->supplies); i++)
+		sc301iot->supplies[i].supply = sc301iot_supply_names[i];
+
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(sc301iot->supplies),
+				      sc301iot->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get regulators\n");
+
+	sc301iot->reset_gpio = devm_gpiod_get_optional(dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(sc301iot->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(sc301iot->reset_gpio),
+				     "failed to get reset gpio\n");
+
+	sc301iot->powerdown_gpio = devm_gpiod_get_optional(dev, "powerdown",
+							 GPIOD_OUT_HIGH);
+	if (IS_ERR(sc301iot->powerdown_gpio))
+		return dev_err_probe(dev, PTR_ERR(sc301iot->powerdown_gpio),
+				     "failed to get powerdown gpio\n");
+
+	sc301iot->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(sc301iot->regmap))
+		return dev_err_probe(dev, PTR_ERR(sc301iot->regmap),
+				     "failed to get cci regmap\n");
+
+	ret = sc301iot_power_on(dev);
+	if (ret)
+		return ret;
+
+	ret = sc301iot_identify_module(sc301iot);
+	if (ret)
+		goto err_power_off;
+
+	sc301iot->mode = &sc301iot_modes[0];
+
+	ret = sc301iot_init_controls(sc301iot);
+	if (ret)
+		goto err_power_off;
+
+	sc301iot->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	sc301iot->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	sc301iot->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&sc301iot->sd.entity, 1, &sc301iot->pad);
+	if (ret)
+		goto err_handler_free;
+
+	sc301iot->sd.state_lock = sc301iot->ctrls.handler.lock;
+	ret = v4l2_subdev_init_finalize(&sc301iot->sd);
+	if (ret)
+		goto err_media_entity;
+
+	pm_runtime_set_active(dev);
+	pm_runtime_get_noresume(dev);
+	pm_runtime_enable(dev);
+	pm_runtime_set_autosuspend_delay(dev, 1000);
+	pm_runtime_use_autosuspend(dev);
+	pm_runtime_put_autosuspend(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&sc301iot->sd);
+	if (ret)
+		goto err_subdev_cleanup;
+
+	return 0;
+
+err_subdev_cleanup:
+	v4l2_subdev_cleanup(&sc301iot->sd);
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+err_media_entity:
+	media_entity_cleanup(&sc301iot->sd.entity);
+err_handler_free:
+	v4l2_ctrl_handler_free(&sc301iot->ctrls.handler);
+err_power_off:
+	sc301iot_power_off(dev);
+
+	return ret;
+}
+
+static void sc301iot_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct sc301iot *sc301iot = to_sc301iot(sd);
+
+	v4l2_subdev_cleanup(sd);
+	v4l2_async_unregister_subdev(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&sc301iot->ctrls.handler);
+
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev))
+		sc301iot_power_off(&client->dev);
+	pm_runtime_set_suspended(&client->dev);
+}
+
+static const struct of_device_id sc301iot_dt_ids[] = {
+	{ .compatible = "smartens,sc301iot" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, sc301iot_dt_ids);
+
+static const struct i2c_device_id sc301iot_id[] = {
+	{ .name = "sc301iot" },
+	{ }
+};
