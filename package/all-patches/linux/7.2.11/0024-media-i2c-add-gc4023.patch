+#define GC4023_REG_GAIN_1468			CCI_REG8(0x1468)
+#define GC4023_REG_GAIN_B8			CCI_REG8(0x00b8)
+#define GC4023_REG_GAIN_B9			CCI_REG8(0x00b9)
+
+#define GC4023_REG_FLIP				CCI_REG8(0x022c)
+#define GC4023_FLIP_VFLIP			BIT(1)
+
+/* External clock is 27 MHz. */
+#define GC4023_XCLK_FREQ			(27 * HZ_PER_MHZ)
+
+#define GC4023_NATIVE_WIDTH			2560U
+#define GC4023_NATIVE_HEIGHT			1440U
+
+/* 2 lanes, 864 Mbit/s per lane. */
+#define GC4023_LINK_FREQ			432000000
+/* 3840 x 1500 pixels at 30 fps. */
+#define GC4023_PIXEL_RATE			172800000
+
+static const s64 gc4023_link_freqs[] = {
+	GC4023_LINK_FREQ,
+};
+
+#define GC4023_HTS_MIN				3840U
+#define GC4023_HTS_MAX				(2U * 0x0fff)
+#define GC4023_VTS_MAX				0x3fffU
+
+/* Number of lines by which exposure must be less than VTS. */
+#define GC4023_EXPOSURE_OFFSET			8
+
+struct gc4023_gain {
+	u8 reg_614;
+	u8 reg_615;
+	u8 reg_218;
+	u8 reg_1467;
+	u8 reg_1468;
+	u8 reg_b8;
+	u8 reg_b9;
+};
+
