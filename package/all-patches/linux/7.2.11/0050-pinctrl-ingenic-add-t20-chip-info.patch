From: Paul Philippov <paul@themactep.com>
Subject: [PATCH] pinctrl: ingenic: add T20 chip info

The T20 pinctrl block packs its banks 0x100 apart. The T31 chip
info uses 0x1000, so every access to GPA/GPB/GPC lands outside the
bank and GPIO writes silently do nothing. Reuse the T31 pin tables
with the T20 bank stride and bind it through the T20 compatibles.

Signed-off-by: Paul Philippov <paul@themactep.com>
---
--- a/drivers/pinctrl/pinctrl-ingenic.c
+++ b/drivers/pinctrl/pinctrl-ingenic.c
@@ -2958,6 +2958,20 @@
 	.access_table = &t31_access_table,
 };
 
+/* T20 shares the T31 pin tables but packs the banks 0x100 apart. */
+static const struct ingenic_chip_info t20_chip_info = {
+	.num_chips = 3,
+	.reg_offset = 0x100,
+	.version = ID_T31,
+	.groups = t31_groups,
+	.num_groups = ARRAY_SIZE(t31_groups),
+	.functions = t31_functions,
+	.num_functions = ARRAY_SIZE(t31_functions),
+	.pull_ups = t31_pull_ups,
+	.pull_downs = t31_pull_downs,
+	.access_table = &t31_access_table,
+};
+
 static const u32 x2000_pull_ups[5] = {
 	0x0003ffff, 0xffffffff, 0x1ff0ffff, 0xc7fe3f3f, 0x8fff003f,
 };
@@ -4537,6 +4551,7 @@
 	{ .compatible = "ingenic,jz4775-gpio" },
 	{ .compatible = "ingenic,jz4780-gpio" },
 	{ .compatible = "ingenic,t31-gpio" },
+	{ .compatible = "ingenic,t20-gpio" },
 	{ .compatible = "ingenic,x1000-gpio" },
 	{ .compatible = "ingenic,x1600-gpio" },
 	{ .compatible = "ingenic,x1830-gpio" },
@@ -4796,6 +4811,10 @@
 		.data = IF_ENABLED(CONFIG_MACH_T31, &t31_chip_info)
 	},
 	{
+		.compatible = "ingenic,t20-pinctrl",
+		.data = IF_ENABLED(CONFIG_MACH_T20, &t20_chip_info)
+	},
+	{
 		.compatible = "ingenic,x2000-pinctrl",
 		.data = IF_ENABLED(CONFIG_MACH_X2000, &x2000_chip_info)
 	},
