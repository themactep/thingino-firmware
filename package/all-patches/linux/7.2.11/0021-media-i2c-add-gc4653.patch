+#define GC4653_REG_GAIN_2D9			CCI_REG8(0x02d9)
+
+/* 0x0101 is protected by the 0x031d access latch. */
+#define GC4653_REG_FLIP				CCI_REG8(0x0101)
+#define GC4653_REG_ACCESS			CCI_REG8(0x031d)
+#define GC4653_ACCESS_OPEN			0x2d
+#define GC4653_ACCESS_CLOSE			0x28
+#define GC4653_FLIP_MIRROR			BIT(0)
+#define GC4653_FLIP_VFLIP			BIT(1)
+
+/* External clock is 27 MHz. */
+#define GC4653_XCLK_FREQ			(27 * HZ_PER_MHZ)
+
+#define GC4653_NATIVE_WIDTH			2560U
+#define GC4653_NATIVE_HEIGHT			1440U
+
+/* 2 lanes, 648 Mbit/s per lane. */
+#define GC4653_LINK_FREQ			324000000
+/* 3000 x 1600 pixels at 30 fps. */
+#define GC4653_PIXEL_RATE			144000000
+
+static const s64 gc4653_link_freqs[] = {
+	GC4653_LINK_FREQ,
+};
+
+#define GC4653_HTS_MIN				3000U
+#define GC4653_HTS_MAX				(2U * 0x0fff)
+#define GC4653_VTS_MAX				0x3fffU
+
+/* Number of lines by which exposure must be less than VTS. */
+#define GC4653_EXPOSURE_OFFSET			4
+
+struct gc4653_gain {
+	u8 reg_2b3;
+	u8 reg_2b4;
+	u8 reg_2b8;
+	u8 reg_2b9;
+	u8 reg_515;
+	u8 reg_519;
+	u8 reg_2d9;
+};
