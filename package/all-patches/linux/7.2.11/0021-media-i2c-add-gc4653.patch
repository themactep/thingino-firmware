+
+static const struct gc4653_mode gc4653_modes[] = {
+	{
+		.width = GC4653_NATIVE_WIDTH,
+		.height = GC4653_NATIVE_HEIGHT,
+		.hblank = GC4653_HTS_MIN - GC4653_NATIVE_WIDTH,
+		.vblank = 1600 - GC4653_NATIVE_HEIGHT,
+		.regs = gc4653_1440p30_regs,
+		.regs_num = ARRAY_SIZE(gc4653_1440p30_regs),
+	},
+};
+
+struct gc4653_ctrls {
+	struct v4l2_ctrl_handler handler;
+	struct v4l2_ctrl *pixel_rate;
+	struct v4l2_ctrl *link_freq;
+	struct v4l2_ctrl *hblank;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *gain;
+	struct v4l2_ctrl *hflip;
+	struct v4l2_ctrl *vflip;
+};
+
+struct gc4653 {
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+
+	struct regmap *regmap;
+	struct clk *xclk;
+
+	struct gpio_desc *reset_gpio;
+	struct gpio_desc *powerdown_gpio;
+	struct regulator_bulk_data supplies[3];
+
+	struct gc4653_ctrls ctrls;
+
+	const struct gc4653_mode *mode;
+};
+
+static inline struct gc4653 *to_gc4653(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct gc4653, sd);
+}
+
+static inline struct v4l2_subdev *gc4653_ctrl_to_sd(struct v4l2_ctrl *ctrl)
+{
+	return &container_of(ctrl->handler, struct gc4653, ctrls.handler)->sd;
+}
+
+static void gc4653_fill_format(const struct gc4653_mode *mode,
+			       struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->code = MEDIA_BUS_FMT_SGRBG10_1X10;
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	fmt->quantization = V4L2_QUANTIZATION_DEFAULT;
+	fmt->xfer_func = V4L2_XFER_FUNC_DEFAULT;
+}
+
+static int gc4653_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct v4l2_mbus_framefmt *fmt;
+	struct v4l2_rect *crop;
+
+	fmt = v4l2_subdev_state_get_format(state, 0);
+	gc4653_fill_format(&gc4653_modes[0], fmt);
+
+	crop = v4l2_subdev_state_get_crop(state, 0);
+	crop->left = 0;
+	crop->top = 0;
+	crop->width = gc4653_modes[0].width;
+	crop->height = gc4653_modes[0].height;
+
+	return 0;
+}
+
+static int gc4653_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index != 0)
+		return -EINVAL;
+
+	code->code = MEDIA_BUS_FMT_SGRBG10_1X10;
+
+	return 0;
+}
+
+static int gc4653_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index >= ARRAY_SIZE(gc4653_modes))
+		return -EINVAL;
+
+	if (fse->code != MEDIA_BUS_FMT_SGRBG10_1X10)
+		return -EINVAL;
+
+	fse->min_width = gc4653_modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = gc4653_modes[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+static int gc4653_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		sel->r = *v4l2_subdev_state_get_crop(state, 0);
+		return 0;
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = GC4653_NATIVE_WIDTH;
+		sel->r.height = GC4653_NATIVE_HEIGHT;
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static int gc4653_set_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct gc4653 *gc4653 = to_gc4653(sd);
+	const struct gc4653_mode *mode;
+	struct v4l2_mbus_framefmt *framefmt;
+	struct v4l2_rect *crop;
+
+	mode = v4l2_find_nearest_size(gc4653_modes, ARRAY_SIZE(gc4653_modes),
+				      width, height,
+				      fmt->format.width, fmt->format.height);
+
+	gc4653_fill_format(mode, &fmt->format);
+	framefmt = v4l2_subdev_state_get_format(state, fmt->pad);
+	*framefmt = fmt->format;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_ACTIVE) {
+		gc4653->mode = mode;
+		__v4l2_ctrl_s_ctrl(gc4653->ctrls.hblank, mode->hblank);
+		__v4l2_ctrl_s_ctrl(gc4653->ctrls.vblank, mode->vblank);
+	}
+
+	crop = v4l2_subdev_state_get_crop(state, fmt->pad);
+	crop->left = 0;
+	crop->top = 0;
+	crop->width = mode->width;
+	crop->height = mode->height;
+
+	return 0;
+}
+
+static void gc4653_exposure_update(struct gc4653 *gc4653)
+{
+	unsigned int exposure_max;
+
+	exposure_max = gc4653->ctrls.vblank->val + gc4653->mode->height -
+		       GC4653_EXPOSURE_OFFSET;
+	exposure_max = min(exposure_max, 0xfffffU);
+
+	__v4l2_ctrl_modify_range(gc4653->ctrls.exposure, 1, exposure_max, 1,
+				 exposure_max);
+}
+
+static int gc4653_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct gc4653 *gc4653 = to_gc4653(gc4653_ctrl_to_sd(ctrl));
+	u32 hts;
+	int ret = 0;
+
+	if (ctrl->flags & V4L2_CTRL_FLAG_READ_ONLY)
+		return 0;
+
+	if (ctrl->id == V4L2_CID_VBLANK)
+		gc4653_exposure_update(gc4653);
+
+	if (!pm_runtime_get_if_in_use(gc4653->sd.dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		ret = cci_write(gc4653->regmap, GC4653_REG_EXPOSURE,
+				ctrl->val, NULL);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN: {
+		const struct gc4653_gain *gain = &gc4653_gains[ctrl->val];
+
+		ret = cci_write(gc4653->regmap, GC4653_REG_GAIN_2B3,
+				gain->reg_2b3, NULL);
+		ret = cci_write(gc4653->regmap, GC4653_REG_GAIN_2B4,
+				gain->reg_2b4, &ret);
+		ret = cci_write(gc4653->regmap, GC4653_REG_GAIN_2B8,
+				gain->reg_2b8, &ret);
+		ret = cci_write(gc4653->regmap, GC4653_REG_GAIN_2B9,
+				gain->reg_2b9, &ret);
+		ret = cci_write(gc4653->regmap, GC4653_REG_GAIN_515,
+				gain->reg_515, &ret);
+		ret = cci_write(gc4653->regmap, GC4653_REG_GAIN_519,
+				gain->reg_519, &ret);
+		ret = cci_write(gc4653->regmap, GC4653_REG_GAIN_2D9,
+				gain->reg_2d9, &ret);
+		break;
+	}
+	case V4L2_CID_HBLANK:
+		hts = ctrl->val + gc4653->mode->width;
+		ret = cci_write(gc4653->regmap, GC4653_REG_HTS, hts / 2, NULL);
+		break;
+	case V4L2_CID_VBLANK:
+		ret = cci_write(gc4653->regmap, GC4653_REG_VTS,
+				ctrl->val + gc4653->mode->height, NULL);
+		break;
+	case V4L2_CID_HFLIP:
+	case V4L2_CID_VFLIP:
+		cci_write(gc4653->regmap, GC4653_REG_ACCESS,
+			  GC4653_ACCESS_OPEN, &ret);
+		ret = cci_update_bits(gc4653->regmap, GC4653_REG_FLIP,
+				      ctrl->id == V4L2_CID_HFLIP ?
+				      GC4653_FLIP_MIRROR : GC4653_FLIP_VFLIP,
+				      ctrl->val ? (ctrl->id == V4L2_CID_HFLIP ?
+				      GC4653_FLIP_MIRROR : GC4653_FLIP_VFLIP) : 0,
+				      &ret);
+		cci_write(gc4653->regmap, GC4653_REG_ACCESS,
+			  GC4653_ACCESS_CLOSE, &ret);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put_autosuspend(gc4653->sd.dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops gc4653_ctrl_ops = {
+	.s_ctrl = gc4653_set_ctrl,
+};
+
+static int gc4653_init_controls(struct gc4653 *gc4653)
+{
+	struct v4l2_ctrl_handler *hdl = &gc4653->ctrls.handler;
+	struct v4l2_fwnode_device_properties props;
+	const struct v4l2_ctrl_ops *ops = &gc4653_ctrl_ops;
+	unsigned int hblank_max = GC4653_HTS_MAX - GC4653_NATIVE_WIDTH;
+	unsigned int vblank_max = GC4653_VTS_MAX - GC4653_NATIVE_HEIGHT;
+	int ret;
+
+	ret = v4l2_ctrl_handler_init(hdl, 10);
+	if (ret)
+		return ret;
+
+	gc4653->ctrls.pixel_rate =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_PIXEL_RATE,
+				  GC4653_PIXEL_RATE, GC4653_PIXEL_RATE, 1,
+				  GC4653_PIXEL_RATE);
+
+	gc4653->ctrls.link_freq =
+		v4l2_ctrl_new_int_menu(hdl, ops, V4L2_CID_LINK_FREQ, 0, 0,
+				       gc4653_link_freqs);
+	if (gc4653->ctrls.link_freq)
+		gc4653->ctrls.link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	gc4653->ctrls.exposure =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_EXPOSURE, 1,
+				  gc4653_modes[0].vblank +
+				  gc4653_modes[0].height -
+				  GC4653_EXPOSURE_OFFSET, 1,
+				  gc4653_modes[0].vblank +
+				  gc4653_modes[0].height -
+				  GC4653_EXPOSURE_OFFSET);
+
+	gc4653->ctrls.gain =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_ANALOGUE_GAIN, 0,
+				  ARRAY_SIZE(gc4653_gains) - 1, 1, 0);
+
+	gc4653->ctrls.hblank =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_HBLANK,
+				  GC4653_HTS_MIN - GC4653_NATIVE_WIDTH,
+				  hblank_max, 1,
+				  gc4653_modes[0].hblank);
+
+	gc4653->ctrls.vblank =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_VBLANK,
+				  gc4653_modes[0].vblank, vblank_max, 1,
+				  gc4653_modes[0].vblank);
+
+	gc4653->ctrls.hflip = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_HFLIP,
+						0, 1, 1, 0);
+	gc4653->ctrls.vflip = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_VFLIP,
+						0, 1, 1, 0);
+	v4l2_ctrl_cluster(2, &gc4653->ctrls.hflip);
+
+	if (hdl->error) {
+		ret = hdl->error;
+		goto error;
+	}
+
+	ret = v4l2_fwnode_device_parse(gc4653->sd.dev, &props);
+	if (ret)
+		goto error;
+
+	ret = v4l2_ctrl_new_fwnode_properties(hdl, ops, &props);
+	if (ret)
+		goto error;
+
+	gc4653->sd.ctrl_handler = hdl;
+
+	return 0;
+
+error:
+	v4l2_ctrl_handler_free(hdl);
+
+	return ret;
+}
+
+static int gc4653_check_hwcfg(struct device *dev)
+{
+	struct v4l2_fwnode_endpoint ep = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	struct fwnode_handle *endpoint;
+	unsigned int i;
+	int ret;
+
+	endpoint = fwnode_graph_get_next_endpoint(dev_fwnode(dev), NULL);
+	if (!endpoint) {
+		dev_err(dev, "endpoint node not found\n");
+		return -EINVAL;
+	}
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(endpoint, &ep);
+	fwnode_handle_put(endpoint);
+	if (ret)
+		return ret;
+
+	if (ep.bus.mipi_csi2.num_data_lanes != 2) {
+		dev_err(dev, "only 2 data lanes are currently supported\n");
+		ret = -EINVAL;
+		goto out;
+	}
+
+	if (!ep.nr_of_link_frequencies) {
+		dev_err(dev, "link-frequency property not found in DT\n");
+		ret = -EINVAL;
+		goto out;
+	}
+
+	for (i = 0; i < ep.nr_of_link_frequencies; i++) {
+		if (ep.link_frequencies[i] == GC4653_LINK_FREQ)
+			break;
+	}
+
+	if (i == ep.nr_of_link_frequencies) {
+		dev_err(dev, "expected link frequency %u\n", GC4653_LINK_FREQ);
+		ret = -EINVAL;
+	}
+
+out:
+	v4l2_fwnode_endpoint_free(&ep);
+
+	return ret;
+}
+
+static int gc4653_power_on(struct device *dev)
+{
+	struct gc4653 *gc4653 = to_gc4653(dev_get_drvdata(dev));
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(gc4653->supplies),
+				    gc4653->supplies);
+	if (ret)
+		return ret;
+
+	ret = clk_prepare_enable(gc4653->xclk);
+	if (ret)
+		goto err_regulators;
+
+	/* The sensor needs MCLK while reset is released. */
+	gpiod_set_value_cansleep(gc4653->powerdown_gpio, 0);
+	gpiod_set_value_cansleep(gc4653->reset_gpio, 0);
+	msleep(20);
+
+	return 0;
+
+err_regulators:
+	regulator_bulk_disable(ARRAY_SIZE(gc4653->supplies), gc4653->supplies);
+
+	return ret;
+}
+
+static int gc4653_power_off(struct device *dev)
+{
+	struct gc4653 *gc4653 = to_gc4653(dev_get_drvdata(dev));
+
+	gpiod_set_value_cansleep(gc4653->reset_gpio, 1);
+	gpiod_set_value_cansleep(gc4653->powerdown_gpio, 1);
+	clk_disable_unprepare(gc4653->xclk);
+	regulator_bulk_disable(ARRAY_SIZE(gc4653->supplies), gc4653->supplies);
+
+	return 0;
+}
+
+static int gc4653_identify_module(struct gc4653 *gc4653)
+{
+	u64 id_h, id_l;
+	int ret;
+
+	ret = cci_read(gc4653->regmap, GC4653_REG_CHIP_ID_H, &id_h, NULL);
+	if (ret)
+		return ret;
+
+	ret = cci_read(gc4653->regmap, GC4653_REG_CHIP_ID_L, &id_l, NULL);
+	if (ret)
+		return ret;
+
+	if (id_h != GC4653_CHIP_ID_H || id_l != GC4653_CHIP_ID_L) {
+		dev_err(gc4653->sd.dev, "chip id mismatch: %x%x != %x%x\n",
+			(u8)id_h, (u8)id_l, GC4653_CHIP_ID_H, GC4653_CHIP_ID_L);
+		return -EIO;
+	}
+
+	return 0;
+}
+
+static int gc4653_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state, u32 pad,
+				 u64 streams_mask)
+{
+	struct gc4653 *gc4653 = to_gc4653(sd);
+	int ret;
+
+	ret = pm_runtime_resume_and_get(sd->dev);
+	if (ret)
+		return ret;
+
+	cci_multi_reg_write(gc4653->regmap, gc4653->mode->regs,
+			    gc4653->mode->regs_num, &ret);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = __v4l2_ctrl_handler_setup(&gc4653->ctrls.handler);
+	if (ret)
+		goto err_rpm_put;
+
+	cci_write(gc4653->regmap, GC4653_REG_STREAM, GC4653_STREAM_ON, &ret);
+	if (ret)
+		goto err_rpm_put;
+
+	return 0;
+
+err_rpm_put:
+	pm_runtime_put_autosuspend(sd->dev);
+
+	return ret;
+}
+
+static int gc4653_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	struct gc4653 *gc4653 = to_gc4653(sd);
+	int ret = 0;
+
+	cci_write(gc4653->regmap, GC4653_REG_STREAM, 0x00, &ret);
+	if (ret)
+		dev_err(sd->dev, "failed to stop streaming: %d\n", ret);
+
+	pm_runtime_put_autosuspend(sd->dev);
+
+	return ret;
+}
+
+static const struct v4l2_subdev_video_ops gc4653_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops gc4653_pad_ops = {
+	.enum_mbus_code = gc4653_enum_mbus_code,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = gc4653_set_pad_format,
+	.get_selection = gc4653_get_selection,
+	.enum_frame_size = gc4653_enum_frame_size,
+	.enable_streams = gc4653_enable_streams,
+	.disable_streams = gc4653_disable_streams,
+};
+
+static const struct v4l2_subdev_ops gc4653_subdev_ops = {
+	.video = &gc4653_video_ops,
+	.pad = &gc4653_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops gc4653_subdev_internal_ops = {
+	.init_state = gc4653_init_state,
+};
+
+static const char * const gc4653_supply_names[] = {
+	"iovdd",
+	"avdd",
+	"dvdd",
+};
+
+static int gc4653_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct gc4653 *gc4653;
+	unsigned int i;
+	unsigned long xclk_freq;
+	int ret;
+
+	gc4653 = devm_kzalloc(dev, sizeof(*gc4653), GFP_KERNEL);
+	if (!gc4653)
+		return -ENOMEM;
+
+	v4l2_i2c_subdev_init(&gc4653->sd, client, &gc4653_subdev_ops);
+	gc4653->sd.internal_ops = &gc4653_subdev_internal_ops;
+
+	ret = gc4653_check_hwcfg(dev);
+	if (ret)
+		return ret;
+
+	gc4653->xclk = devm_v4l2_sensor_clk_get(dev, NULL);
+	if (IS_ERR(gc4653->xclk))
+		return dev_err_probe(dev, PTR_ERR(gc4653->xclk),
+				     "failed to get xclk\n");
+
+	xclk_freq = clk_get_rate(gc4653->xclk);
+	if (xclk_freq != GC4653_XCLK_FREQ)
+		return dev_err_probe(dev, -EINVAL,
+				     "xclk frequency %lu Hz not supported\n",
+				     xclk_freq);
+
+	for (i = 0; i < ARRAY_SIZE(gc4653->supplies); i++)
+		gc4653->supplies[i].supply = gc4653_supply_names[i];
+
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(gc4653->supplies),
+				      gc4653->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get regulators\n");
+
+	gc4653->reset_gpio = devm_gpiod_get_optional(dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(gc4653->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(gc4653->reset_gpio),
+				     "failed to get reset gpio\n");
+
+	gc4653->powerdown_gpio = devm_gpiod_get_optional(dev, "powerdown",
+							 GPIOD_OUT_HIGH);
+	if (IS_ERR(gc4653->powerdown_gpio))
+		return dev_err_probe(dev, PTR_ERR(gc4653->powerdown_gpio),
+				     "failed to get powerdown gpio\n");
+
+	gc4653->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(gc4653->regmap))
+		return dev_err_probe(dev, PTR_ERR(gc4653->regmap),
+				     "failed to get cci regmap\n");
+
+	ret = gc4653_power_on(dev);
+	if (ret)
+		return ret;
+
+	ret = gc4653_identify_module(gc4653);
+	if (ret)
+		goto err_power_off;
+
+	gc4653->mode = &gc4653_modes[0];
+
+	ret = gc4653_init_controls(gc4653);
+	if (ret)
+		goto err_power_off;
+
+	gc4653->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	gc4653->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	gc4653->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&gc4653->sd.entity, 1, &gc4653->pad);
+	if (ret)
+		goto err_handler_free;
+
+	gc4653->sd.state_lock = gc4653->ctrls.handler.lock;
+	ret = v4l2_subdev_init_finalize(&gc4653->sd);
+	if (ret)
+		goto err_media_entity;
+
+	pm_runtime_set_active(dev);
+	pm_runtime_get_noresume(dev);
+	pm_runtime_enable(dev);
+	pm_runtime_set_autosuspend_delay(dev, 1000);
+	pm_runtime_use_autosuspend(dev);
+	pm_runtime_put_autosuspend(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&gc4653->sd);
+	if (ret)
+		goto err_subdev_cleanup;
+
+	return 0;
+
+err_subdev_cleanup:
+	v4l2_subdev_cleanup(&gc4653->sd);
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+err_media_entity:
+	media_entity_cleanup(&gc4653->sd.entity);
+err_handler_free:
+	v4l2_ctrl_handler_free(&gc4653->ctrls.handler);
+err_power_off:
+	gc4653_power_off(dev);
+
+	return ret;
+}
+
+static void gc4653_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct gc4653 *gc4653 = to_gc4653(sd);
+
+	v4l2_subdev_cleanup(sd);
+	v4l2_async_unregister_subdev(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&gc4653->ctrls.handler);
+
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev))
+		gc4653_power_off(&client->dev);
+	pm_runtime_set_suspended(&client->dev);
+}
+
+static const struct of_device_id gc4653_dt_ids[] = {
+	{ .compatible = "galaxycore,gc4653" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, gc4653_dt_ids);
+
+static const struct i2c_device_id gc4653_id[] = {
+	{ .name = "gc4653" },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, gc4653_id);
+
+static const struct dev_pm_ops gc4653_pm_ops = {
+	RUNTIME_PM_OPS(gc4653_power_off, gc4653_power_on, NULL)
+};
+
+static struct i2c_driver gc4653_i2c_driver = {
+	.driver = {
+		.name = "gc4653",
+		.of_match_table = gc4653_dt_ids,
+		.pm = pm_ptr(&gc4653_pm_ops),
+	},
+	.id_table = gc4653_id,
+	.probe = gc4653_probe,
+	.remove = gc4653_remove,
+};
+
+module_i2c_driver(gc4653_i2c_driver);
+
+MODULE_DESCRIPTION("GalaxyCore GC4653 sensor driver");
+MODULE_LICENSE("GPL");
