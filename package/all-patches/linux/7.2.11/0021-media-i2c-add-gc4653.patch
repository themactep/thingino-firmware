+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-mediabus.h>
+
+#define GC4653_CHIP_ID_H			0x46
+#define GC4653_CHIP_ID_L			0x53
+
+#define GC4653_REG_CHIP_ID_H			CCI_REG8(0x03f0)
+#define GC4653_REG_CHIP_ID_L			CCI_REG8(0x03f1)
+
+#define GC4653_REG_PAGE_SELECT			CCI_REG8(0x03fe)
+#define GC4653_REG_STREAM			CCI_REG8(0x0100)
+#define GC4653_STREAM_ON			0x09
+
+/* HTS is stored divided by two; VTS is a 14-bit value. */
