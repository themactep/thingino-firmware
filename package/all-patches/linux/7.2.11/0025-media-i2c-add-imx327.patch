+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/sony,imx327.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Sony IMX327 1920x1080 CMOS Image Sensor
+
+maintainers:
+  - Paul Philippov <paul@themactep.com>
+
+description:
+  The Sony IMX327 is a 1920x1080 CMOS image sensor with a 10-bit ADC. It is programmable through an I2C interface and outputs raw Bayer data over a two-lane MIPI CSI-2 interface.
+
+allOf:
+  - $ref: /schemas/media/video-interface-devices.yaml#
+
+properties:
+  compatible:
+    const: sony,imx327
+
+  reg:
+    const: 0x36
+
+  clocks:
+    maxItems: 1
+
+  reset-gpios:
+    maxItems: 1
+
+  powerdown-gpios:
+    maxItems: 1
+
+  iovdd-supply:
+    description: Power supply for the I/O circuits (1.8 V).
+
+  avdd-supply:
+    description: Power supply for the analog circuits (2.8 V).
+
+  dvdd-supply:
+    description: Power supply for the digital core (1.2 V).
+
+  orientation: true
+
+  rotation: true
+
+  port:
+    $ref: /schemas/graph.yaml#/$defs/port-base
+
+    properties:
+      endpoint:
+        $ref: /schemas/media/video-interfaces.yaml#
+        unevaluatedProperties: false
+
+        properties:
+          link-frequencies: true
+
+        required:
+          - link-frequencies
+
+    required:
+      - endpoint
+
+    additionalProperties: false
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - reset-gpios
+  - iovdd-supply
+  - avdd-supply
+  - dvdd-supply
+  - port
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        camera@36 {
+            compatible = "sony,imx327";
+            reg = <0x36>;
+            clocks = <&clk_ext_camera>;
+            reset-gpios = <&gpa 18 GPIO_ACTIVE_LOW>;
+            iovdd-supply = <&vcc_1v8>;
+            avdd-supply = <&vcc_2v8>;
+            dvdd-supply = <&vcc_1v2>;
+
+            port {
+                endpoint {
+                    remote-endpoint = <&csi_in>;
+                    data-lanes = <1 2>;
+                    link-frequencies = /bits/ 64 <222500000>;
+                };
+            };
+        };
+    };
+
