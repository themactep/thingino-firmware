From: Paul Philippov <paul@themactep.com>
Subject: [PATCH] media: i2c: add the SmartSens SC3336 sensor driver

Add a mainline V4L2 subdev driver for the SmartSens SC3336 image
sensor. The mode register sequence and gain table are adapted from the
Ingenic vendor sensor driver (sensor_sc3336_t31).

The driver uses the CCI register helpers, runtime PM, and the current
state-based subdev pad API. It exposes the full-resolution mode with
HBLANK/VBLANK, exposure, analogue gain, and mirror/flip controls where
the vendor driver provides them.

Signed-off-by: Paul Philippov <paul@themactep.com>
---
--- /dev/null
+++ b/drivers/media/i2c/sc3336.c
@@ -0,0 +1,1103 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * SmartSens SC3336 CMOS Image Sensor Driver
+ *
+ * The register sequences and gain table are adapted from the Ingenic
+ * vendor sensor driver (sensor_sc3336_t31).
+ *
+ * WARNING: this driver has not been validated on hardware.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+#include <linux/units.h>
+
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-mediabus.h>
+
+#define SC3336_CHIP_ID_H				0xcc
+#define SC3336_CHIP_ID_L				0x41
+
+#define SC3336_REG_CHIP_ID_H			CCI_REG8(0x3107)
+#define SC3336_REG_CHIP_ID_L			CCI_REG8(0x3108)
+
+#define SC3336_REG_STREAM				CCI_REG8(0x0100)
+
+/* HTS is stored divided by two; VTS is a 16-bit value. */
+#define SC3336_REG_HTS				CCI_REG16(0x320c)
+#define SC3336_REG_VTS				CCI_REG16(0x320e)
+
+/*
+ * Exposure is a 20-bit value in units of 1/16 line, laid out
+ * big-endian over 0x3e00..0x3e02.
+ */
+#define SC3336_REG_EXPOSURE			CCI_REG24(0x3e00)
+
+#define SC3336_REG_GAIN_ANALOGUE		CCI_REG8(0x3e09)
+#define SC3336_REG_GAIN_COARSE		CCI_REG8(0x3e06)
+#define SC3336_REG_GAIN_FINE		CCI_REG8(0x3e07)
+
+#define SC3336_REG_FLIP				CCI_REG8(0x3221)
+#define SC3336_FLIP_MASK				0x60
+
+#define SC3336_STREAM_ON				0x01
+
+/* External clock is 24 MHz. */
+#define SC3336_XCLK_FREQ				(24 * HZ_PER_MHZ)
+
+#define SC3336_NATIVE_WIDTH			2304U
+#define SC3336_NATIVE_HEIGHT			1296U
+
+/* 2 lanes, 510 Mbit/s per lane. */
+#define SC3336_LINK_FREQ				255000000
+/* 2500 x 1632 pixels at 25 fps. */
+#define SC3336_PIXEL_RATE				102000000
+
+static const s64 sc3336_link_freqs[] = {
+	SC3336_LINK_FREQ,
+};
+
+#define SC3336_HTS_MIN				2500U
+#define SC3336_HTS_MAX				(2U * 0xffffU)
+#define SC3336_VTS_MAX				0xffffU
+
+/* Number of lines by which exposure must be less than VTS. */
+#define SC3336_EXPOSURE_OFFSET			8
+#define SC3336_EXPOSURE_MAX			0xffffU
+
+struct sc3336_gain {
+	u8 again;
+	u8 coarse_dgain;
+	u8 fine_dgain;
+};
