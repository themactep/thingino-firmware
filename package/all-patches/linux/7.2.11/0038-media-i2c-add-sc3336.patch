+	{ CCI_REG8(0x4509), 0x20 },
+	{ CCI_REG8(0x5ae0), 0xfe },
+	{ CCI_REG8(0x5ae1), 0x40 },
+	{ CCI_REG8(0x5ae2), 0x38 },
+	{ CCI_REG8(0x5ae3), 0x30 },
+	{ CCI_REG8(0x5ae4), 0x28 },
+	{ CCI_REG8(0x5ae5), 0x38 },
+	{ CCI_REG8(0x5ae6), 0x30 },
+	{ CCI_REG8(0x5ae7), 0x28 },
+	{ CCI_REG8(0x5ae8), 0x3f },
+	{ CCI_REG8(0x5ae9), 0x34 },
+	{ CCI_REG8(0x5aea), 0x2c },
+	{ CCI_REG8(0x5aeb), 0x3f },
+	{ CCI_REG8(0x5aec), 0x34 },
+	{ CCI_REG8(0x5aed), 0x2c },
+	{ CCI_REG8(0x36e9), 0x54 },
+	{ CCI_REG8(0x37f9), 0x47 },
+	{ CCI_REG8(0x0100), 0x01 },
+};
+
+static const struct sc3336_mode sc3336_modes[] = {
+	{
+		.width = SC3336_NATIVE_WIDTH,
+		.height = SC3336_NATIVE_HEIGHT,
+		.hblank = SC3336_HTS_MIN - SC3336_NATIVE_WIDTH,
+		.vblank = 1632 - SC3336_NATIVE_HEIGHT,
+		.regs = sc3336_regs_2304_1296_30fps,
+		.regs_num = ARRAY_SIZE(sc3336_regs_2304_1296_30fps),
+	},
+};
+
+struct sc3336_ctrls {
+	struct v4l2_ctrl_handler handler;
+	struct v4l2_ctrl *pixel_rate;
+	struct v4l2_ctrl *link_freq;
+	struct v4l2_ctrl *hblank;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *gain;
+	struct v4l2_ctrl *vflip;
+};
+
+struct sc3336 {
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+
+	struct regmap *regmap;
+	struct clk *xclk;
+
+	struct gpio_desc *reset_gpio;
+	struct gpio_desc *powerdown_gpio;
+	struct regulator_bulk_data supplies[3];
+
+	struct sc3336_ctrls ctrls;
+
+	const struct sc3336_mode *mode;
+
+
+};
+
+static inline struct sc3336 *to_sc3336(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct sc3336, sd);
+}
+
+static inline struct v4l2_subdev *sc3336_ctrl_to_sd(struct v4l2_ctrl *ctrl)
+{
+	return &container_of(ctrl->handler, struct sc3336, ctrls.handler)->sd;
+}
+
+static void sc3336_fill_format(const struct sc3336_mode *mode,
+			       struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->code = MEDIA_BUS_FMT_SBGGR10_1X10;
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	fmt->quantization = V4L2_QUANTIZATION_DEFAULT;
+	fmt->xfer_func = V4L2_XFER_FUNC_DEFAULT;
+}
+
+static int sc3336_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct v4l2_mbus_framefmt *fmt;
+	struct v4l2_rect *crop;
+
+	fmt = v4l2_subdev_state_get_format(state, 0);
+	sc3336_fill_format(&sc3336_modes[0], fmt);
+
+	crop = v4l2_subdev_state_get_crop(state, 0);
+	crop->left = 0;
+	crop->top = 0;
+	crop->width = sc3336_modes[0].width;
+	crop->height = sc3336_modes[0].height;
+
+	return 0;
+}
+
+static int sc3336_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index != 0)
+		return -EINVAL;
+
+	code->code = MEDIA_BUS_FMT_SBGGR10_1X10;
+
+	return 0;
+}
+
+static int sc3336_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index >= ARRAY_SIZE(sc3336_modes))
+		return -EINVAL;
+
+	if (fse->code != MEDIA_BUS_FMT_SBGGR10_1X10)
+		return -EINVAL;
+
+	fse->min_width = sc3336_modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = sc3336_modes[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+static int sc3336_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		sel->r = *v4l2_subdev_state_get_crop(state, 0);
+		return 0;
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = SC3336_NATIVE_WIDTH;
+		sel->r.height = SC3336_NATIVE_HEIGHT;
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static int sc3336_set_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct sc3336 *sc3336 = to_sc3336(sd);
+	const struct sc3336_mode *mode;
+	struct v4l2_mbus_framefmt *framefmt;
+	struct v4l2_rect *crop;
+
+	mode = v4l2_find_nearest_size(sc3336_modes, ARRAY_SIZE(sc3336_modes),
+				      width, height,
+				      fmt->format.width, fmt->format.height);
+
+	sc3336_fill_format(mode, &fmt->format);
+	framefmt = v4l2_subdev_state_get_format(state, fmt->pad);
+	*framefmt = fmt->format;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_ACTIVE) {
+		sc3336->mode = mode;
+		__v4l2_ctrl_s_ctrl(sc3336->ctrls.hblank, mode->hblank);
+		__v4l2_ctrl_s_ctrl(sc3336->ctrls.vblank, mode->vblank);
+	}
+
+	crop = v4l2_subdev_state_get_crop(state, fmt->pad);
+	crop->left = 0;
+	crop->top = 0;
+	crop->width = mode->width;
+	crop->height = mode->height;
+
+	return 0;
+}
+
+static void sc3336_exposure_update(struct sc3336 *sc3336)
+{
+	unsigned int exposure_max;
+
+	exposure_max = sc3336->ctrls.vblank->val + sc3336->mode->height -
+		       SC3336_EXPOSURE_OFFSET;
+	exposure_max = min(exposure_max, SC3336_EXPOSURE_MAX);
+
+	__v4l2_ctrl_modify_range(sc3336->ctrls.exposure, 1, exposure_max, 1,
+				 exposure_max);
+}
+
+static int sc3336_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct sc3336 *sc3336 = to_sc3336(sc3336_ctrl_to_sd(ctrl));
+
+	dev_dbg(sc3336->sd.dev, "sc3336: ctrl 0x%x = %d\n", ctrl->id, ctrl->val);
+	u32 hts;
+	int ret = 0;
+
+	if (ctrl->flags & V4L2_CTRL_FLAG_READ_ONLY)
+		return 0;
+
+	if (ctrl->id == V4L2_CID_VBLANK)
+		sc3336_exposure_update(sc3336);
+
+	if (!pm_runtime_get_if_in_use(sc3336->sd.dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		ret = cci_write(sc3336->regmap, SC3336_REG_EXPOSURE,
+				(u32)ctrl->val << 4, NULL);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		ret = cci_write(sc3336->regmap, SC3336_REG_GAIN_ANALOGUE,
+				sc3336_gains[ctrl->val].again, NULL);
+		ret = cci_write(sc3336->regmap, SC3336_REG_GAIN_COARSE,
+				sc3336_gains[ctrl->val].coarse_dgain, &ret);
+		ret = cci_write(sc3336->regmap, SC3336_REG_GAIN_FINE,
+				sc3336_gains[ctrl->val].fine_dgain, &ret);
+		break;
+
+	case V4L2_CID_HBLANK:
+		hts = ctrl->val + sc3336->mode->width;
+		ret = cci_write(sc3336->regmap, SC3336_REG_HTS, hts / 2, NULL);
+		break;
+	case V4L2_CID_VBLANK:
+		ret = cci_write(sc3336->regmap, SC3336_REG_VTS,
+				ctrl->val + sc3336->mode->height, NULL);
+		break;
+	case V4L2_CID_VFLIP:
+		ret = cci_update_bits(sc3336->regmap, SC3336_REG_FLIP,
+				      SC3336_FLIP_MASK,
+				      ctrl->val ? SC3336_FLIP_MASK : 0, NULL);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put_autosuspend(sc3336->sd.dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops sc3336_ctrl_ops = {
+	.s_ctrl = sc3336_set_ctrl,
+};
+
+static int sc3336_init_controls(struct sc3336 *sc3336)
+{
+	struct v4l2_ctrl_handler *hdl = &sc3336->ctrls.handler;
+	struct v4l2_fwnode_device_properties props;
+	const struct v4l2_ctrl_ops *ops = &sc3336_ctrl_ops;
+	unsigned int hblank_max = SC3336_HTS_MAX - SC3336_NATIVE_WIDTH;
+	unsigned int vblank_max = SC3336_VTS_MAX - SC3336_NATIVE_HEIGHT;
+	int ret;
+
+	ret = v4l2_ctrl_handler_init(hdl, 8);
+	if (ret)
+		return ret;
+
+	sc3336->ctrls.pixel_rate =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_PIXEL_RATE,
+				  SC3336_PIXEL_RATE, SC3336_PIXEL_RATE, 1,
+				  SC3336_PIXEL_RATE);
+
+	sc3336->ctrls.link_freq =
+		v4l2_ctrl_new_int_menu(hdl, ops, V4L2_CID_LINK_FREQ, 0, 0,
+				       sc3336_link_freqs);
+	if (sc3336->ctrls.link_freq)
+		sc3336->ctrls.link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	sc3336->ctrls.exposure =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_EXPOSURE, 1,
+				  min((unsigned int)(sc3336_modes[0].vblank +
+				      sc3336_modes[0].height -
+				      SC3336_EXPOSURE_OFFSET),
+				      SC3336_EXPOSURE_MAX),
+				  1,
+				  min((unsigned int)(sc3336_modes[0].vblank +
+				      sc3336_modes[0].height -
+				      SC3336_EXPOSURE_OFFSET),
+				      SC3336_EXPOSURE_MAX));
+
+	sc3336->ctrls.gain =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_ANALOGUE_GAIN, 0,
+				  ARRAY_SIZE(sc3336_gains) - 1, 1, 0);
+
+	sc3336->ctrls.hblank =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_HBLANK,
+				  SC3336_HTS_MIN - SC3336_NATIVE_WIDTH,
+				  hblank_max, 1,
+				  sc3336_modes[0].hblank);
+
+	sc3336->ctrls.vblank =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_VBLANK,
+				  sc3336_modes[0].vblank, vblank_max, 1,
+				  sc3336_modes[0].vblank);
+
+	sc3336->ctrls.vflip = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_VFLIP,
+					     0, 1, 1, 0);
+
+	if (hdl->error) {
+		ret = hdl->error;
+		goto error;
+	}
+
+	ret = v4l2_fwnode_device_parse(sc3336->sd.dev, &props);
+	if (ret)
+		goto error;
+
+	ret = v4l2_ctrl_new_fwnode_properties(hdl, ops, &props);
+	if (ret)
+		goto error;
+
+	sc3336->sd.ctrl_handler = hdl;
+
+	return 0;
+
+error:
+	v4l2_ctrl_handler_free(hdl);
+
+	return ret;
+}
+
+static int sc3336_check_hwcfg(struct device *dev)
+{
+	struct v4l2_fwnode_endpoint ep = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	struct fwnode_handle *endpoint;
+	unsigned int i;
+	int ret;
+
+	endpoint = fwnode_graph_get_next_endpoint(dev_fwnode(dev), NULL);
+	if (!endpoint) {
+		dev_err(dev, "endpoint node not found\n");
+		return -EINVAL;
+	}
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(endpoint, &ep);
+	fwnode_handle_put(endpoint);
+	if (ret)
+		return ret;
+
+	if (ep.bus.mipi_csi2.num_data_lanes != 2) {
+		dev_err(dev, "only 2 data lanes are currently supported\n");
+		ret = -EINVAL;
+		goto out;
+	}
+
+	if (!ep.nr_of_link_frequencies) {
+		dev_err(dev, "link-frequency property not found in DT\n");
+		ret = -EINVAL;
+		goto out;
+	}
+
+	for (i = 0; i < ep.nr_of_link_frequencies; i++) {
+		if (ep.link_frequencies[i] == SC3336_LINK_FREQ)
+			break;
+	}
+
+	if (i == ep.nr_of_link_frequencies) {
+		dev_err(dev, "expected link frequency %u\n", SC3336_LINK_FREQ);
+		ret = -EINVAL;
+	}
+
+out:
+	v4l2_fwnode_endpoint_free(&ep);
+
+	return ret;
+}
+
+static int sc3336_power_on(struct device *dev)
+{
+	dev_dbg(dev, "sc3336: power on\n");
+	struct sc3336 *sc3336 = to_sc3336(dev_get_drvdata(dev));
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(sc3336->supplies),
+				    sc3336->supplies);
+	if (ret)
+		return ret;
+
+	ret = clk_prepare_enable(sc3336->xclk);
+	if (ret)
+		goto err_regulators;
+
+	/* The sensor needs MCLK while reset is released. */
+	gpiod_set_value_cansleep(sc3336->powerdown_gpio, 0);
+	gpiod_set_value_cansleep(sc3336->reset_gpio, 0);
+	msleep(20);
+
+	return 0;
+
+err_regulators:
+	regulator_bulk_disable(ARRAY_SIZE(sc3336->supplies), sc3336->supplies);
+
+	return ret;
+}
+
+static int sc3336_power_off(struct device *dev)
+{
+	dev_dbg(dev, "sc3336: power off\n");
+	struct sc3336 *sc3336 = to_sc3336(dev_get_drvdata(dev));
+
+	gpiod_set_value_cansleep(sc3336->reset_gpio, 1);
+	gpiod_set_value_cansleep(sc3336->powerdown_gpio, 1);
+	clk_disable_unprepare(sc3336->xclk);
+	regulator_bulk_disable(ARRAY_SIZE(sc3336->supplies), sc3336->supplies);
+
+	return 0;
+}
+
+static int sc3336_identify_module(struct sc3336 *sc3336)
+{
+	u64 id_h, id_l;
+	int ret;
+
+	ret = cci_read(sc3336->regmap, SC3336_REG_CHIP_ID_H, &id_h, NULL);
+	if (ret)
+		return ret;
+
+	ret = cci_read(sc3336->regmap, SC3336_REG_CHIP_ID_L, &id_l, NULL);
+	if (ret)
+		return ret;
+
+	if (id_h != SC3336_CHIP_ID_H || id_l != SC3336_CHIP_ID_L) {
+		dev_err(sc3336->sd.dev, "chip id mismatch: %x%x != %x%x\n",
+			(u8)id_h, (u8)id_l, SC3336_CHIP_ID_H, SC3336_CHIP_ID_L);
+		return -EIO;
+	}
+
+	dev_info(sc3336->sd.dev, "sc3336: chip id %02x%02x\n", (u8)id_h, (u8)id_l);
+	return 0;
+}
+
+static int sc3336_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state, u32 pad,
+				 u64 streams_mask)
+{
+	struct sc3336 *sc3336 = to_sc3336(sd);
+
+	dev_info(sd->dev, "sc3336: stream on\n");
+	int ret;
+
+	ret = pm_runtime_resume_and_get(sd->dev);
+	if (ret)
+		return ret;
+
+	cci_multi_reg_write(sc3336->regmap, sc3336->mode->regs,
+			    sc3336->mode->regs_num, &ret);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = __v4l2_ctrl_handler_setup(&sc3336->ctrls.handler);
+	if (ret)
+		goto err_rpm_put;
+
+	cci_write(sc3336->regmap, SC3336_REG_STREAM, SC3336_STREAM_ON, &ret);
+	if (ret)
+		goto err_rpm_put;
+
+	return 0;
+
+err_rpm_put:
+	pm_runtime_put_autosuspend(sd->dev);
+
+	return ret;
+}
+
+static int sc3336_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	dev_info(sd->dev, "sc3336: stream off\n");
+	struct sc3336 *sc3336 = to_sc3336(sd);
+	int ret = 0;
+
+	cci_write(sc3336->regmap, SC3336_REG_STREAM, 0x00, &ret);
+	if (ret)
+		dev_err(sd->dev, "failed to stop streaming: %d\n", ret);
+
+	pm_runtime_put_autosuspend(sd->dev);
+
+	return ret;
+}
+
+static const struct v4l2_subdev_video_ops sc3336_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops sc3336_pad_ops = {
+	.enum_mbus_code = sc3336_enum_mbus_code,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = sc3336_set_pad_format,
+	.get_selection = sc3336_get_selection,
+	.enum_frame_size = sc3336_enum_frame_size,
+	.enable_streams = sc3336_enable_streams,
+	.disable_streams = sc3336_disable_streams,
+};
+
+static const struct v4l2_subdev_ops sc3336_subdev_ops = {
+	.video = &sc3336_video_ops,
+	.pad = &sc3336_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops sc3336_subdev_internal_ops = {
+	.init_state = sc3336_init_state,
+};
+
+static const char * const sc3336_supply_names[] = {
+	"iovdd",
+	"avdd",
+	"dvdd",
+};
+
+static int sc3336_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+
+	dev_info(dev, "sc3336: probe at i2c 0x%02x\n", client->addr);
+	struct sc3336 *sc3336;
+	unsigned int i;
+	unsigned long xclk_freq;
+	int ret;
+
+	sc3336 = devm_kzalloc(dev, sizeof(*sc3336), GFP_KERNEL);
+	if (!sc3336)
+		return -ENOMEM;
+
+	v4l2_i2c_subdev_init(&sc3336->sd, client, &sc3336_subdev_ops);
+	sc3336->sd.internal_ops = &sc3336_subdev_internal_ops;
+
+	ret = sc3336_check_hwcfg(dev);
+	if (ret)
+		return ret;
+
+	sc3336->xclk = devm_v4l2_sensor_clk_get(dev, NULL);
+	if (IS_ERR(sc3336->xclk))
+		return dev_err_probe(dev, PTR_ERR(sc3336->xclk),
+				     "failed to get xclk\n");
+
+	xclk_freq = clk_get_rate(sc3336->xclk);
+	if (xclk_freq != SC3336_XCLK_FREQ)
+		return dev_err_probe(dev, -EINVAL,
+				     "xclk frequency %lu Hz not supported\n",
+				     xclk_freq);
+
+	for (i = 0; i < ARRAY_SIZE(sc3336->supplies); i++)
+		sc3336->supplies[i].supply = sc3336_supply_names[i];
+
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(sc3336->supplies),
+				      sc3336->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get regulators\n");
+
+	sc3336->reset_gpio = devm_gpiod_get_optional(dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(sc3336->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(sc3336->reset_gpio),
+				     "failed to get reset gpio\n");
+
+	sc3336->powerdown_gpio = devm_gpiod_get_optional(dev, "powerdown",
+							 GPIOD_OUT_HIGH);
+	if (IS_ERR(sc3336->powerdown_gpio))
+		return dev_err_probe(dev, PTR_ERR(sc3336->powerdown_gpio),
+				     "failed to get powerdown gpio\n");
+
+	sc3336->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(sc3336->regmap))
+		return dev_err_probe(dev, PTR_ERR(sc3336->regmap),
+				     "failed to get cci regmap\n");
+
+	ret = sc3336_power_on(dev);
+	if (ret)
+		return ret;
+
+	ret = sc3336_identify_module(sc3336);
+	if (ret)
+		goto err_power_off;
+
+	sc3336->mode = &sc3336_modes[0];
+
+	ret = sc3336_init_controls(sc3336);
+	if (ret)
+		goto err_power_off;
+
+	sc3336->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	sc3336->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	sc3336->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&sc3336->sd.entity, 1, &sc3336->pad);
+	if (ret)
+		goto err_handler_free;
+
+	sc3336->sd.state_lock = sc3336->ctrls.handler.lock;
+	ret = v4l2_subdev_init_finalize(&sc3336->sd);
+	if (ret)
+		goto err_media_entity;
+
+	pm_runtime_set_active(dev);
+	pm_runtime_get_noresume(dev);
+	pm_runtime_enable(dev);
+	pm_runtime_set_autosuspend_delay(dev, 1000);
+	pm_runtime_use_autosuspend(dev);
+	pm_runtime_put_autosuspend(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&sc3336->sd);
+	if (ret)
+		goto err_subdev_cleanup;
+
+	return 0;
+
+err_subdev_cleanup:
+	v4l2_subdev_cleanup(&sc3336->sd);
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+err_media_entity:
+	media_entity_cleanup(&sc3336->sd.entity);
+err_handler_free:
+	v4l2_ctrl_handler_free(&sc3336->ctrls.handler);
+err_power_off:
+	sc3336_power_off(dev);
+
+	return ret;
+}
+
+static void sc3336_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct sc3336 *sc3336 = to_sc3336(sd);
+
+	v4l2_subdev_cleanup(sd);
+	v4l2_async_unregister_subdev(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&sc3336->ctrls.handler);
+
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev))
+		sc3336_power_off(&client->dev);
+	pm_runtime_set_suspended(&client->dev);
+}
+
+static const struct of_device_id sc3336_dt_ids[] = {
+	{ .compatible = "smartens,sc3336" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, sc3336_dt_ids);
+
+static const struct i2c_device_id sc3336_id[] = {
+	{ .name = "sc3336" },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, sc3336_id);
+
+static const struct dev_pm_ops sc3336_pm_ops = {
+	RUNTIME_PM_OPS(sc3336_power_off, sc3336_power_on, NULL)
+};
+
+static struct i2c_driver sc3336_i2c_driver = {
+	.driver = {
+		.name = "sc3336",
+		.of_match_table = sc3336_dt_ids,
+		.pm = pm_ptr(&sc3336_pm_ops),
+	},
+	.probe = sc3336_probe,
+	.remove = sc3336_remove,
+	.id_table = sc3336_id,
+};
+
+module_i2c_driver(sc3336_i2c_driver);
+
+MODULE_DESCRIPTION("SmartSens SC3336 sensor driver");
+MODULE_LICENSE("GPL");
