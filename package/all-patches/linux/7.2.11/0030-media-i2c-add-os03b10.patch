+
+
+static const struct os03b10_mode os03b10_modes[] = {
+	{
+		.width = OS03B10_NATIVE_WIDTH,
+		.height = OS03B10_NATIVE_HEIGHT,
+		.hblank = OS03B10_HTS_MIN - OS03B10_NATIVE_WIDTH,
+		.vblank = 1590 - OS03B10_NATIVE_HEIGHT,
+		.regs = os03b10_1296p25_regs,
+		.regs_num = ARRAY_SIZE(os03b10_1296p25_regs),
+	},
+};
+
+struct os03b10_ctrls {
+	struct v4l2_ctrl_handler handler;
+	struct v4l2_ctrl *pixel_rate;
+	struct v4l2_ctrl *link_freq;
+	struct v4l2_ctrl *hblank;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *gain;
+	struct v4l2_ctrl *hflip;
+	struct v4l2_ctrl *vflip;
+};
+
+struct os03b10 {
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+
+	struct regmap *regmap;
+	struct clk *xclk;
+
+	struct gpio_desc *reset_gpio;
+	struct gpio_desc *powerdown_gpio;
+	struct regulator_bulk_data supplies[3];
+
+	struct os03b10_ctrls ctrls;
+
+	const struct os03b10_mode *mode;
+};
+
+static inline struct os03b10 *to_os03b10(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct os03b10, sd);
+}
+
+static inline struct v4l2_subdev *os03b10_ctrl_to_sd(struct v4l2_ctrl *ctrl)
+{
+	return &container_of(ctrl->handler, struct os03b10, ctrls.handler)->sd;
+}
+
+static void os03b10_fill_format(const struct os03b10_mode *mode,
+			       struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->code = MEDIA_BUS_FMT_SRGGB10_1X10;
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	fmt->quantization = V4L2_QUANTIZATION_DEFAULT;
+	fmt->xfer_func = V4L2_XFER_FUNC_DEFAULT;
+}
+
+static int os03b10_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct v4l2_mbus_framefmt *fmt;
+	struct v4l2_rect *crop;
+
+	fmt = v4l2_subdev_state_get_format(state, 0);
+	os03b10_fill_format(&os03b10_modes[0], fmt);
+
+	crop = v4l2_subdev_state_get_crop(state, 0);
+	crop->left = 0;
+	crop->top = 0;
+	crop->width = os03b10_modes[0].width;
+	crop->height = os03b10_modes[0].height;
+
+	return 0;
+}
+
+static int os03b10_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index != 0)
+		return -EINVAL;
+
+	code->code = MEDIA_BUS_FMT_SRGGB10_1X10;
+
+	return 0;
+}
+
+static int os03b10_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index >= ARRAY_SIZE(os03b10_modes))
+		return -EINVAL;
+
+	if (fse->code != MEDIA_BUS_FMT_SRGGB10_1X10)
+		return -EINVAL;
+
+	fse->min_width = os03b10_modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = os03b10_modes[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+static int os03b10_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		sel->r = *v4l2_subdev_state_get_crop(state, 0);
+		return 0;
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = OS03B10_NATIVE_WIDTH;
+		sel->r.height = OS03B10_NATIVE_HEIGHT;
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static int os03b10_set_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct os03b10 *os03b10 = to_os03b10(sd);
+	const struct os03b10_mode *mode;
+	struct v4l2_mbus_framefmt *framefmt;
+	struct v4l2_rect *crop;
+
+	mode = v4l2_find_nearest_size(os03b10_modes, ARRAY_SIZE(os03b10_modes),
+				      width, height,
+				      fmt->format.width, fmt->format.height);
+
+	os03b10_fill_format(mode, &fmt->format);
+	framefmt = v4l2_subdev_state_get_format(state, fmt->pad);
+	*framefmt = fmt->format;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_ACTIVE) {
+		os03b10->mode = mode;
+		__v4l2_ctrl_s_ctrl(os03b10->ctrls.hblank, mode->hblank);
+		__v4l2_ctrl_s_ctrl(os03b10->ctrls.vblank, mode->vblank);
+	}
+
+	crop = v4l2_subdev_state_get_crop(state, fmt->pad);
+	crop->left = 0;
+	crop->top = 0;
+	crop->width = mode->width;
+	crop->height = mode->height;
+
+	return 0;
+}
+
+static void os03b10_exposure_update(struct os03b10 *os03b10)
+{
+	unsigned int exposure_max;
+
+	exposure_max = os03b10->ctrls.vblank->val + os03b10->mode->height -
+		       OS03B10_EXPOSURE_OFFSET;
+	exposure_max = min(exposure_max, 0x3fffU);
+
+	__v4l2_ctrl_modify_range(os03b10->ctrls.exposure, 1, exposure_max, 1,
+				 exposure_max);
+}
+
+static int os03b10_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct os03b10 *os03b10 = to_os03b10(os03b10_ctrl_to_sd(ctrl));
+
+	dev_dbg(os03b10->sd.dev, "os03b10: ctrl 0x%x = %d\n", ctrl->id, ctrl->val);
+	u32 hts;
+	u8 code, val;
+	unsigned int hflip_val, vflip_val, flip;
+	int ret = 0;
+
+	if (ctrl->flags & V4L2_CTRL_FLAG_READ_ONLY)
+		return 0;
+
+	if (ctrl->id == V4L2_CID_VBLANK)
+		os03b10_exposure_update(os03b10);
+
+	if (!pm_runtime_get_if_in_use(os03b10->sd.dev))
+		return 0;
+
+	hflip_val = os03b10->ctrls.hflip->val;
+	vflip_val = os03b10->ctrls.vflip->val;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		ret = cci_write(os03b10->regmap, OS03B10_REG_PAGE, 0x01, NULL);
+		ret = cci_write(os03b10->regmap, OS03B10_REG_EXPOSURE_H,
+				(ctrl->val >> 8) & 0xff, &ret);
+		ret = cci_write(os03b10->regmap, OS03B10_REG_EXPOSURE_L,
+				ctrl->val & 0xff, &ret);
+		ret = cci_write(os03b10->regmap, OS03B10_REG_COMMIT, 0x01, &ret);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		code = os03b10_gains[ctrl->val].code;
+		ret = cci_write(os03b10->regmap, OS03B10_REG_PAGE, 0x01, NULL);
+		ret = cci_write(os03b10->regmap, OS03B10_REG_GAIN, code, &ret);
+		ret = cci_write(os03b10->regmap, OS03B10_REG_COMMIT, 0x01, &ret);
+		break;
+	case V4L2_CID_HBLANK:
+		hts = ctrl->val + os03b10->mode->width;
+		ret = cci_write(os03b10->regmap, OS03B10_REG_PAGE, 0x01, NULL);
+		ret = cci_write(os03b10->regmap, OS03B10_REG_HTS_H, (hts >> 8) & 0xff, &ret);
+		ret = cci_write(os03b10->regmap, OS03B10_REG_HTS_L, hts & 0xff, &ret);
+		ret = cci_write(os03b10->regmap, OS03B10_REG_COMMIT, 0x01, &ret);
+		break;
+	case V4L2_CID_VBLANK:
+		ret = cci_write(os03b10->regmap, OS03B10_REG_PAGE, 0x01, NULL);
+		ret = cci_write(os03b10->regmap, OS03B10_REG_VTS_H,
+				((ctrl->val + os03b10->mode->height) >> 8) & 0xff, &ret);
+		ret = cci_write(os03b10->regmap, OS03B10_REG_VTS_L,
+				(ctrl->val + os03b10->mode->height) & 0xff, &ret);
+		ret = cci_write(os03b10->regmap, OS03B10_REG_COMMIT, 0x01, &ret);
+		break;
+	case V4L2_CID_HFLIP:
+	case V4L2_CID_VFLIP:
+		flip = (hflip_val ? 1 : 0) | (vflip_val ? 2 : 0);
+		val = flip == 0 ? 0x01 : flip == 1 ? 0x00 : flip == 2 ? 0x03 : 0x02;
+		ret = cci_write(os03b10->regmap, OS03B10_REG_PAGE, 0x01, NULL);
+		ret = cci_write(os03b10->regmap, OS03B10_REG_FLIP, val, &ret);
+		ret = cci_write(os03b10->regmap, OS03B10_REG_COMMIT, 0x01, &ret);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put_autosuspend(os03b10->sd.dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops os03b10_ctrl_ops = {
+	.s_ctrl = os03b10_set_ctrl,
+};
+
+static int os03b10_init_controls(struct os03b10 *os03b10)
+{
+	struct v4l2_ctrl_handler *hdl = &os03b10->ctrls.handler;
+	struct v4l2_fwnode_device_properties props;
+	const struct v4l2_ctrl_ops *ops = &os03b10_ctrl_ops;
+	unsigned int hblank_max = OS03B10_HTS_MAX - OS03B10_NATIVE_WIDTH;
+	unsigned int vblank_max = OS03B10_VTS_MAX - OS03B10_NATIVE_HEIGHT;
+	int ret;
+
+	ret = v4l2_ctrl_handler_init(hdl, 10);
+	if (ret)
+		return ret;
+
+	os03b10->ctrls.pixel_rate =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_PIXEL_RATE,
+				  OS03B10_PIXEL_RATE, OS03B10_PIXEL_RATE, 1,
+				  OS03B10_PIXEL_RATE);
+
+	os03b10->ctrls.link_freq =
+		v4l2_ctrl_new_int_menu(hdl, ops, V4L2_CID_LINK_FREQ, 0, 0,
+				       os03b10_link_freqs);
+	if (os03b10->ctrls.link_freq)
+		os03b10->ctrls.link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	os03b10->ctrls.exposure =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_EXPOSURE, 1,
+				  os03b10_modes[0].vblank +
+				  os03b10_modes[0].height -
+				  OS03B10_EXPOSURE_OFFSET, 1,
+				  os03b10_modes[0].vblank +
+				  os03b10_modes[0].height -
+				  OS03B10_EXPOSURE_OFFSET);
+
+	os03b10->ctrls.gain =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_ANALOGUE_GAIN, 0,
+				  ARRAY_SIZE(os03b10_gains) - 1, 1, 0);
+
+	os03b10->ctrls.hblank =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_HBLANK,
+				  OS03B10_HTS_MIN - OS03B10_NATIVE_WIDTH,
+				  hblank_max, 1,
+				  os03b10_modes[0].hblank);
+
+	os03b10->ctrls.vblank =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_VBLANK,
+				  os03b10_modes[0].vblank, vblank_max, 1,
+				  os03b10_modes[0].vblank);
+
+	os03b10->ctrls.hflip = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_HFLIP,
+						0, 1, 1, 0);
+	os03b10->ctrls.vflip = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_VFLIP,
+						0, 1, 1, 0);
+	v4l2_ctrl_cluster(2, &os03b10->ctrls.hflip);
+
+	if (hdl->error) {
+		ret = hdl->error;
+		goto error;
+	}
+
+	ret = v4l2_fwnode_device_parse(os03b10->sd.dev, &props);
+	if (ret)
+		goto error;
+
+	ret = v4l2_ctrl_new_fwnode_properties(hdl, ops, &props);
+	if (ret)
+		goto error;
+
+	os03b10->sd.ctrl_handler = hdl;
+
+	return 0;
+
+error:
+	v4l2_ctrl_handler_free(hdl);
+
+	return ret;
+}
+
+static int os03b10_check_hwcfg(struct device *dev)
+{
+	struct v4l2_fwnode_endpoint ep = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	struct fwnode_handle *endpoint;
+	unsigned int i;
+	int ret;
+
+	endpoint = fwnode_graph_get_next_endpoint(dev_fwnode(dev), NULL);
+	if (!endpoint) {
+		dev_err(dev, "endpoint node not found\n");
+		return -EINVAL;
+	}
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(endpoint, &ep);
+	fwnode_handle_put(endpoint);
+	if (ret)
+		return ret;
+
+	if (ep.bus.mipi_csi2.num_data_lanes != 2) {
+		dev_err(dev, "only 2 data lanes are currently supported\n");
+		ret = -EINVAL;
+		goto out;
+	}
+
+	if (!ep.nr_of_link_frequencies) {
+		dev_err(dev, "link-frequency property not found in DT\n");
+		ret = -EINVAL;
+		goto out;
+	}
+
+	for (i = 0; i < ep.nr_of_link_frequencies; i++) {
+		if (ep.link_frequencies[i] == OS03B10_LINK_FREQ)
+			break;
+	}
+
+	if (i == ep.nr_of_link_frequencies) {
+		dev_err(dev, "expected link frequency %u\n", OS03B10_LINK_FREQ);
+		ret = -EINVAL;
+	}
+
+out:
+	v4l2_fwnode_endpoint_free(&ep);
+
+	return ret;
+}
+
+static int os03b10_power_on(struct device *dev)
+{
+	dev_dbg(dev, "os03b10: power on\n");
+	struct os03b10 *os03b10 = to_os03b10(dev_get_drvdata(dev));
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(os03b10->supplies),
+				    os03b10->supplies);
+	if (ret)
+		return ret;
+
+	ret = clk_prepare_enable(os03b10->xclk);
+	if (ret)
+		goto err_regulators;
+
+	/* The sensor needs MCLK while reset is released. */
+	gpiod_set_value_cansleep(os03b10->powerdown_gpio, 0);
+	gpiod_set_value_cansleep(os03b10->reset_gpio, 0);
+	msleep(20);
+
+	return 0;
+
+err_regulators:
+	regulator_bulk_disable(ARRAY_SIZE(os03b10->supplies), os03b10->supplies);
+
+	return ret;
+}
+
+static int os03b10_power_off(struct device *dev)
+{
+	dev_dbg(dev, "os03b10: power off\n");
+	struct os03b10 *os03b10 = to_os03b10(dev_get_drvdata(dev));
+
+	gpiod_set_value_cansleep(os03b10->reset_gpio, 1);
+	gpiod_set_value_cansleep(os03b10->powerdown_gpio, 1);
+	clk_disable_unprepare(os03b10->xclk);
+	regulator_bulk_disable(ARRAY_SIZE(os03b10->supplies), os03b10->supplies);
+
+	return 0;
+}
+
+static int os03b10_identify_module(struct os03b10 *os03b10)
+{
+	u64 id_h, id_l;
+	int ret;
+
+	ret = cci_read(os03b10->regmap, OS03B10_REG_CHIP_ID_H, &id_h, NULL);
+	if (ret)
+		return ret;
+
+	ret = cci_read(os03b10->regmap, OS03B10_REG_CHIP_ID_L, &id_l, NULL);
+	if (ret)
+		return ret;
+
+	if (id_h != OS03B10_CHIP_ID_H || id_l != OS03B10_CHIP_ID_L) {
+		dev_err(os03b10->sd.dev, "chip id mismatch: %x%x != %x%x\n",
+			(u8)id_h, (u8)id_l, OS03B10_CHIP_ID_H, OS03B10_CHIP_ID_L);
+		return -EIO;
+	}
+
+	dev_info(os03b10->sd.dev, "os03b10: chip id %02x%02x\n", (u8)id_h, (u8)id_l);
+	return 0;
+}
+
+static int os03b10_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state, u32 pad,
+				 u64 streams_mask)
+{
+	struct os03b10 *os03b10 = to_os03b10(sd);
+
+	dev_info(sd->dev, "os03b10: stream on\n");
+	int ret;
+
+	ret = pm_runtime_resume_and_get(sd->dev);
+	if (ret)
+		return ret;
+
+	cci_multi_reg_write(os03b10->regmap, os03b10_1296p25_regs,
+			    ARRAY_SIZE(os03b10_1296p25_regs), &ret);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = __v4l2_ctrl_handler_setup(&os03b10->ctrls.handler);
+	if (ret)
+		goto err_rpm_put;
+
+	return 0;
+
+err_rpm_put:
+	pm_runtime_put_autosuspend(sd->dev);
+
+	return ret;
+}
+
+static int os03b10_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	dev_info(sd->dev, "os03b10: stream off\n");
+	pm_runtime_put_autosuspend(sd->dev);
+
+	return 0;
+}
+
+static const struct v4l2_subdev_video_ops os03b10_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops os03b10_pad_ops = {
+	.enum_mbus_code = os03b10_enum_mbus_code,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = os03b10_set_pad_format,
+	.get_selection = os03b10_get_selection,
+	.enum_frame_size = os03b10_enum_frame_size,
+	.enable_streams = os03b10_enable_streams,
+	.disable_streams = os03b10_disable_streams,
+};
+
+static const struct v4l2_subdev_ops os03b10_subdev_ops = {
+	.video = &os03b10_video_ops,
+	.pad = &os03b10_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops os03b10_subdev_internal_ops = {
+	.init_state = os03b10_init_state,
+};
+
+static const char * const os03b10_supply_names[] = {
+	"iovdd",
+	"avdd",
+	"dvdd",
+};
+
+static int os03b10_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+
+	dev_info(dev, "os03b10: probe at i2c 0x%02x\n", client->addr);
+	struct os03b10 *os03b10;
+	unsigned int i;
+	unsigned long xclk_freq;
+	int ret;
+
+	os03b10 = devm_kzalloc(dev, sizeof(*os03b10), GFP_KERNEL);
+	if (!os03b10)
+		return -ENOMEM;
+
+	v4l2_i2c_subdev_init(&os03b10->sd, client, &os03b10_subdev_ops);
+	os03b10->sd.internal_ops = &os03b10_subdev_internal_ops;
+
+	ret = os03b10_check_hwcfg(dev);
+	if (ret)
+		return ret;
+
+	os03b10->xclk = devm_v4l2_sensor_clk_get(dev, NULL);
+	if (IS_ERR(os03b10->xclk))
+		return dev_err_probe(dev, PTR_ERR(os03b10->xclk),
+				     "failed to get xclk\n");
+
+	xclk_freq = clk_get_rate(os03b10->xclk);
+	if (xclk_freq != OS03B10_XCLK_FREQ)
+		return dev_err_probe(dev, -EINVAL,
+				     "xclk frequency %lu Hz not supported\n",
+				     xclk_freq);
+
+	for (i = 0; i < ARRAY_SIZE(os03b10->supplies); i++)
+		os03b10->supplies[i].supply = os03b10_supply_names[i];
+
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(os03b10->supplies),
+				      os03b10->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get regulators\n");
+
+	os03b10->reset_gpio = devm_gpiod_get_optional(dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(os03b10->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(os03b10->reset_gpio),
+				     "failed to get reset gpio\n");
+
+	os03b10->powerdown_gpio = devm_gpiod_get_optional(dev, "powerdown",
+							 GPIOD_OUT_HIGH);
+	if (IS_ERR(os03b10->powerdown_gpio))
+		return dev_err_probe(dev, PTR_ERR(os03b10->powerdown_gpio),
+				     "failed to get powerdown gpio\n");
+
+	os03b10->regmap = devm_cci_regmap_init_i2c(client, 8);
+	if (IS_ERR(os03b10->regmap))
+		return dev_err_probe(dev, PTR_ERR(os03b10->regmap),
+				     "failed to get cci regmap\n");
+
+	ret = os03b10_power_on(dev);
+	if (ret)
+		return ret;
+
+	ret = os03b10_identify_module(os03b10);
+	if (ret)
+		goto err_power_off;
+
+	os03b10->mode = &os03b10_modes[0];
+
+	ret = os03b10_init_controls(os03b10);
+	if (ret)
+		goto err_power_off;
+
+	os03b10->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	os03b10->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	os03b10->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&os03b10->sd.entity, 1, &os03b10->pad);
+	if (ret)
+		goto err_handler_free;
+
+	os03b10->sd.state_lock = os03b10->ctrls.handler.lock;
+	ret = v4l2_subdev_init_finalize(&os03b10->sd);
+	if (ret)
+		goto err_media_entity;
+
+	pm_runtime_set_active(dev);
+	pm_runtime_get_noresume(dev);
+	pm_runtime_enable(dev);
+	pm_runtime_set_autosuspend_delay(dev, 1000);
+	pm_runtime_use_autosuspend(dev);
+	pm_runtime_put_autosuspend(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&os03b10->sd);
+	if (ret)
+		goto err_subdev_cleanup;
+
+	return 0;
+
+err_subdev_cleanup:
+	v4l2_subdev_cleanup(&os03b10->sd);
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+err_media_entity:
+	media_entity_cleanup(&os03b10->sd.entity);
+err_handler_free:
+	v4l2_ctrl_handler_free(&os03b10->ctrls.handler);
+err_power_off:
+	os03b10_power_off(dev);
+
+	return ret;
+}
+
+static void os03b10_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct os03b10 *os03b10 = to_os03b10(sd);
+
+	v4l2_subdev_cleanup(sd);
+	v4l2_async_unregister_subdev(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&os03b10->ctrls.handler);
+
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev))
+		os03b10_power_off(&client->dev);
+	pm_runtime_set_suspended(&client->dev);
+}
+
+static const struct of_device_id os03b10_dt_ids[] = {
+	{ .compatible = "ovti,os03b10" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, os03b10_dt_ids);
+
+static const struct i2c_device_id os03b10_id[] = {
+	{ .name = "os03b10" },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, os03b10_id);
+
+static const struct dev_pm_ops os03b10_pm_ops = {
+	RUNTIME_PM_OPS(os03b10_power_off, os03b10_power_on, NULL)
+};
+
+static struct i2c_driver os03b10_i2c_driver = {
+	.driver = {
+		.name = "os03b10",
+		.of_match_table = os03b10_dt_ids,
+		.pm = pm_ptr(&os03b10_pm_ops),
+	},
+	.id_table = os03b10_id,
+	.probe = os03b10_probe,
+	.remove = os03b10_remove,
+};
+
+module_i2c_driver(os03b10_i2c_driver);
+
+MODULE_DESCRIPTION("OmniVision OS03B10 sensor driver");
+MODULE_LICENSE("GPL");
