+
+static const struct sc5235_mode sc5235_modes[] = {
+	{
+		.width = SC5235_NATIVE_WIDTH,
+		.height = SC5235_NATIVE_HEIGHT,
+		.hblank = SC5235_HTS_MIN - SC5235_NATIVE_WIDTH,
+		.vblank = 2666 - SC5235_NATIVE_HEIGHT,
+		.regs = sc5235_1920p15_regs,
+		.regs_num = ARRAY_SIZE(sc5235_1920p15_regs),
+	},
+};
+
+struct sc5235_ctrls {
+	struct v4l2_ctrl_handler handler;
+	struct v4l2_ctrl *pixel_rate;
+	struct v4l2_ctrl *link_freq;
+	struct v4l2_ctrl *hblank;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *gain;
+	struct v4l2_ctrl *vflip;
+};
+
+struct sc5235 {
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+
+	struct regmap *regmap;
+	struct clk *xclk;
+
+	struct gpio_desc *reset_gpio;
+	struct gpio_desc *powerdown_gpio;
+	struct regulator_bulk_data supplies[3];
+
+	struct sc5235_ctrls ctrls;
+
+	const struct sc5235_mode *mode;
+};
+
+static inline struct sc5235 *to_sc5235(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct sc5235, sd);
+}
+
+static inline struct v4l2_subdev *sc5235_ctrl_to_sd(struct v4l2_ctrl *ctrl)
+{
+	return &container_of(ctrl->handler, struct sc5235, ctrls.handler)->sd;
+}
+
+static void sc5235_fill_format(const struct sc5235_mode *mode,
+			       struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->code = MEDIA_BUS_FMT_SBGGR10_1X10;
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	fmt->quantization = V4L2_QUANTIZATION_DEFAULT;
+	fmt->xfer_func = V4L2_XFER_FUNC_DEFAULT;
+}
+
+static int sc5235_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct v4l2_mbus_framefmt *fmt;
+	struct v4l2_rect *crop;
+
+	fmt = v4l2_subdev_state_get_format(state, 0);
+	sc5235_fill_format(&sc5235_modes[0], fmt);
+
+	crop = v4l2_subdev_state_get_crop(state, 0);
+	crop->left = 0;
+	crop->top = 0;
+	crop->width = sc5235_modes[0].width;
+	crop->height = sc5235_modes[0].height;
+
+	return 0;
+}
+
+static int sc5235_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index != 0)
+		return -EINVAL;
+
+	code->code = MEDIA_BUS_FMT_SBGGR10_1X10;
+
+	return 0;
+}
+
+static int sc5235_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index >= ARRAY_SIZE(sc5235_modes))
+		return -EINVAL;
+
+	if (fse->code != MEDIA_BUS_FMT_SBGGR10_1X10)
+		return -EINVAL;
+
+	fse->min_width = sc5235_modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = sc5235_modes[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+static int sc5235_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		sel->r = *v4l2_subdev_state_get_crop(state, 0);
+		return 0;
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = SC5235_NATIVE_WIDTH;
+		sel->r.height = SC5235_NATIVE_HEIGHT;
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static int sc5235_set_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct sc5235 *sc5235 = to_sc5235(sd);
+	const struct sc5235_mode *mode;
+	struct v4l2_mbus_framefmt *framefmt;
+	struct v4l2_rect *crop;
+
+	mode = v4l2_find_nearest_size(sc5235_modes, ARRAY_SIZE(sc5235_modes),
+				      width, height,
+				      fmt->format.width, fmt->format.height);
+
+	sc5235_fill_format(mode, &fmt->format);
+	framefmt = v4l2_subdev_state_get_format(state, fmt->pad);
+	*framefmt = fmt->format;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_ACTIVE) {
+		sc5235->mode = mode;
+		__v4l2_ctrl_s_ctrl(sc5235->ctrls.hblank, mode->hblank);
+		__v4l2_ctrl_s_ctrl(sc5235->ctrls.vblank, mode->vblank);
+	}
+
+	crop = v4l2_subdev_state_get_crop(state, fmt->pad);
+	crop->left = 0;
+	crop->top = 0;
+	crop->width = mode->width;
+	crop->height = mode->height;
+
+	return 0;
+}
+
+static void sc5235_exposure_update(struct sc5235 *sc5235)
+{
+	unsigned int exposure_max;
+
+	exposure_max = sc5235->ctrls.vblank->val + sc5235->mode->height -
+		       SC5235_EXPOSURE_OFFSET;
+	exposure_max = min(exposure_max, 0xffffU);
+
+	__v4l2_ctrl_modify_range(sc5235->ctrls.exposure,
+				 SC5235_EXPOSURE_MIN, exposure_max, 1,
+				 exposure_max);
+}
+
+static int sc5235_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct sc5235 *sc5235 = to_sc5235(sc5235_ctrl_to_sd(ctrl));
+	const struct sc5235_gain *gain;
+	u32 hts, it;
+	int ret = 0;
+
+	if (ctrl->flags & V4L2_CTRL_FLAG_READ_ONLY)
+		return 0;
+
+	if (ctrl->id == V4L2_CID_VBLANK)
+		sc5235_exposure_update(sc5235);
+
+	if (!pm_runtime_get_if_in_use(sc5235->sd.dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		it = (u32)ctrl->val * 2;
+		ret = cci_write(sc5235->regmap, SC5235_REG_EXPOSURE_H,
+				(it >> 12) & 0x0f, NULL);
+		ret = cci_write(sc5235->regmap, SC5235_REG_EXPOSURE_M,
+				(it >> 4) & 0xff, &ret);
+		ret = cci_write(sc5235->regmap, SC5235_REG_EXPOSURE_L,
+				(it & 0x0f) << 4, &ret);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		gain = &sc5235_gains[ctrl->val];
+		ret = cci_write(sc5235->regmap, SC5235_REG_GAIN_L,
+				gain->reg_3e09, NULL);
+		ret = cci_write(sc5235->regmap, SC5235_REG_GAIN_H,
+				gain->reg_3e08, &ret);
+		ret = cci_write(sc5235->regmap, SC5235_REG_GROUP_HOLD, 0x00, &ret);
+		ret = cci_write(sc5235->regmap, CCI_REG8(0x3301),
+				gain->reg_3301, &ret);
+		ret = cci_write(sc5235->regmap, CCI_REG8(0x3630),
+				gain->reg_3630, &ret);
+		ret = cci_write(sc5235->regmap, CCI_REG8(0x3633),
+				gain->reg_3633, &ret);
+		ret = cci_write(sc5235->regmap, CCI_REG8(0x3622),
+				gain->reg_3622, &ret);
+		ret = cci_write(sc5235->regmap, CCI_REG8(0x363a),
+				gain->reg_363a, &ret);
+		ret = cci_write(sc5235->regmap, SC5235_REG_GROUP_HOLD, 0x30, &ret);
+		break;
+	case V4L2_CID_HBLANK:
+		hts = ctrl->val + sc5235->mode->width;
+		ret = cci_write(sc5235->regmap, SC5235_REG_HTS, hts / 2, NULL);
+		break;
+	case V4L2_CID_VBLANK:
+		ret = cci_write(sc5235->regmap, SC5235_REG_VTS,
+				ctrl->val + sc5235->mode->height, NULL);
+		break;
+	case V4L2_CID_VFLIP:
+		ret = cci_update_bits(sc5235->regmap, SC5235_REG_FLIP,
+				      SC5235_FLIP_BITS,
+				      ctrl->val ? SC5235_FLIP_BITS : 0, NULL);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put_autosuspend(sc5235->sd.dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops sc5235_ctrl_ops = {
+	.s_ctrl = sc5235_set_ctrl,
+};
+
+static int sc5235_init_controls(struct sc5235 *sc5235)
+{
+	struct v4l2_ctrl_handler *hdl = &sc5235->ctrls.handler;
+	struct v4l2_fwnode_device_properties props;
+	const struct v4l2_ctrl_ops *ops = &sc5235_ctrl_ops;
+	unsigned int hblank_max = SC5235_HTS_MAX - SC5235_NATIVE_WIDTH;
+	unsigned int vblank_max = SC5235_VTS_MAX - SC5235_NATIVE_HEIGHT;
+	int ret;
+
+	ret = v4l2_ctrl_handler_init(hdl, 8);
+	if (ret)
+		return ret;
+
+	sc5235->ctrls.pixel_rate =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_PIXEL_RATE,
+				  SC5235_PIXEL_RATE, SC5235_PIXEL_RATE, 1,
+				  SC5235_PIXEL_RATE);
+
+	sc5235->ctrls.link_freq =
+		v4l2_ctrl_new_int_menu(hdl, ops, V4L2_CID_LINK_FREQ, 0, 0,
+				       sc5235_link_freqs);
+	if (sc5235->ctrls.link_freq)
+		sc5235->ctrls.link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	sc5235->ctrls.exposure =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_EXPOSURE,
+				  SC5235_EXPOSURE_MIN,
+				  sc5235_modes[0].vblank +
+				  sc5235_modes[0].height -
+				  SC5235_EXPOSURE_OFFSET, 1,
+				  sc5235_modes[0].vblank +
+				  sc5235_modes[0].height -
+				  SC5235_EXPOSURE_OFFSET);
+
+	sc5235->ctrls.gain =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_ANALOGUE_GAIN, 0,
+				  ARRAY_SIZE(sc5235_gains) - 1, 1, 0);
+
+	sc5235->ctrls.hblank =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_HBLANK,
+				  SC5235_HTS_MIN - SC5235_NATIVE_WIDTH,
+				  hblank_max, 1,
+				  sc5235_modes[0].hblank);
+
+	sc5235->ctrls.vblank =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_VBLANK,
+				  sc5235_modes[0].vblank, vblank_max, 1,
+				  sc5235_modes[0].vblank);
+
+	sc5235->ctrls.vflip = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_VFLIP,
+						0, 1, 1, 0);
+
+	if (hdl->error) {
+		ret = hdl->error;
+		goto error;
+	}
+
+	ret = v4l2_fwnode_device_parse(sc5235->sd.dev, &props);
+	if (ret)
+		goto error;
+
+	ret = v4l2_ctrl_new_fwnode_properties(hdl, ops, &props);
+	if (ret)
+		goto error;
+
+	sc5235->sd.ctrl_handler = hdl;
+
+	return 0;
+
+error:
+	v4l2_ctrl_handler_free(hdl);
+
+	return ret;
+}
+
+static int sc5235_check_hwcfg(struct device *dev)
+{
+	struct v4l2_fwnode_endpoint ep = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	struct fwnode_handle *endpoint;
+	unsigned int i;
+	int ret;
+
+	endpoint = fwnode_graph_get_next_endpoint(dev_fwnode(dev), NULL);
+	if (!endpoint) {
+		dev_err(dev, "endpoint node not found\n");
+		return -EINVAL;
+	}
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(endpoint, &ep);
+	fwnode_handle_put(endpoint);
+	if (ret)
+		return ret;
+
+	if (ep.bus.mipi_csi2.num_data_lanes != 2) {
+		dev_err(dev, "only 2 data lanes are currently supported\n");
+		ret = -EINVAL;
+		goto out;
+	}
+
+	if (!ep.nr_of_link_frequencies) {
+		dev_err(dev, "link-frequency property not found in DT\n");
+		ret = -EINVAL;
+		goto out;
+	}
+
+	for (i = 0; i < ep.nr_of_link_frequencies; i++) {
+		if (ep.link_frequencies[i] == SC5235_LINK_FREQ)
+			break;
+	}
+
+	if (i == ep.nr_of_link_frequencies) {
+		dev_err(dev, "expected link frequency %u\n", SC5235_LINK_FREQ);
+		ret = -EINVAL;
+	}
+
+out:
+	v4l2_fwnode_endpoint_free(&ep);
+
+	return ret;
+}
+
+static int sc5235_power_on(struct device *dev)
+{
+	struct sc5235 *sc5235 = to_sc5235(dev_get_drvdata(dev));
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(sc5235->supplies),
+				    sc5235->supplies);
+	if (ret)
+		return ret;
+
+	ret = clk_prepare_enable(sc5235->xclk);
+	if (ret)
+		goto err_regulators;
+
+	/* The sensor needs MCLK while reset is released. */
+	gpiod_set_value_cansleep(sc5235->powerdown_gpio, 0);
+	gpiod_set_value_cansleep(sc5235->reset_gpio, 0);
+	msleep(20);
+
+	return 0;
+
+err_regulators:
+	regulator_bulk_disable(ARRAY_SIZE(sc5235->supplies), sc5235->supplies);
+
+	return ret;
+}
+
+static int sc5235_power_off(struct device *dev)
+{
+	struct sc5235 *sc5235 = to_sc5235(dev_get_drvdata(dev));
+
+	gpiod_set_value_cansleep(sc5235->reset_gpio, 1);
+	gpiod_set_value_cansleep(sc5235->powerdown_gpio, 1);
+	clk_disable_unprepare(sc5235->xclk);
+	regulator_bulk_disable(ARRAY_SIZE(sc5235->supplies), sc5235->supplies);
+
+	return 0;
+}
+
+static int sc5235_identify_module(struct sc5235 *sc5235)
+{
+	u64 id_h, id_l;
+	int ret;
+
+	ret = cci_read(sc5235->regmap, SC5235_REG_CHIP_ID_H, &id_h, NULL);
+	if (ret)
+		return ret;
+
+	ret = cci_read(sc5235->regmap, SC5235_REG_CHIP_ID_L, &id_l, NULL);
+	if (ret)
+		return ret;
+
+	if (id_h != SC5235_CHIP_ID_H || id_l != SC5235_CHIP_ID_L) {
+		dev_err(sc5235->sd.dev, "chip id mismatch: %x%x != %x%x\n",
+			(u8)id_h, (u8)id_l, SC5235_CHIP_ID_H, SC5235_CHIP_ID_L);
+		return -EIO;
+	}
+
+	return 0;
+}
+
+static int sc5235_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state, u32 pad,
+				 u64 streams_mask)
+{
+	struct sc5235 *sc5235 = to_sc5235(sd);
+	int ret;
+
+	ret = pm_runtime_resume_and_get(sd->dev);
+	if (ret)
+		return ret;
+
+	cci_multi_reg_write(sc5235->regmap, sc5235->mode->regs,
+			    sc5235->mode->regs_num, &ret);
+	if (ret)
+		goto err_rpm_put;
+
+	/* The vendor init sequence ends with a 16 ms settle delay. */
+	msleep(16);
+
+	ret = __v4l2_ctrl_handler_setup(&sc5235->ctrls.handler);
+	if (ret)
+		goto err_rpm_put;
+
+	cci_write(sc5235->regmap, SC5235_REG_STREAM, SC5235_STREAM_ON, &ret);
+	if (ret)
+		goto err_rpm_put;
+
+	return 0;
+
+err_rpm_put:
+	pm_runtime_put_autosuspend(sd->dev);
+
+	return ret;
+}
+
+static int sc5235_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	struct sc5235 *sc5235 = to_sc5235(sd);
+	int ret = 0;
+
+	cci_write(sc5235->regmap, SC5235_REG_STREAM, 0x00, &ret);
+	if (ret)
+		dev_err(sd->dev, "failed to stop streaming: %d\n", ret);
+
+	pm_runtime_put_autosuspend(sd->dev);
+
+	return ret;
+}
+
+static const struct v4l2_subdev_video_ops sc5235_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops sc5235_pad_ops = {
+	.enum_mbus_code = sc5235_enum_mbus_code,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = sc5235_set_pad_format,
+	.get_selection = sc5235_get_selection,
+	.enum_frame_size = sc5235_enum_frame_size,
+	.enable_streams = sc5235_enable_streams,
+	.disable_streams = sc5235_disable_streams,
+};
+
+static const struct v4l2_subdev_ops sc5235_subdev_ops = {
+	.video = &sc5235_video_ops,
+	.pad = &sc5235_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops sc5235_subdev_internal_ops = {
+	.init_state = sc5235_init_state,
+};
+
+static const char * const sc5235_supply_names[] = {
+	"iovdd",
+	"avdd",
+	"dvdd",
+};
+
+static int sc5235_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct sc5235 *sc5235;
+	unsigned int i;
+	unsigned long xclk_freq;
+	int ret;
+
+	sc5235 = devm_kzalloc(dev, sizeof(*sc5235), GFP_KERNEL);
+	if (!sc5235)
+		return -ENOMEM;
+
+	v4l2_i2c_subdev_init(&sc5235->sd, client, &sc5235_subdev_ops);
+	sc5235->sd.internal_ops = &sc5235_subdev_internal_ops;
+
+	ret = sc5235_check_hwcfg(dev);
+	if (ret)
+		return ret;
+
+	sc5235->xclk = devm_v4l2_sensor_clk_get(dev, NULL);
+	if (IS_ERR(sc5235->xclk))
+		return dev_err_probe(dev, PTR_ERR(sc5235->xclk),
+				     "failed to get xclk\n");
+
+	xclk_freq = clk_get_rate(sc5235->xclk);
+	if (xclk_freq != SC5235_XCLK_FREQ)
+		return dev_err_probe(dev, -EINVAL,
+				     "xclk frequency %lu Hz not supported\n",
+				     xclk_freq);
+
+	for (i = 0; i < ARRAY_SIZE(sc5235->supplies); i++)
+		sc5235->supplies[i].supply = sc5235_supply_names[i];
+
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(sc5235->supplies),
+				      sc5235->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get regulators\n");
+
+	sc5235->reset_gpio = devm_gpiod_get_optional(dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(sc5235->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(sc5235->reset_gpio),
+				     "failed to get reset gpio\n");
+
+	sc5235->powerdown_gpio = devm_gpiod_get_optional(dev, "powerdown",
+							 GPIOD_OUT_HIGH);
+	if (IS_ERR(sc5235->powerdown_gpio))
+		return dev_err_probe(dev, PTR_ERR(sc5235->powerdown_gpio),
+				     "failed to get powerdown gpio\n");
+
+	sc5235->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(sc5235->regmap))
+		return dev_err_probe(dev, PTR_ERR(sc5235->regmap),
+				     "failed to get cci regmap\n");
+
+	ret = sc5235_power_on(dev);
+	if (ret)
+		return ret;
+
+	ret = sc5235_identify_module(sc5235);
+	if (ret)
+		goto err_power_off;
+
+	sc5235->mode = &sc5235_modes[0];
+
+	ret = sc5235_init_controls(sc5235);
+	if (ret)
+		goto err_power_off;
+
+	sc5235->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	sc5235->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	sc5235->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&sc5235->sd.entity, 1, &sc5235->pad);
+	if (ret)
+		goto err_handler_free;
+
+	sc5235->sd.state_lock = sc5235->ctrls.handler.lock;
+	ret = v4l2_subdev_init_finalize(&sc5235->sd);
+	if (ret)
+		goto err_media_entity;
+
+	pm_runtime_set_active(dev);
+	pm_runtime_get_noresume(dev);
+	pm_runtime_enable(dev);
+	pm_runtime_set_autosuspend_delay(dev, 1000);
+	pm_runtime_use_autosuspend(dev);
+	pm_runtime_put_autosuspend(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&sc5235->sd);
+	if (ret)
+		goto err_subdev_cleanup;
+
+	return 0;
+
+err_subdev_cleanup:
+	v4l2_subdev_cleanup(&sc5235->sd);
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+err_media_entity:
+	media_entity_cleanup(&sc5235->sd.entity);
+err_handler_free:
+	v4l2_ctrl_handler_free(&sc5235->ctrls.handler);
+err_power_off:
+	sc5235_power_off(dev);
+
+	return ret;
+}
+
+static void sc5235_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct sc5235 *sc5235 = to_sc5235(sd);
+
+	v4l2_subdev_cleanup(sd);
+	v4l2_async_unregister_subdev(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&sc5235->ctrls.handler);
+
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev))
+		sc5235_power_off(&client->dev);
+	pm_runtime_set_suspended(&client->dev);
+}
+
+static const struct of_device_id sc5235_dt_ids[] = {
+	{ .compatible = "smartens,sc5235" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, sc5235_dt_ids);
+
+static const struct i2c_device_id sc5235_id[] = {
+	{ .name = "sc5235" },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, sc5235_id);
+
+static const struct dev_pm_ops sc5235_pm_ops = {
+	RUNTIME_PM_OPS(sc5235_power_off, sc5235_power_on, NULL)
+};
+
+static struct i2c_driver sc5235_i2c_driver = {
+	.driver = {
+		.name = "sc5235",
+		.of_match_table = sc5235_dt_ids,
+		.pm = pm_ptr(&sc5235_pm_ops),
+	},
+	.probe = sc5235_probe,
+	.remove = sc5235_remove,
+	.id_table = sc5235_id,
+};
+
+module_i2c_driver(sc5235_i2c_driver);
+
+MODULE_DESCRIPTION("SmartSens SC5235 sensor driver");
+MODULE_LICENSE("GPL");
