From: Paul Philippov <paul@themactep.com>
Subject: [PATCH] media: i2c: add the SmartSens SC5235 sensor driver

Add a mainline V4L2 subdev driver for the SmartSens SC5235 image
sensor. The mode register sequence and gain table are adapted from the
Ingenic vendor sensor driver (sensor_sc5235_t31).

The driver uses the CCI register helpers, runtime PM, and the current
state-based subdev pad API. It exposes the full-resolution mode with
HBLANK/VBLANK, exposure, analogue gain, and mirror/flip controls where
the vendor driver provides them.

Signed-off-by: Paul Philippov <paul@themactep.com>
---
--- /dev/null
+++ b/drivers/media/i2c/sc5235.c
@@ -0,0 +1,1040 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * SmartSens SC5235 CMOS Image Sensor Driver
+ *
+ * The register sequences and gain table are adapted from the Ingenic
+ * vendor sensor driver (sensor_sc5235_t31).  Only the linear mode is
+ * supported; the vendor WDR path is not ported.
+ *
+ * WARNING: this driver has not been validated on hardware. Only the SC2336
+ * driver has been tested on a camera.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+#include <linux/units.h>
+
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-mediabus.h>
+
+#define SC5235_CHIP_ID_H			0x52
+#define SC5235_CHIP_ID_L			0x35
+
+#define SC5235_REG_CHIP_ID_H			CCI_REG8(0x3107)
+#define SC5235_REG_CHIP_ID_L			CCI_REG8(0x3108)
+
+#define SC5235_REG_SOFTWARE_RESET		CCI_REG8(0x0103)
+#define SC5235_REG_STREAM			CCI_REG8(0x0100)
+#define SC5235_REG_GROUP_HOLD			CCI_REG8(0x3812)
+
+/* HTS holds half the number of pixels per line. */
+#define SC5235_REG_HTS				CCI_REG16(0x320c)
+#define SC5235_REG_VTS				CCI_REG16(0x320e)
+
+/* 16-bit exposure in 1/16 line units, split over three registers. */
+#define SC5235_REG_EXPOSURE_H			CCI_REG8(0x3e00)
+#define SC5235_REG_EXPOSURE_M			CCI_REG8(0x3e01)
+#define SC5235_REG_EXPOSURE_L			CCI_REG8(0x3e02)
+
+#define SC5235_REG_GAIN_L			CCI_REG8(0x3e09)
+#define SC5235_REG_GAIN_H			CCI_REG8(0x3e08)
+
+#define SC5235_REG_FLIP				CCI_REG8(0x3221)
+#define SC5235_FLIP_BITS			(BIT(5) | BIT(6))
+
+#define SC5235_STREAM_ON			0x01
+
+/* External clock is 24 MHz. */
+#define SC5235_XCLK_FREQ			(24 * HZ_PER_MHZ)
+
+#define SC5235_NATIVE_WIDTH			2560U
+#define SC5235_NATIVE_HEIGHT			1920U
+
+/*
+ * 2 lanes.  The vendor reports 600 Mbit/s per lane; the computed value
+ * from pixel rate x 10 bits / 2 lanes / 2 is 299.925 MHz.
+ */
+#define SC5235_LINK_FREQ			299925000
+/* 3000 x 2666 pixels at 15 fps. */
+#define SC5235_PIXEL_RATE			119970000
+
+static const s64 sc5235_link_freqs[] = {
+	SC5235_LINK_FREQ,
+};
+
+#define SC5235_HTS_MIN				3000U
+#define SC5235_HTS_MAX				0xffffU
+#define SC5235_VTS_MAX				0xffffU
+
+/* Number of lines by which exposure must be less than VTS. */
+#define SC5235_EXPOSURE_OFFSET			4
+#define SC5235_EXPOSURE_MIN			3
+
+struct sc5235_gain {
+	u8 reg_3e09;
+	u8 reg_3e08;
+	u8 reg_3301;
+	u8 reg_3630;
+	u8 reg_3633;
+	u8 reg_3622;
+	u8 reg_363a;
+};
