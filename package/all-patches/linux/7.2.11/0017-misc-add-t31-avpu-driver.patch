From: Thingino <dev@thingino.com>
Subject: [PATCH] misc: add the T31 AVPU encoder driver

libimp's IMP_System_Init creates its AL board object by opening
/dev/avpu. Without it every streamer start fails with
"AL_Board_Create failed" and the sensor is stopped again, even though
the ISP and the SC2336 are working. The vendor 3.10/4.4 kernels
provide this device from the AVPU driver; the open-tx-isp tree carries
the T31 sources only for 4.4.

Port the T31 AVPU driver to 7.x: keep the libimp ioctl ABI, drop the
hardcoded platform device (the DT node supplies the base, IRQ 62 and
the el150/ahb1/vpll clocks), map the coherent buffers without the
removed dma_cache_sync() and use the current class_create() and
vm_flags_set() APIs. The AVPU core clock runs from VPLL/3 = 400 MHz;
the EL150 divider needs the T31 CE/busy/stop handshake so the rate
change actually latches and clears the stop bit left by the
bootloader.

Build it into the kernel: the rootfs has only ~12 KB spare, while the
kernel partition has ~56 KB.

--- /dev/null
+++ b/drivers/misc/avpu/avpu_alloc.c
@@ -0,0 +1,41 @@
+#include <linux/module.h>
+#include <linux/slab.h>
+#include <linux/dma-mapping.h>
+
+#include "avpu_alloc.h"
+
+MODULE_LICENSE("GPL v2");
+MODULE_AUTHOR("Kevin Grandemange");
+MODULE_AUTHOR("Sebastien Alaiwan");
+MODULE_AUTHOR("Antoine Gruzelle");
+MODULE_DESCRIPTION("JZ Common");
+
+struct avpu_dma_buffer *avpu_alloc_dma(struct device *dev, size_t size)
+{
+	struct avpu_dma_buffer *buf =
+		kmalloc(sizeof(struct avpu_dma_buffer),
+			GFP_KERNEL);
+
+	if (!buf)
+		return NULL;
+
+	buf->size = size;
+	buf->cpu_handle = dma_alloc_coherent(dev, buf->size,
+					     &buf->dma_handle,
+					     GFP_KERNEL | GFP_DMA);
+
+	if (!buf->cpu_handle) {
+		kfree(buf);
+		return NULL;
+	}
+
+	return buf;
+}
+
+void avpu_free_dma(struct device *dev, struct avpu_dma_buffer *buf)
+{
+	if (buf)
+		dma_free_coherent(dev, buf->size, buf->cpu_handle,
+				  buf->dma_handle);
+	kfree(buf);
+}
