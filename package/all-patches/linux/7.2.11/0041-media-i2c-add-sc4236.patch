+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index >= ARRAY_SIZE(sc4236_modes))
+		return -EINVAL;
+
+	if (fse->code != MEDIA_BUS_FMT_SBGGR10_1X10)
+		return -EINVAL;
+
+	fse->min_width = sc4236_modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = sc4236_modes[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+static int sc4236_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		sel->r = *v4l2_subdev_state_get_crop(state, 0);
+		return 0;
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = SC4236_NATIVE_WIDTH;
+		sel->r.height = SC4236_NATIVE_HEIGHT;
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static int sc4236_set_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct sc4236 *sc4236 = to_sc4236(sd);
+	const struct sc4236_mode *mode;
+	struct v4l2_mbus_framefmt *framefmt;
+	struct v4l2_rect *crop;
+
+	mode = v4l2_find_nearest_size(sc4236_modes, ARRAY_SIZE(sc4236_modes),
+				      width, height,
+				      fmt->format.width, fmt->format.height);
+
+	sc4236_fill_format(mode, &fmt->format);
+	framefmt = v4l2_subdev_state_get_format(state, fmt->pad);
+	*framefmt = fmt->format;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_ACTIVE) {
+		sc4236->mode = mode;
+		__v4l2_ctrl_s_ctrl(sc4236->ctrls.hblank, mode->hblank);
+		__v4l2_ctrl_s_ctrl(sc4236->ctrls.vblank, mode->vblank);
+	}
+
+	crop = v4l2_subdev_state_get_crop(state, fmt->pad);
+	crop->left = 0;
+	crop->top = 0;
+	crop->width = mode->width;
+	crop->height = mode->height;
+
+	return 0;
+}
+
+static void sc4236_exposure_update(struct sc4236 *sc4236)
+{
+	unsigned int exposure_max;
+
+	exposure_max = sc4236->ctrls.vblank->val + sc4236->mode->height -
+		       SC4236_EXPOSURE_OFFSET;
+	exposure_max = min(exposure_max, 0xfffffU >> 5);
+
+	__v4l2_ctrl_modify_range(sc4236->ctrls.exposure, 1, exposure_max, 1,
+				 exposure_max);
+}
+
+static int sc4236_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct sc4236 *sc4236 = to_sc4236(sc4236_ctrl_to_sd(ctrl));
+	u32 hts;
+	int ret = 0;
+
+	if (ctrl->flags & V4L2_CTRL_FLAG_READ_ONLY)
+		return 0;
+
+	if (ctrl->id == V4L2_CID_VBLANK)
+		sc4236_exposure_update(sc4236);
+
+	if (!pm_runtime_get_if_in_use(sc4236->sd.dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		ret = cci_write(sc4236->regmap, SC4236_REG_EXPOSURE,
+				(u32)ctrl->val << 5, NULL);
+		if (ctrl->val * 2 < 160)
+			ret = cci_write(sc4236->regmap, SC4236_REG_DENOISE_3314,
+					0x14, &ret);
+		else if (ctrl->val * 2 > 320)
+			ret = cci_write(sc4236->regmap, SC4236_REG_DENOISE_3314,
+					0x04, &ret);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+	{
+		const struct sc4236_gain *gain = &sc4236_gains[ctrl->val];
+
+		ret = cci_write(sc4236->regmap, SC4236_REG_GAIN_3E09,
+				gain->reg_3e09, NULL);
+		ret = cci_write(sc4236->regmap, SC4236_REG_GAIN_3E08,
+				gain->reg_3e08, &ret);
+		ret = cci_write(sc4236->regmap, SC4236_REG_PAGE_3812,
+				0x00, &ret);
+		ret = cci_write(sc4236->regmap, SC4236_REG_DENOISE_3301,
+				gain->reg_3301, &ret);
+		ret = cci_write(sc4236->regmap, SC4236_REG_DENOISE_3633,
+				gain->reg_3633, &ret);
+		ret = cci_write(sc4236->regmap, SC4236_REG_DENOISE_3630,
+				gain->reg_3630, &ret);
+		ret = cci_write(sc4236->regmap, SC4236_REG_DENOISE_3622,
+				gain->reg_3622, &ret);
+		ret = cci_write(sc4236->regmap, SC4236_REG_PAGE_3812,
+				0x30, &ret);
+		break;
+	}
+		break;
+	case V4L2_CID_HBLANK:
+		hts = ctrl->val + sc4236->mode->width;
+		ret = cci_write(sc4236->regmap, SC4236_REG_HTS, hts, NULL);
+		break;
+	case V4L2_CID_VBLANK:
+		ret = cci_write(sc4236->regmap, SC4236_REG_VTS,
+				ctrl->val + sc4236->mode->height, NULL);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put_autosuspend(sc4236->sd.dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops sc4236_ctrl_ops = {
+	.s_ctrl = sc4236_set_ctrl,
+};
+
+static int sc4236_init_controls(struct sc4236 *sc4236)
+{
+	struct v4l2_ctrl_handler *hdl = &sc4236->ctrls.handler;
+	struct v4l2_fwnode_device_properties props;
+	const struct v4l2_ctrl_ops *ops = &sc4236_ctrl_ops;
+	unsigned int hblank_max = SC4236_HTS_MAX - SC4236_NATIVE_WIDTH;
+	unsigned int vblank_max = SC4236_VTS_MAX - SC4236_NATIVE_HEIGHT;
+	int ret;
+
+	ret = v4l2_ctrl_handler_init(hdl, 10);
+	if (ret)
+		return ret;
+
+	sc4236->ctrls.pixel_rate =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_PIXEL_RATE,
+				  SC4236_PIXEL_RATE, SC4236_PIXEL_RATE, 1,
+				  SC4236_PIXEL_RATE);
+
+	sc4236->ctrls.link_freq =
+		v4l2_ctrl_new_int_menu(hdl, ops, V4L2_CID_LINK_FREQ, 0, 0,
+				       sc4236_link_freqs);
+	if (sc4236->ctrls.link_freq)
+		sc4236->ctrls.link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	sc4236->ctrls.exposure =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_EXPOSURE, 1,
+				  sc4236_modes[0].vblank +
+				  sc4236_modes[0].height -
+				  SC4236_EXPOSURE_OFFSET, 1,
+				  sc4236_modes[0].vblank +
+				  sc4236_modes[0].height -
+				  SC4236_EXPOSURE_OFFSET);
+
+	sc4236->ctrls.gain =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_ANALOGUE_GAIN, 0,
+				  ARRAY_SIZE(sc4236_gains) - 1, 1, 0);
+
+	sc4236->ctrls.hblank =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_HBLANK,
+				  SC4236_HTS_MIN - SC4236_NATIVE_WIDTH,
+				  hblank_max, 1,
+				  sc4236_modes[0].hblank);
+
+	sc4236->ctrls.vblank =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_VBLANK,
+				  sc4236_modes[0].vblank, vblank_max, 1,
+				  sc4236_modes[0].vblank);
+
+	if (hdl->error) {
+		ret = hdl->error;
+		goto error;
+	}
+
+	ret = v4l2_fwnode_device_parse(sc4236->sd.dev, &props);
+	if (ret)
+		goto error;
+
+	ret = v4l2_ctrl_new_fwnode_properties(hdl, ops, &props);
+	if (ret)
+		goto error;
+
+	sc4236->sd.ctrl_handler = hdl;
+
+	return 0;
+
+error:
+	v4l2_ctrl_handler_free(hdl);
+
+	return ret;
+}
+
+static int sc4236_check_hwcfg(struct device *dev)
+{
+	struct v4l2_fwnode_endpoint ep = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	struct fwnode_handle *endpoint;
+	unsigned int i;
+	int ret;
+
+	endpoint = fwnode_graph_get_next_endpoint(dev_fwnode(dev), NULL);
+	if (!endpoint) {
+		dev_err(dev, "endpoint node not found\n");
+		return -EINVAL;
+	}
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(endpoint, &ep);
+	fwnode_handle_put(endpoint);
+	if (ret)
+		return ret;
+
+	if (ep.bus.mipi_csi2.num_data_lanes != 2) {
+		dev_err(dev, "only 2 data lanes are currently supported\n");
+		ret = -EINVAL;
+		goto out;
+	}
+
+	if (!ep.nr_of_link_frequencies) {
+		dev_err(dev, "link-frequency property not found in DT\n");
+		ret = -EINVAL;
+		goto out;
+	}
+
+	for (i = 0; i < ep.nr_of_link_frequencies; i++) {
+		if (ep.link_frequencies[i] == SC4236_LINK_FREQ)
+			break;
+	}
+
+	if (i == ep.nr_of_link_frequencies) {
+		dev_err(dev, "expected link frequency %u\n", SC4236_LINK_FREQ);
+		ret = -EINVAL;
+	}
+
+out:
+	v4l2_fwnode_endpoint_free(&ep);
+
+	return ret;
+}
+
+static int sc4236_power_on(struct device *dev)
+{
+	struct sc4236 *sc4236 = to_sc4236(dev_get_drvdata(dev));
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(sc4236->supplies),
+				    sc4236->supplies);
+	if (ret)
+		return ret;
+
+	ret = clk_prepare_enable(sc4236->xclk);
+	if (ret)
+		goto err_regulators;
+
+	/* The sensor needs MCLK while reset is released. */
+	gpiod_set_value_cansleep(sc4236->powerdown_gpio, 0);
+	gpiod_set_value_cansleep(sc4236->reset_gpio, 0);
+	msleep(20);
+
+	return 0;
+
+err_regulators:
+	regulator_bulk_disable(ARRAY_SIZE(sc4236->supplies), sc4236->supplies);
+
+	return ret;
+}
+
+static int sc4236_power_off(struct device *dev)
+{
+	struct sc4236 *sc4236 = to_sc4236(dev_get_drvdata(dev));
+
+	gpiod_set_value_cansleep(sc4236->reset_gpio, 1);
+	gpiod_set_value_cansleep(sc4236->powerdown_gpio, 1);
+	clk_disable_unprepare(sc4236->xclk);
+	regulator_bulk_disable(ARRAY_SIZE(sc4236->supplies), sc4236->supplies);
+
+	return 0;
+}
+
+static int sc4236_identify_module(struct sc4236 *sc4236)
+{
+	u64 id_h, id_l;
+	int ret;
+
+	ret = cci_read(sc4236->regmap, SC4236_REG_CHIP_ID_H, &id_h, NULL);
+	if (ret)
+		return ret;
+
+	ret = cci_read(sc4236->regmap, SC4236_REG_CHIP_ID_L, &id_l, NULL);
+	if (ret)
+		return ret;
+
+	if (id_h != SC4236_CHIP_ID_H || id_l != SC4236_CHIP_ID_L) {
+		dev_err(sc4236->sd.dev, "chip id mismatch: %x%x != %x%x\n",
+			(u8)id_h, (u8)id_l, SC4236_CHIP_ID_H, SC4236_CHIP_ID_L);
+		return -EIO;
+	}
+
+	return 0;
+}
+
+static int sc4236_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state, u32 pad,
+				 u64 streams_mask)
+{
+	struct sc4236 *sc4236 = to_sc4236(sd);
+	int ret;
+
+	ret = pm_runtime_resume_and_get(sd->dev);
+	if (ret)
+		return ret;
+
+	cci_multi_reg_write(sc4236->regmap, sc4236->mode->regs,
+			    sc4236->mode->regs_num, &ret);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = __v4l2_ctrl_handler_setup(&sc4236->ctrls.handler);
+	if (ret)
+		goto err_rpm_put;
+
+	cci_write(sc4236->regmap, SC4236_REG_STREAM, SC4236_STREAM_ON, &ret);
+	if (ret)
+		goto err_rpm_put;
+
+	return 0;
+
+err_rpm_put:
+	pm_runtime_put_autosuspend(sd->dev);
+
+	return ret;
+}
+
+static int sc4236_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	struct sc4236 *sc4236 = to_sc4236(sd);
+	int ret = 0;
+
+	cci_write(sc4236->regmap, SC4236_REG_STREAM, 0x00, &ret);
+	if (ret)
+		dev_err(sd->dev, "failed to stop streaming: %d\n", ret);
+
+	pm_runtime_put_autosuspend(sd->dev);
+
+	return ret;
+}
+
+static const struct v4l2_subdev_video_ops sc4236_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops sc4236_pad_ops = {
+	.enum_mbus_code = sc4236_enum_mbus_code,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = sc4236_set_pad_format,
+	.get_selection = sc4236_get_selection,
+	.enum_frame_size = sc4236_enum_frame_size,
+	.enable_streams = sc4236_enable_streams,
+	.disable_streams = sc4236_disable_streams,
+};
+
+static const struct v4l2_subdev_ops sc4236_subdev_ops = {
+	.video = &sc4236_video_ops,
+	.pad = &sc4236_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops sc4236_subdev_internal_ops = {
+	.init_state = sc4236_init_state,
+};
+
+static const char * const sc4236_supply_names[] = {
+	"iovdd",
+	"avdd",
+	"dvdd",
+};
+
+static int sc4236_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct sc4236 *sc4236;
+	unsigned int i;
+	unsigned long xclk_freq;
+	int ret;
+
+	sc4236 = devm_kzalloc(dev, sizeof(*sc4236), GFP_KERNEL);
+	if (!sc4236)
+		return -ENOMEM;
+
+	v4l2_i2c_subdev_init(&sc4236->sd, client, &sc4236_subdev_ops);
+	sc4236->sd.internal_ops = &sc4236_subdev_internal_ops;
+
+	ret = sc4236_check_hwcfg(dev);
+	if (ret)
+		return ret;
+
+	sc4236->xclk = devm_v4l2_sensor_clk_get(dev, NULL);
+	if (IS_ERR(sc4236->xclk))
+		return dev_err_probe(dev, PTR_ERR(sc4236->xclk),
+				     "failed to get xclk\n");
+
+	xclk_freq = clk_get_rate(sc4236->xclk);
+	if (xclk_freq != SC4236_XCLK_FREQ)
+		return dev_err_probe(dev, -EINVAL,
+				     "xclk frequency %lu Hz not supported\n",
+				     xclk_freq);
+
+	for (i = 0; i < ARRAY_SIZE(sc4236->supplies); i++)
+		sc4236->supplies[i].supply = sc4236_supply_names[i];
+
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(sc4236->supplies),
+				      sc4236->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get regulators\n");
+
+	sc4236->reset_gpio = devm_gpiod_get_optional(dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(sc4236->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(sc4236->reset_gpio),
+				     "failed to get reset gpio\n");
+
+	sc4236->powerdown_gpio = devm_gpiod_get_optional(dev, "powerdown",
+							 GPIOD_OUT_HIGH);
+	if (IS_ERR(sc4236->powerdown_gpio))
+		return dev_err_probe(dev, PTR_ERR(sc4236->powerdown_gpio),
+				     "failed to get powerdown gpio\n");
+
+	sc4236->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(sc4236->regmap))
+		return dev_err_probe(dev, PTR_ERR(sc4236->regmap),
+				     "failed to get cci regmap\n");
+
+	ret = sc4236_power_on(dev);
+	if (ret)
+		return ret;
+
+	ret = sc4236_identify_module(sc4236);
+	if (ret)
+		goto err_power_off;
+
+	sc4236->mode = &sc4236_modes[0];
+
+	ret = sc4236_init_controls(sc4236);
+	if (ret)
+		goto err_power_off;
+
+	sc4236->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	sc4236->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	sc4236->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&sc4236->sd.entity, 1, &sc4236->pad);
+	if (ret)
+		goto err_handler_free;
+
+	sc4236->sd.state_lock = sc4236->ctrls.handler.lock;
+	ret = v4l2_subdev_init_finalize(&sc4236->sd);
+	if (ret)
+		goto err_media_entity;
+
+	pm_runtime_set_active(dev);
+	pm_runtime_get_noresume(dev);
+	pm_runtime_enable(dev);
+	pm_runtime_set_autosuspend_delay(dev, 1000);
+	pm_runtime_use_autosuspend(dev);
+	pm_runtime_put_autosuspend(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&sc4236->sd);
+	if (ret)
+		goto err_subdev_cleanup;
+
+	return 0;
+
+err_subdev_cleanup:
+	v4l2_subdev_cleanup(&sc4236->sd);
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+err_media_entity:
+	media_entity_cleanup(&sc4236->sd.entity);
+err_handler_free:
+	v4l2_ctrl_handler_free(&sc4236->ctrls.handler);
+err_power_off:
+	sc4236_power_off(dev);
+
+	return ret;
+}
+
+static void sc4236_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct sc4236 *sc4236 = to_sc4236(sd);
+
+	v4l2_subdev_cleanup(sd);
+	v4l2_async_unregister_subdev(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&sc4236->ctrls.handler);
+
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev))
+		sc4236_power_off(&client->dev);
+	pm_runtime_set_suspended(&client->dev);
+}
+
+static const struct of_device_id sc4236_dt_ids[] = {
+	{ .compatible = "smartens,sc4236" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, sc4236_dt_ids);
+
+static const struct i2c_device_id sc4236_id[] = {
+	{ .name = "sc4236" },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, sc4236_id);
+
+static const struct dev_pm_ops sc4236_pm_ops = {
+	RUNTIME_PM_OPS(sc4236_power_off, sc4236_power_on, NULL)
+};
+
+static struct i2c_driver sc4236_i2c_driver = {
+	.driver = {
+		.name = "sc4236",
+		.of_match_table = sc4236_dt_ids,
+		.pm = pm_ptr(&sc4236_pm_ops),
+	},
+	.probe = sc4236_probe,
+	.remove = sc4236_remove,
+	.id_table = sc4236_id,
+};
+
+module_i2c_driver(sc4236_i2c_driver);
+
+MODULE_DESCRIPTION("SmartSens SC4236 sensor driver");
+MODULE_LICENSE("GPL");
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/i2c/smartens,sc4236.yaml
@@ -0,0 +1,105 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/smartens,sc4236.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: SmartSens SC4236 2048x1536 CMOS Image Sensor
+
+maintainers:
+  - Paul Philippov <paul@themactep.com>
+
+description:
+  The SmartSens SC4236 is a 2048x1536 CMOS image sensor with a 10-bit ADC. It is programmable through an I2C interface and outputs raw Bayer data over a two-lane MIPI CSI-2 interface.
+
+allOf:
+  - $ref: /schemas/media/video-interface-devices.yaml#
+
+properties:
+  compatible:
+    const: smartens,sc4236
+
+  reg:
+    const: 0x30
+
+  clocks:
+    maxItems: 1
+
+  reset-gpios:
+    maxItems: 1
+
+  powerdown-gpios:
+    maxItems: 1
+
+  iovdd-supply:
+    description: Power supply for the I/O circuits (1.8 V).
+
+  avdd-supply:
+    description: Power supply for the analog circuits (2.8 V).
+
+  dvdd-supply:
+    description: Power supply for the digital core (1.2 V).
+
+  orientation: true
+
+  rotation: true
+
+  port:
+    $ref: /schemas/graph.yaml#/$defs/port-base
+
+    properties:
+      endpoint:
+        $ref: /schemas/media/video-interfaces.yaml#
+        unevaluatedProperties: false
+
+        properties:
+          link-frequencies: true
+
+        required:
+          - link-frequencies
+
+    required:
+      - endpoint
+
+    additionalProperties: false
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - reset-gpios
+  - iovdd-supply
+  - avdd-supply
+  - dvdd-supply
+  - port
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        camera@30 {
+            compatible = "smartens,sc4236";
+            reg = <0x30>;
+            clocks = <&clk_ext_camera>;
+            reset-gpios = <&gpa 18 GPIO_ACTIVE_LOW>;
+            iovdd-supply = <&vcc_1v8>;
+            avdd-supply = <&vcc_2v8>;
+            dvdd-supply = <&vcc_1v2>;
+
+            port {
+                endpoint {
+                    remote-endpoint = <&csi_in>;
+                    data-lanes = <1 2>;
+                    link-frequencies = /bits/ 64 <200000000>;
+                };
+            };
+        };
+    };
+
+...
