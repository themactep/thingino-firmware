+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-mediabus.h>
+
+#define SC4236_CHIP_ID_H			0x32
+#define SC4236_CHIP_ID_L			0x35
+
+#define SC4236_REG_CHIP_ID_H		CCI_REG8(0x3107)
+#define SC4236_REG_CHIP_ID_L		CCI_REG8(0x3108)
+
+#define SC4236_REG_SOFTWARE_RESET		CCI_REG8(0x0103)
+#define SC4236_REG_STREAM			CCI_REG8(0x0100)
+
+/* HTS/VTS are big-endian 16-bit values. */
+#define SC4236_REG_HTS			CCI_REG16(0x320c)
+#define SC4236_REG_VTS			CCI_REG16(0x320e)
+
+/*
+ * Exposure is a 20-bit value in units of half lines, laid out
+ * big-endian over 0x3e00..0x3e02.
+ */
+#define SC4236_REG_EXPOSURE		CCI_REG24(0x3e00)
+
+/* Analog block tuning tied to the integration time. */
+#define SC4236_REG_DENOISE_3314		CCI_REG8(0x3314)
+#define SC4236_REG_GAIN_3E09		CCI_REG8(0x3e09)
