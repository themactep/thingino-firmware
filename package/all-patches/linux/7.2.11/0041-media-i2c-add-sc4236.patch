+#define SC4236_REG_DENOISE_3622		CCI_REG8(0x3622)
+
+#define SC4236_STREAM_ON			0x01
+
+/* External clock is 24 MHz. */
+#define SC4236_XCLK_FREQ			(24 * HZ_PER_MHZ)
+
+#define SC4236_NATIVE_WIDTH		2048U
+#define SC4236_NATIVE_HEIGHT		1536U
+
+/* 2 lanes, 400 Mbit/s per lane. */
+#define SC4236_LINK_FREQ			200000000
+/* 2500 x 1920 pixels at 25 fps. */
+#define SC4236_PIXEL_RATE			120000000
+
+static const s64 sc4236_link_freqs[] = {
+	SC4236_LINK_FREQ,
+};
+
+#define SC4236_HTS_MIN			2500U
+#define SC4236_HTS_MAX			0xffffU
+#define SC4236_VTS_MAX			0xffffU
+
+/* Number of lines by which exposure must be less than VTS. */
+#define SC4236_EXPOSURE_OFFSET		4
+
+struct sc4236_gain {
+	u8 reg_3e09; u8 reg_3e08; u8 reg_3301; u8 reg_3633; u8 reg_3630; u8 reg_3622;
+};
