+static const struct sc4236_mode sc4236_modes[] = {
+	{
+		.width = SC4236_NATIVE_WIDTH,
+		.height = SC4236_NATIVE_HEIGHT,
+		.hblank = SC4236_HTS_MIN - SC4236_NATIVE_WIDTH,
+		.vblank = 1920 - SC4236_NATIVE_HEIGHT,
+		.regs = sc4236_2048h25_regs,
+		.regs_num = ARRAY_SIZE(sc4236_2048h25_regs),
+	},
+};
+
+struct sc4236_ctrls {
+	struct v4l2_ctrl_handler handler;
+	struct v4l2_ctrl *pixel_rate;
+	struct v4l2_ctrl *link_freq;
+	struct v4l2_ctrl *hblank;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *gain;
+};
+
+struct sc4236 {
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+
+	struct regmap *regmap;
+	struct clk *xclk;
+
+	struct gpio_desc *reset_gpio;
+	struct gpio_desc *powerdown_gpio;
+	struct regulator_bulk_data supplies[3];
+
+	struct sc4236_ctrls ctrls;
+
+	const struct sc4236_mode *mode;
+};
+
+static inline struct sc4236 *to_sc4236(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct sc4236, sd);
+}
+
+static inline struct v4l2_subdev *sc4236_ctrl_to_sd(struct v4l2_ctrl *ctrl)
+{
+	return &container_of(ctrl->handler, struct sc4236, ctrls.handler)->sd;
+}
+
+static void sc4236_fill_format(const struct sc4236_mode *mode,
+			       struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->code = MEDIA_BUS_FMT_SBGGR10_1X10;
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	fmt->quantization = V4L2_QUANTIZATION_DEFAULT;
+	fmt->xfer_func = V4L2_XFER_FUNC_DEFAULT;
+}
+
+static int sc4236_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct v4l2_mbus_framefmt *fmt;
+	struct v4l2_rect *crop;
+
+	fmt = v4l2_subdev_state_get_format(state, 0);
+	sc4236_fill_format(&sc4236_modes[0], fmt);
+
+	crop = v4l2_subdev_state_get_crop(state, 0);
+	crop->left = 0;
+	crop->top = 0;
+	crop->width = sc4236_modes[0].width;
+	crop->height = sc4236_modes[0].height;
+
+	return 0;
+}
+
+static int sc4236_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index != 0)
+		return -EINVAL;
+
+	code->code = MEDIA_BUS_FMT_SBGGR10_1X10;
+
+	return 0;
+}
+
