+
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-mediabus.h>
+
+#define SC2336_CHIP_ID_H			0xcb
+#define SC2336_CHIP_ID_L			0x3a
+
+#define SC2336_REG_CHIP_ID_H			CCI_REG8(0x3107)
+#define SC2336_REG_CHIP_ID_L			CCI_REG8(0x3108)
+
+#define SC2336_REG_SOFTWARE_RESET		CCI_REG8(0x0103)
+#define SC2336_REG_STREAM			CCI_REG8(0x0100)
+
+/* HTS/VTS are big-endian 16-bit values. */
+#define SC2336_REG_HTS				CCI_REG16(0x320c)
+#define SC2336_REG_VTS				CCI_REG16(0x320e)
+
+/*
+ * Exposure is a 20-bit value in units of 1/16 line, laid out
+ * big-endian over 0x3e00..0x3e02.
+ */
+#define SC2336_REG_EXPOSURE			CCI_REG24(0x3e00)
+
+#define SC2336_REG_GAIN_FINE			CCI_REG8(0x3e07)
+#define SC2336_REG_GAIN_COARSE			CCI_REG8(0x3e09)
+
+#define SC2336_REG_FLIP				CCI_REG8(0x3221)
+#define SC2336_FLIP_MIRROR			BIT(5)
+#define SC2336_FLIP_VFLIP			BIT(6)
+
+#define SC2336_STREAM_ON			0x01
+
+/* External clock is 24 MHz. */
+#define SC2336_XCLK_FREQ			(24 * HZ_PER_MHZ)
+
+#define SC2336_NATIVE_WIDTH			1920U
+#define SC2336_NATIVE_HEIGHT			1080U
+
+/* 2 lanes, 405 Mbit/s per lane. */
+#define SC2336_LINK_FREQ			202500000
+/* 2250 x 1200 pixels at 30 fps. */
+#define SC2336_PIXEL_RATE			81000000
+
+static const s64 sc2336_link_freqs[] = {
+	SC2336_LINK_FREQ,
+};
+
+#define SC2336_HTS_MIN				2250U
+#define SC2336_HTS_MAX				0xffffU
+#define SC2336_VTS_MAX				0xffffU
+
+/* Number of lines by which exposure must be less than VTS. */
+#define SC2336_EXPOSURE_OFFSET			4
+
