+
+static const struct sc2336_mode sc2336_modes[] = {
+	{
+		.width = SC2336_NATIVE_WIDTH,
+		.height = SC2336_NATIVE_HEIGHT,
+		.hblank = SC2336_HTS_MIN - SC2336_NATIVE_WIDTH,
+		.vblank = 1200 - SC2336_NATIVE_HEIGHT,
+		.regs = sc2336_1080p30_regs,
+		.regs_num = ARRAY_SIZE(sc2336_1080p30_regs),
+	},
+};
+
+struct sc2336_ctrls {
+	struct v4l2_ctrl_handler handler;
+	struct v4l2_ctrl *pixel_rate;
+	struct v4l2_ctrl *link_freq;
+	struct v4l2_ctrl *hblank;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *gain;
+	struct v4l2_ctrl *hflip;
+	struct v4l2_ctrl *vflip;
+};
+
+struct sc2336 {
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+
+	struct regmap *regmap;
+	struct clk *xclk;
+
+	struct gpio_desc *reset_gpio;
+	struct gpio_desc *powerdown_gpio;
+	struct regulator_bulk_data supplies[3];
+
+	struct sc2336_ctrls ctrls;
+
+	const struct sc2336_mode *mode;
+};
+
+static inline struct sc2336 *to_sc2336(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct sc2336, sd);
+}
+
+static inline struct v4l2_subdev *sc2336_ctrl_to_sd(struct v4l2_ctrl *ctrl)
+{
+	return &container_of(ctrl->handler, struct sc2336, ctrls.handler)->sd;
+}
+
+static void sc2336_fill_format(const struct sc2336_mode *mode,
+			       struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->code = MEDIA_BUS_FMT_SBGGR10_1X10;
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	fmt->quantization = V4L2_QUANTIZATION_DEFAULT;
+	fmt->xfer_func = V4L2_XFER_FUNC_DEFAULT;
+}
+
+static int sc2336_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct v4l2_mbus_framefmt *fmt;
+	struct v4l2_rect *crop;
+
+	fmt = v4l2_subdev_state_get_format(state, 0);
+	sc2336_fill_format(&sc2336_modes[0], fmt);
+
+	crop = v4l2_subdev_state_get_crop(state, 0);
+	crop->left = 0;
+	crop->top = 0;
+	crop->width = sc2336_modes[0].width;
+	crop->height = sc2336_modes[0].height;
+
+	return 0;
+}
+
+static int sc2336_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index != 0)
+		return -EINVAL;
+
+	code->code = MEDIA_BUS_FMT_SBGGR10_1X10;
+
+	return 0;
+}
+
+static int sc2336_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index >= ARRAY_SIZE(sc2336_modes))
+		return -EINVAL;
+
+	if (fse->code != MEDIA_BUS_FMT_SBGGR10_1X10)
+		return -EINVAL;
+
+	fse->min_width = sc2336_modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = sc2336_modes[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+static int sc2336_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		sel->r = *v4l2_subdev_state_get_crop(state, 0);
+		return 0;
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = SC2336_NATIVE_WIDTH;
+		sel->r.height = SC2336_NATIVE_HEIGHT;
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static int sc2336_set_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct sc2336 *sc2336 = to_sc2336(sd);
+	const struct sc2336_mode *mode;
+	struct v4l2_mbus_framefmt *framefmt;
+	struct v4l2_rect *crop;
+
+	mode = v4l2_find_nearest_size(sc2336_modes, ARRAY_SIZE(sc2336_modes),
+				      width, height,
+				      fmt->format.width, fmt->format.height);
+
+	sc2336_fill_format(mode, &fmt->format);
+	framefmt = v4l2_subdev_state_get_format(state, fmt->pad);
+	*framefmt = fmt->format;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_ACTIVE) {
+		sc2336->mode = mode;
+		__v4l2_ctrl_s_ctrl(sc2336->ctrls.hblank, mode->hblank);
+		__v4l2_ctrl_s_ctrl(sc2336->ctrls.vblank, mode->vblank);
+	}
+
+	crop = v4l2_subdev_state_get_crop(state, fmt->pad);
+	crop->left = 0;
+	crop->top = 0;
+	crop->width = mode->width;
+	crop->height = mode->height;
+
+	return 0;
+}
+
+static void sc2336_exposure_update(struct sc2336 *sc2336)
+{
+	unsigned int exposure_max;
+
+	exposure_max = sc2336->ctrls.vblank->val + sc2336->mode->height -
+		       SC2336_EXPOSURE_OFFSET;
+	exposure_max = min(exposure_max, 0xfffffU);
+
+	__v4l2_ctrl_modify_range(sc2336->ctrls.exposure, 1, exposure_max, 1,
+				 exposure_max);
+}
+
+static int sc2336_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct sc2336 *sc2336 = to_sc2336(sc2336_ctrl_to_sd(ctrl));
+	u32 hts;
+	int ret = 0;
+
+	if (ctrl->flags & V4L2_CTRL_FLAG_READ_ONLY)
+		return 0;
+
+	if (ctrl->id == V4L2_CID_VBLANK)
+		sc2336_exposure_update(sc2336);
+
+	if (!pm_runtime_get_if_in_use(sc2336->sd.dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		ret = cci_write(sc2336->regmap, SC2336_REG_EXPOSURE,
+				(u32)ctrl->val << 4, NULL);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		ret = cci_write(sc2336->regmap, SC2336_REG_GAIN_COARSE,
+				sc2336_gains[ctrl->val] >> 8, NULL);
+		ret = cci_write(sc2336->regmap, SC2336_REG_GAIN_FINE,
+				sc2336_gains[ctrl->val] & 0xff, &ret);
+		break;
+	case V4L2_CID_HBLANK:
+		hts = ctrl->val + sc2336->mode->width;
+		ret = cci_write(sc2336->regmap, SC2336_REG_HTS, hts, NULL);
+		break;
+	case V4L2_CID_VBLANK:
+		ret = cci_write(sc2336->regmap, SC2336_REG_VTS,
+				ctrl->val + sc2336->mode->height, NULL);
+		break;
+	case V4L2_CID_HFLIP:
+		ret = cci_update_bits(sc2336->regmap, SC2336_REG_FLIP,
+				      SC2336_FLIP_MIRROR,
+				      ctrl->val ? SC2336_FLIP_MIRROR : 0, NULL);
+		break;
+	case V4L2_CID_VFLIP:
+		ret = cci_update_bits(sc2336->regmap, SC2336_REG_FLIP,
+				      SC2336_FLIP_VFLIP,
+				      ctrl->val ? SC2336_FLIP_VFLIP : 0, NULL);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put_autosuspend(sc2336->sd.dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops sc2336_ctrl_ops = {
+	.s_ctrl = sc2336_set_ctrl,
+};
+
+static int sc2336_init_controls(struct sc2336 *sc2336)
+{
+	struct v4l2_ctrl_handler *hdl = &sc2336->ctrls.handler;
+	struct v4l2_fwnode_device_properties props;
+	const struct v4l2_ctrl_ops *ops = &sc2336_ctrl_ops;
+	unsigned int hblank_max = SC2336_HTS_MAX - SC2336_NATIVE_WIDTH;
+	unsigned int vblank_max = SC2336_VTS_MAX - SC2336_NATIVE_HEIGHT;
+	int ret;
+
+	ret = v4l2_ctrl_handler_init(hdl, 10);
+	if (ret)
+		return ret;
+
+	sc2336->ctrls.pixel_rate =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_PIXEL_RATE,
+				  SC2336_PIXEL_RATE, SC2336_PIXEL_RATE, 1,
+				  SC2336_PIXEL_RATE);
+
+	sc2336->ctrls.link_freq =
+		v4l2_ctrl_new_int_menu(hdl, ops, V4L2_CID_LINK_FREQ, 0, 0,
+				       sc2336_link_freqs);
+	if (sc2336->ctrls.link_freq)
+		sc2336->ctrls.link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	sc2336->ctrls.exposure =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_EXPOSURE, 1,
+				  sc2336_modes[0].vblank +
+				  sc2336_modes[0].height -
+				  SC2336_EXPOSURE_OFFSET, 1,
+				  sc2336_modes[0].vblank +
+				  sc2336_modes[0].height -
+				  SC2336_EXPOSURE_OFFSET);
+
+	sc2336->ctrls.gain =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_ANALOGUE_GAIN, 0,
+				  ARRAY_SIZE(sc2336_gains) - 1, 1, 0);
+
+	sc2336->ctrls.hblank =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_HBLANK,
+				  SC2336_HTS_MIN - SC2336_NATIVE_WIDTH,
+				  hblank_max, 1,
+				  sc2336_modes[0].hblank);
+
+	sc2336->ctrls.vblank =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_VBLANK,
+				  sc2336_modes[0].vblank, vblank_max, 1,
+				  sc2336_modes[0].vblank);
+
+	sc2336->ctrls.hflip = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_HFLIP,
+						0, 1, 1, 0);
+	sc2336->ctrls.vflip = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_VFLIP,
+						0, 1, 1, 0);
+	v4l2_ctrl_cluster(2, &sc2336->ctrls.hflip);
+
+	if (hdl->error) {
+		ret = hdl->error;
+		goto error;
+	}
+
+	ret = v4l2_fwnode_device_parse(sc2336->sd.dev, &props);
+	if (ret)
+		goto error;
+
+	ret = v4l2_ctrl_new_fwnode_properties(hdl, ops, &props);
+	if (ret)
+		goto error;
+
+	sc2336->sd.ctrl_handler = hdl;
+
+	return 0;
+
+error:
+	v4l2_ctrl_handler_free(hdl);
+
+	return ret;
+}
+
+static int sc2336_check_hwcfg(struct device *dev)
+{
+	struct v4l2_fwnode_endpoint ep = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	struct fwnode_handle *endpoint;
+	unsigned int i;
+	int ret;
+
+	endpoint = fwnode_graph_get_next_endpoint(dev_fwnode(dev), NULL);
+	if (!endpoint) {
+		dev_err(dev, "endpoint node not found\n");
+		return -EINVAL;
+	}
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(endpoint, &ep);
+	fwnode_handle_put(endpoint);
+	if (ret)
+		return ret;
+
+	if (ep.bus.mipi_csi2.num_data_lanes != 2) {
+		dev_err(dev, "only 2 data lanes are currently supported\n");
+		ret = -EINVAL;
+		goto out;
+	}
+
+	if (!ep.nr_of_link_frequencies) {
+		dev_err(dev, "link-frequency property not found in DT\n");
+		ret = -EINVAL;
+		goto out;
+	}
+
+	for (i = 0; i < ep.nr_of_link_frequencies; i++) {
+		if (ep.link_frequencies[i] == SC2336_LINK_FREQ)
+			break;
+	}
+
+	if (i == ep.nr_of_link_frequencies) {
+		dev_err(dev, "expected link frequency %u\n", SC2336_LINK_FREQ);
+		ret = -EINVAL;
+	}
+
+out:
+	v4l2_fwnode_endpoint_free(&ep);
+
+	return ret;
+}
+
+static int sc2336_power_on(struct device *dev)
+{
+	struct sc2336 *sc2336 = to_sc2336(dev_get_drvdata(dev));
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(sc2336->supplies),
+				    sc2336->supplies);
+	if (ret)
+		return ret;
+
+	ret = clk_prepare_enable(sc2336->xclk);
+	if (ret)
+		goto err_regulators;
+
+	/* The sensor needs MCLK while reset is released. */
+	gpiod_set_value_cansleep(sc2336->powerdown_gpio, 0);
+	gpiod_set_value_cansleep(sc2336->reset_gpio, 0);
+	msleep(20);
+
+	return 0;
+
+err_regulators:
+	regulator_bulk_disable(ARRAY_SIZE(sc2336->supplies), sc2336->supplies);
+
+	return ret;
+}
+
+static int sc2336_power_off(struct device *dev)
+{
+	struct sc2336 *sc2336 = to_sc2336(dev_get_drvdata(dev));
+
+	gpiod_set_value_cansleep(sc2336->reset_gpio, 1);
+	gpiod_set_value_cansleep(sc2336->powerdown_gpio, 1);
+	clk_disable_unprepare(sc2336->xclk);
+	regulator_bulk_disable(ARRAY_SIZE(sc2336->supplies), sc2336->supplies);
+
+	return 0;
+}
+
+static int sc2336_identify_module(struct sc2336 *sc2336)
+{
+	u64 id_h, id_l;
+	int ret;
+
+	ret = cci_read(sc2336->regmap, SC2336_REG_CHIP_ID_H, &id_h, NULL);
+	if (ret)
+		return ret;
+
+	ret = cci_read(sc2336->regmap, SC2336_REG_CHIP_ID_L, &id_l, NULL);
+	if (ret)
+		return ret;
+
+	if (id_h != SC2336_CHIP_ID_H || id_l != SC2336_CHIP_ID_L) {
+		dev_err(sc2336->sd.dev, "chip id mismatch: %x%x != %x%x\n",
+			(u8)id_h, (u8)id_l, SC2336_CHIP_ID_H, SC2336_CHIP_ID_L);
+		return -EIO;
+	}
+
+	return 0;
+}
+
+static int sc2336_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state, u32 pad,
+				 u64 streams_mask)
+{
+	struct sc2336 *sc2336 = to_sc2336(sd);
+	int ret;
+
+	ret = pm_runtime_resume_and_get(sd->dev);
+	if (ret)
+		return ret;
+
+	cci_multi_reg_write(sc2336->regmap, sc2336->mode->regs,
+			    sc2336->mode->regs_num, &ret);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = __v4l2_ctrl_handler_setup(&sc2336->ctrls.handler);
+	if (ret)
+		goto err_rpm_put;
+
+	cci_write(sc2336->regmap, SC2336_REG_STREAM, SC2336_STREAM_ON, &ret);
+	if (ret)
+		goto err_rpm_put;
+
+	return 0;
+
+err_rpm_put:
+	pm_runtime_put_autosuspend(sd->dev);
+
+	return ret;
+}
+
+static int sc2336_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	struct sc2336 *sc2336 = to_sc2336(sd);
+	int ret = 0;
+
+	cci_write(sc2336->regmap, SC2336_REG_STREAM, 0x00, &ret);
+	if (ret)
+		dev_err(sd->dev, "failed to stop streaming: %d\n", ret);
+
+	pm_runtime_put_autosuspend(sd->dev);
+
+	return ret;
+}
+
+static const struct v4l2_subdev_video_ops sc2336_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops sc2336_pad_ops = {
+	.enum_mbus_code = sc2336_enum_mbus_code,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = sc2336_set_pad_format,
+	.get_selection = sc2336_get_selection,
+	.enum_frame_size = sc2336_enum_frame_size,
+	.enable_streams = sc2336_enable_streams,
+	.disable_streams = sc2336_disable_streams,
+};
+
+static const struct v4l2_subdev_ops sc2336_subdev_ops = {
+	.video = &sc2336_video_ops,
+	.pad = &sc2336_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops sc2336_subdev_internal_ops = {
+	.init_state = sc2336_init_state,
+};
+
+static const char * const sc2336_supply_names[] = {
+	"iovdd",
+	"avdd",
+	"dvdd",
+};
+
+static int sc2336_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct sc2336 *sc2336;
+	unsigned int i;
+	unsigned long xclk_freq;
+	int ret;
+
+	sc2336 = devm_kzalloc(dev, sizeof(*sc2336), GFP_KERNEL);
+	if (!sc2336)
+		return -ENOMEM;
+
+	v4l2_i2c_subdev_init(&sc2336->sd, client, &sc2336_subdev_ops);
+	sc2336->sd.internal_ops = &sc2336_subdev_internal_ops;
+
+	ret = sc2336_check_hwcfg(dev);
+	if (ret)
+		return ret;
+
+	sc2336->xclk = devm_v4l2_sensor_clk_get(dev, NULL);
+	if (IS_ERR(sc2336->xclk))
+		return dev_err_probe(dev, PTR_ERR(sc2336->xclk),
+				     "failed to get xclk\n");
+
+	xclk_freq = clk_get_rate(sc2336->xclk);
+	if (xclk_freq != SC2336_XCLK_FREQ)
+		return dev_err_probe(dev, -EINVAL,
+				     "xclk frequency %lu Hz not supported\n",
+				     xclk_freq);
+
+	for (i = 0; i < ARRAY_SIZE(sc2336->supplies); i++)
+		sc2336->supplies[i].supply = sc2336_supply_names[i];
+
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(sc2336->supplies),
+				      sc2336->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get regulators\n");
+
+	sc2336->reset_gpio = devm_gpiod_get_optional(dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(sc2336->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(sc2336->reset_gpio),
+				     "failed to get reset gpio\n");
+
+	sc2336->powerdown_gpio = devm_gpiod_get_optional(dev, "powerdown",
+							 GPIOD_OUT_HIGH);
+	if (IS_ERR(sc2336->powerdown_gpio))
+		return dev_err_probe(dev, PTR_ERR(sc2336->powerdown_gpio),
+				     "failed to get powerdown gpio\n");
+
+	sc2336->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(sc2336->regmap))
+		return dev_err_probe(dev, PTR_ERR(sc2336->regmap),
+				     "failed to get cci regmap\n");
+
+	ret = sc2336_power_on(dev);
+	if (ret)
+		return ret;
+
+	ret = sc2336_identify_module(sc2336);
+	if (ret)
+		goto err_power_off;
+
+	sc2336->mode = &sc2336_modes[0];
+
+	ret = sc2336_init_controls(sc2336);
+	if (ret)
+		goto err_power_off;
+
+	sc2336->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	sc2336->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	sc2336->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&sc2336->sd.entity, 1, &sc2336->pad);
+	if (ret)
+		goto err_handler_free;
+
+	sc2336->sd.state_lock = sc2336->ctrls.handler.lock;
+	ret = v4l2_subdev_init_finalize(&sc2336->sd);
+	if (ret)
+		goto err_media_entity;
+
+	pm_runtime_set_active(dev);
+	pm_runtime_get_noresume(dev);
+	pm_runtime_enable(dev);
+	pm_runtime_set_autosuspend_delay(dev, 1000);
+	pm_runtime_use_autosuspend(dev);
+	pm_runtime_put_autosuspend(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&sc2336->sd);
+	if (ret)
+		goto err_subdev_cleanup;
+
+	return 0;
+
+err_subdev_cleanup:
+	v4l2_subdev_cleanup(&sc2336->sd);
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+err_media_entity:
+	media_entity_cleanup(&sc2336->sd.entity);
+err_handler_free:
+	v4l2_ctrl_handler_free(&sc2336->ctrls.handler);
+err_power_off:
+	sc2336_power_off(dev);
+
+	return ret;
+}
+
+static void sc2336_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct sc2336 *sc2336 = to_sc2336(sd);
+
+	v4l2_subdev_cleanup(sd);
+	v4l2_async_unregister_subdev(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&sc2336->ctrls.handler);
+
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev))
+		sc2336_power_off(&client->dev);
+	pm_runtime_set_suspended(&client->dev);
+}
+
+static const struct of_device_id sc2336_dt_ids[] = {
+	{ .compatible = "smartens,sc2336" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, sc2336_dt_ids);
+
+static const struct i2c_device_id sc2336_id[] = {
+	{ .name = "sc2336" },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, sc2336_id);
+
+static const struct dev_pm_ops sc2336_pm_ops = {
+	RUNTIME_PM_OPS(sc2336_power_off, sc2336_power_on, NULL)
+};
+
+static struct i2c_driver sc2336_i2c_driver = {
+	.driver = {
+		.name = "sc2336",
+		.of_match_table = sc2336_dt_ids,
+		.pm = pm_ptr(&sc2336_pm_ops),
+	},
+	.id_table = sc2336_id,
+	.probe = sc2336_probe,
+	.remove = sc2336_remove,
+};
+
+module_i2c_driver(sc2336_i2c_driver);
+
+MODULE_DESCRIPTION("SmartSens SC2336 sensor driver");
+MODULE_LICENSE("GPL");
