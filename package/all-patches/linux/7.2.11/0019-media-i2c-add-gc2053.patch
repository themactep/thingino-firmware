+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-mediabus.h>
+
+#define GC2053_CHIP_ID_H			0x20
+#define GC2053_CHIP_ID_L			0x53
+
+#define GC2053_REG_CHIP_ID_H			CCI_REG8(0xf0)
+#define GC2053_REG_CHIP_ID_L			CCI_REG8(0xf1)
+#define GC2053_REG_PAGE_SELECT			CCI_REG8(0xfe)
+
+/* Exposure is a 14-bit big-endian value split over 0x03/0x04. */
+#define GC2053_REG_EXPOSURE			CCI_REG16(0x03)
+/* HTS is stored divided by two (dual pixel clock). */
+#define GC2053_REG_HTS				CCI_REG16(0x05)
+#define GC2053_REG_VTS				CCI_REG16(0x41)
+
+#define GC2053_REG_FLIP				CCI_REG8(0x17)
+#define GC2053_FLIP_MIRROR			BIT(0)
+#define GC2053_FLIP_VFLIP			BIT(1)
+
+#define GC2053_REG_GAIN_B4			CCI_REG8(0xb4)
+#define GC2053_REG_GAIN_B3			CCI_REG8(0xb3)
+#define GC2053_REG_GAIN_DPC			CCI_REG8(0xb8)
+#define GC2053_REG_GAIN_BLC			CCI_REG8(0xb9)
+
+#define GC2053_REG_STREAM			CCI_REG8(0x3e)
+#define GC2053_STREAM_ON			0x91
+
+/* External clock is 24 MHz. */
+#define GC2053_XCLK_FREQ			(24 * HZ_PER_MHZ)
+
+#define GC2053_NATIVE_WIDTH			1920U
+#define GC2053_NATIVE_HEIGHT			1080U
+
+/* 2 lanes, 624 Mbit/s per lane. */
+#define GC2053_LINK_FREQ			312000000
+/* 2200 x 1181 pixels at 30 fps. */
+#define GC2053_PIXEL_RATE			78000000
+
+static const s64 gc2053_link_freqs[] = {
+	GC2053_LINK_FREQ,
+};
+
+#define GC2053_HTS_MIN				2200U
+#define GC2053_HTS_MAX				(2U * 0xffff)
+#define GC2053_VTS_MAX				0xffffU
+
+/* Number of lines by which exposure must be less than VTS. */
+#define GC2053_EXPOSURE_OFFSET			8
+
+struct gc2053_gain {
+	u8 reg_b4;
+	u8 reg_b3;
+	u8 dpc;
+	u8 blc;
+};
+
