+
+static const struct gc2053_mode gc2053_modes[] = {
+	{
+		.width = GC2053_NATIVE_WIDTH,
+		.height = GC2053_NATIVE_HEIGHT,
+		.hblank = GC2053_HTS_MIN - GC2053_NATIVE_WIDTH,
+		.vblank = 1181 - GC2053_NATIVE_HEIGHT,
+		.regs = gc2053_1080p30_regs,
+		.regs_num = ARRAY_SIZE(gc2053_1080p30_regs),
+	},
+};
+
+struct gc2053_ctrls {
+	struct v4l2_ctrl_handler handler;
+	struct v4l2_ctrl *pixel_rate;
+	struct v4l2_ctrl *link_freq;
+	struct v4l2_ctrl *hblank;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *gain;
+	struct v4l2_ctrl *hflip;
+	struct v4l2_ctrl *vflip;
+};
+
+struct gc2053 {
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+
+	struct regmap *regmap;
+	struct clk *xclk;
+
+	struct gpio_desc *reset_gpio;
+	struct gpio_desc *powerdown_gpio;
+	struct regulator_bulk_data supplies[3];
+
+	struct gc2053_ctrls ctrls;
+
+	const struct gc2053_mode *mode;
+};
+
+static inline struct gc2053 *to_gc2053(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct gc2053, sd);
+}
+
+static inline struct v4l2_subdev *gc2053_ctrl_to_sd(struct v4l2_ctrl *ctrl)
+{
+	return &container_of(ctrl->handler, struct gc2053, ctrls.handler)->sd;
+}
+
+static void gc2053_fill_format(const struct gc2053_mode *mode,
+			       struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->code = MEDIA_BUS_FMT_SRGGB10_1X10;
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	fmt->quantization = V4L2_QUANTIZATION_DEFAULT;
+	fmt->xfer_func = V4L2_XFER_FUNC_DEFAULT;
+}
+
+static int gc2053_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct v4l2_mbus_framefmt *fmt;
+	struct v4l2_rect *crop;
+
+	fmt = v4l2_subdev_state_get_format(state, 0);
+	gc2053_fill_format(&gc2053_modes[0], fmt);
+
+	crop = v4l2_subdev_state_get_crop(state, 0);
+	crop->left = 0;
+	crop->top = 0;
+	crop->width = gc2053_modes[0].width;
+	crop->height = gc2053_modes[0].height;
+
+	return 0;
+}
+
+static int gc2053_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index != 0)
+		return -EINVAL;
+
+	code->code = MEDIA_BUS_FMT_SRGGB10_1X10;
+
+	return 0;
+}
+
+static int gc2053_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index >= ARRAY_SIZE(gc2053_modes))
+		return -EINVAL;
+
+	if (fse->code != MEDIA_BUS_FMT_SRGGB10_1X10)
+		return -EINVAL;
+
+	fse->min_width = gc2053_modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = gc2053_modes[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+static int gc2053_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		sel->r = *v4l2_subdev_state_get_crop(state, 0);
+		return 0;
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = GC2053_NATIVE_WIDTH;
+		sel->r.height = GC2053_NATIVE_HEIGHT;
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static int gc2053_set_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct gc2053 *gc2053 = to_gc2053(sd);
+	const struct gc2053_mode *mode;
+	struct v4l2_mbus_framefmt *framefmt;
+	struct v4l2_rect *crop;
+
+	mode = v4l2_find_nearest_size(gc2053_modes, ARRAY_SIZE(gc2053_modes),
+				      width, height,
+				      fmt->format.width, fmt->format.height);
+
+	gc2053_fill_format(mode, &fmt->format);
+	framefmt = v4l2_subdev_state_get_format(state, fmt->pad);
+	*framefmt = fmt->format;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_ACTIVE) {
+		gc2053->mode = mode;
+		__v4l2_ctrl_s_ctrl(gc2053->ctrls.hblank, mode->hblank);
+		__v4l2_ctrl_s_ctrl(gc2053->ctrls.vblank, mode->vblank);
+	}
+
+	crop = v4l2_subdev_state_get_crop(state, fmt->pad);
+	crop->left = 0;
+	crop->top = 0;
+	crop->width = mode->width;
+	crop->height = mode->height;
+
+	return 0;
+}
+
+static void gc2053_exposure_update(struct gc2053 *gc2053)
+{
+	unsigned int exposure_max;
+
+	exposure_max = gc2053->ctrls.vblank->val + gc2053->mode->height -
+		       GC2053_EXPOSURE_OFFSET;
+	exposure_max = min(exposure_max, 0x3fffU);
+
+	__v4l2_ctrl_modify_range(gc2053->ctrls.exposure, 1, exposure_max, 1,
+				 exposure_max);
+}
+
+static int gc2053_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct gc2053 *gc2053 = to_gc2053(gc2053_ctrl_to_sd(ctrl));
+	const struct gc2053_gain *gain;
+	u32 hts;
+	int ret = 0;
+
+	if (ctrl->flags & V4L2_CTRL_FLAG_READ_ONLY)
+		return 0;
+
+	if (ctrl->id == V4L2_CID_VBLANK)
+		gc2053_exposure_update(gc2053);
+
+	if (!pm_runtime_get_if_in_use(gc2053->sd.dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		ret = cci_write(gc2053->regmap, GC2053_REG_EXPOSURE,
+				ctrl->val, NULL);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		gain = &gc2053_gains[ctrl->val];
+		ret = cci_write(gc2053->regmap, GC2053_REG_GAIN_B4,
+				gain->reg_b4, NULL);
+		ret = cci_write(gc2053->regmap, GC2053_REG_GAIN_B3,
+				gain->reg_b3, &ret);
+		ret = cci_write(gc2053->regmap, GC2053_REG_GAIN_DPC,
+				gain->dpc, &ret);
+		ret = cci_write(gc2053->regmap, GC2053_REG_GAIN_BLC,
+				gain->blc, &ret);
+		break;
+	case V4L2_CID_HBLANK:
+		hts = ctrl->val + gc2053->mode->width;
+		ret = cci_write(gc2053->regmap, GC2053_REG_HTS, hts / 2, NULL);
+		break;
+	case V4L2_CID_VBLANK:
+		ret = cci_write(gc2053->regmap, GC2053_REG_VTS,
+				ctrl->val + gc2053->mode->height, NULL);
+		break;
+	case V4L2_CID_HFLIP:
+		ret = cci_update_bits(gc2053->regmap, GC2053_REG_FLIP,
+				      GC2053_FLIP_MIRROR,
+				      ctrl->val ? GC2053_FLIP_MIRROR : 0, NULL);
+		break;
+	case V4L2_CID_VFLIP:
+		ret = cci_update_bits(gc2053->regmap, GC2053_REG_FLIP,
+				      GC2053_FLIP_VFLIP,
+				      ctrl->val ? GC2053_FLIP_VFLIP : 0, NULL);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put_autosuspend(gc2053->sd.dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops gc2053_ctrl_ops = {
+	.s_ctrl = gc2053_set_ctrl,
+};
+
+static int gc2053_init_controls(struct gc2053 *gc2053)
+{
+	struct v4l2_ctrl_handler *hdl = &gc2053->ctrls.handler;
+	struct v4l2_fwnode_device_properties props;
+	const struct v4l2_ctrl_ops *ops = &gc2053_ctrl_ops;
+	unsigned int hblank_max = GC2053_HTS_MAX - GC2053_NATIVE_WIDTH;
+	unsigned int vblank_max = GC2053_VTS_MAX - GC2053_NATIVE_HEIGHT;
+	int ret;
+
+	ret = v4l2_ctrl_handler_init(hdl, 10);
+	if (ret)
+		return ret;
+
+	gc2053->ctrls.pixel_rate =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_PIXEL_RATE,
+				  GC2053_PIXEL_RATE, GC2053_PIXEL_RATE, 1,
+				  GC2053_PIXEL_RATE);
+
+	gc2053->ctrls.link_freq =
+		v4l2_ctrl_new_int_menu(hdl, ops, V4L2_CID_LINK_FREQ, 0, 0,
+				       gc2053_link_freqs);
+	if (gc2053->ctrls.link_freq)
+		gc2053->ctrls.link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	gc2053->ctrls.exposure =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_EXPOSURE, 1,
+				  gc2053_modes[0].vblank +
+				  gc2053_modes[0].height -
+				  GC2053_EXPOSURE_OFFSET, 1,
+				  gc2053_modes[0].vblank +
+				  gc2053_modes[0].height -
+				  GC2053_EXPOSURE_OFFSET);
+
+	gc2053->ctrls.gain =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_ANALOGUE_GAIN, 0,
+				  ARRAY_SIZE(gc2053_gains) - 1, 1, 0);
+
+	gc2053->ctrls.hblank =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_HBLANK,
+				  GC2053_HTS_MIN - GC2053_NATIVE_WIDTH,
+				  hblank_max, 1,
+				  gc2053_modes[0].hblank);
+
+	gc2053->ctrls.vblank =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_VBLANK,
+				  gc2053_modes[0].vblank, vblank_max, 1,
+				  gc2053_modes[0].vblank);
+
+	gc2053->ctrls.hflip = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_HFLIP,
+						0, 1, 1, 0);
+	gc2053->ctrls.vflip = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_VFLIP,
+						0, 1, 1, 0);
+	v4l2_ctrl_cluster(2, &gc2053->ctrls.hflip);
+
+	if (hdl->error) {
+		ret = hdl->error;
+		goto error;
+	}
+
+	ret = v4l2_fwnode_device_parse(gc2053->sd.dev, &props);
+	if (ret)
+		goto error;
+
+	ret = v4l2_ctrl_new_fwnode_properties(hdl, ops, &props);
+	if (ret)
+		goto error;
+
+	gc2053->sd.ctrl_handler = hdl;
+
+	return 0;
+
+error:
+	v4l2_ctrl_handler_free(hdl);
+
+	return ret;
+}
+
+static int gc2053_check_hwcfg(struct device *dev)
+{
+	struct v4l2_fwnode_endpoint ep = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	struct fwnode_handle *endpoint;
+	unsigned int i;
+	int ret;
+
+	endpoint = fwnode_graph_get_next_endpoint(dev_fwnode(dev), NULL);
+	if (!endpoint) {
+		dev_err(dev, "endpoint node not found\n");
+		return -EINVAL;
+	}
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(endpoint, &ep);
+	fwnode_handle_put(endpoint);
+	if (ret)
+		return ret;
+
+	if (ep.bus.mipi_csi2.num_data_lanes != 2) {
+		dev_err(dev, "only 2 data lanes are currently supported\n");
+		ret = -EINVAL;
+		goto out;
+	}
+
+	if (!ep.nr_of_link_frequencies) {
+		dev_err(dev, "link-frequency property not found in DT\n");
+		ret = -EINVAL;
+		goto out;
+	}
+
+	for (i = 0; i < ep.nr_of_link_frequencies; i++) {
+		if (ep.link_frequencies[i] == GC2053_LINK_FREQ)
+			break;
+	}
+
+	if (i == ep.nr_of_link_frequencies) {
+		dev_err(dev, "expected link frequency %u\n", GC2053_LINK_FREQ);
+		ret = -EINVAL;
+	}
+
+out:
+	v4l2_fwnode_endpoint_free(&ep);
+
+	return ret;
+}
+
+static int gc2053_power_on(struct device *dev)
+{
+	struct gc2053 *gc2053 = to_gc2053(dev_get_drvdata(dev));
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(gc2053->supplies),
+				    gc2053->supplies);
+	if (ret)
+		return ret;
+
+	ret = clk_prepare_enable(gc2053->xclk);
+	if (ret)
+		goto err_regulators;
+
+	/* The sensor needs MCLK while reset is released. */
+	gpiod_set_value_cansleep(gc2053->powerdown_gpio, 0);
+	gpiod_set_value_cansleep(gc2053->reset_gpio, 0);
+	msleep(20);
+
+	return 0;
+
+err_regulators:
+	regulator_bulk_disable(ARRAY_SIZE(gc2053->supplies), gc2053->supplies);
+
+	return ret;
+}
+
+static int gc2053_power_off(struct device *dev)
+{
+	struct gc2053 *gc2053 = to_gc2053(dev_get_drvdata(dev));
+
+	gpiod_set_value_cansleep(gc2053->reset_gpio, 1);
+	gpiod_set_value_cansleep(gc2053->powerdown_gpio, 1);
+	clk_disable_unprepare(gc2053->xclk);
+	regulator_bulk_disable(ARRAY_SIZE(gc2053->supplies), gc2053->supplies);
+
+	return 0;
+}
+
+static int gc2053_identify_module(struct gc2053 *gc2053)
+{
+	u64 id_h, id_l;
+	int ret;
+
+	ret = cci_read(gc2053->regmap, GC2053_REG_CHIP_ID_H, &id_h, NULL);
+	if (ret)
+		return ret;
+
+	ret = cci_read(gc2053->regmap, GC2053_REG_CHIP_ID_L, &id_l, NULL);
+	if (ret)
+		return ret;
+
+	if (id_h != GC2053_CHIP_ID_H || id_l != GC2053_CHIP_ID_L) {
+		dev_err(gc2053->sd.dev, "chip id mismatch: %x%x != %x%x\n",
+			(u8)id_h, (u8)id_l, GC2053_CHIP_ID_H, GC2053_CHIP_ID_L);
+		return -EIO;
+	}
+
+	return 0;
+}
+
+static int gc2053_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state, u32 pad,
+				 u64 streams_mask)
+{
+	struct gc2053 *gc2053 = to_gc2053(sd);
+	int ret;
+
+	ret = pm_runtime_resume_and_get(sd->dev);
+	if (ret)
+		return ret;
+
+	cci_multi_reg_write(gc2053->regmap, gc2053->mode->regs,
+			    gc2053->mode->regs_num, &ret);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = __v4l2_ctrl_handler_setup(&gc2053->ctrls.handler);
+	if (ret)
+		goto err_rpm_put;
+
+	cci_write(gc2053->regmap, GC2053_REG_PAGE_SELECT, 0x00, &ret);
+	cci_write(gc2053->regmap, GC2053_REG_STREAM, GC2053_STREAM_ON, &ret);
+	if (ret)
+		goto err_rpm_put;
+
+	return 0;
+
+err_rpm_put:
+	pm_runtime_put_autosuspend(sd->dev);
+
+	return ret;
+}
+
+static int gc2053_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	struct gc2053 *gc2053 = to_gc2053(sd);
+	int ret = 0;
+
+	cci_write(gc2053->regmap, GC2053_REG_PAGE_SELECT, 0x00, &ret);
+	cci_write(gc2053->regmap, GC2053_REG_STREAM, 0x00, &ret);
+	if (ret)
+		dev_err(sd->dev, "failed to stop streaming: %d\n", ret);
+
+	pm_runtime_put_autosuspend(sd->dev);
+
+	return ret;
+}
+
+static const struct v4l2_subdev_video_ops gc2053_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops gc2053_pad_ops = {
+	.enum_mbus_code = gc2053_enum_mbus_code,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = gc2053_set_pad_format,
+	.get_selection = gc2053_get_selection,
+	.enum_frame_size = gc2053_enum_frame_size,
+	.enable_streams = gc2053_enable_streams,
+	.disable_streams = gc2053_disable_streams,
+};
+
+static const struct v4l2_subdev_ops gc2053_subdev_ops = {
+	.video = &gc2053_video_ops,
+	.pad = &gc2053_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops gc2053_subdev_internal_ops = {
+	.init_state = gc2053_init_state,
+};
+
+static const char * const gc2053_supply_names[] = {
+	"iovdd",
+	"avdd",
+	"dvdd",
+};
+
+static int gc2053_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct gc2053 *gc2053;
+	unsigned int i;
+	unsigned long xclk_freq;
+	int ret;
+
+	gc2053 = devm_kzalloc(dev, sizeof(*gc2053), GFP_KERNEL);
+	if (!gc2053)
+		return -ENOMEM;
+
+	v4l2_i2c_subdev_init(&gc2053->sd, client, &gc2053_subdev_ops);
+	gc2053->sd.internal_ops = &gc2053_subdev_internal_ops;
+
+	ret = gc2053_check_hwcfg(dev);
+	if (ret)
+		return ret;
+
+	gc2053->xclk = devm_v4l2_sensor_clk_get(dev, NULL);
+	if (IS_ERR(gc2053->xclk))
+		return dev_err_probe(dev, PTR_ERR(gc2053->xclk),
+				     "failed to get xclk\n");
+
+	xclk_freq = clk_get_rate(gc2053->xclk);
+	if (xclk_freq != GC2053_XCLK_FREQ)
+		return dev_err_probe(dev, -EINVAL,
+				     "xclk frequency %lu Hz not supported\n",
+				     xclk_freq);
+
+	for (i = 0; i < ARRAY_SIZE(gc2053->supplies); i++)
+		gc2053->supplies[i].supply = gc2053_supply_names[i];
+
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(gc2053->supplies),
+				      gc2053->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get regulators\n");
+
+	gc2053->reset_gpio = devm_gpiod_get_optional(dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(gc2053->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(gc2053->reset_gpio),
+				     "failed to get reset gpio\n");
+
+	gc2053->powerdown_gpio = devm_gpiod_get_optional(dev, "powerdown",
+							 GPIOD_OUT_HIGH);
+	if (IS_ERR(gc2053->powerdown_gpio))
+		return dev_err_probe(dev, PTR_ERR(gc2053->powerdown_gpio),
+				     "failed to get powerdown gpio\n");
+
+	gc2053->regmap = devm_cci_regmap_init_i2c(client, 8);
+	if (IS_ERR(gc2053->regmap))
+		return dev_err_probe(dev, PTR_ERR(gc2053->regmap),
+				     "failed to get cci regmap\n");
+
+	ret = gc2053_power_on(dev);
+	if (ret)
+		return ret;
+
+	ret = gc2053_identify_module(gc2053);
+	if (ret)
+		goto err_power_off;
+
+	gc2053->mode = &gc2053_modes[0];
+
+	ret = gc2053_init_controls(gc2053);
+	if (ret)
+		goto err_power_off;
+
+	gc2053->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	gc2053->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	gc2053->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&gc2053->sd.entity, 1, &gc2053->pad);
+	if (ret)
+		goto err_handler_free;
+
+	gc2053->sd.state_lock = gc2053->ctrls.handler.lock;
+	ret = v4l2_subdev_init_finalize(&gc2053->sd);
+	if (ret)
+		goto err_media_entity;
+
+	pm_runtime_set_active(dev);
+	pm_runtime_get_noresume(dev);
+	pm_runtime_enable(dev);
+	pm_runtime_set_autosuspend_delay(dev, 1000);
+	pm_runtime_use_autosuspend(dev);
+	pm_runtime_put_autosuspend(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&gc2053->sd);
+	if (ret)
+		goto err_subdev_cleanup;
+
+	return 0;
+
+err_subdev_cleanup:
+	v4l2_subdev_cleanup(&gc2053->sd);
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+err_media_entity:
+	media_entity_cleanup(&gc2053->sd.entity);
+err_handler_free:
+	v4l2_ctrl_handler_free(&gc2053->ctrls.handler);
+err_power_off:
+	gc2053_power_off(dev);
+
+	return ret;
+}
+
+static void gc2053_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct gc2053 *gc2053 = to_gc2053(sd);
+
+	v4l2_subdev_cleanup(sd);
+	v4l2_async_unregister_subdev(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&gc2053->ctrls.handler);
+
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev))
+		gc2053_power_off(&client->dev);
+	pm_runtime_set_suspended(&client->dev);
+}
+
+static const struct of_device_id gc2053_dt_ids[] = {
+	{ .compatible = "galaxycore,gc2053" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, gc2053_dt_ids);
+
+static const struct i2c_device_id gc2053_id[] = {
+	{ .name = "gc2053" },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, gc2053_id);
+
+static const struct dev_pm_ops gc2053_pm_ops = {
+	RUNTIME_PM_OPS(gc2053_power_off, gc2053_power_on, NULL)
+};
+
+static struct i2c_driver gc2053_i2c_driver = {
+	.driver = {
+		.name = "gc2053",
+		.of_match_table = gc2053_dt_ids,
+		.pm = pm_ptr(&gc2053_pm_ops),
+	},
+	.id_table = gc2053_id,
+	.probe = gc2053_probe,
+	.remove = gc2053_remove,
+};
+
+module_i2c_driver(gc2053_i2c_driver);
+
+MODULE_DESCRIPTION("GalaxyCore GC2053 sensor driver");
+MODULE_LICENSE("GPL");
