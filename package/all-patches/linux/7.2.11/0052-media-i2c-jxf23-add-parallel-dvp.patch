From: Paul Philippov <paul@themactep.com>
Subject: [PATCH] media: i2c: jxf23: support the T20 10-bit parallel bus

The T20 Wyze Cam 2 wires the JXF23 as a 10-bit DVP sensor on I2C0
at 0x40 with a 24 MHz cgu_cim clock and an active-low PA18 reset.
Accept a parallel endpoint, use the BGGR10 media bus code, accept
the 24 MHz clock window, pulse the reset like the vendor sensor
module, and read the T20 chip ID from 0x0a/0x0b (0xf0/0xf1 is the
T31 MIPI variant). The CSI-2 path used by T31 is unchanged.

Signed-off-by: Paul Philippov <paul@themactep.com>
---
--- a/drivers/media/i2c/jxf23.c
+++ b/drivers/media/i2c/jxf23.c
@@ -293,8 +293,11 @@
 	struct jxf23_ctrls ctrls;
 
 	const struct jxf23_mode *mode;
+	u32 bus_type;
 };
 
+static u32 jxf23_mbus_code(struct jxf23 *jxf23);
+
 static inline struct jxf23 *to_jxf23(struct v4l2_subdev *sd)
 {
 	return container_of(sd, struct jxf23, sd);
@@ -305,10 +308,10 @@
 	return &container_of(ctrl->handler, struct jxf23, ctrls.handler)->sd;
 }
 
-static void jxf23_fill_format(const struct jxf23_mode *mode,
+static void jxf23_fill_format(const struct jxf23_mode *mode, u32 code,
 			       struct v4l2_mbus_framefmt *fmt)
 {
-	fmt->code = MEDIA_BUS_FMT_SRGGB10_1X10;
+	fmt->code = code;
 	fmt->width = mode->width;
 	fmt->height = mode->height;
 	fmt->field = V4L2_FIELD_NONE;
@@ -325,7 +328,7 @@
 	struct v4l2_rect *crop;
 
 	fmt = v4l2_subdev_state_get_format(state, 0);
-	jxf23_fill_format(&jxf23_modes[0], fmt);
+	jxf23_fill_format(&jxf23_modes[0], jxf23_mbus_code(to_jxf23(sd)), fmt);
 
 	crop = v4l2_subdev_state_get_crop(state, 0);
 	crop->left = 0;
@@ -343,7 +346,7 @@
 	if (code->index != 0)
 		return -EINVAL;
 
-	code->code = MEDIA_BUS_FMT_SRGGB10_1X10;
+	code->code = jxf23_mbus_code(to_jxf23(sd));
 
 	return 0;
 }
@@ -355,7 +358,7 @@
 	if (fse->index >= ARRAY_SIZE(jxf23_modes))
 		return -EINVAL;
 
-	if (fse->code != MEDIA_BUS_FMT_SRGGB10_1X10)
+	if (fse->code != jxf23_mbus_code(to_jxf23(sd)))
 		return -EINVAL;
 
 	fse->min_width = jxf23_modes[fse->index].width;
@@ -400,7 +403,7 @@
 				      width, height,
 				      fmt->format.width, fmt->format.height);
 
-	jxf23_fill_format(mode, &fmt->format);
+	jxf23_fill_format(mode, jxf23_mbus_code(jxf23), &fmt->format);
 	framefmt = v4l2_subdev_state_get_format(state, fmt->pad);
 	*framefmt = fmt->format;
 
@@ -566,10 +569,18 @@
 	return ret;
 }
 
-static int jxf23_check_hwcfg(struct device *dev)
+static u32 jxf23_mbus_code(struct jxf23 *jxf23)
+{
+	if (jxf23->bus_type == V4L2_MBUS_PARALLEL)
+		return MEDIA_BUS_FMT_SBGGR10_1X10;
+
+	return MEDIA_BUS_FMT_SRGGB10_1X10;
+}
+
+static int jxf23_check_hwcfg(struct device *dev, u32 *bus_type)
 {
 	struct v4l2_fwnode_endpoint ep = {
-		.bus_type = V4L2_MBUS_CSI2_DPHY,
+		.bus_type = V4L2_MBUS_UNKNOWN,
 	};
 	struct fwnode_handle *endpoint;
 	unsigned int i;
@@ -586,6 +597,24 @@
 	if (ret)
 		return ret;
 
+	if (ep.bus_type == V4L2_MBUS_PARALLEL) {
+		if (ep.bus.parallel.bus_width != 10) {
+			dev_err(dev, "only 10-bit parallel bus is supported\n");
+			ret = -EINVAL;
+			goto out;
+		}
+		*bus_type = V4L2_MBUS_PARALLEL;
+		ret = 0;
+		goto out;
+	}
+
+	if (ep.bus_type != V4L2_MBUS_CSI2_DPHY) {
+		dev_err(dev, "unsupported media bus type %u\n", ep.bus_type);
+		ret = -EINVAL;
+		goto out;
+	}
+	*bus_type = V4L2_MBUS_CSI2_DPHY;
+
 	if (ep.bus.mipi_csi2.num_data_lanes != 2) {
 		dev_err(dev, "only 2 data lanes are currently supported\n");
 		ret = -EINVAL;
@@ -629,10 +658,15 @@
 	if (ret)
 		goto err_regulators;
 
-	/* The sensor needs MCLK while reset is released. */
+	/*
+	 * The sensor needs MCLK while reset is released. The vendor
+	 * sequence is high -> low (40 ms) -> high (100 ms).
+	 */
 	gpiod_set_value_cansleep(jxf23->powerdown_gpio, 0);
+	gpiod_set_value_cansleep(jxf23->reset_gpio, 1);
+	msleep(40);
 	gpiod_set_value_cansleep(jxf23->reset_gpio, 0);
-	msleep(20);
+	msleep(100);
 
 	return 0;
 
@@ -658,13 +692,24 @@
 static int jxf23_identify_module(struct jxf23 *jxf23)
 {
 	u64 id_h, id_l;
+	u32 reg_h = JXF23_REG_CHIP_ID_H;
+	u32 reg_l = JXF23_REG_CHIP_ID_L;
 	int ret;
 
-	ret = cci_read(jxf23->regmap, JXF23_REG_CHIP_ID_H, &id_h, NULL);
+	/*
+	 * The T31 MIPI variant reports its ID at 0xf0/0xf1. The T20 DVP
+	 * variant keeps it at 0x0a/0x0b (same values, different registers).
+	 */
+	if (jxf23->bus_type == V4L2_MBUS_PARALLEL) {
+		reg_h = CCI_REG8(0x0a);
+		reg_l = CCI_REG8(0x0b);
+	}
+
+	ret = cci_read(jxf23->regmap, reg_h, &id_h, NULL);
 	if (ret)
 		return ret;
 
-	ret = cci_read(jxf23->regmap, JXF23_REG_CHIP_ID_L, &id_l, NULL);
+	ret = cci_read(jxf23->regmap, reg_l, &id_l, NULL);
 	if (ret)
 		return ret;
 
@@ -770,7 +815,7 @@
 	v4l2_i2c_subdev_init(&jxf23->sd, client, &jxf23_subdev_ops);
 	jxf23->sd.internal_ops = &jxf23_subdev_internal_ops;
 
-	ret = jxf23_check_hwcfg(dev);
+	ret = jxf23_check_hwcfg(dev, &jxf23->bus_type);
 	if (ret)
 		return ret;
 
@@ -780,7 +825,18 @@
 				     "failed to get xclk\n");
 
 	xclk_freq = clk_get_rate(jxf23->xclk);
-	if (xclk_freq != JXF23_XCLK_FREQ)
+	/*
+	 * The T31 module runs from 27 MHz. The T20 Wyze Cam 2 runs the
+	 * sensor from the 24 MHz cgu_cim clock. Accept either window.
+	 */
+	if (jxf23->bus_type == V4L2_MBUS_PARALLEL) {
+		if (xclk_freq < 24000000UL * 95 / 100 ||
+		    xclk_freq > 24000000UL * 105 / 100)
+			return dev_err_probe(dev, -EINVAL,
+					     "xclk frequency %lu Hz not supported\n",
+					     xclk_freq);
+	} else if (xclk_freq < JXF23_XCLK_FREQ * 95UL / 100 ||
+		   xclk_freq > JXF23_XCLK_FREQ * 105UL / 100)
 		return dev_err_probe(dev, -EINVAL,
 				     "xclk frequency %lu Hz not supported\n",
 				     xclk_freq);
