+
+#define GC2083_CHIP_ID_H			0x20
+#define GC2083_CHIP_ID_L			0x83
+
+#define GC2083_REG_CHIP_ID_H			CCI_REG8(0x03f0)
+#define GC2083_REG_CHIP_ID_L			CCI_REG8(0x03f1)
+
+/* Exposure is a 16-bit big-endian value split over 0x0d03/0x0d04. */
+#define GC2083_REG_EXPOSURE			CCI_REG16(0x0d03)
+/* HTS is stored divided by two (dual pixel clock). */
+#define GC2083_REG_HTS				CCI_REG16(0x0d05)
+#define GC2083_REG_VTS				CCI_REG16(0x0d41)
+
+#define GC2083_REG_VFLIP			CCI_REG8(0x0d15)
+#define GC2083_FLIP_VFLIP			BIT(1)
+#define GC2083_REG_COL_START			CCI_REG8(0x0192)
+
