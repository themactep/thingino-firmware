+#define GC2083_REG_GAIN_DARKN_G2		CCI_REG8(0x0417)
+
+#define GC2083_REG_STREAM			CCI_REG8(0x023e)
+#define GC2083_STREAM_ON			0x99
+
+/* External clock is 27 MHz. */
+#define GC2083_XCLK_FREQ			(27 * HZ_PER_MHZ)
+
+#define GC2083_NATIVE_WIDTH			1920U
+#define GC2083_NATIVE_HEIGHT			1080U
+
+/* 2 lanes, 495 Mbit/s per lane. */
