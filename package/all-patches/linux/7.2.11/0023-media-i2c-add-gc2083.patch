+static const struct gc2083_mode gc2083_modes[] = {
+	{
+		.width = GC2083_NATIVE_WIDTH,
+		.height = GC2083_NATIVE_HEIGHT,
+		.hblank = GC2083_HTS_MIN - GC2083_NATIVE_WIDTH,
+		.vblank = 1350 - GC2083_NATIVE_HEIGHT,
