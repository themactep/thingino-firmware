+
+static const s64 gc2083_link_freqs[] = {
+	GC2083_LINK_FREQ,
+};
+
+#define GC2083_HTS_MIN				2932U
+#define GC2083_HTS_MAX				(2U * 0xffff)
+#define GC2083_VTS_MAX				0xffffU
+
+/* Number of lines by which exposure must be less than VTS. */
