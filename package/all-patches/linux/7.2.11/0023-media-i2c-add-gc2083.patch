+struct gc2083_ctrls {
+	struct v4l2_ctrl_handler handler;
+	struct v4l2_ctrl *pixel_rate;
+	struct v4l2_ctrl *link_freq;
+	struct v4l2_ctrl *hblank;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *gain;
+	struct v4l2_ctrl *vflip;
+};
+
+struct gc2083 {
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+
+	struct regmap *regmap;
+	struct clk *xclk;
+
+	struct gpio_desc *reset_gpio;
+	struct gpio_desc *powerdown_gpio;
+	struct regulator_bulk_data supplies[3];
+
+	struct gc2083_ctrls ctrls;
+
+	const struct gc2083_mode *mode;
+};
+
+static inline struct gc2083 *to_gc2083(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct gc2083, sd);
+}
+
+static inline struct v4l2_subdev *gc2083_ctrl_to_sd(struct v4l2_ctrl *ctrl)
+{
+	return &container_of(ctrl->handler, struct gc2083, ctrls.handler)->sd;
+}
+
+static void gc2083_fill_format(const struct gc2083_mode *mode,
+			       struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->code = MEDIA_BUS_FMT_SRGGB10_1X10;
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	fmt->quantization = V4L2_QUANTIZATION_DEFAULT;
+	fmt->xfer_func = V4L2_XFER_FUNC_DEFAULT;
+}
+
+static int gc2083_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct v4l2_mbus_framefmt *fmt;
+	struct v4l2_rect *crop;
+
+	fmt = v4l2_subdev_state_get_format(state, 0);
+	gc2083_fill_format(&gc2083_modes[0], fmt);
+
+	crop = v4l2_subdev_state_get_crop(state, 0);
+	crop->left = 0;
+	crop->top = 0;
+	crop->width = gc2083_modes[0].width;
+	crop->height = gc2083_modes[0].height;
+
+	return 0;
+}
+
+static int gc2083_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index != 0)
+		return -EINVAL;
+
+	code->code = MEDIA_BUS_FMT_SRGGB10_1X10;
+
+	return 0;
+}
+
+static int gc2083_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index >= ARRAY_SIZE(gc2083_modes))
+		return -EINVAL;
+
+	if (fse->code != MEDIA_BUS_FMT_SRGGB10_1X10)
+		return -EINVAL;
+
+	fse->min_width = gc2083_modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = gc2083_modes[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+static int gc2083_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		sel->r = *v4l2_subdev_state_get_crop(state, 0);
+		return 0;
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = GC2083_NATIVE_WIDTH;
+		sel->r.height = GC2083_NATIVE_HEIGHT;
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static int gc2083_set_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct gc2083 *gc2083 = to_gc2083(sd);
+	const struct gc2083_mode *mode;
+	struct v4l2_mbus_framefmt *framefmt;
+	struct v4l2_rect *crop;
+
+	mode = v4l2_find_nearest_size(gc2083_modes, ARRAY_SIZE(gc2083_modes),
+				      width, height,
+				      fmt->format.width, fmt->format.height);
+
+	gc2083_fill_format(mode, &fmt->format);
+	framefmt = v4l2_subdev_state_get_format(state, fmt->pad);
+	*framefmt = fmt->format;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_ACTIVE) {
+		gc2083->mode = mode;
+		__v4l2_ctrl_s_ctrl(gc2083->ctrls.hblank, mode->hblank);
+		__v4l2_ctrl_s_ctrl(gc2083->ctrls.vblank, mode->vblank);
+	}
+
+	crop = v4l2_subdev_state_get_crop(state, fmt->pad);
+	crop->left = 0;
+	crop->top = 0;
+	crop->width = mode->width;
+	crop->height = mode->height;
+
+	return 0;
+}
+
+static void gc2083_exposure_update(struct gc2083 *gc2083)
+{
+	unsigned int exposure_max;
+
+	exposure_max = gc2083->ctrls.vblank->val + gc2083->mode->height -
+		       GC2083_EXPOSURE_OFFSET;
+	exposure_max = min(exposure_max, 0xffffU);
+
+	__v4l2_ctrl_modify_range(gc2083->ctrls.exposure, 1, exposure_max, 1,
+				 exposure_max);
+}
+
+static int gc2083_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct gc2083 *gc2083 = to_gc2083(gc2083_ctrl_to_sd(ctrl));
+
+	dev_dbg(gc2083->sd.dev, "gc2083: ctrl 0x%x = %d\n", ctrl->id, ctrl->val);
+	const struct gc2083_gain *gain;
+	u32 hts;
+	int ret = 0;
+
+	if (ctrl->flags & V4L2_CTRL_FLAG_READ_ONLY)
+		return 0;
+
+	if (ctrl->id == V4L2_CID_VBLANK)
+		gc2083_exposure_update(gc2083);
+
+	if (!pm_runtime_get_if_in_use(gc2083->sd.dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		ret = cci_write(gc2083->regmap, GC2083_REG_EXPOSURE,
+				ctrl->val, NULL);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		gain = &gc2083_gains[ctrl->val];
+		ret = cci_write(gc2083->regmap, GC2083_REG_GAIN_PGA,
+				gain->again_pga, NULL);
+		ret = cci_write(gc2083->regmap, GC2083_REG_GAIN_LATCH,
+				0x2e, &ret);
+		ret = cci_write(gc2083->regmap, GC2083_REG_GAIN_SHIFT,
+				gain->again_shift, &ret);
+		ret = cci_write(gc2083->regmap, GC2083_REG_GAIN_LATCH,
+				0x28, &ret);
+		ret = cci_write(gc2083->regmap, GC2083_REG_GAIN_COL0,
+				gain->col_gain0, &ret);
+		ret = cci_write(gc2083->regmap, GC2083_REG_GAIN_COL1,
+				gain->col_gain1, &ret);
+		ret = cci_write(gc2083->regmap, GC2083_REG_GAIN_DARKC,
+				gain->exp_rate_darkc, &ret);
+		ret = cci_write(gc2083->regmap, GC2083_REG_GAIN_DARKS_G1,
+				gain->darks_g1, &ret);
+		ret = cci_write(gc2083->regmap, GC2083_REG_GAIN_DARKS_R1,
+				gain->darks_r1, &ret);
+		ret = cci_write(gc2083->regmap, GC2083_REG_GAIN_DARKS_B1,
+				gain->darks_b1, &ret);
+		ret = cci_write(gc2083->regmap, GC2083_REG_GAIN_DARKS_G2,
+				gain->darks_g2, &ret);
+		ret = cci_write(gc2083->regmap, GC2083_REG_GAIN_DARKN_G1,
+				gain->darkn_g1, &ret);
+		ret = cci_write(gc2083->regmap, GC2083_REG_GAIN_DARKN_R1,
+				gain->darkn_r1, &ret);
+		ret = cci_write(gc2083->regmap, GC2083_REG_GAIN_DARKN_B1,
+				gain->darkn_b1, &ret);
+		ret = cci_write(gc2083->regmap, GC2083_REG_GAIN_DARKN_G2,
+				gain->darkn_g2, &ret);
+		break;
+	case V4L2_CID_HBLANK:
+		hts = ctrl->val + gc2083->mode->width;
+		ret = cci_write(gc2083->regmap, GC2083_REG_HTS, hts / 2, NULL);
+		break;
+	case V4L2_CID_VBLANK:
+		ret = cci_write(gc2083->regmap, GC2083_REG_VTS,
+				ctrl->val + gc2083->mode->height, NULL);
+		break;
+	case V4L2_CID_VFLIP:
+		ret = cci_update_bits(gc2083->regmap, GC2083_REG_VFLIP,
+				      GC2083_FLIP_VFLIP,
+				      ctrl->val ? GC2083_FLIP_VFLIP : 0, NULL);
+		if (!ret)
+			ret = cci_write(gc2083->regmap, GC2083_REG_COL_START,
+					ctrl->val ? 0x01 : 0x00, NULL);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put_autosuspend(gc2083->sd.dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops gc2083_ctrl_ops = {
+	.s_ctrl = gc2083_set_ctrl,
+};
+
+static int gc2083_init_controls(struct gc2083 *gc2083)
+{
+	struct v4l2_ctrl_handler *hdl = &gc2083->ctrls.handler;
+	struct v4l2_fwnode_device_properties props;
+	const struct v4l2_ctrl_ops *ops = &gc2083_ctrl_ops;
+	unsigned int hblank_max = GC2083_HTS_MAX - GC2083_NATIVE_WIDTH;
+	unsigned int vblank_max = GC2083_VTS_MAX - GC2083_NATIVE_HEIGHT;
+	int ret;
+
+	ret = v4l2_ctrl_handler_init(hdl, 10);
+	if (ret)
+		return ret;
+
+	gc2083->ctrls.pixel_rate =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_PIXEL_RATE,
+				  GC2083_PIXEL_RATE, GC2083_PIXEL_RATE, 1,
+				  GC2083_PIXEL_RATE);
+
+	gc2083->ctrls.link_freq =
+		v4l2_ctrl_new_int_menu(hdl, ops, V4L2_CID_LINK_FREQ, 0, 0,
+				       gc2083_link_freqs);
+	if (gc2083->ctrls.link_freq)
+		gc2083->ctrls.link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	gc2083->ctrls.exposure =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_EXPOSURE, 1,
+				  gc2083_modes[0].vblank +
+				  gc2083_modes[0].height -
+				  GC2083_EXPOSURE_OFFSET, 1,
+				  gc2083_modes[0].vblank +
+				  gc2083_modes[0].height -
+				  GC2083_EXPOSURE_OFFSET);
+
+	gc2083->ctrls.gain =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_ANALOGUE_GAIN, 0,
+				  ARRAY_SIZE(gc2083_gains) - 1, 1, 0);
+
+	gc2083->ctrls.hblank =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_HBLANK,
+				  GC2083_HTS_MIN - GC2083_NATIVE_WIDTH,
+				  hblank_max, 1,
+				  gc2083_modes[0].hblank);
+
+	gc2083->ctrls.vblank =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_VBLANK,
+				  gc2083_modes[0].vblank, vblank_max, 1,
+				  gc2083_modes[0].vblank);
+
+	gc2083->ctrls.vflip = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_VFLIP,
+						0, 1, 1, 0);
+
+	if (hdl->error) {
+		ret = hdl->error;
+		goto error;
+	}
+
+	ret = v4l2_fwnode_device_parse(gc2083->sd.dev, &props);
+	if (ret)
+		goto error;
+
+	ret = v4l2_ctrl_new_fwnode_properties(hdl, ops, &props);
+	if (ret)
+		goto error;
+
+	gc2083->sd.ctrl_handler = hdl;
+
+	return 0;
+
+error:
+	v4l2_ctrl_handler_free(hdl);
+
+	return ret;
+}
+
+static int gc2083_check_hwcfg(struct device *dev)
+{
+	struct v4l2_fwnode_endpoint ep = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	struct fwnode_handle *endpoint;
+	unsigned int i;
+	int ret;
+
+	endpoint = fwnode_graph_get_next_endpoint(dev_fwnode(dev), NULL);
+	if (!endpoint) {
+		dev_err(dev, "endpoint node not found\n");
+		return -EINVAL;
+	}
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(endpoint, &ep);
+	fwnode_handle_put(endpoint);
+	if (ret)
+		return ret;
+
+	if (ep.bus.mipi_csi2.num_data_lanes != 2) {
+		dev_err(dev, "only 2 data lanes are currently supported\n");
+		ret = -EINVAL;
+		goto out;
+	}
+
+	if (!ep.nr_of_link_frequencies) {
+		dev_err(dev, "link-frequency property not found in DT\n");
+		ret = -EINVAL;
+		goto out;
+	}
+
+	for (i = 0; i < ep.nr_of_link_frequencies; i++) {
+		if (ep.link_frequencies[i] == GC2083_LINK_FREQ)
+			break;
+	}
+
+	if (i == ep.nr_of_link_frequencies) {
+		dev_err(dev, "expected link frequency %u\n", GC2083_LINK_FREQ);
+		ret = -EINVAL;
+	}
+
+out:
+	v4l2_fwnode_endpoint_free(&ep);
+
+	return ret;
+}
+
+static int gc2083_power_on(struct device *dev)
+{
+	dev_dbg(dev, "gc2083: power on\n");
+	struct gc2083 *gc2083 = to_gc2083(dev_get_drvdata(dev));
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(gc2083->supplies),
+				    gc2083->supplies);
+	if (ret)
+		return ret;
+
+	ret = clk_prepare_enable(gc2083->xclk);
+	if (ret)
+		goto err_regulators;
+
+	/* The sensor needs MCLK while reset is released. */
+	gpiod_set_value_cansleep(gc2083->powerdown_gpio, 0);
+	gpiod_set_value_cansleep(gc2083->reset_gpio, 0);
+	msleep(20);
+
+	return 0;
+
+err_regulators:
+	regulator_bulk_disable(ARRAY_SIZE(gc2083->supplies), gc2083->supplies);
+
+	return ret;
+}
+
+static int gc2083_power_off(struct device *dev)
+{
+	dev_dbg(dev, "gc2083: power off\n");
+	struct gc2083 *gc2083 = to_gc2083(dev_get_drvdata(dev));
+
+	gpiod_set_value_cansleep(gc2083->reset_gpio, 1);
+	gpiod_set_value_cansleep(gc2083->powerdown_gpio, 1);
+	clk_disable_unprepare(gc2083->xclk);
+	regulator_bulk_disable(ARRAY_SIZE(gc2083->supplies), gc2083->supplies);
+
+	return 0;
+}
+
+static int gc2083_identify_module(struct gc2083 *gc2083)
+{
+	u64 id_h, id_l;
+	int ret;
+
+	ret = cci_read(gc2083->regmap, GC2083_REG_CHIP_ID_H, &id_h, NULL);
+	if (ret)
+		return ret;
+
+	ret = cci_read(gc2083->regmap, GC2083_REG_CHIP_ID_L, &id_l, NULL);
+	if (ret)
+		return ret;
+
+	if (id_h != GC2083_CHIP_ID_H || id_l != GC2083_CHIP_ID_L) {
+		dev_err(gc2083->sd.dev, "chip id mismatch: %x%x != %x%x\n",
+			(u8)id_h, (u8)id_l, GC2083_CHIP_ID_H, GC2083_CHIP_ID_L);
+		return -EIO;
+	}
+
+	dev_info(gc2083->sd.dev, "gc2083: chip id %02x%02x\n", (u8)id_h, (u8)id_l);
+	return 0;
+}
+
+static int gc2083_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state, u32 pad,
+				 u64 streams_mask)
+{
+	struct gc2083 *gc2083 = to_gc2083(sd);
+
+	dev_info(sd->dev, "gc2083: stream on\n");
+	int ret;
+
+	ret = pm_runtime_resume_and_get(sd->dev);
+	if (ret)
+		return ret;
+
+	cci_multi_reg_write(gc2083->regmap, gc2083->mode->regs,
+			    gc2083->mode->regs_num, &ret);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = __v4l2_ctrl_handler_setup(&gc2083->ctrls.handler);
+	if (ret)
+		goto err_rpm_put;
+
+	cci_write(gc2083->regmap, GC2083_REG_STREAM, GC2083_STREAM_ON, &ret);
+	if (ret)
+		goto err_rpm_put;
+
+	return 0;
+
+err_rpm_put:
+	pm_runtime_put_autosuspend(sd->dev);
+
+	return ret;
+}
+
+static int gc2083_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	dev_info(sd->dev, "gc2083: stream off\n");
+	struct gc2083 *gc2083 = to_gc2083(sd);
+	int ret = 0;
+
+	cci_write(gc2083->regmap, GC2083_REG_STREAM, 0x00, &ret);
+	if (ret)
+		dev_err(sd->dev, "failed to stop streaming: %d\n", ret);
+
+	pm_runtime_put_autosuspend(sd->dev);
+
+	return ret;
+}
+
+static const struct v4l2_subdev_video_ops gc2083_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops gc2083_pad_ops = {
+	.enum_mbus_code = gc2083_enum_mbus_code,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = gc2083_set_pad_format,
+	.get_selection = gc2083_get_selection,
+	.enum_frame_size = gc2083_enum_frame_size,
+	.enable_streams = gc2083_enable_streams,
+	.disable_streams = gc2083_disable_streams,
+};
+
+static const struct v4l2_subdev_ops gc2083_subdev_ops = {
+	.video = &gc2083_video_ops,
+	.pad = &gc2083_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops gc2083_subdev_internal_ops = {
+	.init_state = gc2083_init_state,
+};
+
+static const char * const gc2083_supply_names[] = {
+	"iovdd",
+	"avdd",
+	"dvdd",
+};
+
+static int gc2083_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+
+	dev_info(dev, "gc2083: probe at i2c 0x%02x\n", client->addr);
+	struct gc2083 *gc2083;
+	unsigned int i;
+	unsigned long xclk_freq;
+	int ret;
+
+	gc2083 = devm_kzalloc(dev, sizeof(*gc2083), GFP_KERNEL);
+	if (!gc2083)
+		return -ENOMEM;
+
+	v4l2_i2c_subdev_init(&gc2083->sd, client, &gc2083_subdev_ops);
+	gc2083->sd.internal_ops = &gc2083_subdev_internal_ops;
+
+	ret = gc2083_check_hwcfg(dev);
+	if (ret)
+		return ret;
+
+	gc2083->xclk = devm_v4l2_sensor_clk_get(dev, NULL);
+	if (IS_ERR(gc2083->xclk))
+		return dev_err_probe(dev, PTR_ERR(gc2083->xclk),
+				     "failed to get xclk\n");
+
+	xclk_freq = clk_get_rate(gc2083->xclk);
+	if (xclk_freq != GC2083_XCLK_FREQ)
+		return dev_err_probe(dev, -EINVAL,
+				     "xclk frequency %lu Hz not supported\n",
+				     xclk_freq);
+
+	for (i = 0; i < ARRAY_SIZE(gc2083->supplies); i++)
+		gc2083->supplies[i].supply = gc2083_supply_names[i];
+
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(gc2083->supplies),
+				      gc2083->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get regulators\n");
+
+	gc2083->reset_gpio = devm_gpiod_get_optional(dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(gc2083->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(gc2083->reset_gpio),
+				     "failed to get reset gpio\n");
+
+	gc2083->powerdown_gpio = devm_gpiod_get_optional(dev, "powerdown",
+							 GPIOD_OUT_HIGH);
+	if (IS_ERR(gc2083->powerdown_gpio))
+		return dev_err_probe(dev, PTR_ERR(gc2083->powerdown_gpio),
+				     "failed to get powerdown gpio\n");
+
+	gc2083->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(gc2083->regmap))
+		return dev_err_probe(dev, PTR_ERR(gc2083->regmap),
+				     "failed to get cci regmap\n");
+
+	ret = gc2083_power_on(dev);
+	if (ret)
+		return ret;
+
+	ret = gc2083_identify_module(gc2083);
+	if (ret)
+		goto err_power_off;
+
+	gc2083->mode = &gc2083_modes[0];
+
+	ret = gc2083_init_controls(gc2083);
+	if (ret)
+		goto err_power_off;
+
+	gc2083->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	gc2083->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	gc2083->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&gc2083->sd.entity, 1, &gc2083->pad);
+	if (ret)
+		goto err_handler_free;
+
+	gc2083->sd.state_lock = gc2083->ctrls.handler.lock;
+	ret = v4l2_subdev_init_finalize(&gc2083->sd);
+	if (ret)
+		goto err_media_entity;
+
+	pm_runtime_set_active(dev);
+	pm_runtime_get_noresume(dev);
+	pm_runtime_enable(dev);
+	pm_runtime_set_autosuspend_delay(dev, 1000);
+	pm_runtime_use_autosuspend(dev);
+	pm_runtime_put_autosuspend(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&gc2083->sd);
+	if (ret)
+		goto err_subdev_cleanup;
+
+	return 0;
+
+err_subdev_cleanup:
+	v4l2_subdev_cleanup(&gc2083->sd);
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+err_media_entity:
+	media_entity_cleanup(&gc2083->sd.entity);
+err_handler_free:
+	v4l2_ctrl_handler_free(&gc2083->ctrls.handler);
+err_power_off:
+	gc2083_power_off(dev);
+
+	return ret;
+}
+
+static void gc2083_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct gc2083 *gc2083 = to_gc2083(sd);
+
+	v4l2_subdev_cleanup(sd);
+	v4l2_async_unregister_subdev(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&gc2083->ctrls.handler);
+
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev))
+		gc2083_power_off(&client->dev);
+	pm_runtime_set_suspended(&client->dev);
+}
+
+static const struct of_device_id gc2083_dt_ids[] = {
+	{ .compatible = "galaxycore,gc2083" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, gc2083_dt_ids);
+
+static const struct i2c_device_id gc2083_id[] = {
+	{ .name = "gc2083" },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, gc2083_id);
+
+static const struct dev_pm_ops gc2083_pm_ops = {
+	RUNTIME_PM_OPS(gc2083_power_off, gc2083_power_on, NULL)
+};
+
+static struct i2c_driver gc2083_i2c_driver = {
+	.driver = {
+		.name = "gc2083",
+		.of_match_table = gc2083_dt_ids,
+		.pm = pm_ptr(&gc2083_pm_ops),
+	},
+	.id_table = gc2083_id,
+	.probe = gc2083_probe,
+	.remove = gc2083_remove,
+};
+
+module_i2c_driver(gc2083_i2c_driver);
+
+MODULE_DESCRIPTION("GalaxyCore GC2083 sensor driver");
+MODULE_LICENSE("GPL");
