Subject: [PATCH] dt-bindings: sound: document ingenic,t31-i2s and
 ingenic,t31-codec

Add the T31 to the AIC binding (third clock: the capture divider) and a
binding for the T31 internal codec with its optional
speaker-enable-gpios.
---
 .../bindings/sound/ingenic,aic.yaml           | 25 +++++++-
 .../bindings/sound/ingenic,t31-codec.yaml     | 64 +++++++++++++++++++
 2 files changed, 88 insertions(+), 1 deletion(-)
 create mode 100644 Documentation/devicetree/bindings/sound/ingenic,t31-codec.yaml

diff --git a/Documentation/devicetree/bindings/sound/ingenic,aic.yaml b/Documentation/devicetree/bindings/sound/ingenic,aic.yaml
index d15c000f1..ce989d5f3 100644
--- a/Documentation/devicetree/bindings/sound/ingenic,aic.yaml
+++ b/Documentation/devicetree/bindings/sound/ingenic,aic.yaml
@@ -23,6 +23,7 @@ properties:
           - ingenic,jz4760-i2s
           - ingenic,jz4770-i2s
           - ingenic,jz4780-i2s
+          - ingenic,t31-i2s
           - ingenic,x1000-i2s
       - items:
           - const: ingenic,jz4725b-i2s
@@ -38,14 +39,18 @@ properties:
     maxItems: 1
 
   clocks:
+    minItems: 2
     items:
       - description: AIC clock
-      - description: I2S clock
+      - description: I2S clock (on the T31 the playback divider)
+      - description: I2S capture divider (T31 only)
 
   clock-names:
+    minItems: 2
     items:
       - const: aic
       - const: i2s
+      - const: i2s-rx
 
   dmas:
     items:
@@ -57,6 +62,24 @@ properties:
       - const: rx
       - const: tx
 
+if:
+  properties:
+    compatible:
+      contains:
+        const: ingenic,t31-i2s
+then:
+  properties:
+    clocks:
+      minItems: 3
+    clock-names:
+      minItems: 3
+else:
+  properties:
+    clocks:
+      maxItems: 2
+    clock-names:
+      maxItems: 2
+
 unevaluatedProperties: false
 
 required:
diff --git a/Documentation/devicetree/bindings/sound/ingenic,t31-codec.yaml b/Documentation/devicetree/bindings/sound/ingenic,t31-codec.yaml
new file mode 100644
index 000000000..093e65509
--- /dev/null
+++ b/Documentation/devicetree/bindings/sound/ingenic,t31-codec.yaml
@@ -0,0 +1,64 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sound/ingenic,t31-codec.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Ingenic T31 internal audio codec
+
+description:
+  The analogue microphone ADC and line/speaker DAC of the Ingenic T31 SoC.
+  It is the I2S bit-clock and frame master towards the T31 AIC.
+
+maintainers:
+  - Paul Cercueil <paul@crapouillou.net>
+
+allOf:
+  - $ref: dai-common.yaml#
+
+properties:
+  $nodename:
+    pattern: '^audio-codec@.*'
+
+  compatible:
+    const: ingenic,t31-codec
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+
+  clock-names:
+    items:
+      - const: aic
+
+  speaker-enable-gpios:
+    maxItems: 1
+    description:
+      External speaker amplifier enable. Raised only while a playback stream
+      runs.
+
+  '#sound-dai-cells':
+    const: 0
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+  - '#sound-dai-cells'
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    codec: audio-codec@10021000 {
+      compatible = "ingenic,t31-codec";
+      reg = <0x10021000 0x1000>;
+      #sound-dai-cells = <0>;
+      clocks = <&cgu 0>;
+      clock-names = "aic";
+      speaker-enable-gpios = <&gpa 7 GPIO_ACTIVE_HIGH>;
+    };
