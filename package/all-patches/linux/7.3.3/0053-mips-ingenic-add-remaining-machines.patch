 dtb-$(CONFIG_X1830_CU1830_NEO)	+= cu1830-neo.dtb
 dtb-$(CONFIG_MACH_T31)		+= thingino-t31.dtb
 dtb-$(CONFIG_MACH_T20_PRIMARY)	+= thingino-t20.dtb
+dtb-$(CONFIG_MACH_T10_PRIMARY)	+= thingino-t10.dtb
+dtb-$(CONFIG_MACH_T21_PRIMARY)	+= thingino-t21.dtb
+dtb-$(CONFIG_MACH_T23_PRIMARY)	+= thingino-t23.dtb
