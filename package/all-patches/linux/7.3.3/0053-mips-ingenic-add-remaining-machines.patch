+dtb-$(CONFIG_MACH_T32_PRIMARY)	+= thingino-t32.dtb
+dtb-$(CONFIG_MACH_T33_PRIMARY)	+= thingino-t33.dtb
 dtb-$(CONFIG_MACH_T40_PRIMARY)	+= shark.dtb
 dtb-$(CONFIG_MACH_T41_PRIMARY)	+= marmot.dtb
 ifeq ($(CONFIG_MACH_T41_PRIMARY),y)
 dtb-y := marmot.dtb $(filter-out marmot.dtb,$(dtb-y))
 else ifeq ($(CONFIG_MACH_T40_PRIMARY),y)
 dtb-y := shark.dtb $(filter-out shark.dtb,$(dtb-y))
+else ifeq ($(CONFIG_MACH_T33_PRIMARY),y)
+dtb-y := thingino-t33.dtb $(filter-out thingino-t33.dtb,$(dtb-y))
+else ifeq ($(CONFIG_MACH_T32_PRIMARY),y)
+dtb-y := thingino-t32.dtb $(filter-out thingino-t32.dtb,$(dtb-y))
+else ifeq ($(CONFIG_MACH_T30_PRIMARY),y)
+dtb-y := thingino-t30.dtb $(filter-out thingino-t30.dtb,$(dtb-y))
+else ifeq ($(CONFIG_MACH_T23_PRIMARY),y)
+dtb-y := thingino-t23.dtb $(filter-out thingino-t23.dtb,$(dtb-y))
+else ifeq ($(CONFIG_MACH_T21_PRIMARY),y)
+dtb-y := thingino-t21.dtb $(filter-out thingino-t21.dtb,$(dtb-y))
 else ifeq ($(CONFIG_MACH_T20_PRIMARY),y)
 dtb-y := thingino-t20.dtb $(filter-out thingino-t20.dtb,$(dtb-y))
+else ifeq ($(CONFIG_MACH_T10_PRIMARY),y)
