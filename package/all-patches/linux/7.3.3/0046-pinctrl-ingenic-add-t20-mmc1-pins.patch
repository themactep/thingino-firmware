From: Paul Philippov <paul@themactep.com>
Subject: [PATCH] pinctrl: ingenic: add T20 mmc1 (SDIO) pin groups

The T20 SDIO WiFi sits on MSC1, wired to PC2-7 with function 0. The
shared t31_chip_info only carries the T31 PB8-14 groups, so the PC pins
are never muxed and no SDIO card is found.

Add the T20 1-bit/4-bit groups under the "mmc1" function.

Signed-off-by: Paul Philippov <paul@themactep.com>
---
--- a/drivers/pinctrl/pinctrl-ingenic.c
+++ b/drivers/pinctrl/pinctrl-ingenic.c
@@ -2841,6 +2841,9 @@
 static int t31_mmc0_4bit_pins[] = { 0x23, 0x24, 0x25, };
 static int t31_mmc1_1bit_pins[] = { 0x28, 0x29, 0x2a, };
 static int t31_mmc1_4bit_pins[] = { 0x2b, 0x2d, 0x2e, };
+/* T20 wires MSC1 to PC2-7 (function 0); the T31 groups cover PB only. */
+static int t20_mmc1_1bit_pins[] = { 0x42, 0x43, 0x44, };
+static int t20_mmc1_4bit_pins[] = { 0x45, 0x46, 0x47, };
 static int t31_sfc_data_pins[] = { 0x17, 0x18, 0x1b, 0x1c, };
 static int t31_ssi0_dt_pins[] = { 0x4b, };
 static int t31_ssi0_dr_pins[] = { 0x4c, };
@@ -2870,6 +2873,8 @@
 	INGENIC_PIN_GROUP("mmc0-4bit", t31_mmc0_4bit, 0),
 	INGENIC_PIN_GROUP("mmc1-1bit", t31_mmc1_1bit, 1),
 	INGENIC_PIN_GROUP("mmc1-4bit", t31_mmc1_4bit, 1),
+	INGENIC_PIN_GROUP("mmc1-pc-1bit", t20_mmc1_1bit, 0),
+	INGENIC_PIN_GROUP("mmc1-pc-4bit", t20_mmc1_4bit, 0),
 	INGENIC_PIN_GROUP("sfc-data", t31_sfc_data, 1),
 	INGENIC_PIN_GROUP("ssi0-dt", t31_ssi0_dt, 0),
 	INGENIC_PIN_GROUP("ssi0-dr", t31_ssi0_dr, 0),
@@ -2892,7 +2897,9 @@
 	"i2c1-data-a", "i2c1-data-b", "i2c1-data-c",
 };
 static const char *t31_mmc0_groups[] = { "mmc0-1bit", "mmc0-4bit", };
-static const char *t31_mmc1_groups[] = { "mmc1-1bit", "mmc1-4bit", };
+static const char *t31_mmc1_groups[] = {
+	"mmc1-1bit", "mmc1-4bit", "mmc1-pc-1bit", "mmc1-pc-4bit",
+};
 static const char *t31_sfc_groups[] = { "sfc-data", };
 static const char *t31_ssi0_groups[] = {
 	"ssi0-dt", "ssi0-dr", "ssi0-clk", "ssi0-ce",
