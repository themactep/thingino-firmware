From: Lu-Fi <noreply@github.com>
Subject: [PATCH] ASoC: codecs: ingenic-t31-codec: add the T20

The T20 internal codec sits at the same MMIO base as the T31 one and
shares the interface registers (CGR, CACR, CDCR1/2, the CSRR rate
table, the mono bit CACR[0]), but it keeps the older T10 analog
register map: CMCR 0x0c, CAACR 0x84, CMICCR 0x88, CACR2 0x8c, CAMPCR
0x90, CAR 0x94, CHR 0x98, CHCR 0x9c, CCR 0xa0. The T31 tables would
write the wrong registers.

Add "ingenic,t20-codec" with its own power-up, ADC and DAC tables,
following the T20 branches of the vendor codec driver: precharge
(CHCR[7:6] = 1) and a CCR ramp at power-up, the built-in mic
single-ended with 1.6 * vcc bias, BST and ALC on and the fixed +20 dB
gain, the DAC with the CHCR pop control, record volume in CACR2[4:0]
(default 0x13 as the vendor enable sequence leaves it) and playback
volume in CHCR[4:0]. The vendor T20 driver has no boost or ALC knob,
so the T20 exposes only the two volume controls.

The tables, the component driver (controls) and the mixer registers
move into a per-compatible info struct. The mixer control dispatch no
longer switches on T31 register offsets, because the T20 CACR2 is at
the T31 CMICCR offset. The T31 behaviour is unchanged.

Signed-off-by: Lu-Fi <lutz@fiebach.de>
---
 sound/soc/codecs/Kconfig             |   6 +-
 sound/soc/codecs/ingenic-t31-codec.c | 248 ++++++++++++++++++++++++++---------
 2 files changed, 189 insertions(+), 65 deletions(-)

diff --git a/sound/soc/codecs/Kconfig b/sound/soc/codecs/Kconfig
index 66930131f..a29a946ad 100644
--- a/sound/soc/codecs/Kconfig
+++ b/sound/soc/codecs/Kconfig
@@ -1189,10 +1189,10 @@ config SND_SOC_INGENIC_T31_CODEC
 	depends on MACH_INGENIC || COMPILE_TEST
 	depends on OF
 	select REGMAP_MMIO
-	tristate "Ingenic T31 internal CODEC"
+	tristate "Ingenic T31/T20 internal CODEC"
 	help
-	  Enable support for the internal CODEC found in the T31 SoC from
-	  Ingenic: microphone input and DAC/headphone output with an
+	  Enable support for the internal CODEC found in the T31 and T20
+	  SoCs from Ingenic: microphone input and DAC/headphone output with an
 	  optional speaker amplifier enable GPIO.
 
 	  This driver can also be built as a module. If so, the module
diff --git a/sound/soc/codecs/ingenic-t31-codec.c b/sound/soc/codecs/ingenic-t31-codec.c
index ea71420df..edf8f61f4 100644
--- a/sound/soc/codecs/ingenic-t31-codec.c
+++ b/sound/soc/codecs/ingenic-t31-codec.c
@@ -1,9 +1,12 @@
 // SPDX-License-Identifier: GPL-2.0
 /*
- * Ingenic T31 internal audio codec
+ * Ingenic T31 and T20 internal audio codec
  *
- * The register sequences follow the vendor driver for the T31 (power-up,
- * microphone ADC and DAC/headphone-out enable/disable).  The codec is the
+ * The register sequences follow the vendor driver for the T31 and the T20
+ * (power-up, microphone ADC and DAC/headphone-out enable/disable).  Both
+ * codecs are MMIO at the same base with the same CACR/CSRR interface
+ * registers, but the T20 keeps the older (T10) analog register map, so
+ * each SoC has its own tables and mixer registers.  The codec is the
  * I2S clock provider and runs from fs * 256 supplied by the CGU.  An
  * optional external speaker amplifier enable GPIO ("speaker-enable") is
  * driven only while a playback stream is prepared.
@@ -42,6 +45,17 @@
 #define T31_CODEC_CSRR		0x110
 #define T31_CODEC_MAX_REG	0x130
 
+/* T20 (T10 layout) analog registers; CGR, CACR, CDCR1/2, CSRR as above */
+#define T20_CODEC_CMCR		0x0c
+#define T20_CODEC_CAACR		0x84
+#define T20_CODEC_CMICCR	0x88
+#define T20_CODEC_CACR2		0x8c
+#define T20_CODEC_CAMPCR	0x90
+#define T20_CODEC_CAR		0x94
+#define T20_CODEC_CHR		0x98
+#define T20_CODEC_CHCR		0x9c
+#define T20_CODEC_CCR		0xa0
+
 #define T31_RATES (SNDRV_PCM_RATE_8000 | SNDRV_PCM_RATE_12000 | \
 		   SNDRV_PCM_RATE_16000 | SNDRV_PCM_RATE_24000 | \
 		   SNDRV_PCM_RATE_32000 | SNDRV_PCM_RATE_44100 | \
@@ -54,6 +68,9 @@
 #define T31_VOL_MAX		31
 #define T31_VOL_DEFAULT		0x18
 
+/* the vendor T20 mic enable ends with CACR2[4:0] = 0x13 */
+#define T20_GAIN_DEFAULT	0x13
+
 /*
  * Where a step's value comes from.  T31_V_CONST writes .val; the others take
  * it from the codec state, so editing or reordering a table cannot silently
@@ -167,7 +184,92 @@ static const struct t31_codec_step t31_codec_dac_off[] = {
 	{ T31_CODEC_CANACR2,	4, 4, 0x00, 10 },
 };
 
+/*
+ * T20: vendor jz_t10_codec.c, CONFIG_SOC_T20 / T10-map branches.  Power-up
+ * precharges the codec (CHCR[7:6] = 1) and ramps CCR[6:0] up from 0 with
+ * CCR[7] set.
+ */
+static const struct t31_codec_step t20_codec_powerup[] = {
+	{ T31_CODEC_CGR,	0, 1, 0x00, 10 },
+	{ T31_CODEC_CGR,	0, 1, 0x03, 10 },
+	{ T20_CODEC_CMCR,	0, 7, 0x3e, 0 },
+	{ T31_CODEC_CDCR1,	0, 7, 0x10, 0 },
+	{ T31_CODEC_CDCR2,	0, 7, 0x0e, 0 },
+	{ T20_CODEC_CHCR,	6, 7, 0x01, 10 },
+	{ T20_CODEC_CCR,	7, 7, 0x01, 10 },
+	{ T20_CODEC_CCR,	0, 6, 0x00, 30 },
+	{ T20_CODEC_CCR,	0, 6, 0x01, 30 },
+	{ T20_CODEC_CCR,	0, 6, 0x03, 30 },
+	{ T20_CODEC_CCR,	0, 6, 0x07, 30 },
+	{ T20_CODEC_CCR,	0, 6, 0x0f, 30 },
+	{ T20_CODEC_CCR,	0, 6, 0x1f, 30 },
+	{ T20_CODEC_CCR,	0, 6, 0x3f, 20 },
+};
+
+/* built-in mic, single-ended, bias 1.6 * vcc, BST + ALC, fixed +20 dB */
+static const struct t31_codec_step t20_codec_adc_on[] = {
+	{ T31_CODEC_CACR,	5, 6, 0x00, 10 },
+	{ T31_CODEC_CACR,	3, 4, 0x02, 10 },
+	{ T31_CODEC_CACR,	0, 0, 0x01, 10, T31_V_MONO },
+	{ T20_CODEC_CMCR,	0, 7, 0x3e, 20 },
+	{ T20_CODEC_CACR2,	0, 4, 0x0c, 10 },
+	{ T20_CODEC_CACR2,	5, 5, 0x01, 10 },
+	{ T20_CODEC_CAACR,	7, 7, 0x01, 10 },
+	{ T20_CODEC_CAACR,	6, 6, 0x01, 10 },
+	{ T20_CODEC_CAACR,	0, 2, 0x06, 10 },
+	{ T20_CODEC_CAMPCR,	7, 7, 0x01, 10 },
+	{ T20_CODEC_CMICCR,	6, 6, 0x01, 10 },
+	{ T20_CODEC_CMICCR,	0, 0, 0x01, 10 },
+	{ T20_CODEC_CAMPCR,	6, 6, 0x01, 10 },
+	{ T20_CODEC_CAMPCR,	5, 5, 0x01, 10 },
+	{ T20_CODEC_CMICCR,	1, 1, 0x01, 10 },
+	{ T20_CODEC_CMICCR,	4, 4, 0x01, 10 },
+	{ T20_CODEC_CAACR,	5, 5, 0x01, 10 },
+	{ T20_CODEC_CACR2,	0, 4, 0x13, 10, T31_V_GAIN },
+	{ T20_CODEC_CMICCR,	5, 5, 0x01, 10 },
+};
+
+static const struct t31_codec_step t20_codec_adc_off[] = {
+	{ T20_CODEC_CAMPCR,	5, 7, 0x00, 0 },
+};
+
+/* DAC and headphone/speaker out, with the CHCR pop control */
+static const struct t31_codec_step t20_codec_dac_on[] = {
+	{ T20_CODEC_CAACR,	6, 7, 0x03, 10 },
+	{ T20_CODEC_CAR,	6, 6, 0x01, 10 },
+	{ T20_CODEC_CAR,	5, 5, 0x01, 10 },
+	{ T20_CODEC_CHCR,	6, 7, 0x02, 10 },
+	{ T20_CODEC_CAR,	3, 3, 0x01, 10 },
+	{ T20_CODEC_CAR,	2, 2, 0x01, 10 },
+	{ T20_CODEC_CAR,	1, 1, 0x01, 10 },
+	{ T20_CODEC_CAR,	0, 0, 0x01, 10 },
+	{ T20_CODEC_CHR,	7, 7, 0x01, 10 },
+	{ T20_CODEC_CHR,	6, 6, 0x01, 10 },
+	{ T20_CODEC_CHR,	5, 5, 0x01, 20 },
+	{ T20_CODEC_CHCR,	0, 4, 0x18, 0, T31_V_VOL },
+};
+
+static const struct t31_codec_step t20_codec_dac_off[] = {
+	{ T20_CODEC_CAR,	0, 3, 0x00, 0 },
+};
+
+struct t31_codec_seq {
+	const struct t31_codec_step *s;
+	unsigned int n;
+};
+
+#define T31_SEQ(t)	{ t, ARRAY_SIZE(t) }
+
+struct t31_codec_info {
+	struct t31_codec_seq powerup, adc_on, adc_off, dac_on, dac_off;
+	const struct snd_soc_component_driver *component;
+	unsigned int gain_reg;	/* "Mic Capture Volume", [4:0] */
+	unsigned int vol_reg;	/* "Master Playback Volume", [4:0] */
+	unsigned int gain_default;
+};
+
 struct t31_codec {
+	const struct t31_codec_info *info;
 	struct regmap *regmap;
 	struct gpio_desc *amp;
 	struct mutex lock;
@@ -182,10 +284,10 @@ struct t31_codec {
 	unsigned int alc;
 };
 
-static int t31_codec_run(struct t31_codec *c, const struct t31_codec_step *s,
-			 unsigned int n)
+static int t31_codec_run(struct t31_codec *c, const struct t31_codec_seq *seq)
 {
-	unsigned int i, val;
+	const struct t31_codec_step *s = seq->s;
+	unsigned int i, n = seq->n, val;
 	int ret;
 
 	for (i = 0; i < n; i++, s++) {
@@ -248,8 +350,7 @@ static int t31_codec_startup(struct snd_pcm_substream *substream,
 
 	mutex_lock(&c->lock);
 	if (!c->powered) {
-		ret = t31_codec_run(c, t31_codec_powerup,
-				    ARRAY_SIZE(t31_codec_powerup));
+		ret = t31_codec_run(c, &c->info->powerup);
 		if (!ret)
 			c->powered = true;
 	}
@@ -288,8 +389,7 @@ static int t31_codec_prepare(struct snd_pcm_substream *substream,
 	ret = regmap_update_bits(c->regmap, T31_CODEC_CSRR, GENMASK(2, 0), bits);
 	if (!ret && substream->stream == SNDRV_PCM_STREAM_PLAYBACK) {
 		if (!c->dac_on) {
-			ret = t31_codec_run(c, t31_codec_dac_on,
-					    ARRAY_SIZE(t31_codec_dac_on));
+			ret = t31_codec_run(c, &c->info->dac_on);
 			if (!ret) {
 				c->dac_on = true;
 				/* the amplifier is switched on last (vendor order) */
@@ -301,8 +401,7 @@ static int t31_codec_prepare(struct snd_pcm_substream *substream,
 		ret = regmap_update_bits(c->regmap, T31_CODEC_CACR, BIT(0),
 					 c->channels == 1);
 	else if (!ret) {
-		ret = t31_codec_run(c, t31_codec_adc_on,
-				    ARRAY_SIZE(t31_codec_adc_on));
+		ret = t31_codec_run(c, &c->info->adc_on);
 		if (!ret)
 			c->adc_on = true;
 	}
@@ -321,13 +420,11 @@ static void t31_codec_shutdown(struct snd_pcm_substream *substream,
 		if (c->dac_on) {
 			/* the amplifier is switched off first (vendor order) */
 			gpiod_set_value_cansleep(c->amp, 0);
-			t31_codec_run(c, t31_codec_dac_off,
-				      ARRAY_SIZE(t31_codec_dac_off));
+			t31_codec_run(c, &c->info->dac_off);
 			c->dac_on = false;
 		}
 	} else if (c->adc_on) {
-		t31_codec_run(c, t31_codec_adc_off,
-			      ARRAY_SIZE(t31_codec_adc_off));
+		t31_codec_run(c, &c->info->adc_off);
 		c->adc_on = false;
 	}
 	mutex_unlock(&c->lock);
@@ -361,6 +458,23 @@ static struct snd_soc_dai_driver t31_codec_dai = {
 	.symmetric_rate = 1,
 };
 
+/*
+ * Map a mixer control to its state field.  Registers differ per SoC (the
+ * T20 CACR2 is at the T31 CMICCR offset), so the per-SoC gain/volume
+ * registers are matched first.
+ */
+static unsigned int *t31_codec_ctl_state(struct t31_codec *c,
+					 const struct soc_mixer_control *mc)
+{
+	if (mc->reg == c->info->gain_reg)
+		return &c->gain;
+	if (mc->reg == c->info->vol_reg)
+		return &c->vol;
+	if (mc->reg == T31_CODEC_CMICGAINR)
+		return &c->boost;
+	return &c->alc;
+}
+
 /*
  * The mixer values are kept in the driver state and written to the codec
  * only while the ADC is on (before that the registers do not stick); the
@@ -372,23 +486,8 @@ static int t31_codec_ctl_get(struct snd_kcontrol *kc,
 	struct snd_soc_component *comp = snd_kcontrol_chip(kc);
 	struct t31_codec *c = snd_soc_component_get_drvdata(comp);
 	struct soc_mixer_control *mc = (struct soc_mixer_control *)kc->private_value;
-	unsigned int v;
-
-	switch (mc->reg) {
-	case T31_CODEC_CALCGR:
-		v = c->gain;
-		break;
-	case T31_CODEC_CMICGAINR:
-		v = c->boost;
-		break;
-	case T31_CODEC_CHR:
-		v = c->vol;
-		break;
-	default:
-		v = c->alc;
-		break;
-	}
-	uc->value.integer.value[0] = v;
+
+	uc->value.integer.value[0] = *t31_codec_ctl_state(c, mc);
 
 	return 0;
 }
@@ -400,42 +499,21 @@ static int t31_codec_ctl_put(struct snd_kcontrol *kc,
 	struct t31_codec *c = snd_soc_component_get_drvdata(comp);
 	struct soc_mixer_control *mc = (struct soc_mixer_control *)kc->private_value;
 	unsigned int v = uc->value.integer.value[0];
-	unsigned int *state, mask, shift;
+	unsigned int *state = t31_codec_ctl_state(c, mc);
+	/* every field is 2^k - 1 wide: [4:0], [7:6] or a single bit */
+	unsigned int shift = mc->shift, mask = mc->max << shift;
 	int ret = 0;
 
 	if (v > mc->max)
 		return -EINVAL;
 
-	switch (mc->reg) {
-	case T31_CODEC_CALCGR:
-		state = &c->gain;
-		mask = GENMASK(4, 0);
-		shift = 0;
-		break;
-	case T31_CODEC_CMICGAINR:
-		state = &c->boost;
-		mask = GENMASK(7, 6);
-		shift = 6;
-		break;
-	case T31_CODEC_CHR:
-		state = &c->vol;
-		mask = GENMASK(4, 0);
-		shift = 0;
-		break;
-	default:
-		state = &c->alc;
-		mask = BIT(4);
-		shift = 4;
-		break;
-	}
-
 	mutex_lock(&c->lock);
 	if (*state == v) {
 		mutex_unlock(&c->lock);
 		return 0;
 	}
 	*state = v;
-	if (mc->reg == T31_CODEC_CHR ? c->dac_on : c->adc_on)
+	if (state == &c->vol ? c->dac_on : c->adc_on)
 		ret = regmap_update_bits(c->regmap, mc->reg, mask, v << shift);
 	mutex_unlock(&c->lock);
 
@@ -456,6 +534,15 @@ static const struct snd_kcontrol_new t31_codec_controls[] = {
 		       T31_VOL_MAX, 0, t31_codec_ctl_get, t31_codec_ctl_put),
 };
 
+/* the vendor T20 driver has no boost or ALC knob (both fixed on) */
+static const struct snd_kcontrol_new t20_codec_controls[] = {
+	SOC_SINGLE_EXT_TLV("Mic Capture Volume", T20_CODEC_CACR2, 0,
+			   T31_GAIN_MAX, 0, t31_codec_ctl_get,
+			   t31_codec_ctl_put, t31_codec_gain_tlv),
+	SOC_SINGLE_EXT("Master Playback Volume", T20_CODEC_CHCR, 0,
+		       T31_VOL_MAX, 0, t31_codec_ctl_get, t31_codec_ctl_put),
+};
+
 /*
  * System sleep: drop the speaker amplifier while suspended so it cannot
  * stay on with a playback stream open, and raise it again on resume.
@@ -495,6 +582,38 @@ static const struct snd_soc_component_driver t31_codec_component = {
 	.endianness		= 1,
 };
 
+static const struct snd_soc_component_driver t20_codec_component = {
+	.suspend		= t31_codec_suspend,
+	.resume			= t31_codec_resume,
+	.controls		= t20_codec_controls,
+	.num_controls		= ARRAY_SIZE(t20_codec_controls),
+	.endianness		= 1,
+};
+
+static const struct t31_codec_info t31_codec_info = {
+	.powerup	= T31_SEQ(t31_codec_powerup),
+	.adc_on		= T31_SEQ(t31_codec_adc_on),
+	.adc_off	= T31_SEQ(t31_codec_adc_off),
+	.dac_on		= T31_SEQ(t31_codec_dac_on),
+	.dac_off	= T31_SEQ(t31_codec_dac_off),
+	.component	= &t31_codec_component,
+	.gain_reg	= T31_CODEC_CALCGR,
+	.vol_reg	= T31_CODEC_CHR,
+	.gain_default	= T31_GAIN_DEFAULT,
+};
+
+static const struct t31_codec_info t20_codec_info = {
+	.powerup	= T31_SEQ(t20_codec_powerup),
+	.adc_on		= T31_SEQ(t20_codec_adc_on),
+	.adc_off	= T31_SEQ(t20_codec_adc_off),
+	.dac_on		= T31_SEQ(t20_codec_dac_on),
+	.dac_off	= T31_SEQ(t20_codec_dac_off),
+	.component	= &t20_codec_component,
+	.gain_reg	= T20_CODEC_CACR2,
+	.vol_reg	= T20_CODEC_CHCR,
+	.gain_default	= T20_GAIN_DEFAULT,
+};
+
 static const struct regmap_config t31_codec_regmap_config = {
 	.reg_bits	= 32,
 	.reg_stride	= 4,
@@ -514,6 +633,10 @@ static int t31_codec_probe(struct platform_device *pdev)
 	if (!c)
 		return -ENOMEM;
 
+	c->info = of_device_get_match_data(dev);
+	if (!c->info)
+		return -ENODEV;
+
 	regs = devm_platform_ioremap_resource(pdev, 0);
 	if (IS_ERR(regs))
 		return PTR_ERR(regs);
@@ -534,19 +657,20 @@ static int t31_codec_probe(struct platform_device *pdev)
 
 	mutex_init(&c->lock);
 	c->vol = T31_VOL_DEFAULT;
-	c->gain = T31_GAIN_DEFAULT;
+	c->gain = c->info->gain_default;
 	c->boost = T31_BOOST_DEFAULT;
 	c->alc = 1;
 	c->rate = 16000;
 	c->channels = 1;
 	platform_set_drvdata(pdev, c);
 
-	return devm_snd_soc_register_component(dev, &t31_codec_component,
+	return devm_snd_soc_register_component(dev, c->info->component,
 					       &t31_codec_dai, 1);
 }
 
 static const struct of_device_id t31_codec_of_match[] = {
-	{ .compatible = "ingenic,t31-codec" },
+	{ .compatible = "ingenic,t20-codec", .data = &t20_codec_info },
+	{ .compatible = "ingenic,t31-codec", .data = &t31_codec_info },
 	{ /* sentinel */ }
 };
 MODULE_DEVICE_TABLE(of, t31_codec_of_match);
@@ -560,5 +684,5 @@ static struct platform_driver t31_codec_driver = {
 };
 module_platform_driver(t31_codec_driver);
 
-MODULE_DESCRIPTION("Ingenic T31 internal codec");
+MODULE_DESCRIPTION("Ingenic T31/T20 internal codec");
 MODULE_LICENSE("GPL");
