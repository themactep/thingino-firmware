From: Paul Philippov <paul@themactep.com>
Subject: [PATCH] media: videobuf2: add a selectable DMA-contig switch

VIDEOBUF2_DMA_CONTIG has no prompt, so an out-of-tree V4L2 driver
cannot enable it from a config fragment. Add a small Thingino switch
that selects it, for the recovered T41 TX-ISP V4L2 frontend.

Signed-off-by: Paul Philippov <paul@themactep.com>
---
--- a/drivers/media/common/videobuf2/Kconfig
+++ b/drivers/media/common/videobuf2/Kconfig
@@ -13,6 +13,10 @@
 	tristate
 	default y if MEDIA_SUPPORT
 
+config VIDEOBUF2_DMA_CONTIG_THINGINO
+	bool "Enable the videobuf2 DMA contiguous allocator for TX-ISP"
+	select VIDEOBUF2_DMA_CONTIG
+
 config VIDEOBUF2_DMA_CONTIG
 	tristate
 	select VIDEOBUF2_CORE
