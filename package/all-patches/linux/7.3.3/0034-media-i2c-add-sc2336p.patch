+#define SC2336P_CHIP_ID_L			0x3a
+
+#define SC2336P_REG_CHIP_ID_H			CCI_REG8(0x3107)
+#define SC2336P_REG_CHIP_ID_L			CCI_REG8(0x3108)
+
+#define SC2336P_REG_SOFTWARE_RESET		CCI_REG8(0x0103)
+#define SC2336P_REG_STREAM			CCI_REG8(0x0100)
+
+/* HTS/VTS are big-endian 16-bit values. */
+#define SC2336P_REG_HTS				CCI_REG16(0x320c)
+#define SC2336P_REG_VTS				CCI_REG16(0x320e)
+
+/*
+ * Exposure is a 20-bit value in units of 1/16 line, laid out
+ * big-endian over 0x3e00..0x3e02.
+ */
