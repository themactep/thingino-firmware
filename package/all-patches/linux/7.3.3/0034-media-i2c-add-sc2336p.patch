+
+static const struct sc2336p_mode sc2336p_modes[] = {
+	{
+		.width = SC2336P_NATIVE_WIDTH,
+		.height = SC2336P_NATIVE_HEIGHT,
+		.hblank = SC2336P_HTS_MIN - SC2336P_NATIVE_WIDTH,
+		.vblank = 1200 - SC2336P_NATIVE_HEIGHT,
+		.regs = sc2336p_1080p30_regs,
+		.regs_num = ARRAY_SIZE(sc2336p_1080p30_regs),
+	},
+};
+
+struct sc2336p_ctrls {
+	struct v4l2_ctrl_handler handler;
+	struct v4l2_ctrl *pixel_rate;
+	struct v4l2_ctrl *link_freq;
+	struct v4l2_ctrl *hblank;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *gain;
+	struct v4l2_ctrl *hflip;
+	struct v4l2_ctrl *vflip;
+};
+
+struct sc2336p {
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+
+	struct regmap *regmap;
+	struct clk *xclk;
+
+	struct gpio_desc *reset_gpio;
+	struct gpio_desc *powerdown_gpio;
+	struct regulator_bulk_data supplies[3];
+
+	struct sc2336p_ctrls ctrls;
+
+	const struct sc2336p_mode *mode;
+};
+
+static inline struct sc2336p *to_sc2336p(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct sc2336p, sd);
+}
+
+static inline struct v4l2_subdev *sc2336p_ctrl_to_sd(struct v4l2_ctrl *ctrl)
+{
+	return &container_of(ctrl->handler, struct sc2336p, ctrls.handler)->sd;
+}
+
+static void sc2336p_fill_format(const struct sc2336p_mode *mode,
+			       struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->code = MEDIA_BUS_FMT_SBGGR10_1X10;
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	fmt->quantization = V4L2_QUANTIZATION_DEFAULT;
+	fmt->xfer_func = V4L2_XFER_FUNC_DEFAULT;
+}
+
+static int sc2336p_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct v4l2_mbus_framefmt *fmt;
+	struct v4l2_rect *crop;
+
+	fmt = v4l2_subdev_state_get_format(state, 0);
+	sc2336p_fill_format(&sc2336p_modes[0], fmt);
+
+	crop = v4l2_subdev_state_get_crop(state, 0);
+	crop->left = 0;
+	crop->top = 0;
+	crop->width = sc2336p_modes[0].width;
+	crop->height = sc2336p_modes[0].height;
+
+	return 0;
+}
+
+static int sc2336p_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index != 0)
+		return -EINVAL;
+
+	code->code = MEDIA_BUS_FMT_SBGGR10_1X10;
+
+	return 0;
+}
+
+static int sc2336p_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index >= ARRAY_SIZE(sc2336p_modes))
+		return -EINVAL;
+
+	if (fse->code != MEDIA_BUS_FMT_SBGGR10_1X10)
+		return -EINVAL;
+
+	fse->min_width = sc2336p_modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = sc2336p_modes[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+static int sc2336p_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		sel->r = *v4l2_subdev_state_get_crop(state, 0);
+		return 0;
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = SC2336P_NATIVE_WIDTH;
+		sel->r.height = SC2336P_NATIVE_HEIGHT;
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static int sc2336p_set_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct sc2336p *sc2336p = to_sc2336p(sd);
+	const struct sc2336p_mode *mode;
+	struct v4l2_mbus_framefmt *framefmt;
+	struct v4l2_rect *crop;
+
+	mode = v4l2_find_nearest_size(sc2336p_modes, ARRAY_SIZE(sc2336p_modes),
+				      width, height,
+				      fmt->format.width, fmt->format.height);
+
+	sc2336p_fill_format(mode, &fmt->format);
+	framefmt = v4l2_subdev_state_get_format(state, fmt->pad);
+	*framefmt = fmt->format;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_ACTIVE) {
+		sc2336p->mode = mode;
+		__v4l2_ctrl_s_ctrl(sc2336p->ctrls.hblank, mode->hblank);
+		__v4l2_ctrl_s_ctrl(sc2336p->ctrls.vblank, mode->vblank);
+	}
+
+	crop = v4l2_subdev_state_get_crop(state, fmt->pad);
+	crop->left = 0;
+	crop->top = 0;
+	crop->width = mode->width;
+	crop->height = mode->height;
+
+	return 0;
+}
+
+static void sc2336p_exposure_update(struct sc2336p *sc2336p)
+{
+	unsigned int exposure_max;
+
+	exposure_max = sc2336p->ctrls.vblank->val + sc2336p->mode->height -
+		       SC2336P_EXPOSURE_OFFSET;
+	exposure_max = min(exposure_max, 0xfffffU);
+
+	__v4l2_ctrl_modify_range(sc2336p->ctrls.exposure, 1, exposure_max, 1,
+				 exposure_max);
+}
+
+static int sc2336p_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct sc2336p *sc2336p = to_sc2336p(sc2336p_ctrl_to_sd(ctrl));
+
+	dev_dbg(sc2336p->sd.dev, "sc2336p: ctrl 0x%x = %d\n", ctrl->id, ctrl->val);
+	u32 hts;
+	int ret = 0;
+
+	if (ctrl->flags & V4L2_CTRL_FLAG_READ_ONLY)
+		return 0;
+
+	if (ctrl->id == V4L2_CID_VBLANK)
+		sc2336p_exposure_update(sc2336p);
+
+	if (!pm_runtime_get_if_in_use(sc2336p->sd.dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		ret = cci_write(sc2336p->regmap, SC2336P_REG_EXPOSURE,
+				(u32)ctrl->val << 4, NULL);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		ret = cci_write(sc2336p->regmap, SC2336P_REG_GAIN_COARSE,
+				sc2336p_gains[ctrl->val] >> 8, NULL);
+		ret = cci_write(sc2336p->regmap, SC2336P_REG_GAIN_FINE,
+				sc2336p_gains[ctrl->val] & 0xff, &ret);
+		break;
+	case V4L2_CID_HBLANK:
+		hts = ctrl->val + sc2336p->mode->width;
+		ret = cci_write(sc2336p->regmap, SC2336P_REG_HTS, hts, NULL);
+		break;
+	case V4L2_CID_VBLANK:
+		ret = cci_write(sc2336p->regmap, SC2336P_REG_VTS,
+				ctrl->val + sc2336p->mode->height, NULL);
+		break;
+	case V4L2_CID_HFLIP:
+		ret = cci_update_bits(sc2336p->regmap, SC2336P_REG_FLIP,
+				      SC2336P_FLIP_MIRROR,
+				      ctrl->val ? SC2336P_FLIP_MIRROR : 0, NULL);
+		break;
+	case V4L2_CID_VFLIP:
+		ret = cci_update_bits(sc2336p->regmap, SC2336P_REG_FLIP,
+				      SC2336P_FLIP_VFLIP,
+				      ctrl->val ? SC2336P_FLIP_VFLIP : 0, NULL);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put_autosuspend(sc2336p->sd.dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops sc2336p_ctrl_ops = {
+	.s_ctrl = sc2336p_set_ctrl,
+};
+
+static int sc2336p_init_controls(struct sc2336p *sc2336p)
+{
+	struct v4l2_ctrl_handler *hdl = &sc2336p->ctrls.handler;
+	struct v4l2_fwnode_device_properties props;
+	const struct v4l2_ctrl_ops *ops = &sc2336p_ctrl_ops;
+	unsigned int hblank_max = SC2336P_HTS_MAX - SC2336P_NATIVE_WIDTH;
+	unsigned int vblank_max = SC2336P_VTS_MAX - SC2336P_NATIVE_HEIGHT;
+	int ret;
+
+	ret = v4l2_ctrl_handler_init(hdl, 10);
+	if (ret)
+		return ret;
+
+	sc2336p->ctrls.pixel_rate =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_PIXEL_RATE,
+				  SC2336P_PIXEL_RATE, SC2336P_PIXEL_RATE, 1,
+				  SC2336P_PIXEL_RATE);
+
+	sc2336p->ctrls.link_freq =
+		v4l2_ctrl_new_int_menu(hdl, ops, V4L2_CID_LINK_FREQ, 0, 0,
+				       sc2336p_link_freqs);
+	if (sc2336p->ctrls.link_freq)
+		sc2336p->ctrls.link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	sc2336p->ctrls.exposure =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_EXPOSURE, 1,
+				  sc2336p_modes[0].vblank +
+				  sc2336p_modes[0].height -
+				  SC2336P_EXPOSURE_OFFSET, 1,
+				  sc2336p_modes[0].vblank +
+				  sc2336p_modes[0].height -
+				  SC2336P_EXPOSURE_OFFSET);
+
+	sc2336p->ctrls.gain =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_ANALOGUE_GAIN, 0,
+				  ARRAY_SIZE(sc2336p_gains) - 1, 1, 0);
+
+	sc2336p->ctrls.hblank =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_HBLANK,
+				  SC2336P_HTS_MIN - SC2336P_NATIVE_WIDTH,
+				  hblank_max, 1,
+				  sc2336p_modes[0].hblank);
+
+	sc2336p->ctrls.vblank =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_VBLANK,
+				  sc2336p_modes[0].vblank, vblank_max, 1,
+				  sc2336p_modes[0].vblank);
+
+	sc2336p->ctrls.hflip = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_HFLIP,
+						0, 1, 1, 0);
+	sc2336p->ctrls.vflip = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_VFLIP,
+						0, 1, 1, 0);
+	v4l2_ctrl_cluster(2, &sc2336p->ctrls.hflip);
+
+	if (hdl->error) {
+		ret = hdl->error;
+		goto error;
+	}
+
+	ret = v4l2_fwnode_device_parse(sc2336p->sd.dev, &props);
+	if (ret)
+		goto error;
+
+	ret = v4l2_ctrl_new_fwnode_properties(hdl, ops, &props);
+	if (ret)
+		goto error;
+
+	sc2336p->sd.ctrl_handler = hdl;
+
+	return 0;
+
+error:
+	v4l2_ctrl_handler_free(hdl);
+
+	return ret;
+}
+
+static int sc2336p_check_hwcfg(struct device *dev)
+{
+	struct v4l2_fwnode_endpoint ep = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	struct fwnode_handle *endpoint;
+	unsigned int i;
+	int ret;
+
+	endpoint = fwnode_graph_get_next_endpoint(dev_fwnode(dev), NULL);
+	if (!endpoint) {
+		dev_err(dev, "endpoint node not found\n");
+		return -EINVAL;
+	}
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(endpoint, &ep);
+	fwnode_handle_put(endpoint);
+	if (ret)
+		return ret;
+
+	if (ep.bus.mipi_csi2.num_data_lanes != 2) {
+		dev_err(dev, "only 2 data lanes are currently supported\n");
+		ret = -EINVAL;
+		goto out;
+	}
+
+	if (!ep.nr_of_link_frequencies) {
+		dev_err(dev, "link-frequency property not found in DT\n");
+		ret = -EINVAL;
+		goto out;
+	}
+
+	for (i = 0; i < ep.nr_of_link_frequencies; i++) {
+		if (ep.link_frequencies[i] == SC2336P_LINK_FREQ)
+			break;
+	}
+
+	if (i == ep.nr_of_link_frequencies) {
+		dev_err(dev, "expected link frequency %u\n", SC2336P_LINK_FREQ);
+		ret = -EINVAL;
+	}
+
+out:
+	v4l2_fwnode_endpoint_free(&ep);
+
+	return ret;
+}
+
+static int sc2336p_power_on(struct device *dev)
+{
+	dev_dbg(dev, "sc2336p: power on\n");
+	struct sc2336p *sc2336p = to_sc2336p(dev_get_drvdata(dev));
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(sc2336p->supplies),
+				    sc2336p->supplies);
+	if (ret)
+		return ret;
+
+	ret = clk_prepare_enable(sc2336p->xclk);
+	if (ret)
+		goto err_regulators;
+
+	/* The sensor needs MCLK while reset is released. */
+	gpiod_set_value_cansleep(sc2336p->powerdown_gpio, 0);
+	gpiod_set_value_cansleep(sc2336p->reset_gpio, 0);
+	msleep(20);
+
+	return 0;
+
+err_regulators:
+	regulator_bulk_disable(ARRAY_SIZE(sc2336p->supplies), sc2336p->supplies);
+
+	return ret;
+}
+
+static int sc2336p_power_off(struct device *dev)
+{
+	dev_dbg(dev, "sc2336p: power off\n");
+	struct sc2336p *sc2336p = to_sc2336p(dev_get_drvdata(dev));
+
+	gpiod_set_value_cansleep(sc2336p->reset_gpio, 1);
+	gpiod_set_value_cansleep(sc2336p->powerdown_gpio, 1);
+	clk_disable_unprepare(sc2336p->xclk);
+	regulator_bulk_disable(ARRAY_SIZE(sc2336p->supplies), sc2336p->supplies);
+
+	return 0;
+}
+
+static int sc2336p_identify_module(struct sc2336p *sc2336p)
+{
+	u64 id_h, id_l;
+	int ret;
+
+	ret = cci_read(sc2336p->regmap, SC2336P_REG_CHIP_ID_H, &id_h, NULL);
+	if (ret)
+		return ret;
+
+	ret = cci_read(sc2336p->regmap, SC2336P_REG_CHIP_ID_L, &id_l, NULL);
+	if (ret)
+		return ret;
+
+	if (id_h != SC2336P_CHIP_ID_H || id_l != SC2336P_CHIP_ID_L) {
+		dev_err(sc2336p->sd.dev, "chip id mismatch: %x%x != %x%x\n",
+			(u8)id_h, (u8)id_l, SC2336P_CHIP_ID_H, SC2336P_CHIP_ID_L);
+		return -EIO;
+	}
+
+	dev_info(sc2336p->sd.dev, "sc2336p: chip id %02x%02x\n", (u8)id_h, (u8)id_l);
+	return 0;
+}
+
+static int sc2336p_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state, u32 pad,
+				 u64 streams_mask)
+{
+	struct sc2336p *sc2336p = to_sc2336p(sd);
+
+	dev_info(sd->dev, "sc2336p: stream on\n");
+	int ret;
+
+	ret = pm_runtime_resume_and_get(sd->dev);
+	if (ret)
+		return ret;
+
+	cci_multi_reg_write(sc2336p->regmap, sc2336p->mode->regs,
+			    sc2336p->mode->regs_num, &ret);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = __v4l2_ctrl_handler_setup(&sc2336p->ctrls.handler);
+	if (ret)
+		goto err_rpm_put;
+
+	cci_write(sc2336p->regmap, SC2336P_REG_STREAM, SC2336P_STREAM_ON, &ret);
+	if (ret)
+		goto err_rpm_put;
+
+	return 0;
+
+err_rpm_put:
+	pm_runtime_put_autosuspend(sd->dev);
+
+	return ret;
+}
+
+static int sc2336p_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	dev_info(sd->dev, "sc2336p: stream off\n");
+	struct sc2336p *sc2336p = to_sc2336p(sd);
+	int ret = 0;
+
+	cci_write(sc2336p->regmap, SC2336P_REG_STREAM, 0x00, &ret);
+	if (ret)
+		dev_err(sd->dev, "failed to stop streaming: %d\n", ret);
+
+	pm_runtime_put_autosuspend(sd->dev);
+
+	return ret;
+}
+
+static const struct v4l2_subdev_video_ops sc2336p_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops sc2336p_pad_ops = {
+	.enum_mbus_code = sc2336p_enum_mbus_code,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = sc2336p_set_pad_format,
+	.get_selection = sc2336p_get_selection,
+	.enum_frame_size = sc2336p_enum_frame_size,
+	.enable_streams = sc2336p_enable_streams,
+	.disable_streams = sc2336p_disable_streams,
+};
+
+static const struct v4l2_subdev_ops sc2336p_subdev_ops = {
+	.video = &sc2336p_video_ops,
+	.pad = &sc2336p_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops sc2336p_subdev_internal_ops = {
+	.init_state = sc2336p_init_state,
+};
+
+static const char * const sc2336p_supply_names[] = {
+	"iovdd",
+	"avdd",
+	"dvdd",
+};
+
+static int sc2336p_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+
+	dev_info(dev, "sc2336p: probe at i2c 0x%02x\n", client->addr);
+	struct sc2336p *sc2336p;
+	unsigned int i;
+	unsigned long xclk_freq;
+	int ret;
+
+	sc2336p = devm_kzalloc(dev, sizeof(*sc2336p), GFP_KERNEL);
+	if (!sc2336p)
+		return -ENOMEM;
+
+	v4l2_i2c_subdev_init(&sc2336p->sd, client, &sc2336p_subdev_ops);
+	sc2336p->sd.internal_ops = &sc2336p_subdev_internal_ops;
+
+	ret = sc2336p_check_hwcfg(dev);
+	if (ret)
+		return ret;
+
+	sc2336p->xclk = devm_v4l2_sensor_clk_get(dev, NULL);
+	if (IS_ERR(sc2336p->xclk))
+		return dev_err_probe(dev, PTR_ERR(sc2336p->xclk),
+				     "failed to get xclk\n");
+
+	xclk_freq = clk_get_rate(sc2336p->xclk);
+	if (xclk_freq != SC2336P_XCLK_FREQ)
+		return dev_err_probe(dev, -EINVAL,
+				     "xclk frequency %lu Hz not supported\n",
+				     xclk_freq);
+
+	for (i = 0; i < ARRAY_SIZE(sc2336p->supplies); i++)
+		sc2336p->supplies[i].supply = sc2336p_supply_names[i];
+
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(sc2336p->supplies),
+				      sc2336p->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get regulators\n");
+
+	sc2336p->reset_gpio = devm_gpiod_get_optional(dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(sc2336p->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(sc2336p->reset_gpio),
+				     "failed to get reset gpio\n");
+
+	sc2336p->powerdown_gpio = devm_gpiod_get_optional(dev, "powerdown",
+							 GPIOD_OUT_HIGH);
+	if (IS_ERR(sc2336p->powerdown_gpio))
+		return dev_err_probe(dev, PTR_ERR(sc2336p->powerdown_gpio),
+				     "failed to get powerdown gpio\n");
+
+	sc2336p->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(sc2336p->regmap))
+		return dev_err_probe(dev, PTR_ERR(sc2336p->regmap),
+				     "failed to get cci regmap\n");
+
+	ret = sc2336p_power_on(dev);
+	if (ret)
+		return ret;
+
+	ret = sc2336p_identify_module(sc2336p);
+	if (ret)
+		goto err_power_off;
+
+	sc2336p->mode = &sc2336p_modes[0];
+
+	ret = sc2336p_init_controls(sc2336p);
+	if (ret)
+		goto err_power_off;
+
+	sc2336p->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	sc2336p->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	sc2336p->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&sc2336p->sd.entity, 1, &sc2336p->pad);
+	if (ret)
+		goto err_handler_free;
+
+	sc2336p->sd.state_lock = sc2336p->ctrls.handler.lock;
+	ret = v4l2_subdev_init_finalize(&sc2336p->sd);
+	if (ret)
+		goto err_media_entity;
+
+	pm_runtime_set_active(dev);
+	pm_runtime_get_noresume(dev);
+	pm_runtime_enable(dev);
+	pm_runtime_set_autosuspend_delay(dev, 1000);
+	pm_runtime_use_autosuspend(dev);
+	pm_runtime_put_autosuspend(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&sc2336p->sd);
+	if (ret)
+		goto err_subdev_cleanup;
+
+	return 0;
+
+err_subdev_cleanup:
+	v4l2_subdev_cleanup(&sc2336p->sd);
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+err_media_entity:
+	media_entity_cleanup(&sc2336p->sd.entity);
+err_handler_free:
+	v4l2_ctrl_handler_free(&sc2336p->ctrls.handler);
+err_power_off:
+	sc2336p_power_off(dev);
+
+	return ret;
+}
+
+static void sc2336p_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct sc2336p *sc2336p = to_sc2336p(sd);
+
+	v4l2_subdev_cleanup(sd);
+	v4l2_async_unregister_subdev(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&sc2336p->ctrls.handler);
+
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev))
+		sc2336p_power_off(&client->dev);
+	pm_runtime_set_suspended(&client->dev);
+}
+
+static const struct of_device_id sc2336p_dt_ids[] = {
+	{ .compatible = "smartens,sc2336p" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, sc2336p_dt_ids);
+
+static const struct i2c_device_id sc2336p_id[] = {
+	{ .name = "sc2336p" },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, sc2336p_id);
+
+static const struct dev_pm_ops sc2336p_pm_ops = {
+	RUNTIME_PM_OPS(sc2336p_power_off, sc2336p_power_on, NULL)
+};
+
+static struct i2c_driver sc2336p_i2c_driver = {
+	.driver = {
+		.name = "sc2336p",
+		.of_match_table = sc2336p_dt_ids,
+		.pm = pm_ptr(&sc2336p_pm_ops),
+	},
+	.id_table = sc2336p_id,
+	.probe = sc2336p_probe,
+	.remove = sc2336p_remove,
+};
+
+module_i2c_driver(sc2336p_i2c_driver);
+
+MODULE_DESCRIPTION("SmartSens SC2336P sensor driver");
+MODULE_LICENSE("GPL");
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/i2c/smartens,sc2336p.yaml
@@ -0,0 +1,105 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/smartens,sc2336p.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: SmartSens SC2336P 1920x1080 CMOS Image Sensor
+
+maintainers:
+  - Paul Philippov <paul@themactep.com>
+
+description:
+  The SmartSens SC2336P is a 1920x1080 CMOS image sensor with a 10-bit ADC. It is programmable through an I2C interface and outputs raw Bayer data over a two-lane MIPI CSI-2 interface.
+
+allOf:
+  - $ref: /schemas/media/video-interface-devices.yaml#
+
+properties:
+  compatible:
+    const: smartens,sc2336p
+
+  reg:
+    const: 0x30
+
+  clocks:
+    maxItems: 1
+
+  reset-gpios:
+    maxItems: 1
+
+  powerdown-gpios:
+    maxItems: 1
+
+  iovdd-supply:
+    description: Power supply for the I/O circuits (1.8 V).
+
+  avdd-supply:
+    description: Power supply for the analog circuits (2.8 V).
+
+  dvdd-supply:
+    description: Power supply for the digital core (1.2 V).
+
+  orientation: true
+
+  rotation: true
+
+  port:
+    $ref: /schemas/graph.yaml#/$defs/port-base
+
+    properties:
+      endpoint:
+        $ref: /schemas/media/video-interfaces.yaml#
+        unevaluatedProperties: false
+
+        properties:
+          link-frequencies: true
+
+        required:
+          - link-frequencies
+
+    required:
+      - endpoint
+
+    additionalProperties: false
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - reset-gpios
+  - iovdd-supply
+  - avdd-supply
+  - dvdd-supply
+  - port
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        camera@30 {
+            compatible = "smartens,sc2336p";
+            reg = <0x30>;
+            clocks = <&clk_ext_camera>;
+            reset-gpios = <&gpa 18 GPIO_ACTIVE_LOW>;
+            iovdd-supply = <&vcc_1v8>;
+            avdd-supply = <&vcc_2v8>;
+            dvdd-supply = <&vcc_1v2>;
+
+            port {
+                endpoint {
+                    remote-endpoint = <&csi_in>;
+                    data-lanes = <1 2>;
+                    link-frequencies = /bits/ 64 <198000000>;
+                };
+            };
+        };
+    };
+
+...
