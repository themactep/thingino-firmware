+
+#define SC2336P_REG_GAIN_FINE			CCI_REG8(0x3e07)
+#define SC2336P_REG_GAIN_COARSE			CCI_REG8(0x3e09)
+
+#define SC2336P_REG_FLIP				CCI_REG8(0x3221)
+#define SC2336P_FLIP_MIRROR			BIT(5)
+#define SC2336P_FLIP_VFLIP			BIT(6)
+
+#define SC2336P_STREAM_ON			0x01
+
+/* External clock is 24 MHz. */
+#define SC2336P_XCLK_FREQ			(24 * HZ_PER_MHZ)
+
+#define SC2336P_NATIVE_WIDTH			1920U
+#define SC2336P_NATIVE_HEIGHT			1080U
+
+/* 2 lanes, 405 Mbit/s per lane. */
+#define SC2336P_LINK_FREQ			198000000
+/* 2250 x 1200 pixels at 30 fps. */
+#define SC2336P_PIXEL_RATE			79200000
+
+static const s64 sc2336p_link_freqs[] = {
+	SC2336P_LINK_FREQ,
+};
+
+#define SC2336P_HTS_MIN				2200U
+#define SC2336P_HTS_MAX				0xffffU
+#define SC2336P_VTS_MAX				0xffffU
+
+/* Number of lines by which exposure must be less than VTS. */
+#define SC2336P_EXPOSURE_OFFSET			4
+
