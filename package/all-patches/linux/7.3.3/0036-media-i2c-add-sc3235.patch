From: Paul Philippov <paul@themactep.com>
Subject: [PATCH] media: i2c: add the SmartSens SC3235 sensor driver

Add a mainline V4L2 subdev driver for the SmartSens SC3235 image
sensor. The mode register sequence and gain table are adapted from the
Ingenic vendor sensor driver (sensor_sc3235_t31).

The driver uses the CCI register helpers, runtime PM, and the current
state-based subdev pad API. It exposes the full-resolution mode with
HBLANK/VBLANK, exposure, analogue gain, and mirror/flip controls where
the vendor driver provides them.

Signed-off-by: Paul Philippov <paul@themactep.com>
---
--- /dev/null
+++ b/drivers/media/i2c/sc3235.c
@@ -0,0 +1,1013 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * SmartSens SC3235 CMOS Image Sensor Driver
+ *
+ * The register sequences and gain table are adapted from the Ingenic
+ * vendor sensor driver (sensor_sc3235_t31).
+ *
+ * WARNING: this driver has not been validated on hardware.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+#include <linux/units.h>
+
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-mediabus.h>
+
+#define SC3235_CHIP_ID_H			0xcc
+#define SC3235_CHIP_ID_L			0x05
+
+#define SC3235_REG_CHIP_ID_H			CCI_REG8(0x3107)
+#define SC3235_REG_CHIP_ID_L			CCI_REG8(0x3108)
+
+#define SC3235_REG_SOFTWARE_RESET		CCI_REG8(0x0103)
+#define SC3235_REG_STREAM			CCI_REG8(0x0100)
+#define SC3235_REG_GROUP_HOLD			CCI_REG8(0x3812)
+
+#define SC3235_REG_HTS				CCI_REG16(0x320c)
+#define SC3235_REG_VTS				CCI_REG16(0x320e)
+
+/* 16-bit exposure in 1/16 line units, split over three registers. */
+#define SC3235_REG_EXPOSURE_H			CCI_REG8(0x3e00)
+#define SC3235_REG_EXPOSURE_M			CCI_REG8(0x3e01)
+#define SC3235_REG_EXPOSURE_L			CCI_REG8(0x3e02)
+#define SC3235_REG_EXPOSURE_BAND		CCI_REG8(0x3314)
+
+#define SC3235_REG_GAIN_L			CCI_REG8(0x3e09)
+#define SC3235_REG_GAIN_H			CCI_REG8(0x3e08)
+
+#define SC3235_STREAM_ON			0x01
+
+/* External clock is 24 MHz. */
+#define SC3235_XCLK_FREQ			(24 * HZ_PER_MHZ)
+
+#define SC3235_NATIVE_WIDTH			2304U
+#define SC3235_NATIVE_HEIGHT			1296U
+
+/* 2 lanes, 486 Mbit/s per lane. */
+#define SC3235_LINK_FREQ			243000000
+/* 2400 x 1620 pixels at 25 fps. */
+#define SC3235_PIXEL_RATE			97200000
+
+static const s64 sc3235_link_freqs[] = {
+	SC3235_LINK_FREQ,
+};
+
+#define SC3235_HTS_MIN				2400U
+#define SC3235_HTS_MAX				0xffffU
+#define SC3235_VTS_MAX				0xffffU
+
+/* Number of lines by which exposure must be less than VTS. */
+#define SC3235_EXPOSURE_OFFSET			4
+#define SC3235_EXPOSURE_MIN			2
+
