+	{ CCI_REG8(0x3935), 0x18 },
+	{ CCI_REG8(0x3936), 0x08 },
+	{ CCI_REG8(0x3937), 0x13 },
+	{ CCI_REG8(0x3940), 0x68 },
+	{ CCI_REG8(0x3942), 0x02 },
+	{ CCI_REG8(0x3943), 0x33 },
+	{ CCI_REG8(0x3e01), 0xa8 },
+	{ CCI_REG8(0x3e02), 0x40 },
+	{ CCI_REG8(0x3e09), 0x20 },
+	{ CCI_REG8(0x3e1b), 0x35 },
+	{ CCI_REG8(0x3e25), 0x03 },
+	{ CCI_REG8(0x3e26), 0x20 },
+	{ CCI_REG8(0x5781), 0x04 },
+	{ CCI_REG8(0x5782), 0x04 },
+	{ CCI_REG8(0x5783), 0x02 },
+	{ CCI_REG8(0x5784), 0x02 },
+	{ CCI_REG8(0x5785), 0x40 },
+	{ CCI_REG8(0x5786), 0x20 },
+	{ CCI_REG8(0x5787), 0x18 },
+	{ CCI_REG8(0x5788), 0x10 },
+	{ CCI_REG8(0x5789), 0x10 },
+	{ CCI_REG8(0x578a), 0x30 },
+	{ CCI_REG8(0x57a4), 0xa0 },
+	{ CCI_REG8(0x320e), 0x06 },
+	{ CCI_REG8(0x320f), 0x54 },
+	{ CCI_REG8(0x0100), 0x01 },
+};
+
+static const struct sc3235_mode sc3235_modes[] = {
+	{
+		.width = SC3235_NATIVE_WIDTH,
+		.height = SC3235_NATIVE_HEIGHT,
+		.hblank = SC3235_HTS_MIN - SC3235_NATIVE_WIDTH,
+		.vblank = 1620 - SC3235_NATIVE_HEIGHT,
+		.regs = sc3235_1296p25_regs,
+		.regs_num = ARRAY_SIZE(sc3235_1296p25_regs),
+	},
+};
+
+struct sc3235_ctrls {
+	struct v4l2_ctrl_handler handler;
+	struct v4l2_ctrl *pixel_rate;
+	struct v4l2_ctrl *link_freq;
+	struct v4l2_ctrl *hblank;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *gain;
+};
+
+struct sc3235 {
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+
+	struct regmap *regmap;
+	struct clk *xclk;
+
+	struct gpio_desc *reset_gpio;
+	struct gpio_desc *powerdown_gpio;
+	struct regulator_bulk_data supplies[3];
+
+	struct sc3235_ctrls ctrls;
+
+	const struct sc3235_mode *mode;
+};
+
+static inline struct sc3235 *to_sc3235(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct sc3235, sd);
+}
+
+static inline struct v4l2_subdev *sc3235_ctrl_to_sd(struct v4l2_ctrl *ctrl)
+{
+	return &container_of(ctrl->handler, struct sc3235, ctrls.handler)->sd;
+}
+
+static void sc3235_fill_format(const struct sc3235_mode *mode,
+			       struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->code = MEDIA_BUS_FMT_SBGGR10_1X10;
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	fmt->quantization = V4L2_QUANTIZATION_DEFAULT;
+	fmt->xfer_func = V4L2_XFER_FUNC_DEFAULT;
+}
+
+static int sc3235_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct v4l2_mbus_framefmt *fmt;
+	struct v4l2_rect *crop;
+
+	fmt = v4l2_subdev_state_get_format(state, 0);
+	sc3235_fill_format(&sc3235_modes[0], fmt);
+
+	crop = v4l2_subdev_state_get_crop(state, 0);
+	crop->left = 0;
+	crop->top = 0;
+	crop->width = sc3235_modes[0].width;
+	crop->height = sc3235_modes[0].height;
+
+	return 0;
+}
+
+static int sc3235_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index != 0)
+		return -EINVAL;
+
+	code->code = MEDIA_BUS_FMT_SBGGR10_1X10;
+
+	return 0;
+}
+
+static int sc3235_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index >= ARRAY_SIZE(sc3235_modes))
+		return -EINVAL;
+
+	if (fse->code != MEDIA_BUS_FMT_SBGGR10_1X10)
+		return -EINVAL;
+
+	fse->min_width = sc3235_modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = sc3235_modes[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+static int sc3235_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		sel->r = *v4l2_subdev_state_get_crop(state, 0);
+		return 0;
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = SC3235_NATIVE_WIDTH;
+		sel->r.height = SC3235_NATIVE_HEIGHT;
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static int sc3235_set_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct sc3235 *sc3235 = to_sc3235(sd);
+	const struct sc3235_mode *mode;
+	struct v4l2_mbus_framefmt *framefmt;
+	struct v4l2_rect *crop;
+
+	mode = v4l2_find_nearest_size(sc3235_modes, ARRAY_SIZE(sc3235_modes),
+				      width, height,
+				      fmt->format.width, fmt->format.height);
+
+	sc3235_fill_format(mode, &fmt->format);
+	framefmt = v4l2_subdev_state_get_format(state, fmt->pad);
+	*framefmt = fmt->format;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_ACTIVE) {
+		sc3235->mode = mode;
+		__v4l2_ctrl_s_ctrl(sc3235->ctrls.hblank, mode->hblank);
+		__v4l2_ctrl_s_ctrl(sc3235->ctrls.vblank, mode->vblank);
+	}
+
+	crop = v4l2_subdev_state_get_crop(state, fmt->pad);
+	crop->left = 0;
+	crop->top = 0;
+	crop->width = mode->width;
+	crop->height = mode->height;
+
+	return 0;
+}
+
+static void sc3235_exposure_update(struct sc3235 *sc3235)
+{
+	unsigned int exposure_max;
+
+	exposure_max = sc3235->ctrls.vblank->val + sc3235->mode->height -
+		       SC3235_EXPOSURE_OFFSET;
+	exposure_max = min(exposure_max, 0xffffU);
+
+	__v4l2_ctrl_modify_range(sc3235->ctrls.exposure,
+				 SC3235_EXPOSURE_MIN, exposure_max, 1,
+				 exposure_max);
+}
+
+static int sc3235_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct sc3235 *sc3235 = to_sc3235(sc3235_ctrl_to_sd(ctrl));
+
+	dev_dbg(sc3235->sd.dev, "sc3235: ctrl 0x%x = %d\n", ctrl->id, ctrl->val);
+	const struct sc3235_gain *gain;
+	u32 hts, it;
+	int ret = 0;
+
+	if (ctrl->flags & V4L2_CTRL_FLAG_READ_ONLY)
+		return 0;
+
+	if (ctrl->id == V4L2_CID_VBLANK)
+		sc3235_exposure_update(sc3235);
+
+	if (!pm_runtime_get_if_in_use(sc3235->sd.dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		it = (u32)ctrl->val * 2;
+		ret = cci_write(sc3235->regmap, SC3235_REG_GROUP_HOLD, 0x00, NULL);
+		ret = cci_write(sc3235->regmap, SC3235_REG_EXPOSURE_H,
+				(it >> 12) & 0x0f, &ret);
+		ret = cci_write(sc3235->regmap, SC3235_REG_EXPOSURE_M,
+				(it >> 4) & 0xff, &ret);
+		ret = cci_write(sc3235->regmap, SC3235_REG_EXPOSURE_L,
+				(it & 0x0f) << 4, &ret);
+		if (it < 0x250)
+			ret = cci_write(sc3235->regmap, SC3235_REG_EXPOSURE_BAND,
+					0x14, &ret);
+		else if (it > 0x450)
+			ret = cci_write(sc3235->regmap, SC3235_REG_EXPOSURE_BAND,
+					0x04, &ret);
+		ret = cci_write(sc3235->regmap, SC3235_REG_GROUP_HOLD, 0x30, &ret);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		gain = &sc3235_gains[ctrl->val];
+		ret = cci_write(sc3235->regmap, SC3235_REG_GROUP_HOLD, 0x00, NULL);
+		ret = cci_write(sc3235->regmap, CCI_REG8(0x3632),
+				gain->reg_3632, &ret);
+		ret = cci_write(sc3235->regmap, CCI_REG8(0x3306),
+				gain->reg_3306, &ret);
+		ret = cci_write(sc3235->regmap, CCI_REG8(0x330b),
+				gain->reg_330b, &ret);
+		ret = cci_write(sc3235->regmap, SC3235_REG_GROUP_HOLD, 0x30, &ret);
+		ret = cci_write(sc3235->regmap, SC3235_REG_GAIN_L,
+				gain->reg_3e09, &ret);
+		ret = cci_write(sc3235->regmap, SC3235_REG_GAIN_H,
+				gain->reg_3e08, &ret);
+		break;
+	case V4L2_CID_HBLANK:
+		hts = ctrl->val + sc3235->mode->width;
+		ret = cci_write(sc3235->regmap, SC3235_REG_HTS, hts, NULL);
+		break;
+	case V4L2_CID_VBLANK:
+		ret = cci_write(sc3235->regmap, SC3235_REG_VTS,
+				ctrl->val + sc3235->mode->height, NULL);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put_autosuspend(sc3235->sd.dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops sc3235_ctrl_ops = {
+	.s_ctrl = sc3235_set_ctrl,
+};
+
+static int sc3235_init_controls(struct sc3235 *sc3235)
+{
+	struct v4l2_ctrl_handler *hdl = &sc3235->ctrls.handler;
+	struct v4l2_fwnode_device_properties props;
+	const struct v4l2_ctrl_ops *ops = &sc3235_ctrl_ops;
+	unsigned int hblank_max = SC3235_HTS_MAX - SC3235_NATIVE_WIDTH;
+	unsigned int vblank_max = SC3235_VTS_MAX - SC3235_NATIVE_HEIGHT;
+	int ret;
+
+	ret = v4l2_ctrl_handler_init(hdl, 8);
+	if (ret)
+		return ret;
+
+	sc3235->ctrls.pixel_rate =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_PIXEL_RATE,
+				  SC3235_PIXEL_RATE, SC3235_PIXEL_RATE, 1,
+				  SC3235_PIXEL_RATE);
+
+	sc3235->ctrls.link_freq =
+		v4l2_ctrl_new_int_menu(hdl, ops, V4L2_CID_LINK_FREQ, 0, 0,
+				       sc3235_link_freqs);
+	if (sc3235->ctrls.link_freq)
+		sc3235->ctrls.link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	sc3235->ctrls.exposure =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_EXPOSURE,
+				  SC3235_EXPOSURE_MIN,
+				  sc3235_modes[0].vblank +
+				  sc3235_modes[0].height -
+				  SC3235_EXPOSURE_OFFSET, 1,
+				  sc3235_modes[0].vblank +
+				  sc3235_modes[0].height -
+				  SC3235_EXPOSURE_OFFSET);
+
+	sc3235->ctrls.gain =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_ANALOGUE_GAIN, 0,
+				  ARRAY_SIZE(sc3235_gains) - 1, 1, 0);
+
+	sc3235->ctrls.hblank =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_HBLANK,
+				  SC3235_HTS_MIN - SC3235_NATIVE_WIDTH,
+				  hblank_max, 1,
+				  sc3235_modes[0].hblank);
+
+	sc3235->ctrls.vblank =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_VBLANK,
+				  sc3235_modes[0].vblank, vblank_max, 1,
+				  sc3235_modes[0].vblank);
+
+	if (hdl->error) {
+		ret = hdl->error;
+		goto error;
+	}
+
+	ret = v4l2_fwnode_device_parse(sc3235->sd.dev, &props);
+	if (ret)
+		goto error;
+
+	ret = v4l2_ctrl_new_fwnode_properties(hdl, ops, &props);
+	if (ret)
+		goto error;
+
+	sc3235->sd.ctrl_handler = hdl;
+
+	return 0;
+
+error:
+	v4l2_ctrl_handler_free(hdl);
+
+	return ret;
+}
+
+static int sc3235_check_hwcfg(struct device *dev)
+{
+	struct v4l2_fwnode_endpoint ep = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	struct fwnode_handle *endpoint;
+	unsigned int i;
+	int ret;
+
+	endpoint = fwnode_graph_get_next_endpoint(dev_fwnode(dev), NULL);
+	if (!endpoint) {
+		dev_err(dev, "endpoint node not found\n");
+		return -EINVAL;
+	}
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(endpoint, &ep);
+	fwnode_handle_put(endpoint);
+	if (ret)
+		return ret;
+
+	if (ep.bus.mipi_csi2.num_data_lanes != 2) {
+		dev_err(dev, "only 2 data lanes are currently supported\n");
+		ret = -EINVAL;
+		goto out;
+	}
+
+	if (!ep.nr_of_link_frequencies) {
+		dev_err(dev, "link-frequency property not found in DT\n");
+		ret = -EINVAL;
+		goto out;
+	}
+
+	for (i = 0; i < ep.nr_of_link_frequencies; i++) {
+		if (ep.link_frequencies[i] == SC3235_LINK_FREQ)
+			break;
+	}
+
+	if (i == ep.nr_of_link_frequencies) {
+		dev_err(dev, "expected link frequency %u\n", SC3235_LINK_FREQ);
+		ret = -EINVAL;
+	}
+
+out:
+	v4l2_fwnode_endpoint_free(&ep);
+
+	return ret;
+}
+
+static int sc3235_power_on(struct device *dev)
+{
+	dev_dbg(dev, "sc3235: power on\n");
+	struct sc3235 *sc3235 = to_sc3235(dev_get_drvdata(dev));
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(sc3235->supplies),
+				    sc3235->supplies);
+	if (ret)
+		return ret;
+
+	ret = clk_prepare_enable(sc3235->xclk);
+	if (ret)
+		goto err_regulators;
+
+	/* The sensor needs MCLK while reset is released. */
+	gpiod_set_value_cansleep(sc3235->powerdown_gpio, 0);
+	gpiod_set_value_cansleep(sc3235->reset_gpio, 0);
+	msleep(20);
+
+	return 0;
+
+err_regulators:
+	regulator_bulk_disable(ARRAY_SIZE(sc3235->supplies), sc3235->supplies);
+
+	return ret;
+}
+
+static int sc3235_power_off(struct device *dev)
+{
+	dev_dbg(dev, "sc3235: power off\n");
+	struct sc3235 *sc3235 = to_sc3235(dev_get_drvdata(dev));
+
+	gpiod_set_value_cansleep(sc3235->reset_gpio, 1);
+	gpiod_set_value_cansleep(sc3235->powerdown_gpio, 1);
+	clk_disable_unprepare(sc3235->xclk);
+	regulator_bulk_disable(ARRAY_SIZE(sc3235->supplies), sc3235->supplies);
+
+	return 0;
+}
+
+static int sc3235_identify_module(struct sc3235 *sc3235)
+{
+	u64 id_h, id_l;
+	int ret;
+
+	ret = cci_read(sc3235->regmap, SC3235_REG_CHIP_ID_H, &id_h, NULL);
+	if (ret)
+		return ret;
+
+	ret = cci_read(sc3235->regmap, SC3235_REG_CHIP_ID_L, &id_l, NULL);
+	if (ret)
+		return ret;
+
+	if (id_h != SC3235_CHIP_ID_H || id_l != SC3235_CHIP_ID_L) {
+		dev_err(sc3235->sd.dev, "chip id mismatch: %x%x != %x%x\n",
+			(u8)id_h, (u8)id_l, SC3235_CHIP_ID_H, SC3235_CHIP_ID_L);
+		return -EIO;
+	}
+
+	dev_info(sc3235->sd.dev, "sc3235: chip id %02x%02x\n", (u8)id_h, (u8)id_l);
+	return 0;
+}
+
+static int sc3235_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state, u32 pad,
+				 u64 streams_mask)
+{
+	struct sc3235 *sc3235 = to_sc3235(sd);
+
+	dev_info(sd->dev, "sc3235: stream on\n");
+	int ret;
+
+	ret = pm_runtime_resume_and_get(sd->dev);
+	if (ret)
+		return ret;
+
+	cci_multi_reg_write(sc3235->regmap, sc3235->mode->regs,
+			    sc3235->mode->regs_num, &ret);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = __v4l2_ctrl_handler_setup(&sc3235->ctrls.handler);
+	if (ret)
+		goto err_rpm_put;
+
+	cci_write(sc3235->regmap, SC3235_REG_STREAM, SC3235_STREAM_ON, &ret);
+	if (ret)
+		goto err_rpm_put;
+
+	return 0;
+
+err_rpm_put:
+	pm_runtime_put_autosuspend(sd->dev);
+
+	return ret;
+}
+
+static int sc3235_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	dev_info(sd->dev, "sc3235: stream off\n");
+	struct sc3235 *sc3235 = to_sc3235(sd);
+	int ret = 0;
+
+	cci_write(sc3235->regmap, SC3235_REG_STREAM, 0x00, &ret);
+	if (ret)
+		dev_err(sd->dev, "failed to stop streaming: %d\n", ret);
+
+	pm_runtime_put_autosuspend(sd->dev);
+
+	return ret;
+}
+
+static const struct v4l2_subdev_video_ops sc3235_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops sc3235_pad_ops = {
+	.enum_mbus_code = sc3235_enum_mbus_code,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = sc3235_set_pad_format,
+	.get_selection = sc3235_get_selection,
+	.enum_frame_size = sc3235_enum_frame_size,
+	.enable_streams = sc3235_enable_streams,
+	.disable_streams = sc3235_disable_streams,
+};
+
+static const struct v4l2_subdev_ops sc3235_subdev_ops = {
+	.video = &sc3235_video_ops,
+	.pad = &sc3235_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops sc3235_subdev_internal_ops = {
+	.init_state = sc3235_init_state,
+};
+
+static const char * const sc3235_supply_names[] = {
+	"iovdd",
+	"avdd",
+	"dvdd",
+};
+
+static int sc3235_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+
+	dev_info(dev, "sc3235: probe at i2c 0x%02x\n", client->addr);
+	struct sc3235 *sc3235;
+	unsigned int i;
+	unsigned long xclk_freq;
+	int ret;
+
+	sc3235 = devm_kzalloc(dev, sizeof(*sc3235), GFP_KERNEL);
+	if (!sc3235)
+		return -ENOMEM;
+
+	v4l2_i2c_subdev_init(&sc3235->sd, client, &sc3235_subdev_ops);
+	sc3235->sd.internal_ops = &sc3235_subdev_internal_ops;
+
+	ret = sc3235_check_hwcfg(dev);
+	if (ret)
+		return ret;
+
+	sc3235->xclk = devm_v4l2_sensor_clk_get(dev, NULL);
+	if (IS_ERR(sc3235->xclk))
+		return dev_err_probe(dev, PTR_ERR(sc3235->xclk),
+				     "failed to get xclk\n");
+
+	xclk_freq = clk_get_rate(sc3235->xclk);
+	if (xclk_freq != SC3235_XCLK_FREQ)
+		return dev_err_probe(dev, -EINVAL,
+				     "xclk frequency %lu Hz not supported\n",
+				     xclk_freq);
+
+	for (i = 0; i < ARRAY_SIZE(sc3235->supplies); i++)
+		sc3235->supplies[i].supply = sc3235_supply_names[i];
+
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(sc3235->supplies),
+				      sc3235->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get regulators\n");
+
+	sc3235->reset_gpio = devm_gpiod_get_optional(dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(sc3235->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(sc3235->reset_gpio),
+				     "failed to get reset gpio\n");
+
+	sc3235->powerdown_gpio = devm_gpiod_get_optional(dev, "powerdown",
+							 GPIOD_OUT_HIGH);
+	if (IS_ERR(sc3235->powerdown_gpio))
+		return dev_err_probe(dev, PTR_ERR(sc3235->powerdown_gpio),
+				     "failed to get powerdown gpio\n");
+
+	sc3235->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(sc3235->regmap))
+		return dev_err_probe(dev, PTR_ERR(sc3235->regmap),
+				     "failed to get cci regmap\n");
+
+	ret = sc3235_power_on(dev);
+	if (ret)
+		return ret;
+
+	ret = sc3235_identify_module(sc3235);
+	if (ret)
+		goto err_power_off;
+
+	sc3235->mode = &sc3235_modes[0];
+
+	ret = sc3235_init_controls(sc3235);
+	if (ret)
+		goto err_power_off;
+
+	sc3235->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	sc3235->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	sc3235->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&sc3235->sd.entity, 1, &sc3235->pad);
+	if (ret)
+		goto err_handler_free;
+
+	sc3235->sd.state_lock = sc3235->ctrls.handler.lock;
+	ret = v4l2_subdev_init_finalize(&sc3235->sd);
+	if (ret)
+		goto err_media_entity;
+
+	pm_runtime_set_active(dev);
+	pm_runtime_get_noresume(dev);
+	pm_runtime_enable(dev);
+	pm_runtime_set_autosuspend_delay(dev, 1000);
+	pm_runtime_use_autosuspend(dev);
+	pm_runtime_put_autosuspend(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&sc3235->sd);
+	if (ret)
+		goto err_subdev_cleanup;
+
+	return 0;
+
+err_subdev_cleanup:
+	v4l2_subdev_cleanup(&sc3235->sd);
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+err_media_entity:
+	media_entity_cleanup(&sc3235->sd.entity);
+err_handler_free:
+	v4l2_ctrl_handler_free(&sc3235->ctrls.handler);
+err_power_off:
+	sc3235_power_off(dev);
+
+	return ret;
+}
+
+static void sc3235_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct sc3235 *sc3235 = to_sc3235(sd);
+
+	v4l2_subdev_cleanup(sd);
+	v4l2_async_unregister_subdev(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&sc3235->ctrls.handler);
+
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev))
+		sc3235_power_off(&client->dev);
+	pm_runtime_set_suspended(&client->dev);
+}
+
+static const struct of_device_id sc3235_dt_ids[] = {
+	{ .compatible = "smartens,sc3235" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, sc3235_dt_ids);
+
+static const struct i2c_device_id sc3235_id[] = {
+	{ .name = "sc3235" },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, sc3235_id);
+
+static const struct dev_pm_ops sc3235_pm_ops = {
+	RUNTIME_PM_OPS(sc3235_power_off, sc3235_power_on, NULL)
+};
+
+static struct i2c_driver sc3235_i2c_driver = {
+	.driver = {
+		.name = "sc3235",
+		.of_match_table = sc3235_dt_ids,
+		.pm = pm_ptr(&sc3235_pm_ops),
+	},
+	.probe = sc3235_probe,
+	.remove = sc3235_remove,
+	.id_table = sc3235_id,
+};
+
+module_i2c_driver(sc3235_i2c_driver);
+
+MODULE_DESCRIPTION("SmartSens SC3235 sensor driver");
+MODULE_LICENSE("GPL");
