+
+	[T41_CLK_EXCLK] = { "ext", CGU_CLK_EXT },
+	[T41_CLK_RTCLK] = { "rtc", CGU_CLK_EXT },
+
+	/* PLLs */
+
+	[T41_CLK_APLL] = {
+		"apll", CGU_CLK_CUSTOM,
+		.parents = { T41_CLK_EXCLK, -1, -1, -1 },
+		.custom = { &t41_apll_ops },
+	},
+
+	[T41_CLK_MPLL] = {
+		"mpll", CGU_CLK_CUSTOM,
+		.parents = { T41_CLK_EXCLK, -1, -1, -1 },
+		.custom = { &t41_mpll_ops },
+	},
+
+	[T41_CLK_VPLL] = {
