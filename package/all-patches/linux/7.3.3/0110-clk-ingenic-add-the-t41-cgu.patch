+		.parents = { T41_CLK_SCLKA, T41_CLK_MPLL, T41_CLK_VPLL, -1 },
+		.mux = { CGU_REG_MACCDR, 30, 2 },
+		.div = { CGU_REG_MACCDR, 0, 1, 8, 28, 29, 27 },
+		.gate = { CGU_REG_CLKGR1, 4 },
+	},
+
+	[T41_CLK_SFC0] = {
