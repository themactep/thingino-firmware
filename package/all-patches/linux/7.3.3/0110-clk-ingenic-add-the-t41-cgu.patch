From: Paul Philippov <paul@themactep.com>
Subject: [PATCH] clk: ingenic: add the T41 CGU

The T41 clock and power manager is the XBurst2 block: the X1000 register
layout (CPCCR, APLL/MPLL, CLKGR/CLKGR1, the per-peripheral CDR registers
and VPLL at 0xe0) with the T41's own mux sources, dividers and gates.
The PLLs have two output dividers, OD0 and OD1:

  f = ext * (m + 1) * 2 / ((n + 1) << od0) / (od1 + 1)

which the generic PLL type cannot express, so each PLL is a read-only
custom clock. Register the CPU/L2/AHB/APB tree, the peripheral mux,
divider and gate combinations, and the remaining gates. Rates above the
APB are marked critical and the peripheral gates are left alone
(CLK_IGNORE_UNUSED) because U-Boot leaves the tree running and the
drivers that own those gates do not ask for them yet.

The APB divider is registered as "pclk" and the fixed inputs as "ext" and
"rtc": the TCU clock provider and its channel clocks look their parents
up by those names.

The AIC, and with it the fractional I2S dividers, are left out until the
audio driver is ported.

Signed-off-by: Paul Philippov <paul@themactep.com>
---
--- a/drivers/clk/ingenic/Kconfig
+++ b/drivers/clk/ingenic/Kconfig
@@ -95,6 +95,16 @@
 
 	  If building for a T31 SoC, you want to say Y here.
 
+config INGENIC_CGU_T41
+	bool "Ingenic T41 CGU driver"
+	default MACH_T41
+	select INGENIC_CGU_COMMON
+	help
+	  Support the clocks provided by the CGU hardware on Ingenic T41
+	  and compatible SoCs.
+
+	  If building for a T41 SoC, you want to say Y here.
+
 config INGENIC_TCU_CLK
 	bool "Ingenic JZ47xx TCU clocks driver"
 	default MACH_INGENIC
--- a/drivers/clk/ingenic/Makefile
+++ b/drivers/clk/ingenic/Makefile
@@ -9,4 +9,5 @@
 obj-$(CONFIG_INGENIC_CGU_X1000)		+= x1000-cgu.o
 obj-$(CONFIG_INGENIC_CGU_X1830)		+= x1830-cgu.o
 obj-$(CONFIG_INGENIC_CGU_T31)		+= t31-cgu.o
+obj-$(CONFIG_INGENIC_CGU_T41)		+= t41-cgu.o
 obj-$(CONFIG_INGENIC_TCU_CLK)		+= tcu.o
--- /dev/null
+++ b/drivers/clk/ingenic/t41-cgu.c
@@ -0,0 +1,561 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * T41 SoC CGU driver
+ *
+ * The T41 clock and power manager is the XBurst2 block: the same register
+ * layout the XBurst1 X1000 uses (CPCCR, APLL, MPLL, CLKGR/CLKGR1, the
+ * per-peripheral CDR registers and VPLL at 0xe0), with the T41's own mux
+ * sources, dividers and gates. The PLLs take two output dividers, OD0 and
+ * OD1, so they do not fit the generic PLL type.
+ */
+
+#include <linux/clk-provider.h>
+#include <linux/io.h>
+#include <linux/of.h>
+
+#include <dt-bindings/clock/ingenic,t41-cgu.h>
+
+#include "cgu.h"
+#include "pm.h"
+
+/* CGU register offsets */
+#define CGU_REG_CPCCR		0x00
+#define CGU_REG_LCR		0x04
+#define CGU_REG_CPPCR		0x0c
+#define CGU_REG_APLL		0x10
+#define CGU_REG_MPLL		0x14
+#define CGU_REG_CLKGR		0x20
+#define CGU_REG_OPCR		0x24
+#define CGU_REG_CLKGR1		0x28
+#define CGU_REG_DDRCDR		0x2c
+#define CGU_REG_USBPCR		0x3c
+#define CGU_REG_USBRDT		0x40
+#define CGU_REG_USBPCR1		0x48
+#define CGU_REG_RSACDR		0x4c
+#define CGU_REG_SSI_SLVCDR	0x50
+#define CGU_REG_MACCDR		0x54
+#define CGU_REG_SFC0CDR		0x60
+#define CGU_REG_LPCDR		0x64
+#define CGU_REG_MSC0CDR		0x68
+#define CGU_REG_MSC1CDR		0x6c
+#define CGU_REG_SSICDR		0x74
+#define CGU_REG_SFC1CDR		0x7c
+#define CGU_REG_ISPMCDR		0x80
+#define CGU_REG_CIMCDR		0x90
+#define CGU_REG_LDCCDR		0xa0
+#define CGU_REG_ISPSCDR		0xa8
+#define CGU_REG_ISPACDR		0xac
+#define CGU_REG_BT0CDR		0xb8
+#define CGU_REG_EL200CDR	0xbc
+#define CGU_REG_CPCSR		0xd4
+#define CGU_REG_VPLL		0xe0
+#define CGU_REG_MACPHY		0xe8
+#define CGU_REG_PWMCDR		0xfc
+
+/* bits within the CPCCR register */
+#define CPCCR_PCS		BIT(22)	/* divider change strobe */
+
+/* PLL register fields: two output dividers, OD0 and OD1 */
+#define PLL_M_SHIFT		20
+#define PLL_M_BITS		9
+#define PLL_N_SHIFT		14
+#define PLL_N_BITS		6
+#define PLL_OD0_SHIFT		11
+#define PLL_OD0_BITS		3
+#define PLL_OD1_SHIFT		7
+#define PLL_OD1_BITS		4
+
+static struct ingenic_cgu *cgu;
+
+static unsigned long t41_pll_recalc_rate(struct clk_hw *hw,
+					 unsigned long parent_rate,
+					 unsigned int reg)
+{
+	u32 val = readl(cgu->base + reg);
+	unsigned int m, n, od0, od1;
+	u64 rate;
+
+	m = (val >> PLL_M_SHIFT) & GENMASK(PLL_M_BITS - 1, 0);
+	n = (val >> PLL_N_SHIFT) & GENMASK(PLL_N_BITS - 1, 0);
+	od0 = (val >> PLL_OD0_SHIFT) & GENMASK(PLL_OD0_BITS - 1, 0);
+	od1 = (val >> PLL_OD1_SHIFT) & GENMASK(PLL_OD1_BITS - 1, 0);
+
+	rate = (u64)parent_rate * (m + 1) * 2;
+	do_div(rate, (u64)(n + 1) << od0);
+	do_div(rate, od1 + 1);
+
+	return rate;
+}
+
+#define T41_PLL_OPS(_name, _reg)					\
+static unsigned long t41_##_name##_recalc_rate(struct clk_hw *hw,	\
+					       unsigned long parent_rate)\
+{									\
+	return t41_pll_recalc_rate(hw, parent_rate, _reg);		\
+}									\
+static const struct clk_ops t41_##_name##_ops = {			\
+	.recalc_rate	= t41_##_name##_recalc_rate,			\
+}
+
+T41_PLL_OPS(apll, CGU_REG_APLL);
+T41_PLL_OPS(mpll, CGU_REG_MPLL);
+T41_PLL_OPS(vpll, CGU_REG_VPLL);
+
+/*
+ * Everything above the modulo-64 kHz APB clock is marked critical: U-Boot
+ * leaves the clock tree running and nothing in the kernel changes CPU or
+ * bus rates, so the clock framework must not take them down as unused.
+ * The peripheral gates carry CLK_IGNORE_UNUSED until the drivers that own
+ * them ask for their clocks by name.
+ */
+static const struct ingenic_cgu_clk_info t41_cgu_clocks[] = {
