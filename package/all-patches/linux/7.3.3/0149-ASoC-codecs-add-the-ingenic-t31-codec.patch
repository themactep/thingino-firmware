Subject: [PATCH] ASoC: codecs: add the Ingenic T31 internal codec (capture only)

Minimal ASoC codec for the T31 microphone path, "ingenic,t31-codec".
The jz4740 codec driver cannot be used: it holds the T31 codec in reset
(register 0x00 bits 1:0 are srst/dcrst there) and rewrites 0x00/0x04.

The vendor power-up (once) and microphone ADC enable/disable sequences
run from startup/prepare/shutdown, the sample rate goes to CSRR.  The
DAI has a capture stream only, so no playback device is created and
the DAC/speaker path is never touched.  Controls: "Mic Capture Volume"
(PGA), "Mic Boost Capture Volume", "ALC Capture Switch".
---
--- a/sound/soc/codecs/Kconfig
+++ b/sound/soc/codecs/Kconfig
@@ -135,6 +135,7 @@
 	imply SND_SOC_IDT821034
 	imply SND_SOC_INNO_RK3036
 	imply SND_SOC_ISABELLE
+	imply SND_SOC_INGENIC_T31_CODEC
 	imply SND_SOC_JZ4740_CODEC
 	imply SND_SOC_JZ4725B_CODEC
 	imply SND_SOC_JZ4760_CODEC
@@ -1184,6 +1185,18 @@
 	help
 	  Enable support for Conexant CX20721 and CX20723 codec chips.
 
+config SND_SOC_INGENIC_T31_CODEC
+	depends on MACH_INGENIC || COMPILE_TEST
+	depends on OF
+	select REGMAP_MMIO
+	tristate "Ingenic T31 internal CODEC (capture only)"
+	help
+	  Enable support for the microphone input of the internal CODEC
+	  found in the T31 SoC from Ingenic.  There is no playback path.
+
+	  This driver can also be built as a module. If so, the module
+	  will be called snd-soc-ingenic-t31-codec.
+
 config SND_SOC_JZ4740_CODEC
 	depends on MACH_INGENIC || COMPILE_TEST
 	depends on OF
--- a/sound/soc/codecs/Makefile
+++ b/sound/soc/codecs/Makefile
@@ -153,6 +153,7 @@
 snd-soc-inno-rk3036-y := inno_rk3036.o
 snd-soc-isabelle-y := isabelle.o
 snd-soc-jz4740-codec-y := jz4740.o
+snd-soc-ingenic-t31-codec-y := ingenic-t31-codec.o
 snd-soc-jz4725b-codec-y := jz4725b.o
 snd-soc-jz4760-codec-y := jz4760.o
 snd-soc-jz4770-codec-y := jz4770.o
@@ -596,6 +597,7 @@
 obj-$(CONFIG_SND_SOC_IDT821034)	+= snd-soc-idt821034.o
 obj-$(CONFIG_SND_SOC_INNO_RK3036)	+= snd-soc-inno-rk3036.o
 obj-$(CONFIG_SND_SOC_ISABELLE)	+= snd-soc-isabelle.o
+obj-$(CONFIG_SND_SOC_INGENIC_T31_CODEC)	+= snd-soc-ingenic-t31-codec.o
 obj-$(CONFIG_SND_SOC_JZ4740_CODEC)	+= snd-soc-jz4740-codec.o
 obj-$(CONFIG_SND_SOC_JZ4725B_CODEC)	+= snd-soc-jz4725b-codec.o
 obj-$(CONFIG_SND_SOC_JZ4760_CODEC)      += snd-soc-jz4760-codec.o
--- /dev/null
+++ b/sound/soc/codecs/ingenic-t31-codec.c
@@ -0,0 +1,412 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Ingenic T31 internal audio codec (capture only)
+ *
+ * The register sequences follow the vendor driver for the T31 (power-up,
+ * microphone ADC enable/disable).  The codec is the I2S clock provider and
+ * runs from fs * 256 supplied by the CGU.  There is no playback path on
+ * purpose: no DAC or speaker amplifier is ever touched.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/err.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+
+#include <sound/pcm.h>
+#include <sound/pcm_params.h>
+#include <sound/soc.h>
+#include <sound/tlv.h>
+
+#define T31_CODEC_CGR		0x00	/* [1] dcrst, [0] srst, low-active */
+#define T31_CODEC_CACR		0x08
+#define T31_CODEC_CACR2		0x0c
+#define T31_CODEC_CDCR1		0x10
+#define T31_CODEC_CDCR2		0x14
+#define T31_CODEC_CGAINLR	0x24
+#define T31_CODEC_CCR		0x84
+#define T31_CODEC_CAACR		0x88
+#define T31_CODEC_CMICCR	0x8c
+#define T31_CODEC_CMICGAINR	0x90
+#define T31_CODEC_CALCGR	0x94
+#define T31_CODEC_CANACR	0x98
+#define T31_CODEC_CSRR		0x110
+#define T31_CODEC_MAX_REG	0x130
+
+#define T31_RATES (SNDRV_PCM_RATE_8000 | SNDRV_PCM_RATE_12000 | \
+		   SNDRV_PCM_RATE_16000 | SNDRV_PCM_RATE_24000 | \
+		   SNDRV_PCM_RATE_32000 | SNDRV_PCM_RATE_44100 | \
+		   SNDRV_PCM_RATE_48000)
+
+#define T31_GAIN_MAX		31
+#define T31_GAIN_DEFAULT	0x0c
+#define T31_BOOST_MAX		3
+#define T31_BOOST_DEFAULT	2
+
+struct t31_codec_step {
+	u16 reg;
+	u8 lsb, msb, val, delay_ms;
+};
+
+/* power-up, once */
+static const struct t31_codec_step t31_codec_powerup[] = {
+	{ T31_CODEC_CGR,	0, 1, 0x00, 10 },
+	{ T31_CODEC_CGR,	0, 1, 0x03, 10 },
+	{ T31_CODEC_CACR2,	0, 7, 0x3e, 0 },
+	{ T31_CODEC_CDCR1,	0, 7, 0x10, 0 },
+	{ T31_CODEC_CDCR2,	0, 7, 0x3e, 0 },
+	{ T31_CODEC_CANACR,	0, 1, 0x01, 10 },
+	{ T31_CODEC_CCR,	0, 6, 0x01, 10 },
+	{ T31_CODEC_CAACR,	5, 5, 0x01, 10 },
+	{ T31_CODEC_CCR,	0, 6, 0x01, 30 },
+	{ T31_CODEC_CCR,	0, 6, 0x03, 30 },
+	{ T31_CODEC_CCR,	0, 6, 0x07, 30 },
+	{ T31_CODEC_CCR,	0, 6, 0x0f, 30 },
+	{ T31_CODEC_CCR,	0, 6, 0x1f, 30 },
+	{ T31_CODEC_CCR,	0, 6, 0x3f, 30 },
+	{ T31_CODEC_CCR,	0, 6, 0x7f, 50 },
+};
+
+/* microphone capture enable; the entries marked below come from the state */
+static const struct t31_codec_step t31_codec_adc_on[] = {
+	{ T31_CODEC_CANACR,	0, 1, 0x02, 10 },
+	{ T31_CODEC_CGAINLR,	0, 4, 0x08, 10 },
+	{ T31_CODEC_CACR,	5, 6, 0x00, 10 },
+	{ T31_CODEC_CACR,	3, 4, 0x02, 10 },
+	{ T31_CODEC_CACR,	0, 0, 0x00, 10 },	/* mono: from the state */
+	{ T31_CODEC_CACR,	7, 7, 0x01, 10 },
+	{ T31_CODEC_CACR2,	0, 7, 0x3e, 10 },
+	{ T31_CODEC_CMICCR,	7, 7, 0x01, 10 },
+	{ T31_CODEC_CAACR,	4, 4, 0x01, 10 },
+	{ T31_CODEC_CAACR,	3, 3, 0x01, 10 },
+	{ T31_CODEC_CAACR,	0, 2, 0x07, 10 },
+	{ T31_CODEC_CMICCR,	5, 5, 0x01, 10 },
+	{ T31_CODEC_CMICGAINR,	4, 4, 0x01, 10 },
+	{ T31_CODEC_CMICGAINR,	5, 5, 0x01, 10 },
+	{ T31_CODEC_CANACR,	6, 6, 0x01, 10 },
+	{ T31_CODEC_CANACR,	5, 5, 0x01, 10 },
+	{ T31_CODEC_CANACR,	4, 4, 0x01, 10 },
+	{ T31_CODEC_CANACR,	7, 7, 0x01, 10 },
+	{ T31_CODEC_CMICCR,	6, 6, 0x01, 10 },
+	{ T31_CODEC_CMICGAINR,	6, 7, 0x02, 10 },	/* boost: from the state */
+	{ T31_CODEC_CALCGR,	0, 4, 0x0c, 10 },	/* gain: from the state */
+	{ T31_CODEC_CMICCR,	4, 4, 0x01, 10 },	/* ALC: from the state */
+	{ T31_CODEC_CCR,	0, 6, 0x01, 10 },
+};
+
+static const struct t31_codec_step t31_codec_adc_off[] = {
+	{ T31_CODEC_CMICCR,	4, 4, 0x00, 10 },
+	{ T31_CODEC_CANACR,	5, 5, 0x00, 10 },
+	{ T31_CODEC_CANACR,	6, 6, 0x00, 10 },
+	{ T31_CODEC_CMICGAINR,	5, 5, 0x00, 10 },
+	{ T31_CODEC_CMICGAINR,	4, 4, 0x00, 10 },
+	{ T31_CODEC_CMICCR,	5, 5, 0x00, 10 },
+	{ T31_CODEC_CAACR,	4, 4, 0x00, 10 },
+	{ T31_CODEC_CANACR,	4, 4, 0x00, 10 },
+	{ T31_CODEC_CANACR,	7, 7, 0x00, 10 },
+	{ T31_CODEC_CMICCR,	6, 6, 0x00, 10 },
+};
+
+struct t31_codec {
+	struct regmap *regmap;
+	struct mutex lock;
+	bool powered;
+	bool adc_on;
+	unsigned int rate;
+	unsigned int channels;
+	unsigned int gain;
+	unsigned int boost;
+	unsigned int alc;
+};
+
+static int t31_codec_run(struct t31_codec *c, const struct t31_codec_step *s,
+			 unsigned int n)
+{
+	unsigned int i, val;
+	int ret;
+
+	for (i = 0; i < n; i++, s++) {
+		unsigned int mask = GENMASK(s->msb, s->lsb);
+
+		val = s->val;
+		if (s == &t31_codec_adc_on[4])
+			val = c->channels == 1;
+		else if (s == &t31_codec_adc_on[19])
+			val = c->boost;
+		else if (s == &t31_codec_adc_on[20])
+			val = c->gain;
+		else if (s == &t31_codec_adc_on[21])
+			val = c->alc;
+
+		ret = regmap_update_bits(c->regmap, s->reg, mask, val << s->lsb);
+		if (ret)
+			return ret;
+		if (s->delay_ms)
+			msleep(s->delay_ms);
+	}
+
+	return 0;
+}
+
+static int t31_codec_rate_bits(unsigned int rate)
+{
+	switch (rate) {
+	case 8000:	return 7;
+	case 12000:	return 6;
+	case 16000:	return 5;
+	case 24000:	return 4;
+	case 32000:	return 3;
+	case 44100:	return 2;
+	case 48000:	return 1;
+	default:	return -EINVAL;
+	}
+}
+
+static int t31_codec_startup(struct snd_pcm_substream *substream,
+			     struct snd_soc_dai *dai)
+{
+	struct t31_codec *c = snd_soc_component_get_drvdata(dai->component);
+	int ret = 0;
+
+	mutex_lock(&c->lock);
+	if (!c->powered) {
+		ret = t31_codec_run(c, t31_codec_powerup,
+				    ARRAY_SIZE(t31_codec_powerup));
+		if (!ret)
+			c->powered = true;
+	}
+	mutex_unlock(&c->lock);
+
+	return ret;
+}
+
+static int t31_codec_hw_params(struct snd_pcm_substream *substream,
+			       struct snd_pcm_hw_params *params,
+			       struct snd_soc_dai *dai)
+{
+	struct t31_codec *c = snd_soc_component_get_drvdata(dai->component);
+
+	if (params_width(params) != 16)
+		return -EINVAL;
+
+	c->rate = params_rate(params);
+	c->channels = params_channels(params);
+
+	return 0;
+}
+
+static int t31_codec_prepare(struct snd_pcm_substream *substream,
+			     struct snd_soc_dai *dai)
+{
+	struct t31_codec *c = snd_soc_component_get_drvdata(dai->component);
+	int ret, bits;
+
+	bits = t31_codec_rate_bits(c->rate);
+	if (bits < 0)
+		return bits;
+
+	mutex_lock(&c->lock);
+	ret = regmap_update_bits(c->regmap, T31_CODEC_CSRR, GENMASK(2, 0), bits);
+	if (!ret && c->adc_on)
+		/* re-prepare after an xrun: only the interface mode */
+		ret = regmap_update_bits(c->regmap, T31_CODEC_CACR, BIT(0),
+					 c->channels == 1);
+	else if (!ret) {
+		ret = t31_codec_run(c, t31_codec_adc_on,
+				    ARRAY_SIZE(t31_codec_adc_on));
+		if (!ret)
+			c->adc_on = true;
+	}
+	mutex_unlock(&c->lock);
+
+	return ret;
+}
+
+static void t31_codec_shutdown(struct snd_pcm_substream *substream,
+			       struct snd_soc_dai *dai)
+{
+	struct t31_codec *c = snd_soc_component_get_drvdata(dai->component);
+
+	mutex_lock(&c->lock);
+	if (c->adc_on) {
+		t31_codec_run(c, t31_codec_adc_off,
+			      ARRAY_SIZE(t31_codec_adc_off));
+		c->adc_on = false;
+	}
+	mutex_unlock(&c->lock);
+}
+
+static const struct snd_soc_dai_ops t31_codec_dai_ops = {
+	.startup	= t31_codec_startup,
+	.hw_params	= t31_codec_hw_params,
+	.prepare	= t31_codec_prepare,
+	.shutdown	= t31_codec_shutdown,
+};
+
+static struct snd_soc_dai_driver t31_codec_dai = {
+	.name = "t31-codec-hifi",
+	.capture = {
+		.stream_name = "Capture",
+		.channels_min = 1,
+		.channels_max = 2,
+		.rates = T31_RATES,
+		.formats = SNDRV_PCM_FMTBIT_S16_LE,
+	},
+	.ops = &t31_codec_dai_ops,
+};
+
+/*
+ * The mixer values are kept in the driver state and written to the codec
+ * only while the ADC is on (before that the registers do not stick); the
+ * enable sequence takes them from the state.
+ */
+static int t31_codec_ctl_get(struct snd_kcontrol *kc,
+			     struct snd_ctl_elem_value *uc)
+{
+	struct snd_soc_component *comp = snd_kcontrol_chip(kc);
+	struct t31_codec *c = snd_soc_component_get_drvdata(comp);
+	struct soc_mixer_control *mc = (struct soc_mixer_control *)kc->private_value;
+	unsigned int v;
+
+	switch (mc->reg) {
+	case T31_CODEC_CALCGR:
+		v = c->gain;
+		break;
+	case T31_CODEC_CMICGAINR:
+		v = c->boost;
+		break;
+	default:
+		v = c->alc;
+		break;
+	}
+	uc->value.integer.value[0] = v;
+
+	return 0;
+}
+
+static int t31_codec_ctl_put(struct snd_kcontrol *kc,
+			     struct snd_ctl_elem_value *uc)
+{
+	struct snd_soc_component *comp = snd_kcontrol_chip(kc);
+	struct t31_codec *c = snd_soc_component_get_drvdata(comp);
+	struct soc_mixer_control *mc = (struct soc_mixer_control *)kc->private_value;
+	unsigned int v = uc->value.integer.value[0];
+	unsigned int *state, mask, shift;
+	int ret = 0;
+
+	if (v > mc->max)
+		return -EINVAL;
+
+	switch (mc->reg) {
+	case T31_CODEC_CALCGR:
+		state = &c->gain;
+		mask = GENMASK(4, 0);
+		shift = 0;
+		break;
+	case T31_CODEC_CMICGAINR:
+		state = &c->boost;
+		mask = GENMASK(7, 6);
+		shift = 6;
+		break;
+	default:
+		state = &c->alc;
+		mask = BIT(4);
+		shift = 4;
+		break;
+	}
+
+	mutex_lock(&c->lock);
+	if (*state == v) {
+		mutex_unlock(&c->lock);
+		return 0;
+	}
+	*state = v;
+	if (c->adc_on)
+		ret = regmap_update_bits(c->regmap, mc->reg, mask, v << shift);
+	mutex_unlock(&c->lock);
+
+	return ret ? ret : 1;
+}
+
+static const DECLARE_TLV_DB_SCALE(t31_codec_gain_tlv, -1800, 150, 0);
+
+static const struct snd_kcontrol_new t31_codec_controls[] = {
+	SOC_SINGLE_EXT_TLV("Mic Capture Volume", T31_CODEC_CALCGR, 0,
+			   T31_GAIN_MAX, 0, t31_codec_ctl_get,
+			   t31_codec_ctl_put, t31_codec_gain_tlv),
+	SOC_SINGLE_EXT("Mic Boost Capture Volume", T31_CODEC_CMICGAINR, 6,
+		       T31_BOOST_MAX, 0, t31_codec_ctl_get, t31_codec_ctl_put),
+	SOC_SINGLE_EXT("ALC Capture Switch", T31_CODEC_CMICCR, 4, 1, 0,
+		       t31_codec_ctl_get, t31_codec_ctl_put),
+};
+
+static const struct snd_soc_component_driver t31_codec_component = {
+	.controls		= t31_codec_controls,
+	.num_controls		= ARRAY_SIZE(t31_codec_controls),
+	.endianness		= 1,
+};
+
+static const struct regmap_config t31_codec_regmap_config = {
+	.reg_bits	= 32,
+	.reg_stride	= 4,
+	.val_bits	= 32,
+	.max_register	= T31_CODEC_MAX_REG,
+	.cache_type	= REGCACHE_NONE,
+};
+
+static int t31_codec_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct t31_codec *c;
+	void __iomem *regs;
+	struct clk *clk;
+
+	c = devm_kzalloc(dev, sizeof(*c), GFP_KERNEL);
+	if (!c)
+		return -ENOMEM;
+
+	regs = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(regs))
+		return PTR_ERR(regs);
+
+	c->regmap = devm_regmap_init_mmio(dev, regs, &t31_codec_regmap_config);
+	if (IS_ERR(c->regmap))
+		return PTR_ERR(c->regmap);
+
+	clk = devm_clk_get_enabled(dev, "aic");
+	if (IS_ERR(clk))
+		return PTR_ERR(clk);
+
+	mutex_init(&c->lock);
+	c->gain = T31_GAIN_DEFAULT;
+	c->boost = T31_BOOST_DEFAULT;
+	c->alc = 1;
+	c->rate = 16000;
+	c->channels = 1;
+	platform_set_drvdata(pdev, c);
+
+	return devm_snd_soc_register_component(dev, &t31_codec_component,
+					       &t31_codec_dai, 1);
+}
+
+static const struct of_device_id t31_codec_of_match[] = {
+	{ .compatible = "ingenic,t31-codec" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, t31_codec_of_match);
+
+static struct platform_driver t31_codec_driver = {
+	.probe = t31_codec_probe,
+	.driver = {
+		.name = "t31-codec",
+		.of_match_table = t31_codec_of_match,
+	},
+};
+module_platform_driver(t31_codec_driver);
+
+MODULE_DESCRIPTION("Ingenic T31 internal codec (capture only)");
+MODULE_LICENSE("GPL");
