From: Paul Philippov <paul@themactep.com>
Subject: [PATCH] pinctrl: ingenic: add the T20 CIM/DVP pin groups

The T20 DVP camera needs PA0-9 as the 10-bit data bus, PA14 as PCLK,
PA15 as the sensor MCLK, and PA16/PA17 as the sync inputs, all on
function 1.

Only the data bus was described so far, so the mainline pinctrl never
touched the MSK bit on PA14/15/16/17. PA15 stayed in GPIO mode, the
CIM clock never reached the pad, and the sensor NACKed every I2C
access.

Signed-off-by: Paul Philippov <paul@themactep.com>
---
--- a/drivers/pinctrl/pinctrl-ingenic.c
+++ b/drivers/pinctrl/pinctrl-ingenic.c
@@ -2852,6 +2852,12 @@
 static int t31_pwm_pwm2_pins[] = { 0x53, };
 static int t31_pwm_pwm3_pins[] = { 0x54, };
 
+static int t20_cim_data_pins[] = { 0x00, 0x01, 0x02, 0x03, 0x04,
+				   0x05, 0x06, 0x07, 0x08, 0x09, };
+static int t20_cim_pclk_pins[] = { 0x0e, };
+static int t20_cim_mclk_pins[] = { 0x0f, };
+static int t20_cim_sync_pins[] = { 0x10, 0x11, };
+
 static const struct group_desc t31_groups[] = {
 	INGENIC_PIN_GROUP("uart0-data-b", t31_uart0_data_b, 0),
 	INGENIC_PIN_GROUP("uart0-data-c", t31_uart0_data_c, 1),
@@ -2876,6 +2882,10 @@
 	INGENIC_PIN_GROUP("pwm1", t31_pwm_pwm1, 0),
 	INGENIC_PIN_GROUP("pwm2", t31_pwm_pwm2, 0),
 	INGENIC_PIN_GROUP("pwm3", t31_pwm_pwm3, 0),
+	INGENIC_PIN_GROUP("cim-data-10bit", t20_cim_data, 1),
+	INGENIC_PIN_GROUP("cim-pclk", t20_cim_pclk, 1),
+	INGENIC_PIN_GROUP("cim-mclk", t20_cim_mclk, 1),
+	INGENIC_PIN_GROUP("cim-sync", t20_cim_sync, 1),
 };
 
 static const char *t31_uart0_groups[] = {
@@ -2897,6 +2907,9 @@
 static const char *t31_pwm1_groups[] = { "pwm1", };
 static const char *t31_pwm2_groups[] = { "pwm2", };
 static const char *t31_pwm3_groups[] = { "pwm3", };
+static const char *t20_cim_groups[] = {
+	"cim-data-10bit", "cim-pclk", "cim-mclk", "cim-sync",
+};
 
 static const struct pinfunction t31_functions[] = {
 	INGENIC_PIN_FUNCTION("uart0", t31_uart0),
@@ -2912,6 +2925,7 @@
 	INGENIC_PIN_FUNCTION("pwm1", t31_pwm1),
 	INGENIC_PIN_FUNCTION("pwm2", t31_pwm2),
 	INGENIC_PIN_FUNCTION("pwm3", t31_pwm3),
+	INGENIC_PIN_FUNCTION("cim", t20_cim),
 };
 
 static const u32 t31_pull_ups[3] = {
