+	{ CCI_REG8(0x3903), 0x40 },
+	{ CCI_REG8(0x3909), 0x00 },
+	{ CCI_REG8(0x391f), 0x41 },
+	{ CCI_REG8(0x3926), 0xe0 },
+	{ CCI_REG8(0x3933), 0x80 },
+	{ CCI_REG8(0x3934), 0x02 },
+	{ CCI_REG8(0x3937), 0x6f },
+	{ CCI_REG8(0x3e00), 0x00 },
+	{ CCI_REG8(0x3e01), 0x95 },
+	{ CCI_REG8(0x3e02), 0x50 },
+	{ CCI_REG8(0x3e08), 0x00 },
+	{ CCI_REG8(0x4509), 0x20 },
+	{ CCI_REG8(0x450d), 0x07 },
+	{ CCI_REG8(0x4837), 0x33 },
+	{ CCI_REG8(0x5780), 0x76 },
+	{ CCI_REG8(0x5784), 0x10 },
+	{ CCI_REG8(0x5787), 0x0a },
+	{ CCI_REG8(0x5788), 0x0a },
+	{ CCI_REG8(0x5789), 0x08 },
+	{ CCI_REG8(0x578a), 0x0a },
+	{ CCI_REG8(0x578b), 0x0a },
+	{ CCI_REG8(0x578c), 0x08 },
