+
+static const struct sc231hai_mode sc231hai_modes[] = {
+	{
+		.width = SC231HAI_NATIVE_WIDTH,
+		.height = SC231HAI_NATIVE_HEIGHT,
+		.hblank = SC231HAI_HTS_MIN - SC231HAI_NATIVE_WIDTH,
+		.vblank = 1200 - SC231HAI_NATIVE_HEIGHT,
+		.regs = sc231hai_1920h30_regs,
+		.regs_num = ARRAY_SIZE(sc231hai_1920h30_regs),
+	},
+};
+
+struct sc231hai_ctrls {
+	struct v4l2_ctrl_handler handler;
+	struct v4l2_ctrl *pixel_rate;
+	struct v4l2_ctrl *link_freq;
+	struct v4l2_ctrl *hblank;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *gain;
+	struct v4l2_ctrl *vflip;
+};
+
+struct sc231hai {
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+
+	struct regmap *regmap;
+	struct clk *xclk;
+
+	struct gpio_desc *reset_gpio;
+	struct gpio_desc *powerdown_gpio;
+	struct regulator_bulk_data supplies[3];
+
+	struct sc231hai_ctrls ctrls;
+
+	const struct sc231hai_mode *mode;
+};
+
+static inline struct sc231hai *to_sc231hai(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct sc231hai, sd);
+}
+
+static inline struct v4l2_subdev *sc231hai_ctrl_to_sd(struct v4l2_ctrl *ctrl)
+{
+	return &container_of(ctrl->handler, struct sc231hai, ctrls.handler)->sd;
+}
+
+static void sc231hai_fill_format(const struct sc231hai_mode *mode,
+			       struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->code = MEDIA_BUS_FMT_SBGGR10_1X10;
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	fmt->quantization = V4L2_QUANTIZATION_DEFAULT;
+	fmt->xfer_func = V4L2_XFER_FUNC_DEFAULT;
+}
+
+static int sc231hai_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct v4l2_mbus_framefmt *fmt;
+	struct v4l2_rect *crop;
+
+	fmt = v4l2_subdev_state_get_format(state, 0);
+	sc231hai_fill_format(&sc231hai_modes[0], fmt);
+
+	crop = v4l2_subdev_state_get_crop(state, 0);
+	crop->left = 0;
+	crop->top = 0;
+	crop->width = sc231hai_modes[0].width;
+	crop->height = sc231hai_modes[0].height;
+
+	return 0;
+}
+
+static int sc231hai_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index != 0)
+		return -EINVAL;
+
+	code->code = MEDIA_BUS_FMT_SBGGR10_1X10;
+
+	return 0;
+}
+
+static int sc231hai_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index >= ARRAY_SIZE(sc231hai_modes))
+		return -EINVAL;
+
+	if (fse->code != MEDIA_BUS_FMT_SBGGR10_1X10)
+		return -EINVAL;
+
+	fse->min_width = sc231hai_modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = sc231hai_modes[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+static int sc231hai_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		sel->r = *v4l2_subdev_state_get_crop(state, 0);
+		return 0;
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = SC231HAI_NATIVE_WIDTH;
+		sel->r.height = SC231HAI_NATIVE_HEIGHT;
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static int sc231hai_set_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct sc231hai *sc231hai = to_sc231hai(sd);
+	const struct sc231hai_mode *mode;
+	struct v4l2_mbus_framefmt *framefmt;
+	struct v4l2_rect *crop;
+
+	mode = v4l2_find_nearest_size(sc231hai_modes, ARRAY_SIZE(sc231hai_modes),
+				      width, height,
+				      fmt->format.width, fmt->format.height);
+
+	sc231hai_fill_format(mode, &fmt->format);
+	framefmt = v4l2_subdev_state_get_format(state, fmt->pad);
+	*framefmt = fmt->format;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_ACTIVE) {
+		sc231hai->mode = mode;
+		__v4l2_ctrl_s_ctrl(sc231hai->ctrls.hblank, mode->hblank);
+		__v4l2_ctrl_s_ctrl(sc231hai->ctrls.vblank, mode->vblank);
+	}
+
+	crop = v4l2_subdev_state_get_crop(state, fmt->pad);
+	crop->left = 0;
+	crop->top = 0;
+	crop->width = mode->width;
+	crop->height = mode->height;
+
+	return 0;
+}
+
+static void sc231hai_exposure_update(struct sc231hai *sc231hai)
+{
+	unsigned int exposure_max;
+
+	exposure_max = sc231hai->ctrls.vblank->val + sc231hai->mode->height -
+		       SC231HAI_EXPOSURE_OFFSET;
+	exposure_max = min(exposure_max, 0xfffffU >> 5);
+
+	__v4l2_ctrl_modify_range(sc231hai->ctrls.exposure, 1, exposure_max, 1,
+				 exposure_max);
+}
+
+static int sc231hai_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct sc231hai *sc231hai = to_sc231hai(sc231hai_ctrl_to_sd(ctrl));
+
+	dev_dbg(sc231hai->sd.dev, "sc231hai: ctrl 0x%x = %d\n", ctrl->id, ctrl->val);
+	u32 hts;
+	int ret = 0;
+
+	if (ctrl->flags & V4L2_CTRL_FLAG_READ_ONLY)
+		return 0;
+
+	if (ctrl->id == V4L2_CID_VBLANK)
+		sc231hai_exposure_update(sc231hai);
+
+	if (!pm_runtime_get_if_in_use(sc231hai->sd.dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		ret = cci_write(sc231hai->regmap, SC231HAI_REG_EXPOSURE,
+				(u32)ctrl->val << 5, NULL);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+	{
+		const struct sc231hai_gain *gain = &sc231hai_gains[ctrl->val];
+
+		ret = cci_write(sc231hai->regmap, SC231HAI_REG_GAIN_3E08,
+				gain->reg_3e08, NULL);
+		ret = cci_write(sc231hai->regmap, SC231HAI_REG_GAIN_3E09,
+				gain->reg_3e09, &ret);
+		break;
+	}
+		break;
+	case V4L2_CID_HBLANK:
+		hts = ctrl->val + sc231hai->mode->width;
+		ret = cci_write(sc231hai->regmap, SC231HAI_REG_HTS, hts, NULL);
+		break;
+	case V4L2_CID_VBLANK:
+		ret = cci_write(sc231hai->regmap, SC231HAI_REG_VTS,
+				ctrl->val + sc231hai->mode->height, NULL);
+		break;
+	case V4L2_CID_VFLIP:
+		ret = cci_update_bits(sc231hai->regmap, SC231HAI_REG_FLIP,
+				      SC231HAI_FLIP_BOTH,
+				      ctrl->val ? SC231HAI_FLIP_BOTH : 0,
+				      NULL);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put_autosuspend(sc231hai->sd.dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops sc231hai_ctrl_ops = {
+	.s_ctrl = sc231hai_set_ctrl,
+};
+
+static int sc231hai_init_controls(struct sc231hai *sc231hai)
+{
+	struct v4l2_ctrl_handler *hdl = &sc231hai->ctrls.handler;
+	struct v4l2_fwnode_device_properties props;
+	const struct v4l2_ctrl_ops *ops = &sc231hai_ctrl_ops;
+	unsigned int hblank_max = SC231HAI_HTS_MAX - SC231HAI_NATIVE_WIDTH;
+	unsigned int vblank_max = SC231HAI_VTS_MAX - SC231HAI_NATIVE_HEIGHT;
+	int ret;
+
+	ret = v4l2_ctrl_handler_init(hdl, 10);
+	if (ret)
+		return ret;
+
+	sc231hai->ctrls.pixel_rate =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_PIXEL_RATE,
+				  SC231HAI_PIXEL_RATE, SC231HAI_PIXEL_RATE, 1,
+				  SC231HAI_PIXEL_RATE);
+
+	sc231hai->ctrls.link_freq =
+		v4l2_ctrl_new_int_menu(hdl, ops, V4L2_CID_LINK_FREQ, 0, 0,
+				       sc231hai_link_freqs);
+	if (sc231hai->ctrls.link_freq)
+		sc231hai->ctrls.link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	sc231hai->ctrls.exposure =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_EXPOSURE, 1,
+				  sc231hai_modes[0].vblank +
+				  sc231hai_modes[0].height -
+				  SC231HAI_EXPOSURE_OFFSET, 1,
+				  sc231hai_modes[0].vblank +
+				  sc231hai_modes[0].height -
+				  SC231HAI_EXPOSURE_OFFSET);
+
+	sc231hai->ctrls.gain =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_ANALOGUE_GAIN, 0,
+				  ARRAY_SIZE(sc231hai_gains) - 1, 1, 0);
+
+	sc231hai->ctrls.hblank =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_HBLANK,
+				  SC231HAI_HTS_MIN - SC231HAI_NATIVE_WIDTH,
+				  hblank_max, 1,
+				  sc231hai_modes[0].hblank);
+
+	sc231hai->ctrls.vblank =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_VBLANK,
+				  sc231hai_modes[0].vblank, vblank_max, 1,
+				  sc231hai_modes[0].vblank);
+
+	sc231hai->ctrls.vflip = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_VFLIP,
+						  0, 1, 1, 0);
+
+	if (hdl->error) {
+		ret = hdl->error;
+		goto error;
+	}
+
+	ret = v4l2_fwnode_device_parse(sc231hai->sd.dev, &props);
+	if (ret)
+		goto error;
+
+	ret = v4l2_ctrl_new_fwnode_properties(hdl, ops, &props);
+	if (ret)
+		goto error;
+
+	sc231hai->sd.ctrl_handler = hdl;
+
+	return 0;
+
+error:
+	v4l2_ctrl_handler_free(hdl);
+
+	return ret;
+}
+
+static int sc231hai_check_hwcfg(struct device *dev)
+{
+	struct v4l2_fwnode_endpoint ep = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	struct fwnode_handle *endpoint;
+	unsigned int i;
+	int ret;
+
+	endpoint = fwnode_graph_get_next_endpoint(dev_fwnode(dev), NULL);
+	if (!endpoint) {
+		dev_err(dev, "endpoint node not found\n");
+		return -EINVAL;
+	}
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(endpoint, &ep);
+	fwnode_handle_put(endpoint);
+	if (ret)
+		return ret;
+
+	if (ep.bus.mipi_csi2.num_data_lanes != 2) {
+		dev_err(dev, "only 2 data lanes are currently supported\n");
+		ret = -EINVAL;
+		goto out;
+	}
+
+	if (!ep.nr_of_link_frequencies) {
+		dev_err(dev, "link-frequency property not found in DT\n");
+		ret = -EINVAL;
+		goto out;
+	}
+
+	for (i = 0; i < ep.nr_of_link_frequencies; i++) {
+		if (ep.link_frequencies[i] == SC231HAI_LINK_FREQ)
+			break;
+	}
+
+	if (i == ep.nr_of_link_frequencies) {
+		dev_err(dev, "expected link frequency %u\n", SC231HAI_LINK_FREQ);
+		ret = -EINVAL;
+	}
+
+out:
+	v4l2_fwnode_endpoint_free(&ep);
+
+	return ret;
+}
+
+static int sc231hai_power_on(struct device *dev)
+{
+	dev_dbg(dev, "sc231hai: power on\n");
+	struct sc231hai *sc231hai = to_sc231hai(dev_get_drvdata(dev));
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(sc231hai->supplies),
+				    sc231hai->supplies);
+	if (ret)
+		return ret;
+
+	ret = clk_prepare_enable(sc231hai->xclk);
+	if (ret)
+		goto err_regulators;
+
+	/* The sensor needs MCLK while reset is released. */
+	gpiod_set_value_cansleep(sc231hai->powerdown_gpio, 0);
+	gpiod_set_value_cansleep(sc231hai->reset_gpio, 0);
+	msleep(20);
+
+	return 0;
+
+err_regulators:
+	regulator_bulk_disable(ARRAY_SIZE(sc231hai->supplies), sc231hai->supplies);
+
+	return ret;
+}
+
+static int sc231hai_power_off(struct device *dev)
+{
+	dev_dbg(dev, "sc231hai: power off\n");
+	struct sc231hai *sc231hai = to_sc231hai(dev_get_drvdata(dev));
+
+	gpiod_set_value_cansleep(sc231hai->reset_gpio, 1);
+	gpiod_set_value_cansleep(sc231hai->powerdown_gpio, 1);
+	clk_disable_unprepare(sc231hai->xclk);
+	regulator_bulk_disable(ARRAY_SIZE(sc231hai->supplies), sc231hai->supplies);
+
+	return 0;
+}
+
+static int sc231hai_identify_module(struct sc231hai *sc231hai)
+{
+	u64 id_h, id_l;
+	int ret;
+
+	ret = cci_read(sc231hai->regmap, SC231HAI_REG_CHIP_ID_H, &id_h, NULL);
+	if (ret)
+		return ret;
+
+	ret = cci_read(sc231hai->regmap, SC231HAI_REG_CHIP_ID_L, &id_l, NULL);
+	if (ret)
+		return ret;
+
+	if (id_h != SC231HAI_CHIP_ID_H || id_l != SC231HAI_CHIP_ID_L) {
+		dev_err(sc231hai->sd.dev, "chip id mismatch: %x%x != %x%x\n",
+			(u8)id_h, (u8)id_l, SC231HAI_CHIP_ID_H, SC231HAI_CHIP_ID_L);
+		return -EIO;
+	}
+
+	dev_info(sc231hai->sd.dev, "sc231hai: chip id %02x%02x\n", (u8)id_h, (u8)id_l);
+	return 0;
+}
+
+static int sc231hai_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state, u32 pad,
+				 u64 streams_mask)
+{
+	struct sc231hai *sc231hai = to_sc231hai(sd);
+
+	dev_info(sd->dev, "sc231hai: stream on\n");
+	int ret;
+
+	ret = pm_runtime_resume_and_get(sd->dev);
+	if (ret)
+		return ret;
+
+	cci_multi_reg_write(sc231hai->regmap, sc231hai->mode->regs,
+			    sc231hai->mode->regs_num, &ret);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = __v4l2_ctrl_handler_setup(&sc231hai->ctrls.handler);
+	if (ret)
+		goto err_rpm_put;
+
+	cci_write(sc231hai->regmap, SC231HAI_REG_STREAM, SC231HAI_STREAM_ON, &ret);
+	if (ret)
+		goto err_rpm_put;
+
+	return 0;
+
+err_rpm_put:
+	pm_runtime_put_autosuspend(sd->dev);
+
+	return ret;
+}
+
+static int sc231hai_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	dev_info(sd->dev, "sc231hai: stream off\n");
+	struct sc231hai *sc231hai = to_sc231hai(sd);
+	int ret = 0;
+
+	cci_write(sc231hai->regmap, SC231HAI_REG_STREAM, 0x00, &ret);
+	if (ret)
+		dev_err(sd->dev, "failed to stop streaming: %d\n", ret);
+
+	pm_runtime_put_autosuspend(sd->dev);
+
+	return ret;
+}
+
+static const struct v4l2_subdev_video_ops sc231hai_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops sc231hai_pad_ops = {
+	.enum_mbus_code = sc231hai_enum_mbus_code,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = sc231hai_set_pad_format,
+	.get_selection = sc231hai_get_selection,
+	.enum_frame_size = sc231hai_enum_frame_size,
+	.enable_streams = sc231hai_enable_streams,
+	.disable_streams = sc231hai_disable_streams,
+};
+
+static const struct v4l2_subdev_ops sc231hai_subdev_ops = {
+	.video = &sc231hai_video_ops,
+	.pad = &sc231hai_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops sc231hai_subdev_internal_ops = {
+	.init_state = sc231hai_init_state,
+};
+
+static const char * const sc231hai_supply_names[] = {
+	"iovdd",
+	"avdd",
+	"dvdd",
+};
+
+static int sc231hai_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+
+	dev_info(dev, "sc231hai: probe at i2c 0x%02x\n", client->addr);
+	struct sc231hai *sc231hai;
+	unsigned int i;
+	unsigned long xclk_freq;
+	int ret;
+
+	sc231hai = devm_kzalloc(dev, sizeof(*sc231hai), GFP_KERNEL);
+	if (!sc231hai)
+		return -ENOMEM;
+
+	v4l2_i2c_subdev_init(&sc231hai->sd, client, &sc231hai_subdev_ops);
+	sc231hai->sd.internal_ops = &sc231hai_subdev_internal_ops;
+
+	ret = sc231hai_check_hwcfg(dev);
+	if (ret)
+		return ret;
+
+	sc231hai->xclk = devm_v4l2_sensor_clk_get(dev, NULL);
+	if (IS_ERR(sc231hai->xclk))
+		return dev_err_probe(dev, PTR_ERR(sc231hai->xclk),
+				     "failed to get xclk\n");
+
+	xclk_freq = clk_get_rate(sc231hai->xclk);
+	if (xclk_freq != SC231HAI_XCLK_FREQ)
+		return dev_err_probe(dev, -EINVAL,
+				     "xclk frequency %lu Hz not supported\n",
+				     xclk_freq);
+
+	for (i = 0; i < ARRAY_SIZE(sc231hai->supplies); i++)
+		sc231hai->supplies[i].supply = sc231hai_supply_names[i];
+
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(sc231hai->supplies),
+				      sc231hai->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get regulators\n");
+
+	sc231hai->reset_gpio = devm_gpiod_get_optional(dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(sc231hai->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(sc231hai->reset_gpio),
+				     "failed to get reset gpio\n");
+
+	sc231hai->powerdown_gpio = devm_gpiod_get_optional(dev, "powerdown",
+							 GPIOD_OUT_HIGH);
+	if (IS_ERR(sc231hai->powerdown_gpio))
+		return dev_err_probe(dev, PTR_ERR(sc231hai->powerdown_gpio),
+				     "failed to get powerdown gpio\n");
+
+	sc231hai->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(sc231hai->regmap))
+		return dev_err_probe(dev, PTR_ERR(sc231hai->regmap),
+				     "failed to get cci regmap\n");
+
+	ret = sc231hai_power_on(dev);
+	if (ret)
+		return ret;
+
+	ret = sc231hai_identify_module(sc231hai);
+	if (ret)
+		goto err_power_off;
+
+	sc231hai->mode = &sc231hai_modes[0];
+
+	ret = sc231hai_init_controls(sc231hai);
+	if (ret)
+		goto err_power_off;
+
+	sc231hai->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	sc231hai->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	sc231hai->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&sc231hai->sd.entity, 1, &sc231hai->pad);
+	if (ret)
+		goto err_handler_free;
+
+	sc231hai->sd.state_lock = sc231hai->ctrls.handler.lock;
+	ret = v4l2_subdev_init_finalize(&sc231hai->sd);
+	if (ret)
+		goto err_media_entity;
+
+	pm_runtime_set_active(dev);
+	pm_runtime_get_noresume(dev);
+	pm_runtime_enable(dev);
+	pm_runtime_set_autosuspend_delay(dev, 1000);
+	pm_runtime_use_autosuspend(dev);
+	pm_runtime_put_autosuspend(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&sc231hai->sd);
+	if (ret)
+		goto err_subdev_cleanup;
+
+	return 0;
+
+err_subdev_cleanup:
+	v4l2_subdev_cleanup(&sc231hai->sd);
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+err_media_entity:
+	media_entity_cleanup(&sc231hai->sd.entity);
+err_handler_free:
+	v4l2_ctrl_handler_free(&sc231hai->ctrls.handler);
+err_power_off:
+	sc231hai_power_off(dev);
+
+	return ret;
+}
+
+static void sc231hai_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct sc231hai *sc231hai = to_sc231hai(sd);
+
+	v4l2_subdev_cleanup(sd);
+	v4l2_async_unregister_subdev(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&sc231hai->ctrls.handler);
+
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev))
+		sc231hai_power_off(&client->dev);
+	pm_runtime_set_suspended(&client->dev);
+}
+
+static const struct of_device_id sc231hai_dt_ids[] = {
+	{ .compatible = "smartens,sc231hai" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, sc231hai_dt_ids);
+
+static const struct i2c_device_id sc231hai_id[] = {
+	{ .name = "sc231hai" },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, sc231hai_id);
+
+static const struct dev_pm_ops sc231hai_pm_ops = {
+	RUNTIME_PM_OPS(sc231hai_power_off, sc231hai_power_on, NULL)
+};
+
+static struct i2c_driver sc231hai_i2c_driver = {
+	.driver = {
+		.name = "sc231hai",
+		.of_match_table = sc231hai_dt_ids,
+		.pm = pm_ptr(&sc231hai_pm_ops),
+	},
+	.probe = sc231hai_probe,
+	.remove = sc231hai_remove,
+	.id_table = sc231hai_id,
+};
+
+module_i2c_driver(sc231hai_i2c_driver);
+
+MODULE_DESCRIPTION("SmartSens SC231HAI sensor driver");
+MODULE_LICENSE("GPL");
