From: Paul Philippov <paul@themactep.com>
Subject: [PATCH] media: i2c: add the SmartSens SC231HAI sensor driver

Add a mainline V4L2 subdev driver for the SmartSens SC231HAI image
sensor. The mode register sequence and gain table are adapted from the
Ingenic vendor sensor driver (sensor_sc231hai_t31).

The driver uses the CCI register helpers, runtime PM, and the current
state-based subdev pad API. It exposes the full-resolution mode with
HBLANK/VBLANK, exposure, analogue gain, and mirror/flip controls where
the vendor driver provides them.

Signed-off-by: Paul Philippov <paul@themactep.com>
---
--- /dev/null
+++ b/drivers/media/i2c/sc231hai.c
@@ -0,0 +1,1108 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * SmartSens SC231HAI CMOS Image Sensor Driver
+ *
+ * The register sequences and gain table are adapted from the Ingenic
+ * vendor sensor driver (sensor_sc231hai_t31).
+ *
+ * WARNING: this driver has not been validated on hardware.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+#include <linux/units.h>
+
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-mediabus.h>
+
+#define SC231HAI_CHIP_ID_H			0xcb
+#define SC231HAI_CHIP_ID_L			0x6a
+
+#define SC231HAI_REG_CHIP_ID_H		CCI_REG8(0x3107)
+#define SC231HAI_REG_CHIP_ID_L		CCI_REG8(0x3108)
+
+#define SC231HAI_REG_SOFTWARE_RESET		CCI_REG8(0x0103)
+#define SC231HAI_REG_STREAM			CCI_REG8(0x0100)
+
+/* HTS/VTS are big-endian 16-bit values. */
+#define SC231HAI_REG_HTS			CCI_REG16(0x320c)
+#define SC231HAI_REG_VTS			CCI_REG16(0x320e)
+
+/*
+ * Exposure is a 20-bit value in units of half lines, laid out
+ * big-endian over 0x3e00..0x3e02.
+ */
+#define SC231HAI_REG_EXPOSURE		CCI_REG24(0x3e00)
+
+#define SC231HAI_REG_GAIN_3E08		CCI_REG8(0x3e08)
+#define SC231HAI_REG_GAIN_3E09		CCI_REG8(0x3e09)
+#define SC231HAI_REG_FLIP		CCI_REG8(0x3221)
+#define SC231HAI_FLIP_BOTH		0x60
+
+#define SC231HAI_STREAM_ON			0x01
+
+/* External clock is 24 MHz. */
+#define SC231HAI_XCLK_FREQ			(24 * HZ_PER_MHZ)
+
+#define SC231HAI_NATIVE_WIDTH		1920U
+#define SC231HAI_NATIVE_HEIGHT		1080U
+
+/* 2 lanes, 396 Mbit/s per lane. */
+#define SC231HAI_LINK_FREQ			198000000
+/* 2200 x 1200 pixels at 30 fps. */
+#define SC231HAI_PIXEL_RATE			79200000
+
+static const s64 sc231hai_link_freqs[] = {
+	SC231HAI_LINK_FREQ,
+};
+
+#define SC231HAI_HTS_MIN			2200U
+#define SC231HAI_HTS_MAX			0xffffU
+#define SC231HAI_VTS_MAX			0xffffU
+
+/* Number of lines by which exposure must be less than VTS. */
+#define SC231HAI_EXPOSURE_OFFSET		8
+
+struct sc231hai_gain {
+	u8 reg_3e08; u8 reg_3e09;
+};
