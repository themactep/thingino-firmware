From: Lu-Fi <noreply@github.com>
Subject: [PATCH] media: i2c: add the SmartSens SC5336 driver

V4L2 subdev driver for the SC5336 (Cinnado D1 T41NQ), built on the
sc4336p driver. The register sequence, gain table, chip-variant fixups
(reg 0x3040) and flip bits come from the Ingenic vendor sensor driver
(sensor_sc5336_t41): 2880x1620, MIPI 2 lanes at 864 Mbit/s, RAW10,
VTS 1800 at 30 fps, HTS at its reset value. Selected per camera from
the sensor name like the other Thingino sensor ports.

Signed-off-by: Lu-Fi <lutz@fiebach.de>
---
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -1066,6 +1066,16 @@
 	  To compile this driver as a module, choose M here: the
 	  module will be called sc4336.
 
+config VIDEO_SC5336
+	select V4L2_CCI_I2C
+	tristate "SmartSens SC5336 sensor support"
+	help
+	  This is a V4L2 sensor-level driver for the SmartSens SC5336
+	  camera sensor.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called sc5336.
+
 config VIDEO_SC4336P
 	select V4L2_CCI_I2C
 	tristate "SmartSens SC4336P sensor support"
--- a/drivers/media/i2c/Makefile
+++ b/drivers/media/i2c/Makefile
@@ -167,6 +167,7 @@
 obj-$(CONFIG_VIDEO_SC4236) += sc4236.o
 obj-$(CONFIG_VIDEO_SC4336) += sc4336.o
 obj-$(CONFIG_VIDEO_SC4336P) += sc4336p.o
+obj-$(CONFIG_VIDEO_SC5336) += sc5336.o
 obj-$(CONFIG_VIDEO_SC5235) += sc5235.o
 obj-$(CONFIG_VIDEO_GC8613) += gc8613.o
 obj-$(CONFIG_VIDEO_T4KA3) += t4ka3.o
--- /dev/null
+++ b/drivers/media/i2c/sc5336.c
@@ -0,0 +1,1143 @@
