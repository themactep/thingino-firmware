+/*
+ * SmartSens SC5336 CMOS Image Sensor Driver
+ *
+ * Based on the sc5336 driver. The register sequence, gain table, chip
+ * variant fixups and flip bits are adapted from the Ingenic vendor sensor
+ * driver (sensor_sc5336_t41): 2880x1620, MIPI 2 lanes, RAW10.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+#include <linux/units.h>
+
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-mediabus.h>
+
+#define SC5336_CHIP_ID_H			0xce
+#define SC5336_CHIP_ID_L			0x50
+
+#define SC5336_REG_CHIP_ID_H			CCI_REG8(0x3107)
+#define SC5336_REG_CHIP_ID_L			CCI_REG8(0x3108)
+
+#define SC5336_REG_STREAM			CCI_REG8(0x0100)
+
+/* HTS/VTS are big-endian 16-bit values. */
+#define SC5336_REG_HTS				CCI_REG16(0x320c)
+#define SC5336_REG_VTS_H			CCI_REG8(0x320e)
+#define SC5336_REG_VTS_L			CCI_REG8(0x320f)
+
+/* Exposure is a 16-bit value in units of 1 line, split 4/8/4 bits. */
+#define SC5336_REG_EXPOSURE_0			CCI_REG8(0x3e00)
+#define SC5336_REG_EXPOSURE_1			CCI_REG8(0x3e01)
+#define SC5336_REG_EXPOSURE_2			CCI_REG8(0x3e02)
+
+#define SC5336_REG_GAIN_L			CCI_REG8(0x3e07)
+#define SC5336_REG_GAIN_H			CCI_REG8(0x3e09)
+
+/* Chip variant: picks the analog settings applied before stream on */
+#define SC5336_REG_VARIANT			CCI_REG8(0x3040)
+
+#define SC5336_REG_FLIP				CCI_REG8(0x3221)
+#define SC5336_VFLIP_MASK			0x60
+#define SC5336_HFLIP_MASK			0x06
+
+#define SC5336_STREAM_ON			0x01
+
+/* External clock is 27 MHz. */
+#define SC5336_XCLK_FREQ			(27 * HZ_PER_MHZ)
+
+#define SC5336_NATIVE_WIDTH			2880U
+#define SC5336_NATIVE_HEIGHT			1620U
+
+/* 2 lanes, 864 Mbit/s per lane. */
+#define SC5336_LINK_FREQ			432000000
+/*
+ * 3200 x 1800 pixels at 30 fps. HTS (0x320c) counts 2 pixels and keeps
+ * its reset value 0x640, as the vendor driver does (it reads it, never
+ * writes it).
+ */
+#define SC5336_PIXEL_RATE			172800000
+
+static const s64 sc5336_link_freqs[] = {
+	SC5336_LINK_FREQ,
+};
+
+#define SC5336_HTS_MIN				3200U
+#define SC5336_HTS_MAX				0xffffU
+#define SC5336_VTS_MAX				0xffffU
+
+/* Number of lines by which exposure must be less than VTS. */
+#define SC5336_EXPOSURE_OFFSET			8
+
+struct sc5336_gain {
+	u8 reg_3e07;
+	u8 reg_3e09;
+};
+
