@@ -219,14 +220,6 @@
 	gpio_keys: gpio_keys {
 		compatible = "gpio-keys";
 
-		power {
-			label = "Power";
-			linux,code = <KEY_POWER>;
-			gpios = <&gpc 8 GPIO_ACTIVE_LOW INGENIC_GPIO_NOBIAS>;
-			linux,input-type = <1>;
-			gpio_key,wakeup = <1>;
-			debounce-interval = <100>;
-		};
 
 		bootsel0 {
 			label = "bootsel0";
