 	};
 };
 
@@ -106,13 +106,14 @@
 	bus-width = <4>;
 	voltage-ranges = <1800 3300>;
 	cd-inverted;
+	cd-gpios = <&gpb 26 GPIO_ACTIVE_LOW INGENIC_GPIO_NOBIAS>;
 
 	/* special property */
 	ingenic,wp-gpios = <0>;
-	ingenic,cd-gpios = <&gpb 27 GPIO_ACTIVE_LOW INGENIC_GPIO_NOBIAS>;
+	ingenic,cd-gpios = <&gpb 26 GPIO_ACTIVE_LOW INGENIC_GPIO_NOBIAS>;
 	ingenic,rst-gpios = <0>;
 	pinctrl-0 = <&msc0_pb>;
-	//mmc-pwrseq = <&mmc0_pwrseq>;
+	mmc-pwrseq = <&mmc0_pwrseq>;
 };
 
