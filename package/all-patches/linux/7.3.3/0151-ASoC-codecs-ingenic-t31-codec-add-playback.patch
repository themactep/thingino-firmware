Subject: [PATCH] ASoC: codecs: ingenic-t31-codec: add the playback stream

Add a playback stream to the T31 codec DAI.  The DAC / headphone-out
enable and disable sequences are the vendor ones (jz_t10_codec.c
codec_set_speaker() T31 branch and codec_turn_off(CODEC_WMODE)); the
enable runs from prepare(), the disable from shutdown() of the playback
substream.  The sequence is not repeated after an xrun, and the shared
CANACR[1:0] POP control is left alone on disable while capture runs.

- "Master Playback Volume" (CHR[4:0], 0..31, vendor default 0x18) is kept
  in the driver state and applied to the codec while the DAC is on
- optional "speaker-enable" GPIO for an external amplifier: driven
  inactive at probe (as the vendor probe does), active after the DAC
  sequence of an active playback stream and inactive again before the
  disable sequence.  Without the property the amplifier is not driven.
- one sample-rate register (CSRR) serves ADC and DAC: symmetric rates
- hw_params stores the channel count only for capture (CACR mono bit)

The capture path is unchanged.
---
--- a/sound/soc/codecs/ingenic-t31-codec.c
+++ b/sound/soc/codecs/ingenic-t31-codec.c
@@ -1,16 +1,18 @@
 // SPDX-License-Identifier: GPL-2.0
 /*
- * Ingenic T31 internal audio codec (capture only)
+ * Ingenic T31 internal audio codec
  *
  * The register sequences follow the vendor driver for the T31 (power-up,
- * microphone ADC enable/disable).  The codec is the I2S clock provider and
- * runs from fs * 256 supplied by the CGU.  There is no playback path on
- * purpose: no DAC or speaker amplifier is ever touched.
+ * microphone ADC and DAC/headphone-out enable/disable).  The codec is the
+ * I2S clock provider and runs from fs * 256 supplied by the CGU.  An
+ * optional external speaker amplifier enable GPIO ("speaker-enable") is
+ * driven only while a playback stream is prepared.
  */
 
 #include <linux/clk.h>
 #include <linux/delay.h>
 #include <linux/err.h>
+#include <linux/gpio/consumer.h>
 #include <linux/module.h>
 #include <linux/mutex.h>
 #include <linux/of.h>
@@ -28,12 +30,15 @@
 #define T31_CODEC_CDCR1		0x10
 #define T31_CODEC_CDCR2		0x14
 #define T31_CODEC_CGAINLR	0x24
+#define T31_CODEC_POWER		0x80
 #define T31_CODEC_CCR		0x84
 #define T31_CODEC_CAACR		0x88
 #define T31_CODEC_CMICCR	0x8c
 #define T31_CODEC_CMICGAINR	0x90
 #define T31_CODEC_CALCGR	0x94
 #define T31_CODEC_CANACR	0x98
+#define T31_CODEC_CANACR2	0x9c
+#define T31_CODEC_CHR		0xa0
 #define T31_CODEC_CSRR		0x110
 #define T31_CODEC_MAX_REG	0x130
 
@@ -46,6 +51,8 @@
 #define T31_GAIN_DEFAULT	0x0c
 #define T31_BOOST_MAX		3
 #define T31_BOOST_DEFAULT	2
+#define T31_VOL_MAX		31
+#define T31_VOL_DEFAULT		0x18
 
 struct t31_codec_step {
 	u16 reg;
@@ -111,11 +118,46 @@
 	{ T31_CODEC_CMICCR,	6, 6, 0x00, 10 },
 };
 
+/* playback (DAC and headphone out) enable, vendor jz_t10_codec.c:432-479 */
+static const struct t31_codec_step t31_codec_dac_on[] = {
+	{ T31_CODEC_POWER,	0, 2, 0x07, 0 },
+	{ T31_CODEC_CMICCR,	0, 3, 0x0f, 0 },
+	{ T31_CODEC_CANACR,	3, 3, 0x01, 10 },
+	{ T31_CODEC_CANACR,	2, 2, 0x01, 10 },
+	{ T31_CODEC_CANACR,	0, 1, 0x02, 10 },
+	{ T31_CODEC_CHR,	5, 5, 0x01, 10 },
+	{ T31_CODEC_CHR,	6, 6, 0x01, 10 },
+	{ T31_CODEC_CANACR2,	7, 7, 0x01, 10 },
+	{ T31_CODEC_CANACR2,	6, 6, 0x01, 10 },
+	{ T31_CODEC_CANACR2,	5, 5, 0x01, 10 },
+	{ T31_CODEC_CANACR2,	4, 4, 0x01, 10 },
+	{ T31_CODEC_CHR,	7, 7, 0x01, 10 },
+	{ T31_CODEC_CHR,	0, 4, 0x18, 10 },	/* volume: from the state */
+	{ T31_CODEC_CCR,	0, 6, 0x01, 10 },
+};
+
+/* vendor jz_t10_codec.c:660-690 */
+static const struct t31_codec_step t31_codec_dac_off[] = {
+	{ T31_CODEC_CHR,	0, 4, 0x00, 10 },
+	{ T31_CODEC_CHR,	7, 7, 0x00, 10 },
+	{ T31_CODEC_CHR,	6, 6, 0x00, 10 },
+	{ T31_CODEC_CHR,	5, 5, 0x00, 10 },
+	{ T31_CODEC_CANACR2,	5, 5, 0x00, 10 },
+	{ T31_CODEC_CANACR2,	6, 6, 0x00, 10 },
+	{ T31_CODEC_CANACR2,	7, 7, 0x00, 10 },
+	{ T31_CODEC_CANACR,	0, 1, 0x01, 10 },	/* skipped while capturing */
+	{ T31_CODEC_CANACR,	3, 3, 0x00, 10 },
+	{ T31_CODEC_CANACR2,	4, 4, 0x00, 10 },
+};
+
 struct t31_codec {
 	struct regmap *regmap;
+	struct gpio_desc *amp;
 	struct mutex lock;
 	bool powered;
 	bool adc_on;
+	bool dac_on;
+	unsigned int vol;
 	unsigned int rate;
 	unsigned int channels;
 	unsigned int gain;
@@ -141,6 +183,10 @@
 			val = c->gain;
 		else if (s == &t31_codec_adc_on[21])
 			val = c->alc;
+		else if (s == &t31_codec_dac_on[12])
+			val = c->vol;
+		else if (s == &t31_codec_dac_off[7] && c->adc_on)
+			continue;
 
 		ret = regmap_update_bits(c->regmap, s->reg, mask, val << s->lsb);
 		if (ret)
@@ -194,7 +240,8 @@
 		return -EINVAL;
 
 	c->rate = params_rate(params);
-	c->channels = params_channels(params);
+	if (substream->stream == SNDRV_PCM_STREAM_CAPTURE)
+		c->channels = params_channels(params);
 
 	return 0;
 }
@@ -211,7 +258,17 @@
 
 	mutex_lock(&c->lock);
 	ret = regmap_update_bits(c->regmap, T31_CODEC_CSRR, GENMASK(2, 0), bits);
-	if (!ret && c->adc_on)
+	if (!ret && substream->stream == SNDRV_PCM_STREAM_PLAYBACK) {
+		if (!c->dac_on) {
+			ret = t31_codec_run(c, t31_codec_dac_on,
+					    ARRAY_SIZE(t31_codec_dac_on));
+			if (!ret) {
+				c->dac_on = true;
+				/* the amplifier is switched on last (vendor order) */
+				gpiod_set_value_cansleep(c->amp, 1);
+			}
+		}
+	} else if (!ret && c->adc_on)
 		/* re-prepare after an xrun: only the interface mode */
 		ret = regmap_update_bits(c->regmap, T31_CODEC_CACR, BIT(0),
 					 c->channels == 1);
@@ -232,7 +289,15 @@
 	struct t31_codec *c = snd_soc_component_get_drvdata(dai->component);
 
 	mutex_lock(&c->lock);
-	if (c->adc_on) {
+	if (substream->stream == SNDRV_PCM_STREAM_PLAYBACK) {
+		if (c->dac_on) {
+			/* the amplifier is switched off first (vendor order) */
+			gpiod_set_value_cansleep(c->amp, 0);
+			t31_codec_run(c, t31_codec_dac_off,
+				      ARRAY_SIZE(t31_codec_dac_off));
+			c->dac_on = false;
+		}
+	} else if (c->adc_on) {
 		t31_codec_run(c, t31_codec_adc_off,
 			      ARRAY_SIZE(t31_codec_adc_off));
 		c->adc_on = false;
@@ -249,6 +314,13 @@
 
 static struct snd_soc_dai_driver t31_codec_dai = {
 	.name = "t31-codec-hifi",
+	.playback = {
+		.stream_name = "Playback",
+		.channels_min = 1,
+		.channels_max = 2,
+		.rates = T31_RATES,
+		.formats = SNDRV_PCM_FMTBIT_S16_LE,
+	},
 	.capture = {
 		.stream_name = "Capture",
 		.channels_min = 1,
@@ -257,6 +329,8 @@
 		.formats = SNDRV_PCM_FMTBIT_S16_LE,
 	},
 	.ops = &t31_codec_dai_ops,
+	/* one sample rate register (CSRR) for ADC and DAC */
+	.symmetric_rate = 1,
 };
 
 /*
@@ -279,6 +353,9 @@
 	case T31_CODEC_CMICGAINR:
 		v = c->boost;
 		break;
+	case T31_CODEC_CHR:
+		v = c->vol;
+		break;
 	default:
 		v = c->alc;
 		break;
@@ -312,6 +389,11 @@
 		mask = GENMASK(7, 6);
 		shift = 6;
 		break;
+	case T31_CODEC_CHR:
+		state = &c->vol;
+		mask = GENMASK(4, 0);
+		shift = 0;
+		break;
 	default:
 		state = &c->alc;
 		mask = BIT(4);
@@ -325,7 +407,7 @@
 		return 0;
 	}
 	*state = v;
-	if (c->adc_on)
+	if (mc->reg == T31_CODEC_CHR ? c->dac_on : c->adc_on)
 		ret = regmap_update_bits(c->regmap, mc->reg, mask, v << shift);
 	mutex_unlock(&c->lock);
 
@@ -342,6 +424,8 @@
 		       T31_BOOST_MAX, 0, t31_codec_ctl_get, t31_codec_ctl_put),
 	SOC_SINGLE_EXT("ALC Capture Switch", T31_CODEC_CMICCR, 4, 1, 0,
 		       t31_codec_ctl_get, t31_codec_ctl_put),
+	SOC_SINGLE_EXT("Master Playback Volume", T31_CODEC_CHR, 0,
+		       T31_VOL_MAX, 0, t31_codec_ctl_get, t31_codec_ctl_put),
 };
 
 static const struct snd_soc_component_driver t31_codec_component = {
@@ -381,7 +465,14 @@
 	if (IS_ERR(clk))
 		return PTR_ERR(clk);
 
+	/* optional: boards without a switchable amplifier have no such GPIO */
+	c->amp = devm_gpiod_get_optional(dev, "speaker-enable", GPIOD_OUT_LOW);
+	if (IS_ERR(c->amp))
+		return dev_err_probe(dev, PTR_ERR(c->amp),
+				     "speaker-enable GPIO\n");
+
 	mutex_init(&c->lock);
+	c->vol = T31_VOL_DEFAULT;
 	c->gain = T31_GAIN_DEFAULT;
 	c->boost = T31_BOOST_DEFAULT;
 	c->alc = 1;
@@ -408,5 +499,5 @@
 };
 module_platform_driver(t31_codec_driver);
 
-MODULE_DESCRIPTION("Ingenic T31 internal codec (capture only)");
+MODULE_DESCRIPTION("Ingenic T31 internal codec");
 MODULE_LICENSE("GPL");
--- a/sound/soc/codecs/Kconfig
+++ b/sound/soc/codecs/Kconfig
@@ -1189,10 +1189,11 @@
 	depends on MACH_INGENIC || COMPILE_TEST
 	depends on OF
 	select REGMAP_MMIO
-	tristate "Ingenic T31 internal CODEC (capture only)"
+	tristate "Ingenic T31 internal CODEC"
 	help
-	  Enable support for the microphone input of the internal CODEC
-	  found in the T31 SoC from Ingenic.  There is no playback path.
+	  Enable support for the internal CODEC found in the T31 SoC from
+	  Ingenic: microphone input and DAC/headphone output with an
+	  optional speaker amplifier enable GPIO.
 
 	  This driver can also be built as a module. If so, the module
 	  will be called snd-soc-ingenic-t31-codec.
