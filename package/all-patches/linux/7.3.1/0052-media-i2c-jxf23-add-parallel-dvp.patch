From: Paul Philippov <paul@themactep.com>
Subject: [PATCH] media: i2c: jxf23: support the T20 10-bit parallel bus

The T20 Wyze Cam 2 wires the JXF23 as a 10-bit DVP sensor on I2C0
at 0x40 with a 24 MHz cgu_cim clock and an active-low PA18 reset.

Accept a parallel endpoint and use the BGGR10 media bus code. The T20
DVP module has its own power/clock sequence: the vendor keeps PLL 0x10
at 0x48, waits 500 ms after 0x48=0x85, then writes 0x48=0x05,
0x1f=0x01, the 0x99/0x9b padding registers and 0x12=0x00. Use it
instead of the T31 MIPI sequence when the endpoint is parallel, and
write 0x12=0x40 on stream off.

Also accept the 24 MHz clock window, pulse the reset like the vendor
sensor module, and read the T20 chip ID from 0x0a/0x0b (0xf0/0xf1 is
the T31 MIPI variant). The CSI-2 path used by T31 is unchanged.

Signed-off-by: Paul Philippov <paul@themactep.com>
---
--- a/drivers/media/i2c/jxf23.c
+++ b/drivers/media/i2c/jxf23.c
@@ -257,6 +257,111 @@
 	{ CCI_REG8(0x48), 0x0a },
 };
 
+/*
+ * The T20 DVP module uses a different power/clock sequence from the T31 MIPI
+ * module: it keeps PLL 0x10 at 0x48, waits 500 ms after 0x48=0x85, and then
+ * writes 0x48=0x05, 0x1f=0x01 and the two 0x99/0x9b padding registers.
+ */
+static const struct cci_reg_sequence jxf23_1080p25_dvp_regs[] = {
+	{ CCI_REG8(0x0e), 0x11 },
+	{ CCI_REG8(0x0f), 0x14 },
+	{ CCI_REG8(0x10), 0x40 },
+	{ CCI_REG8(0x11), 0x80 },
+	{ CCI_REG8(0x48), 0x05 },
+	{ CCI_REG8(0x96), 0xaa },
+	{ CCI_REG8(0x94), 0xc0 },
+	{ CCI_REG8(0x97), 0x8d },
+	{ CCI_REG8(0x96), 0x00 },
+	{ CCI_REG8(0x12), 0x40 },
+	{ CCI_REG8(0x0e), 0x11 },
+	{ CCI_REG8(0x0f), 0x14 },
+	{ CCI_REG8(0x10), 0x48 },
+	{ CCI_REG8(0x11), 0x80 },
+	{ CCI_REG8(0x0d), 0x50 },
+	{ CCI_REG8(0x5f), 0x41 },
+	{ CCI_REG8(0x60), 0x20 },
+	{ CCI_REG8(0x58), 0x12 },
+	{ CCI_REG8(0x57), 0x60 },
+	{ CCI_REG8(0x9d), 0x00 },
+	{ CCI_REG8(0x20), 0x00 },
+	{ CCI_REG8(0x21), 0x05 },
+	{ CCI_REG8(0x22), 0x46 },
+	{ CCI_REG8(0x23), 0x05 },
+	{ CCI_REG8(0x24), 0xc0 },
+	{ CCI_REG8(0x25), 0x38 },
+	{ CCI_REG8(0x26), 0x43 },
+	{ CCI_REG8(0x27), 0xc3 },
+	{ CCI_REG8(0x28), 0x19 },
+	{ CCI_REG8(0x29), 0x04 },
+	{ CCI_REG8(0x2c), 0x00 },
+	{ CCI_REG8(0x2d), 0x00 },
+	{ CCI_REG8(0x2e), 0x18 },
+	{ CCI_REG8(0x2f), 0x44 },
+	{ CCI_REG8(0x41), 0xc9 },
+	{ CCI_REG8(0x42), 0x13 },
+	{ CCI_REG8(0x46), 0x00 },
+	{ CCI_REG8(0x76), 0x60 },
+	{ CCI_REG8(0x77), 0x09 },
+	{ CCI_REG8(0x1d), 0xff },
+	{ CCI_REG8(0x1e), 0x9f },
+	{ CCI_REG8(0x6c), 0xc0 },
+	{ CCI_REG8(0x2a), 0xb1 },
+	{ CCI_REG8(0x2b), 0x24 },
+	{ CCI_REG8(0x31), 0x08 },
+	{ CCI_REG8(0x32), 0x4f },
+	{ CCI_REG8(0x33), 0x20 },
+	{ CCI_REG8(0x34), 0x5e },
+	{ CCI_REG8(0x35), 0x5e },
+	{ CCI_REG8(0x3a), 0xaf },
+	{ CCI_REG8(0x56), 0x32 },
+	{ CCI_REG8(0x59), 0xbf },
+	{ CCI_REG8(0x5a), 0x04 },
+	{ CCI_REG8(0x85), 0x5a },
+	{ CCI_REG8(0x8a), 0x04 },
+	{ CCI_REG8(0x8f), 0x90 },
+	{ CCI_REG8(0x91), 0x13 },
+	{ CCI_REG8(0x5b), 0xa0 },
+	{ CCI_REG8(0x5c), 0xf0 },
+	{ CCI_REG8(0x5d), 0xf4 },
+	{ CCI_REG8(0x5e), 0x1f },
+	{ CCI_REG8(0x62), 0x04 },
+	{ CCI_REG8(0x63), 0x0f },
+	{ CCI_REG8(0x64), 0xc0 },
+	{ CCI_REG8(0x66), 0x44 },
+	{ CCI_REG8(0x67), 0x73 },
+	{ CCI_REG8(0x69), 0x7c },
+	{ CCI_REG8(0x6a), 0x28 },
+	{ CCI_REG8(0x7a), 0xc0 },
+	{ CCI_REG8(0x4a), 0x05 },
+	{ CCI_REG8(0x7e), 0xcd },
+	{ CCI_REG8(0x49), 0x10 },
+	{ CCI_REG8(0x50), 0x02 },
+	{ CCI_REG8(0x7b), 0x4a },
+	{ CCI_REG8(0x7c), 0x0c },
+	{ CCI_REG8(0x7f), 0x57 },
+	{ CCI_REG8(0x90), 0x00 },
