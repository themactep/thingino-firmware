+
+#define SC4336_HTS_MIN				2800U
+#define SC4336_HTS_MAX				0xffffU
+#define SC4336_VTS_MAX				0xffffU
+
+/* Number of lines by which exposure must be less than VTS. */
+#define SC4336_EXPOSURE_OFFSET			4
