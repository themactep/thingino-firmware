+
+#define SC4336_STREAM_ON			0x01
+
+/* External clock is 27 MHz. */
+#define SC4336_XCLK_FREQ			(27 * HZ_PER_MHZ)
+
+#define SC4336_NATIVE_WIDTH			2560U
+#define SC4336_NATIVE_HEIGHT			1440U
+
+/* 2 lanes, 630 Mbit/s per lane. */
+#define SC4336_LINK_FREQ			315000000
+/* 2800 x 1500 pixels at 30 fps. */
+#define SC4336_PIXEL_RATE			126000000
