+
+static const struct gc8613_mode gc8613_modes[] = {
+	{
+		.width = GC8613_NATIVE_WIDTH,
+		.height = GC8613_NATIVE_HEIGHT,
+		.hblank = 3934 - GC8613_NATIVE_WIDTH,
+		.vblank = 2250 - GC8613_NATIVE_HEIGHT,
+		.hts_reg = 0x0320,
+		.regs = gc8613_2160p25_regs,
+		.regs_num = ARRAY_SIZE(gc8613_2160p25_regs),
+	},
+};
+
+struct gc8613_ctrls {
+	struct v4l2_ctrl_handler handler;
+	struct v4l2_ctrl *pixel_rate;
+	struct v4l2_ctrl *link_freq;
+	struct v4l2_ctrl *hblank;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *gain;
+};
+
+struct gc8613 {
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+
+	struct regmap *regmap;
+	struct clk *xclk;
+
+	struct gpio_desc *reset_gpio;
+	struct gpio_desc *powerdown_gpio;
+	struct regulator_bulk_data supplies[3];
+
+	struct gc8613_ctrls ctrls;
+
+	const struct gc8613_mode *mode;
+};
+
+static inline struct gc8613 *to_gc8613(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct gc8613, sd);
+}
+
+static inline struct v4l2_subdev *gc8613_ctrl_to_sd(struct v4l2_ctrl *ctrl)
+{
+	return &container_of(ctrl->handler, struct gc8613, ctrls.handler)->sd;
+}
+
+static void gc8613_fill_format(const struct gc8613_mode *mode,
+			       struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->code = MEDIA_BUS_FMT_SRGGB10_1X10;
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	fmt->quantization = V4L2_QUANTIZATION_DEFAULT;
+	fmt->xfer_func = V4L2_XFER_FUNC_DEFAULT;
+}
+
+static int gc8613_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct v4l2_mbus_framefmt *fmt;
+	struct v4l2_rect *crop;
+
+	fmt = v4l2_subdev_state_get_format(state, 0);
+	gc8613_fill_format(&gc8613_modes[0], fmt);
+
+	crop = v4l2_subdev_state_get_crop(state, 0);
+	crop->left = 0;
+	crop->top = 0;
+	crop->width = gc8613_modes[0].width;
+	crop->height = gc8613_modes[0].height;
+
+	return 0;
+}
+
+static int gc8613_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index != 0)
+		return -EINVAL;
+
+	code->code = MEDIA_BUS_FMT_SRGGB10_1X10;
+
+	return 0;
+}
+
+static int gc8613_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index >= ARRAY_SIZE(gc8613_modes))
+		return -EINVAL;
+
+	if (fse->code != MEDIA_BUS_FMT_SRGGB10_1X10)
+		return -EINVAL;
+
+	fse->min_width = gc8613_modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = gc8613_modes[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+static int gc8613_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		sel->r = *v4l2_subdev_state_get_crop(state, 0);
+		return 0;
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = GC8613_NATIVE_WIDTH;
+		sel->r.height = GC8613_NATIVE_HEIGHT;
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static int gc8613_set_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct gc8613 *gc8613 = to_gc8613(sd);
+	const struct gc8613_mode *mode;
+	struct v4l2_mbus_framefmt *framefmt;
+	struct v4l2_rect *crop;
+
+	mode = v4l2_find_nearest_size(gc8613_modes, ARRAY_SIZE(gc8613_modes),
+				      width, height,
+				      fmt->format.width, fmt->format.height);
+
+	gc8613_fill_format(mode, &fmt->format);
+	framefmt = v4l2_subdev_state_get_format(state, fmt->pad);
+	*framefmt = fmt->format;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_ACTIVE) {
+		gc8613->mode = mode;
+		__v4l2_ctrl_s_ctrl(gc8613->ctrls.hblank, mode->hblank);
+		__v4l2_ctrl_s_ctrl(gc8613->ctrls.vblank, mode->vblank);
+	}
+
+	crop = v4l2_subdev_state_get_crop(state, fmt->pad);
+	crop->left = 0;
+	crop->top = 0;
+	crop->width = mode->width;
+	crop->height = mode->height;
+
+	return 0;
+}
+
+static void gc8613_exposure_update(struct gc8613 *gc8613)
+{
+	unsigned int exposure_max;
+
+	exposure_max = gc8613->ctrls.vblank->val + gc8613->mode->height -
+		       GC8613_EXPOSURE_OFFSET;
+	exposure_max = min(exposure_max, GC8613_VTS_MAX - GC8613_EXPOSURE_OFFSET);
+
+	__v4l2_ctrl_modify_range(gc8613->ctrls.exposure, 1, exposure_max, 1,
+				 exposure_max);
+}
+
+static int gc8613_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct gc8613 *gc8613 = to_gc8613(gc8613_ctrl_to_sd(ctrl));
+
+	dev_dbg(gc8613->sd.dev, "gc8613: ctrl 0x%x = %d\n", ctrl->id, ctrl->val);
+	int ret = 0;
+
+	if (ctrl->flags & V4L2_CTRL_FLAG_READ_ONLY)
+		return 0;
+
+	if (ctrl->id == V4L2_CID_VBLANK)
+		gc8613_exposure_update(gc8613);
+
+	if (!pm_runtime_get_if_in_use(gc8613->sd.dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		ret = cci_write(gc8613->regmap, GC8613_REG_EXPOSURE,
+				ctrl->val, NULL);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN: {
+		const struct gc8613_gain *gain = &gc8613_gains[ctrl->val];
+
+		ret = cci_write(gc8613->regmap, GC8613_REG_GAIN_CTRL,
+				0x2d, NULL);
+		ret = cci_write(gc8613->regmap, GC8613_REG_GAIN_614,
+				gain->reg_614, &ret);
+		ret = cci_write(gc8613->regmap, GC8613_REG_GAIN_615,
+				gain->reg_615, &ret);
+		ret = cci_write(gc8613->regmap, GC8613_REG_GAIN_CTRL,
+				0x28, &ret);
+		ret = cci_write(gc8613->regmap, GC8613_REG_GAIN_225,
+				gain->reg_225, &ret);
+		ret = cci_write(gc8613->regmap, GC8613_REG_GAIN_1467,
+				gain->reg_1467, &ret);
+		ret = cci_write(gc8613->regmap, GC8613_REG_GAIN_1468,
+				gain->reg_1468, &ret);
+		ret = cci_write(gc8613->regmap, GC8613_REG_GAIN_1447,
+				gain->reg_1447, &ret);
+		break;
+	}
+	case V4L2_CID_HBLANK:
+		ret = cci_write(gc8613->regmap, GC8613_REG_HTS,
+				gc8613->mode->hts_reg, NULL);
+		break;
+	case V4L2_CID_VBLANK:
+		ret = cci_write(gc8613->regmap, GC8613_REG_VTS,
+				ctrl->val + gc8613->mode->height, NULL);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put_autosuspend(gc8613->sd.dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops gc8613_ctrl_ops = {
+	.s_ctrl = gc8613_set_ctrl,
+};
+
+static int gc8613_init_controls(struct gc8613 *gc8613)
+{
+	struct v4l2_ctrl_handler *hdl = &gc8613->ctrls.handler;
+	struct v4l2_fwnode_device_properties props;
+	const struct v4l2_ctrl_ops *ops = &gc8613_ctrl_ops;
+	unsigned int hblank_max = GC8613_HTS_MAX - GC8613_NATIVE_WIDTH;
+	unsigned int vblank_max = GC8613_VTS_MAX - GC8613_NATIVE_HEIGHT;
+	int ret;
+
+	ret = v4l2_ctrl_handler_init(hdl, 10);
+	if (ret)
+		return ret;
+
+	gc8613->ctrls.pixel_rate =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_PIXEL_RATE,
+				  GC8613_PIXEL_RATE, GC8613_PIXEL_RATE, 1,
+				  GC8613_PIXEL_RATE);
+
+	gc8613->ctrls.link_freq =
+		v4l2_ctrl_new_int_menu(hdl, ops, V4L2_CID_LINK_FREQ, 0, 0,
+				       gc8613_link_freqs);
+	if (gc8613->ctrls.link_freq)
+		gc8613->ctrls.link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	gc8613->ctrls.exposure =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_EXPOSURE, 1,
+				  gc8613_modes[0].vblank +
+				  gc8613_modes[0].height -
+				  GC8613_EXPOSURE_OFFSET, 1,
+				  gc8613_modes[0].vblank +
+				  gc8613_modes[0].height -
+				  GC8613_EXPOSURE_OFFSET);
+
+	gc8613->ctrls.gain =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_ANALOGUE_GAIN, 0,
+				  ARRAY_SIZE(gc8613_gains) - 1, 1, 0);
+
+	gc8613->ctrls.hblank =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_HBLANK,
+				  GC8613_HTS_MIN - GC8613_NATIVE_WIDTH,
+				  hblank_max, 1,
+				  gc8613_modes[0].hblank);
+
+	gc8613->ctrls.vblank =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_VBLANK,
+				  gc8613_modes[0].vblank, vblank_max, 1,
+				  gc8613_modes[0].vblank);
+
+	if (hdl->error) {
+		ret = hdl->error;
+		goto error;
+	}
+
+	ret = v4l2_fwnode_device_parse(gc8613->sd.dev, &props);
+	if (ret)
+		goto error;
+
+	ret = v4l2_ctrl_new_fwnode_properties(hdl, ops, &props);
+	if (ret)
+		goto error;
+
+	gc8613->sd.ctrl_handler = hdl;
+
+	return 0;
+
+error:
+	v4l2_ctrl_handler_free(hdl);
+
+	return ret;
+}
+
+static int gc8613_check_hwcfg(struct device *dev)
+{
+	struct v4l2_fwnode_endpoint ep = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	struct fwnode_handle *endpoint;
+	unsigned int i;
+	int ret;
+
+	endpoint = fwnode_graph_get_next_endpoint(dev_fwnode(dev), NULL);
+	if (!endpoint) {
+		dev_err(dev, "endpoint node not found\n");
+		return -EINVAL;
+	}
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(endpoint, &ep);
+	fwnode_handle_put(endpoint);
+	if (ret)
+		return ret;
+
+	if (ep.bus.mipi_csi2.num_data_lanes != 2) {
+		dev_err(dev, "only 2 data lanes are currently supported\n");
+		ret = -EINVAL;
+		goto out;
+	}
+
+	if (!ep.nr_of_link_frequencies) {
+		dev_err(dev, "link-frequency property not found in DT\n");
+		ret = -EINVAL;
+		goto out;
+	}
+
+	for (i = 0; i < ep.nr_of_link_frequencies; i++) {
+		if (ep.link_frequencies[i] == GC8613_LINK_FREQ)
+			break;
+	}
+
+	if (i == ep.nr_of_link_frequencies) {
+		dev_err(dev, "expected link frequency %u\n", GC8613_LINK_FREQ);
+		ret = -EINVAL;
+	}
+
+out:
+	v4l2_fwnode_endpoint_free(&ep);
+
+	return ret;
+}
+
+static int gc8613_power_on(struct device *dev)
+{
+	dev_dbg(dev, "gc8613: power on\n");
+	struct gc8613 *gc8613 = to_gc8613(dev_get_drvdata(dev));
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(gc8613->supplies),
+				    gc8613->supplies);
+	if (ret)
+		return ret;
+
+	ret = clk_prepare_enable(gc8613->xclk);
+	if (ret)
+		goto err_regulators;
+
+	/* The sensor needs MCLK while reset is released. */
+	gpiod_set_value_cansleep(gc8613->powerdown_gpio, 0);
+	gpiod_set_value_cansleep(gc8613->reset_gpio, 0);
+	msleep(20);
+
+	return 0;
+
+err_regulators:
+	regulator_bulk_disable(ARRAY_SIZE(gc8613->supplies), gc8613->supplies);
+
+	return ret;
+}
+
+static int gc8613_power_off(struct device *dev)
+{
+	dev_dbg(dev, "gc8613: power off\n");
+	struct gc8613 *gc8613 = to_gc8613(dev_get_drvdata(dev));
+
+	gpiod_set_value_cansleep(gc8613->reset_gpio, 1);
+	gpiod_set_value_cansleep(gc8613->powerdown_gpio, 1);
+	clk_disable_unprepare(gc8613->xclk);
+	regulator_bulk_disable(ARRAY_SIZE(gc8613->supplies), gc8613->supplies);
+
+	return 0;
+}
+
+static int gc8613_identify_module(struct gc8613 *gc8613)
+{
+	u64 id_h, id_l;
+	int ret;
+
+	ret = cci_read(gc8613->regmap, GC8613_REG_CHIP_ID_H, &id_h, NULL);
+	if (ret)
+		return ret;
+
+	ret = cci_read(gc8613->regmap, GC8613_REG_CHIP_ID_L, &id_l, NULL);
+	if (ret)
+		return ret;
+
+	if (id_h != GC8613_CHIP_ID_H || id_l != GC8613_CHIP_ID_L) {
+		dev_err(gc8613->sd.dev, "chip id mismatch: %x%x != %x%x\n",
+			(u8)id_h, (u8)id_l, GC8613_CHIP_ID_H, GC8613_CHIP_ID_L);
+		return -EIO;
+	}
+
+	dev_info(gc8613->sd.dev, "gc8613: chip id %02x%02x\n", (u8)id_h, (u8)id_l);
+	return 0;
+}
+
+static int gc8613_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state, u32 pad,
+				 u64 streams_mask)
+{
+	struct gc8613 *gc8613 = to_gc8613(sd);
+
+	dev_info(sd->dev, "gc8613: stream on\n");
+	int ret;
+
+	ret = pm_runtime_resume_and_get(sd->dev);
+	if (ret)
+		return ret;
+
+	cci_multi_reg_write(gc8613->regmap, gc8613->mode->regs,
+			    gc8613->mode->regs_num, &ret);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = __v4l2_ctrl_handler_setup(&gc8613->ctrls.handler);
+	if (ret)
+		goto err_rpm_put;
+
+	/*
+	 * The legacy stream-on array is empty: the init sequence ends with
+	 * 0x0100 = 0x09, which starts streaming.
+	 */
+
+	return 0;
+
+err_rpm_put:
+	pm_runtime_put_autosuspend(sd->dev);
+
+	return ret;
+}
+
+static int gc8613_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	dev_info(sd->dev, "gc8613: stream off\n");
+	/* The legacy stream-off array is empty. */
+	pm_runtime_put_autosuspend(sd->dev);
+
+	return 0;
+}
+
+static const struct v4l2_subdev_video_ops gc8613_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops gc8613_pad_ops = {
+	.enum_mbus_code = gc8613_enum_mbus_code,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = gc8613_set_pad_format,
+	.get_selection = gc8613_get_selection,
+	.enum_frame_size = gc8613_enum_frame_size,
+	.enable_streams = gc8613_enable_streams,
+	.disable_streams = gc8613_disable_streams,
+};
+
+static const struct v4l2_subdev_ops gc8613_subdev_ops = {
+	.video = &gc8613_video_ops,
+	.pad = &gc8613_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops gc8613_subdev_internal_ops = {
+	.init_state = gc8613_init_state,
+};
+
+static const char * const gc8613_supply_names[] = {
+	"iovdd",
+	"avdd",
+	"dvdd",
+};
+
+static int gc8613_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+
+	dev_info(dev, "gc8613: probe at i2c 0x%02x\n", client->addr);
+	struct gc8613 *gc8613;
+	unsigned int i;
+	unsigned long xclk_freq;
+	int ret;
+
+	gc8613 = devm_kzalloc(dev, sizeof(*gc8613), GFP_KERNEL);
+	if (!gc8613)
+		return -ENOMEM;
+
+	v4l2_i2c_subdev_init(&gc8613->sd, client, &gc8613_subdev_ops);
+	gc8613->sd.internal_ops = &gc8613_subdev_internal_ops;
+
+	ret = gc8613_check_hwcfg(dev);
+	if (ret)
+		return ret;
+
+	gc8613->xclk = devm_v4l2_sensor_clk_get(dev, NULL);
+	if (IS_ERR(gc8613->xclk))
+		return dev_err_probe(dev, PTR_ERR(gc8613->xclk),
+				     "failed to get xclk\n");
+
+	xclk_freq = clk_get_rate(gc8613->xclk);
+	if (xclk_freq != GC8613_XCLK_FREQ)
+		return dev_err_probe(dev, -EINVAL,
+				     "xclk frequency %lu Hz not supported\n",
+				     xclk_freq);
+
+	for (i = 0; i < ARRAY_SIZE(gc8613->supplies); i++)
+		gc8613->supplies[i].supply = gc8613_supply_names[i];
+
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(gc8613->supplies),
+				      gc8613->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get regulators\n");
+
+	gc8613->reset_gpio = devm_gpiod_get_optional(dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(gc8613->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(gc8613->reset_gpio),
+				     "failed to get reset gpio\n");
+
+	gc8613->powerdown_gpio = devm_gpiod_get_optional(dev, "powerdown",
+							 GPIOD_OUT_HIGH);
+	if (IS_ERR(gc8613->powerdown_gpio))
+		return dev_err_probe(dev, PTR_ERR(gc8613->powerdown_gpio),
+				     "failed to get powerdown gpio\n");
+
+	gc8613->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(gc8613->regmap))
+		return dev_err_probe(dev, PTR_ERR(gc8613->regmap),
+				     "failed to get cci regmap\n");
+
+	ret = gc8613_power_on(dev);
+	if (ret)
+		return ret;
+
+	ret = gc8613_identify_module(gc8613);
+	if (ret)
+		goto err_power_off;
+
+	gc8613->mode = &gc8613_modes[0];
+
+	ret = gc8613_init_controls(gc8613);
+	if (ret)
+		goto err_power_off;
+
+	gc8613->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	gc8613->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	gc8613->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&gc8613->sd.entity, 1, &gc8613->pad);
+	if (ret)
+		goto err_handler_free;
+
+	gc8613->sd.state_lock = gc8613->ctrls.handler.lock;
+	ret = v4l2_subdev_init_finalize(&gc8613->sd);
+	if (ret)
+		goto err_media_entity;
+
+	pm_runtime_set_active(dev);
+	pm_runtime_get_noresume(dev);
+	pm_runtime_enable(dev);
+	pm_runtime_set_autosuspend_delay(dev, 1000);
+	pm_runtime_use_autosuspend(dev);
+	pm_runtime_put_autosuspend(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&gc8613->sd);
+	if (ret)
+		goto err_subdev_cleanup;
+
+	return 0;
+
+err_subdev_cleanup:
+	v4l2_subdev_cleanup(&gc8613->sd);
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+err_media_entity:
+	media_entity_cleanup(&gc8613->sd.entity);
+err_handler_free:
+	v4l2_ctrl_handler_free(&gc8613->ctrls.handler);
+err_power_off:
+	gc8613_power_off(dev);
+
+	return ret;
+}
+
+static void gc8613_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct gc8613 *gc8613 = to_gc8613(sd);
+
+	v4l2_subdev_cleanup(sd);
+	v4l2_async_unregister_subdev(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&gc8613->ctrls.handler);
+
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev))
+		gc8613_power_off(&client->dev);
+	pm_runtime_set_suspended(&client->dev);
+}
+
+static const struct of_device_id gc8613_dt_ids[] = {
+	{ .compatible = "galaxycore,gc8613" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, gc8613_dt_ids);
+
+static const struct i2c_device_id gc8613_id[] = {
+	{ .name = "gc8613" },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, gc8613_id);
+
+static const struct dev_pm_ops gc8613_pm_ops = {
+	RUNTIME_PM_OPS(gc8613_power_off, gc8613_power_on, NULL)
+};
+
+static struct i2c_driver gc8613_i2c_driver = {
+	.driver = {
+		.name = "gc8613",
+		.of_match_table = gc8613_dt_ids,
+		.pm = pm_ptr(&gc8613_pm_ops),
+	},
+	.probe = gc8613_probe,
+	.remove = gc8613_remove,
+	.id_table = gc8613_id,
+};
+
+module_i2c_driver(gc8613_i2c_driver);
+
+MODULE_DESCRIPTION("GalaxyCore GC8613 sensor driver");
+MODULE_LICENSE("GPL");
