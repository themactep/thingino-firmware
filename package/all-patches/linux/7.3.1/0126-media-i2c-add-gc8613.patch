+#define GC8613_REG_GAIN_1467			CCI_REG8(0x1467)
+#define GC8613_REG_GAIN_1468			CCI_REG8(0x1468)
+#define GC8613_REG_GAIN_1447			CCI_REG8(0x1447)
+
+/* External clock is 27 MHz. */
+#define GC8613_XCLK_FREQ			(27 * HZ_PER_MHZ)
+
+#define GC8613_NATIVE_WIDTH			3840U
+#define GC8613_NATIVE_HEIGHT			2160U
+
+/* 2 lanes, 1107 Mbit/s per lane (link frequency is half the bit rate). */
+#define GC8613_LINK_FREQ			553500000
+/* 3934 x 2250 pixels at 25 fps. */
+#define GC8613_PIXEL_RATE			221287500
+
+static const s64 gc8613_link_freqs[] = {
+	GC8613_LINK_FREQ,
+};
+
+#define GC8613_HTS_MIN				3840U
+#define GC8613_HTS_MAX				(2U * 0x0fff)
+#define GC8613_VTS_MAX				0x3fffU
+
+/* Number of lines by which exposure must be less than VTS. */
+#define GC8613_EXPOSURE_OFFSET			8
+
+struct gc8613_gain {
+	u8 reg_614;
+	u8 reg_615;
+	u8 reg_225;
+	u8 reg_1467;
+	u8 reg_1468;
+	u8 reg_1447;
+};
