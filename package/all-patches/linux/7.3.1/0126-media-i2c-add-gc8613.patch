+#define GC8613_CHIP_ID_L			0x13
+
+#define GC8613_REG_CHIP_ID_H			CCI_REG8(0x03f0)
+#define GC8613_REG_CHIP_ID_L			CCI_REG8(0x03f1)
+
+/* HTS is a 16-bit line length; VTS is a 14-bit frame length. */
