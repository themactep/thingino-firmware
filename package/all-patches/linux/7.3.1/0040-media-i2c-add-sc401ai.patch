From: Paul Philippov <paul@themactep.com>
Subject: [PATCH] media: i2c: add the SmartSens SC401AI sensor driver

Add a mainline V4L2 subdev driver for the SmartSens SC401AI image
sensor. The mode register sequence and gain table are adapted from the
Ingenic vendor sensor driver (sensor_sc401ai_t31).

The driver uses the CCI register helpers, runtime PM, and the current
state-based subdev pad API. It exposes the full-resolution mode with
HBLANK/VBLANK, exposure, analogue gain, and mirror/flip controls where
the vendor driver provides them.

Signed-off-by: Paul Philippov <paul@themactep.com>
---
--- /dev/null
+++ b/drivers/media/i2c/sc401ai.c
@@ -0,0 +1,1161 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * SmartSens SC401AI CMOS Image Sensor Driver
+ *
+ * The register sequences and gain table are adapted from the Ingenic
+ * vendor sensor driver (sensor_sc401ai_t31).
+ *
+ * WARNING: this driver has not been validated on hardware.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+#include <linux/units.h>
+
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-mediabus.h>
+
+#define SC401AI_CHIP_ID_H			0xcd
+#define SC401AI_CHIP_ID_L			0x2e
+
+#define SC401AI_REG_CHIP_ID_H			CCI_REG8(0x3107)
+#define SC401AI_REG_CHIP_ID_L			CCI_REG8(0x3108)
+
+#define SC401AI_REG_SOFTWARE_RESET		CCI_REG8(0x0103)
+#define SC401AI_REG_STREAM			CCI_REG8(0x0100)
+
+/* HTS holds half the number of pixels per line. */
+#define SC401AI_REG_HTS				CCI_REG16(0x320c)
+#define SC401AI_REG_VTS				CCI_REG16(0x320e)
+
+/* 16-bit exposure in 1/16 line units, split over three registers. */
+#define SC401AI_REG_EXPOSURE_H			CCI_REG8(0x3e00)
+#define SC401AI_REG_EXPOSURE_M			CCI_REG8(0x3e01)
+#define SC401AI_REG_EXPOSURE_L			CCI_REG8(0x3e02)
+
+#define SC401AI_REG_GAIN_L			CCI_REG8(0x3e09)
+#define SC401AI_REG_GAIN_H			CCI_REG8(0x3e08)
+#define SC401AI_REG_GAIN_LIMIT			CCI_REG8(0x363a)
+
+#define SC401AI_REG_FLIP			CCI_REG8(0x3221)
+#define SC401AI_FLIP_BITS			(BIT(5) | BIT(6))
+
+#define SC401AI_STREAM_ON			0x01
+
+/* External clock is 24 MHz. */
+#define SC401AI_XCLK_FREQ			(24 * HZ_PER_MHZ)
+
+#define SC401AI_NATIVE_WIDTH			2560U
+#define SC401AI_NATIVE_HEIGHT			1440U
+
+/* 2 lanes, 630 Mbit/s per lane. */
+#define SC401AI_LINK_FREQ			315000000
+/* 2800 x 1800 pixels at 25 fps. */
+#define SC401AI_PIXEL_RATE			126000000
+
+static const s64 sc401ai_link_freqs[] = {
+	SC401AI_LINK_FREQ,
+};
+
+#define SC401AI_HTS_MIN				2800U
+#define SC401AI_HTS_MAX				0xffffU
+#define SC401AI_VTS_MAX				0xffffU
+
+/* Number of lines by which exposure must be less than VTS. */
+#define SC401AI_EXPOSURE_OFFSET			4
+#define SC401AI_EXPOSURE_MIN			3
+
+/* Above this LUT gain the vendor switches the internal DCG path. */
+#define SC401AI_GAIN_DCG_THRESHOLD		0x2740
+
+struct sc401ai_gain {
+	u8 reg_3e09;
+	u8 reg_3e08;
+};
