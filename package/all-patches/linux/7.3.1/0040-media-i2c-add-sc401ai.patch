+
+static inline struct sc401ai *to_sc401ai(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct sc401ai, sd);
+}
+
+static inline struct v4l2_subdev *sc401ai_ctrl_to_sd(struct v4l2_ctrl *ctrl)
+{
+	return &container_of(ctrl->handler, struct sc401ai, ctrls.handler)->sd;
+}
+
+static void sc401ai_fill_format(const struct sc401ai_mode *mode,
+				struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->code = MEDIA_BUS_FMT_SBGGR10_1X10;
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	fmt->quantization = V4L2_QUANTIZATION_DEFAULT;
+	fmt->xfer_func = V4L2_XFER_FUNC_DEFAULT;
+}
+
+static int sc401ai_init_state(struct v4l2_subdev *sd,
+			      struct v4l2_subdev_state *state)
+{
+	struct v4l2_mbus_framefmt *fmt;
+	struct v4l2_rect *crop;
+
+	fmt = v4l2_subdev_state_get_format(state, 0);
+	sc401ai_fill_format(&sc401ai_modes[0], fmt);
+
+	crop = v4l2_subdev_state_get_crop(state, 0);
+	crop->left = 0;
+	crop->top = 0;
+	crop->width = sc401ai_modes[0].width;
+	crop->height = sc401ai_modes[0].height;
+
+	return 0;
+}
+
+static int sc401ai_enum_mbus_code(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index != 0)
+		return -EINVAL;
+
+	code->code = MEDIA_BUS_FMT_SBGGR10_1X10;
+
+	return 0;
+}
+
+static int sc401ai_enum_frame_size(struct v4l2_subdev *sd,
+				   struct v4l2_subdev_state *state,
+				   struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index >= ARRAY_SIZE(sc401ai_modes))
+		return -EINVAL;
+
+	if (fse->code != MEDIA_BUS_FMT_SBGGR10_1X10)
+		return -EINVAL;
+
+	fse->min_width = sc401ai_modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = sc401ai_modes[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+static int sc401ai_get_selection(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		sel->r = *v4l2_subdev_state_get_crop(state, 0);
+		return 0;
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = SC401AI_NATIVE_WIDTH;
+		sel->r.height = SC401AI_NATIVE_HEIGHT;
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static int sc401ai_set_pad_format(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_format *fmt)
+{
+	struct sc401ai *sc401ai = to_sc401ai(sd);
+	const struct sc401ai_mode *mode;
+	struct v4l2_mbus_framefmt *framefmt;
+	struct v4l2_rect *crop;
+
+	mode = v4l2_find_nearest_size(sc401ai_modes, ARRAY_SIZE(sc401ai_modes),
+				      width, height,
+				      fmt->format.width, fmt->format.height);
+
+	sc401ai_fill_format(mode, &fmt->format);
+	framefmt = v4l2_subdev_state_get_format(state, fmt->pad);
+	*framefmt = fmt->format;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_ACTIVE) {
+		sc401ai->mode = mode;
+		__v4l2_ctrl_s_ctrl(sc401ai->ctrls.hblank, mode->hblank);
+		__v4l2_ctrl_s_ctrl(sc401ai->ctrls.vblank, mode->vblank);
+	}
+
+	crop = v4l2_subdev_state_get_crop(state, fmt->pad);
+	crop->left = 0;
+	crop->top = 0;
+	crop->width = mode->width;
+	crop->height = mode->height;
+
+	return 0;
+}
+
+static void sc401ai_exposure_update(struct sc401ai *sc401ai)
+{
+	unsigned int exposure_max;
+
+	exposure_max = sc401ai->ctrls.vblank->val + sc401ai->mode->height -
+		       SC401AI_EXPOSURE_OFFSET;
+	exposure_max = min(exposure_max, 0xffffU);
+
+	__v4l2_ctrl_modify_range(sc401ai->ctrls.exposure,
+				 SC401AI_EXPOSURE_MIN, exposure_max, 1,
+				 exposure_max);
+}
+
+static int sc401ai_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct sc401ai *sc401ai = to_sc401ai(sc401ai_ctrl_to_sd(ctrl));
+
+	dev_dbg(sc401ai->sd.dev, "sc401ai: ctrl 0x%x = %d\n", ctrl->id, ctrl->val);
+	const struct sc401ai_gain *gain;
+	u32 hts, it, value;
+	int ret = 0;
+
+	if (ctrl->flags & V4L2_CTRL_FLAG_READ_ONLY)
+		return 0;
+
+	if (ctrl->id == V4L2_CID_VBLANK)
+		sc401ai_exposure_update(sc401ai);
+
+	if (!pm_runtime_get_if_in_use(sc401ai->sd.dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		it = (u32)ctrl->val * 2;
+		ret = cci_write(sc401ai->regmap, SC401AI_REG_EXPOSURE_H,
+				(it >> 12) & 0x0f, NULL);
+		ret = cci_write(sc401ai->regmap, SC401AI_REG_EXPOSURE_M,
+				(it >> 4) & 0xff, &ret);
+		ret = cci_write(sc401ai->regmap, SC401AI_REG_EXPOSURE_L,
+				(it & 0x0f) << 4, &ret);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		gain = &sc401ai_gains[ctrl->val];
+		value = ((u16)gain->reg_3e08 << 8) | gain->reg_3e09;
+		ret = cci_write(sc401ai->regmap, SC401AI_REG_GAIN_L,
+				gain->reg_3e09, NULL);
+		ret = cci_write(sc401ai->regmap, SC401AI_REG_GAIN_H,
+				gain->reg_3e08, &ret);
+		ret = cci_write(sc401ai->regmap, SC401AI_REG_GAIN_LIMIT,
+				value < SC401AI_GAIN_DCG_THRESHOLD ? 0x0b : 0x17,
+				&ret);
+		break;
+	case V4L2_CID_HBLANK:
+		hts = ctrl->val + sc401ai->mode->width;
+		ret = cci_write(sc401ai->regmap, SC401AI_REG_HTS, hts / 2, NULL);
+		break;
+	case V4L2_CID_VBLANK:
+		ret = cci_write(sc401ai->regmap, SC401AI_REG_VTS,
+				ctrl->val + sc401ai->mode->height, NULL);
+		break;
+	case V4L2_CID_VFLIP:
+		ret = cci_update_bits(sc401ai->regmap, SC401AI_REG_FLIP,
+				      SC401AI_FLIP_BITS,
+				      ctrl->val ? SC401AI_FLIP_BITS : 0, NULL);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put_autosuspend(sc401ai->sd.dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops sc401ai_ctrl_ops = {
+	.s_ctrl = sc401ai_set_ctrl,
+};
+
+static int sc401ai_init_controls(struct sc401ai *sc401ai)
+{
+	struct v4l2_ctrl_handler *hdl = &sc401ai->ctrls.handler;
+	struct v4l2_fwnode_device_properties props;
+	const struct v4l2_ctrl_ops *ops = &sc401ai_ctrl_ops;
+	unsigned int hblank_max = SC401AI_HTS_MAX - SC401AI_NATIVE_WIDTH;
+	unsigned int vblank_max = SC401AI_VTS_MAX - SC401AI_NATIVE_HEIGHT;
+	int ret;
+
+	ret = v4l2_ctrl_handler_init(hdl, 8);
+	if (ret)
+		return ret;
+
+	sc401ai->ctrls.pixel_rate =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_PIXEL_RATE,
+				  SC401AI_PIXEL_RATE, SC401AI_PIXEL_RATE, 1,
+				  SC401AI_PIXEL_RATE);
+
+	sc401ai->ctrls.link_freq =
+		v4l2_ctrl_new_int_menu(hdl, ops, V4L2_CID_LINK_FREQ, 0, 0,
+				       sc401ai_link_freqs);
+	if (sc401ai->ctrls.link_freq)
+		sc401ai->ctrls.link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	sc401ai->ctrls.exposure =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_EXPOSURE,
+				  SC401AI_EXPOSURE_MIN,
+				  sc401ai_modes[0].vblank +
+				  sc401ai_modes[0].height -
+				  SC401AI_EXPOSURE_OFFSET, 1,
+				  sc401ai_modes[0].vblank +
+				  sc401ai_modes[0].height -
+				  SC401AI_EXPOSURE_OFFSET);
+
+	sc401ai->ctrls.gain =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_ANALOGUE_GAIN, 0,
+				  ARRAY_SIZE(sc401ai_gains) - 1, 1, 0);
+
+	sc401ai->ctrls.hblank =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_HBLANK,
+				  SC401AI_HTS_MIN - SC401AI_NATIVE_WIDTH,
+				  hblank_max, 1,
+				  sc401ai_modes[0].hblank);
+
+	sc401ai->ctrls.vblank =
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_VBLANK,
+				  sc401ai_modes[0].vblank, vblank_max, 1,
+				  sc401ai_modes[0].vblank);
+
+	sc401ai->ctrls.vflip = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_VFLIP,
+						 0, 1, 1, 0);
+
+	if (hdl->error) {
+		ret = hdl->error;
+		goto error;
+	}
+
+	ret = v4l2_fwnode_device_parse(sc401ai->sd.dev, &props);
+	if (ret)
+		goto error;
+
+	ret = v4l2_ctrl_new_fwnode_properties(hdl, ops, &props);
+	if (ret)
+		goto error;
+
+	sc401ai->sd.ctrl_handler = hdl;
+
+	return 0;
+
+error:
+	v4l2_ctrl_handler_free(hdl);
+
+	return ret;
+}
+
+static int sc401ai_check_hwcfg(struct device *dev)
+{
+	struct v4l2_fwnode_endpoint ep = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	struct fwnode_handle *endpoint;
+	unsigned int i;
+	int ret;
+
+	endpoint = fwnode_graph_get_next_endpoint(dev_fwnode(dev), NULL);
+	if (!endpoint) {
+		dev_err(dev, "endpoint node not found\n");
+		return -EINVAL;
+	}
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(endpoint, &ep);
+	fwnode_handle_put(endpoint);
+	if (ret)
+		return ret;
+
+	if (ep.bus.mipi_csi2.num_data_lanes != 2) {
+		dev_err(dev, "only 2 data lanes are currently supported\n");
+		ret = -EINVAL;
+		goto out;
+	}
+
+	if (!ep.nr_of_link_frequencies) {
+		dev_err(dev, "link-frequency property not found in DT\n");
+		ret = -EINVAL;
+		goto out;
+	}
+
+	for (i = 0; i < ep.nr_of_link_frequencies; i++) {
+		if (ep.link_frequencies[i] == SC401AI_LINK_FREQ)
+			break;
+	}
+
+	if (i == ep.nr_of_link_frequencies) {
+		dev_err(dev, "expected link frequency %u\n", SC401AI_LINK_FREQ);
+		ret = -EINVAL;
+	}
+
+out:
+	v4l2_fwnode_endpoint_free(&ep);
+
+	return ret;
+}
+
+static int sc401ai_power_on(struct device *dev)
+{
+	dev_dbg(dev, "sc401ai: power on\n");
+	struct sc401ai *sc401ai = to_sc401ai(dev_get_drvdata(dev));
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(sc401ai->supplies),
+				    sc401ai->supplies);
+	if (ret)
+		return ret;
+
+	ret = clk_prepare_enable(sc401ai->xclk);
+	if (ret)
+		goto err_regulators;
+
+	/* The sensor needs MCLK while reset is released. */
+	gpiod_set_value_cansleep(sc401ai->powerdown_gpio, 0);
+	gpiod_set_value_cansleep(sc401ai->reset_gpio, 0);
+	msleep(20);
+
+	return 0;
+
+err_regulators:
+	regulator_bulk_disable(ARRAY_SIZE(sc401ai->supplies), sc401ai->supplies);
+
+	return ret;
+}
+
+static int sc401ai_power_off(struct device *dev)
+{
+	dev_dbg(dev, "sc401ai: power off\n");
+	struct sc401ai *sc401ai = to_sc401ai(dev_get_drvdata(dev));
+
+	gpiod_set_value_cansleep(sc401ai->reset_gpio, 1);
+	gpiod_set_value_cansleep(sc401ai->powerdown_gpio, 1);
+	clk_disable_unprepare(sc401ai->xclk);
+	regulator_bulk_disable(ARRAY_SIZE(sc401ai->supplies), sc401ai->supplies);
+
+	return 0;
+}
+
+static int sc401ai_identify_module(struct sc401ai *sc401ai)
+{
+	u64 id_h, id_l;
+	int ret;
+
+	ret = cci_read(sc401ai->regmap, SC401AI_REG_CHIP_ID_H, &id_h, NULL);
+	if (ret)
+		return ret;
+
+	ret = cci_read(sc401ai->regmap, SC401AI_REG_CHIP_ID_L, &id_l, NULL);
+	if (ret)
+		return ret;
+
+	if (id_h != SC401AI_CHIP_ID_H || id_l != SC401AI_CHIP_ID_L) {
+		dev_err(sc401ai->sd.dev, "chip id mismatch: %x%x != %x%x\n",
+			(u8)id_h, (u8)id_l, SC401AI_CHIP_ID_H, SC401AI_CHIP_ID_L);
+		return -EIO;
+	}
+
+	dev_info(sc401ai->sd.dev, "sc401ai: chip id %02x%02x\n", (u8)id_h, (u8)id_l);
+	return 0;
+}
+
+static int sc401ai_enable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	struct sc401ai *sc401ai = to_sc401ai(sd);
+
+	dev_info(sd->dev, "sc401ai: stream on\n");
+	int ret;
+
+	ret = pm_runtime_resume_and_get(sd->dev);
+	if (ret)
+		return ret;
+
+	cci_multi_reg_write(sc401ai->regmap, sc401ai->mode->regs,
+			    sc401ai->mode->regs_num, &ret);
+	if (ret)
+		goto err_rpm_put;
+
+	/* The vendor init sequence ends with a 16 ms settle delay. */
+	msleep(16);
+
+	ret = __v4l2_ctrl_handler_setup(&sc401ai->ctrls.handler);
+	if (ret)
+		goto err_rpm_put;
+
+	cci_write(sc401ai->regmap, SC401AI_REG_STREAM, SC401AI_STREAM_ON, &ret);
+	if (ret)
+		goto err_rpm_put;
+
+	return 0;
+
+err_rpm_put:
+	pm_runtime_put_autosuspend(sd->dev);
+
+	return ret;
+}
+
+static int sc401ai_disable_streams(struct v4l2_subdev *sd,
+				   struct v4l2_subdev_state *state, u32 pad,
+				   u64 streams_mask)
+{
+	dev_info(sd->dev, "sc401ai: stream off\n");
+	struct sc401ai *sc401ai = to_sc401ai(sd);
+	int ret = 0;
+
+	cci_write(sc401ai->regmap, SC401AI_REG_STREAM, 0x00, &ret);
+	if (ret)
+		dev_err(sd->dev, "failed to stop streaming: %d\n", ret);
+
+	pm_runtime_put_autosuspend(sd->dev);
+
+	return ret;
+}
+
+static const struct v4l2_subdev_video_ops sc401ai_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops sc401ai_pad_ops = {
+	.enum_mbus_code = sc401ai_enum_mbus_code,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = sc401ai_set_pad_format,
+	.get_selection = sc401ai_get_selection,
+	.enum_frame_size = sc401ai_enum_frame_size,
+	.enable_streams = sc401ai_enable_streams,
+	.disable_streams = sc401ai_disable_streams,
+};
+
+static const struct v4l2_subdev_ops sc401ai_subdev_ops = {
+	.video = &sc401ai_video_ops,
+	.pad = &sc401ai_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops sc401ai_subdev_internal_ops = {
+	.init_state = sc401ai_init_state,
+};
+
+static const char * const sc401ai_supply_names[] = {
+	"iovdd",
+	"avdd",
+	"dvdd",
+};
+
+static int sc401ai_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+
+	dev_info(dev, "sc401ai: probe at i2c 0x%02x\n", client->addr);
+	struct sc401ai *sc401ai;
+	unsigned int i;
+	unsigned long xclk_freq;
+	int ret;
+
+	sc401ai = devm_kzalloc(dev, sizeof(*sc401ai), GFP_KERNEL);
+	if (!sc401ai)
+		return -ENOMEM;
+
+	v4l2_i2c_subdev_init(&sc401ai->sd, client, &sc401ai_subdev_ops);
+	sc401ai->sd.internal_ops = &sc401ai_subdev_internal_ops;
+
+	ret = sc401ai_check_hwcfg(dev);
+	if (ret)
+		return ret;
+
+	sc401ai->xclk = devm_v4l2_sensor_clk_get(dev, NULL);
+	if (IS_ERR(sc401ai->xclk))
+		return dev_err_probe(dev, PTR_ERR(sc401ai->xclk),
+				     "failed to get xclk\n");
+
+	xclk_freq = clk_get_rate(sc401ai->xclk);
+	if (xclk_freq != SC401AI_XCLK_FREQ)
+		return dev_err_probe(dev, -EINVAL,
+				     "xclk frequency %lu Hz not supported\n",
+				     xclk_freq);
+
+	for (i = 0; i < ARRAY_SIZE(sc401ai->supplies); i++)
+		sc401ai->supplies[i].supply = sc401ai_supply_names[i];
+
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(sc401ai->supplies),
+				      sc401ai->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get regulators\n");
+
+	sc401ai->reset_gpio = devm_gpiod_get_optional(dev, "reset",
+						      GPIOD_OUT_HIGH);
+	if (IS_ERR(sc401ai->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(sc401ai->reset_gpio),
+				     "failed to get reset gpio\n");
+
+	sc401ai->powerdown_gpio = devm_gpiod_get_optional(dev, "powerdown",
+							  GPIOD_OUT_HIGH);
+	if (IS_ERR(sc401ai->powerdown_gpio))
+		return dev_err_probe(dev, PTR_ERR(sc401ai->powerdown_gpio),
+				     "failed to get powerdown gpio\n");
+
+	sc401ai->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(sc401ai->regmap))
+		return dev_err_probe(dev, PTR_ERR(sc401ai->regmap),
+				     "failed to get cci regmap\n");
+
+	ret = sc401ai_power_on(dev);
+	if (ret)
+		return ret;
+
+	ret = sc401ai_identify_module(sc401ai);
+	if (ret)
+		goto err_power_off;
+
+	sc401ai->mode = &sc401ai_modes[0];
+
+	ret = sc401ai_init_controls(sc401ai);
+	if (ret)
+		goto err_power_off;
+
+	sc401ai->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	sc401ai->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	sc401ai->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&sc401ai->sd.entity, 1, &sc401ai->pad);
+	if (ret)
+		goto err_handler_free;
+
+	sc401ai->sd.state_lock = sc401ai->ctrls.handler.lock;
+	ret = v4l2_subdev_init_finalize(&sc401ai->sd);
+	if (ret)
+		goto err_media_entity;
+
+	pm_runtime_set_active(dev);
+	pm_runtime_get_noresume(dev);
+	pm_runtime_enable(dev);
+	pm_runtime_set_autosuspend_delay(dev, 1000);
+	pm_runtime_use_autosuspend(dev);
+	pm_runtime_put_autosuspend(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&sc401ai->sd);
+	if (ret)
+		goto err_subdev_cleanup;
+
+	return 0;
+
+err_subdev_cleanup:
+	v4l2_subdev_cleanup(&sc401ai->sd);
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+err_media_entity:
+	media_entity_cleanup(&sc401ai->sd.entity);
+err_handler_free:
+	v4l2_ctrl_handler_free(&sc401ai->ctrls.handler);
+err_power_off:
+	sc401ai_power_off(dev);
+
+	return ret;
+}
+
+static void sc401ai_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct sc401ai *sc401ai = to_sc401ai(sd);
+
+	v4l2_subdev_cleanup(sd);
+	v4l2_async_unregister_subdev(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&sc401ai->ctrls.handler);
+
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev))
+		sc401ai_power_off(&client->dev);
+	pm_runtime_set_suspended(&client->dev);
+}
+
+static const struct of_device_id sc401ai_dt_ids[] = {
+	{ .compatible = "smartens,sc401ai" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, sc401ai_dt_ids);
+
+static const struct i2c_device_id sc401ai_id[] = {
+	{ .name = "sc401ai" },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, sc401ai_id);
+
+static const struct dev_pm_ops sc401ai_pm_ops = {
+	RUNTIME_PM_OPS(sc401ai_power_off, sc401ai_power_on, NULL)
+};
+
+static struct i2c_driver sc401ai_i2c_driver = {
+	.driver = {
+		.name = "sc401ai",
+		.of_match_table = sc401ai_dt_ids,
+		.pm = pm_ptr(&sc401ai_pm_ops),
+	},
+	.probe = sc401ai_probe,
+	.remove = sc401ai_remove,
+	.id_table = sc401ai_id,
+};
+
+module_i2c_driver(sc401ai_i2c_driver);
+
+MODULE_DESCRIPTION("SmartSens SC401AI sensor driver");
+MODULE_LICENSE("GPL");
