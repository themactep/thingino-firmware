 #if defined(CONFIG_SOC_T21) || defined(CONFIG_SOC_T23)
 	vpu_writel(vpu, REG_VDMA_TASKRG_T21, VDMA_ACFG_DHA(cnode->dma_addr)
@@ -404,7 +408,6 @@ static long vpu_set_bsfull_paddr(struct device *dev, struct channel_node *cnode)
 	return 0;
 }
 
-static int bs_cnt = 0;
