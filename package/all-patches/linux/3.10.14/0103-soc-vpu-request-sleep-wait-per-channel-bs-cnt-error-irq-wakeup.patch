 {
 	int ret = 0, bsreadcnt = 3, bslen_bs = 0;
@@ -425,14 +428,14 @@ static long vpu_wait_bs_complete(struct device *dev, struct channel_node *cnode)
 		if (vpu_reset(dev) < 0) {
 			dev_warn(dev, "vpu reset failed\n");
 		}
-		bs_cnt = 0;
+		vpu->bs_cnt = 0;
 		return ret ? -EINTR : -1;
 	}
 	vpu_stat = vpu->status;
 	bs_paddr = vpu_readl(vpu, REG_EMC_BS_ADDR);
 
 	if (vpu_stat & SCH_STAT_ENDFLAG) {
-		bs_cnt = 0;
+		vpu->bs_cnt = 0;
 		if ((ret > 0) && (cnode->codecdir == HWJPEGDEC)) {
 			vpu->bslen = vpu_readl(vpu, REG_JPGC_MCUS);
 			vpu->cmpx = 0;
@@ -471,7 +474,7 @@ static long vpu_wait_bs_complete(struct device *dev, struct channel_node *cnode)
 			if (vpu_reset(dev) < 0) {
 				dev_warn(dev, "vpu reset failed\n");
 			}
-			bs_cnt = 0;
+			vpu->bs_cnt = 0;
 			return -1;
 		}
 		cnode->output_len = vpu->bslen;
@@ -484,15 +487,15 @@ static long vpu_wait_bs_complete(struct device *dev, struct channel_node *cnode)
 			vpu->bslen = vpu_readl(vpu, REG_SDE_CFG9);
 			bslen_bs = vpu_readl(vpu, REG_EMC_BS_SIZE);
 
-			if ((vpu->bslen - (bslen_bs*1024*bs_cnt)) <= (bslen_bs*1024)) {
+			if ((vpu->bslen - (bslen_bs*1024*vpu->bs_cnt)) <= (bslen_bs*1024)) {
 				cnode->output_len = vpu->bslen;
 				ret = 0x3;
-				bs_cnt = 0;
+				vpu->bs_cnt = 0;
 				return ret;
 			}
 		}
 
-		bs_cnt++;
+		vpu->bs_cnt++;
 		vpu->bslen = vpu_readl(vpu, REG_EMC_BS_SIZE);
 		if ((ret > 0) && (cnode->codecdir == HWJPEGDEC)) {
 			vpu->bslen = vpu_readl(vpu, REG_EMC_BS_SIZE);
@@ -529,7 +532,7 @@ static long vpu_wait_bs_complete(struct device *dev, struct channel_node *cnode)
 			if (vpu_reset(dev) < 0) {
 				dev_warn(dev, "vpu reset failed\n");
 			}
-			bs_cnt = 0;
+			vpu->bs_cnt = 0;
 			return -1;
 		}
 		cnode->output_len = vpu->bslen;
@@ -542,7 +545,7 @@ static long vpu_wait_bs_complete(struct device *dev, struct channel_node *cnode)
 		if (vpu_reset(dev) < 0) {
 			dev_warn(dev, "vpu reset failed\n");
 		}
-		bs_cnt = 0;
+		vpu->bs_cnt = 0;
 		ret = -1;
 	}
 
diff --git a/drivers/video/soc_vpu/jz_nvpu/jz_nvpu.c b/drivers/video/soc_vpu/jz_nvpu/jz_nvpu.c
index 42ab3038..c608261f 100644
--- a/drivers/video/soc_vpu/jz_nvpu/jz_nvpu.c
+++ b/drivers/video/soc_vpu/jz_nvpu/jz_nvpu.c
@@ -199,6 +199,16 @@ static long vpu_start_vpu(struct device *dev, const struct channel_node * const
 #if 1
 	struct jz_vpu *vpu = dev_get_drvdata(dev);
 	struct channel_list *clist = list_entry(cnode->clist, struct channel_list, list);
+	unsigned long slock_flag = 0;
+
+	/*
+	 * Forget the previous job (as helix does since 0099): a completion
+	 * or status left by a late or error interrupt must not end this job.
+	 */
+	spin_lock_irqsave(&vpu->slock, slock_flag);
+	INIT_COMPLETION(vpu->done);
+	vpu->status = 0;
+	spin_unlock_irqrestore(&vpu->slock, slock_flag);
 
 	if (cnode->n_flag == 1) {
 		vpu_start_ncu(vpu,cnode->ncu_addr);
@@ -263,10 +273,19 @@ static long vpu_start_vpu(struct device *dev, const struct channel_node * const
 static long vpu_wait_complete(struct device *dev, struct channel_node * const cnode)
 {
 	long ret = 0;
+	bool hw_error;
 	struct jz_vpu *vpu = dev_get_drvdata(dev);
 
-hard_vpu_wait_restart:
-	ret = wait_for_completion_interruptible_timeout(&vpu->done, msecs_to_jiffies(cnode->mdelay));
+	/*
+	 * One bounded, killable wait (as helix since 0102): the interruptible
+	 * wait restarted with the full timeout on every signal.  An error
+	 * interrupt completes the wait as well (the handler masks all sources,
+	 * no end of frame follows) and is reported as a failure.
+	 */
+	ret = wait_for_completion_killable_timeout(&vpu->done, msecs_to_jiffies(cnode->mdelay));
+	hw_error = (ret > 0) && !(vpu->status & VPU_STAT_ENDF);
+	if (hw_error)
+		ret = 0;
 	if (ret > 0) {
 		ret = 0;
 		if ((cnode->codecdir & (1 << 16)) == 0) {
@@ -284,16 +303,21 @@ hard_vpu_wait_restart:
 		dev_dbg(vpu->vpu.dev, "[%d:%d] wait complete\n", current->tgid, current->pid);
 	} else if (ret == -ERESTARTSYS) {
 		/*
-		 * A fatal signal (SIGKILL) stays pending until the task returns
-		 * to userspace, so restarting the wait here spins in the kernel
-		 * forever and makes the task unkillable.  Let it out instead.
+		 * The wait is killable, so only a fatal signal gets here (the
+		 * bail-out itself is 0097).  Also stop the core: it may still be
+		 * writing into buffers that are released when the task exits.
 		 */
-		if (fatal_signal_pending(current))
-			return -ERESTARTSYS;
-		dev_dbg(vpu->vpu.dev, "[%d:%d]:fun:%s,line:%d vpu is interrupt\n", current->tgid, current->pid, __func__, __LINE__);
-		goto hard_vpu_wait_restart;
+		dev_dbg(vpu->vpu.dev, "[%d:%d] fatal signal, stopping the core\n", current->tgid, current->pid);
+		if (vpu_reset(dev) < 0) {
+			dev_warn(dev, "vpu reset failed\n");
+		}
+		vpu->bslen = 0;
+		ret = -EINTR;
 	} else {
-		dev_warn(dev, "[%d:%d] wait_for_completion timeout\n", current->tgid, current->pid);
+		if (hw_error)
+			dev_warn(dev, "[%d:%d] vpu error interrupt, status = %x\n", current->tgid, current->pid, vpu->status);
+		else
+			dev_warn(dev, "[%d:%d] wait_for_completion timeout\n", current->tgid, current->pid);
 		dev_warn(dev, "vpu_stat = %x\n", vpu_readl(vpu,REG_VPU_STAT));
 		dev_warn(dev, "aux_stat = %x\n", vpu_readl(vpu,REG_VPU_AUX_STAT));
 		dev_warn(dev, "ret = %ld\n", ret);
@@ -423,6 +447,9 @@ static irqreturn_t vpu_interrupt(int irq, void *dev)
 			vpu->bslen = 0;
 			vpu->status = vpu_stat;
 			vpu->cmpx = 0;
+			/* all sources are masked: end the wait with the error now
+			 * instead of letting it run into the timeout */
+			complete(&vpu->done);
 		}
 	} else {
 		if(vpu_readl(vpu,REG_VPU_AUX_STAT) & AUX_STAT_MIRQP) {
diff --git a/drivers/video/soc_vpu/soc_vpu.c b/drivers/video/soc_vpu/soc_vpu.c
index 7ef8bc66..74d236f2 100644
--- a/drivers/video/soc_vpu/soc_vpu.c
+++ b/drivers/video/soc_vpu/soc_vpu.c
@@ -455,13 +455,34 @@ err_copy_from_user:
 	return ret;
 }
 
+/* Is a VPU matching vpu_id on the free list?  Takes fvlist->slock. */
+static bool soc_vpu_id_free(struct free_vpu_list *fvlist, int vpu_id)
+{
+	unsigned long fvflag = 0;
+	struct vpu_list *vl = NULL;
+	bool found = false;
+
+	spin_lock_irqsave(&fvlist->slock, fvflag);
+	list_for_each_entry(vl, &fvlist->fvlist_head, list) {
+		struct vpu *v = list_entry(vl->vlist, struct vpu, vlist);
+
+		if ((v->vpu_id & vpu_id) == vpu_id) {
+			found = true;
+			break;
+		}
+	}
+	spin_unlock_irqrestore(&fvlist->slock, fvflag);
+
+	return found;
+}
+
 static long soc_vpu_request(struct soc_channel *sc, struct channel_node *cnode, struct file *file)
 {
 	long ret = 0;
 	unsigned long fvflag = 0, vlflag = 0;
 	struct free_vpu_list *fvlist = NULL;
 	struct vpu_list *vlist = NULL;
-	volatile int find_vpu_try_times = 0;
+	unsigned long find_deadline = 0;
 	//struct timespec start, end;
 
 	fvlist = list_entry(sc->fvlist_head, struct free_vpu_list, fvlist_head);
@@ -498,10 +519,23 @@ find_vpu_try_point:
 				vpu = vpu_ptr;
 				//end = current_kernel_time();
 			} else {
-				if (find_vpu_try_times++ < FIND_VPU_TRY_TIME_THRESHOLD) {
+				/*
+				 * The wanted VPU is busy: give the token back and
+				 * sleep until a VPU returns to the free list, for at
+				 * most FIND_VPU_WAIT_MS in total.  This used to be up
+				 * to 100 x udelay(2000) = 200 ms of busy-waiting.
+				 */
+				if (!find_deadline)
+					find_deadline = jiffies + msecs_to_jiffies(FIND_VPU_WAIT_MS);
+				if (time_before(jiffies, find_deadline)) {
 					complete(&fvlist->vdone);
 					spin_unlock_irqrestore(&fvlist->slock, fvflag);
-					udelay(2000);
+					wait_event_timeout(fvlist->vwq,
+							   soc_vpu_id_free(fvlist, cnode->vpu_id),
+							   (long)(find_deadline - jiffies) > 0 ?
+							   (long)(find_deadline - jiffies) : 1);
+					if (fatal_signal_pending(current))
+						return -EINTR;
 					goto find_vpu_try_point;
 				} else {
 					spin_unlock_irqrestore(&fvlist->slock, fvflag);
@@ -557,6 +591,7 @@ err_vpu_open:
 	list_add_tail(cnode->vlist, &fvlist->fvlist_head);
 	complete(&fvlist->vdone);
 	spin_unlock_irqrestore(&fvlist->slock, fvflag);
+	wake_up_all(&fvlist->vwq);
 	cnode->vlist = NULL;
 err_not_find_request_vpu:
 err_fvlist_empty:
@@ -581,6 +616,7 @@ static void soc_vpu_put_free_locked(struct soc_channel *sc, struct vpu_list *vli
 			if (list_empty(&vlist->list)) {
 				list_add_tail(&vlist->list, &fvlist->fvlist_head);
 				complete(&fvlist->vdone);
+				wake_up_all(&fvlist->vwq);
 			} else {
 				WARN_ONCE(1, "soc_vpu: vpu node %p released twice\n", vlist);
 			}
@@ -1624,6 +1660,7 @@ static int __init soc_channel_init(void)
 	/* 3. init fvlist */
 	INIT_LIST_HEAD(&fvlist->fvlist_head);
 	init_completion(&fvlist->vdone);
+	init_waitqueue_head(&fvlist->vwq);
 	for (i = 0; i < vpu_node_num; i++) {
 		list_add_tail(&vpu_list[i].list, &fvlist->fvlist_head);
 		complete(&fvlist->vdone);
diff --git a/drivers/video/soc_vpu/soc_vpu.h b/drivers/video/soc_vpu/soc_vpu.h
index 16609518..f4672b98 100644
--- a/drivers/video/soc_vpu/soc_vpu.h
+++ b/drivers/video/soc_vpu/soc_vpu.h
@@ -66,6 +66,9 @@ enum vpu_phase {
 };
 
 #define FIND_VPU_TRY_TIME_THRESHOLD (100)
+/* how long soc_vpu_request() waits for a specific VPU id to become free:
+ * the old 100 tries of udelay(2000) */
+#define FIND_VPU_WAIT_MS (FIND_VPU_TRY_TIME_THRESHOLD * 2)
 
 struct vpu_list {
 	struct list_head	list;		/* the list of this struct list */
@@ -82,6 +85,7 @@ struct free_vpu_list {
 	struct list_head	fvlist_head;
 	struct completion	vdone;		/* channel complete */
 	spinlock_t		slock;		/* done lock */
+	wait_queue_head_t	vwq;		/* a vpu went back to the list */
 };
 
 struct soc_channel {
