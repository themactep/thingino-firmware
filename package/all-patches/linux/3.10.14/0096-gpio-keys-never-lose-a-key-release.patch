diff --git a/drivers/input/keyboard/gpio_keys.c b/drivers/input/keyboard/gpio_keys.c
--- a/drivers/input/keyboard/gpio_keys.c
+++ b/drivers/input/keyboard/gpio_keys.c
@@ -30,6 +30,13 @@
 #include <linux/of_gpio.h>
 #include <linux/spinlock.h>
 
+/*
+ * While a GPIO key reads as pressed, its level is re-read at this interval
+ * so a lost release edge cannot leave the key stuck down (a stuck key turns
+ * a short press into a long hold for userspace, e.g. a factory reset).
+ */
+#define GPIO_KEYS_PRESSED_RECHECK_MS	50
+
 struct gpio_button_data {
 	const struct gpio_keys_button *button;
 	struct input_dev *input;
@@ -117,10 +124,13 @@
 		 * Disable IRQ and possible debouncing timer.
 		 */
 		disable_irq(bdata->irq);
-		if (bdata->timer_debounce)
-			del_timer_sync(&bdata->timer);
-
 		bdata->disabled = true;
+		del_timer_sync(&bdata->timer);
+		if (gpio_is_valid(bdata->button->gpio)) {
+			/* the work may re-arm the pressed-key recheck timer */
+			cancel_work_sync(&bdata->work);
+			del_timer_sync(&bdata->timer);
+		}
 	}
 }
 
@@ -322,7 +332,7 @@
 	.attrs = gpio_keys_attrs,
 };
 
-static void gpio_keys_gpio_report_event(struct gpio_button_data *bdata)
+static int gpio_keys_gpio_report_event(struct gpio_button_data *bdata)
 {
 	const struct gpio_keys_button *button = bdata->button;
 	struct input_dev *input = bdata->input;
@@ -336,6 +346,8 @@
 		input_event(input, type, button->code, !!state);
 	}
 	input_sync(input);
+
+	return state;
 }
 
 static void gpio_keys_gpio_work_func(struct work_struct *work)
@@ -343,7 +355,13 @@
 	struct gpio_button_data *bdata =
 		container_of(work, struct gpio_button_data, work);
 
-	gpio_keys_gpio_report_event(bdata);
+	/*
+	 * The input core drops repeated identical states, so the recheck only
+	 * emits an event when the level really changed without an interrupt.
+	 */
+	if (gpio_keys_gpio_report_event(bdata) && !bdata->disabled)
+		mod_timer(&bdata->timer, jiffies +
+			  msecs_to_jiffies(GPIO_KEYS_PRESSED_RECHECK_MS));
 
 	if (bdata->button->wakeup)
 		pm_relax(bdata->input->dev.parent);
@@ -676,9 +694,11 @@
 static void gpio_remove_key(struct gpio_button_data *bdata)
 {
 	free_irq(bdata->irq, bdata);
-	if (bdata->timer_debounce)
-		del_timer_sync(&bdata->timer);
+	bdata->disabled = true;
+	del_timer_sync(&bdata->timer);
 	cancel_work_sync(&bdata->work);
+	/* the work may have re-armed the pressed-key recheck timer */
+	del_timer_sync(&bdata->timer);
 	if (gpio_is_valid(bdata->button->gpio))
 		gpio_free(bdata->button->gpio);
 }
