 	} else if (ret == -ERESTARTSYS) {
-		dev_dbg(sc->mdev.this_device, "[fun:%s,line:%d] fvlist wait is interrupt, ingnore this info\n", __func__, __LINE__);
-		goto find_vpu_try_point;
