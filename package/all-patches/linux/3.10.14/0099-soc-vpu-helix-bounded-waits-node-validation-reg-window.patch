 err_tlb_deinit:
 err_tlb_unmap_all_vaddr:
@@ -421,7 +467,7 @@ static long soc_vpu_request(struct soc_channel *sc, struct channel_node *cnode,
 
 	//start = current_kernel_time();
 find_vpu_try_point:
-	ret = wait_for_completion_interruptible_timeout(&fvlist->vdone, msecs_to_jiffies(cnode->mdelay));
+	ret = wait_for_completion_killable_timeout(&fvlist->vdone, msecs_to_jiffies(cnode->mdelay));
 	if (ret > 0) {
