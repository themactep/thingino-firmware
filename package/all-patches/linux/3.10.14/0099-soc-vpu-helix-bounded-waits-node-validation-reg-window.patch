+/*
+ * IOCTL_CHANNEL_WOR_VPU_REG used to read or write any physical address
+ * below 512 MiB through KSEG1.  The stock libimp only reads Helix registers
+ * with it (T23: _jz_hwicodec_pf_h264e_t21_set_priv(), base 0x13100000;
+ * T21: 0x13200000); OpenIMP does not use it.  Keep reads and writes, but
+ * only for aligned words inside the VPU register windows.
+ */
+#define SOC_VPU_REG_WINDOW	0x100000
+#if defined(CONFIG_VPU_HELIX_NUM)
+#define SOC_VPU_HELIX_UNITS	CONFIG_VPU_HELIX_NUM
+#else
+#define SOC_VPU_HELIX_UNITS	1
+#endif
+
+static bool soc_vpu_reg_allowed(unsigned int paddr)
+{
+	int i __maybe_unused;
+
+	if (paddr & 0x3)
+		return false;
+#ifdef HELIX_IOBASE_UNIT
+	for (i = 0; i < SOC_VPU_HELIX_UNITS; i++) {
+		if ((paddr >= HELIX_IOBASE_UNIT(i)) && (paddr < HELIX_IOBASE_UNIT(i) + SOC_VPU_REG_WINDOW))
+			return true;
+	}
+#elif defined(HELIX_IOBASE)
+	if ((paddr >= HELIX_IOBASE) && (paddr < HELIX_IOBASE + SOC_VPU_REG_WINDOW))
+		return true;
+#endif
+#if defined(CONFIG_VPU_RADIX) && defined(RADIX_IOBASE)
+	if ((paddr >= RADIX_IOBASE) && (paddr < RADIX_IOBASE + SOC_VPU_REG_WINDOW))
+		return true;
+#endif
+#if defined(CONFIG_SOC_T23) && defined(IVDC_IOBASE)
+	/* IVDC (direct ISP->VPU path), as mapped by the Helix driver */
+	if ((paddr >= IVDC_IOBASE) && (paddr < IVDC_IOBASE + 0x1000))
+		return true;
+#endif
+	return false;
+}
