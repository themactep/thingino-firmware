From: Claude <noreply@anthropic.com>
Subject: [PATCH] soc_vpu/helix: bounded waits, validated nodes, register window, channel release by file

On top of 0095-0097.

 - helix vpu_wait_complete(): one killable wait with the job timeout
   instead of an interruptible wait that restarted with the full timeout
   on every -ERESTARTSYS (and spun while a signal stayed pending).  A
   fatal signal resets the core and returns -EINTR.
 - vpu_interrupt(): an error interrupt (no ENDFLAG/BSFULL) completes the
   wait - the handler masks all sources, so nothing else would follow -
   and vpu_wait_complete() reports it as a failure (core reset) instead
   of waiting out the timeout.
 - vpu_wait_bs_complete(): same killable wait; a timeout or an empty
   length returns an error instead of resetting the core and waiting
   again forever for an interrupt the reset core cannot raise.
 - soc_channel_request()/soc_vpu_request(): killable waits, no
   ERESTARTSYS retry loop.
 - The kernel pointers channel_node.vlist/.clist and init_buf_info.clist
   (and the suspend/resume vlist) are checked against vpu_list[] and
   channel_list[] before use: CHANNEL_REL, RUN, START (clist, used by the
   cache flush), WAIT_COMPLETE, WAIT_BSFULL_COMPLETE, SET_BSFULL_PADDR,
   BUF_INIT, PRIVATE_TLB, VPU_SUSPEND/RESUME return -EINVAL otherwise.
 - IOCTL_CHANNEL_WOR_VPU_REG only reads/writes aligned words inside the
   Helix register window(s) (HELIX_IOBASE_UNIT(i) + 1 MiB), the Radix
   window when built, and on T23 the IVDC page (0x13200000 + 4 KiB);
   -EPERM otherwise.  The OEM T21/T23 libimp only reads Helix registers
   with it (_jz_hwicodec_pf_h264e_t21_set_priv, 0x1310xxxx on T23,
   0x1320xxxx on T21); OpenIMP does not use it.
 - Channels remember the requesting struct file; close releases the
   channels of that file (or all on the last close) instead of those
   whose tgid/pid equals the closing thread.  The release tests and
   clears the phase under clist->slock and never adds a node that is
   already on the free list.
 - /sys/module/helix/parameters/bsf_stop (read-only, 1): marker for
   userspace that BSFULL-only stops are handled (0096) and waits are
   bounded; OpenIMP enables the core's bitstream-full stop only then.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
--- a/drivers/video/soc_vpu/helix/helix.c
+++ b/drivers/video/soc_vpu/helix/helix.c
@@ -20,6 +20,17 @@
 
 static int timeoffset = 50;
 static int data_threshold = 500;
+
+/*
+ * Read-only marker for userspace (/sys/module/helix/parameters/bsf_stop):
+ * a job that ends on BSFULL without ENDFLAG is reported with this job's
+ * length and the core is stopped before the VPU is handed back, and all
+ * waits are bounded.  Kernels without it report a stale length on such a
+ * stop, so userspace must not enable the bitstream-full interrupt there.
+ */
+static int bsf_stop = 1;
+module_param(bsf_stop, int, 0444);
+MODULE_PARM_DESC(bsf_stop, "1: BSFULL-only stops are safe to request (read-only)");
 struct jz_vpu_helix {
 	struct vpu          vpu;
 	char                name[16];
@@ -275,11 +286,25 @@ enc_cancel:
 static long vpu_wait_complete(struct device *dev, struct channel_node * const cnode)
 {
 	long ret = 0, bsreadcnt = 3;
-	bool bsfull_only;
+	bool bsfull_only, hw_error;
 	struct jz_vpu_helix *vpu = dev_get_drvdata(dev);
 
-hard_vpu_wait_restart:
-	ret = wait_for_completion_interruptible_timeout(&vpu->done, msecs_to_jiffies(cnode->mdelay));
+	/*
+	 * One bounded wait for the whole job.  The old interruptible wait
+	 * restarted with the full timeout on every signal and spun while a
+	 * signal stayed pending, so a dying process (or a stream of signals)
+	 * could keep the caller - and the VPU - here forever.  Only a fatal
+	 * signal ends the wait early; the core is then stopped below.
+	 */
+	ret = wait_for_completion_killable_timeout(&vpu->done, msecs_to_jiffies(cnode->mdelay));
+	/*
+	 * An error interrupt (resolution, bitstream or ACFG error without
+	 * ENDFLAG/BSFULL) completes the wait too: the handler has masked all
+	 * interrupt sources, so no end-of-frame will follow.
+	 */
+	hw_error = (ret > 0) && !(vpu->status & (SCH_STAT_ENDFLAG | SCH_STAT_BSFULL));
+	if (hw_error)
+		ret = 0;
 	/*
 	 * BSFULL without ENDFLAG: the bitstream buffer is full and the core is
 	 * paused in the middle of the picture.  The interrupt handler does not
@@ -325,10 +350,17 @@ hard_vpu_wait_restart:
 		ret = 0;
 		dev_dbg(vpu->vpu.dev, "[%d:%d] wait complete finish\n", current->tgid, current->pid);
 	} else if (ret == -ERESTARTSYS) {
-		dev_dbg(vpu->vpu.dev, "[%d:%d]:fun:%s,line:%d vpu is interrupt\n", current->tgid, current->pid, __func__, __LINE__);
-		goto hard_vpu_wait_restart;
+		dev_dbg(vpu->vpu.dev, "[%d:%d] fatal signal, stopping the core\n", current->tgid, current->pid);
+		if (vpu_reset(dev) < 0) {
+			dev_warn(dev, "vpu reset failed\n");
+		}
+		vpu->bslen = 0;
+		ret = -EINTR;
 	} else {
-		dev_warn(dev, "[%d:%d] wait_for_completion timeout\n", current->tgid, current->pid);
+		if (hw_error)
+			dev_warn(dev, "[%d:%d] vpu error interrupt, status = %x\n", current->tgid, current->pid, vpu->status);
+		else
+			dev_warn(dev, "[%d:%d] wait_for_completion timeout\n", current->tgid, current->pid);
 		dev_warn(dev, "vpu_stat = %x\n", vpu_readl(vpu,REG_SCH_STAT));
 		dev_warn(dev, "vdma_task = %x\n", vpu_readl(vpu,REG_VDMA_TASKST));
 		dev_warn(dev, "ret = %ld\n", ret);
@@ -380,8 +412,22 @@ static long vpu_wait_bs_complete(struct device *dev, struct channel_node *cnode)
 	unsigned int bs_paddr;
 	struct jz_vpu_helix *vpu = dev_get_drvdata(dev);
 
-hard_vpu_wait_bs_restart:
-	ret = wait_for_completion_interruptible_timeout(&vpu->done, msecs_to_jiffies(cnode->mdelay));
+	/*
+	 * Bounded like vpu_wait_complete(): a fatal signal or a timeout ends
+	 * the wait with an error.  The old code went back to waiting after
+	 * resetting the core on a timeout - for an interrupt the reset core
+	 * can never raise - and so never returned.
+	 */
+	ret = wait_for_completion_killable_timeout(&vpu->done, msecs_to_jiffies(cnode->mdelay));
+	if (ret <= 0) {
+		dev_warn(dev, "[%d:%d] wait_bs %s, status = %x\n", current->tgid, current->pid,
+			 ret ? "interrupted" : "timeout", vpu_readl(vpu, REG_SCH_STAT));
+		if (vpu_reset(dev) < 0) {
+			dev_warn(dev, "vpu reset failed\n");
+		}
+		bs_cnt = 0;
+		return ret ? -EINTR : -1;
+	}
 	vpu_stat = vpu->status;
 	bs_paddr = vpu_readl(vpu, REG_EMC_BS_ADDR);
 
@@ -425,7 +471,8 @@ hard_vpu_wait_bs_restart:
 			if (vpu_reset(dev) < 0) {
 				dev_warn(dev, "vpu reset failed\n");
 			}
-			goto hard_vpu_wait_bs_restart;
+			bs_cnt = 0;
+			return -1;
 		}
 		cnode->output_len = vpu->bslen;
 		cnode->status = vpu->status;
@@ -482,12 +529,21 @@ hard_vpu_wait_bs_restart:
 			if (vpu_reset(dev) < 0) {
 				dev_warn(dev, "vpu reset failed\n");
 			}
-			goto hard_vpu_wait_bs_restart;
+			bs_cnt = 0;
+			return -1;
 		}
 		cnode->output_len = vpu->bslen;
 		cnode->status = vpu->status;
 		cnode->cmpx = vpu->cmpx;
 		ret = 0x4;
+	} else {
+		/* error interrupt: neither end of frame nor bitstream full */
+		dev_warn(dev, "[%d:%d] vpu error interrupt, status = %x\n", current->tgid, current->pid, vpu_stat);
+		if (vpu_reset(dev) < 0) {
+			dev_warn(dev, "vpu reset failed\n");
+		}
+		bs_cnt = 0;
+		ret = -1;
 	}
 
 	return ret;
@@ -560,6 +616,12 @@ static irqreturn_t vpu_interrupt(int irq, void *dev)
 			vpu->bslen = 0;
 			vpu->status = vpu_stat;
 			vpu->cmpx = 0;
+			/*
+			 * All interrupt sources are masked above, so this job
+			 * ends here: wake the waiter now instead of letting it
+			 * sit out the full timeout.
+			 */
+			complete(&vpu->done);
 		}
 	}
 
--- a/drivers/video/soc_vpu/soc_vpu.c
+++ b/drivers/video/soc_vpu/soc_vpu.c
@@ -8,6 +8,7 @@
 #include <linux/syscalls.h>
 #include <mach/libdmmu.h>
 #include <asm/delay.h>
+#include <soc/base.h>
 
 #include "soc_vpu.h"
 
@@ -21,6 +22,50 @@ static struct channel_list channel_list[CONFIG_CHANNEL_NODE_NUM];
 static int vpu_node_num = 0;
 static struct vpu_list vpu_list[CONFIG_VPU_NODE_NUM];
 struct soc_channel *soc_channel = NULL;
+
+/*
+ * channel_node.vlist / .clist and init_buf_info.clist are kernel pointers
+ * that make a round trip through userspace.  Only accept the addresses of
+ * our own nodes; anything else would be dereferenced (and written) as a
+ * kernel object.
+ */
+static struct vpu_list *soc_vpu_find_vlist(const struct list_head *node)
+{
+	int i;
+
+	for (i = 0; i < vpu_node_num; i++) {
+		if ((node == &vpu_list[i].list) && vpu_list[i].vlist)
+			return &vpu_list[i];
+	}
+	return NULL;
+}
+
+static struct channel_list *soc_vpu_find_clist(const struct list_head *node)
+{
+	int i;
+
+	for (i = 0; i < CONFIG_CHANNEL_NODE_NUM; i++) {
+		if (node == &channel_list[i].list)
+			return &channel_list[i];
+	}
+	return NULL;
+}
+
+/* A NULL pointer passes unless the ioctl needs that node. */
+static long soc_vpu_check_cnode(struct soc_channel *sc, const struct channel_node *cnode,
+				bool need_vlist, bool need_clist)
+{
+	if ((cnode->vlist || need_vlist) && !soc_vpu_find_vlist(cnode->vlist))
+		goto err_bad_node;
+	if ((cnode->clist || need_clist) && !soc_vpu_find_clist(cnode->clist))
+		goto err_bad_node;
+	return 0;
+
+err_bad_node:
+	dev_err_ratelimited(sc->mdev.this_device, "[%d:%d] invalid vpu/channel node %p/%p\n",
+			    current->tgid, current->pid, cnode->vlist, cnode->clist);
+	return -EINVAL;
+}
 /*
  * Vpu_register needn't lock because there are only
  * one process using it at the register context.
@@ -323,7 +368,7 @@ static int channel_tlb_unmap_all_vaddr(struct device *dev, struct channel_list *
 }
 #endif
 
