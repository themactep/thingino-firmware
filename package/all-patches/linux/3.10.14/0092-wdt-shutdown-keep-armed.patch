diff --git i/arch/mips/xburst/soc-4775/common/reset.c w/arch/mips/xburst/soc-4775/common/reset.c
index c1538565b..a00ccecc7 100644
--- i/arch/mips/xburst/soc-4775/common/reset.c
+++ w/arch/mips/xburst/soc-4775/common/reset.c
@@ -395,7 +395,13 @@ int wdt_suspend(struct platform_device *pdev, pm_message_t state)
 
 void wdt_shutdown(struct platform_device *pdev)
 {
-	wdt_stop_count();
+	/*
+	 * Do NOT stop the WDT here.
+	 * The hardware watchdog must stay armed as a fallback:
+	 * if device_shutdown() hangs on another device, or if
+	 * jz_wdt_restart() fails to fire, the WDT will reset the
+	 * system within the timeout configured by userspace.
+	 */
 }
 
 int wdt_resume(struct platform_device *pdev)
