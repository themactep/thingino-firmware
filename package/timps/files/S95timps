#!/bin/sh

PIDFILE=/var/run/timpsd.pid
DAEMON=/usr/bin/timpsd
CONF=/etc/timps.conf

conf_get() {
	sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" "$CONF" 2>/dev/null |
		sed 's/[[:space:]]*#.*$//; s/^"\(.*\)"$/\1/; s/^'\''\(.*\)'\''$/\1/' |
		head -n1
}

UHTTPD_CRT=/etc/ssl/certs/uhttpd.crt
UHTTPD_KEY=/etc/ssl/private/uhttpd.key

# link (not copy) the WebUI cert: one browser trust decision then covers both ports
ensure_tls_certs() {
	case "$(conf_get http.https | tr '[:upper:]' '[:lower:]')" in
		1 | 2 | true | yes | on) ;;
		*)
			[ "$(conf_get rtsp.tls)" = "1" ] ||
				case "$(conf_get webrtc.enabled)" in
					1 | 2) ;;
					*) return 0 ;;
				esac
			;;
	esac
	crt=$(conf_get http.tls_cert)
	key=$(conf_get http.tls_key)
	[ -n "$crt" ] && [ -n "$key" ] || return 0
	[ -s "$crt" ] && [ -s "$key" ] && return 0

	if [ "$crt" != "$UHTTPD_CRT" ] && [ "$key" != "$UHTTPD_KEY" ] &&
		[ -s "$UHTTPD_CRT" ] && [ -s "$UHTTPD_KEY" ]; then
		mkdir -p "$(dirname "$crt")" "$(dirname "$key")"
		if ln -sf "$UHTTPD_CRT" "$crt" && ln -sf "$UHTTPD_KEY" "$key"; then
			logger -t timps "TLS: sharing the web UI certificate ($UHTTPD_CRT)"
			return 0
		fi
		# a half-made link would leave timpsd with a cert and no key
		rm -f "$crt" "$key"
		logger -t timps "TLS: could not link $UHTTPD_CRT, generating our own"
	fi

	[ -x /usr/bin/generate-timps-tls-certs.sh ] || return 0
	out=$(/usr/bin/generate-timps-tls-certs.sh "$crt" "$key" 2>&1) ||
		logger -t timps "TLS cert generation failed: $out"
}

# tr: busybox grep stops at NUL bytes
preflight() {
	tr -d '\000' 2>/dev/null <"$DAEMON" | grep -q -- --check-libs || return 0
	out=$("$DAEMON" --check-libs 2>&1)
	rc=$?
	case $rc in
	0) return 0 ;;
	78 | 79)
		echo "$out" | while IFS= read -r l; do
			[ -n "$l" ] || continue
			logger -t timps -p daemon.err "$l"
			echo "$l"
		done
		msg="timpsd not started (exit $rc): libimp does not fit this timpsd build"
		logger -t timps -p daemon.err "$msg"
		echo "$msg"
		return 1
		;;
	*)
		[ -z "$out" ] ||
			logger -t timps -p daemon.warn "timpsd --check-libs exited $rc, starting anyway: $(echo "$out" | head -n 1)"
		return 0
		;;
	esac
}

# starting a new instance before the old one has exited makes ISP init fail
wait_stop() {
	# busybox usleep is optional; without it the loop runs in 1 s steps
	usleep 1 2>/dev/null && n=50 || n=5
	i=0
	while [ "$i" -lt "$n" ]; do
		[ -f "$PIDFILE" ] || return 0
		p=$(cat "$PIDFILE" 2>/dev/null)
		[ -n "$p" ] && kill -0 "$p" 2>/dev/null || return 0
		i=$((i + 1))
		usleep 100000 2>/dev/null || sleep 1
	done
	return 1
}

case "$1" in
	start)
		echo "Starting timpsd..."
		preflight || exit 1
		ensure_tls_certs
		start-stop-daemon -S -b -m -p "$PIDFILE" \
			-x "$DAEMON" -- -c "$CONF"
		;;
	stop)
		echo "Stopping timpsd..."
		start-stop-daemon -K -p "$PIDFILE" 2>/dev/null
		if ! wait_stop; then
			echo "timpsd not responding, sending KILL..."
			start-stop-daemon -K -s KILL -p "$PIDFILE" 2>/dev/null
		fi
		# keep the pidfile while the process lives: restart and start-stop-daemon -S rely on it
		if wait_stop; then
			rm -f "$PIDFILE"
		else
			echo "timpsd still stopping..."
		fi
		;;
	restart)
		"$0" stop
		wait_stop
		"$0" start || exit 1
		;;
	status)
		if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null; then
			echo "timpsd running (pid $(cat "$PIDFILE"))"
			exit 0
		fi
		echo "timpsd not running"
		exit 1
		;;
	*)
		echo "Usage: $0 {start|stop|restart|status}"
		exit 1
		;;
esac

exit 0
