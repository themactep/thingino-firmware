#!/bin/sh
# daynight.irprobe_cmd target: timps's silent day/night probe execs
# "<cmd> on|off" (no shell) to blip the illuminators for one dark reading.
# Idle-Dark (daynight.ir_idle_off) adds "idle" (off with a long watchdog:
# dark on purpose until a consumer arrives) and "state" (prints on|off).
#
# Switches the same set as the board's `daynight` script: ir850, ir940 and
# white, each gated by thingino.json daynight.controls.* with that script's
# defaults, and only if `light` resolves a pin. Any of them left lit makes
# the probe read as day.
#
# "off" arms a detached watchdog: the daemon has no failsafe, so if it dies
# during the dark window the illuminators would stay off. Stamped and
# nonce-checked so a newer "on"/"off"/"idle" invalidates every older watchdog.
# "idle" arms one too, longer than timps's 600 s re-assert that renews it; it
# stands down if the board script has since switched to day. "state" leaves
# the stamp alone.
#
# Exit: 0 ok, 1 nothing switchable, 2 unknown verb, 3 "idle" refused because
# white light is in the set (it would light the ambient reading), 4 "idle"
# could not switch or stamp (rolled back).
cfg=${THINGINO_CONFIG:-/etc/thingino.json}
stamp=${STAMP_DIR:-/run}/timps-irprobe
delay=${IRPROBE_WATCHDOG_S:-60}
idle_delay=${IRPROBE_IDLE_WATCHDOG_S:-900}
mode_file=${DAYNIGHT_MODE_FILE:-/run/thingino/daynight_mode}

lights=
for t in ir850:true ir940:true white:false; do
	v=$(jct "$cfg" get "daynight.controls.${t%:*}" 2>/dev/null) || v=${t#*:}
	[ "$v" = true ] && [ -n "$(light "${t%:*}" gpio 2>/dev/null)" ] &&
		lights="$lights ${t%:*}"
done
[ -n "$lights" ] || exit 1 # nothing switchable: timps logs it and skips the probe

case "$1" in
on)
	rm -f "$stamp"
	rc=0
	for t in $lights; do
		light "$t" on || rc=$?
	done
	exit "$rc"
	;;
off)
	nonce=$$
	# before switching, so an older watchdog cannot relight mid-way;
	# without a stamp there is no failsafe, so stay lit
	echo "$nonce" >"$stamp" || exit 1
	dark=
	for t in $lights; do
		light "$t" off
		rc=$?
		if [ "$rc" -ne 0 ]; then
			rm -f "$stamp"
			for u in $dark; do
				light "$u" on
			done
			exit "$rc"
		fi
		dark="$dark $t"
	done
	(
		sleep "$delay"
		[ "$(cat "$stamp" 2>/dev/null)" = "$nonce" ] || exit 0
		for t in $lights; do
			light "$t" on
		done
	) >/dev/null 2>&1 &
	exit 0
	;;
idle)
	case " $lights " in *" white "*) exit 3 ;; esac
	nonce=$$
	echo "$nonce" >"$stamp" || exit 4
	dark=
	for t in $lights; do
		if ! light "$t" off; then
			rm -f "$stamp"
			for u in $dark; do
				light "$u" on
			done
			exit 4
		fi
		dark="$dark $t"
	done
	(
		sleep "$idle_delay"
		[ "$(cat "$stamp" 2>/dev/null)" = "$nonce" ] || exit 0
		[ "$(cat "$mode_file" 2>/dev/null)" = day ] && exit 0
		for t in $lights; do
			light "$t" on
		done
	) >/dev/null 2>&1 &
	exit 0
	;;
state)
	for t in $lights; do
		[ "$(light "$t" read 2>/dev/null)" = 0 ] || {
			echo on
			exit 0
		}
	done
	echo off
	exit 0
	;;
esac
exit 2
