#!/bin/sh
# daynight.irprobe_cmd target: timps's silent day/night probe execs
# "<cmd> on|off" (no shell) to blip the illuminators for one dark reading.
#
# Switches the same set as the board's `daynight` script: ir850, ir940 and
# white, each gated by thingino.json daynight.controls.* with that script's
# defaults, and only if `light` resolves a pin. Any of them left lit makes
# the probe read as day.
#
# "off" arms a detached watchdog: the daemon has no failsafe, so if it dies
# during the dark window the illuminators would stay off. Stamped and
# nonce-checked so a newer "on"/"off" invalidates every older watchdog.
cfg=${THINGINO_CONFIG:-/etc/thingino.json}
stamp=${STAMP_DIR:-/run}/timps-irprobe
delay=${IRPROBE_WATCHDOG_S:-60}

lights=
for t in ir850:true ir940:true white:false; do
	v=$(jct "$cfg" get "daynight.controls.${t%:*}" 2>/dev/null) || v=${t#*:}
	[ "$v" = true ] && [ -n "$(light "${t%:*}" gpio 2>/dev/null)" ] &&
		lights="$lights ${t%:*}"
done
[ -n "$lights" ] || exit 1 # nothing switchable: timps logs it and skips the probe

case "$1" in
on)
	rm -f "$stamp"
	rc=0
	for t in $lights; do
		light "$t" on || rc=$?
	done
	exit "$rc"
	;;
off)
	nonce=$$
	# before switching, so an older watchdog cannot relight mid-way;
	# without a stamp there is no failsafe, so stay lit
	echo "$nonce" >"$stamp" || exit 1
	dark=
	for t in $lights; do
		light "$t" off
		rc=$?
		if [ "$rc" -ne 0 ]; then
			rm -f "$stamp"
			for u in $dark; do
				light "$u" on
			done
			exit "$rc"
		fi
		dark="$dark $t"
	done
	(
		sleep "$delay"
		[ "$(cat "$stamp" 2>/dev/null)" = "$nonce" ] || exit 0
		for t in $lights; do
			light "$t" on
		done
	) >/dev/null 2>&1 &
	exit 0
	;;
esac
exit 2
