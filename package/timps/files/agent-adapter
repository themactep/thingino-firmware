# POST one image.kv via /control and echo the accepted update.
agent_set_image_int() {
	body_file=$1
	path=$2
	key=$3
	ctl_key=$4
	value=$(agent_setting_value "$body_file" "$key") || return 1
	agent_validate_int "$value" || return 1
	agent_control_set "{\"image\":{\"$ctl_key\":$value}}" || {
		echo "failed to apply image.$ctl_key" >&2
		return 1
	}
	agent_print_setting_update "$path" "$key" "$value"
}

agent_set_setting() {
