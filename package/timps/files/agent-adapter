			fi
			agent_print_setting_update "$path" spk_enabled "$value"
			;;
		motion/enabled)
			value=$(agent_setting_value "$body_file" enabled) || return 1
			agent_validate_bool "$value" || return 1
			raw=$(agent_json_bool_to_01 "$value") || return 1
			agent_control_set "{\"motion\":{\"enabled\":$raw}}" >/dev/null || return 1
