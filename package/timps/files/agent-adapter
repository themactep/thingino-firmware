# ---- privacy ----

AGENT_PRIVACY_STATE="${AGENT_PRIVACY_STATE:-/run/agent/timps-privacy}"

agent_privacy_enabled() {
	# timps privacy masks are reflected in capslookups; persist a state file so
	# the privacy toggle round-trips even when a mask is only re-created live.
	if [ -r "$AGENT_PRIVACY_STATE" ]; then
		value=$(sed -n '1p' "$AGENT_PRIVACY_STATE" 2>/dev/null | tr -d '\r\n')
		case "$value" in
			true | false)
				printf '%s' "$value"
				return 0
				;;
		esac
	fi
	printf 'false'
}

agent_privacy_write_state() {
	dir=$(dirname "$AGENT_PRIVACY_STATE")
	mkdir -p "$dir" 2>/dev/null || true
	printf '%s\n' "$1" >"$AGENT_PRIVACY_STATE" 2>/dev/null || true
}

agent_privacy_apply() {
	state=$1
	# A single all-channel privacy mask in slot 0: enabled -> show a full-frame
	# black mask, disabled -> hide it. Uses the canonical privacy.0.0 form.
	if [ "$state" = true ]; then
		agent_control_set '{"privacy":{"0":{"0":{"enabled":1,"x":0,"y":0,"w":4096,"h":4096,"color":"0xFF000000"}}}}'
	else
		agent_control_set '{"privacy":{"0":{"0":{"enabled":0}}}}'
	fi
	agent_privacy_write_state "$state"
}

# ---- action helpers ----

agent_heartbeat_hw_state() {
	cmd=${1%% *}
	command -v "$cmd" >/dev/null 2>&1 || {
		printf 'null'
		return 0
	}
	value=$(eval "$1 read" 2>/dev/null)
	case "$value" in
		'' | *[!0-9]*) printf 'null' ;;
		*) printf '%s' "$value" ;;
	esac
}

# ---- setting value helpers (mirroring raptor) ----

agent_setting_value() {
	body_file=$1
	field=$2
	value=$(agent_json_config_value "$body_file" "$field")
	[ -n "$value" ] || {
		echo "missing field '$field'" >&2
		return 1
	}
	printf '%s' "$value"
}

agent_validate_bool() {
	case "$1" in
		true | false) return 0 ;;
		*)
			echo "boolean value required" >&2
			return 1
			;;
	esac
}

agent_validate_int() {
	case "$1" in
		'' | *[!0-9-]*)
			echo "integer value required" >&2
			return 1
			;;
		*) return 0 ;;
	esac
}

agent_unquote_string() {
	printf '%s' "$1" | tr -d '"'
}

agent_validate_stream_format() {
	value=$(agent_unquote_string "$1" | tr 'a-z' 'A-Z')
	case "$value" in
		H264 | H265)
			printf '%s' "$value"
			return 0
			;;
		*)
			echo "stream format must be H264 or H265" >&2
			return 1
			;;
	esac
}

agent_validate_stream_mode() {
	value=$(agent_unquote_string "$1" | tr 'a-z' 'A-Z')
	case "$value" in
		CBR | VBR | SMART | FIXQP | CAPPED_VBR | CAPPED_QUALITY)
			printf '%s' "$value"
			return 0
			;;
		*)
			echo "stream mode must be CBR, VBR, SMART, FIXQP, CAPPED_VBR, or CAPPED_QUALITY" >&2
			return 1
			;;
	esac
}

agent_format_to_codec() {
	printf '%s' "$1" | tr 'A-Z' 'a-z'
}

agent_mode_to_rc() {
	printf '%s' "$1" | tr 'A-Z' 'a-z'
}

