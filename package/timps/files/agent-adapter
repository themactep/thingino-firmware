#!/bin/sh
# shellcheck disable=SC2018,SC2019,SC2086  # tr a-z/A-Z on ASCII values; deliberate IFS word-splits into positional params

AGENT_CONFIG="${AGENT_CONFIG:-/etc/timps.conf}"
THINGINO_AGENT_SEND2_CONFIG="${THINGINO_AGENT_SEND2_CONFIG:-/etc/send2.json}"
AGENT_TIMPS_TOKEN_FILE="${AGENT_TIMPS_TOKEN_FILE:-/run/timps.token}"
AGENT_TMPDIR="${AGENT_TMPDIR:-/tmp}"

agent_name() {
	printf 'timps'
}

# ---- config file access ----
# timps is a plain "key = value" file; file-only / restart-only keys (rtsp.port,
# http.port, record.dir, motion.cooldown_ms, motion.on_motion, ...) are read
# here. Live-persisted keys are read from GET /control instead.

agent_conf_get() {
	sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" "$AGENT_CONFIG" 2>/dev/null |
		sed 's/[[:space:]]*#.*$//; s/^"\(.*\)"$/\1/; s/^'\''\(.*\)'\''$/\1/' |
		head -n1
}

agent_conf_bool() {
	value=$(agent_conf_get "$1" | tr 'A-Z' 'a-z')
	case "$value" in
		1 | true | yes | on) printf 'true' ;;
		0 | false | no | off) printf 'false' ;;
		*)
			printf '%s' "${2:-false}"
			;;
	esac
}

# ---- /control HTTP transport ----
# timps skips auth for loopback (127.0.0.0/8), so the on-device agent reaches
# /control directly; the per-boot token is still sent when available.

agent_timps_port() {
	port=$(agent_conf_get http.port | tr -cd '0-9')
	[ -n "$port" ] || port=8880
	printf '%s' "$port"
}

agent_timps_scheme() {
	case "$(agent_conf_get http.https | tr 'A-Z' 'a-z')" in
		1 | true | yes | on) printf 'https' ;;
		*) printf 'http' ;;
	esac
}

agent_control_url() {
	printf '%s://127.0.0.1:%s/control' "$(agent_timps_scheme)" "$(agent_timps_port)"
}

# GET /control -> the full JSON doc, cached once per adapter invocation.
agent_control_json() {
	_cache="$AGENT_TMPDIR/agent-timps-control.$$"
	if [ ! -s "$_cache" ]; then
		url=$(agent_control_url)
		curl_k=""
		[ "$(agent_timps_scheme)" = https ] && curl_k="-k"
		# shellcheck disable=SC2086
		curl --silent --fail --max-time 15 $curl_k "$url" >"$_cache" 2>/dev/null || {
			rm -f "$_cache"
			return 0
		}
	fi
	cat "$_cache" 2>/dev/null
}

# POST /control with a nested JSON payload. timps applies + persists changed
# keys. The cached snapshot is invalidated so subsequent reads see the change.
agent_control_set() {
	url=$(agent_control_url)
	curl_k=""
	[ "$(agent_timps_scheme)" = https ] && curl_k="-k"
	token=
	[ -r "$AGENT_TIMPS_TOKEN_FILE" ] &&
		token=$(sed -n '1p' "$AGENT_TIMPS_TOKEN_FILE" 2>/dev/null | tr -cd '0-9A-Za-z')
	# shellcheck disable=SC2086
	if [ -n "$token" ]; then
		curl --silent --fail --max-time 15 $curl_k -X POST \
			-H "X-Timps-Token: $token" -H 'Content-Type: application/json' \
			-d "$1" "$url" >/dev/null 2>&1
	else
		curl --silent --fail --max-time 15 $curl_k -X POST \
			-H 'Content-Type: application/json' -d "$1" "$url" >/dev/null 2>&1
	fi
	rm -f "$AGENT_TMPDIR/agent-timps-control.$$" 2>/dev/null
}

# ---- JSON parsing (both helpers are self-contained awk programs) ----

agent_jsec() {
	# Balances the raw object body for `"<sec>":[ \t]*{ ... }`. Feed the whole
	# control doc on stdin; prints the balanced object (or nothing).
	sec=$1
	awk -v sec="$sec" '
		{
			str = $0; n = length(str)
			m = match(str, "\"" sec "\"[ \t]*:[ \t]*{")
			if (m == 0) exit
			found = RSTART
			while (substr(str, found, 1) != "{") found++
			i = found; depth = 0
			while (i <= n) {
				c = substr(str, i, 1)
				if (c == "\"") {
					i++
					while (i <= n) {
						x = substr(str, i, 1)
						if (x == "\\") { i += 2; continue }
						if (x == "\"") break
						i++
					}
					i++
					continue
				}
				if (c == "{") depth++
				else if (c == "}") { depth--; if (depth <= 0) { i++; break } }
				i++
			}
			print substr(str, found, i - found)
		}'
}

agent_jleaf() {
	# Extracts a unique leaf value for `key` from a single-line JSON object body
	# on stdin. Feed a section body (from agent_jsec) unless the key is already
	# globally unique. De-escapes strings; prints numbers/bools/arrays verbatim.
	key=$1
	awk -v key="$key" '
		{
			str = $0; n = length(str)
			m = match(str, "\"" key "\"[ \t]*:")
			if (m == 0) exit
			j = RSTART + RLENGTH
			while (j <= n && substr(str, j, 1) ~ "[ \t]") j++
			c = substr(str, j, 1)
			if (c == "\"") {
				j++; v = ""
				while (j <= n) {
					x = substr(str, j, 1)
					if (x == "\\") { v = v substr(str, j+1, 1); j += 2; continue }
					if (x == "\"") break
					v = v x; j++
				}
				print v; exit
			}
			if (c == "{" || c == "[") {
				depth = 0; v = ""
				while (j <= n) {
					x = substr(str, j, 1)
					if (x == "\"") {
						v = v x; j++
						while (j<=n) {
							y = substr(str, j, 1)
							if (y == "\\") { v = v y; j++; v = v substr(str, j, 1); j++ }
							else if (y == "\"") { v = v y; j++; break }
							else { v = v y; j++ }
						}
						continue
					}
					if (x == "{" || x == "[") { depth++; v = v x; j++; continue }
					if (x == "}" || x == "]") { depth--; v = v x; j++; if (depth <= 0) break; continue }
					v = v x; j++
				}
				print v; exit
			}
			v = ""
			while (j <= n) {
				x = substr(str, j, 1)
				if (x == "," || x == "}" || x == "]") break
				v = v x; j++
			}
			print v
		}'
}

# Read a section from the cached control doc: `agent_section <name>`.
agent_section() {
	agent_control_json | agent_jsec "$1" 2>/dev/null
}

# Read a leaf from a section object. `agent_leaf <key> <section-json>`.
agent_leaf() {
	key=$1
	section=$2
	printf '%s\n' "$section" | agent_jleaf "$key" 2>/dev/null
}

# Convenience: read `section.key` from the live control snapshot.
agent_ctrl() {
	path=$1
	section=${path%%.*}
	key=${path#*.}
	case "$path" in
		*.*.*)
			# video.N.key / osdN.N.key / privacyN.N.key: scope through the
			# numeric sub-object first.
			top=${path%%.*}
			idx=${path#*.}
			idx=${idx%%.*}
			leaf=${path#*.*.}
			obj=$(agent_section "$top")
			sub=$(printf '%s\n' "$obj" | agent_jsec "$idx" 2>/dev/null)
			agent_leaf "$leaf" "$sub"
			;;
		*)
			agent_leaf "$key" "$(agent_section "$section")"
			;;
	esac
}

agent_ctrl_int() {
	value=$(agent_ctrl "$1")
	[ -n "$value" ] || return 0
	printf '%s' "$value" | tr -cd '0-9-'
}

# ---- capability probes ----

agent_has_control() {
	# The whole adapter depends on the /control endpoint (USE_CONTROL builds).
	[ -n "$(agent_control_json)" ]
}

agent_streamer_running() {
	pidof timpsd >/dev/null 2>&1 && printf 'true' || printf 'false'
}

agent_network_ip() {
	agent_default_ip
}

agent_network_online() {
	ip_addr=$(agent_network_ip)
	[ -n "$ip_addr" ] && printf 'true' || printf 'false'
}

agent_service_script() {
	[ -f /etc/init.d/S95timps ] && printf '/etc/init.d/S95timps'
}

agent_streaming_controllable() {
	[ -n "$(agent_service_script)" ] && printf 'true' || printf 'false'
}

agent_health_status() {
	if [ "$(agent_streamer_running)" = true ] && [ "$(agent_network_online)" = true ]; then
		printf 'ok'
	else
		printf 'degraded'
	fi
}

# Streamer-built, so capability is not gated on the presence of an external
# helper binary. Snapshots come from GET /control + a loopback /snapshot.jpg.
agent_has_snapshot() {
	agent_has_control && printf 'true' || printf 'false'
}

agent_has_clip() {
	# fMP4 recording + one-shot /control clip require USE_RECORD.
	case "$(agent_ctrl record.available 2>/dev/null)" in
		1) printf 'true' ;;
		*)
			# Classic older builds expose it under caps.record.available.
			caps=$(agent_section caps)
			rec=$(printf '%s\n' "$caps" | agent_jsec record 2>/dev/null)
			case "$(printf '%s\n' "$rec" | agent_jleaf available 2>/dev/null)" in
				1) printf 'true' ;;
				*) printf 'false' ;;
			esac
			;;
	esac
}

agent_has_privacy() {
	# Privacy masks need an OSD group on the stream; caps.privacy reports that.
	caps=$(agent_section caps)
	priv=$(printf '%s\n' "$caps" | agent_jsec privacy 2>/dev/null)
	case "$(printf '%s\n' "$priv" | agent_jleaf available 2>/dev/null)" in
		1) printf 'true' ;;
		*) printf 'false' ;;
	esac
}

agent_has_daynight() {
	# timps ships its own native day/night thread; anything with /control has it.
	agent_has_control && printf 'true' || printf 'false'
}

agent_has_ptz() {
	command -v motors >/dev/null 2>&1 && printf 'true' || printf 'false'
}

agent_stream_count() {
	printf '2'
}

agent_send2_service_supported() {
	case "$1" in
		email | ftp | gphotos | mqtt | ntfy | storage | telegram | webhook) return 0 ;;
		*)
			echo "unsupported send2 service: $1" >&2
			return 1
			;;
	esac
}

agent_send2_service_has_send_video() {
	case "$1" in
		email | ftp | gphotos | mqtt | ntfy | storage | telegram | webhook) return 0 ;;
		*) return 1 ;;
	esac
}

agent_send2_raw() {
	service=$1
	field=$2
	agent_json_config_value "$THINGINO_AGENT_SEND2_CONFIG" "$service.$field"
}

agent_send2_motion_enabled() {
	agent_json_value_or \
		"$(agent_json_config_value "$THINGINO_CONFIG_FILE" "motion.send2$1")" false
}

agent_send2_motion_set() {
	service=$1
	value=$2
	command -v jct >/dev/null 2>&1 || {
		echo "jct is not available" >&2
		return 1
	}
	[ -f "$THINGINO_CONFIG_FILE" ] || {
		echo "missing $THINGINO_CONFIG_FILE" >&2
		return 1
	}
	jct "$THINGINO_CONFIG_FILE" set "motion.send2$service" "$value" >/dev/null 2>&1 || {
		echo "failed to persist motion send2 flag" >&2
		return 1
	}
}

# ---- stream helpers ----

agent_stream_section() {
	printf '%s' "$1"
}

agent_stream_enabled() {
	value=$(agent_ctrl "video.$1.enabled")
	agent_json_bool "$value"
}

agent_stream_field() {
	agent_ctrl "video.$1.$2"
}

agent_stream_field_int() {
	agent_ctrl_int "video.$1.$2"
}

agent_stream_format() {
	codec=$(agent_stream_field "$1" codec | tr 'a-z' 'A-Z')
	case "$codec" in
		H264 | H265) printf '%s' "$codec" ;;
		HEVC) printf 'H265' ;;
		*) printf '%s' "$codec" ;;
	esac
}

agent_stream_mode() {
	mode=$(agent_stream_field "$1" rc_mode | tr 'a-z' 'A-Z')
	case "$mode" in
		CBR | VBR | FIXQP | SMART | CAPPED_VBR | CAPPED_QUALITY) printf '%s' "$mode" ;;
		*) printf '%s' "$mode" ;;
	esac
}

agent_rtsp_port() {
	port=$(agent_conf_get rtsp.port | tr -cd '0-9')
	[ -n "$port" ] || port=554
	printf '%s' "$port"
}

agent_rtsp_scheme() {
	case "$(agent_conf_get rtsp.tls | tr 'A-Z' 'a-z')" in
		1 | true | yes | on) printf 'rtsps' ;;
		*) printf 'rtsp' ;;
	esac
}

agent_rtsp_endpoint() {
	stream_id=$1
	ep=$(agent_stream_field "$stream_id" rtsp_path)
	case "$ep" in
		'' | null) printf 'ch%s' "$stream_id" ;;
		*) printf '%s' "${ep#/}" ;;
	esac
}

agent_stream_rtsp_url() {
	stream_id=$1
	ip_addr=$(agent_network_ip)
	[ -n "$ip_addr" ] || return 0
	endpoint=$(agent_rtsp_endpoint "$stream_id")
	[ -n "$endpoint" ] || return 0
	printf '%s://%s:%s/%s' \
		"$(agent_rtsp_scheme)" \
		"$ip_addr" \
		"$(agent_rtsp_port)" \
		"$endpoint"
}

agent_rtsp_listening() {
	port=$(agent_rtsp_port)
	if command -v netstat >/dev/null 2>&1; then
		netstat -lnt 2>/dev/null | grep -q ":${port} " && printf 'true' && return 0
	fi
	if command -v ss >/dev/null 2>&1; then
		ss -lnt 2>/dev/null | grep -q ":${port} " && printf 'true' && return 0
	fi
	pidof timpsd >/dev/null 2>&1 && printf 'true' || printf 'false'
}

# ---- motion / daynight / recording ----

agent_motion_enabled() {
	value=$(agent_ctrl motion.enabled)
	agent_json_bool "$value"
}

agent_motion_active() {
	active=$(agent_ctrl motion.active)
	case "$active" in
		\[*]) printf '%s' "$active" | grep -q '[1]' && printf 'true' || printf 'false' ;;
		*)
			last_ms=$(agent_ctrl_int motion.last_ms)
			if [ -n "$last_ms" ] && [ "$last_ms" -ge 0 ] && [ "$last_ms" -le 3000 ]; then
				printf 'true'
			else
				printf 'false'
			fi
			;;
	esac
}

agent_daynight_enabled() {
	value=$(agent_ctrl daynight.enabled)
	case "$value" in
		0 | false) printf 'false' ;;
		1 | true) printf 'true' ;;
		*) printf 'false' ;;
	esac
}

agent_daynight_running_mode() {
	mode=$(agent_ctrl_int image.running_mode)
	case "$mode" in
		1 | 2) printf 'night' ;;
		0) printf 'day' ;;
		*)
			# fall back to the config file
			case "$(agent_conf_get image.running_mode | tr -cd '0-9')" in
				1 | 2) printf 'night' ;;
				*) printf 'day' ;;
			esac
			;;
	esac
}

agent_daynight_target_mode() {
	if [ "$(agent_daynight_enabled)" = true ]; then
		printf 'auto'
		return 0
	fi
	agent_daynight_running_mode
}

agent_daynight_force_mode() {
	# Emits a raw JSON value: the quoted mode when forced, or `null` when auto.
	if [ "$(agent_daynight_enabled)" = true ]; then
		printf 'null'
	else
		agent_json_string "$(agent_daynight_running_mode)"
	fi
}

agent_recording_active() {
	value=$(agent_ctrl record.active)
	case "$value" in
		1 | true) printf 'true' ;;
		*)
			# An in-progress one-shot clip or manual override counts as active.
			case "$(agent_conf_bool record.enabled false)" in
				true)
					sp=$(agent_ctrl record.available 2>/dev/null)
					[ "$sp" = 1 ] && printf 'true' || printf 'false'
					;;
				*) printf 'false' ;;
			esac
			;;
	esac
}

agent_record_channel() {
	value=$(agent_ctrl record.channel 2>/dev/null)
	case "$value" in
		'' | *[!0-9]*) printf '0' ;;
		*) printf '%s' "$value" ;;
	esac
}

agent_stream_recording_active() {
	stream_id=$1
	if [ "$(agent_recording_active)" != true ]; then
		printf 'false'
		return 0
	fi
	[ "$(agent_record_channel)" = "$stream_id" ] && printf 'true' || printf 'false'
}

agent_stream_healthy() {
	stream_id=$1
	[ "$(agent_streamer_running)" = true ] || {
		printf 'false'
		return 0
	}
	[ "$(agent_stream_enabled "$stream_id")" = true ] || {
		printf 'false'
		return 0
	}
	printf 'true'
}

# ---- storage / recording config ----

agent_storage_path() {
	path=$(agent_ctrl record.dir 2>/dev/null)
	[ -n "$path" ] || path=$(agent_conf_get record.dir)
	[ -n "$path" ] || path=/mnt/mmcblk0p1
	printf '%s' "$path"
}

agent_storage_mount() {
	path=$(agent_storage_path)
	case "$path" in
		/mnt/*)
			printf '%s' "$path" | awk -F/ '{print "/" $2 "/" $3}'
			;;
		*)
			printf '%s' "$path"
			;;
	esac
}

agent_storage_is_mounted() {
	mount_point=$(agent_storage_mount)
	[ -n "$mount_point" ] || {
		printf 'false'
		return 0
	}
	if mount 2>/dev/null | grep -q " on ${mount_point} "; then
		printf 'true'
	elif [ -d "$mount_point" ]; then
		printf 'true'
	else
		printf 'false'
	fi
}

agent_print_runtime_storage() {
	mount_point=$(agent_storage_mount)
	record_root=$(agent_storage_path)
	mounted=$(agent_storage_is_mounted)
	writable=false
	[ "$mounted" = true ] && [ -w "$mount_point" ] && writable=true
	total_kib=null
	used_kib=null
	available_kib=null
	filesystem=
	if [ "$mounted" = true ] && [ -n "$mount_point" ]; then
		df_line=$(df -k "$mount_point" 2>/dev/null | awk 'NR == 2 { print }')
		if [ -n "$df_line" ]; then
			filesystem=$(printf '%s' "$df_line" | awk '{ print $1 }')
			total_kib=$(printf '%s' "$df_line" | awk '{ print $2 }')
			used_kib=$(printf '%s' "$df_line" | awk '{ print $3 }')
			available_kib=$(printf '%s' "$df_line" | awk '{ print $4 }')
		fi
	fi
	printf '{'
	printf '"configured_mount":%s,' "$(agent_json_string_or_null "$mount_point")"
	printf '"mounted":%s,' "$(agent_json_bool "$mounted")"
	printf '"filesystem":%s,' "$(agent_json_string_or_null "$filesystem")"
	printf '"record_root":%s,' "$(agent_json_string_or_null "$record_root")"
	printf '"writable":%s,' "$(agent_json_bool "$writable")"
	printf '"total_kib":%s,' "$(agent_json_value_or "$total_kib" null)"
	printf '"used_kib":%s,' "$(agent_json_value_or "$used_kib" null)"
	printf '"available_kib":%s' "$(agent_json_value_or "$available_kib" null)"
	printf '}'
}

agent_print_runtime_recording() {
	supported=$(agent_json_bool "$(agent_has_clip)")
	configured_autostart=$(agent_conf_bool record.enabled false)
	configured_channel=$(agent_json_value_or "$(agent_ctrl record.channel 2>/dev/null)" null)
	configured_duration=$(agent_json_value_or "$(agent_conf_get record.segment_s | tr -cd '0-9')" null)
	configured_mount=$(agent_storage_mount)
	record_root=$(agent_storage_path)
	storage_writable=$(agent_json_bool "$([ "$(agent_storage_is_mounted)" = true ] && [ -n "$configured_mount" ] && [ -w "$configured_mount" ] && printf true || printf false)")
	active=$(agent_recording_active)
	current_channel=null
	[ "$active" = true ] && current_channel=$(agent_record_channel)
	printf '{'
	printf '"supported":%s,' "$supported"
	printf '"active":%s,' "$(agent_json_bool "$active")"
	printf '"configured_autostart":%s,' "$configured_autostart"
	printf '"configured_channel":%s,' "$configured_channel"
	printf '"configured_duration_seconds":%s,' "$configured_duration"
	printf '"configured_mount":%s,' "$(agent_json_string_or_null "$configured_mount")"
	printf '"record_root":%s,' "$(agent_json_string_or_null "$record_root")"
	printf '"writable":%s,' "$storage_writable"
	printf '"current_channel":%s,' "$current_channel"
	printf '"current_duration_seconds":null,'
	printf '"current_path":null,'
	printf '"current_mount":%s,' "$(agent_json_string_or_null "$configured_mount")"
	printf '"current_directory":null,'
	printf '"current_name_template":null,'
	printf '"loop":null'
	printf '}'
}

# ---- profile / type coercion ----

agent_profile_to_name() {
	case "$1" in
		0) printf 'baseline' ;;
		1) printf 'main' ;;
		2 | high) printf 'high' ;;
		*) printf 'high' ;;
	esac
}

agent_profile_to_int() {
	value=$(printf '%s' "$1" | tr 'A-Z' 'a-z' | tr -d '"')
	case "$value" in
		0 | base | baseline) printf '0' ;;
		1 | main) printf '1' ;;
		2 | high) printf '2' ;;
		*)
			echo "profile must be 0/1/2 or baseline/main/high" >&2
			return 1
			;;
	esac
}

agent_wb_mode_from_int() {
	case "$1" in
		0) printf 'auto' ;;
		1) printf 'manual' ;;
		2) printf 'daylight' ;;
		3) printf 'cloudy' ;;
		4) printf 'incandescent' ;;
		5) printf 'fluorescent' ;;
		6) printf 'twilight' ;;
		7) printf 'shade' ;;
		8) printf 'warm_fluorescent' ;;
		9) printf 'custom' ;;
		*) printf 'auto' ;;
	esac
}

agent_wb_mode_to_int() {
	mode=$(printf '%s' "$1" | tr 'A-Z' 'a-z' | tr '-' '_')
	case "$mode" in
		auto | 0) printf '0' ;;
		manual | 1) printf '1' ;;
		daylight | day_light | day | 2) printf '2' ;;
		cloudy | 3) printf '3' ;;
		incandescent | 4) printf '4' ;;
		fluorescent | flourescent | 5) printf '5' ;;
		twilight | 6) printf '6' ;;
		shade | 7) printf '7' ;;
		warm_fluorescent | warm_flourescent | 8) printf '8' ;;
		custom | 9) printf '9' ;;
		*) printf '0' ;;
	esac
}

agent_bool01_to_json() {
	case "$(printf '%s' "$1" | tr 'A-Z' 'a-z')" in
		1 | true | yes | on) printf 'true' ;;
		0 | false | no | off) printf 'false' ;;
		*)
			printf '%s' "${2:-false}"
			;;
	esac
}

agent_json_bool_to_01() {
	case "$1" in
		true) printf '1' ;;
		false) printf '0' ;;
		*)
			echo "boolean value required" >&2
			return 1
			;;
	esac
}

# ---- firmware / misc ----

agent_firmware_upgrade_supported() {
	command -v sysupgrade >/dev/null 2>&1 && printf 'true' || printf 'false'
}

agent_firmware_pending_full() {
	[ -f /tmp/upgrade.me ] && printf 'true' || printf 'false'
}

agent_firmware_pending_partial() {
	[ -f /tmp/update.me ] && printf 'true' || printf 'false'
}

agent_firmware_boot_marked_complete() {
	if command -v fw_printenv >/dev/null 2>&1; then
		value=$(fw_printenv -n sysupgrade_complete 2>/dev/null | tr -d '\n')
		case "$value" in
			1 | true | yes | on) printf 'true' ;;
			*)
				case "$value" in
					0 | false | no | off | '') printf 'false' ;;
					*) printf 'null' ;;
				esac
				;;
		esac
	else
		printf 'null'
	fi
}

