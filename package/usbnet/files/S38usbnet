#!/bin/sh

# Candidate USB network/serial adapter modules -- only the ones actually
# built in for this board's enabled usbnet variant(s) will exist under
# /lib/modules, so it's safe to just try them all rather than hardcoding
# one module name per board.
modulenames="rndis_host cdc_ether cdc_ncm asix ax88179_178a r8152 option"

start() {
	echo -c 15 "Starting USB NET"

	if [ -n "$gpio_usbnet" ]; then
		num=${gpio_usbnet%[oO]}
		state=${gpio_usbnet#$num}

		case "$state" in
			O) gpio_cmd="high" ;;
			o) gpio_cmd="low" ;;
		esac

		echo "Set GPIO $num $gpio_cmd"
		gpio $gpio_cmd $num
	fi

	echo "Load usbserial module"
	modprobe usbserial

	for modulename in $modulenames; do
		if modinfo "$modulename" >/dev/null 2>&1 && ! grep -q ^$modulename /proc/modules; then
			echo "Load $modulename module"
			modprobe $modulename
		fi
	done
}

case "$1" in
	start)
		start
		;;
	stop)
		true
		;;
	*)
		echo "Usage: $0 {start|stop}"
		exit 1
		;;
esac

exit 0
