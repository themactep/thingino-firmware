From: Paul Philippov <paul@themactep.com>
Subject: [PATCH] rtl8189es: port the cfg80211 ops and helpers to 7.3

Use wireless_dev for the key/station ops, add the 7.3 cookie
and radio_idx parameters, fix the ROC/mgmt-tx signatures and
provide the removed strncpy.

Signed-off-by: Paul Philippov <paul@themactep.com>
---
diff --git a/include/osdep_service_linux.h b/include/osdep_service_linux.h
index 6dcc60c..b55a297 100644
--- a/include/osdep_service_linux.h
+++ b/include/osdep_service_linux.h
@@ -19,6 +19,19 @@
 #include <linux/spinlock.h>
 #include <linux/compiler.h>
 #include <linux/kernel.h>
+#include <linux/string.h>
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(7, 0, 0))
+static inline char *rtw_strncpy(char *dest, const char *src, size_t count)
+{
+	size_t i;
+	for (i = 0; i < count && src[i]; i++)
+		dest[i] = src[i];
+	for (; i < count; i++)
+		dest[i] = 0;
+	return dest;
+}
+#define strncpy rtw_strncpy
+#endif
 #include <linux/errno.h>
 #include <linux/init.h>
 #include <linux/slab.h>
