From: Paul Philippov <paul@themactep.com>
Subject: [PATCH] ssv6158: adapt the mac80211 glue to Linux 7.3

Port the mac80211 callbacks, timers, platform remove, beacon,
efuse, asm, proc and const call sites, and drop exports of
local symbols.

Signed-off-by: Paul Philippov <paul@themactep.com>
---
diff --git a/Makefile b/Makefile
index 8c0a5db..037f2d6 100644
--- a/Makefile
+++ b/Makefile
@@ -13,10 +13,10 @@ include $(KBUILD_TOP)/platform-config.mak
 # Generate $(KMODULE_NAME)-wifi.cfg
 BKP_CFG := $(shell cp $(KBUILD_TOP)/$(KMODULE_NAME)-wifi.cfg $(KBUILD_TOP)/image/$(KMODULE_NAME)-wifi.cfg)
 
-EXTRA_CFLAGS := -I$(KBUILD_TOP) -I$(KBUILD_TOP)/include
+EXTRA_CFLAGS := -I$(KBUILD_TOP) -I$(KBUILD_TOP)/include -Wno-error=missing-prototypes -Wno-error=old-style-declaration
 ccflags-y += $(EXTRA_CFLAGS)
 subdir-ccflags-y += $(EXTRA_CFLAGS)
-ccflags-y += -Wno-error=missing-prototypes -Wno-error=unused-variable -Wno-error=empty-body
+ccflags-y += -Wno-error=missing-prototypes -Wno-error=unused-variable -Wno-error=empty-body -Wno-error=header-guard -Wno-error=old-style-declaration
 
 DEF_PARSER_H = $(KBUILD_TOP)/include/ssv_conf_parser.h
 $(shell env ccflags="$(ccflags-y)" $(KBUILD_TOP)/parser-conf.sh $(DEF_PARSER_H))
