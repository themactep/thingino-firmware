config BR2_PACKAGE_THINGINO_SYSTEM
	bool "thingino-system"
	help
	  Various utilities related to thingino system operations

config BR2_PACKAGE_THINGINO_SYSTEM_INGENIC
	default y
	bool "Ingenic platform utilities"
	depends on BR2_PACKAGE_THINGINO_SYSTEM && BR2_SOC_VENDOR_INGENIC
	help
	  soc, sensor, usb-role and S03mac, from files/ingenic/.

	  All four are tied to the silicon: soc and usb-role read Ingenic
	  registers through devmem, S03mac reads the serial-number registers
	  to derive a MAC, and sensor reads the /proc/jz tree the Ingenic
	  kernel modules create. On other silicon they report nothing useful,
	  and usb-role, which writes, would be actively wrong.

	  Another vendor supplies its own block rather than teaching these
	  to branch.

config BR2_PACKAGE_THINGINO_SYSTEM_USB_ROLE
	default y
	depends on BR2_PACKAGE_THINGINO_SYSTEM && BR2_PACKAGE_THINGINO_KOPT_DWC2_OTG
	bool "usb-role switcher"
	help
	  Enables on the fly USB role switching when using the ingenic DWC2 USB controller.

config BR2_PACKAGE_THINGINO_SYSTEM_ENTROPY_GENERATOR
	default y
	bool "entropy generator"
	depends on BR2_PACKAGE_THINGINO_SYSTEM && SOC_FAMILY = "t40"
	help
	  Enables the entropy service for the T40 SoC.

config BR2_PACKAGE_THINGINO_SYSTEM_AUTOMOUNT
	bool "block device automount"
	depends on BR2_PACKAGE_THINGINO_SYSTEM
	default y if BR2_THINGINO_SDCARD
	help
	  Install the mdev handler and boot-time scan that mount partitions below
	  /mnt. SD-card boards select this by default; SATA and USB-storage
	  appliances can enable it without pulling in the MMC kernel stack.

config BR2_PACKAGE_THINGINO_SYSTEM_SWAP
	bool "swap"
	depends on BR2_PACKAGE_THINGINO_SYSTEM
	help
	  Enables swap support.

config BR2_PACKAGE_THINGINO_SYSTEM_SENSOR_UTILS
	default y
	bool "sensor utilities"
	depends on BR2_PACKAGE_THINGINO_SYSTEM && BR2_THINGINO_DEV_CAMERA
	select BR2_PACKAGE_THINGINO_SENSOR_INFO if BR2_SOC_VENDOR_INGENIC
	help
	  Enables sensor utilities: /usr/sbin/sensor, which every vendor
	  supplies.

	  On Ingenic it also pulls in the sensor-info package, whose sinfo
	  probes the sensor I2C bus. That detector is Ingenic-only, so it
	  is not selected for other vendors, which supply their own
	  detection.
