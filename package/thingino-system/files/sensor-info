#!/bin/sh

echo "Thingino Diagnostics - sensor info"
echo "This script requires network access to download modules if needed..."

# Check if sinfo module is already loaded
if lsmod | grep -q "sinfo"; then
	echo "sinfo module is already loaded. Skipping download."
else
	# Get SoC type
	soc="$(soc -f)"
	if [ -z "$soc" ]; then
		echo "Error: Could not determine SoC type."
		exit 1
	fi

	echo "Detected SoC: $soc"
	echo "Downloading sinfo module..."

	# Download the appropriate module, check for kernel version later. Bounded
	# timeouts + an IPv6 fallback: on a network where native IPv4 is dead but
	# blackholed rather than actively refused (e.g. behind a carrier NAT that
	# drops instead of rejecting), a plain unbounded curl can hang forever if
	# the resolver hands back a dead IPv4 address to try first. Try the
	# default (whatever the resolver/network naturally prefers) with a
	# reasonable timeout first, and only fall back to forcing IPv6 if that
	# fails -- forcing -6 unconditionally would break normal IPv4-only boards
	# instead, so it's a fallback, not the default.
	sinfo_url="https://github.com/themactep/ingenic-sdk/releases/download/sinfo/sinfo-$soc.ko"
	sinfo_out="/tmp/sinfo-$soc.ko"

	curl -fL --connect-timeout 10 --max-time 60 "$sinfo_url" -o "$sinfo_out"
	sinfo_rc=$?

	if [ "$sinfo_rc" -ne 0 ]; then
		echo "Default connection failed, retrying over IPv6..."
		curl -fL -6 --connect-timeout 10 --max-time 60 "$sinfo_url" -o "$sinfo_out"
		sinfo_rc=$?
	fi

	if [ "$sinfo_rc" -ne 0 ]; then
		# Last resort: this device's C library resolver (used by curl/ping6/
		# getaddrinfo) can fail to retrieve github.com's own DNS64-synthesized
		# AAAA even when the network has a working NAT64 gateway and busybox's
		# own independent nslookup implementation gets the right answer for the
		# exact same query -- confirmed live, a narrow uClibc/DNS64 interop bug
		# specific to certain hostnames (github.com among them), not a general
		# DNS64 problem. The actual CDN host github.com's release links
		# redirect to resolves fine on its own through the normal path, so work
		# around this by resolving just the github.com hop ourselves (via
		# nslookup, which isn't affected) and pinning it with --resolve; -L
		# still follows the subsequent redirect normally from there.
		echo "IPv6 retry failed, trying to resolve github.com manually..."
		sinfo_v6=$(nslookup github.com 2>/dev/null | awk '/^Address: 64:ff9b::/{print $2; exit}')
		if [ -n "$sinfo_v6" ]; then
			curl -fL -6 --connect-timeout 10 --max-time 60 --resolve "github.com:443:$sinfo_v6" "$sinfo_url" -o "$sinfo_out"
			sinfo_rc=$?
		fi
	fi

	if [ "$sinfo_rc" -ne 0 ]; then
		echo "Error: Failed to download sinfo module."
		exit 1
	fi

	# Load the module
	echo "Loading sinfo module..."
	insmod "/tmp/sinfo-$soc.ko"
	if [ $? -ne 0 ]; then
		echo "Error: Failed to load sinfo module."
		rm -f "/tmp/sinfo-$soc.ko"
		exit 1
	fi

	# Clean up downloaded file
	rm -f "/tmp/sinfo-$soc.ko"
fi

# Trigger info output
echo "Detecting sensors, please wait..."
echo 1 >/proc/jz/sinfo/info

# Check for module dir
if [ -f "/proc/jz/sinfo/info" ]; then
	sensor_proc=$(cat /proc/jz/sinfo/info)
	if echo "$sensor_proc" | grep -q "Detected sensors"; then
		echo ""
		echo "$sensor_proc"
		exit 0
	else
		echo "No sensor information found."
	fi
fi
