#!/bin/sh
# shellcheck disable=SC2162

reset_env=true
ENV_SETTINGS="wlan_ssid wlan_pass hostname"

while getopts "efh" opt; do
	case $opt in
		e)
			reset_env=false
			;;
		f)
			force_wipe=true
			;;
		h)
			printf 'Usage: %s [options]\n  -e    Wipe the overlay only, keep the U-Boot ENV settings\n  -f    Do not ask for confirmation\n  -h    Show help information\n' "$0"
			exit 0
			;;
		\?)
			echo "Invalid option. Use -h for help."
			exit 1
			;;
	esac
done

# Erasing the env bricks: the next fw_setenv saves its built-in bootcmd=bootp.
clear_env_settings() {
	command -v fw_setenv >/dev/null || return 0
	if fw_printenv 2>&1 >/dev/null | grep -q "Bad CRC"; then
		echo "U-Boot ENV is not valid, leaving it as is." >&2
		return 0
	fi
	script=""
	for name in $ENV_SETTINGS; do
		fw_printenv -n "$name" >/dev/null 2>&1 && script="$script$name
"
	done
	[ -n "$script" ] || return 0
	echo "Clearing settings from U-Boot ENV..."
	printf '%s' "$script" | fw_setenv -s -
}

wipe() {
	data_dev=$(awk '$4 ~ /"data"/ {gsub(":","",$1); print $1}' /proc/mtd)
	if [ -z "$data_dev" ]; then
		echo "Overlay partition not found!" >&2
		exit 1
	fi
	[ "$reset_env" = true ] && clear_env_settings

	echo "Erasing overlay partition..."
	flash_eraseall -j "/dev/${data_dev}"
	echo "Erase completed. Rebooting..."
	reboot -f
}

warn() {
	printf 'Warning\nThis action will reset the device to defaults and erase all configurations, leaving the device like the first boot.\nAll saved settings will be erased!\nAre you sure you want to proceed? (yes/no)\n'
	read response
	if [ "$response" != "yes" ]; then
		echo "Operation aborted." >&2
		exit 1
	else
		wipe
	fi
}

if [ "$force_wipe" = true ]; then
	wipe
else
	warn
fi

exit 0
