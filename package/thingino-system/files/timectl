#!/bin/sh
# timectl - single gate for clock, timezone, and NTP configuration.
#
# Every writer (WebUI, DHCP, ONVIF, HA) funnels through here. Observers read
# the resolved state with "timectl status". Timezone names resolve through the
# read-only /usr/share/tz.json table, with the partial /etc/tz.user.json map
# layered over it.

TZJSON_FILE="/usr/share/tz.json"
TZUSER_FILE="/etc/tz.user.json"
TZNAME_FILE="/etc/timezone"
TZCODE_FILE="/etc/TZ"
TZ_SOURCE_FILE="/etc/timezone.source"
TZ_MAX=67
NTP_DEFAULT_FILE="/etc/default/ntp.conf"
NTP_WORKING_FILE="/tmp/ntp.conf"
NTP_SOURCE_FILE="/etc/ntp.source"

usage() {
	echo "Usage: $0 <command> [args]" >&2
	echo "Commands:" >&2
	echo "  status                      print resolved state as key=value" >&2
	echo "  refresh                     boot: re-resolve /etc/timezone to /etc/TZ" >&2
	echo "  set-timezone <name> [--source user|dhcp]" >&2
	echo "  set-timezone-custom <name> <posix-tz>" >&2
	echo "  remove-timezone-custom <name>" >&2
	echo "  set-ntp <srv>... [--source user|dhcp]" >&2
	echo "  set-time <date>             manual clock hint, then NTP reconcile" >&2
	echo "  pin-timezone                keep the current timezone, ignore DHCP" >&2
	echo "  unpin-timezone              allow DHCP to change the timezone again" >&2
	echo "  sync                        one-shot NTP sync" >&2
	exit 1
}

precedence() {
	case "$1" in
		user) echo 3 ;;
		dhcp) echo 2 ;;
		default) echo 1 ;;
		*) echo 0 ;;
	esac
}

# resolve_base <tzdb-name> -> POSIX TZ string from the read-only table
# Separate sed invocations so each stage re-reads the stream line-by-line;
# combining them with ';' would apply the later substitutions to the whole
# (still single-line) pattern space and only convert the first entry.
resolve_base() {
	sed 's/},{/\n/g' "$TZJSON_FILE" |
		sed 's/^\[{//;s/}\]$//' |
		sed 's/"n":"\([^"]*\)","v":"\([^"]*\)"/\1:\2/' |
		grep -F "$1:" | head -1 | cut -d: -f2-
}

# resolve <tzdb-name> -> POSIX TZ string. /etc/tz.user.json is a partial
# object map layered over the read-only table; a user entry wins.
resolve() {
	if [ -f "$TZUSER_FILE" ]; then
		user_tz=$(jct "$TZUSER_FILE" get "$1" 2>/dev/null)
		if [ -n "$user_tz" ]; then
			printf '%s\n' "$user_tz"
			return 0
		fi
	fi
	resolve_base "$1"
}

current_source() {
	if [ -f "$1" ]; then
		cat "$1"
	else
		echo default
	fi
}

allowed() {
	# allowed <source> <state-file>: 0 if source may write, 1 otherwise
	[ "$(precedence "$1")" -ge "$(precedence "$(current_source "$2")")" ]
}

# Custom names are JSON map keys looked up by jct, so keep them free of dots
# (jct's path separator) and of characters that would need JSON escaping.
# Spaces are allowed because the shipped table spells some IANA names with
# spaces; leading/trailing spaces are not useful.
valid_tz_name() {
	printf '%s' "$1" | grep -Eq '^[A-Za-z0-9_+][A-Za-z0-9_+ /-]*$' || return 1
	[ "${1% }" = "$1" ] || return 1
	return 0
}

# Check a POSIX TZ string against uClibc-ng's parser. Kept in sync with
# scripts/check-tz-json.sh: the read-only table is checked at build time,
# this is for values a user adds to /etc/tz.user.json.
valid_tz_string() {
	[ -n "$1" ] || return 1
	[ "${#1}" -le "$TZ_MAX" ] || return 1
	# BusyBox awk (CONFIG_AWK=y) parses one string per process; all state
	# lives inside the awk invocation, nothing leaks into this scope.
	printf '%s' "$1" | awk '
		function fail() { bad = 1; return 0 }
		function isdigit(c) { return c ~ /^[0-9]$/ }
		function isalpha(c) { return c ~ /^[A-Za-z]$/ }
		# hh[:mm[:ss]], hours below 25, minutes and seconds below 60, no
		# sign: the same four passes as uClibc-ng getoffset()
		function offset(    i, lim, f, d) {
			split("25 60 60 1", lim, " ")
			f = -1
			for (i = 1; i <= 4; i++) {
				d = 0
				while (d < 2 && isdigit(substr(s, p, 1))) {
					f = (d ? f * 10 : 0) + substr(s, p, 1)
					p++; d++
				}
				if (f < 0 || f >= lim[i]) return 0
				f = 0
				if (substr(s, p, 1) == ":") { p++; f = -1 }
			}
			return 1
		}
		function number(lo, hi,    d, f) {
			f = 0
			for (d = 0; d < 3 && isdigit(substr(s, p, 1)); d++) {
				f = f * 10 + substr(s, p, 1)
				p++
			}
			return d > 0 && f >= lo && f <= hi
		}
		function tzname(    q, n, c) {
			q = substr(s, p, 1) == "<"
			if (q) p++
			for (n = 0; ; n++) {
				c = substr(s, p, 1)
				if (!(isalpha(c) || (q && (isdigit(c) || c == "+" || c == "-")))) break
				p++
			}
			if (n < 3 || n > 6) return 0
			if (q && substr(s, p++, 1) != ">") return 0
			return 1
		}
		# ,Mm.w.d / ,Jn / ,n with optional /time, uClibc accepts 0-24 only
		function rule(    c) {
			if (substr(s, p++, 1) != ",") return fail()
			c = substr(s, p, 1)
			if (c == "M") {
				p++
				if (!number(1, 12) || substr(s, p++, 1) != "." ||
				    !number(1, 5) || substr(s, p++, 1) != "." || !number(0, 6))
					return fail()
			} else if (c == "J") {
				p++
				if (!number(1, 365)) return fail()
			} else if (!number(0, 365)) {
				return fail()
			}
			if (substr(s, p, 1) == "/") {
				p++
				if (substr(s, p, 1) == "-" || substr(s, p, 1) == "+")
					return fail()
				if (!offset()) return fail()
			}
			return 1
		}
		function check(    c) {
			p = 1
			if (length(s) > 67) return fail()
			if (substr(s, p, 1) == ":") p++
			if (!tzname()) return fail()
			c = substr(s, p, 1)
			if (c == "+" || c == "-") p++
			if (!offset()) return fail()
			if (p > length(s)) return
			if (!tzname()) return fail()
			c = substr(s, p, 1)
			if (c == "+" || c == "-") { p++; if (!offset()) return fail() }
			else if (isdigit(c) && !offset()) return fail()
			if (p > length(s)) return
			if (!rule() || !rule()) return
			if (p <= length(s)) return fail()
		}
		NR == 1 { s = $0; check() }
		NR > 1 { bad = 1 }
	END { exit (bad ? 1 : 0) }
	'
}

cmd_status() {
	name=$(cat "$TZNAME_FILE" 2>/dev/null)
	[ -n "$name" ] || name="Etc/GMT"
	posix=$(cat "$TZCODE_FILE" 2>/dev/null)
	[ -n "$posix" ] || posix="GMT0"
	ntp_servers=$(sed -n 's/^server \([^ ]*\).*/\1/p' "$NTP_WORKING_FILE" 2>/dev/null | tr '\n' ' ')

	printf 'timezone_name=%s\n' "$name"
	printf 'timezone_posix=%s\n' "$posix"
	printf 'timezone_source=%s\n' "$(current_source "$TZ_SOURCE_FILE")"
	printf 'ntp_servers=%s\n' "$ntp_servers"
	printf 'ntp_source=%s\n' "$(current_source "$NTP_SOURCE_FILE")"
	printf 'clock_utc=%s\n' "$(date -u +%s)"
	printf 'clock_local=%s\n' "$(date '+%Y-%m-%d %H:%M:%S %Z')"
}

cmd_refresh() {
	# One-time migration: the retired dhcp.ignore_timezone flag maps to a
	# pinned (user-sourced) timezone, and the dead key is then removed.
	if [ ! -f "$TZ_SOURCE_FILE" ]; then
		if [ "true" = "$(jct /etc/thingino.json get dhcp.ignore_timezone 2>/dev/null)" ]; then
			echo "user" >"$TZ_SOURCE_FILE"
		fi
		jct /etc/thingino.json del dhcp.ignore_timezone 2>/dev/null
	fi

	name=$(cat "$TZNAME_FILE" 2>/dev/null)
	if [ -z "$name" ]; then
		name="Etc/GMT"
		echo "$name" >"$TZNAME_FILE"
	fi

	tz=$(resolve "$name")
	if [ -z "$tz" ]; then
		echo "timectl: timezone '$name' not found in $TZJSON_FILE or $TZUSER_FILE" >&2
		return 1
	fi

	if [ "$tz" != "$(cat "$TZCODE_FILE" 2>/dev/null)" ]; then
		echo "$tz" >"$TZCODE_FILE"
	fi
}

cmd_set_timezone() {
	name=""
	source="user"
	while [ $# -gt 0 ]; do
		case "$1" in
			--source)
				source="$2"
				shift 2
				;;
			--source=*)
				source="${1#--source=}"
				shift
				;;
			*)
				name="$1"
				shift
				;;
		esac
	done

	if [ -z "$name" ]; then
		echo "timectl: set-timezone requires a timezone name" >&2
		return 1
	fi

	if ! allowed "$source" "$TZ_SOURCE_FILE"; then
		echo "timectl: timezone managed by '$(current_source "$TZ_SOURCE_FILE")', ignoring '$source'" >&2
		return 0
	fi

	tz=$(resolve "$name")
	if [ -z "$tz" ]; then
		echo "timectl: timezone '$name' not found in $TZJSON_FILE or $TZUSER_FILE" >&2
		return 1
	fi

	if [ "$name" = "$(cat "$TZNAME_FILE" 2>/dev/null)" ] &&
		[ "$source" = "$(current_source "$TZ_SOURCE_FILE")" ] &&
		[ "$tz" = "$(cat "$TZCODE_FILE" 2>/dev/null)" ]; then
		echo "timectl: timezone already set to '$name' [$source]" >&2
		return 0
	fi

	echo "$name" >"$TZNAME_FILE"
	echo "$tz" >"$TZCODE_FILE"
	echo "$source" >"$TZ_SOURCE_FILE"
	echo "timectl: timezone set to $name ($tz) [$source]" >&2
}

cmd_set_timezone_custom() {
	custom_name="$1"
	custom_posix="$2"

	if [ -z "$custom_name" ] || [ -z "$custom_posix" ]; then
		echo "timectl: set-timezone-custom requires <name> and <posix-tz>" >&2
		return 1
	fi
	if ! valid_tz_name "$custom_name"; then
		echo "timectl: invalid custom timezone name '$custom_name'" >&2
		return 1
	fi
	if ! valid_tz_string "$custom_posix"; then
		echo "timectl: invalid POSIX TZ string '$custom_posix'" >&2
		return 1
	fi

	if [ ! -f "$TZUSER_FILE" ]; then
		echo '{}' >"$TZUSER_FILE" || return 1
	fi

	custom_tmp=$(mktemp) || return 1
	printf '{"%s":"%s"}\n' "$custom_name" "$custom_posix" >"$custom_tmp" || {
		rm -f "$custom_tmp"
		return 1
	}
	if ! jct "$TZUSER_FILE" import "$custom_tmp"; then
		rm -f "$custom_tmp"
		echo "timectl: failed to update $TZUSER_FILE" >&2
		return 1
	fi
	rm -f "$custom_tmp"

	echo "timectl: custom timezone '$custom_name' saved" >&2
	cmd_set_timezone --source user "$custom_name"
}

cmd_remove_timezone_custom() {
	custom_name="$1"

	if [ -z "$custom_name" ]; then
		echo "timectl: remove-timezone-custom requires <name>" >&2
		return 1
	fi
	if ! valid_tz_name "$custom_name"; then
		echo "timectl: invalid custom timezone name '$custom_name'" >&2
		return 1
	fi
	if [ ! -f "$TZUSER_FILE" ] ||
		! jct "$TZUSER_FILE" get "$custom_name" >/dev/null 2>&1; then
		echo "timectl: no custom timezone '$custom_name'" >&2
		return 1
	fi

	if [ "$custom_name" = "$(cat "$TZNAME_FILE" 2>/dev/null)" ]; then
		base_tz=$(resolve_base "$custom_name")
		if [ -z "$base_tz" ]; then
			echo "timectl: timezone '$custom_name' is in use; set another timezone first" >&2
			return 1
		fi
	fi

	if ! jct "$TZUSER_FILE" del "$custom_name"; then
		echo "timectl: failed to update $TZUSER_FILE" >&2
		return 1
	fi

	if [ "$custom_name" = "$(cat "$TZNAME_FILE" 2>/dev/null)" ]; then
		cmd_refresh || return 1
	fi
	echo "timectl: custom timezone '$custom_name' removed" >&2
}

cmd_set_ntp() {
	source="user"
	servers=""
	while [ $# -gt 0 ]; do
		case "$1" in
			--source)
				source="$2"
				shift 2
				;;
			--source=*)
				source="${1#--source=}"
				shift
				;;
			*)
				servers="$servers $1"
				shift
				;;
		esac
	done

	[ -z "$servers" ] && return 0

	# Backward compat: the old WebUI marks user-pinned NTP by chmod 444 on
	# the default file without recording a source. Treat that as user-sourced.
	if [ "$source" = "dhcp" ] &&
		[ -f "$NTP_DEFAULT_FILE" ] &&
		[ '444' = "$(stat -c%a "$NTP_DEFAULT_FILE" 2>/dev/null)" ]; then
		echo "timectl: ntp is user-pinned, ignoring dhcp" >&2
		return 0
	fi

	if ! allowed "$source" "$NTP_SOURCE_FILE"; then
		echo "timectl: ntp managed by '$(current_source "$NTP_SOURCE_FILE")', ignoring '$source'" >&2
		return 0
	fi

	tmp=$(mktemp)
	for s in $servers; do
		echo "server $s iburst" >>"$tmp"
	done

	if [ "$source" = "user" ]; then
		cat "$tmp" >"$NTP_DEFAULT_FILE"
		chmod 444 "$NTP_DEFAULT_FILE"
	fi
	cat "$tmp" >"$NTP_WORKING_FILE"
	rm -f "$tmp"
	echo "$source" >"$NTP_SOURCE_FILE"
	echo "timectl: ntp set to:$servers [$source]" >&2
}

cmd_set_time() {
	if [ -z "$1" ]; then
		echo "timectl: set-time requires a date" >&2
		return 1
	fi

	if ! date -s "$1" >/dev/null 2>&1; then
		echo "timectl: invalid date '$1'" >&2
		return 1
	fi

	hwclock -w >/dev/null 2>&1
	# A manual set is a hint: reconcile with NTP so a wrong client value is
	# corrected instead of persisting in the system clock.
	ntpd -q -N >/dev/null 2>&1 &
}

cmd_pin_timezone() {
	name=$(cat "$TZNAME_FILE" 2>/dev/null)
	if [ -z "$name" ]; then
		name="Etc/GMT"
		echo "$name" >"$TZNAME_FILE"
	fi
	echo "user" >"$TZ_SOURCE_FILE"
	echo "timectl: timezone pinned to $name [user]" >&2
}

cmd_unpin_timezone() {
	echo "default" >"$TZ_SOURCE_FILE"
	echo "timectl: timezone unpinned [default]" >&2
}

cmd_sync() {
	ntpd -q -N >/dev/null 2>&1 &
}

case "${1:-}" in
	status)
		shift
		cmd_status
		;;
	refresh)
		shift
		cmd_refresh
		;;
	set-timezone)
		shift
		cmd_set_timezone "$@"
		;;
	set-timezone-custom)
		shift
		cmd_set_timezone_custom "$@"
		;;
	remove-timezone-custom)
		shift
		cmd_remove_timezone_custom "$@"
		;;
	set-ntp)
		shift
		cmd_set_ntp "$@"
		;;
	set-time)
		shift
		cmd_set_time "$@"
		;;
	pin-timezone)
		shift
		cmd_pin_timezone
		;;
	unpin-timezone)
		shift
		cmd_unpin_timezone
		;;
	sync)
		shift
		cmd_sync
		;;
	*) usage ;;
esac
