#!/bin/sh
# shellcheck disable=SC3043

FIFO="/run/prudynt/video_ctrl"

usage() {
	echo "Usage: $0 [on|off] [0|1|all]" >&2
	exit 1
}

COMMAND="$1"
CHANNEL_ARG="$2"

[ -z "$COMMAND" ] && usage

case "$COMMAND" in
	on | off) ;;
	*) usage ;;
esac

if [ ! -p "$FIFO" ]; then
	echo "error: prudynt control FIFO is missing: $FIFO" >&2
	exit 1
fi

case "$CHANNEL_ARG" in
	"" | all)
		printf "PRIVACY value=%s\n" "$COMMAND" >"$FIFO"
		;;
	0 | 1)
		printf "PRIVACY ch=%s value=%s\n" "$CHANNEL_ARG" "$COMMAND" >"$FIFO"
		;;
	ch=0 | ch=1)
		printf "PRIVACY %s value=%s\n" "$CHANNEL_ARG" "$COMMAND" >"$FIFO"
		;;
	*)
		echo "error: invalid channel '$CHANNEL_ARG' (use 0, 1, or all)" >&2
		exit 1
		;;
esac

exit 0
