config BR2_PACKAGE_THINGINO_PKG
	bool "thingino-pkg"
	select BR2_PACKAGE_THINGINO_LIBCURL
	help
	  Thingino Package Manager — installs, removes, and lists
	  precompiled bundle packages (.tgz files) on the device.

	  Commands: install, remove, list, info, files

	  https://github.com/themactep/thingino-firmware
