From: Paul Philippov <paul@themactep.com>
Subject: [PATCH] txw901u: adapt the driver to Linux 7.3

Use NUM_NL80211_BANDS, linux/unaligned.h, 7.3 beacon/timer
APIs, 802.11 op wrappers and drop the removed VFS namespace
and date/time warnings.

Signed-off-by: Paul Philippov <paul@themactep.com>
---
--- a/hgic_smac/hgics.h
+++ b/hgic_smac/hgics.h
@@ -79,7 +79,7 @@
     struct ieee80211_hw *hw;
     struct hgic_bus *bus;
     struct mac_address macaddr[4];
-    struct ieee80211_supported_band sbands[IEEE80211_NUM_BANDS];
+    struct ieee80211_supported_band sbands[NUM_NL80211_BANDS];
     struct hgics_vif *ap;
     struct hgics_vif *sta;
     struct hgics_vif *p2p;
--- a/hgic_smac/ap.c
+++ b/hgic_smac/ap.c
@@ -61,7 +61,7 @@
         return;
     }
 
-    skb = ieee80211_beacon_get(hw, vif);
+    skb = ieee80211_beacon_get(hw, vif, 0);
     if (skb == NULL) {
         hgic_err("get beacon fail\r\n");
         return;
@@ -78,7 +78,11 @@
 #if !defined(__RTOS__) && LINUX_VERSION_CODE >= KERNEL_VERSION(4,15,0)
 void hgics_mac80211_beacon(struct timer_list *t)
 {
-    struct hgics_wdev *hg = from_timer(hg, t, beacon_timer);
+    #if (LINUX_VERSION_CODE >= KERNEL_VERSION(7, 3, 0))
+    struct hgics_wdev *hg = timer_container_of(hg, t, beacon_timer);
+#else
+    struct hgics_wdev *hg = from_timer(hg, t, beacon_timer);
+#endif
 #else
 void hgics_mac80211_beacon(unsigned long arg)
 {
@@ -100,7 +104,11 @@
 
     if (vif->type == NL80211_IFTYPE_AP || vif->type == NL80211_IFTYPE_AP_VLAN) {
         set_bit(HGICS_VIF_STATE_BEACON, &hgvif->state);
-        del_timer(&hg->beacon_timer);
+        #if (LINUX_VERSION_CODE >= KERNEL_VERSION(7, 3, 0))
+        timer_delete(&hg->beacon_timer);
+#else
+        del_timer(&hg->beacon_timer);
+#endif
         if (info->enable_beacon) {
             mod_timer(&hg->beacon_timer, jiffies + msecs_to_jiffies(hg->beacon_int));
         }
--- a/hgic_smac/core.c
+++ b/hgic_smac/core.c
@@ -95,8 +95,15 @@
     return err;
 }
 
-static void hgics_ops_stop(struct ieee80211_hw *hw)
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(7, 3, 0))
+static void hgics_ops_stop(struct ieee80211_hw *hw, bool suspend)
+#else
+static void hgics_ops_stop(struct ieee80211_hw *hw)
+#endif
 {
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(7, 3, 0))
+    (void)suspend;
+#endif
     struct hgics_wdev *hg = (struct hgics_wdev *)hw->priv;
 
     hgic_enter();
@@ -136,7 +143,11 @@
     struct hgics_vif  *hgvif = (struct hgics_vif *)vif->drv_priv;
     hgic_enter();
     hg->hghw->ops->stop_ap(hw, vif);
-    del_timer(&hg->beacon_timer);
+    #if (LINUX_VERSION_CODE >= KERNEL_VERSION(7, 3, 0))
+    timer_delete(&hg->beacon_timer);
+#else
+    del_timer(&hg->beacon_timer);
+#endif
     hgic_fwctrl_set_beacon_start(&hg->ctrl, hgvif->idx, 0);
     clear_bit(HGICS_VIF_STATE_BEACON, &hgvif->state);
     hgic_leave();
@@ -364,7 +375,7 @@
 
     if (changed & BSS_CHANGED_ASSOC) {
         //hgic_dbg("  assoc succces, aid:%d\n", info->aid);
-        hgic_fwctrl_set_aid(&hg->ctrl, hgvif->idx, info->aid);
+        hgic_fwctrl_set_aid(&hg->ctrl, hgvif->idx, vif->cfg.aid);
     }
 
 #if 0
@@ -566,26 +577,74 @@
 }
 #endif
 
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(7, 3, 0))
+static int hgics_start_ap_7_3(struct ieee80211_hw *hw, struct ieee80211_vif *vif,
+    struct ieee80211_bss_conf *info)
+{ (void)info; return hgics_ops_start_ap(hw, vif); }
+
+static void hgics_stop_ap_7_3(struct ieee80211_hw *hw, struct ieee80211_vif *vif,
+    struct ieee80211_bss_conf *info)
+{ (void)info; hgics_ops_stop_ap(hw, vif); }
+
+static int hgics_config_7_3(struct ieee80211_hw *hw, int radio_idx, u32 changed)
+{ (void)radio_idx; return hgics_ops_config(hw, changed); }
+
+static int hgics_rts_7_3(struct ieee80211_hw *hw, int radio_idx, u32 value)
+{ (void)radio_idx; return hgics_ops_set_rts_threshold(hw, value); }
+
+static void hgics_bss_changed_7_3(struct ieee80211_hw *hw, struct ieee80211_vif *vif,
+    struct ieee80211_bss_conf *info, u64 changed)
+{ hgics_ops_bss_info_changed(hw, vif, info, (u32)changed); }
+
+static int hgics_conf_tx_7_3(struct ieee80211_hw *hw, struct ieee80211_vif *vif,
+    unsigned int link_id, u16 ac, const struct ieee80211_tx_queue_params *params)
+{ (void)link_id; return hgics_ops_conf_tx(hw, vif, ac, params); }
+#endif
+
 static struct ieee80211_ops hgics_ops = {
     .tx = hgics_ops_tx,
     .start = hgics_ops_start,
     .stop = hgics_ops_stop,
 #if LINUX_VERSION_CODE >= KERNEL_VERSION(3,8,0)
-    .start_ap = hgics_ops_start_ap,
-    .stop_ap = hgics_ops_stop_ap,
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(7, 3, 0))
+    .start_ap = hgics_start_ap_7_3,
+#else
+    .start_ap = hgics_ops_start_ap,
+#endif
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(7, 3, 0))
+    .stop_ap = hgics_stop_ap_7_3,
+#else
+    .stop_ap = hgics_ops_stop_ap,
+#endif
 #endif
     .add_interface = hgics_ops_add_interface,
     .remove_interface = hgics_ops_remove_interface,
     .change_interface = hgics_ops_change_interface,
-    .config = hgics_ops_config,
-    .bss_info_changed = hgics_ops_bss_info_changed,
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(7, 3, 0))
+    .config = hgics_config_7_3,
+#else
+    .config = hgics_ops_config,
+#endif
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(7, 3, 0))
+    .bss_info_changed = hgics_bss_changed_7_3,
+#else
+    .bss_info_changed = hgics_ops_bss_info_changed,
+#endif
     .configure_filter = hgics_ops_configure_filter,
     .sta_add = hgics_ops_sta_add,
     .sta_remove = hgics_ops_sta_remove,
     .sta_notify = hgics_ops_sta_notify,
-    .set_rts_threshold = hgics_ops_set_rts_threshold,
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(7, 3, 0))
+    .set_rts_threshold = hgics_rts_7_3,
+#else
+    .set_rts_threshold = hgics_ops_set_rts_threshold,
+#endif
     .set_key = hgics_ops_set_key,
-    .conf_tx = hgics_ops_conf_tx,
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(7, 3, 0))
+    .conf_tx = hgics_conf_tx_7_3,
+#else
+    .conf_tx = hgics_ops_conf_tx,
+#endif
     .ampdu_action = hgics_ops_ampdu_action,
 };
 
@@ -1120,7 +1179,11 @@
 #if !defined(__RTOS__) && LINUX_VERSION_CODE >= KERNEL_VERSION(4,15,0)
 static void hgics_detect_timer(struct timer_list *t)
 {
-    struct hgics_wdev *hg = from_timer(hg, t, detect_tmr);
+    #if (LINUX_VERSION_CODE >= KERNEL_VERSION(7, 3, 0))
+    struct hgics_wdev *hg = timer_container_of(hg, t, detect_tmr);
+#else
+    struct hgics_wdev *hg = from_timer(hg, t, detect_tmr);
+#endif
     if (!test_bit(HGICS_STATE_REMOVE, &hg->state)) {
         schedule_work(&hg->detect_work);
     }
@@ -1160,9 +1223,17 @@
         cancel_work_sync(&hg->test_work);
 
         hgic_dbg(" trace ...\r\n");
-        del_timer_sync(&hg->detect_tmr);
+        #if (LINUX_VERSION_CODE >= KERNEL_VERSION(7, 3, 0))
+        timer_delete_sync(&hg->detect_tmr);
+#else
+        del_timer_sync(&hg->detect_tmr);
+#endif
         hgic_dbg(" trace ...\r\n");
-        del_timer_sync(&hg->beacon_timer);
+        #if (LINUX_VERSION_CODE >= KERNEL_VERSION(7, 3, 0))
+        timer_delete_sync(&hg->beacon_timer);
+#else
+        del_timer_sync(&hg->beacon_timer);
+#endif
 
         hgic_dbg(" trace ...\r\n");
         cancel_work_sync(&hg->delay_init);
--- a/hgic_smac/11bgn.c
+++ b/hgic_smac/11bgn.c
@@ -15,7 +15,7 @@
 #include "hgics.h"
 
 #define CHAN_2G(channel, freqency, chflags)  { \
-        .band = IEEE80211_BAND_2GHZ, \
+        .band = NL80211_BAND_2GHZ, \
         .center_freq = (freqency), \
         .hw_value = (channel), \
         .flags = chflags, \
@@ -62,7 +62,7 @@
 };
 
 static const struct ieee80211_supported_band hgics_band_2G = {
-    .band = IEEE80211_BAND_2GHZ,
+    .band = NL80211_BAND_2GHZ,
     .channels = hgics_ch2g,
     .n_channels = ARRAY_SIZE(hgics_ch2g),
     .bitrates = hgics_legacy_ratetable,
@@ -120,7 +120,7 @@
 {
     int i = 0;
     struct ieee80211_hw *hw = hg->hw;
-    struct ieee80211_supported_band *sband = &hg->sbands[IEEE80211_BAND_2GHZ];
+    struct ieee80211_supported_band *sband = &hg->sbands[NL80211_BAND_2GHZ];
 
     hgic_dbg("Enter\n");
 #if LINUX_VERSION_CODE < KERNEL_VERSION(3,14,0)
@@ -162,7 +162,7 @@
 #endif
 
     memcpy(sband, &hgics_band_2G, sizeof(struct ieee80211_supported_band));
-    hw->wiphy->bands[IEEE80211_BAND_2GHZ] = sband;
+    hw->wiphy->bands[NL80211_BAND_2GHZ] = sband;
     hw->wiphy->iface_combinations = hgics_iface_combos;
     hw->wiphy->n_iface_combinations = ARRAY_SIZE(hgics_iface_combos);
 #if LINUX_VERSION_CODE > KERNEL_VERSION(3,10,0)
--- a/hgic_smac/stabr.h
+++ b/hgic_smac/stabr.h
@@ -1,5 +1,9 @@
 
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(7, 3, 0))
+#include <linux/unaligned.h>
+#else
 #include <asm/unaligned.h>
+#endif
 #include <linux/list.h>
 #include <linux/netdevice.h>
 #include <linux/types.h>
--- a/hgic_smac/Makefile
+++ b/hgic_smac/Makefile
@@ -1,3 +1,4 @@
+ccflags-y += -Wno-error=date-time
 obj-$(CONFIG_HGICS)    += hgics.o
 
 hgics-objs += core.o
--- a/utils/fwdl.c
+++ b/utils/fwdl.c
@@ -23,9 +23,6 @@
 #define BOOT_CMD_KEY_SIZE   8
 #define FWDATA_MAX_SIZE    (512*1024)
 
-#if LINUX_VERSION_CODE >= KERNEL_VERSION(5,10,0)
-MODULE_IMPORT_NS(VFS_internal_I_am_really_a_filesystem_and_am_NOT_a_driver);
-#endif
 
 void hgic_bootdl_release(struct hgic_bootdl *hg, int mode)
 {
--- a/Makefile
+++ b/Makefile
@@ -1,3 +1,4 @@
+EXTRA_CFLAGS += -Wno-error=date-time
 CURRENT_PATH := $(shell pwd)
 
 #Hi3516
@@ -41,7 +42,7 @@
 #ccflags-y += -DCONFIG_HGIC_AH
 #export CONFIG_HGIC_AH = y
 
-ccflags-y += -DCONFIG_HGIC_2G -DCONFIG_USB_ZERO_PACKET
+ccflags-y += -DCONFIG_HGIC_2G -DCONFIG_USB_ZERO_PACKET -Wno-error=date-time
 export CONFIG_HGIC_2G = y
 
 #ccflags-y += -DCONFIG_HGIC_STABR
