From: Paul Philippov <paul@themactep.com>
Subject: [PATCH] rtl8188fu: provide the IPX header for 7.3

Linux 7.3 removed net/ipx.h. The bridge extension still uses
struct ipxhdr, so define the small wire structure locally.

Signed-off-by: Paul Philippov <paul@themactep.com>
---
--- a/core/rtw_br_ext.c
+++ b/core/rtw_br_ext.c
@@ -15,9 +15,26 @@
 #define _RTW_BR_EXT_C_
 
 #ifdef __KERNEL__
+	#include <linux/version.h>
 	#include <linux/if_arp.h>
 	#include <net/ip.h>
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(7, 3, 0))
+struct ipx_address {
+	__be32 net;
+	__u8 node[6];
+	__be16 sock;
+};
+struct ipxhdr {
+	__be16 ipx_checksum;
+	__be16 ipx_pktsize;
+	__u8 ipx_tctrl;
+	__u8 ipx_type;
+	struct ipx_address ipx_dest;
+	struct ipx_address ipx_source;
+};
+#else
 	#include <net/ipx.h>
+#endif
 	#include <linux/atalk.h>
 	#include <linux/udp.h>
 	#include <linux/if_pppox.h>
