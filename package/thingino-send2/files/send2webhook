#!/bin/env sh

. /usr/share/prudynt-helpers
. /usr/share/send2common

domain="webhook"
config_file="/etc/send2.json"

show_help() {
	echo "Usage: $0 [options]
Where:
	-u url       Webhook URL
	-m message   Message to send to webhook
	-v           Verbose output
	-f file      Send file
	-S           Send photo
	-V           Send video
" >&2
	exit 0
}

read_config() {
	[ -f "$config_file" ] || return

	message=$(get_value message)
	url=$(get_value url)
}

read_config

while getopts f:m:u:vSV flag; do
	case "$flag" in
		m) message=$OPTARG ;;
		u) url=$OPTARG ;;
		v) verbose="true" ;;
		# sending a file from the command line disables sending photo
		# and video defined in config unless explicitly set so (-S/-V)
		f) file=$OPTARG; send_photo="false"; send_photo="false" ;;
		S) send_photo="true" ;;
		V) send_video="true" ;;
		*) show_help ;;
	esac
done

# use config settings only if not set from command line
if [ -z "$send_photo$send_video" ]; then
        send_photo=$(get_value send_photo)
        send_video=$(get_value send_video)
fi

if [ -z "$url" ]; then
	echo_error "Webhook URL not found"
	exit 1
fi

set -- $CURL
if [ "true" = "$verbose" ]; then
	set -- "$@" --verbose
else
	set -- "$@" --silent
fi

if [ -n "$file" ]; then
	set -- "$@" -F "file=@$file"
fi

if [ "true" = "$send_photo" ]; then
	photo=$(copy_photo)
	[ -n "$photo" ] && [ -f "$photo" ] && set -- "$@" -F "image=@$photo"
fi

if [ "true" = "$send_video" ]; then
	video=$(copy_video)
	[ -n "$video" ] && [ -f "$video" ] && set -- "$@" -F "video=@$video"
fi

# Message as the raw POST body (-d): ntfy publishes the body as the
# message, generic webhook receivers get the standard body payload.
# Multipart (-F) is used only when files are attached (curl switches
# automatically when -F is present).
set -- "$@" -d "$message" --url "$url"

[ "true" = "$verbose" ] && echo_command "$*"

if ! "$@" >/dev/null; then
	echo_error "Failed to send webhook message"
	exit 1
fi

exit 0
