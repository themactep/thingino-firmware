#!/bin/env sh

. /usr/share/prudynt-helpers
. /usr/share/send2common

domain="webhook"
config_file="/etc/send2.json"

show_help() {
	echo "Usage: $0 [options]
Where:
	-u url       Webhook URL
	-m message   Message to send to webhook
	-v           Verbose output
	-f file      Send file
	-S           Send photo
	-V           Send video
" >&2
	exit 0
}

read_config() {
	[ -f "$config_file" ] || return

	message=$(get_value message)
	url=$(get_value url)
}

read_config

while getopts f:m:u:vSV flag; do
	case "$flag" in
		m) message=$OPTARG ;;
		u) url=$OPTARG ;;
		v) verbose="true" ;;
		# sending a file from the command line disables sending photo
		# and video defined in config unless explicitly set so (-S/-V)
		f) file=$OPTARG; send_photo="false"; send_video="false" ;;
		S) send_photo="true" ;;
		V) send_video="true" ;;
		*) show_help ;;
	esac
done

# use config settings only if not set from command line
if [ -z "$send_photo$send_video" ]; then
        send_photo=$(get_value send_photo)
        send_video=$(get_value send_video)
fi

if [ -z "$url" ]; then
	echo_error "Webhook URL not found"
	exit 1
fi

set -- $CURL
if [ "true" = "$verbose" ]; then
	set -- "$@" --verbose
else
	set -- "$@" --silent
fi

has_attachment=""

if [ -n "$file" ]; then
	set -- "$@" -F "file=@$file"
	has_attachment="true"
fi

if [ "true" = "$send_photo" ]; then
	photo=$(copy_photo)
	if [ -n "$photo" ] && [ -f "$photo" ]; then
		set -- "$@" -F "image=@$photo"
		has_attachment="true"
	fi
fi

if [ "true" = "$send_video" ]; then
	video=$(copy_video)
	if [ -n "$video" ] && [ -f "$video" ]; then
		set -- "$@" -F "video=@$video"
		has_attachment="true"
	fi
fi

# Multipart and raw body are mutually exclusive in curl. With an attachment
# the message must be a form field; with none, keep the raw-body behavior
# (ntfy-style receivers, documented in docs/thingino/send2webhook.md).
if [ -n "$has_attachment" ]; then
	set -- "$@" --form-string "message=$message"
else
	set -- "$@" -d "$message"
fi
set -- "$@" --url "$url"

[ "true" = "$verbose" ] && echo_command "$*"

if ! "$@" >/dev/null; then
	echo_error "Failed to send webhook message"
	exit 1
fi

exit 0
