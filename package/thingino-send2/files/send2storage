#!/bin/env sh

. /usr/share/prudynt-helpers
. /usr/share/send2common

domain="storage"
config_file="/etc/send2.json"

show_help() {
	echo "Usage: $0 [options]
Where:
	-m mount      Mount point (e.g., /mnt/mmc, /mnt/nfs)
	-d path       Device-specific path within mount
	-t template   Filename template (strftime format)
	-S            Send photo
	-V            Send video
	-v            Verbose output
" >&2
	exit 0
}

read_config() {
	[ -f "$config_file" ] || return

	mount=$(get_value mount)
	device_path=$(get_value device_path)
	template=$(get_value template)
}

# Destination relative path from the template. Extension comes from media
# kind, not the temp path — motion/send2common use extensionless mktemp
# names, so ${file##*.} would invent junk suffixes.
target_path() {
	local kind="$1" ext="bin"

	case "$kind" in
		photo) ext="jpg" ;;
		video) ext="mp4" ;;
	esac

	printf '%s.%s' "$(date +"$template")" "$ext"
}

process_file() {
	local file="$1" kind="$2" rel dest_file

	# empty / missing capture — don't invent junk names
	[ -n "$file" ] && [ -f "$file" ] || return 0

	rel=$(target_path "$kind")
	dest_file="$dest_dir/$rel"

	# template may contain directory components (e.g. %Y%m%d/%H)
	if ! mkdir -p "$(dirname "$dest_file")"; then
		echo_error "Failed to create directory: $(dirname "$dest_file")"
		rm -f "$file"
		return 1
	fi

	[ "true" = "$verbose" ] && echo_info "Copying $file to $dest_file"

	if ! cp "$file" "$dest_file"; then
		echo_error "Failed to copy file to storage: $dest_file"
		rm -f "$file"
		return 1
	fi

	# capture paths stage via mktemp (mode 600) and cp preserves the mode;
	# published files must stay world-readable for NAS/NFS shares
	chmod 644 "$dest_file"

	rm -f "$file"
}

read_config

# A clip that motion recorded on the mount itself is renamed into place (no
# copy, no RAM); anything else takes the normal copy_video route. Motion
# stages the clip as a hidden dotfile (.<template basename>.mp4) in the
# destination directory, so nothing half-written is ever visible on NFS/SMB
# shares; the rename is same-directory and atomic. A crash mid-recording
# would leave a stale dotfile behind — sweep those older than an hour.
sweep_stale_staging() {
	for stale_file in "$dest_dir"/.motion_*.mp4; do
		[ -f "$stale_file" ] || continue
		find "$stale_file" -maxdepth 0 -mmin +60 -exec rm -f {} \; 2>/dev/null
	done
}

process_video() {
	case "$MOTION_VIDEO_FILE" in
		"$mount"/*)
			[ -f "$MOTION_VIDEO_FILE" ] || return 0
			local dest_file
			dest_file="$dest_dir/$(target_path video)"
			mkdir -p "$(dirname "$dest_file")" || return 1
			# The recording is finished here; only the rename can fail now.
			if ! mv "$MOTION_VIDEO_FILE" "$dest_file"; then
				echo_error "Failed to move $MOTION_VIDEO_FILE to $dest_file"
				return 1
			fi
			chmod 644 "$dest_file"
			;;
		*)
			sweep_stale_staging
			process_file "$(copy_video)" video
			;;
	esac
}

# order is important!
while getopts m:d:t:vSV flag; do
	case "$flag" in
		m) mount=$OPTARG ;;
		d) device_path=$OPTARG ;;
		t) template=$OPTARG ;;
		v) verbose="true" ;;
		S) send_photo="true" ;;
		V) send_video="true" ;;
		*) show_help ;;
	esac
done

# use config settings only if not set from command line
if [ -z "$send_photo$send_video" ]; then
        send_photo=$(get_value send_photo)
        send_video=$(get_value send_video)
fi

# Validate mount point
if [ -z "$mount" ]; then
	echo_error "Mount point not configured"
	exit 1
fi

# -d alone only proves the directory exists; on an unmounted /mnt/mmc the
# copy path would silently write into the overlay.
if ! mountpoint -q "$mount" 2>/dev/null; then
	echo_error "Mount point is not a mountpoint: $mount"
	exit 1
fi

if [ ! -d "$mount" ]; then
	echo_error "Mount point does not exist: $mount"
	exit 1
fi

# Check if mount is writable
if ! touch "$mount/.write_test" 2>/dev/null; then
	echo_error "Mount point is not writable: $mount"
	exit 1
fi
rm -f "$mount/.write_test"

# Set defaults
[ -z "$template" ] && template="$(hostname -s)-%Y%m%d-%H%M%S"

# Create destination directory
dest_dir="$mount"
[ -n "$device_path" ] && dest_dir="$dest_dir/$device_path"

if [ ! -d "$dest_dir" ]; then
	mkdir -p "$dest_dir" || {
		echo_error "Failed to create directory: $dest_dir"
		exit 1
	}
fi

# Process media files
if [ "true" = "$send_video" ]; then
	process_video || exit 1
fi

if [ "true" = "$send_photo" ]; then
	process_file "$(copy_photo)" photo || exit 1
fi

[ "true" = "$verbose" ] && echo_info "Successfully saved files to $dest_dir"

exit 0
