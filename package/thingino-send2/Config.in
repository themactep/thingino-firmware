config BR2_PACKAGE_THINGINO_SEND2
	bool "thingino-send2"
	select BR2_PACKAGE_THINGINO_JCT
	help
	  Streamer-agnostic send-to-* notification toolkit (email, FTP,
	  Telegram, MQTT, ntfy, webhook, storage, Google Photos, Gotify).

	  Provides /usr/sbin/send2* plus /etc/send2.json and shared helpers.
	  Snapshot and clip capture fall back through the active streamer
	  (prudynt, raptor, or timps). Selected automatically by streamer
	  packages that need motion alerts or the WebUI Send-to pages.
