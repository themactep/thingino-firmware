#!/bin/sh

# shellcheck disable=SC1091  # lib.sh and adapter.sh are installed on the camera, not in the build tree
. /usr/libexec/agent/lib.sh
# The single backend adapter is selected at build time and installed at this
# fixed path by the chosen streamer package (or the null fallback).
. /usr/libexec/agent/adapter.sh

print_device() {
	backend=$(agent_name)
	printf '{'
	printf '"id":%s,' "$(agent_json_string "$(agent_camera_id)")"
	printf '"name":%s,' "$(agent_json_string "$(agent_hostname)")"
	printf '"hostname":%s,' "$(agent_json_string "$(agent_hostname)")"
	printf '"manufacturer":"Thingino",'
	printf '"model":%s,' "$(agent_json_string "$(agent_camera_model)")"
	printf '"software":{'
	printf '"firmware_version":%s,' "$(agent_json_string "$(agent_firmware_version)")"
	printf '"api_version":"0-local",'
	printf '"streamer":%s' "$(agent_json_string "$backend")"
	printf '},'
	printf '"backend":{"name":%s,"available":true}' "$(agent_json_string "$backend")"
	printf '}\n'
}

