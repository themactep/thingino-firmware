usage() {
	cat <<'EOF'
Usage: agentctl <command> [args...]

Read commands:
  device                        Print canonical device identity JSON
  health                        Print coarse health JSON
  capabilities [group]          Print capability JSON
  runtime <resource|all>        Print runtime resource JSON
  state                         Compatibility alias for runtime all
  config                        Print full persisted config JSON
  schema                        Print machine-readable config schema JSON
  events                        Stream agent events in SSE format
  get-setting <path>            Print a narrow setting resource JSON

Write and action commands:
  set-setting <path> <json>     Apply a narrow setting resource update
  apply-config <json-file>      Compatibility bulk config patch
  snapshot [stream]             Write JPEG bytes to stdout
  record continuous|stop [stream]
  record [seconds] [stream] [path]
  privacy <on|off> [channel]
  daynight <auto|day|night>
  service <name> <start|stop|restart>
  restart-streamer
  reboot

The agent owns the external API. The single backend adapter selected at build
time (by the streamer package) is loaded from /usr/libexec/agent/adapter.sh.
EOF
	exit 1
}

command=$1
[ -n "$command" ] || usage
shift

case "$command" in
	device)
		print_device
		;;
	health)
		agent_get_health
		;;
	capabilities)
		group=${1:-all}
		agent_get_capabilities "$group"
		;;
	runtime)
		resource=${1:-all}
		agent_get_runtime "$resource"
		;;
	state)
		agent_get_runtime all
		;;
	config)
		agent_get_config
		;;
	schema)
		print_config_schema
		;;
	events)
		agent_get_events
		;;
	get-setting)
		path=$1
		[ -n "$path" ] || {
			echo "usage: agentctl get-setting <path>" >&2
			exit 1
		}
		agent_get_setting "$path"
		;;
	set-setting)
		path=$1
		body_file=$2
		[ -n "$path" ] || {
			echo "usage: agentctl set-setting <path> <json-file>" >&2
			exit 1
		}
		[ -n "$body_file" ] || {
			echo "usage: agentctl set-setting <path> <json-file>" >&2
			exit 1
		}
		agent_set_setting "$path" "$body_file"
		;;
	apply-config)
		body_file=$1
		[ -n "$body_file" ] || {
			echo "usage: agentctl apply-config <json-file>" >&2
			exit 1
		}
		agent_apply_config "$body_file"
		;;
	snapshot)
		agent_snapshot "$@"
		;;
	record)
		agent_record "$@"
		;;
	privacy)
		agent_privacy "$@"
		;;
	daynight)
		agent_daynight "$@"
		;;
	service)
		agent_service "$@"
		;;
	restart-streamer)
		agent_service streaming restart
		;;
	send2-test)
		agent_send2_test "$@"
		;;
	reboot)
		agent_reboot
		;;
	*)
		usage
		;;
esac
