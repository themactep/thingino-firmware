#!/bin/sh
# shellcheck disable=SC2018,SC2019

OS_RELEASE_FILE="${OS_RELEASE_FILE:-/etc/os-release}"
THINGINO_CONFIG_FILE="${THINGINO_CONFIG_FILE:-/etc/thingino.json}"

agent_json_string() {
	value=$(printf '%s' "$1" | awk 'BEGIN { ORS="" } {
		gsub(/\\/, "\\\\");
		gsub(/"/, "\\\"");
		gsub(/\t/, "\\t");
		gsub(/\r/, "\\r");
		if (NR > 1) {
			printf "\\n";
		}
		printf "%s", $0;
	}')
	printf '"%s"' "$value"
}

agent_json_bool() {
	case "$1" in
		1 | true | TRUE | yes | on) printf 'true' ;;
		*) printf 'false' ;;
	esac
}

agent_os_release_value() {
	key=$1
	[ -r "$OS_RELEASE_FILE" ] || return 0
	awk -F '=' -v key="$key" '
		$1 == key {
			value = substr($0, index($0, "=") + 1)
			gsub(/^"|"$/, "", value)
			print value
			exit
		}
	' "$OS_RELEASE_FILE" 2>/dev/null | tr -d '\n'
}

agent_json_config_value() {
	file=$1
	path=$2
	if command -v jct >/dev/null 2>&1 && [ -f "$file" ]; then
		jct "$file" get "$path" 2>/dev/null | tr -d '\n\r'
	fi
}

agent_text_config_value() {
	path=$1
	agent_json_config_value "$THINGINO_CONFIG_FILE" "$path" | tr -d '"'
}

agent_clean_mac() {
	printf '%s' "$1" | tr -d ':\n\r' | tr 'A-F' 'a-f'
}

agent_camera_id() {
	value=$(agent_text_config_value eth.mac)
	[ -n "$value" ] || value=$(agent_text_config_value wlan.mac)
	[ -n "$value" ] || value=$(fw_printenv -n ethaddr 2>/dev/null)
	[ -n "$value" ] || value=$(fw_printenv -n wlan_mac 2>/dev/null)
	[ -n "$value" ] || value=$(agent_os_release_value IMAGE_ID)
	agent_clean_mac "$value"
}

agent_camera_model() {
	value=$(agent_text_config_value ha.device_model)
	[ -n "$value" ] || value=$(agent_os_release_value IMAGE_ID)
	[ -n "$value" ] || value=$(agent_os_release_value HOSTNAME)
	[ -n "$value" ] || value=$(soc -m 2>/dev/null | tr -d '\n')
	printf '%s' "$value"
}

agent_firmware_version() {
	value=$(agent_os_release_value BUILD_ID)
	[ -n "$value" ] || value=$(agent_os_release_value COMMIT_ID)
	[ -n "$value" ] || value=$(agent_os_release_value VERSION_ID)
	printf '%s' "$value"
}

agent_hostname() {
	value=$(hostname 2>/dev/null | tr -d '\n')
	case "$value" in
		"" | "(none)") value="" ;;
	esac
	[ -n "$value" ] || value=$(cat /etc/hostname 2>/dev/null | tr -d '\n')
	[ -n "$value" ] || value=$(agent_os_release_value HOSTNAME)
	printf '%s' "$value"
}

agent_default_ip() {
	ip_addr=$(hostname -i 2>/dev/null | awk '{for (i = 1; i <= NF; i++) if ($i !~ /^127\./) { print $i; exit }}')
	if [ -n "$ip_addr" ]; then
		printf '%s' "$ip_addr"
		return 0
	fi

	ip_addr=$(ip -4 route get 1 2>/dev/null | awk '{for (i = 1; i <= NF; i++) if ($i == "src") { print $(i + 1); exit }}')
	if [ -n "$ip_addr" ]; then
		printf '%s' "$ip_addr"
		return 0
	fi

	ip_addr=$(ip -4 addr show scope global 2>/dev/null | awk '/inet / {sub(/\/.*/, "", $2); print $2; exit}')
	if [ -n "$ip_addr" ]; then
		printf '%s' "$ip_addr"
		return 0
	fi

	ifconfig 2>/dev/null | awk '
		/inet addr:/ { sub(/.*inet addr:/, "", $0); sub(/ .*/, "", $0); if ($0 !~ /^127\./) { print; exit } }
		/inet / && $2 !~ /^127\./ { print $2; exit }
	'
}

agent_uptime_seconds() {
	cut -d '.' -f 1 /proc/uptime 2>/dev/null || printf '0'
}

agent_loadavg_field() {
	field_index=$1
	awk -v field_index="$field_index" 'NR == 1 && NF >= field_index { print $field_index; exit }' /proc/loadavg 2>/dev/null | tr -d '\n'
}

agent_meminfo_kib() {
	field_name=$1
	awk -v field_name="$field_name" '$1 == field_name":" { print $2; exit }' /proc/meminfo 2>/dev/null | tr -d '\n'
}

agent_mem_available_kib() {
	available_kib=$(agent_meminfo_kib MemAvailable)
	if [ -n "$available_kib" ]; then
		printf '%s' "$available_kib"
		return 0
	fi
	free_kib=$(agent_meminfo_kib MemFree)
	buffers_kib=$(agent_meminfo_kib Buffers)
	cached_kib=$(agent_meminfo_kib Cached)
	free_kib=${free_kib:-0}
	buffers_kib=${buffers_kib:-0}
	cached_kib=${cached_kib:-0}
	printf '%s' $((free_kib + buffers_kib + cached_kib))
}

agent_mem_used_kib() {
	total_kib=$(agent_meminfo_kib MemTotal)
	available_kib=$(agent_mem_available_kib)
	total_kib=${total_kib:-0}
	available_kib=${available_kib:-0}
	used_kib=$((total_kib - available_kib))
	if [ "$used_kib" -lt 0 ]; then
		used_kib=0
	fi
	printf '%s' "$used_kib"
}

agent_json_value_or() {
	value=$1
	default_value=$2
	if [ -n "$value" ]; then
		printf '%s' "$value"
	else
		printf '%s' "$default_value"
	fi
}

agent_json_string_or_null() {
	value=$1
	if [ -n "$value" ]; then
		agent_json_string "$value"
	else
		printf 'null'
	fi
}

agent_timestamp_utc() {
	date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || printf '1970-01-01T00:00:00Z'
}

agent_sse_payload() {
	event_type=$1
	payload_fields=$2
	printf '{'
	printf '"type":%s,' "$(agent_json_string "$event_type")"
	printf '"timestamp":%s' "$(agent_json_string "$(agent_timestamp_utc)")"
	[ -n "$payload_fields" ] && printf ',%s' "$payload_fields"
	printf '}'
}

agent_sse_emit() {
	event_type=$1
	payload=$2
	printf 'event: %s\n' "$event_type" || exit 0
	printf 'data: %s\n\n' "$payload" || exit 0
}

agent_setting_path_label() {
	printf '%s' "$1" | tr '/' '.'
}

agent_print_setting_leaf() {
	key=$1
	value=$2
	printf '{"%s":%s}\n' "$key" "$(agent_json_value_or "$value" null)"
}

agent_print_setting_update() {
	path=$1
	key=$2
	value=$3
	printf '{"status":"accepted","applied":["settings.%s"],"staged":[],"restart_required":[],"resource":{"%s":%s}}\n' \
		"$(agent_setting_path_label "$path")" "$key" "$(agent_json_value_or "$value" null)"
}

agent_print_setting_resource_update() {
	path=$1
	resource_json=$2
	printf '{"status":"accepted","applied":["settings.%s"],"staged":[],"restart_required":[],"resource":%s}\n' \
		"$(agent_setting_path_label "$path")" "$(agent_json_value_or "$resource_json" null)"
}

# daynightd owns day/night when present (writes /etc/thingino.json + SIGHUP).
# Matches package/thingino-webui/files/www/x/json-imp.cgi preference order.
agent_has_daynightd() {
	command -v daynightd >/dev/null 2>&1
}

agent_daynightd_reload() {
	if [ -f /run/daynightd.pid ]; then
		kill -HUP "$(cat /run/daynightd.pid)" 2>/dev/null || true
	fi
}

agent_daynightd_script() {
	if [ -x /sbin/daynight ]; then
		printf '/sbin/daynight'
	elif [ -x /usr/sbin/daynight ]; then
		printf '/usr/sbin/daynight'
	fi
}

agent_daynightd_config_get() {
	agent_json_config_value "$THINGINO_CONFIG_FILE" "$1"
}

agent_daynightd_config_set() {
	path=$1
	value=$2
	command -v jct >/dev/null 2>&1 || {
		echo "jct is not available" >&2
		return 1
	}
	[ -f "$THINGINO_CONFIG_FILE" ] || {
		echo "missing $THINGINO_CONFIG_FILE" >&2
		return 1
	}
	jct "$THINGINO_CONFIG_FILE" set "$path" "$value" >/dev/null 2>&1 || {
		echo "failed to set $path" >&2
		return 1
	}
}

agent_daynightd_enabled() {
	case "$(agent_daynightd_config_get daynight.enabled | tr 'A-Z' 'a-z')" in
		1 | true | yes | on) printf 'true' ;;
		*) printf 'false' ;;
	esac
}

agent_daynightd_force_mode() {
	mode=$(agent_daynightd_config_get daynight.force_mode | tr -d '"' | tr 'A-Z' 'a-z')
	case "$mode" in
		day | night) agent_json_string "$mode" ;;
		*) printf 'null' ;;
	esac
}

agent_daynightd_running_mode() {
	if [ -r /run/thingino/daynight_mode ]; then
		mode=$(sed -n '1p' /run/thingino/daynight_mode 2>/dev/null | tr -d '\r\n ' | tr 'A-Z' 'a-z')
		case "$mode" in
			day | night)
				printf '%s' "$mode"
				return 0
				;;
		esac
	fi
	printf 'unknown'
}

agent_daynightd_target_mode() {
	if [ "$(agent_daynightd_enabled)" = true ]; then
		printf 'auto'
		return 0
	fi
	mode=$(agent_daynightd_config_get daynight.force_mode | tr -d '"' | tr 'A-Z' 'a-z')
	case "$mode" in
		day | night) printf '%s' "$mode" ;;
		*) printf 'auto' ;;
	esac
}

# Apply auto|day|night the same way json-imp.cgi does for daynightd images.
agent_daynightd_set_mode() {
	mode=$(printf '%s' "$1" | tr 'A-Z' 'a-z')
	case "$mode" in
		auto)
			agent_daynightd_config_set daynight.enabled true || return 1
			agent_daynightd_config_set daynight.force_mode "" || return 1
			agent_daynightd_reload
			;;
		day | night)
			agent_daynightd_config_set daynight.enabled false || return 1
			agent_daynightd_config_set daynight.force_mode "$mode" || return 1
			script=$(agent_daynightd_script)
			if [ -n "$script" ]; then
				"$script" "$mode" >/dev/null 2>&1 || true
			fi
			agent_daynightd_reload
			;;
		*)
			echo "daynight mode must be auto, day, or night" >&2
			return 1
			;;
	esac
}
