#!/bin/sh
# shellcheck disable=SC3043

WLAN_MODULE_NAME="@WLAN_MODULE_NAME@"

start_web_server() {
	for init in /etc/init.d/S60uhttpd /etc/init.d/S90httpd; do
		[ -x "$init" ] || continue
		"$init" restart
		return
	done
}

unload_wlan_module() {
	[ -n "$WLAN_MODULE_NAME" ] || return 0

	if grep -q "^$WLAN_MODULE_NAME\b" /proc/modules; then
		echo "Unloading WLAN module $WLAN_MODULE_NAME" >&2
		if rmmod "$WLAN_MODULE_NAME"; then
			echo "Unloaded $WLAN_MODULE_NAME" >&2
		else
			echo "Failed to unload $WLAN_MODULE_NAME" >&2
		fi
	fi
}

has_wired_uplink() {
	local iface="$1" own

	[ -z "$iface" ] && return 1
	ip link show "$iface" >/dev/null 2>&1 || return 1
	# A route via one of our own addresses (USB direct's fallback on
	# usb0) leads nowhere.
	own=$(ip -4 addr show dev "$iface" | awk '$1 == "inet" { sub(/\/.*/, "", $2); printf " %s ", $2 }')
	ip -4 route show default dev "$iface" | awk -v own="$own" '
		{ gw = ""; for (i = 1; i < NF; i++) if ($i == "via") gw = $(i + 1) }
		gw == "" || !index(own, " " gw " ") { up = 1 }
		END { exit !up }' && return 0
	ip -6 route show default dev "$iface" | grep -q . && return 0
	return 1
}

any_wired_iface_exists() {
	for iface in eth0; do
		ip link show "$iface" >/dev/null 2>&1 && return 0
	done
	return 1
}

stop_wireless() {
	[ -x /etc/init.d/S38wpa_supplicant ] && /etc/init.d/S38wpa_supplicant stop
	[ -x /etc/init.d/S36wireless ] && /etc/init.d/S36wireless stop
	unload_wlan_module
	@if WIFI_MODULE_IS_SDIO@
	@if !WIFI_SDIO_UNSUPPORTED@
	@if !WIFI_SDIO_RETURN_EARLY@
	echo "Send REMOVE to MMC1"
	mmc 1 -r
	@endif@
	@endif@
	@endif@
	start_web_server
}

start_wireless() {
	[ -x /etc/init.d/S36wireless ] && /etc/init.d/S36wireless start
	[ -x /etc/init.d/S38wpa_supplicant ] && /etc/init.d/S38wpa_supplicant start
	# With no stored credentials S38 only records the pending decision;
	# the boot path confirms it from watch_wired_uplink, so do the same
	# when the wired link disappears after boot.
	if [ -f /run/portal_pending ]; then
		/etc/init.d/S38wpa_supplicant portal_confirmed
	fi
}

watch_wired_uplink() {
	# Only poll for wired uplink if wired interfaces exist
	if any_wired_iface_exists; then
		attempt=0
		while [ "$attempt" -lt 10 ]; do
			for iface in eth0; do
				if has_wired_uplink "$iface"; then
					echo "Wired uplink on $iface found, stopping WiFi" >&2
					stop_wireless
					exit 0
				fi
			done
			attempt=$((attempt + 1))
			sleep 1
		done
	fi
	# No wired uplink: this is a wireless camera, bring the portal up
	if [ -f /run/portal_pending ]; then
		/etc/init.d/S38wpa_supplicant portal_confirmed
	fi
}

# Link-state follow-up from ifplugd. The boot probe only runs once, so
# without this a plugged/unplugged USB Ethernet adapter leaves the WLAN
# module either unloaded with no way back or running beside the cable.
recheck() {
	case "$1" in
		up)
			# Give DHCP a moment to install the default route before
			# deciding that this really is the uplink.
			attempt=0
			while [ "$attempt" -lt 10 ]; do
				for iface in eth0; do
					if has_wired_uplink "$iface"; then
						stop_wireless
						return 0
					fi
				done
				attempt=$((attempt + 1))
				sleep 1
			done
			# Link is up but no usable route; keep WLAN off so the
			# wired port remains the only uplink.
			stop_wireless
			;;
		down)
			# Another wired interface may still be the uplink.
			for iface in eth0; do
				has_wired_uplink "$iface" && return 0
			done
			start_wireless
			;;
	esac
}

case "$1" in
	start)
		# The uplink probe needs up to 10 s; on wifi-only cameras it
		# always runs the full 10 s, so it must not hold up rcS.
		watch_wired_uplink &
		;;
	recheck)
		recheck "$2"
		;;
esac

exit 0
