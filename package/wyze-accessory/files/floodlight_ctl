#!/bin/sh
# Control the light on the Wyze Cam Floodlight v1 accessory board.
#
# The light board is attached over an internal USB serial link (ch341)
# and speaks a simple framed protocol:
#
#   <0xAA 0x55> <0x43> <len> <0x46> <payload> <checksum>
#
# Protocol and original script by gponick:
# https://github.com/gtxaspec/wz_mini_hacks/discussions/771#discussioncomment-11737172
# Usage:
#   floodlight_ctl on <1-100>  Turn on at a brightness percentage.
#   floodlight_ctl off         Turn off.
#   floodlight_ctl motion      Process a night-time motion event.
VERBOSE=0

MOTION_CONFIG=/etc/floodlight-motion.conf
NIGHTMODE=/run/thingino/daynight_mode
MOTION_LOCK=/var/run/floodlight-motion.lock
STATE_FILE=/var/run/floodlight.status
BRIGHTNESS_FILE=/var/run/floodlight.brightness

get_floodlight_command_string() {
	initial_total=405
	brightness_pct=$1
	brightness_hex=$(printf "%02x" $((255 * brightness_pct / 100)))
	brightness_dec=$((255 * brightness_pct / 100))
	sequence_start="\xaa\x55\x43\x06\x46"
	brightness_sequence="\x${brightness_hex}\x00\x07"
	combined_sequence="${sequence_start}${brightness_sequence}"
	check_bytes_raw=$(printf "%.4x" $((brightness_dec + initial_total)))
	first_two_chars=$(echo "$check_bytes_raw" | awk '{print substr($0, 1, 2)}')
	last_two_chars=$(echo "$check_bytes_raw" | awk '{print substr($0, 3, 2)}')
	check_bytes="\x${first_two_chars}\x${last_two_chars}"
	printf '%s' "${combined_sequence}${check_bytes}"
}

find_device() {
	DEVICE=""
	[ -c /dev/ttyUSB0 ] && DEVICE=/dev/ttyUSB0
	[ -c /dev/ttyUSB1 ] && DEVICE=/dev/ttyUSB1
	[ -n "$DEVICE" ]
}

valid_brightness() {
	case "$1" in '' | *[!0-9]*) return 1 ;; esac
	[ "$1" -ge 1 ] && [ "$1" -le 100 ]
}

turn_on() {
	valid_brightness "$1" || { echo "Brightness must be 1-100" >&2; return 1; }
	find_device || { echo "Could not find a floodlight serial device" >&2; return 1; }
	printf '%s\n' ON >"$STATE_FILE"
	printf '%s\n' "$1" >"$BRIGHTNESS_FILE"
	printf '%b' "$(get_floodlight_command_string "$1")" >"$DEVICE"
}

turn_off() {
	find_device || { echo "Could not find a floodlight serial device" >&2; return 1; }
	printf '%s\n' OFF >"$STATE_FILE"
	printf '%b' "$(get_floodlight_command_string 0)" >"$DEVICE"
}

motion_settings() {
	motion_enabled=0
	motion_duration=30
	if [ -r "$MOTION_CONFIG" ]; then
		value=$(sed -n 's/^MOTION_ENABLED=\([01]\)$/\1/p' "$MOTION_CONFIG" | head -n 1)
		[ -n "$value" ] && motion_enabled=$value
		value=$(sed -n 's/^MOTION_DURATION=\([0-9][0-9]*\)$/\1/p' "$MOTION_CONFIG" | head -n 1)
		[ -n "$value" ] && motion_duration=$value
	fi
	case "$motion_duration" in '' | *[!0-9]*) motion_duration=30 ;; esac
	[ "$motion_duration" -ge 15 ] && [ "$motion_duration" -le 3600 ] || motion_duration=30
}

run_motion() {
	motion_settings
	[ "$motion_enabled" = 1 ] || exit 0

	mode=day
	[ -r "$NIGHTMODE" ] && IFS= read -r mode <"$NIGHTMODE"
	if [ "$mode" != night ]; then
		echo "Motion detected during daytime; floodlight not triggered"
		exit 0
	fi

	mkdir "$MOTION_LOCK" 2>/dev/null || {
		echo "Floodlight motion timer is already active"
		exit 0
	}
	trap 'rmdir "$MOTION_LOCK" 2>/dev/null' EXIT INT TERM

	brightness=100
	if [ -r "$BRIGHTNESS_FILE" ]; then
		IFS= read -r brightness <"$BRIGHTNESS_FILE"
	fi
	valid_brightness "$brightness" || brightness=100

	echo "Motion detected; turning on floodlight for ${motion_duration} seconds"
	turn_on "$brightness" || exit 1
	sleep "$motion_duration"
	rm -rf $MOTION_LOCK
	turn_off
	echo "Floodlight turned off after motion timer"
}

case "$1" in
	on | ON)
		[ $# -eq 2 ] || { echo "usage: floodlight_ctl on <1-100>" >&2; exit 1; }
		turn_on "$2"
		;;
	off | OFF)
		[ $# -eq 1 ] || { echo "usage: floodlight_ctl off" >&2; exit 1; }
		turn_off
		;;
	motion)
		[ $# -eq 1 ] || { echo "usage: floodlight_ctl motion" >&2; exit 1; }
		run_motion
		;;
	*)
		echo "usage: floodlight_ctl {on <1-100>|off|motion}" >&2
		exit 1
		;;
esac

exit 0
