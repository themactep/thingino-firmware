config BR2_PACKAGE_THINGINO_ISP
	bool

choice
	prompt "ISP stack"
	default BR2_PACKAGE_THINGINO_ISP_NONE if BR2_THINGINO_TOOLCHAIN
	default BR2_PACKAGE_THINGINO_ISP_NONE if BR2_SOC_FAMILY = "a1"
	default BR2_PACKAGE_THINGINO_ISP_NONE if !BR2_THINGINO_DEV_CAMERA
	default BR2_PACKAGE_THINGINO_ISP_OPEN if BR2_PACKAGE_OPEN_TX_ISP_SUPPORTED
	default BR2_PACKAGE_THINGINO_ISP_PROPRIETARY
	help
	  Select the ISP kernel and userspace implementation used by the
	  camera stack.

	  Defaults to the open stack on every SoC it supports, where the
	  open-tx-isp kernel driver is paired with OpenIMP userspace (or
	  the Ingenic libimp on SoCs with no OpenIMP build). SoCs the open
	  stack does not cover keep the proprietary Ingenic stack.

config BR2_PACKAGE_THINGINO_ISP_NONE
	bool "None"
	help
	  Do not select an ISP provider.

config BR2_PACKAGE_THINGINO_ISP_PROPRIETARY
	bool "Proprietary Ingenic ISP stack"
	depends on !BR2_SOC_FAMILY = "a1"
	depends on BR2_THINGINO_DEV_CAMERA
	select BR2_PACKAGE_THINGINO_ISP
	select BR2_PACKAGE_INGENIC_SDK
	select BR2_PACKAGE_INGENIC_LIB
	select BR2_PACKAGE_INGENIC_LIB_LIBIMP
	help
	  Use the Ingenic SDK TX-ISP driver and libimp userspace ABI.

config BR2_PACKAGE_THINGINO_ISP_OPEN
	bool "Open ISP stack (experimental)"
	depends on BR2_PACKAGE_OPEN_TX_ISP_SUPPORTED
	depends on BR2_THINGINO_DEV_CAMERA
	select BR2_PACKAGE_THINGINO_ISP
	select BR2_PACKAGE_INGENIC_SDK
	select BR2_PACKAGE_INGENIC_LIB
	select BR2_PACKAGE_OPEN_TX_ISP
	select BR2_PACKAGE_OPENIMP if BR2_PACKAGE_OPENIMP_SUPPORTED && !BR2_PACKAGE_THINGINO_ISP_OPEN_VENDOR_LIBIMP
	select BR2_PACKAGE_INGENIC_LIB_LIBIMP if !BR2_PACKAGE_OPENIMP_SUPPORTED || BR2_PACKAGE_THINGINO_ISP_OPEN_VENDOR_LIBIMP
	select BR2_PACKAGE_INGENIC_SYSTEM_LIBS_NEO if !BR2_PACKAGE_OPENIMP_SUPPORTED || BR2_PACKAGE_THINGINO_ISP_OPEN_VENDOR_LIBIMP || !BR2_PACKAGE_THINGINO_STREAMER_TIMPS
	select BR2_PACKAGE_INGENIC_SYSTEM_LIBS_NEO_LIBALOG if !BR2_PACKAGE_OPENIMP_SUPPORTED || BR2_PACKAGE_THINGINO_ISP_OPEN_VENDOR_LIBIMP || !BR2_PACKAGE_THINGINO_STREAMER_TIMPS
	select BR2_PACKAGE_INGENIC_SYSTEM_LIBS_NEO_LIBSYSUTILS if !BR2_PACKAGE_OPENIMP_SUPPORTED || BR2_PACKAGE_THINGINO_ISP_OPEN_VENDOR_LIBIMP || !BR2_PACKAGE_THINGINO_STREAMER_TIMPS
	select BR2_PACKAGE_LIBAUDIOPROCESS_NEO
	help
	  Use open-tx-isp on supported T10, T20, T21, T23, T30, T31,
	  T40, and T41 targets. OpenIMP supplies the userspace ABI where
	  it is supported (T10 builds it through the shared T20 userspace).
	  Turn on "Use the Ingenic libimp.so userspace with the open kernel
	  driver" to keep Ingenic's proprietary libimp.so instead, for full
	  IMP audio codec parity.

	  With OpenIMP and timps neither the stock libalog/libsysutils nor
	  a forced neo replacement is needed: timps imports no SU_*/alog
	  symbol and OpenIMP's libimp.so does not link them. (The neo
	  libraries still follow their own default.)

	  Image tuning and sensor coverage remain experimental.

endchoice

config BR2_PACKAGE_THINGINO_ISP_OPEN_VENDOR_LIBIMP
	bool "Use the Ingenic libimp.so userspace with the open kernel driver"
	depends on BR2_PACKAGE_THINGINO_ISP_OPEN
	help
	  Keep Ingenic's proprietary libimp.so as the userspace ABI on top
	  of open-tx-isp instead of OpenIMP. The open driver preserves
	  libimp.so compatibility (device-tested on T20 and T31), so the
	  stock userspace - and the streamers that need it, notably
	  prudynt's IMP_AENC/IMP_ADEC audio codecs - run unchanged on the
	  open kernel driver.

	  Off (the default) lets OpenIMP supply the userspace where it is
	  supported. prudynt then builds with -DOPENIMP, which drops the
	  IMP-native G711/G726 encode and ADEC backchannel paths but keeps
	  direct-encoded AAC/Opus.
