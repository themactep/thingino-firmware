config BR2_PACKAGE_THINGINO_ISP
	bool

choice
	prompt "ISP stack"
	default BR2_PACKAGE_THINGINO_ISP_NONE if BR2_THINGINO_TOOLCHAIN
	default BR2_PACKAGE_THINGINO_ISP_NONE if BR2_SOC_FAMILY = "a1"
	default BR2_PACKAGE_THINGINO_ISP_NONE if !BR2_THINGINO_DEV_CAMERA
	default BR2_PACKAGE_THINGINO_ISP_OPEN if BR2_PACKAGE_OPEN_TX_ISP_SUPPORTED
	help
	  Select the ISP kernel and userspace implementation used by the
	  camera stack.  The open stack is the only provider; boards whose
	  SoC or kernel has no open-tx-isp support cannot select it.

config BR2_PACKAGE_THINGINO_ISP_NONE
	bool "None"
	# Ingenic camera profiles must use the open stack; a SoC/kernel with
	# no open-tx-isp support has no valid provider and fails the build.
	depends on !BR2_THINGINO_DEV_CAMERA || BR2_SOC_FAMILY = "a1"
	help
	  Do not select an ISP provider. Available only for non-camera
	  builds and the non-Ingenic A1 family.

config BR2_PACKAGE_THINGINO_ISP_OPEN
	bool "Open ISP stack (experimental)"
	depends on BR2_PACKAGE_OPEN_TX_ISP_SUPPORTED
	depends on BR2_THINGINO_DEV_CAMERA
	select BR2_PACKAGE_THINGINO_ISP
	# On kernel 7 the SDK is disabled and the open driver carries its own
	# sensors from sensor-src/, so do not force the SDK back on.
	select BR2_PACKAGE_INGENIC_SDK if !KERNEL_MODERN
	select BR2_PACKAGE_INGENIC_LIB
	select BR2_PACKAGE_OPEN_TX_ISP
	select BR2_PACKAGE_OPENIMP
	select BR2_PACKAGE_INGENIC_SYSTEM_LIBS_NEO
	select BR2_PACKAGE_INGENIC_SYSTEM_LIBS_NEO_LIBALOG
	select BR2_PACKAGE_INGENIC_SYSTEM_LIBS_NEO_LIBSYSUTILS
	select BR2_PACKAGE_LIBAUDIOPROCESS_NEO
	help
	  Use open-tx-isp on supported T10, T20, T21, T23, T30, T31,
	  T40, and T41 targets. OpenIMP always supplies the userspace
	  ABI; there is no proprietary libimp fallback. A target or
	  kernel without OpenIMP support fails the build instead.

	  Image tuning and sensor coverage remain experimental.

endchoice
