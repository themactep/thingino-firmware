#!/bin/sh
# shellcheck disable=SC2068

DAEMON="/usr/sbin/httpd"
PIDFILE="/var/run/httpd.pid"
PORTAL_MODE_FLAG="/run/portal_mode"
PORTAL_PENDING_FLAG="/run/portal_pending"

start_daemon() {
	start-stop-daemon -S -b -m -p "$PIDFILE" -x "$DAEMON" -- $@
}

stop_daemon() {
	if [ -f "$PIDFILE" ]; then
		start-stop-daemon -K -p "$PIDFILE" -x "$DAEMON"
		rm -f "$PIDFILE"
	else
		start-stop-daemon -K -x "$DAEMON"
	fi

	i=0
	while pgrep -x "$(basename "$DAEMON")" >/dev/null 2>&1; do
		i=$((i + 1))
		[ "$i" -eq 5 ] && start-stop-daemon -K -s KILL -x "$DAEMON" 2>/dev/null
		[ "$i" -ge 8 ] && break
		sleep 1
	done
}

if [ -f "$PORTAL_MODE_FLAG" ]; then
	DAEMON_ARGS="-f -c /etc/httpd-portal.conf"
else
	DAEMON_ARGS="-f -c /etc/httpd.conf"
fi

start() {
	if [ -f "$PORTAL_PENDING_FLAG" ] && [ ! -f "$PORTAL_MODE_FLAG" ]; then
		echo "Portal decision pending, deferring HTTPD"
		return 0
	fi

	echo -c 15 "Starting HTTPD"

	# shellcheck disable=SC2086
	start_daemon $DAEMON_ARGS
}

stop() {
	echo -c 15 "Stopping HTTPD"

	stop_daemon
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart)
		stop
		sleep 1
		start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac

exit 0
