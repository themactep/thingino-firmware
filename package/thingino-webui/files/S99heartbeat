#!/bin/sh
# shellcheck disable=SC1091

# Heartbeat daemon: generate the web UI heartbeat payload once per interval
# and cache it so each SSE client (json-heartbeat.cgi) only relays the file
# instead of re-aggregating every interval per tab.

LIB="/usr/libexec/thingino-webui/heartbeat-lib.sh"
CACHE_FILE="/run/thingino/heartbeat.json"
UPDATE_INTERVAL="${HEARTBEAT_INTERVAL:-5}"
PIDFILE="/var/run/heartbeatd.pid"

start() {
	if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
		return 0
	fi
	heartbeat_loop &
	echo $! >"$PIDFILE"
}

stop() {
	if [ -f "$PIDFILE" ]; then
		kill "$(cat "$PIDFILE")" 2>/dev/null
	fi
	rm -f "$PIDFILE" "$CACHE_FILE" "$CACHE_FILE.tmp"
}

heartbeat_loop() {
	# shellcheck disable=SC1090
	. "$LIB"
	mkdir -p "$(dirname "$CACHE_FILE")"
	while true; do
		if thingino_heartbeat_payload >"$CACHE_FILE.tmp" 2>/dev/null; then
			mv "$CACHE_FILE.tmp" "$CACHE_FILE"
		fi
		sleep "$UPDATE_INTERVAL"
	done
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart)
		stop
		sleep 1
		start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac
