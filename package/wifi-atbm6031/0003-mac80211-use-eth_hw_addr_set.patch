From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Paul Philippov <paul@themactep.com>
Date: Fri, 17 Oct 2026 00:00:00 +0000
Subject: [PATCH] mac80211: set dev_addr via eth_hw_addr_set()

The vendored mac80211 memcpy()s into netdev->dev_addr directly. Newer
kernels keep a shadow copy and warn at registration:

  netdevice: wlan0: Incorrect netdev->dev_addr
  WARNING: net/core/dev_addr_lists.c:657

Use the designated setter, which updates the shadow too. It only exists
since 5.17, so keep the direct copy on older kernels.

Signed-off-by: Paul Philippov <paul@themactep.com>
---
diff --git a/hal_apollo/mac80211/iface.c b/hal_apollo/mac80211/iface.c
index 151a7fb..ce893e1 100644
--- a/hal_apollo/mac80211/iface.c
+++ b/hal_apollo/mac80211/iface.c
@@ -14,6 +14,7 @@
 #include <linux/kernel.h>
 #include <linux/if_arp.h>
 #include <linux/netdevice.h>
+#include <linux/etherdevice.h>
 #include <linux/rtnetlink.h>
 #include <net/atbm_mac80211.h>
 #include <net/ieee80211_radiotap.h>
@@ -486,9 +487,13 @@ static int ieee80211_do_open(struct net_device *dev, bool coming_up)
 	 * this interface, if it has the special null one.
 	 */
 	if (is_zero_ether_addr(dev->dev_addr)) {
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(5, 17, 0))
+		eth_hw_addr_set(dev, local->hw.wiphy->perm_addr);
+#else
 		memcpy(dev->dev_addr,
 		       local->hw.wiphy->perm_addr,
 		       ETH_ALEN);
+#endif
 		memcpy(dev->perm_addr, dev->dev_addr, ETH_ALEN);
 
 		if (!is_valid_ether_addr(dev->dev_addr)) {
@@ -2530,7 +2535,11 @@ int ieee80211_if_add(struct ieee80211_local *local, const char *name,
 		goto fail;
 
 	ieee80211_assign_perm_addr(local, ndev, type);
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(5, 17, 0))
+	eth_hw_addr_set(ndev, ndev->perm_addr);
+#else
 	memcpy(ndev->dev_addr, ndev->perm_addr, ETH_ALEN);
+#endif
 	SET_NETDEV_DEV(ndev, wiphy_dev(local->hw.wiphy));
 
 	/* don't use IEEE80211_DEV_TO_SUB_IF because it checks too much */
