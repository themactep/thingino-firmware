#!/bin/sh
# 32 MB low-memory tuning, late part (BR2_THINGINO_LOWMEM, Lu-Fi/openimp#800).
# Runs right after S60uhttpd. See S03lowmem for the low-memory killer levels.

case "$1" in
	start)
		# uhttpd itself must stay up (if the low-memory killer takes it the
		# WebUI is gone until reboot): keep it at 0 or below. Its CGIs raise
		# themselves to 800 in auth.sh (patched at build time by
		# thingino-kopt), so the killer drops a heartbeat loop, a helper or
		# a curl, never the server and never the streamer.
		for p in $(pidof uhttpd); do
			a=$(cat "/proc/$p/oom_score_adj" 2>/dev/null)
			[ "${a:-0}" -gt 0 ] && echo 0 >"/proc/$p/oom_score_adj" 2>/dev/null
		done
		# Losing Wi-Fi or ssh makes the camera useless: keep them away from
		# both killers.
		for p in $(pidof wpa_supplicant) $(pidof dropbear); do
			echo -500 >"/proc/$p/oom_score_adj" 2>/dev/null
		done
		;;
	stop | restart | reload) ;;
	*)
		echo "Usage: $0 {start|stop}"
		exit 1
		;;
esac

exit 0
