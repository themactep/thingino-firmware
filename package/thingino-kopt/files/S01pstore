#!/bin/sh
# Mount pstore so the kernel log of the previous boot shows up in /sys/fs/pstore.
# Installed only with BR2_THINGINO_RAMOOPS=y.
case "$1" in
	start) [ -d /sys/fs/pstore ] && mount -t pstore pstore /sys/fs/pstore ;;
	stop | restart | reload) ;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac
exit 0
