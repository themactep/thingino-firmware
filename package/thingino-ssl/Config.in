config BR2_PACKAGE_THINGINO_SSL
	bool

choice
	prompt "SSL/TLS Library"
	default BR2_PACKAGE_THINGINO_SSL_MBEDTLS
	help
	  Select the SSL/TLS library for thingino.
	  Only one SSL/TLS library should be selected.

config BR2_PACKAGE_THINGINO_SSL_MBEDTLS
	bool "mbedTLS"
	select BR2_PACKAGE_THINGINO_MBEDTLS
	select BR2_PACKAGE_MBEDTLS_CERTGEN
	select BR2_PACKAGE_THINGINO_SSL
	help
	  Use mbedTLS for SSL/TLS support.
	  Lightweight, designed for embedded systems with HTTP/2 support.

	  https://tls.mbed.org/

config BR2_PACKAGE_THINGINO_SSL_WOLFSSL
	bool "wolfSSL"
	depends on BR2_TOOLCHAIN_HAS_THREADS
	select BR2_PACKAGE_THINGINO_WOLFSSL
	select BR2_PACKAGE_THINGINO_WOLFSSL_CERTGEN
	select BR2_PACKAGE_THINGINO_SSL
	help
	  Use wolfSSL for SSL/TLS support.
	  Fast, portable SSL/TLS library targeted at IoT and embedded systems.

	  https://www.wolfssl.com/

config BR2_PACKAGE_THINGINO_SSL_OPENSSL
	bool "OpenSSL"
	select BR2_PACKAGE_OPENSSL
	select BR2_PACKAGE_LIBOPENSSL
	select BR2_PACKAGE_LIBOPENSSL_BIN
	# Essential for HTTPS, RTSPS, RTMP, WPA2, etc. (not all are needed)
	select BR2_PACKAGE_LIBOPENSSL_ENABLE_CHACHA          # Modern cipher for TLS 1.3
	select BR2_PACKAGE_LIBOPENSSL_ENABLE_RC4             # RTMP + WPA2-TKIP
	select BR2_PACKAGE_LIBOPENSSL_ENABLE_MD4             # WPA2 support
	select BR2_PACKAGE_LIBOPENSSL_ENABLE_DES             # WPA2 support
	select BR2_PACKAGE_LIBOPENSSL_ENABLE_PSK             # WPA2-PSK
	select BR2_PACKAGE_LIBOPENSSL_ENABLE_IDEA            # May be needed
	select BR2_PACKAGE_LIBOPENSSL_ENABLE_SEED            # May be needed
	select BR2_PACKAGE_LIBOPENSSL_ENABLE_BLAKE2          # Modern hash
	select BR2_PACKAGE_LIBOPENSSL_ENABLE_SSL             # Essential for HTTPS
	select BR2_PACKAGE_LIBOPENSSL_ENABLE_ECX             # Modern elliptic curves
	select BR2_PACKAGE_LIBOPENSSL_ENABLE_ARGON2          # Modern password hashing
	select BR2_PACKAGE_THINGINO_SSL
	help
	  Use OpenSSL for SSL/TLS support.
	  Full-featured, widely compatible SSL/TLS library.

	  Obsolete and insecure algorithms (MD2, RC2, CAST, Blowfish,
	  SSLv3, weak SSL, etc.) are disabled by default; see the
	  thingino libopenssl override (package/thingino-libopenssl/).

	  https://www.openssl.org/

endchoice

comment "wolfSSL needs a toolchain w/ threads"
	depends on !BR2_TOOLCHAIN_HAS_THREADS

# SSL library package definitions (selectable only via the choice above)
if BR2_PACKAGE_THINGINO_SSL
source "$BR2_EXTERNAL_THINGINO_PATH/package/thingino-mbedtls/Config.in"
source "$BR2_EXTERNAL_THINGINO_PATH/package/thingino-wolfssl/Config.in"
endif
