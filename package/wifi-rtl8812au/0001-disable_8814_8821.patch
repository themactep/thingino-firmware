From: Paul Philippov <paul@themactep.com>
Subject: [PATCH] rtl8812au: disable the 8821/8814 variants

Build the 8812AU-only configuration and anchor the phydm include
at the module source directory for out-of-tree kbuild.

Signed-off-by: Paul Philippov <paul@themactep.com>
---
--- a/Makefile
+++ b/Makefile
@@ -49,7 +49,7 @@
 
 ########################## WIFI IC ############################
 CONFIG_RTL8812A = y
-CONFIG_RTL8821A = y
+CONFIG_RTL8821A = n
 CONFIG_RTL8814A = n
 ######################### Interface ###########################
 CONFIG_USB_HCI = y
@@ -301,7 +301,7 @@
 				hal/btc/halbtc8821c2ant.o
 endif
 
-include $(TopDIR)/hal/phydm/phydm.mk
+include $(src)/hal/phydm/phydm.mk
 
 ########### HAL_RTL8812A_RTL8821A #################################
 ifneq ($(CONFIG_RTL8812A)_$(CONFIG_RTL8821A), n_n)
