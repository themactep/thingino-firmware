#!/bin/sh

DAEMON="/usr/sbin/ha-daemon"
DAEMON_NAME="ha-daemon"
PIDFILE="/run/ha-daemon.pid"
LOGFILE="/tmp/ha-daemon.log"
WATCHDOG="/usr/sbin/ha-watchdog"
WATCHDOG_PIDFILE="/run/ha-watchdog.pid"

start_daemon() {
	start-stop-daemon -S -b -m -p "$PIDFILE" -x "$DAEMON"
}

# ha-daemon is a shell script.  start-stop-daemon -K with -n can miss
# shell-script processes on some BusyBox versions (matching against
# /proc/PID/exe vs /proc/PID/comm asymmetry).  Use pidof + kill
# instead — pidof reliably finds scripts by searching cmdline, and
# kill works regardless of how the kernel names the process.
stop_daemon() {
	if [ -f "$PIDFILE" ]; then
		kill "$(cat "$PIDFILE")" 2>/dev/null
		rm -f "$PIDFILE"
	fi
	# Kill any stragglers that pidof can still see
	local pids
	pids=$(pidof "$DAEMON_NAME" 2>/dev/null)
	[ -n "$pids" ] && kill $pids 2>/dev/null
}

read_config() {
	jct /etc/thingino.json get "$1" 2>/dev/null
}

start() {
	echo -c 15 "Starting HA daemon"

	# Clear stop flag from previous shutdown
	rm -f /run/ha-stop

	if [ "true" != "$(read_config "ha.enabled")" ]; then
		echo "Disabled" >&2
		exit 1
	else
		echo "Enabled"
	fi

	host=$(read_config "ha.mqtt.host")
	if [ -z "$host" ]; then
		echo "HA MQTT host is not configured" >&2
		exit 1
	else
		echo "HA MQTT host: $host"
	fi

	start_daemon

	# Start watchdog to respawn ha-daemon if it crashes
	if [ -x "$WATCHDOG" ]; then
		start-stop-daemon -S -b -m -p "$WATCHDOG_PIDFILE" -x "$WATCHDOG"
	fi
}

stop() {
	echo -c 15 "Stopping HA daemon"

	# Provides HA_CAMERA_ID, needed to match this camera's mosquitto clients
	[ -f /usr/share/ha-common ] && . /usr/share/ha-common

	# Signal the watchdog to exit before we do anything else.
	# If the watchdog survives our kill signals (race window between
	# kill returning and the signal being delivered), it sees this flag
	# and exits instead of restarting ha-daemon.
	touch /run/ha-stop

	# Kill the watchdog FIRST and VERIFY it is dead before touching
	# ha-daemon.  Otherwise the watchdog can see ha-daemon's PID file
	# disappear (removed by stop_daemon below) and call S93ha restart
	# before we get a chance to kill it — producing an infinite restart
	# loop that stalls shutdown.
	if [ -f "$WATCHDOG_PIDFILE" ]; then
		kill "$(cat "$WATCHDOG_PIDFILE")" 2>/dev/null
		rm -f "$WATCHDOG_PIDFILE"
	fi
	killall -q ha-watchdog 2>/dev/null

	# Wait for the watchdog to actually die.  kill(1) returns before
	# the signal is delivered; without this wait the watchdog can still
	# be alive when we kill ha-daemon below.
	local wdog_timeout=30
	while [ "$wdog_timeout" -gt 0 ]; do
		pidof ha-watchdog >/dev/null 2>&1 || break
		sleep 0.1
		wdog_timeout=$((wdog_timeout - 1))
	done

	# Now safe to kill ha-daemon — the watchdog cannot respawn it.
	stop_daemon
	killall -q ha-commands ha-discovery ha-state 2>/dev/null
	if [ -n "$HA_CAMERA_ID" ]; then
		pkill -f "mosquitto_.*${HA_CAMERA_ID}" 2>/dev/null
	fi

	# Give processes a brief moment to exit gracefully (offline MQTT),
	# then force-kill any survivors.  No long polling — the MQTT broker
	# detects TCP disconnect via keepalive if we miss the offline message.
	sleep 1
	start-stop-daemon -K -s SIGKILL -n ha-daemon 2>/dev/null
	pkill -9 -f ha-watchdog 2>/dev/null
	killall -q -9 ha-commands ha-discovery ha-state 2>/dev/null
	if [ -n "$HA_CAMERA_ID" ]; then
		pkill -9 -f "mosquitto_.*${HA_CAMERA_ID}" 2>/dev/null
	fi

	rm -f /run/ha-stop
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart)
		stop
		sleep 1
		start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac

exit 0
