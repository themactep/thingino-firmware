#!/bin/sh

DAEMON="/usr/sbin/ha-daemon"
DAEMON_NAME="ha-daemon"
PIDFILE="/run/ha-daemon.pid"
LOGFILE="/tmp/ha-daemon.log"
WATCHDOG="/usr/sbin/ha-watchdog"
WATCHDOG_PIDFILE="/run/ha-watchdog.pid"

start_daemon() {
	start-stop-daemon -S -b -m -p "$PIDFILE" -x "$DAEMON"
}

# ha-daemon is a shell script: matching with -x compares /proc/PID/exe,
# which points to the interpreter, not the script. Match by name instead.
stop_daemon() {
	if [ -f "$PIDFILE" ]; then
		start-stop-daemon -K -p "$PIDFILE" -n "$DAEMON_NAME"
		status=$?
		rm -f "$PIDFILE"
		return $status
	fi

	start-stop-daemon -K -n "$DAEMON_NAME"
}

read_config() {
	jct /etc/thingino.json get "$1" 2>/dev/null
}

ha_processes_gone() {
	local proc
	for proc in ha-daemon ha-commands ha-discovery ha-state ha-watchdog; do
		if pidof "$proc" >/dev/null 2>&1; then
			return 1
		fi
	done
	if [ -n "$HA_CAMERA_ID" ]; then
		if pgrep -f "mosquitto_.*${HA_CAMERA_ID}" >/dev/null 2>&1; then
			return 1
		fi
	fi
	return 0
}

wait_for_ha_shutdown() {
	local timeout=20
	while [ "$timeout" -gt 0 ]; do
		ha_processes_gone && return 0
		sleep 1
		timeout=$((timeout - 1))
	done
	return 1
}

start() {
	echo -c 15 "Starting HA daemon"

	if [ "true" != "$(read_config "ha.enabled")" ]; then
		echo "Disabled" >&2
		exit 1
	else
		echo "Enabled"
	fi

	host=$(read_config "ha.mqtt.host")
	if [ -z "$host" ]; then
		echo "HA MQTT host is not configured" >&2
		exit 1
	else
		echo "HA MQTT host: $host"
	fi

	start_daemon

	# Start watchdog to respawn ha-daemon if it crashes
	if [ -x "$WATCHDOG" ]; then
		start-stop-daemon -S -b -m -p "$WATCHDOG_PIDFILE" -x "$WATCHDOG"
	fi
}

stop() {
	echo -c 15 "Stopping HA daemon"

	# Provides HA_CAMERA_ID, needed to match this camera's mosquitto clients
	[ -f /usr/share/ha-common ] && . /usr/share/ha-common

	# Kill the watchdog FIRST — if we stop ha-daemon before the watchdog,
	# the watchdog sees a missing PID file and respawns everything.
	# Use the PID file: killall can't match scripts (comm is "sh").
	if [ -f "$WATCHDOG_PIDFILE" ]; then
		kill "$(cat "$WATCHDOG_PIDFILE")" 2>/dev/null
		rm -f "$WATCHDOG_PIDFILE"
	fi

	stop_daemon
	killall -q ha-watchdog ha-commands ha-discovery ha-state 2>/dev/null
	rm -f "$WATCHDOG_PIDFILE"
	if [ -n "$HA_CAMERA_ID" ]; then
		pkill -f "mosquitto_.*${HA_CAMERA_ID}" 2>/dev/null
	fi
	if ! wait_for_ha_shutdown; then
		start-stop-daemon -K -s SIGKILL -n ha-daemon 2>/dev/null
		pkill -9 -f ha-watchdog 2>/dev/null
		killall -q -9 ha-commands ha-discovery ha-state 2>/dev/null
		if [ -n "$HA_CAMERA_ID" ]; then
			pkill -9 -f "mosquitto_.*${HA_CAMERA_ID}" 2>/dev/null
		fi
		wait_for_ha_shutdown || true
	fi
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart)
		stop
		sleep 1
		start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac

exit 0
