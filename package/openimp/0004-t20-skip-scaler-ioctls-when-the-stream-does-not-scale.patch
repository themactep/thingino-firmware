From: Paul Philippov <paul@themactep.com>
Subject: [PATCH] t20: skip the scaler ioctls when the stream does not scale

fs_set_format() always queried the scaler cap and programmed the scaler,
even for the full-resolution channel, which has no scaler.  The driver
answers GET_SCALERCAP with EPERM for that channel by design, so the query
was treated as fatal and IMP_FrameSource_EnableChn() failed on the main
stream:

    [KernelIF] Opened /dev/video1 (fd=23)
    [KernelIF] T20 GET_SCALERCAP failed: Operation not permitted
    [ERROR:IMPFramesource.cpp]: IMP_FrameSource_EnableChn(0) ... failed

Only touch the scaler when the stream actually scales.  The same channel
then reaches TRY_FMT/S_FMT and the main stream comes up.

Signed-off-by: Paul Philippov <paul@themactep.com>
---
 src/kernel_interface.c | 19 ++++++++++++-------
 1 file changed, 13 insertions(+), 8 deletions(-)

diff --git a/src/kernel_interface.c b/src/kernel_interface.c
--- a/src/kernel_interface.c
+++ b/src/kernel_interface.c
@@ -429,13 +429,18 @@
         fprintf(stderr, "[KernelIF] T20 VIDIOC_S_CROP failed: %s\n", strerror(errno));
         return -1;
     }
-    if (ioctl(fd, VIDIOC_GET_SCALERCAP, &cap) < 0) {
-        fprintf(stderr, "[KernelIF] T20 GET_SCALERCAP failed: %s\n", strerror(errno));
-        return -1;
-    }
-    if (ioctl(fd, VIDIOC_SET_SCALER, &scaler) < 0) {
-        fprintf(stderr, "[KernelIF] T20 SET_SCALER failed: %s\n", strerror(errno));
-        return -1;
+    /* The FR (full-resolution) channel has no scaler; the driver answers
+     * GET_SCALERCAP with EPERM for it.  Only touch the scaler when this
+     * stream actually scales, otherwise the query is fatal to bring-up. */
+    if (fmt->scaler_enable) {
+        if (ioctl(fd, VIDIOC_GET_SCALERCAP, &cap) < 0) {
+            fprintf(stderr, "[KernelIF] T20 GET_SCALERCAP failed: %s\n", strerror(errno));
+            return -1;
+        }
+        if (ioctl(fd, VIDIOC_SET_SCALER, &scaler) < 0) {
+            fprintf(stderr, "[KernelIF] T20 SET_SCALER failed: %s\n", strerror(errno));
+            return -1;
+        }
     }
 
     s.type = 1;
-- 
