 static int t31_ao_driver_write(void *ctx, const void *data, size_t len)
 {
+#if defined(OPENIMP_T31_ALSA)
+    (void)ctx;
+    if (!t31_audio.ao_pcm)
+        return -1;
+    {
+        unsigned int channels = t31_audio.ao_attr.soundmode ==
+                                        AUDIO_SOUND_MODE_STEREO ? 2U : 1U;
+        int frames = (int)(len / (channels * 2));
+        int written;
+
+        if (channels == 2)
+            written = pcm_writei(t31_audio.ao_pcm, data, (unsigned int)frames);
+        else {
+            int16_t *stereo = malloc((size_t)frames * 2 * sizeof(int16_t));
+            int i;
+
+            if (!stereo)
+                return -1;
+            for (i = 0; i < frames; i++) {
+                stereo[2 * i] = ((const int16_t *)data)[i];
+                stereo[2 * i + 1] = ((const int16_t *)data)[i];
+            }
+            written = pcm_writei(t31_audio.ao_pcm, stereo, (unsigned int)frames);
+            free(stereo);
+        }
+        return written == frames ? 0 : -1;
+    }
+#else
     const unsigned char *bytes = data;
 
     (void)ctx;
@@ -1927,6 +2078,7 @@
         len -= take;
     }
     return 0;
+#endif
 }
 
 static int t31_ao_write_period(void)
