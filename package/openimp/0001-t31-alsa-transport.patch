+#if defined(OPENIMP_T31_ALSA)
+static void t31_alsa_config(struct pcm_config *config,
+                            const IMPAudioIOAttr *attribute,
+                            unsigned int channels)
+{
+    unsigned int periods = attribute->frmNum >= 2 ? attribute->frmNum : 8;
+
+    if (periods > 64)
+        periods = 64;
+    memset(config, 0, sizeof(*config));
+    config->channels = channels;
+    config->rate = attribute->samplerate;
+    config->period_size = attribute->numPerFrm ? attribute->numPerFrm : 160;
+    config->period_count = periods + 1;
+    config->format = PCM_FORMAT_S16_LE;
+    config->start_threshold = config->period_size;
+    config->stop_threshold = config->period_size * config->period_count;
+    config->silence_threshold = 0;
+}
+#endif
+
 int IMP_AI_Enable(int device)
 {
+#if !defined(OPENIMP_T31_ALSA)
     int fd;
+#endif
 
     if (device != 0 && device != 1)
         return -1;
     if (t31_audio.ai_enabled)
