From: Paul Philippov <paul@themactep.com>
Subject: [PATCH] linux 4.4/5.15: restore the Ingenic SDIO WLAN power hook

The Ingenic SDK kernels export ingenic_sdio_wlan_power_onoff() from the
MMC host driver, but the mainline driver dropped the platform_ops call
and the gpio implementation. Restore both when the kernel actually
provides the helper, so SDIO WLAN power sequencing keeps working on the
legacy Ingenic kernels. Kernels without the helper keep the empty stubs.

Signed-off-by: Paul Philippov <paul@themactep.com>
---
diff --git a/os_dep/linux/custom_gpio_linux.c b/os_dep/linux/custom_gpio_linux.c
index 23401b7..209d1e7 100644
--- a/os_dep/linux/custom_gpio_linux.c
+++ b/os_dep/linux/custom_gpio_linux.c
@@ -329,6 +329,21 @@ int unregister_net_gpio_init(void)
 
 #else
 
+#if defined(CONFIG_INGENIC_MMC_MMC0) || defined(CONFIG_INGENIC_MMC_MMC0_MODULE) || \
+	defined(CONFIG_INGENIC_MMC_MMC1) || defined(CONFIG_INGENIC_MMC_MMC1_MODULE) || \
+	defined(CONFIG_MMC_SDHCI_INGENIC) || defined(CONFIG_MMC_SDHCI_INGENIC_MODULE)
+#define RTW_INGENIC_SDIO_WLAN_POWER 1
+#endif
+
+#ifdef RTW_INGENIC_SDIO_WLAN_POWER
+
+extern int ingenic_sdio_wlan_power_onoff(int onoff, int flag);
+#define RESET  0
+#define NORMAL 1
+
+static int poweroff_num = 0;
+static int poweron_num = 0;
+
 int rtw_wifi_gpio_init(void)
 {
 	return 0;
@@ -336,5 +351,43 @@ int rtw_wifi_gpio_init(void)
 
 void rtw_wifi_gpio_wlan_ctrl(int onoff)
 {
+	printk("%s: %d, onoff = %x\n", __func__, __LINE__, onoff);
+	switch (onoff) {
+	case 0:
+		if (poweroff_num) {
+			printk(("=========== WLAN placed in RESET OFF========\n"));
+			ingenic_sdio_wlan_power_onoff(onoff, RESET);
+		} else {
+			printk(("=========== WLAN placed in NOMAL OFF ========\n"));
+			poweroff_num = 1;
+			ingenic_sdio_wlan_power_onoff(onoff, NORMAL);
+		}
+		mdelay(100);
+		break;
+	case 1:
+		if (poweron_num) {
+			printk(("=========== WLAN placed in RESET ON  ========\n"));
+			ingenic_sdio_wlan_power_onoff(onoff, RESET);
+		} else {
+			printk(("=========== WLAN placed in NOMAL ON========\n"));
+			poweron_num = 1;
+			ingenic_sdio_wlan_power_onoff(onoff, NORMAL);
+		}
+		break;
+	}
+	return;
 }
+
+#else
+
+int rtw_wifi_gpio_init(void)
+{
+	return 0;
+}
+
+void rtw_wifi_gpio_wlan_ctrl(int onoff)
+{
+}
+
+#endif /* RTW_INGENIC_SDIO_WLAN_POWER */
 #endif /* CONFIG_PLATFORM_SPRD */
diff --git a/platform/platform_ops.c b/platform/platform_ops.c
index 627cf32..e97eac4 100644
--- a/platform/platform_ops.c
+++ b/platform/platform_ops.c
@@ -14,6 +14,12 @@
  *****************************************************************************/
 #include "platform_ops.h"
 #ifndef CONFIG_PLATFORM_OPS
+#if defined(CONFIG_INGENIC_MMC_MMC0) || defined(CONFIG_INGENIC_MMC_MMC0_MODULE) || \
+	defined(CONFIG_INGENIC_MMC_MMC1) || defined(CONFIG_INGENIC_MMC_MMC1_MODULE) || \
+	defined(CONFIG_MMC_SDHCI_INGENIC) || defined(CONFIG_MMC_SDHCI_INGENIC_MODULE)
+#define RTW_INGENIC_SDIO_WLAN_POWER 1
+extern void rtw_wifi_gpio_wlan_ctrl(int onoff);
+#endif
 /*
  * Return:
  *	0:	power on successfully
@@ -23,11 +29,17 @@ int platform_wifi_power_on(void)
 {
 	int ret = 0;
 
+#ifdef RTW_INGENIC_SDIO_WLAN_POWER
+	rtw_wifi_gpio_wlan_ctrl(1);
+#endif
 
 	return ret;
 }
 
 void platform_wifi_power_off(void)
 {
+#ifdef RTW_INGENIC_SDIO_WLAN_POWER
+	rtw_wifi_gpio_wlan_ctrl(0);
+#endif
 }
 #endif /* !CONFIG_PLATFORM_OPS */
-- 
2.55.0
