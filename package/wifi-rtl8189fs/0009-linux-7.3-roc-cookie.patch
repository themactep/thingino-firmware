From: Paul Philippov <paul@themactep.com>
Subject: [PATCH] linux 7.3: adapt the ROC and mgmt-tx cookies

Linux 7.3 passes the cfg80211 remain-on-channel and mgmt-tx
cookie by value. Keep the driver's pointer-based bookkeeping by
taking a local copy of the cookie.

Signed-off-by: Paul Philippov <paul@themactep.com>
---
--- a/os_dep/linux/ioctl_cfg80211.c	2026-11-02 06:47:04.738055883 -0500
+++ b/os_dep/linux/ioctl_cfg80211.c	2026-11-02 06:47:04.760318162 -0500
@@ -7915,7 +7915,12 @@
 	enum nl80211_channel_type channel_type,
 #endif
 	unsigned int duration,
-#if (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 18, 0))
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(7, 3, 0))
+	u64 cookie_in, const u8 *rx_addr)
+{
+	u64 *cookie = &cookie_in;
+	(void)rx_addr;
+#elif (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 18, 0))
 	u64 *cookie, const u8 *rx_addr)
 {
 	(void)rx_addr;
@@ -8494,8 +8499,14 @@
 #else
 	struct cfg80211_mgmt_tx_params *params,
 #endif
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(7, 3, 0))
+	u64 cookie_in)
+{
+	u64 *cookie = &cookie_in;
+#else
 	u64 *cookie)
 {
+#endif
 #if (LINUX_VERSION_CODE >= KERNEL_VERSION(3, 14, 0)) || defined(COMPAT_KERNEL_RELEASE)
 	struct ieee80211_channel *chan = params->chan;
 	const u8 *buf = params->buf;
