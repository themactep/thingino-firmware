+		/* check x value */
+		gpio = (x > 0) ? mdev->motors[HORIZONTAL_MOTOR].pdata->motor_max_gpio
+			       : mdev->motors[HORIZONTAL_MOTOR].pdata->motor_min_gpio;
+		if (gpio_is_valid(gpio)) {
