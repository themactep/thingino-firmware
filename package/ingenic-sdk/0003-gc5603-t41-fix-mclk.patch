From 0000000000000000000000000000000000000005 Mon Sep 17 00:00:00 2001
From: Oskari Rauta <oskari.rauta@gmail.com>
Date: Sun, 12 Jul 2026 11:28:06 +0300
Subject: [PATCH] ingenic-sdk: gc5603 t41: use the real CIM clocks and VPLL

The gc5603 driver was copied from a tree where the CIM clocks are named
per channel ("mux_cim0".."div_cim0"). On T41 the clock driver exposes
"mux_cim"/"div_cim" (4.4.94/isp/t41/include/sensor-common.h defines
SEN_MCLK and SEN_BCLK that way), so the lookups fail and the MCLK never
reaches the rate the sensor expects.

The fallback then reparents to EPLL, which does not exist on T41: the
clock driver provides APLL, MPLL and VPLL only. The error path leaves the
parent unchanged and 27 MHz is requested from a parent that cannot divide
to it. GC5603's 30 fps mode needs a true 27 MHz MCLK; without it the ISP
AE fps calculation stalls the pipeline.

Use the generic clock names and reparent mux_cim to VPLL (1080 MHz / 40 =
27 MHz) when the current rate is not a multiple of 27 MHz.

Signed-off-by: Oskari Rauta <oskari.rauta@gmail.com>
Signed-off-by: Paul Philippov <paul@themactep.com>
---
--- a/4.4.94/sensor-src/t41/gc5603.c
+++ b/4.4.94/sensor-src/t41/gc5603.c
@@ -1035,18 +1035,18 @@
 
 	switch (info->mclk) {
 		case TISP_SENSOR_MCLK0:
-			sclka = private_devm_clk_get(&client->dev, "mux_cim0");
-			sensor->mclk = private_devm_clk_get(sensor->dev, "div_cim0");
+			sclka = private_devm_clk_get(&client->dev, "mux_cim");
+			sensor->mclk = private_devm_clk_get(sensor->dev, "div_cim");
 			set_sensor_mclk_function(0);
 			break;
 		case TISP_SENSOR_MCLK1:
-			sclka = private_devm_clk_get(&client->dev, "mux_cim1");
-			sensor->mclk = private_devm_clk_get(sensor->dev, "div_cim1");
+			sclka = private_devm_clk_get(&client->dev, "mux_cim");
+			sensor->mclk = private_devm_clk_get(sensor->dev, "div_cim");
 			set_sensor_mclk_function(1);
 			break;
 		case TISP_SENSOR_MCLK2:
-			sclka = private_devm_clk_get(&client->dev, "mux_cim2");
-			sensor->mclk = private_devm_clk_get(sensor->dev, "div_cim2");
+			sclka = private_devm_clk_get(&client->dev, "mux_cim");
+			sensor->mclk = private_devm_clk_get(sensor->dev, "div_cim");
 			set_sensor_mclk_function(2);
 			break;
 		default:
@@ -1059,19 +1059,20 @@
 	}
 
 	rate = private_clk_get_rate(sensor->mclk);
-	if (((rate / 1000) % 27000) != 0) {
-		ret = clk_set_parent(sclka, clk_get(NULL, "epll"));
-		sclka = private_devm_clk_get(&client->dev, "epll");
-		if (IS_ERR(sclka)) {
-			pr_err("get sclka failed\n");
+	{
+		/* gc5603 30fps mode is designed for 27 MHz MCLK. The T41 has no
+		 * EPLL (only APLL 1104 / MPLL 1400 / VPLL 1080); APLL cannot divide
+		 * to 27 MHz. VPLL is a valid mux_cim parent and 1080/40 = 27 MHz.
+		 * Without a true 27 MHz the ISP AE fps calc stalls the pipeline. */
+		struct clk *vpll = clk_get(NULL, "vpll");
+		if (IS_ERR_OR_NULL(vpll)) {
+			pr_warn("gc5603: vpll unavailable, keeping mclk parent\n");
 		} else {
-			rate = private_clk_get_rate(sclka);
-			if (((rate / 1000) % 27000) != 0) {
-				private_clk_set_rate(sclka, 891000000);
-			}
+			ret = clk_set_parent(sclka, vpll);
+			if (ret)
+				pr_warn("gc5603: reparent mux_cim to vpll failed\n");
 		}
 	}
-
 	private_clk_set_rate(sensor->mclk, 27000000);
 	private_clk_prepare_enable(sensor->mclk);
 
