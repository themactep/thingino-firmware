From: Paul Philippov <paul@themactep.com>
Subject: [PATCH] wq9001: use the kernel IFF flags on 7.3

The driver's private IFF_* defines collide with linux/if.h.
Use the kernel values on 7.3 and keep only the driver-specific
bits. Also relax missing-prototypes.

Signed-off-by: Paul Philippov <paul@themactep.com>
---
--- a/oss/_if.h	2026-11-02 13:11:36.330400471 -0500
+++ b/oss/_if.h	2026-11-02 13:11:36.349897429 -0500
@@ -15,22 +15,38 @@
  * (d) if_drv_flags field written only by the device driver, read by either
  *     the stack or driver.
  */
-#define IFF_UP          0x1             /* (n) interface is up */
-#define IFF_BROADCAST   0x2             /* (i) broadcast address valid */
-#define IFF_DEBUG       0x4             /* (n) turn on debugging */
-#define IFF_LOOPBACK    0x8             /* (i) is a loopback net */
-#define IFF_POINTOPOINT 0x10            /* (i) is a point-to-point link */
+#if (LINUX_VERSION_CODE < KERNEL_VERSION(7, 3, 0))
+#define IFF_UP          0x1
+#endif             /* (n) interface is up */
+#if (LINUX_VERSION_CODE < KERNEL_VERSION(7, 3, 0))
+#define IFF_BROADCAST   0x2
+#endif             /* (i) broadcast address valid */
+#if (LINUX_VERSION_CODE < KERNEL_VERSION(7, 3, 0))
+#define IFF_DEBUG       0x4
+#endif             /* (n) turn on debugging */
+#if (LINUX_VERSION_CODE < KERNEL_VERSION(7, 3, 0))
+#define IFF_LOOPBACK    0x8
+#endif             /* (i) is a loopback net */
+#if (LINUX_VERSION_CODE < KERNEL_VERSION(7, 3, 0))
+#define IFF_POINTOPOINT 0x10
+#endif            /* (i) is a point-to-point link */
 #define IFF_DRV_RUNNING 0x40            /* (d) resources allocated */
-#define IFF_NOARP       0x80            /* (n) no address resolution protocol */
-#define IFF_PROMISC     0x100           /* (n) receive all packets */
-#define IFF_ALLMULTI    0x200           /* (n) receive all multicast packets */
+#if (LINUX_VERSION_CODE < KERNEL_VERSION(7, 3, 0))
+#define IFF_NOARP       0x80
+#endif            /* (n) no address resolution protocol */
+#if (LINUX_VERSION_CODE < KERNEL_VERSION(7, 3, 0))
+#define IFF_PROMISC     0x100
+#endif           /* (n) receive all packets */
+#if (LINUX_VERSION_CODE < KERNEL_VERSION(7, 3, 0))
+#define IFF_ALLMULTI    0x200
+#endif           /* (n) receive all multicast packets */
 #define IFF_DRV_OACTIVE 0x400           /* (d) tx hardware queue is full */
 #define IFF_SIMPLEX     0x800           /* (i) can't hear own transmissions */
 #define IFF_LINK0       0x1000          /* per link layer defined bit */
 #define IFF_LINK1       0x2000          /* per link layer defined bit */
 #define IFF_LINK2       0x4000          /* per link layer defined bit */
 #define IFF_ALTPHYS     IFF_LINK2       /* use alternate physical connection */
-#if LINUX_VERSION_CODE > KERNEL_VERSION(3,0,8)
+#if LINUX_VERSION_CODE > KERNEL_VERSION(3,0,8) && LINUX_VERSION_CODE < KERNEL_VERSION(7, 3, 0)
 #define IFF_MULTICAST   0x8000          /* (i) supports multicast */
 #endif
 #define IFF_CANTCONFIG  0x10000         /* (i) unconfigurable using ioctl(2) */
--- a/Makefile	2026-11-02 13:11:36.332427651 -0500
+++ b/Makefile	2026-11-02 13:11:36.349929094 -0500
@@ -64,6 +64,7 @@
 subdir-ccflags-y +=  -I$(DRV_PATH)/wdrv -I$(DRV_PATH)/wdrv/mwl  -I$(DRV_PATH)/oss -I$(DRV_PATH)/wproto
 
 ccflags-y += -DWQ_DEBUG
+ccflags-y += -Wno-error=missing-prototypes
 #ccflags-y += -DWQ_SIM_HOST_ONLY
 #ccflags-y += -DWQ_BUS_TEST
 ccflags-y += -DWQ_FW_DL
