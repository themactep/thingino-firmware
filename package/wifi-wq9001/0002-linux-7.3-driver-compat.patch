diff --git a/oss/net_if.c b/oss/net_if.c
index 3ba27cf..359d771 100644
--- a/oss/net_if.c
+++ b/oss/net_if.c
@@ -1,4 +1,16 @@
 #include "oss.h"
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(7, 0, 0))
+static inline char *wq_strncpy(char *dest, const char *src, size_t count)
+{
+	size_t i;
+	for (i = 0; i < count && src[i]; i++)
+		dest[i] = src[i];
+	for (; i < count; i++)
+		dest[i] = 0;
+	return dest;
+}
+#define strncpy wq_strncpy
+#endif
 
 void net_if_link_state_change(struct ifnet *ifp, int link_state)
 {
@@ -204,7 +216,9 @@ int net_if_ioctl(struct ifnet *ifp, unsigned int cmd, caddr_t data)
         case SIOCGIFFLAGS:
             temp_flags = ifp->if_flags | ifp->if_drv_flags;
             ifr->ifr_flags = temp_flags & 0xffff;
+#if (LINUX_VERSION_CODE < KERNEL_VERSION(7, 3, 0))
             ifr->ifr_flagshigh = temp_flags >> 16;
+#endif
             break;
 
         case SIOCGIFMTU:
@@ -212,8 +226,12 @@ int net_if_ioctl(struct ifnet *ifp, unsigned int cmd, caddr_t data)
             break;
 
         case SIOCSIFFLAGS:
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(7, 3, 0))
+            new_flags = ifr->ifr_flags & 0xffff;
+#else
             new_flags = (ifr->ifr_flags & 0xffff) |
                         (ifr->ifr_flagshigh << 16);
+#endif
             if (ifp->if_flags & IFF_UP && (new_flags & IFF_UP) == 0)
                 net_if_down(ifp);
             else if (new_flags & IFF_UP && (ifp->if_flags & IFF_UP) == 0)
