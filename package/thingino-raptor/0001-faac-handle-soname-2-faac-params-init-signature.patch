From 925af3be8b712443a7499bd3a4cc814b382dff12 Mon Sep 17 00:00:00 2001
From: Paul Philippov <paul@themactep.com>
Date: Thu, 1 Oct 2026 00:32:26 -0400
Subject: [PATCH] faac: handle SONAME 2 faac_params_init() signature

faac_params_init() gained a caller_size argument in SONAME 2 so the
library can reconcile a faac_params that has grown since the caller was
built. Pass sizeof(params) on 2.x and fall back to the one-argument form
on 1.x, covering both rad (AAC codec) and rsp (RTMP audio) call sites.
---
 rad/rad_codec_aac.c | 4 ++++
 rsp/rsp_audio.c     | 4 ++++
 2 files changed, 8 insertions(+)

diff --git a/rad/rad_codec_aac.c b/rad/rad_codec_aac.c
index f24fbe0..5b1bc50 100644
--- a/rad/rad_codec_aac.c
+++ b/rad/rad_codec_aac.c
@@ -61,7 +61,11 @@ static int aac_init(rad_codec_ctx_t *ctx, rss_config_t *cfg, int sample_rate)
 	}
 
 	faac_params params;
+#if defined(FAAC_VERSION_MAJOR) && (FAAC_VERSION_MAJOR >= 2)
+	faac_status status = faac_params_init(&params, (uint32_t)sizeof(params));
+#else
 	faac_status status = faac_params_init(&params);
+#endif
 	if (status != FAAC_OK) {
 		free(st);
 		return -1;
diff --git a/rsp/rsp_audio.c b/rsp/rsp_audio.c
index af7afad..4854d2f 100644
--- a/rsp/rsp_audio.c
+++ b/rsp/rsp_audio.c
@@ -153,7 +153,11 @@ rsp_audio_enc_t *rsp_audio_init(uint32_t input_codec, uint32_t sample_rate)
 
 	/* Init faac encoder at output rate (48kHz for RTMP compatibility) */
 	faac_params params;
+#if defined(FAAC_VERSION_MAJOR) && (FAAC_VERSION_MAJOR >= 2)
+	faac_status status = faac_params_init(&params, (uint32_t)sizeof(params));
+#else
 	faac_status status = faac_params_init(&params);
+#endif
 	if (status != FAAC_OK) {
 		RSS_ERROR("rsp_audio: faac params init failed: %s", faac_strerror(status));
 		free(enc);
-- 
2.55.0

