FAAC 3.0 renames the encoder configuration fields, removes the old
names without a shim, and requires the caller size in
`faac_params_init()`.

Map the fields to the ABI 3 names and pass the parameter size. These
streams are mono, so their bit_rate values are already whole-stream and
do not need scaling.

diff --git a/rad/rad_codec_aac.c b/rad/rad_codec_aac.c
index 26186dd..c6fe7b7 100644
--- a/rad/rad_codec_aac.c
+++ b/rad/rad_codec_aac.c
@@ -45,7 +45,7 @@ static int aac_init(rad_codec_ctx_t *ctx, rss_config_t *cfg, int sample_rate)
 	/* HE-AAC needs Fs >= 32kHz (the Fs/2 SBR core collapses below);
 	 * clamp an explicit request rather than failing encoder open. */
 	const char *profile = rss_config_get_str(cfg, "audio", "aac_profile", "lc");
-	enum faac_object_type object = FAAC_OBJ_LOW;
+	enum faac_object_type object = FAAC_OBJ_LC;
 	if (strcmp(profile, "he") == 0) {
 		if (sample_rate >= 32000) {
 			object = FAAC_OBJ_HE_AAC_V1;
@@ -60,20 +60,19 @@ static int aac_init(rad_codec_ctx_t *ctx, rss_config_t *cfg, int sample_rate)
 	}
 
 	faac_params params;
-	faac_status status = faac_params_init(&params);
+	faac_status status = faac_params_init(&params, (uint32_t)sizeof(params));
 	if (status != FAAC_OK) {
 		free(st);
 		return -1;
 	}
 	params.sample_rate = (uint32_t)sample_rate;
-	params.num_channels = 1;
-	params.mpeg_version = FAAC_MPEG4;
+	params.channels = 1;
 	params.object_type = object;
-	params.joint_mode = FAAC_JOINT_NONE;
-	params.use_tns = false;
-	params.bit_rate = (uint32_t)bitrate; /* per channel; mono */
+	params.stereo_mode = FAAC_STEREO_LR;
+	params.flags &= ~FAAC_FLAG_TNS;
+	params.bit_rate = (uint32_t)bitrate; /* whole-stream; mono */
 	params.bandwidth = 0;		     /* derive cutoff from bit_rate */
-	params.output_format = FAAC_STREAM_RAW;
+	params.stream_format = FAAC_STREAM_RAW;
 	params.input_format = FAAC_INPUT_16BIT;
 
 	status = faac_encoder_open(&params, &st->handle);
diff --git a/rsp/rsp_audio.c b/rsp/rsp_audio.c
index af7afad..1a91c82 100644
--- a/rsp/rsp_audio.c
+++ b/rsp/rsp_audio.c
@@ -153,24 +153,23 @@ rsp_audio_enc_t *rsp_audio_init(uint32_t input_codec, uint32_t sample_rate)
 
 	/* Init faac encoder at output rate (48kHz for RTMP compatibility) */
 	faac_params params;
-	faac_status status = faac_params_init(&params);
+	faac_status status = faac_params_init(&params, (uint32_t)sizeof(params));
 	if (status != FAAC_OK) {
 		RSS_ERROR("rsp_audio: faac params init failed: %s", faac_strerror(status));
 		free(enc);
 		return NULL;
 	}
 	params.sample_rate = enc->output_rate;
-	params.num_channels = 1;
-	params.mpeg_version = FAAC_MPEG4;
+	params.channels = 1;
 	/* RTMP push stays AAC-LC: the FLV sequence header emitted here
 	 * carries no HE signaling, and the fixed 128k bitrate would never
 	 * select HE anyway. */
-	params.object_type = FAAC_OBJ_LOW;
-	params.joint_mode = FAAC_JOINT_NONE;
-	params.use_tns = false;
-	params.bit_rate = 128000; /* per channel; mono */
+	params.object_type = FAAC_OBJ_LC;
+	params.stereo_mode = FAAC_STEREO_LR;
+	params.flags &= ~FAAC_FLAG_TNS;
+	params.bit_rate = 128000; /* whole-stream; mono */
 	params.bandwidth = 0;	  /* derive cutoff from bit_rate */
-	params.output_format = FAAC_STREAM_RAW;
+	params.stream_format = FAAC_STREAM_RAW;
 	params.input_format = FAAC_INPUT_16BIT;
 
 	status = faac_encoder_open(&params, &enc->faac);
