			agent_print_setting_leaf enabled "$(agent_stream_enabled "$stream_id")"
			;;
		streams/[01]/audio-enabled)
			agent_print_setting_leaf audio_enabled "$(agent_stream_audio_enabled)"
			;;
		streams/[01]/width)
			stream_id=${path#streams/}
			stream_id=${stream_id%/width}
			agent_print_setting_leaf width "$(agent_json_value_or "$(agent_stream_field "$stream_id" width)" null)"
			;;
		streams/[01]/height)
			stream_id=${path#streams/}
			stream_id=${stream_id%/height}
			agent_print_setting_leaf height "$(agent_json_value_or "$(agent_stream_field "$stream_id" height)" null)"
			;;
		streams/[01]/fps)
			stream_id=${path#streams/}
			stream_id=${stream_id%/fps}
			agent_print_setting_leaf fps "$(agent_json_value_or "$(agent_stream_field "$stream_id" fps)" null)"
			;;
		streams/[01]/bitrate)
			stream_id=${path#streams/}
			stream_id=${stream_id%/bitrate}
			agent_print_setting_leaf bitrate "$(agent_json_value_or "$(agent_stream_field "$stream_id" bitrate)" null)"
			;;
		streams/[01]/gop)
			stream_id=${path#streams/}
			stream_id=${stream_id%/gop}
			agent_print_setting_leaf gop "$(agent_json_value_or "$(agent_stream_field "$stream_id" gop)" null)"
			;;
		streams/[01]/buffers)
			stream_id=${path#streams/}
			stream_id=${stream_id%/buffers}
			agent_print_setting_leaf buffers "$(agent_json_value_or "$(agent_stream_field "$stream_id" nr_vbs)" null)"
			;;
		streams/[01]/profile)
			stream_id=${path#streams/}
			stream_id=${stream_id%/profile}
			_profile_raw=$(agent_stream_field "$stream_id" profile)
			if [ -n "$_profile_raw" ]; then
				printf '{"profile":%s}\n' "$(agent_json_string "$(agent_profile_to_name "$_profile_raw")")"
			else
				printf '{"profile":null}\n'
			fi
			;;
		streams/[01]/rtsp-endpoint)
			stream_id=${path#streams/}
			stream_id=${stream_id%/rtsp-endpoint}
			printf '{"rtsp_endpoint":%s}\n' "$(agent_json_string_or_null "$(agent_rtsp_endpoint "$stream_id")")"
			;;
		streams/[01]/format)
			stream_id=${path#streams/}
			stream_id=${stream_id%/format}
			printf '{"format":%s}\n' "$(agent_json_string_or_null "$(agent_stream_format "$stream_id")")"
			;;
		streams/[01]/mode)
			stream_id=${path#streams/}
			stream_id=${stream_id%/mode}
			printf '{"mode":%s}\n' "$(agent_json_string_or_null "$(agent_stream_mode "$stream_id")")"
			;;
		streams/[01]/osd/*)
			agent_print_osd_setting "$path"
			;;
		send2/services/*/send-photo)
			rest=${path#send2/services/}
			service=${rest%/send-photo}
			agent_send2_service_supported "$service" || return 1
			agent_send2_service_has_send_photo "$service" || {
				echo "send_photo is not supported for send2 service '$service'" >&2
				return 1
			}
			agent_print_setting_leaf send_photo "$(agent_json_value_or "$(agent_send2_raw "$service" send_photo)" true)"
			;;
		send2/services/*/send-video)
			rest=${path#send2/services/}
			service=${rest%/send-video}
			agent_send2_service_supported "$service" || return 1
			agent_send2_service_has_send_video "$service" || {
				echo "send_video is not supported for send2 service '$service'" >&2
				return 1
			}
			agent_print_setting_leaf send_video "$(agent_json_value_or "$(agent_send2_raw "$service" send_video)" false)"
			;;
		*)
			echo "unsupported setting path: $path" >&2
			return 1
			;;
	esac
}

agent_set_setting() {
	path=$1
	body_file=$2
	case "$path" in
		image/brightness)
			value=$(agent_setting_value "$body_file" brightness) || return 1
			agent_validate_int "$value" || return 1
			agent_ctl rvd set-brightness "$value" >/dev/null 2>&1 || return 1
			agent_config_set image brightness "$value" || return 1
			agent_config_save
			agent_print_setting_update "$path" brightness "$value"
			;;
		image/contrast)
			value=$(agent_setting_value "$body_file" contrast) || return 1
			agent_validate_int "$value" || return 1
			agent_ctl rvd set-contrast "$value" >/dev/null 2>&1 || return 1
			agent_config_set image contrast "$value" || return 1
			agent_config_save
			agent_print_setting_update "$path" contrast "$value"
			;;
		image/saturation)
			value=$(agent_setting_value "$body_file" saturation) || return 1
			agent_validate_int "$value" || return 1
			agent_ctl rvd set-saturation "$value" >/dev/null 2>&1 || return 1
			agent_config_set image saturation "$value" || return 1
			agent_config_save
			agent_print_setting_update "$path" saturation "$value"
			;;
		image/sharpness)
			value=$(agent_setting_value "$body_file" sharpness) || return 1
			agent_validate_int "$value" || return 1
			agent_ctl rvd set-sharpness "$value" >/dev/null 2>&1 || return 1
			agent_config_set image sharpness "$value" || return 1
			agent_config_save
			agent_print_setting_update "$path" sharpness "$value"
			;;
		image/anti-flicker)
			value=$(agent_setting_value "$body_file" anti_flicker) || return 1
			agent_validate_int "$value" || return 1
			agent_ctl rvd set-antiflicker "$value" >/dev/null 2>&1 || return 1
			agent_config_set sensor antiflicker "$value" || return 1
			agent_config_save
			agent_print_setting_update "$path" anti_flicker "$value"
			;;
		image/hflip)
			value=$(agent_setting_value "$body_file" hflip) || return 1
			agent_validate_bool "$value" || return 1
			raw=$(agent_json_bool_to_01 "$value") || return 1
			agent_ctl rvd set-hflip "$raw" >/dev/null 2>&1 || return 1
			agent_config_set image hflip "$raw" || return 1
			agent_config_save
			agent_print_setting_update "$path" hflip "$value"
			;;
		image/vflip)
			value=$(agent_setting_value "$body_file" vflip) || return 1
			agent_validate_bool "$value" || return 1
			raw=$(agent_json_bool_to_01 "$value") || return 1
			agent_ctl rvd set-vflip "$raw" >/dev/null 2>&1 || return 1
			agent_config_set image vflip "$raw" || return 1
			agent_config_save
			agent_print_setting_update "$path" vflip "$value"
			;;
		image/ae-compensation)
			value=$(agent_setting_value "$body_file" ae_compensation) || return 1
			agent_validate_int "$value" || return 1
			agent_ctl rvd set-ae-comp "$value" >/dev/null 2>&1 || return 1
			agent_config_set image ae_comp "$value" || return 1
			agent_config_save
			agent_print_setting_update "$path" ae_compensation "$value"
			;;
		image/core-wb-mode)
			value=$(agent_setting_value "$body_file" core_wb_mode) || return 1
			agent_validate_int "$value" || return 1
			wb_mode_int=$value
			mode=$(agent_wb_mode_from_int "$wb_mode_int")
			r_gain=$(agent_wb_gain_raw r)
			b_gain=$(agent_wb_gain_raw b)
			[ -n "$r_gain" ] || r_gain=256
			[ -n "$b_gain" ] || b_gain=256
			case "$mode" in
				manual | custom)
					agent_ctl rvd set-wb "$mode" "$r_gain" "$b_gain" >/dev/null 2>&1 || return 1
					;;
				*)
					agent_ctl rvd set-wb "$mode" >/dev/null 2>&1 || return 1
					;;
			esac
			agent_config_set image wb_mode "$mode" || return 1
			agent_config_save
			agent_print_setting_update "$path" core_wb_mode "$wb_mode_int"
			;;
		image/wb-rgain)
			value=$(agent_setting_value "$body_file" wb_rgain) || return 1
			agent_validate_int "$value" || return 1
			wb_rgain=$value
			mode=$(agent_wb_mode_raw)
			[ -n "$mode" ] || mode=manual
			case "$mode" in
				manual | custom) ;;
				*) mode=manual ;;
			esac
			b_gain=$(agent_wb_gain_raw b)
			[ -n "$b_gain" ] || b_gain=256
			agent_ctl rvd set-wb "$mode" "$wb_rgain" "$b_gain" >/dev/null 2>&1 || return 1
			agent_config_set image wb_mode "$mode" || return 1
			agent_config_set image wb_r "$wb_rgain" || return 1
			agent_config_save
			agent_print_setting_update "$path" wb_rgain "$wb_rgain"
			;;
		image/wb-bgain)
			value=$(agent_setting_value "$body_file" wb_bgain) || return 1
			agent_validate_int "$value" || return 1
			wb_bgain=$value
			mode=$(agent_wb_mode_raw)
			[ -n "$mode" ] || mode=manual
			case "$mode" in
				manual | custom) ;;
				*) mode=manual ;;
			esac
			r_gain=$(agent_wb_gain_raw r)
			[ -n "$r_gain" ] || r_gain=256
			agent_ctl rvd set-wb "$mode" "$r_gain" "$wb_bgain" >/dev/null 2>&1 || return 1
			agent_config_set image wb_mode "$mode" || return 1
			agent_config_set image wb_b "$wb_bgain" || return 1
			agent_config_save
			agent_print_setting_update "$path" wb_bgain "$wb_bgain"
			;;
		audio/mic-enabled)
			value=$(agent_setting_value "$body_file" mic_enabled) || return 1
			agent_validate_bool "$value" || return 1
			if [ "$value" = true ]; then
				microphone on >/dev/null 2>&1 || return 1
			else
				microphone off >/dev/null 2>&1 || return 1
			fi
			agent_config_save
			agent_print_setting_update "$path" mic_enabled "$value"
			;;
		audio/spk-enabled)
			value=$(agent_setting_value "$body_file" spk_enabled) || return 1
			agent_validate_bool "$value" || return 1
			if [ "$value" = true ]; then
				speaker on >/dev/null 2>&1 || return 1
			else
				speaker off >/dev/null 2>&1 || return 1
			fi
			agent_config_save
			agent_print_setting_update "$path" spk_enabled "$value"
			;;
		motion/enabled)
			value=$(agent_setting_value "$body_file" enabled) || return 1
			agent_validate_bool "$value" || return 1
			agent_config_set motion enabled "$value" || return 1
			agent_config_save
			agent_print_setting_update "$path" enabled "$value"
			;;
		motion/sensitivity)
			value=$(agent_setting_value "$body_file" sensitivity) || return 1
			agent_validate_int "$value" || return 1
			agent_ctl rmd sensitivity "$value" >/dev/null 2>&1 || true
			agent_config_set motion sensitivity "$value" || return 1
			agent_config_save
			agent_print_setting_update "$path" sensitivity "$value"
			;;
		motion/cooldown-time)
			value=$(agent_setting_value "$body_file" cooldown_time) || return 1
			agent_validate_int "$value" || return 1
			agent_config_set motion cooldown_sec "$value" || return 1
			agent_config_save
			agent_print_setting_update "$path" cooldown_time "$value"
			;;
		motion/outputs/send2/*)
			service=${path#motion/outputs/send2/}
			agent_send2_service_supported "$service" || return 1
			value=$(agent_setting_value "$body_file" enabled) || return 1
			agent_validate_bool "$value" || return 1
			agent_send2_motion_set "$service" "$value" || return 1
			agent_print_setting_update "$path" enabled "$value"
			;;
		daynight/enabled)
			value=$(agent_setting_value "$body_file" enabled) || return 1
			agent_validate_bool "$value" || return 1
			if agent_has_daynightd; then
				if [ "$value" = true ]; then
					agent_daynightd_set_mode auto || return 1
				else
					mode=$(agent_daynight_running_mode)
					case "$mode" in
						day | night) ;;
						*) mode=day ;;
					esac
					agent_daynightd_set_mode "$mode" || return 1
				fi
			elif [ "$value" = true ]; then
				agent_ctl ric mode auto >/dev/null 2>&1 || return 1
				agent_config_set ircut mode auto || return 1
				agent_config_save
			else
				mode=$(agent_daynight_running_mode)
				case "$mode" in
					day | night) ;;
					*) mode=day ;;
				esac
				agent_ctl ric mode "$mode" >/dev/null 2>&1 || return 1
				agent_config_set ircut mode "$mode" || return 1
				agent_config_save
			fi
			agent_print_setting_update "$path" enabled "$value"
			;;
		daynight/force-mode)
			value=$(agent_setting_value "$body_file" force_mode) || return 1
			value=$(agent_unquote_string "$value")
			case "$value" in
				day | night) ;;
				*)
					echo "force_mode must be day or night" >&2
					return 1
					;;
			esac
			if agent_has_daynightd; then
				agent_daynightd_set_mode "$value" || return 1
			else
				agent_ctl ric mode "$value" >/dev/null 2>&1 || return 1
				agent_config_set ircut mode "$value" || return 1
				agent_config_save
			fi
			agent_print_setting_update "$path" force_mode "$(agent_json_string "$value")"
			;;
		privacy/enabled)
			value=$(agent_setting_value "$body_file" enabled) || return 1
			agent_validate_bool "$value" || return 1
			if [ "$value" = true ]; then
				state=on
			else
				state=off
			fi
			agent_privacy "$state" all >/dev/null || return 1
			agent_print_setting_update "$path" enabled "$value"
			;;
		privacy/channel)
			value=$(agent_setting_value "$body_file" channel) || return 1
			case "$value" in
				all) value='"all"' ;;
				'"all"') ;;
				*)
					echo "privacy.channel must be all" >&2
					return 1
					;;
			esac
			agent_print_setting_update "$path" channel "$value"
			;;
		storage/*)
			agent_set_storage_setting "$path" "$body_file"
			;;
		streams/[01]/enabled)
			stream_id=${path#streams/}
			stream_id=${stream_id%/enabled}
			value=$(agent_setting_value "$body_file" enabled) || return 1
			agent_validate_bool "$value" || return 1
			if [ "$stream_id" = 0 ]; then
				if [ "$value" = true ]; then
					agent_ctl rvd stream-start 0 >/dev/null 2>&1 || true
				else
					agent_ctl rvd stream-stop 0 >/dev/null 2>&1 || true
				fi
			else
				agent_config_set stream1 enabled "$value" || return 1
				agent_config_save
				if [ "$value" = true ]; then
					agent_ctl rvd stream-start 1 >/dev/null 2>&1 || true
				else
					agent_ctl rvd stream-stop 1 >/dev/null 2>&1 || true
				fi
			fi
			agent_print_setting_update "$path" enabled "$value"
			;;
		streams/[01]/audio-enabled)
			value=$(agent_setting_value "$body_file" audio_enabled) || return 1
			agent_validate_bool "$value" || return 1
			agent_config_set audio enabled "$value" || return 1
			agent_config_save
			agent_print_setting_update "$path" audio_enabled "$value"
			;;
		streams/[01]/width)
			stream_id=${path#streams/}
			stream_id=${stream_id%/width}
			value=$(agent_setting_value "$body_file" width) || return 1
			agent_validate_int "$value" || return 1
			height=$(agent_stream_field "$stream_id" height)
			[ -n "$height" ] || height=1080
			agent_ctl rvd set-resolution "$stream_id" "$value" "$height" >/dev/null 2>&1 || return 1
			agent_config_set "$(agent_stream_section "$stream_id")" width "$value" || return 1
			agent_config_save
			agent_print_setting_update "$path" width "$value"
			;;
		streams/[01]/height)
			stream_id=${path#streams/}
			stream_id=${stream_id%/height}
			value=$(agent_setting_value "$body_file" height) || return 1
			agent_validate_int "$value" || return 1
			width=$(agent_stream_field "$stream_id" width)
			[ -n "$width" ] || width=1920
			agent_ctl rvd set-resolution "$stream_id" "$width" "$value" >/dev/null 2>&1 || return 1
			agent_config_set "$(agent_stream_section "$stream_id")" height "$value" || return 1
			agent_config_save
			agent_print_setting_update "$path" height "$value"
			;;
		streams/[01]/fps)
			stream_id=${path#streams/}
			stream_id=${stream_id%/fps}
			value=$(agent_setting_value "$body_file" fps) || return 1
			agent_validate_int "$value" || return 1
			agent_ctl rvd set-fps "$stream_id" "$value" >/dev/null 2>&1 || return 1
			agent_config_set "$(agent_stream_section "$stream_id")" fps "$value" || return 1
			agent_config_save
			agent_print_setting_update "$path" fps "$value"
			;;
		streams/[01]/bitrate)
			stream_id=${path#streams/}
			stream_id=${stream_id%/bitrate}
			value=$(agent_setting_value "$body_file" bitrate) || return 1
			agent_validate_int "$value" || return 1
			agent_ctl rvd set-bitrate "$stream_id" "$value" >/dev/null 2>&1 || return 1
			agent_config_set "$(agent_stream_section "$stream_id")" bitrate "$value" || return 1
			agent_config_save
			agent_print_setting_update "$path" bitrate "$value"
			;;
		streams/[01]/gop)
			stream_id=${path#streams/}
			stream_id=${stream_id%/gop}
			value=$(agent_setting_value "$body_file" gop) || return 1
			agent_validate_int "$value" || return 1
			agent_ctl rvd set-gop "$stream_id" "$value" >/dev/null 2>&1 || return 1
			agent_config_set "$(agent_stream_section "$stream_id")" gop "$value" || return 1
			agent_config_save
			agent_print_setting_update "$path" gop "$value"
			;;
		streams/[01]/buffers)
			stream_id=${path#streams/}
			stream_id=${stream_id%/buffers}
			value=$(agent_setting_value "$body_file" buffers) || return 1
			agent_validate_int "$value" || return 1
			# Raptor maps buffers onto encoder VBS count; takes effect after streamer restart.
			agent_config_set "$(agent_stream_section "$stream_id")" nr_vbs "$value" || return 1
			agent_config_save
			agent_print_setting_update "$path" buffers "$value"
			;;
		streams/[01]/profile)
			stream_id=${path#streams/}
			stream_id=${stream_id%/profile}
			value=$(agent_setting_value "$body_file" profile) || return 1
			profile_int=$(agent_profile_to_int "$value") || return 1
			profile_name=$(agent_profile_to_name "$profile_int")
			# Encoder profile is persisted; applies after streamer restart.
			agent_config_set "$(agent_stream_section "$stream_id")" profile "$profile_int" || return 1
			agent_config_save
			agent_print_setting_update "$path" profile "$(agent_json_string "$profile_name")"
			;;
		streams/[01]/rtsp-endpoint)
			stream_id=${path#streams/}
			stream_id=${stream_id%/rtsp-endpoint}
			value=$(agent_setting_value "$body_file" rtsp_endpoint) || return 1
			value=$(agent_unquote_string "$value")
			value=${value#/}
			[ -n "$value" ] || {
				echo "non-empty rtsp_endpoint required" >&2
				return 1
			}
			case "$stream_id" in
				0) key=endpoint_main ;;
				1) key=endpoint_sub ;;
				*)
					echo "unsupported stream id" >&2
					return 1
					;;
			esac
			agent_config_set rtsp "$key" "$value" || return 1
			agent_config_save
			agent_print_setting_update "$path" rtsp_endpoint "$(agent_json_string "$value")"
			;;
		streams/[01]/format)
			stream_id=${path#streams/}
			stream_id=${stream_id%/format}
			value=$(agent_setting_value "$body_file" format) || return 1
			value=$(agent_validate_stream_format "$value") || return 1
			codec=$(agent_format_to_codec "$value")
			agent_ctl rvd set-codec "$stream_id" "$codec" >/dev/null 2>&1 || return 1
			agent_config_set "$(agent_stream_section "$stream_id")" codec "$codec" || return 1
			agent_config_save
			agent_print_setting_update "$path" format "$(agent_json_string "$value")"
			;;
		streams/[01]/mode)
			stream_id=${path#streams/}
			stream_id=${stream_id%/mode}
			value=$(agent_setting_value "$body_file" mode) || return 1
			value=$(agent_validate_stream_mode "$value") || return 1
			rc_mode=$(agent_mode_to_rc "$value")
			bitrate=$(agent_stream_field "$stream_id" bitrate)
			[ -n "$bitrate" ] || bitrate=3000000
			agent_ctl rvd set-rc-mode "$stream_id" "$rc_mode" "$bitrate" >/dev/null 2>&1 || return 1
			agent_config_set "$(agent_stream_section "$stream_id")" rc_mode "$rc_mode" || return 1
			agent_config_save
			agent_print_setting_update "$path" mode "$(agent_json_string "$value")"
			;;
		streams/[01]/osd/*)
			agent_set_osd_setting "$path" "$body_file"
			;;
		send2/services/*/send-photo)
			rest=${path#send2/services/}
			service=${rest%/send-photo}
			agent_send2_service_supported "$service" || return 1
			agent_send2_service_has_send_photo "$service" || {
				echo "send_photo is not supported for send2 service '$service'" >&2
				return 1
			}
			value=$(agent_setting_value "$body_file" send_photo) || return 1
			agent_validate_bool "$value" || return 1
			if command -v jct >/dev/null 2>&1 && [ -f "$THINGINO_AGENT_SEND2_CONFIG" ]; then
				jct "$THINGINO_AGENT_SEND2_CONFIG" set "$service.send_photo" "$value" >/dev/null 2>&1 || {
					echo "failed to persist send2 configuration" >&2
					return 1
				}
			fi
			agent_print_setting_update "$path" send_photo "$value"
			;;
		send2/services/*/send-video)
			rest=${path#send2/services/}
			service=${rest%/send-video}
			agent_send2_service_supported "$service" || return 1
			agent_send2_service_has_send_video "$service" || {
				echo "send_video is not supported for send2 service '$service'" >&2
				return 1
			}
			value=$(agent_setting_value "$body_file" send_video) || return 1
			agent_validate_bool "$value" || return 1
			if command -v jct >/dev/null 2>&1 && [ -f "$THINGINO_AGENT_SEND2_CONFIG" ]; then
				jct "$THINGINO_AGENT_SEND2_CONFIG" set "$service.send_video" "$value" >/dev/null 2>&1 || {
					echo "failed to persist send2 configuration" >&2
					return 1
				}
			fi
			agent_print_setting_update "$path" send_video "$value"
			;;
		*)
			echo "unsupported setting path: $path" >&2
			return 1
			;;
	esac
}

agent_apply_config() {
	source_file=$1
	[ -n "$source_file" ] || {
		echo "usage: agentctl apply-config <json-file>" >&2
		return 1
	}
	[ -s "$source_file" ] || {
		echo "configuration payload is empty" >&2
		return 1
	}

	# Apply a conservative subset of canonical fields when present.
	for field in brightness contrast saturation sharpness; do
		value=$(agent_json_config_value "$source_file" "image.$field")
		[ -n "$value" ] || continue
		agent_ctl rvd "set-$field" "$value" >/dev/null 2>&1 || true
		agent_config_set image "$field" "$value" || true
	done
	for field in hflip vflip; do
		value=$(agent_json_config_value "$source_file" "image.$field")
		[ -n "$value" ] || continue
		raw=$(agent_json_bool_to_01 "$value" 2>/dev/null) || continue
		agent_ctl rvd "set-$field" "$raw" >/dev/null 2>&1 || true
		agent_config_set image "$field" "$raw" || true
	done

	value=$(agent_json_config_value "$source_file" motion.enabled)
	[ -n "$value" ] && agent_config_set motion enabled "$value"

	value=$(agent_json_config_value "$source_file" daynight.enabled)
	case "$value" in
		true)
			if agent_has_daynightd; then
				agent_daynightd_set_mode auto || true
			else
				agent_ctl ric mode auto >/dev/null 2>&1 || true
			fi
			;;
		false)
			force=$(agent_json_config_value "$source_file" daynight.force_mode | tr -d '"')
			case "$force" in
				day | night)
					if agent_has_daynightd; then
						agent_daynightd_set_mode "$force" || true
					else
						agent_ctl ric mode "$force" >/dev/null 2>&1 || true
					fi
					;;
			esac
			;;
	esac

	agent_config_save
	printf '{"status":"accepted","applied":["config"],"staged":[],"restart_required":[]}\n'
}

agent_snapshot() {
	channel=${1:-0}
	command -v raptorctl >/dev/null 2>&1 || {
		echo "snapshot is not supported on this camera" >&2
		return 1
	}
	tmp=$(mktemp /tmp/agent-snap.XXXXXX.jpg) || return 1
	if ! raptorctl rvd save jpeg "$tmp" "$channel" >/dev/null 2>&1; then
		rm -f "$tmp"
		echo "failed to capture snapshot" >&2
		return 1
	fi
	cat "$tmp"
	rm -f "$tmp"
}

agent_ensure_rmr() {
	if pidof rmr >/dev/null 2>&1; then
		return 0
	fi
	if command -v start-stop-daemon >/dev/null 2>&1; then
		start-stop-daemon -S -b -x /usr/bin/rmr -- -c "$AGENT_CONFIG" >/dev/null 2>&1 || true
	elif [ -x /usr/bin/rmr ]; then
		/usr/bin/rmr -c "$AGENT_CONFIG" >/dev/null 2>&1 &
	else
		return 1
	fi
	i=0
	while [ "$i" -lt 20 ]; do
		pidof rmr >/dev/null 2>&1 && return 0
		sleep 0.1 2>/dev/null || usleep 100000 2>/dev/null || sleep 1
		i=$((i + 1))
	done
	pidof rmr >/dev/null 2>&1
}

agent_record() {
	# Usage:
	#   record stop [channel]
	#   record continuous [channel]
	#   record [duration] [channel] [path]   # timed clip (existing)
	arg1=${1:-10}
	channel=${2:-0}
	file=${3:-/tmp/clip_$(date +%Y%m%d_%H%M%S).mp4}
	command -v raptorctl >/dev/null 2>&1 || {
		echo "record action is not supported on this camera" >&2
		return 1
	}

	case "$arg1" in
		stop)
			agent_ctl rmr disable >/dev/null 2>&1 || true
			agent_config_set recording enabled false || true
			agent_config_save
			printf '{"status":"accepted","action":"stop","stream_id":%s}\n' \
				"$(agent_json_value_or "$channel" 0)"
			return 0
			;;
		continuous)
			agent_config_set recording stream "$channel" || return 1
			agent_config_set recording enabled true || return 1
			agent_config_save
			agent_ensure_rmr || {
				echo "failed to start rmr recording daemon" >&2
				return 1
			}
			agent_ctl rmr enable >/dev/null 2>&1 || {
				echo "failed to enable continuous recording" >&2
				return 1
			}
			printf '{"status":"accepted","action":"continuous","stream_id":%s}\n' \
				"$(agent_json_value_or "$channel" 0)"
			return 0
			;;
	esac

	duration=$arg1
	# Prefer motion-clip helper; falls back to RMR timed start.
	if raptorctl test-motion "$duration" >/dev/null 2>&1; then
		printf '{"status":"accepted","result":{"path":%s}}\n' "$(agent_json_string "$file")"
		return 0
	fi
	agent_ensure_rmr || true
	raptorctl rmr start >/dev/null 2>&1 || {
		echo "record action is not supported on this camera" >&2
		return 1
	}
	(
		sleep "$duration"
		raptorctl rmr stop >/dev/null 2>&1 || true
	) >/dev/null 2>&1 &
	printf '{"status":"accepted","result":{"path":%s,"channel":%s}}\n' \
		"$(agent_json_string "$file")" \
		"$(agent_json_value_or "$channel" 0)"
}

agent_privacy() {
	state=$1
	channel=${2:-all}
	[ -n "$state" ] || {
		echo "usage: agentctl privacy <on|off> [channel]" >&2
		return 1
	}
	command -v raptorctl >/dev/null 2>&1 || {
		echo "privacy action is not supported on this camera" >&2
		return 1
	}

	# Privacy state lives in RVD (rod privacy is redirected). Capture the
	# command response — status queries do not include the privacy array.
	if [ "$channel" = "all" ]; then
		resp=$(raptorctl rod privacy "$state" 2>/dev/null) || return 1
	else
		resp=$(raptorctl rod privacy "$state" "$channel" 2>/dev/null) || return 1
	fi

	enabled=$(agent_privacy_parse_enabled "$resp" || true)
	case "$enabled" in
		true | false) ;;
		*)
			case "$state" in
				on) enabled=true ;;
				*) enabled=false ;;
			esac
			;;
	esac
	agent_privacy_write_state "$enabled"
	printf '{"status":"accepted"}\n'
}

agent_daynight() {
	mode=$(printf '%s' "$1" | tr 'A-Z' 'a-z')
	[ -n "$mode" ] || {
		echo "usage: agentctl daynight <auto|day|night>" >&2
		return 1
	}
	case "$mode" in
		auto | day | night)
			if agent_has_daynightd; then
				agent_daynightd_set_mode "$mode" || return 1
			else
				agent_ctl ric mode "$mode" >/dev/null 2>&1 || return 1
				agent_config_set ircut mode "$mode" || return 1
				agent_config_save
			fi
			printf '{"status":"accepted","mode":%s}\n' "$(agent_json_string "$mode")"
			;;
		*)
			echo "daynight mode must be auto, day, or night" >&2
			return 1
			;;
	esac
}

agent_service() {
	service_name=$(printf '%s' "$1" | tr 'A-Z' 'a-z')
	action_name=$(printf '%s' "$2" | tr 'A-Z' 'a-z')
	case "$service_name" in
		streaming)
			script=$(agent_service_script)
			;;
		*)
			echo "unsupported service: $service_name" >&2
			return 1
			;;
	esac
	[ -n "$script" ] || {
		echo "$service_name service control is not supported on this camera" >&2
		return 1
	}
	case "$action_name" in
		start | stop | restart) ;;
		*)
			echo "service action must be start, stop, or restart" >&2
			return 1
			;;
	esac
	"$script" "$action_name" >/dev/null 2>&1 || {
		echo "failed to $action_name $service_name service" >&2
		return 1
	}
	printf '{"status":"accepted","service":%s,"operation":%s}\n' \
		"$(agent_json_string "$service_name")" "$(agent_json_string "$action_name")"
}

agent_reboot() {
	(
		sleep 1
		reboot -f
	) >/dev/null 2>&1 &
	printf '{"status":"accepted","operation":"reboot"}\n'
}

agent_send2_test() {
	service=$(printf '%s' "${1:-}" | tr 'A-Z' 'a-z')
	action=$(printf '%s' "${2:-test}" | tr 'A-Z' 'a-z')
	[ -n "$service" ] || {
		echo "send2-test: service name required" >&2
		return 1
	}
	tool="/usr/sbin/send2${service}"
	[ -x "$tool" ] || {
		echo "send2-test: unsupported service '$service'" >&2
		return 1
	}
	_send2_ok=true
	case "$action" in
		test) "$tool" -S >/dev/null 2>&1 || _send2_ok=false ;;
		test-photo) "$tool" -S >/dev/null 2>&1 || _send2_ok=false ;;
		test-video) "$tool" -V >/dev/null 2>&1 || _send2_ok=false ;;
		*)
			echo "send2-test: unsupported action '$action'" >&2
			return 1
			;;
	esac
	if [ "$_send2_ok" = "false" ]; then
		printf '{"status":"error","service":%s,"action":%s,"message":"send2 test failed"}\n' \
			"$(agent_json_string "$service")" \
			"$(agent_json_string "$action")"
		return 1
	fi
	printf '{"status":"ok","service":%s,"action":%s}\n' \
		"$(agent_json_string "$service")" \
		"$(agent_json_string "$action")"
}
