#!/bin/sh
# shellcheck disable=SC2018,SC2019,SC2086  # tr a-z/A-Z on ASCII values; deliberate IFS word-splits into positional params

AGENT_CONFIG="${AGENT_CONFIG:-/etc/raptor.conf}"
THINGINO_AGENT_SEND2_CONFIG="${THINGINO_AGENT_SEND2_CONFIG:-/etc/send2.json}"
AGENT_PRIVACY_STATE="${AGENT_PRIVACY_STATE:-/run/agent/raptor-privacy}"

agent_name() {
	printf 'raptor'
}

agent_json_string_field() {
	key=$1
	json=$2
	printf '%s\n' "$json" |
		sed -n 's/.*"'"$key"'"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' |
		head -n 1
}

agent_json_number_field() {
	key=$1
	json=$2
	printf '%s\n' "$json" |
		sed -n 's/.*"'"$key"'"[[:space:]]*:[[:space:]]*\(-\{0,1\}[0-9][0-9]*\(\.[0-9][0-9]*\)\{0,1\}\).*/\1/p' |
		head -n 1
}

agent_json_bool_field() {
	key=$1
	json=$2
	value=$(printf '%s\n' "$json" |
		sed -n 's/.*"'"$key"'"[[:space:]]*:[[:space:]]*\(true\|false\).*/\1/p' |
		head -n 1)
	case "$value" in
		true | false)
			printf '%s' "$value"
			;;
		*)
			return 1
			;;
	esac
}

agent_config_get() {
	section=$1
	key=$2
	command -v raptorctl >/dev/null 2>&1 || return 0
	raptorctl config get "$section" "$key" 2>/dev/null | tr -d '\r\n"'
}

agent_config_bool() {
	value=$(agent_config_get "$1" "$2" | tr 'A-Z' 'a-z')
	case "$value" in
		1 | true | yes | on) printf 'true' ;;
		0 | false | no | off) printf 'false' ;;
		*)
			if [ -n "$3" ]; then
				printf '%s' "$3"
			else
				printf 'false'
			fi
			;;
	esac
}

agent_config_set() {
	section=$1
	key=$2
	value=$3
	command -v raptorctl >/dev/null 2>&1 || {
		echo "raptorctl is not available" >&2
		return 1
	}
	raptorctl config set "$section" "$key" "$value" >/dev/null 2>&1 || {
		echo "failed to set raptor config $section.$key" >&2
		return 1
	}
}

agent_config_save() {
	command -v raptorctl >/dev/null 2>&1 || return 0
	raptorctl config save >/dev/null 2>&1 || true
}

agent_ctl() {
	command -v raptorctl >/dev/null 2>&1 || {
		echo "raptorctl is not available" >&2
		return 1
	}
	raptorctl "$@"
}

agent_daemon_status() {
	daemon=$1
	command -v raptorctl >/dev/null 2>&1 || return 0
	raptorctl "$daemon" status 2>/dev/null || true
}

agent_streamer_running() {
	pidof rvd >/dev/null 2>&1 && printf 'true' || printf 'false'
}

agent_network_ip() {
	agent_default_ip
}

agent_network_online() {
	ip_addr=$(agent_network_ip)
	[ -n "$ip_addr" ] && printf 'true' || printf 'false'
}

agent_health_status() {
	if [ "$(agent_streamer_running)" = true ] && [ "$(agent_network_online)" = true ]; then
		printf 'ok'
	else
		printf 'degraded'
	fi
}

agent_service_script() {
	[ -f /etc/init.d/S31raptor ] && printf '/etc/init.d/S31raptor'
}

agent_streaming_controllable() {
	[ -n "$(agent_service_script)" ] && printf 'true' || printf 'false'
}

agent_has_snapshot() {
	command -v raptorctl >/dev/null 2>&1 && printf 'true' || printf 'false'
}

agent_has_clip() {
	if command -v raptorctl >/dev/null 2>&1 && { [ -x /usr/bin/rmr ] || pidof rmr >/dev/null 2>&1; }; then
		printf 'true'
	else
		printf 'false'
	fi
}

agent_has_privacy() {
	if command -v privacy >/dev/null 2>&1 || command -v raptorctl >/dev/null 2>&1; then
		printf 'true'
	else
		printf 'false'
	fi
}

agent_has_daynight() {
	if agent_has_daynightd || command -v raptorctl >/dev/null 2>&1 || [ -x /usr/bin/ric ]; then
		printf 'true'
	else
		printf 'false'
	fi
}

agent_has_ptz() {
	command -v motors >/dev/null 2>&1 && printf 'true' || printf 'false'
}

agent_stream_count() {
	printf '2'
}

agent_send2_service_supported() {
	case "$1" in
		email | ftp | gotify | gphotos | mqtt | ntfy | pushover | storage | telegram | webhook) return 0 ;;
		*)
			echo "unsupported send2 service: $1" >&2
			return 1
			;;
	esac
}

agent_send2_service_has_send_photo() {
	case "$1" in
		email | ftp | gphotos | mqtt | ntfy | pushover | storage | telegram | webhook) return 0 ;;
		*) return 1 ;;
	esac
}

agent_send2_service_has_send_video() {
	case "$1" in
		email | ftp | gphotos | mqtt | ntfy | storage | telegram | webhook) return 0 ;;
		*) return 1 ;;
	esac
}

agent_send2_raw() {
	service=$1
	field=$2
	agent_json_config_value "$THINGINO_AGENT_SEND2_CONFIG" "$service.$field"
}

agent_print_send2_capabilities() {
	printf '{'
	sep=''
	for service in email ftp gotify gphotos mqtt ntfy pushover storage telegram webhook; do
		printf '%s"%s":{"enabled":true,"send_photo":%s,"send_video":%s}' \
			"$sep" "$service" \
			"$(agent_json_bool "$(agent_send2_service_has_send_photo "$service" && printf true || printf false)")" \
			"$(agent_json_bool "$(agent_send2_service_has_send_video "$service" && printf true || printf false)")"
		sep=,
	done
	printf '}'
}

agent_print_service_capabilities() {
	streaming_service=false
	[ -n "$(agent_service_script)" ] && streaming_service=true
	printf '{"streaming":{"start":%s,"stop":%s,"restart":%s}}' \
		"$(agent_json_bool "$streaming_service")" \
		"$(agent_json_bool "$streaming_service")" \
		"$(agent_json_bool "$streaming_service")"
}

agent_firmware_upgrade_supported() {
	command -v sysupgrade >/dev/null 2>&1 && printf 'true' || printf 'false'
}

agent_firmware_pending_full() {
	[ -f /tmp/upgrade.me ] && printf 'true' || printf 'false'
}

agent_firmware_pending_partial() {
	[ -f /tmp/update.me ] && printf 'true' || printf 'false'
}

agent_firmware_boot_marked_complete() {
	if command -v fw_printenv >/dev/null 2>&1; then
		value=$(fw_printenv -n sysupgrade_complete 2>/dev/null | tr -d '\n')
		case "$value" in
			1 | true | TRUE | yes | on) printf 'true' ;;
			0 | false | FALSE | no | off) printf 'false' ;;
			'') printf 'null' ;;
			*) printf 'null' ;;
		esac
	else
		printf 'null'
	fi
}

agent_firmware_pending_action() {
	if [ "$(agent_firmware_pending_full)" = true ]; then
		printf 'full'
	elif [ "$(agent_firmware_pending_partial)" = true ]; then
		printf 'partial'
	else
		printf 'none'
	fi
}

agent_print_firmware_capabilities() {
	printf '{"upgrade":%s}' "$(agent_json_bool "$(agent_firmware_upgrade_supported)")"
}

agent_print_runtime_firmware() {
	printf '{'
	printf '"upgrade_supported":%s,' "$(agent_json_bool "$(agent_firmware_upgrade_supported)")"
	printf '"pending_full":%s,' "$(agent_json_bool "$(agent_firmware_pending_full)")"
	printf '"pending_partial":%s,' "$(agent_json_bool "$(agent_firmware_pending_partial)")"
	printf '"pending_action":%s,' "$(agent_json_string "$(agent_firmware_pending_action)")"
	printf '"boot_marked_complete":%s,' "$(agent_firmware_boot_marked_complete)"
	printf '"current_version":%s' "$(agent_json_string_or_null "$(agent_firmware_version)")"
	printf '}'
}

agent_bool01_to_json() {
	case "$(printf '%s' "$1" | tr 'A-Z' 'a-z')" in
		1 | true | yes | on) printf 'true' ;;
		0 | false | no | off) printf 'false' ;;
		*)
			if [ -n "$2" ]; then
				printf '%s' "$2"
			else
				printf 'false'
			fi
			;;
	esac
}

agent_json_bool_to_01() {
	case "$1" in
		true) printf '1' ;;
		false) printf '0' ;;
		*)
			echo "boolean value required" >&2
			return 1
			;;
	esac
}

agent_isp_json() {
	# Cache one get-isp call per adapter invocation when possible via a temp file
	# keyed by PID; callers that need multiple fields reuse it.
	_isp_cache="/tmp/agent-raptor-isp.$$"
	if [ ! -s "$_isp_cache" ]; then
		command -v raptorctl >/dev/null 2>&1 || return 0
		raptorctl rvd get-isp >"$_isp_cache" 2>/dev/null || {
			rm -f "$_isp_cache"
			return 0
		}
	fi
	cat "$_isp_cache" 2>/dev/null
}

agent_image_raw() {
	key=$1
	isp=$(agent_isp_json)
	if [ -n "$isp" ]; then
		value=$(agent_json_number_field "$key" "$isp")
		if [ -n "$value" ]; then
			printf '%s' "$value"
			return 0
		fi
		# Some ISP dumps use nested objects; fall through to config.
	fi
	agent_config_get image "$key"
}

agent_image_bool() {
	agent_bool01_to_json "$(agent_image_raw "$1")" false
}

# Map UI / prudynt-style WB mode integers onto raptor set-wb names (and back).
agent_wb_mode_to_int() {
	mode=$(printf '%s' "$1" | tr 'A-Z' 'a-z' | tr '-' '_')
	case "$mode" in
		auto | 0) printf '0' ;;
		manual | 1) printf '1' ;;
		daylight | day_light | day | 2) printf '2' ;;
		cloudy | 3) printf '3' ;;
		incandescent | 4) printf '4' ;;
		fluorescent | flourescent | 5) printf '5' ;;
		twilight | 6) printf '6' ;;
		shade | 7) printf '7' ;;
		warm_fluorescent | warm_flourescent | 8) printf '8' ;;
		custom | 9) printf '9' ;;
		*) printf '0' ;;
	esac
}

agent_wb_mode_from_int() {
	case "$1" in
		0) printf 'auto' ;;
		1) printf 'manual' ;;
		2) printf 'daylight' ;;
		3) printf 'cloudy' ;;
		4) printf 'incandescent' ;;
		5) printf 'fluorescent' ;;
		6) printf 'twilight' ;;
		7) printf 'shade' ;;
		8) printf 'warm_fluorescent' ;;
		9) printf 'custom' ;;
		*)
			# Already a name?
			printf '%s' "$(printf '%s' "$1" | tr 'A-Z' 'a-z' | tr '-' '_')"
			;;
	esac
}

agent_wb_json() {
	_wb_cache="/tmp/agent-raptor-wb.$$"
	if [ ! -s "$_wb_cache" ]; then
		command -v raptorctl >/dev/null 2>&1 || return 0
		raptorctl rvd get-wb >"$_wb_cache" 2>/dev/null || {
			rm -f "$_wb_cache"
			return 0
		}
	fi
	cat "$_wb_cache" 2>/dev/null
}

agent_wb_mode_raw() {
	# Prefer get-wb: get-isp's wb_mode can lag behind the live WB state.
	wb=$(agent_wb_json)
	if [ -n "$wb" ]; then
		mode=$(agent_json_string_field mode "$wb")
		if [ -n "$mode" ]; then
			printf '%s' "$mode"
			return 0
		fi
	fi
	isp=$(agent_isp_json)
	if [ -n "$isp" ]; then
		mode=$(agent_json_string_field wb_mode "$isp")
		if [ -n "$mode" ]; then
			printf '%s' "$mode"
			return 0
		fi
	fi
	agent_config_get image wb_mode
}

agent_wb_gain_raw() {
	# $1 = r|b — prefer live get-wb, then ISP, then persisted image.wb_{r,b}
	channel=$1
	wb=$(agent_wb_json)
	if [ -n "$wb" ]; then
		value=$(agent_json_number_field "${channel}_gain" "$wb")
		if [ -n "$value" ]; then
			printf '%s' "$value"
			return 0
		fi
	fi
	isp=$(agent_isp_json)
	if [ -n "$isp" ]; then
		value=$(agent_json_number_field "wb_$channel" "$isp")
		if [ -n "$value" ]; then
			printf '%s' "$value"
			return 0
		fi
	fi
	agent_config_get image "wb_$channel"
}

agent_profile_to_int() {
	value=$(printf '%s' "$1" | tr 'A-Z' 'a-z' | tr -d '"')
	case "$value" in
		0 | base | baseline) printf '0' ;;
		1 | main) printf '1' ;;
		2 | high) printf '2' ;;
		*)
			echo "profile must be 0/1/2 or baseline/main/high" >&2
			return 1
			;;
	esac
}

agent_profile_to_name() {
	case "$1" in
		0) printf 'baseline' ;;
		1) printf 'main' ;;
		2) printf 'high' ;;
		base | baseline) printf 'baseline' ;;
		main) printf 'main' ;;
		high) printf 'high' ;;
		*)
			agent_profile_to_int "$1" >/dev/null 2>&1 || {
				printf 'high'
				return 0
			}
			agent_profile_to_name "$(agent_profile_to_int "$1")"
			;;
	esac
}

agent_motion_enabled() {
	agent_config_bool motion enabled false
}

agent_motion_active() {
	status=$(agent_daemon_status rmd)
	state=$(agent_json_string_field state "$status")
	case "$state" in
		active | triggered | detecting)
			printf 'true'
			return 0
			;;
	esac
	if agent_json_bool_field active "$status" >/dev/null 2>&1; then
		agent_json_bool_field active "$status"
		return 0
	fi
	if agent_json_bool_field motion "$status" >/dev/null 2>&1; then
		agent_json_bool_field motion "$status"
		return 0
	fi
	printf 'false'
}

agent_daynight_mode_config() {
	if agent_has_daynightd; then
		agent_daynightd_target_mode
		return 0
	fi
	mode=$(agent_config_get ircut mode | tr 'A-Z' 'a-z')
	[ -n "$mode" ] || mode=auto
	printf '%s' "$mode"
}

agent_daynight_enabled() {
	if agent_has_daynightd; then
		agent_daynightd_enabled
		return 0
	fi
	case "$(agent_daynight_mode_config)" in
		auto) printf 'true' ;;
		*) printf 'false' ;;
	esac
}

agent_daynight_force_mode() {
	if agent_has_daynightd; then
		agent_daynightd_force_mode
		return 0
	fi
	case "$(agent_daynight_mode_config)" in
		day | night)
			agent_json_string "$(agent_daynight_mode_config)"
			;;
		*)
			printf 'null'
			;;
	esac
}

agent_daynight_running_mode() {
	if agent_has_daynightd; then
		agent_daynightd_running_mode
		return 0
	fi
	status=$(agent_daemon_status ric)
	mode=$(agent_json_string_field state "$status")
	case "$mode" in
		day | night)
			printf '%s' "$mode"
			return 0
			;;
	esac
	mode=$(agent_json_string_field mode "$status")
	case "$mode" in
		day | night)
			printf '%s' "$mode"
			return 0
			;;
	esac
	if [ -r /tmp/ircutmode.txt ]; then
		value=$(sed -n '1p' /tmp/ircutmode.txt 2>/dev/null | tr -d '\r\n ')
		case "$value" in
			0)
				printf 'night'
				return 0
				;;
			1)
				printf 'day'
				return 0
				;;
		esac
	fi
	printf 'unknown'
}

agent_daynight_target_mode() {
	if agent_has_daynightd; then
		agent_daynightd_target_mode
		return 0
	fi
	case "$(agent_daynight_mode_config)" in
		auto) printf 'auto' ;;
		day) printf 'day' ;;
		night) printf 'night' ;;
		*) printf 'auto' ;;
	esac
}

agent_privacy_parse_enabled() {
	# RVD privacy responses look like: {"status":"ok","privacy":["on","off"],...}
	# There is no privacy field on `rod status` / `rvd status`.
	json=$1
	privacy_list=$(printf '%s\n' "$json" |
		sed -n 's/.*"privacy"[[:space:]]*:[[:space:]]*\[\([^]]*\)\].*/\1/p' |
		head -n 1)
	if [ -n "$privacy_list" ]; then
		case "$privacy_list" in
			*\"on\"*)
				printf 'true'
				return 0
				;;
			*)
				printf 'false'
				return 0
				;;
		esac
	fi
	if agent_json_bool_field audio_muted "$json" >/dev/null 2>&1; then
		agent_json_bool_field audio_muted "$json"
		return 0
	fi
	return 1
}

agent_privacy_write_state() {
	enabled=$1
	mkdir -p "$(dirname "$AGENT_PRIVACY_STATE")" 2>/dev/null || true
	printf '%s\n' "$enabled" >"$AGENT_PRIVACY_STATE" 2>/dev/null || true
}

agent_privacy_enabled() {
	if [ -r "$AGENT_PRIVACY_STATE" ]; then
		value=$(sed -n '1p' "$AGENT_PRIVACY_STATE" 2>/dev/null | tr -d '\r\n')
		case "$value" in
			true | false)
				printf '%s' "$value"
				return 0
				;;
		esac
	fi

	# Optional live hint: ROD may expose a "privacy" OSD element whose visibility
	# tracks the last privacy toggle (raptorctl show/hide-element).
	elements=$(agent_ctl rod elements 2>/dev/null || true)
	if [ -n "$elements" ]; then
		printf '%s\n' "$elements" | grep -q '"name"[[:space:]]*:[[:space:]]*"privacy"' || {
			printf 'false'
			return 0
		}
		# Prefer a privacy object that includes visible:true
		if printf '%s\n' "$elements" | grep -q '"name"[[:space:]]*:[[:space:]]*"privacy"[^}]*"visible"[[:space:]]*:[[:space:]]*true\|"visible"[[:space:]]*:[[:space:]]*true[^}]*"name"[[:space:]]*:[[:space:]]*"privacy"'; then
			printf 'true'
			return 0
		fi
		if printf '%s\n' "$elements" | grep '"name"[[:space:]]*:[[:space:]]*"privacy"' | grep -q '"visible"[[:space:]]*:[[:space:]]*false'; then
			printf 'false'
			return 0
		fi
	fi

	printf 'false'
}

agent_stream_section() {
	printf 'stream%s' "$1"
}

agent_stream_enabled() {
	stream_id=$1
	if [ "$stream_id" = 0 ]; then
		printf 'true'
		return 0
	fi
	agent_config_bool "$(agent_stream_section "$stream_id")" enabled true
}

agent_stream_audio_enabled() {
	agent_config_bool audio enabled true
}

agent_stream_field() {
	stream_id=$1
	field=$2
	agent_config_get "$(agent_stream_section "$stream_id")" "$field"
}

agent_stream_format() {
	codec=$(agent_stream_field "$1" codec | tr 'a-z' 'A-Z')
	case "$codec" in
		H264 | H265) printf '%s' "$codec" ;;
		*) printf '%s' "$codec" ;;
	esac
}

agent_stream_mode() {
	mode=$(agent_stream_field "$1" rc_mode | tr 'a-z' 'A-Z')
	case "$mode" in
		CBR | VBR | FIXQP | CAPPED_VBR | CAPPED_QUALITY | SMART) printf '%s' "$mode" ;;
		CAPPED) printf 'CAPPED_VBR' ;;
		*) printf '%s' "$mode" ;;
	esac
}

agent_rtsp_port() {
	port=$(agent_config_get rtsp port)
	if [ -n "$port" ]; then
		printf '%s' "$port"
		return 0
	fi
	case "$(agent_config_bool rtsp tls false)" in
		true) printf '322' ;;
		*) printf '554' ;;
	esac
}

agent_rtsp_scheme() {
	case "$(agent_config_bool rtsp tls false)" in
		true) printf 'rtsps' ;;
		*) printf 'rtsp' ;;
	esac
}

agent_rtsp_endpoint() {
	stream_id=$1
	case "$stream_id" in
		0)
			key=endpoint_main
			def=ch0
			;;
		1)
			key=endpoint_sub
			def=ch1
			;;
		*)
			printf ''
			return 0
			;;
	esac
	ep=$(agent_config_get rtsp "$key")
	[ -n "$ep" ] || ep=$def
	printf '%s' "${ep#/}"
}

agent_stream_rtsp_url() {
	stream_id=$1
	ip_addr=$(agent_network_ip)
	[ -n "$ip_addr" ] || return 0
	endpoint=$(agent_rtsp_endpoint "$stream_id")
	[ -n "$endpoint" ] || return 0
	printf '%s://%s:%s/%s' \
		"$(agent_rtsp_scheme)" \
		"$ip_addr" \
		"$(agent_rtsp_port)" \
		"$endpoint"
}

agent_rtsp_listening() {
	port=$(agent_rtsp_port)
	if command -v netstat >/dev/null 2>&1; then
		netstat -lnt 2>/dev/null | grep -q ":${port} " && printf 'true' && return 0
	fi
	if command -v ss >/dev/null 2>&1; then
		ss -lnt 2>/dev/null | grep -q ":${port} " && printf 'true' && return 0
	fi
	pidof rsd >/dev/null 2>&1 && printf 'true' || printf 'false'
}

agent_recording_active() {
	status=$(agent_daemon_status rmr)
	if agent_json_bool_field recording "$status" >/dev/null 2>&1; then
		agent_json_bool_field recording "$status"
		return 0
	fi
	printf 'false'
}

agent_record_channel() {
	value=$(agent_config_get recording stream)
	case "$value" in
		'' | *[!0-9]*) printf '0' ;;
		*) printf '%s' "$value" ;;
	esac
}

agent_stream_recording_active() {
	stream_id=$1
	if [ "$(agent_recording_active)" != true ]; then
		printf 'false'
		return 0
	fi
	[ "$(agent_record_channel)" = "$stream_id" ] && printf 'true' || printf 'false'
}

agent_stream_healthy() {
	stream_id=$1
	if [ "$(agent_streamer_running)" != true ]; then
		printf 'false'
		return 0
	fi
	if [ "$(agent_stream_enabled "$stream_id")" != true ]; then
		printf 'false'
		return 0
	fi
	printf 'true'
}

agent_storage_path() {
	path=$(agent_config_get recording storage_path)
	[ -n "$path" ] || path=/mnt/mmcblk0p1/raptor
	printf '%s' "$path"
}

agent_storage_mount() {
	path=$(agent_storage_path)
	case "$path" in
		/mnt/*)
			printf '%s' "$path" | awk -F/ '{print "/" $2 "/" $3}'
			;;
		*)
			printf '%s' "$path"
			;;
	esac
}

agent_storage_is_mounted() {
	mount_point=$(agent_storage_mount)
	[ -n "$mount_point" ] || {
		printf 'false'
		return 0
	}
	if mount 2>/dev/null | grep -q " on ${mount_point} "; then
		printf 'true'
	elif [ -d "$mount_point" ]; then
		printf 'true'
	else
		printf 'false'
	fi
}

agent_print_runtime_storage() {
	mount_point=$(agent_storage_mount)
	record_root=$(agent_storage_path)
	mounted=$(agent_storage_is_mounted)
	writable=false
	[ "$mounted" = true ] && [ -w "$mount_point" ] && writable=true
	total_kib=null
	used_kib=null
	available_kib=null
	filesystem=
	if [ "$mounted" = true ] && [ -n "$mount_point" ]; then
		df_line=$(df -k "$mount_point" 2>/dev/null | awk 'NR == 2 { print }')
		if [ -n "$df_line" ]; then
			filesystem=$(printf '%s' "$df_line" | awk '{ print $1 }')
			total_kib=$(printf '%s' "$df_line" | awk '{ print $2 }')
			used_kib=$(printf '%s' "$df_line" | awk '{ print $3 }')
			available_kib=$(printf '%s' "$df_line" | awk '{ print $4 }')
		fi
	fi
	printf '{'
	printf '"configured_mount":%s,' "$(agent_json_string_or_null "$mount_point")"
	printf '"mounted":%s,' "$(agent_json_bool "$mounted")"
	printf '"filesystem":%s,' "$(agent_json_string_or_null "$filesystem")"
