			;;
		storage/channel)
			agent_print_setting_leaf channel "$(agent_json_value_or "$(agent_config_get recording stream)" null)"
			;;
		storage/device-path)
			printf '{"device_path":%s}\n' "$(agent_json_string_or_null "$(agent_storage_path)")"
			;;
		storage/duration)
			agent_print_setting_leaf duration "$(agent_json_value_or "$(agent_config_get recording clip_length_sec)" null)"
			;;
		storage/filename)
			printf '{"filename":null}\n'
			;;
		storage/mount)
			printf '{"mount":%s}\n' "$(agent_json_string_or_null "$(agent_storage_mount)")"
			;;
		*)
			echo "unsupported setting path: $path" >&2
			return 1
			;;
	esac
}

agent_set_storage_setting() {
	path=$1
	body_file=$2
	case "$path" in
		storage/autostart)
			value=$(agent_setting_value "$body_file" autostart) || return 1
			agent_validate_bool "$value" || return 1
			agent_config_set recording enabled "$value" || return 1
			agent_config_save
			if [ "$value" = true ]; then
				agent_ctl rmr enable >/dev/null 2>&1 || true
			else
				agent_ctl rmr disable >/dev/null 2>&1 || true
			fi
			agent_print_setting_update "$path" autostart "$value"
			;;
		storage/channel)
			value=$(agent_setting_value "$body_file" channel) || return 1
			agent_validate_int "$value" || return 1
			agent_config_set recording stream "$value" || return 1
			agent_config_save
			agent_print_setting_update "$path" channel "$value"
			;;
		storage/duration)
			value=$(agent_setting_value "$body_file" duration) || return 1
			agent_validate_int "$value" || return 1
			agent_config_set recording clip_length_sec "$value" || return 1
			agent_config_save
			agent_print_setting_update "$path" duration "$value"
			;;
		storage/device-path)
			value=$(agent_setting_value "$body_file" device_path) || return 1
			value=$(agent_unquote_string "$value")
			[ -n "$value" ] || {
				echo "non-empty string required" >&2
				return 1
			}
			agent_config_set recording storage_path "$value" || return 1
			agent_config_save
			agent_print_setting_update "$path" device_path "$(agent_json_string "$value")"
			;;
		storage/mount)
			value=$(agent_setting_value "$body_file" mount) || return 1
			value=$(agent_unquote_string "$value")
			[ -n "$value" ] || {
				echo "non-empty string required" >&2
				return 1
			}
			agent_config_set recording storage_path "$value" || return 1
			agent_config_save
			agent_print_setting_update "$path" mount "$(agent_json_string "$value")"
			;;
		storage/filename)
			echo "storage.filename is not supported by the raptor backend" >&2
			return 1
			;;
		*)
			echo "unsupported setting path: $path" >&2
			return 1
			;;
	esac
}

