agent_setting_value() {
	body_file=$1
	field=$2
	value=$(agent_json_config_value "$body_file" "$field")
	[ -n "$value" ] || {
		echo "missing field '$field'" >&2
		return 1
	}
	printf '%s' "$value"
}

agent_validate_bool() {
	case "$1" in
		true | false) return 0 ;;
		*)
			echo "boolean value required" >&2
			return 1
			;;
	esac
}

agent_validate_int() {
	case "$1" in
		'' | *[!0-9-]*)
			echo "integer value required" >&2
			return 1
			;;
		*) return 0 ;;
	esac
}

agent_unquote_string() {
	printf '%s' "$1" | tr -d '"'
}

agent_validate_stream_format() {
	value=$(agent_unquote_string "$1" | tr 'a-z' 'A-Z')
	case "$value" in
		H264 | H265)
			printf '%s' "$value"
			return 0
			;;
		*)
			echo "stream format must be H264 or H265" >&2
			return 1
			;;
	esac
}

agent_validate_stream_mode() {
	value=$(agent_unquote_string "$1" | tr 'a-z' 'A-Z')
	case "$value" in
		CBR | VBR | SMART | FIXQP | CAPPED_VBR | CAPPED_QUALITY)
			printf '%s' "$value"
			return 0
			;;
		*)
			echo "stream mode must be CBR, VBR, SMART, FIXQP, CAPPED_VBR, or CAPPED_QUALITY" >&2
			return 1
			;;
	esac
}

agent_mode_to_rc() {
	printf '%s' "$1" | tr 'A-Z' 'a-z'
}

agent_format_to_codec() {
	printf '%s' "$1" | tr 'A-Z' 'a-z'
}

agent_send2_motion_key() {
	printf 'motion.send2%s' "$1"
}

agent_send2_motion_enabled() {
	service=$1
	key=$(agent_send2_motion_key "$service")
	agent_json_value_or "$(agent_json_config_value "$THINGINO_CONFIG_FILE" "$key")" false
}

agent_send2_motion_set() {
	service=$1
	value=$2
	key=$(agent_send2_motion_key "$service")
	command -v jct >/dev/null 2>&1 || {
		echo "jct is not available" >&2
		return 1
	}
	[ -f "$THINGINO_CONFIG_FILE" ] || {
		echo "missing $THINGINO_CONFIG_FILE" >&2
		return 1
	}
	jct "$THINGINO_CONFIG_FILE" set "$key" "$value" >/dev/null 2>&1 || {
		echo "failed to persist motion send2 flag" >&2
		return 1
	}
}

# Map canonical OSD leaf paths onto raptor's global [osd] / [osd.<element>] model.
# Raptor OSD is mostly global; streamN only owns osd_enabled. Stream-scoped agent
# paths still work — both streams read/write the same global element config.
agent_osd_element_name() {
	case "$1" in
		time) printf 'timestamp' ;;
		uptime) printf 'uptime' ;;
		usertext) printf 'camera' ;;
		logo) printf 'logo' ;;
		privacy) printf 'privacy' ;;
		*) return 1 ;;
	esac
}

agent_osd_spec() {
	# relative|config_section|config_key|response_key|value_type|runtime_hint
	case "$1" in
		enabled) printf 'stream|osd_enabled|enabled|bool|stream\n' ;;
		font-path) printf 'osd|font|font_path|text|global\n' ;;
		font-size) printf 'osd|font_size|font_size|int|font_size\n' ;;
		stroke-size) printf 'osd|font_stroke|stroke_size|int|stroke_size\n' ;;
		time/enabled) printf 'osd.timestamp|visible|enabled|bool|element:timestamp\n' ;;
		time/format) printf 'osd|time_format|format|text|time_format\n' ;;
		time/position) printf 'osd.timestamp|position|position|text|element:timestamp\n' ;;
		time/fill-color) printf 'osd|font_color|fill_color|text|font_color\n' ;;
		time/stroke-color) printf 'osd|stroke_color|stroke_color|text|stroke_color\n' ;;
		uptime/enabled) printf 'osd.uptime|visible|enabled|bool|element:uptime\n' ;;
		uptime/format) printf 'osd.uptime|template|format|text|element:uptime\n' ;;
		uptime/position) printf 'osd.uptime|position|position|text|element:uptime\n' ;;
		uptime/fill-color) printf 'osd|font_color|fill_color|text|font_color\n' ;;
		uptime/stroke-color) printf 'osd|stroke_color|stroke_color|text|stroke_color\n' ;;
		usertext/enabled) printf 'osd.camera|visible|enabled|bool|element:camera\n' ;;
		usertext/format) printf 'osd.camera|template|format|text|element:camera\n' ;;
		usertext/position) printf 'osd.camera|position|position|text|element:camera\n' ;;
		usertext/fill-color) printf 'osd|font_color|fill_color|text|font_color\n' ;;
		usertext/stroke-color) printf 'osd|stroke_color|stroke_color|text|stroke_color\n' ;;
		logo/enabled) printf 'osd.logo|visible|enabled|bool|element:logo\n' ;;
		logo/path) printf 'osd.logo|path|path|text|element:logo\n' ;;
		logo/position) printf 'osd.logo|position|position|text|element:logo\n' ;;
		logo/width) printf 'osd.logo|width|width|int|element:logo\n' ;;
		logo/height) printf 'osd.logo|height|height|int|element:logo\n' ;;
		privacy/enabled) printf 'osd.privacy|visible|enabled|bool|element:privacy\n' ;;
		privacy/text) printf 'osd.privacy|template|text|text|element:privacy\n' ;;
		privacy/position) printf 'osd.privacy|position|position|text|element:privacy\n' ;;
		privacy/font-size) printf 'osd.privacy|font_size|font_size|int|element:privacy\n' ;;
		privacy/fill-color) printf 'osd|font_color|fill_color|text|font_color\n' ;;
		privacy/stroke-color) printf 'osd|stroke_color|stroke_color|text|stroke_color\n' ;;
		*) return 1 ;;
	esac
}

agent_parse_osd_path() {
	path=$1
	stream_id=${path#streams/}
	stream_id=${stream_id%%/*}
	# shellcheck disable=SC2295  # stream_id is numeric, never a glob pattern
	relative=${path#streams/$stream_id/osd/}
	[ -n "$stream_id" ] && [ "$relative" != "$path" ] || return 1
	case "$stream_id" in
		0 | 1) ;;
		*) return 1 ;;
	esac
	spec=$(agent_osd_spec "$relative") || return 1
	printf '%s|%s|%s\n' "$stream_id" "$relative" "$spec"
}

agent_osd_color_to_raptor() {
	# WebUI / prudynt colors are #RRGGBBAA. Raptor ROD wants 0xAARRGGBB.
	value=$(agent_unquote_string "$1")
	case "$value" in
		0x* | 0X*)
			printf '%s' "$value"
			;;
		\#????????)
			hex=$(printf '%s' "$value" | tr -d '#' | tr 'a-f' 'A-F')
			rgb=$(printf '%s' "$hex" | cut -c1-6)
			aa=$(printf '%s' "$hex" | cut -c7-8)
			printf '0x%s%s' "$aa" "$rgb"
			;;
		\#??????)
			printf '0xFF%s' "$(printf '%s' "$value" | tr -d '#' | tr 'a-f' 'A-F')"
			;;
		*)
			printf '%s' "$value"
			;;
	esac
}

agent_osd_color_to_ui() {
	# 0xAARRGGBB / #AARRGGBB -> #RRGGBBAA for preview.js rgba2color().
	value=$(agent_unquote_string "$1")
	hex=$(printf '%s' "$value" | sed 's/^0[xX]//;s/^#//' | tr 'a-f' 'A-F')
	case "$hex" in
		????????)
			aa=$(printf '%s' "$hex" | cut -c1-2)
			rgb=$(printf '%s' "$hex" | cut -c3-8)
			printf '#%s%s' "$rgb" "$aa"
			;;
		*)
			printf '%s' "$value"
			;;
	esac
}

agent_osd_apply_runtime() {
	hint=$1
	key=$2
	value=$3
	case "$hint" in
		stream) ;;
		global) ;;
		font_size)
			agent_ctl rod set-font-size "$value" >/dev/null 2>&1 || true
			;;
		stroke_size)
			agent_ctl rod set-stroke-size "$value" >/dev/null 2>&1 || true
			;;
		font_color)
			agent_ctl rod set-font-color "$value" >/dev/null 2>&1 || true
			;;
		stroke_color)
			agent_ctl rod set-stroke-color "$value" >/dev/null 2>&1 || true
			;;
		time_format)
			agent_ctl rod set-time-format "$value" >/dev/null 2>&1 || true
			;;
		element:*)
			elem=${hint#element:}
			case "$key" in
				visible)
					case "$value" in
						true | 1 | on) agent_ctl rod show-element "$elem" >/dev/null 2>&1 || true ;;
						*) agent_ctl rod hide-element "$elem" >/dev/null 2>&1 || true ;;
					esac
					;;
				position)
					agent_ctl rod set-position "$elem" "$value" >/dev/null 2>&1 || true
					;;
				template | path | width | height | font_size)
					agent_ctl rod set-element "$elem" "$key=$value" >/dev/null 2>&1 || true
					;;
			esac
			;;
	esac
}

agent_print_osd_setting() {
	path=$1
	parsed=$(agent_parse_osd_path "$path") || {
		echo "unsupported setting path: $path" >&2
		return 1
	}
	OLDIFS=$IFS
	IFS='|'
	set -- $parsed
	IFS=$OLDIFS
	stream_id=$1
	section=$3
	config_key=$4
	response_key=$5
	value_type=$6

	if [ "$section" = stream ]; then
		raw=$(agent_config_bool "$(agent_stream_section "$stream_id")" osd_enabled true)
		agent_print_setting_leaf "$response_key" "$raw"
		return 0
	fi

	raw=$(agent_config_get "$section" "$config_key")
	case "$value_type" in
		bool)
			agent_print_setting_leaf "$response_key" "$(agent_bool01_to_json "$raw" false)"
			;;
		int)
			agent_print_setting_leaf "$response_key" "$(agent_json_value_or "$raw" null)"
			;;
		text)
			case "$response_key" in
				fill_color | stroke_color)
					if [ -n "$raw" ]; then
						raw=$(agent_osd_color_to_ui "$raw")
					fi
					;;
			esac
			printf '{"%s":%s}\n' "$response_key" "$(agent_json_string_or_null "$raw")"
			;;
		*)
			echo "unsupported OSD value type: $value_type" >&2
			return 1
			;;
	esac
}

agent_set_osd_setting() {
	path=$1
	body_file=$2
	parsed=$(agent_parse_osd_path "$path") || {
		echo "unsupported setting path: $path" >&2
		return 1
	}
	OLDIFS=$IFS
	IFS='|'
	set -- $parsed
	IFS=$OLDIFS
	stream_id=$1
	section=$3
	config_key=$4
	response_key=$5
	value_type=$6
	runtime_hint=$7

	raw_value=$(agent_setting_value "$body_file" "$response_key") || return 1
	case "$value_type" in
		bool)
			agent_validate_bool "$raw_value" || return 1
			json_value=$raw_value
			persist_value=$raw_value
			;;
		int)
			agent_validate_int "$raw_value" || return 1
			json_value=$raw_value
			persist_value=$raw_value
			;;
		text)
			text_value=$(agent_unquote_string "$raw_value")
			case "$response_key" in
				fill_color | stroke_color)
					persist_value=$(agent_osd_color_to_raptor "$text_value")
					;;
				*)
					persist_value=$text_value
					;;
			esac
			json_value=$(agent_json_string "$persist_value")
			;;
		*)
			echo "unsupported OSD value type: $value_type" >&2
			return 1
			;;
	esac

	if [ "$section" = stream ]; then
		agent_config_set "$(agent_stream_section "$stream_id")" osd_enabled "$persist_value" || return 1
		agent_config_save
		agent_print_setting_update "$path" "$response_key" "$json_value"
		return 0
	fi

	agent_config_set "$section" "$config_key" "$persist_value" || return 1
	agent_config_save
	agent_osd_apply_runtime "$runtime_hint" "$config_key" "$persist_value"
	agent_print_setting_update "$path" "$response_key" "$json_value"
}

agent_print_storage_setting() {
	path=$1
	case "$path" in
		storage/autostart)
