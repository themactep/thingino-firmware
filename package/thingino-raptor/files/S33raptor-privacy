#!/bin/sh

enabled() {
	[ "$(jct /etc/thingino.json get privacy.on_boot 2>/dev/null)" = "true" ]
}

# rvd takes a few seconds to accept commands after S31raptor returns.
engage() {
	i=0
	while [ "$i" -lt 30 ]; do
		agentctl privacy on >/dev/null 2>&1 && return 0
		sleep 1
		i=$((i + 1))
	done
	echo "raptor-privacy: rvd did not accept privacy on" | logger -t raptor-privacy
}

case "$1" in
	start)
		enabled || exit 0
		echo "Engaging privacy mode..."
		engage &
		;;
	stop | restart) ;;
	*)
		echo "Usage: $0 {start|stop|restart}" >&2
		exit 1
		;;
esac

exit 0
