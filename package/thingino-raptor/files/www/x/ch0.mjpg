#!/bin/sh
# shellcheck disable=SC1091
# MJPEG preview for channel 0 -- proxy raptor's native MJPEG (rhd) on the
# loopback. A persistent rhd reader keeps the on-demand JPEG encoder warm,
# so frames arrive at the configured jpeg_fps instead of cold-starting the
# encoder for every frame.

. /var/www/x/auth.sh
require_auth

CHANNEL=0
BOUNDARY="raptorframe"

if ! pidof rhd >/dev/null 2>&1; then
	printf 'Status: 503 Service Unavailable\r\n\r\n'
	exit 0
fi

cfg() {
	raptorctl config get http "$1" 2>/dev/null | tr -d ' \t\r\n'
}

port="$(cfg port)"
[ -n "$port" ] || port=8443
user="$(cfg username)"
pass="$(cfg password)"

scheme="https"
[ "$(cfg https)" = "false" ] && scheme="http"

printf 'Content-Type: multipart/x-mixed-replace; boundary=%s\r\n\r\n' "$BOUNDARY"

if [ -n "$user" ] || [ -n "$pass" ]; then
	exec curl -skN -u "$user:$pass" "$scheme://127.0.0.1:$port/mjpeg?stream=$CHANNEL"
else
	exec curl -skN "$scheme://127.0.0.1:$port/mjpeg?stream=$CHANNEL"
fi
