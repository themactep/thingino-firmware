#!/bin/sh
# shellcheck disable=SC1091
# Snapshot download for channel 1 via raptorctl.

. /var/www/x/auth.sh
require_auth

tmp=$(mktemp /tmp/raptor-snap.XXXXXX) || exit 1
trap 'rm -f "$tmp"' EXIT INT TERM

if ! command -v raptorctl >/dev/null 2>&1; then
	printf 'Status: 503 Service Unavailable\r\n\r\n'
	exit 0
fi

# rvd numbers JPEG channels over the streams that have one: with the main's
# JPEG off, the sub's is channel 0 and there is no channel 1. Serve channel 0
# then, so "Ch1" snapshots whatever JPEG there is instead of failing.
channel=1
[ -e /dev/shm/rss_ring_jpeg1 ] || channel=0

if ! raptorctl rvd save jpeg "$tmp" "$channel" >/dev/null 2>&1 || [ ! -s "$tmp" ]; then
	printf 'Status: 503 Service Unavailable\r\n\r\n'
	exit 0
fi

printf 'Content-Type: image/jpeg\r\n'
printf 'Content-Disposition: attachment; filename=ch1-%s.jpg\r\n' "$(date +%s)"
printf 'Cache-Control: no-store\r\n'
printf 'Connection: close\r\n'
printf '\r\n'
cat "$tmp"
