#!/bin/sh

DAEMON="/usr/bin/thingino-button"
# -s: syslog, stay in the foreground. start-stop-daemon -b -m backgrounds
# the process and records its real pid; -d would fork again and leave a
# stale pre-fork pid in the pidfile, so stop/restart could not find it.
DAEMON_ARGS="-s"

PIDFILE="/run/thingino-button.pid"

start_daemon() {
	start-stop-daemon -S -b -m -p "$PIDFILE" -x "$DAEMON" -- $@
}

stop_daemon() {
	status=1
	if [ -f "$PIDFILE" ]; then
		start-stop-daemon -K -p "$PIDFILE" -x "$DAEMON" && status=0
		rm -f "$PIDFILE"
	fi

	# Also stop instances the pidfile does not cover (started with -d by
	# an older script, or started by hand); only processes of $DAEMON
	# match -x.
	start-stop-daemon -K -x "$DAEMON" >/dev/null 2>&1 && status=0

	i=0
	while pidof thingino-button >/dev/null && [ $i -lt 20 ]; do
		sleep 0.1
		i=$((i + 1))
	done

	return $status
}

start() {
	echo -c 15 "Starting Button service"

	# shellcheck disable=SC2086
	start_daemon $DAEMON_ARGS
}

stop() {
	echo -c 15 "Stopping Button service"

	stop_daemon
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart | reload)
		stop || true
		start
		;;
	*)
		echo "Usage: $0 {start|stop|restart|reload}"
		exit 1
		;;
esac

exit 0
