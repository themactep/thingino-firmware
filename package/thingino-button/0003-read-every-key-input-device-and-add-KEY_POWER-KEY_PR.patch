 	}
@@ -561,9 +539,11 @@ int main(int argc, char *argv[]) {
 		log_message("Input device opened successfully.\n");
 	}
 
-	process_events(fd);
+	process_events(fds, nfds);
 
-	close(fd);
+	for (int i = 0; i < nfds; i++) {
+		close(fds[i]);
+	}
 
 	if (silent_mode || daemon_mode) {
 		closelog();
