+	if (ndev == 0) {
+		copy_string(devices[0], sizeof(devices[0]), input_device);
+		ndev = 1;
+	}
 
 	// Register signal handlers
 	signal(SIGTERM, handle_signal);
 
-	int fd = -1;
-	int retries = 0;
-	while (fd < 0 && retries < 30) {
-		fd = open(input_device, O_RDONLY | O_NONBLOCK);
+	int fds[MAX_DEVICES];
+	int nfds = 0;
+	for (int i = 0; i < ndev; i++) {
