+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(7, 3, 0))
+static int cfg80211_rtw_add_key_7_3(struct wiphy *wiphy, struct wireless_dev *wdev,
+	int link_id, u8 key_index, bool pairwise, const u8 *mac_addr, struct key_params *params)
+{ return cfg80211_rtw_add_key(wiphy, wdev->netdev, link_id, key_index, pairwise, mac_addr, params); }
+
+static int cfg80211_rtw_get_key_7_3(struct wiphy *wiphy, struct wireless_dev *wdev,
+	int link_id, u8 keyid, bool pairwise, const u8 *mac_addr, void *cookie,
+	void (*callback)(void *cookie, struct key_params *))
+{ return cfg80211_rtw_get_key(wiphy, wdev->netdev, link_id, keyid, pairwise, mac_addr, cookie, callback); }
+
+static int cfg80211_rtw_del_key_7_3(struct wiphy *wiphy, struct wireless_dev *wdev,
+	int link_id, u8 key_index, bool pairwise, const u8 *mac_addr)
+{ return cfg80211_rtw_del_key(wiphy, wdev->netdev, link_id, key_index, pairwise, mac_addr); }
+
+static int cfg80211_rtw_set_default_mgmt_key_7_3(struct wiphy *wiphy,
+	struct wireless_dev *wdev, int link_id, u8 key_index)
+{ return cfg80211_rtw_set_default_mgmt_key(wiphy, wdev->netdev, link_id, key_index); }
+
+static int cfg80211_rtw_set_wiphy_params_7_3(struct wiphy *wiphy, int radio_idx, u32 changed)
+{ (void)radio_idx; return cfg80211_rtw_set_wiphy_params(wiphy, changed); }
+
+static int cfg80211_rtw_set_txpower_7_3(struct wiphy *wiphy, struct wireless_dev *wdev,
+	int radio_idx, enum nl80211_tx_power_setting type, int mbm)
+{ (void)radio_idx; return cfg80211_rtw_set_txpower(wiphy, wdev, type, mbm); }
+
+static int cfg80211_rtw_get_txpower_7_3(struct wiphy *wiphy, struct wireless_dev *wdev,
+	int radio_idx, unsigned int link_id, int *dbm)
+{ (void)radio_idx; (void)link_id; return cfg80211_rtw_get_txpower(wiphy, wdev, dbm); }
+
+static int cfg80211_rtw_get_station_7_3(struct wiphy *wiphy, struct wireless_dev *wdev,
+	const u8 *mac, struct station_info *sinfo)
+{ return cfg80211_rtw_get_station(wiphy, wdev->netdev, mac, sinfo); }
+
+static int cfg80211_rtw_add_station_7_3(struct wiphy *wiphy, struct wireless_dev *wdev,
+	const u8 *mac, struct station_parameters *params)
+{ return cfg80211_rtw_add_station(wiphy, wdev->netdev, mac, params); }
+
+static int cfg80211_rtw_del_station_7_3(struct wiphy *wiphy, struct wireless_dev *wdev,
+	struct station_del_parameters *params)
+{ return cfg80211_rtw_del_station(wiphy, wdev->netdev, params); }
+
+static int cfg80211_rtw_change_station_7_3(struct wiphy *wiphy, struct wireless_dev *wdev,
+	const u8 *mac, struct station_parameters *params)
+{ return cfg80211_rtw_change_station(wiphy, wdev->netdev, mac, params); }
+
+static int cfg80211_rtw_dump_station_7_3(struct wiphy *wiphy, struct wireless_dev *wdev,
+	int idx, u8 *mac, struct station_info *sinfo)
+{ return cfg80211_rtw_dump_station(wiphy, wdev->netdev, idx, mac, sinfo); }
+
+static int cfg80211_rtw_set_monitor_channel_7_3(struct wiphy *wiphy,
+	struct net_device *dev, struct cfg80211_chan_def *chandef)
+{ (void)dev; return cfg80211_rtw_set_monitor_channel(wiphy, chandef); }
+
+static s32 cfg80211_rtw_remain_on_channel_7_3(struct wiphy *wiphy, struct wireless_dev *wdev,
+	struct ieee80211_channel *channel, unsigned int duration, u64 cookie, const u8 *rx_addr)
+{ u64 c = cookie; (void)rx_addr; return cfg80211_rtw_remain_on_channel(wiphy, wdev, channel, duration, &c); }
+
+static int cfg80211_rtw_mgmt_tx_7_3(struct wiphy *wiphy, struct wireless_dev *wdev,
+	struct cfg80211_mgmt_tx_params *params, u64 cookie)
+{ u64 c = cookie; return cfg80211_rtw_mgmt_tx(wiphy, wdev, params, &c); }
