WIFI_ZT9101_SITE_METHOD = git
WIFI_ZT9101_SITE = https://github.com/yjun123/ZT9101_vendor_linux_driver
WIFI_ZT9101_SITE_BRANCH = main
WIFI_ZT9101_VERSION = cfd413b25aa5e21b61164c7774056799425e7d1d

WIFI_ZT9101_LICENSE = GPL-2.0
WIFI_ZT9101_LICENSE_FILES = LICENSE

WIFI_ZT9101_MODULE_SUBDIRS = ZT9101_android_V1.2.1800.20241115
WIFI_ZT9101_MODULE_MAKE_OPTS = \
	HOST_PLAT=t31 \
	WDRV_DIR=$(@D)/ZT9101_android_V1.2.1800.20241115

ZT9101_MODULE_NAME = zt9101_ztopmac_usb
ZT9101_MODULE_OPTS = cfg=/usr/share/wifi/zt9101-wifi.cfg

define WIFI_ZT9101_LINUX_CONFIG_FIXUPS
	$(call KCONFIG_ENABLE_OPT,CONFIG_WLAN)
	$(call KCONFIG_ENABLE_OPT,CONFIG_WIRELESS)
	$(call KCONFIG_ENABLE_OPT,CONFIG_WIRELESS_EXT)
	$(call KCONFIG_ENABLE_OPT,CONFIG_WEXT_CORE)
	$(call KCONFIG_ENABLE_OPT,CONFIG_WEXT_PROC)
	$(call KCONFIG_ENABLE_OPT,CONFIG_WEXT_PRIV)
	$(call KCONFIG_SET_OPT,CONFIG_CFG80211,y)
endef

define WIFI_ZT9101_INSTALL_FIRMWARE
	$(INSTALL) -D -m 0644 $(@D)/ZT9101_android_V1.2.1800.20241115/fw/ZT9101_fw_c1ab8ba.bin \
		$(TARGET_DIR)/usr/lib/firmware/zt9101/ZT9101_fw_c1ab8ba.bin
	$(INSTALL) -D -m 0644 $(@D)/ZT9101_android_V1.2.1800.20241115/fw/ZT9101V30_fw_8546b3a.bin \
		$(TARGET_DIR)/usr/lib/firmware/zt9101/ZT9101V30_fw_8546b3a.bin
	$(INSTALL) -D -m 0644 $(WIFI_ZT9101_PKGDIR)/files/zt9101-wifi.cfg \
		$(TARGET_DIR)/usr/share/wifi/zt9101-wifi.cfg
endef

WIFI_ZT9101_POST_INSTALL_TARGET_HOOKS += WIFI_ZT9101_INSTALL_FIRMWARE

$(eval $(kernel-module))
$(eval $(generic-package))
