From: Lu-Fi <noreply@github.com>
Subject: [PATCH] t20: keep room for the 7.x vb2_v4l2_buffer in the frame channel

Since 4.4 the vb2 v4l2 layer treats every queued buffer as a struct
vb2_v4l2_buffer and stores flags, field, timecode, sequence and planes[]
right behind the embedded struct vb2_buffer. The T20 frame channel buffer
still starts with a bare struct vb2_buffer, so on 7.x every QBUF wrote
the v4l2 flags and field into buf.entry, the core FIFO list head.

That went unnoticed while buf_queue linked the entry unconditionally. The
openimp #467 "never link twice" check (tx_isp_t2x_entry_linked) reads
the entry instead: flags != 0 looks like a linked list head, so no buffer
ever reached the core FIFO. The ISP ran, no frame was written, and the
streamer's DQBUF failed with EINVAL right after "framesource enabled"
(no video, snapshot 503) on the Wyze Cam v2 (T20X, kernel 7.3.3).

Overlay the vb2_buffer with a vb2_v4l2_buffer on >= 4.4 so the driver's
own fields start behind it. The 3.10 layout is unchanged.

Signed-off-by: Lu-Fi <lutz@fiebach.de>

--- a/external/ingenic-sdk/3.10.14/isp/t20/tx-isp-frame-channel.h
+++ b/external/ingenic-sdk/3.10.14/isp/t20/tx-isp-frame-channel.h
@@ -5,6 +5,10 @@
 #include <media/v4l2-device.h>
 #include <media/v4l2-ioctl.h>
 #include <media/videobuf2-core.h>
+#include <linux/version.h>
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(4, 4, 0)
+#include <media/videobuf2-v4l2.h>
+#endif
 
 #include <tx-isp-common.h>
 
@@ -47,7 +51,22 @@
 };
 
 struct frame_channel_video_buffer{
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(4, 4, 0)
+	/*
+	 * Since 4.4 the vb2 v4l2 layer treats every buffer as a struct
+	 * vb2_v4l2_buffer (to_vb2_v4l2_buffer()) and stores flags, field,
+	 * timecode, sequence and planes[] right behind the vb2_buffer.  Keep
+	 * that room, or QBUF overwrites buf.entry (flags/field) and the
+	 * "never link twice" check of openimp #467 sees every buffer as
+	 * already queued.
+	 */
+	union {
+		struct vb2_buffer vb;
+		struct vb2_v4l2_buffer vb_v4l2;
+	};
+#else
 	struct vb2_buffer vb;
+#endif
 	struct frame_channel_buffer buf;
 	struct v4l2_buffer v4l2_buf;
 	u32 sequence;
