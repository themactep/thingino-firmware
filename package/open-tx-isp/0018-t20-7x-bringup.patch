From: Paul Philippov <paul@themactep.com>
Subject: [PATCH] t20: bring the recovered tx-isp driver up on kernel 7.2

The T20 driver is a recovered 3.10 OEM module. It builds against the
7.2 kernel with the vendor-compatible register access unchanged and a
set of API adaptations:

- provide the vendor mach/jz_proc/soc headers and a small compat header
  for the removed V4L2/vb2/string helpers;
- register the T20 ISP platform devices from the module (CSI, VIC, core
  and the main tx-isp device) instead of the 3.10 board files;
- use media_device_init() and drop the outer graph mutex that would
  deadlock media_device_register_entity() on 7.2;
- set video device caps and the vb2 queue lock, and adapt the queue to
  the modern dma-buf/vb2 API;
- skip the legacy clkdev lookups; U-Boot programs the ISP and CSI clocks;
- keep the vendor UAPI and sensor handoff for the next stage.

The module now loads and the ISP probe completes on the Wyze Cam 2 T20.

Signed-off-by: Paul Philippov <paul@themactep.com>
---
--- a/driver/t20/Kbuild
+++ b/driver/t20/Kbuild
@@ -1,3 +1,5 @@
+ccflags-y += -DCONFIG_SOC_T20 -DCONFIG_KERNEL_4_4_94
+ccflags-y += -include $(src)/include/tx_isp_t20_compat.h
 obj-m += tx-isp-t20.o
 tx-isp-t20-objs := \
 	sdk/tx-isp-vic.o \
@@ -29,6 +31,8 @@
 	sdk/system-chardev.o \
 	tx_isp_t20_sinfo.o \
 	tx_isp_t20_math.o \
+	tx_isp_t20_compat.o \
+	tx_isp_t20_devices.o \
 	tx_isp_t20_firmware.o
 
 ccflags-y += -DREGTRACE_KERNEL_TREE_BUILD
@@ -38,6 +42,7 @@
 # directory it is built in.
 ccflags-y += -fmacro-prefix-map=$(abspath $(src)/../..)/=
 ccflags-y += -DCONFIG_ISP_MODULE_USE_MMAP
+ccflags-y += -I$(src)/include
 ccflags-y += -I$(src)/../include
 ccflags-y += -I$(src)/sdk/source/apical-isp
 ccflags-y += -I$(src)/../../external/ingenic-sdk/include
@@ -53,7 +58,7 @@
 ifeq ($(TX_ISP_FW_O0),1)
 CFLAGS_tx_isp_t20_firmware.o += -O0 -fno-tree-dce -fno-ipa-pure-const -fno-ipa-reference
 endif
-ccflags-y += -std=gnu99 -fpermissive -w
+ccflags-y += -w
 ccflags-y += -Wno-error=strict-prototypes
 ccflags-y += -Wno-error=implicit-function-declaration
 ccflags-y += -Wno-error=implicit-int
--- /dev/null
+++ b/driver/t20/include/mach/tx_isp.h
@@ -0,0 +1,64 @@
+#ifndef __TX_ISP_H__
+#define __TX_ISP_H__
+
+#include <linux/videodev2.h>
+#include <linux/v4l2-mediabus.h>
+#define TX_SENSOR_MAX_REGULATOR_NUM 3
+#define DUMMY_CLOCK_RATE 0x0000ffff
+
+/*
+* The subdevices's group IDs.
+*/
+
+enum tx_isp_subdev_group_index {
+	TX_ISP_CORE_GRP_IDX,
+	TX_ISP_VIC_GRP_IDX,
+	TX_ISP_CSI_GRP_IDX,
+	TX_ISP_VIDEO_IN_GRP_IDX,
+	TX_ISP_MAX_GRP_IDX,
+};
+
+/*
+* the names of subdev are defined here.
+*/
+#define TX_ISP_CSI_NAME "tx-isp-csi"
+#define TX_ISP_VIC_NAME "tx-isp-vic"
+#define TX_ISP_CORE_NAME "tx-isp-core"
+
+/*
+* the return values are defined here.
+*/
+#define ISP_SUCCESS 0
+#define ISP_ERROR   0xfe
+
+/*
+@ name: the clock's name
+@ rate: the rate of the clock.
+@ flags:
+*/
+struct tx_isp_subdev_clk_info{
+	const char *name;
+	unsigned long rate;
+};
+/*
+@ name : sensor's name
+@ rst_gpio: the number of gpio that reset sensor; the invalid value is -1.
+@ pwdn_gpio: the number of gpio that power down sensor; the invalid value is -1.
+@ mclk_gpio : the name of sensor's mclk
+@ regulator_name : the name of sensor's power
+*/
+struct tx_isp_sensor_board_info{
+	const char *name;
+	unsigned int reset_gpio;
+	unsigned int pwdn_gpio;
+	const char *mclk_name;
+	const char *regulator_name[TX_SENSOR_MAX_REGULATOR_NUM];
+};
+
+struct tx_isp_subdev_platform_data {
+	unsigned int grp_id;
+	struct tx_isp_subdev_clk_info *clks;
+	unsigned int clk_num;
+};
+
+#endif /*__TX_ISP_H__*/
