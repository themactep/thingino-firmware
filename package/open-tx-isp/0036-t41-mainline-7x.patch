diff --git a/driver/t41/tx_isp_t41_compat.c b/driver/t41/tx_isp_t41_compat.c
new file mode 100644
index 0000000..e7fc1bd
--- /dev/null
+++ b/driver/t41/tx_isp_t41_compat.c
@@ -0,0 +1,98 @@
+/*
+ * Kernel 7.x compatibility implementations for the recovered T41 driver.
+ *
+ * The 4.4 vendor tree provided these through the Ingenic SDK and old kernel
+ * internals. Keep them in one place so the recovered source stays close to
+ * what was decompiled.
+ */
+
+#include <linux/module.h>
+#include <linux/kernel.h>
+#include <linux/proc_fs.h>
+#include <linux/dma-mapping.h>
+#include <linux/io.h>
+#include <linux/sched.h>
+
+struct proc_dir_entry *tx_isp_get_jz_proc_root(void)
+{
+	static struct proc_dir_entry *root;
+
+	if (!root)
+		root = proc_mkdir("jz", NULL);
+	return root;
+}
+
+struct proc_dir_entry *jz_proc_mkdir(const char *name, ...)
+{
+	return proc_mkdir(name, tx_isp_get_jz_proc_root());
+}
+
+int jzgpio_set_func(int port, int func, unsigned long pins, ...)
+{
+	/* The T41 DT pinctrl states own the used pins. */
+	(void)port;
+	(void)func;
+	(void)pins;
+	return 0;
+}
+
+void kernel_mxuv3_begin_partial(int mode)
+{
+	(void)mode;
+}
+
+void kernel_mxuv3_end(void)
+{
+}
+
+void warn_slowpath_null(const char *file, int line)
+{
+	(void)file;
+	(void)line;
+}
+
+void dma_cache_sync(void *dev, void *vaddr, size_t size,
+		    enum dma_data_direction dir, ...)
+{
+	/* Coherent buffers need no explicit cache maintenance. */
+	(void)dev;
+	(void)vaddr;
+	(void)size;
+	(void)dir;
+}
+
+int dma_alloc_from_coherent(void *dev, ssize_t size, void **vaddr,
+			    dma_addr_t *dma_handle, ...)
+{
+	*vaddr = dma_alloc_coherent(dev, size, dma_handle, GFP_KERNEL);
+	return *vaddr ? 0 : -ENOMEM;
+}
+
+int dma_release_from_coherent(void *dev, int order, ...)
+{
+	/* The recovered caller only has the handle and order here; the
+	 * allocation path already keeps the CPU address for dma_free. */
+	(void)dev;
+	(void)order;
+	return -ENOENT;
+}
+
+int __copy_user(void *to, const void *from, unsigned long n, ...)
+{
+	/* Recovered direct-copy token; the ioctl user-copy wrappers use the
+	 * real copy_from_user()/copy_to_user() paths. */
+	memcpy(to, from, n);
+	return 0;
+}
+
+void *__ioremap(phys_addr_t phys_addr, size_t size, ...)
+{
+	return ioremap(phys_addr, size);
+}
+
+void __iounmap(const volatile void __iomem *addr, ...)
+{
+	iounmap((void __iomem *)addr);
+}
+
+MODULE_LICENSE("GPL");
