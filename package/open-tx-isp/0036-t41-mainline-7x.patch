diff --git a/driver/t41/tx_isp_t41_kernel_compat.h b/driver/t41/tx_isp_t41_kernel_compat.h
new file mode 100644
index 0000000..77eab63
--- /dev/null
+++ b/driver/t41/tx_isp_t41_kernel_compat.h
@@ -0,0 +1,72 @@
+#ifndef __TX_ISP_T41_KERNEL_COMPAT_H__
+#define __TX_ISP_T41_KERNEL_COMPAT_H__
+
+#include <linux/version.h>
+#include <linux/types.h>
+#include <linux/math64.h>
+#include <linux/wait.h>
+#include <linux/proc_fs.h>
+#include <linux/string.h>
+#include <linux/timekeeping.h>
+
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 0, 0)
+/* struct timeval was removed from the kernel API; the recovered timing code
+ * and the vendor ioctl ABI still use it. */
+struct timeval {
+	long tv_sec;
+	long tv_usec;
+};
+#endif
+
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(4, 13, 0)
+typedef wait_queue_entry_t wait_queue_t;
+#endif
+
+/* __div64_32 is a MIPS-internal helper; the recovered division path only
+ * takes its address as a function token. */
+static inline uint32_t tx_isp_t41_div64_32(uint64_t *n, uint32_t base)
+{
+	return do_div(*n, base);
+}
+
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 8, 0)
+static inline size_t strlcpy(char *dst, const char *src, size_t size)
+{
+	int ret = strscpy(dst, src, size);
+	return ret < 0 ? size : (size_t)ret;
+}
+#endif
+
+#ifndef PDE_DATA
+#define PDE_DATA(inode) pde_data(inode)
+#endif
+
+struct proc_dir_entry *jz_proc_mkdir(const char *name, ...);
+
+/* set_fs()/KERNEL_DS are gone; the V4L2 bridge still spells them out. */
+typedef unsigned long mm_segment_t;
+#ifndef KERNEL_DS
+#define KERNEL_DS 0UL
+#endif
+#ifndef get_fs
+#define get_fs() 0UL
+#endif
+#ifndef set_fs
+#define set_fs(segment) do { (void)(segment); } while (0)
+#endif
+
+static inline void do_gettimeofday(struct timeval *tv)
+{
+	struct timespec64 now;
+
+	ktime_get_real_ts64(&now);
+	tv->tv_sec = (long)now.tv_sec;
+	tv->tv_usec = now.tv_nsec / NSEC_PER_USEC;
+}
+
+static inline void getrawmonotonic64(struct timespec64 *ts)
+{
+	ktime_get_raw_ts64(ts);
+}
+
+#endif
