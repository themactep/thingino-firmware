From: Paul Philippov <paul@themactep.com>
Subject: [PATCH] t31: accept a mainline sensor without flip controls

The SC4236 mainline driver does not expose HFLIP/VFLIP. The V4L2
bridge treats them as mandatory and bails out, so AddSensor falls back
to the vendor client at 0x37 and the ISP never acquires the subdev.

Treat the flip controls as optional and skip them when absent.

Signed-off-by: Paul Philippov <paul@themactep.com>
---
diff --git a/driver/t31/tx_isp_v4l2_sensor.c b/driver/t31/tx_isp_v4l2_sensor.c
index 87711cd8..8e720931 100644
--- a/driver/t31/tx_isp_v4l2_sensor.c
+++ b/driver/t31/tx_isp_v4l2_sensor.c
@@ -327,13 +327,17 @@ static int tx_v4l2_sensor_set_vflip(struct tx_isp_subdev *sd, int enable)
 	if (!s)
 		return -ENODEV;
 
-	ret = v4l2_ctrl_s_ctrl(s->hflip, !!(enable & 0x1));
-	if (ret)
-		return ret;
+	if (s->hflip) {
+		ret = v4l2_ctrl_s_ctrl(s->hflip, !!(enable & 0x1));
+		if (ret)
+			return ret;
+	}
 
-	ret = v4l2_ctrl_s_ctrl(s->vflip, !!(enable & 0x2));
-	if (ret)
-		return ret;
+	if (s->vflip) {
+		ret = v4l2_ctrl_s_ctrl(s->vflip, !!(enable & 0x2));
+		if (ret)
+			return ret;
+	}
 
 	sensor = &s->sensor;
 	return tx_isp_call_subdev_notify(sd, TX_ISP_EVENT_SYNC_SENSOR_ATTR,
@@ -519,7 +523,7 @@ struct tx_isp_subdev *tx_isp_v4l2_sensor_get(struct i2c_adapter *adapter,
 				       V4L2_CID_PIXEL_RATE);
 
 	if (!s->exposure || !s->gain || !s->hblank || !s->vblank ||
-	    !s->hflip || !s->vflip || !s->link_freq || !s->pixel_rate) {
+	    !s->link_freq || !s->pixel_rate) {
 		dev_err(&s->client->dev, "missing controls: exp=%p gain=%p hb=%p vb=%p hf=%p vf=%p lf=%p pr=%p\n",
 			s->exposure, s->gain, s->hblank, s->vblank,
 			s->hflip, s->vflip, s->link_freq, s->pixel_rate);
