+/*
+ * Runtime bring-up tracing for the recovered T23 driver. Every recovered
+ * diagnostic is prefixed "tx_isp_t23_recovered:" and emitted at INFO, WARNING
+ * or ERR level - the recovered code uses all three for plain bring-up notes.
+ * Route the whole set through this flag so a production boot is quiet; the
+ * driver's own warnings and errors, which carry no such prefix, are untouched.
+ * Writable at runtime:
+ * /sys/module/tx_isp_t23/parameters/t23_runtime_trace
+ */
+int t23_runtime_trace;
+module_param(t23_runtime_trace, int, 0644);
+MODULE_PARM_DESC(t23_runtime_trace, "enable T23 recovered-driver diagnostic logging");
+
+#define t23_trace(lvl_fmt, ...) \
+	do { if (t23_runtime_trace) printk(lvl_fmt, ##__VA_ARGS__); } while (0)
