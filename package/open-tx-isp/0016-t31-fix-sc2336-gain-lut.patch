+	283241, 285558, 287890, 290097, 292253, 294361, 296489, 298505,
+	300480, 302414, 304370, 306226, 308048, 309834, 311644, 313364,
+	315054, 316715, 318398, 320001, 321577, 323128, 324702, 326203,
+	327680,
 };
 
 static unsigned int tx_v4l2_alloc_again(unsigned int isp_gain,
@@ -339,11 +338,16 @@ static int tx_v4l2_sensor_set_expo(struct tx_isp_subdev *sd, int value)
 			return ret;
 	}
 
-	if (again) {
-		ret = v4l2_ctrl_s_ctrl(s->gain, again);
-		if (ret)
-			return ret;
-	}
+	/*
+	 * Index 0 is the 1.0x entry, not "no change": the vendor modules write
+	 * the gain on every EXPO event. Skipping it left the sensor at the
+	 * previous gain whenever the AE traded gain for integration time, so
+	 * that frame came out up to a stop too bright and the AE oscillated
+	 * between anti-flicker steps.
+	 */
+	ret = v4l2_ctrl_s_ctrl(s->gain, again);
+	if (ret)
+		return ret;
 
 	return 0;
 }
