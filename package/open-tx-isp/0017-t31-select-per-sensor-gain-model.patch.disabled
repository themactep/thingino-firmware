From: Paul Philippov <paul@themactep.com>
Subject: [PATCH] t31: select the gain model per V4L2 sensor

The bridge used one hardcoded SC2336 gain table for every mainline
V4L2 sensor. The other ports have different gain tables and control
ranges: sc4236 has 63 entries and reaches 15x, gc2083 has 29 entries
and reaches 125x, gc4023 has 25 entries and reaches 64x. Feeding them
the SC2336 model made the AE see the wrong gain and, for sensors with
fewer entries, clamp at the top of the V4L2 control.

Add a gain model keyed by sensor name. The tables are the log2 Q16
gain columns from the sensor drivers, the unit the T31 AE uses, and
max_again is taken from the selected table. Select the model when the
sensor is attached and cap the index at the V4L2 control maximum.
Sensors without a model keep the SC2336 table capped at their control
maximum, with a warning, until their table is added.

Signed-off-by: Paul Philippov <paul@themactep.com>
---
--- a/driver/t31/tx_isp_v4l2_sensor.c
+++ b/driver/t31/tx_isp_v4l2_sensor.c
@@ -32,10 +32,15 @@
 
 #define TX_V4L2_NAME_LEN	32
 #define TX_V4L2_CHIP_ID		0xcb3a
-#define TX_V4L2_MAX_GAIN	tx_v4l2_gain_lut[ARRAY_SIZE(tx_v4l2_gain_lut) - 1]
 #define TX_V4L2_MIN_EXPOSURE	2
 #define TX_V4L2_EXPOSURE_OFFSET	4
 
+struct tx_v4l2_gain_model {
+	const char *name;
+	const u32 *lut;
+	unsigned int size;
+};
+
 struct tx_isp_v4l2_sensor {
 	struct tx_isp_sensor sensor;
 	struct platform_device pdev;
@@ -64,6 +69,8 @@
 };
 
 static struct tx_isp_subdev *tx_isp_v4l2_sensor_sd;
+static const struct tx_v4l2_gain_model *tx_v4l2_active_gain;
+static u32 tx_v4l2_active_gain_max;
 
 /*
  * The mainline sc2336 driver maps the V4L2 analogue gain control to the
@@ -107,26 +114,81 @@
 	327680,
 };
 
+static const u32 tx_v4l2_sc4236_gain_lut[] = {
+	     0,   5731,  11136,  16248,  21097,  25710,  30109,  34312,
+	 38336,  42195,  45904,  49472,  52910,  56228,  59433,  62534,
+	 65536,  71267,  76672,  81784,  86633,  91246,  95645,  99848,
+	103872, 107731, 111440, 115008, 118446, 121764, 124969, 128070,
+	131072, 136803, 142208, 147320, 152169, 156782, 161181, 165384,
+	169408, 173267, 176976, 180544, 183982, 187300, 190505, 193606,
+	196608, 202339, 207744, 212856, 217705, 222318, 226717, 230920,
+	234944, 238803, 242512, 246080, 249518, 252836, 256041,
+};
+
+static const u32 tx_v4l2_gc2083_gain_lut[] = {
+	     0,  16247,  32233,  48592,  65536,  81783,  97243, 113685,
+	131072, 147629, 162779, 179442, 196608, 213165, 228446, 244978,
+	262144, 278701, 293982, 310458, 327680, 344199, 359485, 376022,
+	393216, 409735, 425021, 441558, 456839,
+};
+
+static const u32 tx_v4l2_gc4023_gain_lut[] = {
+	     0,  16208,  32217,  47690,  65536,  81784,  97213, 113226,
+	131072, 147001, 162766, 178990, 196608, 212696, 228446, 244419,
+	262144, 278158, 293982, 310012, 327680, 343731, 359484, 375550,
+	393216,
+};
+
+static const struct tx_v4l2_gain_model tx_v4l2_gain_models[] = {
+	{ "sc2336",  tx_v4l2_gain_lut,        ARRAY_SIZE(tx_v4l2_gain_lut) },
+	{ "sc2336p", tx_v4l2_gain_lut,        ARRAY_SIZE(tx_v4l2_gain_lut) },
+	{ "sc4236",  tx_v4l2_sc4236_gain_lut, ARRAY_SIZE(tx_v4l2_sc4236_gain_lut) },
+	{ "gc2083",  tx_v4l2_gc2083_gain_lut, ARRAY_SIZE(tx_v4l2_gc2083_gain_lut) },
+	{ "gc4023",  tx_v4l2_gc4023_gain_lut, ARRAY_SIZE(tx_v4l2_gc4023_gain_lut) },
+};
+
+static const struct tx_v4l2_gain_model *
+tx_v4l2_gain_model_by_name(const char *name)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(tx_v4l2_gain_models); i++)
+		if (!strcmp(tx_v4l2_gain_models[i].name, name))
+			return &tx_v4l2_gain_models[i];
+
+	return NULL;
+}
+
 static unsigned int tx_v4l2_alloc_again(unsigned int isp_gain,
 					unsigned char shift,
 					unsigned int *sensor_again)
 {
-	unsigned int i;
+	const struct tx_v4l2_gain_model *model = tx_v4l2_active_gain;
+	unsigned int i, max;
+
+	if (!model) {
+		model = &tx_v4l2_gain_models[0];
+		max = model->size - 1;
+	} else {
+		max = tx_v4l2_active_gain_max;
+		if (max >= model->size)
+			max = model->size - 1;
+	}
 
 	if (isp_gain == 0) {
 		*sensor_again = 0;
-		return tx_v4l2_gain_lut[0];
+		return model->lut[0];
 	}
 
-	for (i = 1; i < ARRAY_SIZE(tx_v4l2_gain_lut); i++) {
-		if (isp_gain < tx_v4l2_gain_lut[i]) {
+	for (i = 1; i <= max; i++) {
+		if (isp_gain < model->lut[i]) {
 			*sensor_again = i - 1;
-			return tx_v4l2_gain_lut[i - 1];
+			return model->lut[i - 1];
 		}
 	}
 
-	*sensor_again = ARRAY_SIZE(tx_v4l2_gain_lut) - 1;
-	return tx_v4l2_gain_lut[ARRAY_SIZE(tx_v4l2_gain_lut) - 1];
+	*sensor_again = max;
+	return model->lut[max];
 }
 
 static unsigned int tx_v4l2_alloc_dgain(unsigned int isp_gain,
@@ -540,6 +602,8 @@
 	struct tx_isp_v4l2_sensor *s;
 	struct tx_isp_sensor *sensor;
 	struct tx_isp_sensor_attribute *attr;
+	const struct tx_v4l2_gain_model *gain_model;
+	u32 gain_index_max;
 	int ret;
 
 	if (!adapter || !name || !name[0])
@@ -604,6 +668,24 @@
 		return NULL;
 	}
 
+	gain_model = tx_v4l2_gain_model_by_name(name);
+	if (!gain_model) {
+		dev_warn(&s->client->dev,
+			 "tx-isp-v4l2: no gain model for %s, using the SC2336 model capped at index %u\n",
+			 name, (u32)s->gain->maximum);
+		gain_model = &tx_v4l2_gain_models[0];
+	}
+
+	gain_index_max = (u32)s->gain->maximum;
+	if (gain_index_max >= gain_model->size)
+		gain_index_max = gain_model->size - 1;
+	tx_v4l2_active_gain = gain_model;
+	tx_v4l2_active_gain_max = gain_index_max;
+	dev_info(&s->client->dev,
+		 "tx-isp-v4l2: gain model %s (%u entries, max index %u, max gain %u)\n",
+		 gain_model->name, gain_model->size, gain_index_max,
+		 gain_model->lut[gain_index_max]);
+
 	if (tx_v4l2_parse_lanes(s)) {
 		dev_err(&s->client->dev, "failed to parse MIPI lanes\n");
 		tx_v4l2_sensor_free(s);
@@ -627,7 +709,7 @@
 	attr->mipi.mipi_sc.sensor_frame_mode = TX_SENSOR_DEFAULT_FRAME_MODE;
 	attr->mipi.mipi_sc.sensor_mode = TX_SENSOR_DEFAULT_MODE;
 	attr->data_type = TX_SENSOR_DATA_TYPE_LINEAR;
-	attr->max_again = TX_V4L2_MAX_GAIN;
+	attr->max_again = gain_model->lut[gain_index_max];
 	attr->max_dgain = 0;
 	attr->min_integration_time = TX_V4L2_MIN_EXPOSURE;
 	attr->min_integration_time_native = TX_V4L2_MIN_EXPOSURE;
@@ -680,6 +762,8 @@
 
 	s = sd_to_v4l2_sensor(sd);
 	tx_isp_v4l2_sensor_sd = NULL;
+	tx_v4l2_active_gain = NULL;
+	tx_v4l2_active_gain_max = 0;
 
 	if (!s)
 		return;
