From: Paul Philippov <paul@themactep.com>
Subject: [PATCH] t20 fw: read the WDR mode directly in apical_api_calibration

The recovered dispatch for the WDR-mode calibration classes read the
current mode through a pointer stored at fw_ctx + 0x1500 and then
dereferenced that pointer at + 0x1524.  Offset 0x1500 falls inside a
reserved padding region of the firmware owner view and is never
written, so the pointer is always NULL.  The first day/night
transition (night mode at boot, driven by daynightd) therefore oopsed
with BadVA 0x1524 on T10, in apical_switch_wdr_mode, from
t20_daynight_work.

The WDR mode lives at fw_ctx + 0x1524 (struct tx_isp_t20_nr_owner_view,
field wdr_mode).  Read it directly; the extra indirection has no writer
anywhere in the recovered firmware.

--- a/driver/t20/tx_isp_t20_firmware.c
+++ b/driver/t20/tx_isp_t20_firmware.c
@@ -13485,7 +13485,7 @@
 					return result;
 				}
 				if (sensor_idx < 0x14) {
-					wdr_ptr = *(uint32_t *)(fw_ctx + 0x1500);
+					wdr_ptr = (uint32_t)(fw_ctx);
 					apical_switch_wdr_mode(*(uint8_t *)(wdr_ptr + 0x1524));
 					return 0;
 				}
@@ -13494,7 +13494,7 @@
 				goto cmp_check;
 			}
 			if (sensor_idx >= 0xb) {
-				wdr_ptr = *(uint32_t *)(fw_ctx + 0x1500);
+				wdr_ptr = (uint32_t)(fw_ctx);
 				apical_switch_wdr_mode(*(uint8_t *)(wdr_ptr + 0x1524));
 				return 0;
 			}
@@ -13505,11 +13505,11 @@
 			cmp_val = sensor_idx - 6;
 			if (sensor_idx >= 5)
 				goto set_cmp3;
-			wdr_ptr = *(uint32_t *)(fw_ctx + 0x1500);
+			wdr_ptr = (uint32_t)(fw_ctx);
 			apical_switch_wdr_mode(*(uint8_t *)(wdr_ptr + 0x1524));
 			return 0;
 		}
-		wdr_ptr = *(uint32_t *)(fw_ctx + 0x1500);
+		wdr_ptr = (uint32_t)(fw_ctx);
 		apical_switch_wdr_mode(*(uint8_t *)(wdr_ptr + 0x1524));
 		return 0;
 	}
@@ -13547,7 +13547,7 @@
 	if (cmp2 < cmp_val) {
 		return 0;
 	}
-	wdr_ptr = *(uint32_t *)(fw_ctx + 0x1500);
+	wdr_ptr = (uint32_t)(fw_ctx);
 	apical_switch_wdr_mode(*(uint8_t *)(wdr_ptr + 0x1524));
 	return 0;
 
