+{
+	int ret = strscpy(dst, src, size);
+
+	return ret < 0 ? size : (size_t)ret;
+}
+
+static inline char *tx_isp_strncpy(char *dest, const char *src, size_t count)
+{
+	char *tmp = dest;
+
+	while (count) {
+		if ((*tmp = *src) != 0)
+			src++;
+		tmp++;
+		count--;
+	}
+	return dest;
