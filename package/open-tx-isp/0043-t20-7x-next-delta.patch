+
+static inline struct tx_isp_sensor *tx_to_sensor(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct tx_isp_sensor, sd);
+}
+
+static unsigned int tx_alloc_again(unsigned int isp_gain, unsigned char shift,
+				   unsigned int *sensor_again)
+{
+	const unsigned int last = ARRAY_SIZE(tx_gain_lut) - 1;
+	unsigned int i;
+
+	for (i = 0; i <= last; i++) {
+		if (isp_gain == 0) {
+			*sensor_again = 0;
+			return 0;
+		}
+		if (isp_gain < tx_gain_lut[i].gain) {
+			*sensor_again = tx_gain_lut[i - 1].code;
+			return tx_gain_lut[i - 1].gain;
+		}
+		if (tx_gain_lut[i].gain == tx_gain_lut[last].gain &&
+		    isp_gain >= tx_gain_lut[i].gain) {
+			*sensor_again = tx_gain_lut[i].code;
+			return tx_gain_lut[i].gain;
+		}
+	}
+	return isp_gain;
+}
+
+static unsigned int tx_alloc_dgain(unsigned int isp_gain, unsigned char shift,
+				   unsigned int *sensor_dgain)
+{
+	return 0;
+}
+
+static int tx_s_power(struct v4l2_subdev *sd, int on)
+{
+	return 0;
+}
+
+static int tx_s_stream(struct v4l2_subdev *sd, int enable)
+{
+	struct tx_isp_sensor *sensor = tx_to_sensor(sd);
+	struct tx_isp_t20_v4l2_sensor *ctx = sensor->priv;
+
+	return v4l2_subdev_call(ctx->vsd, video, s_stream, enable);
+}
+
+static int tx_init(struct v4l2_subdev *sd, u32 enable)
+{
+	struct tx_isp_sensor *sensor = tx_to_sensor(sd);
+	struct tx_isp_notify_argument arg;
+
+	if (!enable)
+		return 0;
+
+	arg.value = (int)&sensor->video;
+	arg.ret = 0;
+	sd->v4l2_dev->notify(sd, TX_ISP_NOTIFY_SYNC_VIDEO_IN, &arg);
+	return 0;
+}
+
+static long tx_ioctl(struct v4l2_subdev *sd, unsigned int cmd, void *arg)
+{
+	struct tx_isp_sensor *sensor = tx_to_sensor(sd);
+	struct tx_isp_t20_v4l2_sensor *ctx = sensor->priv;
+	struct isp_private_ioctl *ctl = arg;
+
+	if (cmd != VIDIOC_ISP_PRIVATE_IOCTL || !ctl)
+		return -ENOIOCTLCMD;
+
+	switch (ctl->cmd) {
+	case TX_ISP_PRIVATE_IOCTL_SENSOR_INT_TIME:
+		if (!ctx->exposure)
+			return -ENODEV;
+		return v4l2_ctrl_s_ctrl(ctx->exposure, ctl->value);
+	case TX_ISP_PRIVATE_IOCTL_SENSOR_AGAIN:
+		if (!ctx->gain)
+			return -ENODEV;
+		return v4l2_ctrl_s_ctrl(ctx->gain, ctl->value);
+	case TX_ISP_PRIVATE_IOCTL_SENSOR_DGAIN:
+	case TX_ISP_PRIVATE_IOCTL_SENSOR_BLACK_LEVEL:
+		return 0;
+	default:
+		/*
+		 * The pipeline walks every subdev and treats -ENOIOCTLCMD as
+		 * "not mine", but the notify helper returns the last result
+		 * as the pipeline result.  The vendor sensor returns 0 for the
+		 * commands it does not implement; do the same.
+		 */
+		return 0;
+	}
+}
+
+static const struct v4l2_subdev_core_ops tx_core_ops = {
+	.s_power = tx_s_power,
+	.init = tx_init,
+	.ioctl = tx_ioctl,
+};
+
+static const struct v4l2_subdev_video_ops tx_video_ops = {
+	.s_stream = tx_s_stream,
+};
+
+static const struct v4l2_subdev_ops tx_sensor_ops = {
+	.core = &tx_core_ops,
+	.video = &tx_video_ops,
+};
+
+struct tx_lookup {
+	const char *name;
+	struct i2c_client *client;
+	struct v4l2_subdev *vsd;
+};
+
+static int tx_lookup_client(struct device *dev, void *data)
+{
+	struct tx_lookup *lookup = data;
+	struct i2c_client *client;
+	struct v4l2_subdev *vsd;
+
+	client = i2c_verify_client(dev);
+	if (!client)
+		return 0;
+	if (!client->name || strcmp(client->name, lookup->name))
+		return 0;
+	vsd = i2c_get_clientdata(client);
+	if (!vsd)
+		return 0;
+	lookup->client = client;
+	lookup->vsd = vsd;
+	return 1;
+}
+
+static bool tx_find_on_adapter(struct i2c_adapter *adapter, const char *name,
+			       struct tx_lookup *lookup)
+{
+	lookup->name = name;
+	lookup->client = NULL;
+	lookup->vsd = NULL;
+	device_for_each_child(&adapter->dev, lookup, tx_lookup_client);
+	return lookup->vsd != NULL;
+}
+
+static struct v4l2_subdev *tx_find_sensor(struct i2c_adapter *adapter,
+					  const char *name,
+					  struct i2c_client **client)
+{
+	struct tx_lookup lookup;
+	unsigned int nr;
+
+	if (adapter && tx_find_on_adapter(adapter, name, &lookup)) {
+		*client = lookup.client;
+		return lookup.vsd;
+	}
+
+	/*
+	 * The streamer passes the vendor bus number, which is not the mainline
+	 * adapter number the DT client sits on.  Search every adapter before
+	 * giving up.
+	 */
+	for (nr = 0; nr < 16; nr++) {
+		struct i2c_adapter *scan = i2c_get_adapter(nr);
+		bool found;
+
+		if (!scan)
+			continue;
+		found = tx_find_on_adapter(scan, name, &lookup);
+		i2c_put_adapter(scan);
+		if (found) {
+			*client = lookup.client;
+			return lookup.vsd;
+		}
+	}
+
+	return NULL;
+}
+
+struct v4l2_subdev *tx_isp_t20_v4l2_sensor_get(struct v4l2_device *v4l2_dev,
+					       struct i2c_adapter *adapter,
+					       const char *name)
+{
+	struct tx_isp_t20_v4l2_sensor *ctx;
+	struct tx_isp_sensor *sensor;
+	struct v4l2_subdev *vsd;
+	struct i2c_client *client;
+	int ret;
+
+	if (!v4l2_dev || !name || !name[0])
+		return NULL;
+
+	vsd = tx_find_sensor(adapter, name, &client);
+	if (!vsd)
+		return NULL;
+
+	ctx = kzalloc(sizeof(*ctx), GFP_KERNEL);
+	sensor = kzalloc(sizeof(*sensor), GFP_KERNEL);
+	if (!ctx || !sensor) {
+		kfree(ctx);
+		kfree(sensor);
+		return NULL;
+	}
+
+	ctx->vsd = vsd;
+	ctx->client = client;
+	ctx->exposure = v4l2_ctrl_find(vsd->ctrl_handler, V4L2_CID_EXPOSURE);
+	ctx->gain = v4l2_ctrl_find(vsd->ctrl_handler, V4L2_CID_ANALOGUE_GAIN);
+	if (!ctx->exposure || !ctx->gain) {
+		dev_err(&client->dev,
+			"tx-isp-t20: sensor %s is missing exposure/gain controls\n",
+			name);
+		kfree(ctx);
+		kfree(sensor);
+		return NULL;
+	}
+
+	sensor->priv = ctx;
+	sensor->type = V4L2_INPUT_TYPE_CAMERA;
+
+	sensor->attr.name = TX_JXF23_NAME;
+	sensor->attr.chip_id = TX_JXF23_CHIP_ID;
+	sensor->attr.cbus_type = TX_SENSOR_CONTROL_INTERFACE_I2C;
+	sensor->attr.cbus_mask = TX_SBUS_SAMPLE_8BITS | TX_SBUS_ADDR_8BITS;
+	sensor->attr.cbus_device = client->addr;
+	sensor->attr.dbus_type = TX_SENSOR_DATA_INTERFACE_DVP;
+	sensor->attr.dvp.gpio = DVP_PA_LOW_10BIT;
+	sensor->attr.dvp.mode = SENSOR_DVP_HREF_MODE;
+	sensor->attr.max_again = TX_JXF23_MAX_AGAIN;
+	sensor->attr.max_dgain = 0;
+	sensor->attr.min_integration_time = 2;
+	sensor->attr.min_integration_time_native = 2;
+	sensor->attr.max_integration_time_native = TX_JXF23_MAX_INT_TIME;
+	sensor->attr.integration_time_limit = TX_JXF23_MAX_INT_TIME;
+	sensor->attr.max_integration_time = TX_JXF23_MAX_INT_TIME;
+	sensor->attr.total_width = TX_JXF23_TOTAL_WIDTH;
+	sensor->attr.total_height = TX_JXF23_TOTAL_HEIGHT;
+	sensor->attr.integration_time_apply_delay = 2;
+	sensor->attr.again_apply_delay = 2;
+	sensor->attr.dgain_apply_delay = 0;
+	sensor->attr.sensor_ctrl.alloc_again = tx_alloc_again;
+	sensor->attr.sensor_ctrl.alloc_dgain = tx_alloc_dgain;
+
+	sensor->video.attr = &sensor->attr;
+	sensor->video.vi_max_width = TX_JXF23_WIDTH;
+	sensor->video.vi_max_height = TX_JXF23_HEIGHT;
+	sensor->video.fps = TX_JXF23_FPS;
+	sensor->video.mbus.width = TX_JXF23_WIDTH;
+	sensor->video.mbus.height = TX_JXF23_HEIGHT;
+	sensor->video.mbus.code = V4L2_MBUS_FMT_SBGGR10_1X10;
+	sensor->video.mbus.field = V4L2_FIELD_NONE;
+	sensor->video.mbus.colorspace = V4L2_COLORSPACE_SRGB;
+
+	v4l2_subdev_init(&sensor->sd, &tx_sensor_ops);
+	strscpy(sensor->sd.name, name, sizeof(sensor->sd.name));
+	sensor->sd.owner = THIS_MODULE;
+	sensor->sd.dev = &client->dev;
+	sensor->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	v4l2_set_subdevdata(&sensor->sd, client);
+	v4l2_set_subdev_hostdata(&sensor->sd, sensor);
+
+	ret = v4l2_device_register_subdev(v4l2_dev, &sensor->sd);
+	if (ret) {
+		dev_err(&client->dev,
+			"tx-isp-t20: failed to register the %s bridge: %d\n",
+			name, ret);
+		kfree(ctx);
+		kfree(sensor);
+		return NULL;
+	}
+
+	dev_info(&client->dev,
+		 "tx-isp-t20: attached mainline %s at i2c-%d/0x%02x\n",
+		 name, client->adapter->nr, client->addr);
+	return &sensor->sd;
+}
+
+void tx_isp_t20_v4l2_sensor_put(struct tx_isp_sensor *sensor)
+{
+	if (!tx_isp_t20_v4l2_sensor_is_bridge(sensor))
+		return;
+
+	v4l2_device_unregister_subdev(&sensor->sd);
+	kfree(sensor->priv);
+	kfree(sensor);
+}
+
+struct i2c_client *tx_isp_t20_v4l2_sensor_client(struct tx_isp_sensor *sensor)
+{
+	struct tx_isp_t20_v4l2_sensor *ctx;
+
+	if (!tx_isp_t20_v4l2_sensor_is_bridge(sensor))
+		return NULL;
+
+	ctx = sensor->priv;
+	return ctx->client;
+}
+
+bool tx_isp_t20_v4l2_sensor_is_bridge(struct tx_isp_sensor *sensor)
+{
+	return sensor && sensor->sd.ops == &tx_sensor_ops;
+}
