diff --git a/driver/t20/tx_isp_t20_compat.c b/driver/t20/tx_isp_t20_compat.c
new file mode 100644
--- /dev/null
+++ b/driver/t20/tx_isp_t20_compat.c
@@ -0,0 +1,65 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <linux/init.h>
+#include <linux/export.h>
+#include <linux/fs.h>
+#include <linux/kernel.h>
+#include <linux/proc_fs.h>
+#include <linux/string.h>
+#include <linux/module.h>
+
+unsigned long ispmem_base = 0;
+unsigned long ispmem_size = 0;
+
+static struct proc_dir_entry *tx_isp_jz_root;
+
+struct proc_dir_entry *tx_isp_get_jz_proc_root(void)
+{
+	if (!tx_isp_jz_root)
+		tx_isp_jz_root = proc_mkdir("jz", NULL);
+	return tx_isp_jz_root;
+}
+
+/*
+ * The vendor kernel parsed "ispmem=<size>@<base>" with __setup().  This
+ * driver is a module now, so read the command line from procfs at init.
+ * The region lies outside mem= and is used for the ISP temper/WDR buffers;
+ * leaving it at 0 disables both and makes every shortfall report a 0 KB
+ * carve-out.
+ */
+int __init tx_isp_t20_mem_init(void)
+{
+	struct file *f;
+	char buf[512];
+	loff_t pos = 0;
+	ssize_t n;
+	char *p, *end;
+
+	f = filp_open("/proc/cmdline", O_RDONLY, 0);
+	if (IS_ERR(f)) {
+		pr_err("tx-isp: cannot read /proc/cmdline (%ld)\n",
+		       PTR_ERR(f));
+		return 0;
+	}
+	n = kernel_read(f, buf, sizeof(buf) - 1, &pos);
+	filp_close(f, NULL);
+	if (n <= 0)
+		return 0;
+	buf[n] = '\0';
+
+	p = strstr(buf, "ispmem=");
+	if (!p) {
+		pr_warn("tx-isp: no ispmem= in the kernel command line\n");
+		return 0;
+	}
+	p += strlen("ispmem=");
+
+	ispmem_size = memparse(p, &end);
+	if (*end == '@')
+		ispmem_base = memparse(end + 1, NULL);
+
+	pr_info("tx-isp: ispmem base=0x%lx size=%lu MiB\n",
+		ispmem_base, ispmem_size >> 20);
+	return 0;
+}
+
+MODULE_IMPORT_NS("DMA_BUF");
diff --git a/driver/t20/tx_isp_t20_devices.c b/driver/t20/tx_isp_t20_devices.c
new file mode 100644
--- /dev/null
+++ b/driver/t20/tx_isp_t20_devices.c
@@ -0,0 +1,141 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <linux/init.h>
+#include <linux/platform_device.h>
+#include <linux/dma-mapping.h>
+#include <linux/irqdomain.h>
+#include <linux/of.h>
+#include <mach/tx_isp.h>
+
+#define T20_CSI_IOBASE		0x10040000
+#define T20_VIC_IOBASE		0x13300000
+#define T20_IRQ_IOBASE		0x13320000
+#define T20_CORE_IOBASE		0x13380000
+#define T20_ISP_IRQ		29
+
+static u64 tx_isp_dma_mask = DMA_BIT_MASK(32);
+
+static struct resource tx_isp_csi_res[] = {
+	{ .name = "mipi_csi", .start = T20_CSI_IOBASE,
+	  .end = T20_CSI_IOBASE + 0xfff, .flags = IORESOURCE_MEM },
+};
+
+static struct tx_isp_subdev_clk_info tx_isp_csi_clks[] = {
+	{ "mipi_csi", DUMMY_CLOCK_RATE },
+};
+
+static struct tx_isp_subdev_platform_data tx_isp_csi_pdata = {
+	.grp_id = TX_ISP_CSI_GRP_IDX,
+	.clks = tx_isp_csi_clks,
+	.clk_num = ARRAY_SIZE(tx_isp_csi_clks),
+};
+
+static struct resource tx_isp_vic_res[] = {
+	{ .name = "isp_vic", .start = T20_VIC_IOBASE,
+	  .end = T20_VIC_IOBASE + 0xffff, .flags = IORESOURCE_MEM },
+};
+
+static struct tx_isp_subdev_platform_data tx_isp_vic_pdata = {
+	.grp_id = TX_ISP_VIC_GRP_IDX,
+};
+
+static struct resource tx_isp_core_res[] = {
+	{ .name = "isp_core", .start = T20_CORE_IOBASE,
+	  .end = T20_CORE_IOBASE + 0x7ffff, .flags = IORESOURCE_MEM },
+};
+
+static struct tx_isp_subdev_clk_info tx_isp_core_clks[] = {
+	{ "isp", 100000000 },
+};
+
+static struct tx_isp_subdev_platform_data tx_isp_core_pdata = {
+	.grp_id = TX_ISP_CORE_GRP_IDX,
+	.clks = tx_isp_core_clks,
+	.clk_num = ARRAY_SIZE(tx_isp_core_clks),
+};
+
+static struct resource tx_isp_res[] = {
+	{ .name = "isp_device_irq", .start = T20_IRQ_IOBASE,
+	  .end = T20_IRQ_IOBASE + 0xffff, .flags = IORESOURCE_MEM },
+	{ .name = "isp_irq_id", .start = T20_ISP_IRQ,
+	  .end = T20_ISP_IRQ, .flags = IORESOURCE_IRQ },
+};
+
+static struct tx_isp_subdev_platform_data tx_isp_video_in_pdata = {
+	.grp_id = TX_ISP_VIDEO_IN_GRP_IDX,
+};
+
+/*
+ * T20_ISP_IRQ is an INTC hwirq, not a Linux virq.  The GPIO irqchip
+ * allocates virqs from the same low range, so a raw request_irq(29) lands
+ * on a GPIO line and the VIC never delivers a frame interrupt.  Map the
+ * hwirq through the INTC domain instead.
+ */
+unsigned int tx_isp_t20_irq(void)
+{
+	struct device_node *np;
+	struct irq_domain *domain;
+	unsigned int virq = 0;
+
+	np = of_find_compatible_node(NULL, NULL, "ingenic,t31-intc");
+	if (!np)
+		return 0;
+	domain = irq_find_matching_fwnode(of_fwnode_handle(np),
+					  DOMAIN_BUS_ANY);
+	if (domain)
+		virq = irq_create_mapping(domain, T20_ISP_IRQ);
+	of_node_put(np);
+	return virq;
+}
+
+static struct platform_device *tx_isp_csi_dev;
+static struct platform_device *tx_isp_vic_dev;
+static struct platform_device *tx_isp_core_dev;
+static struct platform_device *tx_isp_dev;
+
+static void tx_isp_set_mask(struct platform_device *pdev)
+{
+	pdev->dev.dma_mask = &tx_isp_dma_mask;
+	pdev->dev.coherent_dma_mask = tx_isp_dma_mask;
+}
+
+int __init tx_isp_t20_devices_register(void)
+{
+	if (!tx_isp_t20_irq())
+		return -ENODEV;
+	tx_isp_csi_dev = platform_device_register_resndata(NULL, TX_ISP_CSI_NAME, -1,
+		tx_isp_csi_res, ARRAY_SIZE(tx_isp_csi_res),
+		&tx_isp_csi_pdata, sizeof(tx_isp_csi_pdata));
+	if (IS_ERR(tx_isp_csi_dev))
+		return PTR_ERR(tx_isp_csi_dev);
+	tx_isp_set_mask(tx_isp_csi_dev);
+
+	tx_isp_vic_dev = platform_device_register_resndata(NULL, TX_ISP_VIC_NAME, -1,
+		tx_isp_vic_res, ARRAY_SIZE(tx_isp_vic_res),
+		&tx_isp_vic_pdata, sizeof(tx_isp_vic_pdata));
+	if (IS_ERR(tx_isp_vic_dev))
+		return PTR_ERR(tx_isp_vic_dev);
+	tx_isp_set_mask(tx_isp_vic_dev);
+
+	tx_isp_core_dev = platform_device_register_resndata(NULL, TX_ISP_CORE_NAME, -1,
+		tx_isp_core_res, ARRAY_SIZE(tx_isp_core_res),
+		&tx_isp_core_pdata, sizeof(tx_isp_core_pdata));
+	if (IS_ERR(tx_isp_core_dev))
+		return PTR_ERR(tx_isp_core_dev);
+	tx_isp_set_mask(tx_isp_core_dev);
+
+	tx_isp_dev = platform_device_register_resndata(NULL, "tx-isp", -1,
+		tx_isp_res, ARRAY_SIZE(tx_isp_res),
+		&tx_isp_video_in_pdata, sizeof(tx_isp_video_in_pdata));
+	if (IS_ERR(tx_isp_dev))
+		return PTR_ERR(tx_isp_dev);
+	tx_isp_set_mask(tx_isp_dev);
+	return 0;
+}
+
+void tx_isp_t20_devices_unregister(void)
+{
+	platform_device_unregister(tx_isp_dev);
+	platform_device_unregister(tx_isp_core_dev);
+	platform_device_unregister(tx_isp_vic_dev);
+	platform_device_unregister(tx_isp_csi_dev);
+}
