--- /dev/null
+++ b/driver/t20/tx_isp_t20_v4l2_sensor.c
@@ -0,0 +1,435 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Mainline V4L2 sensor bridge for the T20 tx-isp driver.
+ *
+ * The recovered T20 driver expects a sensor subdev that implements the
+ * Ingenic vendor sensor ABI and is registered through the tx-isp video-in
+ * register path.  Mainline kernels expose the JXF23 as a regular V4L2
+ * subdevice owned by drivers/media/i2c.  This bridge finds that subdevice on
+ * the I2C bus, presents the vendor ABI on top of it, and forwards streaming
+ * and the AE private ioctls to the mainline driver's pad ops and controls.
+ */
+
+#include <linux/device.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-subdev.h>
+
+#include "tx-isp-common.h"
+#include "tx_isp_t20_v4l2_sensor.h"
+
+/* Values from external/ingenic-sdk/include/sensor-common.h. */
+#define TX_SBUS_SAMPLE_8BITS	0x01
+#define TX_SBUS_ADDR_8BITS	0x08
+
+#define TX_JXF23_NAME		"jxf23"
+#define TX_JXF23_WIDTH		1920
+#define TX_JXF23_HEIGHT		1080
+#define TX_JXF23_CHIP_ID	0xf23
+#define TX_JXF23_TOTAL_WIDTH	2560
+#define TX_JXF23_TOTAL_HEIGHT	1350
+#define TX_JXF23_MAX_INT_TIME	(TX_JXF23_TOTAL_HEIGHT - 4)
+#define TX_JXF23_MAX_AGAIN	324678
+#define TX_JXF23_FPS		(25 << 16 | 1)
+
+struct tx_isp_t20_v4l2_sensor {
+	struct v4l2_subdev *vsd;
+	struct i2c_client *client;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *gain;
+};
+
+struct tx_gain {
+	u8 code;
+	u32 gain;
+};
+
+static const struct tx_gain tx_gain_lut[] = {
+	{ 0x00, 0 },
+	{ 0x01, 5731 },
