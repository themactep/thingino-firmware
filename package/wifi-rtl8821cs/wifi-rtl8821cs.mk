WIFI_RTL8821CS_SITE_METHOD = git
WIFI_RTL8821CS_SITE = https://github.com/gtxaspec/rtl8821cs-wifi
WIFI_RTL8821CS_SITE_BRANCH = master
WIFI_RTL8821CS_VERSION = b47c26072c90028ba3775bfc7dc2c342c5d3d43f

WIFI_RTL8821CS_LICENSE = GPL-2.0, BSD-3-Clause
WIFI_RTL8821CS_LICENSE_FILES = COPYING

RTL8821CS_MODULE_NAME = 8821cs
RTL8821CS_MODULE_OPTS =

WIFI_RTL8821CS_MODULE_MAKE_OPTS = \
	CONFIG_RTL8821CS=m \
	KVER=$(LINUX_VERSION_PROBED) \
	KSRC=$(LINUX_DIR)

define WIFI_RTL8821CS_LINUX_CONFIG_FIXUPS
	$(call KCONFIG_ENABLE_OPT,CONFIG_WLAN)
	$(call KCONFIG_ENABLE_OPT,CONFIG_WIRELESS)
	$(call KCONFIG_SET_OPT,CONFIG_CFG80211,y)
endef

$(eval $(kernel-module))
$(eval $(generic-package))
