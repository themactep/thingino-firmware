+			    (gz_stat.st_mode & S_IROTH) &&
+			    gz_stat.st_mtime >= pi->stat.st_mtime) {
+				cl->dispatch.file.vary = true;
+				if (ae && uh_file_accepts_gzip(ae) &&
+				    (gz_fd = open(gz_path, O_RDONLY)) >= 0) {
+					close(fd);
+					fd = gz_fd;
+					st = &gz_stat;
+					gz = true;
+				}
+			}
+		}
+
+		uh_file_data(cl, pi, fd, st, gz);
 		cl->dispatch.file.hdr = NULL;
 		return;
 	}
