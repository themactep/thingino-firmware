+/* Parse a qvalue ("0", "0.5", "1.000") into thousandths; -1 if malformed. */
+static int uh_file_qvalue(const char *s, size_t len)
+{
+	int q, scale = 100;
+	size_t i;
+
+	if (!len || (s[0] != '0' && s[0] != '1'))
+		return -1;
+
+	q = (s[0] - '0') * 1000;
+	if (len == 1)
+		return q;
+
+	if (s[1] != '.' || len > 5)
+		return -1;
+
+	for (i = 2; i < len; i++, scale /= 10) {
+		if (!isdigit((unsigned char)s[i]))
+			return -1;
+		q += (s[i] - '0') * scale;
+	}
+
+	return q > 1000 ? -1 : q;
+}
+
+/* Does an Accept-Encoding value allow gzip? (RFC 9110, 12.5.3)
+ * Codings are case-insensitive, whitespace around ";" is allowed, and a
+ * coding with q=0 is refused. A list that does not name gzip falls back to
+ * "*". A malformed q counts as q=0, so a refusal is never misread. */
+static bool uh_file_accepts_gzip(const char *ae)
+{
+	int gzip_q = -1, star_q = -1;
+
+	while (*ae) {
+		const char *tok, *name;
+		size_t tlen, nlen, vlen;
+		int q = 1000;
+
+		ae += strspn(ae, " \t,");
+		if (!*ae)
+			break;
+
+		tok = ae;
+		tlen = strcspn(tok, " \t;,");
+		ae += tlen;
+
+		/* parameters: *( OWS ";" OWS name "=" value ) */
+		for (;;) {
+			ae += strspn(ae, " \t");
+			if (*ae != ';')
+				break;
+			ae++;
+			ae += strspn(ae, " \t");
+			name = ae;
+			nlen = strcspn(ae, " \t=;,");
+			ae += nlen;
+			ae += strspn(ae, " \t");
+			if (*ae != '=')
+				continue;
+			ae++;
+			ae += strspn(ae, " \t");
+			vlen = strcspn(ae, " \t;,");
+			if (nlen == 1 && tolower((unsigned char)*name) == 'q')
+				q = uh_file_qvalue(ae, vlen);
+			ae += vlen;
+		}
+		ae += strcspn(ae, ",");
+
+		if (q < 0)
+			q = 0;
+
+		if ((tlen == 4 && !strncasecmp(tok, "gzip", 4)) ||
+		    (tlen == 6 && !strncasecmp(tok, "x-gzip", 6))) {
+			if (q > gzip_q)
+				gzip_q = q;
+		} else if (tlen == 1 && *tok == '*') {
+			star_q = q;
+		}
+	}
+
+	if (gzip_q >= 0)
+		return gzip_q > 0;
+
+	return star_q > 0;
+}
