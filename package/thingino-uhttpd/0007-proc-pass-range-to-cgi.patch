proc: pass the Range request header to CGI as HTTP_RANGE

uhttpd exports only a fixed list of request headers to CGI scripts
(proc_header_env) and serves no byte ranges itself (file.c answers every
request with 200 and the whole file). A CGI that streams recordings from the
SD card therefore cannot honour a player's Range request: Kodi, VLC and
browsers treat the clip as unseekable, scrubbing is impossible, and every
thumbnail or stream probe pulls the whole file. With HTTP_RANGE in the
environment the CGI can answer 206 Partial Content itself.

Same shape as 0006 (X-API-Key).

diff --git a/proc.c b/proc.c
--- a/proc.c
+++ b/proc.c
@@ -39,7 +39,8 @@
 	__header(x_http_method_override, x-http-method-override) \
 	__header(http_auth_user, http-auth-user) \
 	__header(http_auth_pass, http-auth-pass) \
-	__header(x_api_key, x-api-key)
+	__header(x_api_key, x-api-key) \
+	__header(range, range)

 #undef __header
 #define __header __enum_header
@@ -73,6 +74,7 @@
 	{ "HTTP_AUTH_USER", HDR_http_auth_user },
 	{ "HTTP_AUTH_PASS", HDR_http_auth_pass },
 	{ "HTTP_X_API_KEY", HDR_x_api_key },
+	{ "HTTP_RANGE", HDR_range },
 	{ "CONTENT_TYPE", HDR_content_type },
 	{ "CONTENT_LENGTH", HDR_content_length },
 };
