From: Paul Philippov <paul@themactep.com>
Date: Sat, 22 Aug 2026 09:00:00 +0400
Subject: [PATCH] motor-daemon: read the initial point from motors.presets[0]

The web UI and the init script have moved the initial camera position
from the standalone motors.pos_0 string into the presets array: the
first preset is now the position the camera parks at on boot and after
homing. Read it here too, so the homing center target and the initial
kernel step seed come from the same source of truth. motors.pos_0 stays
as a fallback for configs that predate the presets array.

---
--- a/src/motor-daemon.c
+++ b/src/motor-daemon.c
@@ -352,12 +352,31 @@ static bool parse_modern_layout(JsonValue *root, JsonValue *motors) {
     parsed = true;
   }
 
-  const char *pos0 = json_get_string_jct(motors, "pos_0");
-  if (pos0) {
-    strncpy(g_cfg.hw.pos0, pos0, sizeof(g_cfg.hw.pos0) - 1);
-    g_cfg.hw.pos0[sizeof(g_cfg.hw.pos0) - 1] = '\0';
-    if (parse_pos0_string(pos0, &g_cfg.pan.home, &g_cfg.tilt.home))
-      parsed = true;
+  // The initial point is the first preset; pos_0 remains a fallback
+  // for configs that predate the presets array.
+  bool have_initial = false;
+  JsonValue *presets = get_object_item(motors, "presets");
+  if (presets && presets->type == JSON_ARRAY && get_array_size(presets) > 0) {
+    JsonValue *first = get_array_item(presets, 0);
+    if (first && first->type == JSON_OBJECT) {
+      int hx = 0, hy = 0;
+      if (json_get_int_jct(first, "x", &hx) && json_get_int_jct(first, "y", &hy)) {
+        g_cfg.pan.home = hx;
+        g_cfg.tilt.home = hy;
+        snprintf(g_cfg.hw.pos0, sizeof(g_cfg.hw.pos0), "%d,%d", hx, hy);
+        parsed = true;
+        have_initial = true;
+      }
+    }
+  }
+  if (!have_initial) {
+    const char *pos0 = json_get_string_jct(motors, "pos_0");
+    if (pos0) {
+      strncpy(g_cfg.hw.pos0, pos0, sizeof(g_cfg.hw.pos0) - 1);
+      g_cfg.hw.pos0[sizeof(g_cfg.hw.pos0) - 1] = '\0';
+      if (parse_pos0_string(pos0, &g_cfg.pan.home, &g_cfg.tilt.home))
+        parsed = true;
+    }
   }
 
   parsed |= json_get_int_jct(motors, "steps_pan", &g_cfg.pan.max_steps);
