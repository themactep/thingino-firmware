#!/bin/sh

step=50

echo "Pan/Tilt Controller"
echo "Controls: w (up), s (down), a (left), d (right), q (quit)"
echo "Step size: $step"

while true; do
	read -s -n 1 key

	case $key in
		w|W)
			motors -d g -y $step   # Up is positive (matches WebUI arrow pad)
			;;
		s|S)
			motors -d g -y -$step  # Down is negative
			;;
		a|A)
			motors -d g -x -$step   # Left is negative
			;;
		d|D)
			motors -d g -x $step    # Right is positive
			;;
		q|Q)
			echo "Quitting..."
			exit 0
			;;
	esac
done
