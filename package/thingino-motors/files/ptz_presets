#!/bin/sh
# shellcheck disable=SC1087 # $PRESETS is a JSONPath expression, not an array
#
# PTZ preset manager backed by the motors.presets array in /etc/thingino.json.
# Each entry is {"id":N,"name":"..","x":N,"y":N}. The id is assigned at
# creation and never renumbered by reorder or rename, so cruise paths can
# reference presets by id even when the name changes.

MOTORS_CONFIG="/etc/thingino.json"
PRESETS='$.motors.presets'
LEGACY_CONF="/etc/ptz_presets.conf"

usage() {
	echo "Usage: $0 [-g] [-a <preset_id> <preset_name> [<x_coord> <y_coord>]] [-r <preset_id>] [-o <id,...>]
	-g: Display all presets
	-a: Add or overwrite a preset with id, name, and optionally coordinates.
	    Use -1 as preset_id to auto-assign a new unique id.
	-r: Remove a preset by id
	-o: Reorder presets (comma-separated list of ids)
	<preset_id>: Run the specified preset
" >&2
	exit 1
}

json_escape() {
	printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

# Query the presets array; missing key yields "[]" with rc=0.
preset_query() {
	out=$(jct "$MOTORS_CONFIG" path "$@" 2>/dev/null)
	[ -n "$out" ] && printf '%s\n' "$out" || echo '[]'
}

# Single-value query; a filter with no matches yields "[]" from
# --unwrap-single, which must come back as empty so callers can tell
# "not found" from a real value.
preset_value() {
	out=$(jct "$MOTORS_CONFIG" path "$@" 2>/dev/null)
	case "$out" in
		'[]') : ;;
		*) printf '%s\n' "$out" ;;
	esac
}

# Object at the given array index, compact one-line JSON.
preset_at() {
	preset_value "$PRESETS[$1]" --mode values --unwrap-single
}

# Object with the given id, compact one-line JSON, empty if not found.
preset_by_id() {
	preset_value "$PRESETS[?(@.id==$1)]" --mode values --unwrap-single
}

preset_count() {
	ids=$(preset_query "$PRESETS[*].id" --mode values)
	case "$ids" in
		'[]') echo 0 ;;
		*) echo "$ids" | tr -d '[]' | awk -F, '{print NF}' ;;
	esac
}

max_preset_id() {
	ids=$(preset_query "$PRESETS[*].id" --mode values)
	case "$ids" in
		'[]') echo 0 ;;
		*)
			echo "$ids" | tr -d '[]' | awk -F, '{m=0; for (i=1; i<=NF; i++) if ($i+0 > m) m=$i+0; print m}'
			;;
	esac
}

# Replace motors.presets with the JSON array in the given file.
# Other motors keys survive: import merges the motors object and only
# replaces the presets key (arrays are not deep-merged).
import_presets() {
	tmp=$(mktemp)
	{
		printf '{"motors":{"presets":'
		cat "$1"
		printf '}}\n'
	} >"$tmp"
	jct "$MOTORS_CONFIG" import "$tmp" >/dev/null 2>&1
	rm -f "$tmp"
}

# One-time import of the pre-JSON /etc/ptz_presets.conf on upgraded
# devices. Only runs while the presets array is empty, then the conf is
# moved aside so a later delete-all cannot resurrect it.
migrate_legacy_conf() {
	[ -f "$LEGACY_CONF" ] || return 0
	[ "$(preset_count)" -eq 0 ] || return 0

	tmp=$(mktemp)
	printf '[' >"$tmp"
	first=1
	found=0
	while IFS='=' read -r pnum rest; do
		case "$pnum" in
			\#* | '' | *[!0-9]*) continue ;;
		esac
		pname="${rest%%,*}"
		pcoords="${rest#*,}"
		px="${pcoords%%,*}"
		py="${pcoords#*,}"
		[ -n "$px" ] && [ -n "$py" ] || continue
		[ "$first" = 1 ] || printf ',' >>"$tmp"
		first=0
		found=1
		printf '{"id":%s,"name":"%s","x":%s,"y":%s}' \
			"$pnum" "$(json_escape "$pname")" "$px" "$py" >>"$tmp"
	done <"$LEGACY_CONF"
	printf ']\n' >>"$tmp"

	if [ "$found" = 1 ]; then
		import_presets "$tmp"
		mv "$LEGACY_CONF" "$LEGACY_CONF.imported"
		logger -t ptz_presets "Imported legacy presets from $LEGACY_CONF"
	fi
	rm -f "$tmp"
}

migrate_legacy_conf

case "$1" in
	-g)
		count=$(preset_count)
		i=0
		while [ "$i" -lt "$count" ]; do
			id=$(jct "$MOTORS_CONFIG" get motors.presets.$i.id 2>/dev/null)
			name=$(jct "$MOTORS_CONFIG" get motors.presets.$i.name 2>/dev/null)
			x=$(jct "$MOTORS_CONFIG" get motors.presets.$i.x 2>/dev/null)
			y=$(jct "$MOTORS_CONFIG" get motors.presets.$i.y 2>/dev/null)
			echo "$id=$name,$x,$y"
			i=$((i + 1))
		done
		exit 0
		;;
	-a)
		[ $# -ge 3 ] || {
			echo "Error: Missing arguments for -a." >&2
			usage
		}

		INPUT_NUM=$2
		PRESET_NAME=$3

		if [ $# -ge 5 ]; then
			PRESET_X=$4
			PRESET_Y=$5
		else
			MOTOR_POS=$(motors -p)
			PRESET_X=$(echo "$MOTOR_POS" | cut -d, -f1)
			PRESET_Y=$(echo "$MOTOR_POS" | cut -d, -f2)
			[ -z "$PRESET_X" ] || [ -z "$PRESET_Y" ] && echo "Error: Failed to get coordinates from motors -p" && exit 1
		fi

		case "$PRESET_X" in
			'' | *[!0-9]*)
				echo "Error: invalid x coordinate" >&2
				exit 1
				;;
		esac
		case "$PRESET_Y" in
			'' | *[!0-9]*)
				echo "Error: invalid y coordinate" >&2
				exit 1
				;;
		esac

		if [ "$INPUT_NUM" = "-1" ]; then
			PRESET_NUM=$(max_preset_id)
			PRESET_NUM=$((PRESET_NUM + 1))
		else
			case "$INPUT_NUM" in
				'' | *[!0-9]*)
					echo "Error: invalid preset id" >&2
					exit 1
					;;
			esac
			PRESET_NUM=$INPUT_NUM
		fi

		NEW_OBJ=$(printf '{"id":%s,"name":"%s","x":%s,"y":%s}' \
			"$PRESET_NUM" "$(json_escape "$PRESET_NAME")" "$PRESET_X" "$PRESET_Y")

		tmp=$(mktemp)
		printf '[' >"$tmp"
		first=1
		added=0
		count=$(preset_count)
		i=0
		while [ "$i" -lt "$count" ]; do
			cid=$(jct "$MOTORS_CONFIG" get motors.presets.$i.id 2>/dev/null)
			[ "$first" = 1 ] || printf ',' >>"$tmp"
			first=0
			if [ "$cid" = "$PRESET_NUM" ]; then
				printf '%s' "$NEW_OBJ" >>"$tmp"
				added=1
			else
				printf '%s' "$(preset_at "$i")" >>"$tmp"
			fi
			i=$((i + 1))
		done
		if [ "$added" = 0 ]; then
			[ "$first" = 1 ] || printf ',' >>"$tmp"
			printf '%s' "$NEW_OBJ" >>"$tmp"
		fi
		printf ']\n' >>"$tmp"
		import_presets "$tmp"
		rm -f "$tmp"

		if [ "$added" = 1 ]; then
			echo "Preset $PRESET_NUM updated."
		else
			echo "Preset $PRESET_NUM added."
		fi
		exit 0
		;;
	-r)
		[ $# -eq 2 ] || {
			echo "Error: Missing preset id." >&2
			usage
		}
		PRESET_NUM=$2
		case "$PRESET_NUM" in
			'' | *[!0-9]*)
				echo "Preset $PRESET_NUM not found."
				exit 1
				;;
		esac

		tmp=$(mktemp)
		printf '[' >"$tmp"
		first=1
		found=0
		count=$(preset_count)
		i=0
		while [ "$i" -lt "$count" ]; do
			cid=$(jct "$MOTORS_CONFIG" get motors.presets.$i.id 2>/dev/null)
			if [ "$cid" != "$PRESET_NUM" ]; then
				[ "$first" = 1 ] || printf ',' >>"$tmp"
				first=0
				printf '%s' "$(preset_at "$i")" >>"$tmp"
			else
				found=1
			fi
			i=$((i + 1))
		done
		printf ']\n' >>"$tmp"
		if [ "$found" = 1 ]; then
			import_presets "$tmp"
			echo "Preset $PRESET_NUM removed."
		else
			echo "Preset $PRESET_NUM not found."
		fi
		rm -f "$tmp"
		exit 0
		;;
	-o)
		[ $# -eq 2 ] || {
			echo "Error: Missing preset order." >&2
			usage
		}

		tmp=$(mktemp)
		printf '[' >"$tmp"
		first=1
		oldifs=$IFS
		IFS=','
		for pn in $2; do
			IFS=$oldifs
			case "$pn" in
				'' | *[!0-9]*) continue ;;
			esac
			obj=$(preset_by_id "$pn")
			if [ -n "$obj" ]; then
				[ "$first" = 1 ] || printf ',' >>"$tmp"
				first=0
				printf '%s' "$obj" >>"$tmp"
			fi
			IFS=','
		done
		IFS=$oldifs

		# Presets not listed keep their relative order at the end.
		count=$(preset_count)
		i=0
		while [ "$i" -lt "$count" ]; do
			cid=$(jct "$MOTORS_CONFIG" get motors.presets.$i.id 2>/dev/null)
			case ",$2," in
				*",$cid,"*) ;;
				*)
					[ "$first" = 1 ] || printf ',' >>"$tmp"
					first=0
					printf '%s' "$(preset_at "$i")" >>"$tmp"
					;;
			esac
			i=$((i + 1))
		done
		printf ']\n' >>"$tmp"
		import_presets "$tmp"
		rm -f "$tmp"
		echo "Presets reordered."
		exit 0
		;;
	*)
		case "$1" in
			'' | *[!0-9]*) usage ;;
		esac
		PRESET_NUM=$1
		x=$(preset_value "$PRESETS[?(@.id==$PRESET_NUM)].x" --mode values --unwrap-single)
		y=$(preset_value "$PRESETS[?(@.id==$PRESET_NUM)].y" --mode values --unwrap-single)
		if [ -n "$x" ] && [ -n "$y" ]; then
			logger -t ptz_presets "Running: motors -d h -x $x -y $y"
			motors -d h -x "$x" -y "$y"
			exit 0
		else
			echo "Preset $PRESET_NUM not found."
			exit 1
		fi
		;;
esac
