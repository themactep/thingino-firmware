diff --git a/driver/oal/oal_time.h b/driver/oal/oal_time.h
index 8dee860..942407f 100644
--- a/driver/oal/oal_time.h
+++ b/driver/oal/oal_time.h
@@ -108,7 +108,11 @@ typedef union ktime oal_time_t_stru;
 #endif
 
 #endif
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(4, 18, 0))
+typedef struct timespec64 oal_timeval_stru;
+#else
 typedef struct timeval oal_timeval_stru;
+#endif
 typedef struct rtc_time oal_rtctime_stru;
 
 /*****************************************************************************
@@ -129,8 +133,13 @@ typedef struct rtc_time oal_rtctime_stru;
 *****************************************************************************/
 static inline hi_void  oal_time_get_stamp_us(oal_time_us_stru *pst_usec)
 {
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(4, 18, 0))
+    struct timespec64 ts;
+    ktime_get_real_ts64(&ts);
+#else
     struct timespec ts;
     getnstimeofday(&ts);
+#endif
     pst_usec->i_sec     = ts.tv_sec;
     pst_usec->i_usec    = ts.tv_nsec / 1000; /* 1us 是 1000ns */
 }
@@ -165,6 +174,14 @@ static inline oal_time_t_stru oal_ktime_sub(const oal_time_t_stru lhs, const oal
 *****************************************************************************/
 static inline hi_u64 oal_get_time_stamp_from_timeval(hi_void)
 {
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(4, 18, 0))
+    struct timespec64 tv;
+    hi_u64 curr_time;
+
+    ktime_get_real_ts64(&tv);
+    curr_time = tv.tv_nsec / 1000;
+    curr_time = curr_time + tv.tv_sec * 1000;
+#else
     struct timeval tv;
     hi_u64 curr_time;
 
@@ -172,18 +189,27 @@ static inline hi_u64 oal_get_time_stamp_from_timeval(hi_void)
     curr_time = tv.tv_usec;
     do_div(curr_time, 1000);                    /* div 1000 */
     curr_time = curr_time + tv.tv_sec * 1000;   /* mul 1000 */
+#endif
 
     return curr_time;
 }
 
 static inline hi_void oal_do_gettimeofday(oal_timeval_stru *tv)
 {
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(4, 18, 0))
+    ktime_get_real_ts64(tv);
+#else
     do_gettimeofday(tv);
+#endif
 }
 
 static inline hi_void oal_rtc_time_to_tm(unsigned long time, oal_rtctime_stru *tm)
 {
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(5, 0, 0))
+    rtc_time64_to_tm(time, tm);
+#else
     rtc_time_to_tm(time, tm);
+#endif
 }
 
