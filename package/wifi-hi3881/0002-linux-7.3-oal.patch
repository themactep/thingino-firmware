index 89fd002..9e48023 100644
--- a/driver/Makefile
+++ b/driver/Makefile
@@ -141,7 +141,7 @@ SRC_DIRS_FLASH = $(sort $(dir $(FLASH_COBJS)))
 EXTRA_CFLAGS += $(HI1131_HOST_CFLAGS)
 ccflags-y += $(EXTRA_CFLAGS)
 subdir-ccflags-y += $(EXTRA_CFLAGS)
-CROSS_COMPILE := $(CROSS_COMPILE)
+subdir-CROSS_COMPILE := $(CROSS_COMPILE)
 KDIR := $(KDIR)
 ARCH := arm
 
