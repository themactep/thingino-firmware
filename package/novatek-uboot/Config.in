config BR2_PACKAGE_NOVATEK_UBOOT
	bool "Novatek U-Boot"
	depends on BR2_SOC_VENDOR_NOVATEK
	select BR2_PACKAGE_HOST_DTC
	help
	  U-Boot from Novatek-OSS, built with thingino's boot environment.
	  The vendor loader stays on flash and starts it: from the card's
	  FW<model>T.BIN for an SD install, from the uboot partition for a
	  flash install.

if BR2_PACKAGE_NOVATEK_UBOOT

choice
	prompt "Boot media"
	default BR2_PACKAGE_NOVATEK_UBOOT_BOOT_SD

config BR2_PACKAGE_NOVATEK_UBOOT_BOOT_SD
	bool "SD card"
	select BR2_TARGET_ROOTFS_EXT2
	select BR2_PACKAGE_HOST_GENIMAGE
	select BR2_PACKAGE_HOST_DOSFSTOOLS
	select BR2_PACKAGE_HOST_MTOOLS
	select BR2_PACKAGE_E2FSPROGS
	select BR2_PACKAGE_E2FSPROGS_RESIZE2FS
	help
	  Kernel and device tree on the card's FAT partition, root on its
	  second partition (ext4). Onboard flash is never written.

config BR2_PACKAGE_NOVATEK_UBOOT_BOOT_NAND
	bool "SPI NAND"
	select BR2_PACKAGE_HOST_MTD
	help
	  Device tree in the fdt partition, kernel and squashfs root in UBI
	  volumes. The loader partition is never written: a card boot always
	  recovers.

endchoice

endif
