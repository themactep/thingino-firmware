#!/bin/sh
# shellcheck disable=SC3043,SC2017 # SC2017: a/b*c is intentional integer ceil-division for 64 KiB alignment
# flash-ota - minimal host-driven OTA flasher.
# Pre-assembled partition files are uploaded by the host; this script
# flashes them to the matching MTD partitions and reboots.

# Usage: flash-ota <mode> <file> [file2]
#   flash-ota boot   /tmp/boot.bin /tmp/env.bin
#   flash-ota kernel /tmp/kernel.bin
#   flash-ota rootfs /tmp/rootfs.bin /tmp/data.bin

mode="$1"
shift

echo "flash-ota: mode=$mode files=$*"

mtd_dev() { awk -F: "/\"$1\"\$/{print \$1}" /proc/mtd; }

# Partition geometry from /proc/mtd (KiB).  ROOTFS_OFF_K / DATA_OFF_K are
# the chip offsets of the rootfs and data partitions.
read_mtd_layout() {
	ROOTFS_K=0
	DATA_K=0
	ROOTFS_OFF_K=0
	DATA_OFF_K=0
	local dev size name off=0
	while read -r dev size _ name; do
		case "$dev" in
			mtd[0-9]:) ;;
			*) continue ;;
		esac
		size=$((0x$size / 1024))
		case "$name" in
			'"rootfs"')
				ROOTFS_K=$size
				ROOTFS_OFF_K=$off
				;;
			'"data"')
				DATA_K=$size
				DATA_OFF_K=$off
				;;
		esac
		off=$((off + size))
	done </proc/mtd
}

# Write a file to an MTD device at a KiB offset and verify by checksum.
write_at() {
	local mtd="$1" file="$2" offset_k="$3" label="$4"
	local size want have
	size=$(stat -c%s "$file")
	echo "Writing $label ($(((size + 1023) / 1024))KiB) to /dev/$mtd at ${offset_k}KiB"
	dd if="$file" of="/dev/$mtd" bs=1024 seek="$offset_k" 2>/dev/null || {
		echo "ERROR: write $label failed"
		return 1
	}
	want=$(md5sum "$file" | cut -d' ' -f1)
	have=$(dd if="/dev/$mtd" bs=1024 skip="$offset_k" count=$(((size + 1023) / 1024)) 2>/dev/null | head -c "$size" | md5sum | cut -d' ' -f1)
	[ "$want" = "$have" ] || {
		echo "ERROR: verify $label failed"
		return 1
	}
}

# Point U-Boot's mtdparts at the new rootfs/data sizes so the kernel carves
# the partitions we just flashed.
set_mtdparts() {
	local new_rootfs_k="$1" new_data_k="$2" cur new got
	cur=$(fw_printenv mtdparts 2>/dev/null | cut -d= -f2-)
	[ -n "$cur" ] || {
		echo "ERROR: cannot read current mtdparts"
		return 1
	}
	new=$(printf '%s\n' "$cur" | sed "s/,[0-9]*k(rootfs),[0-9]*k(data)/,${new_rootfs_k}k(rootfs),${new_data_k}k(data)/")
	[ "$new" != "$cur" ] || {
		echo "ERROR: cannot compose new mtdparts from '$cur'"
		return 1
	}
	echo "Updating U-Boot mtdparts to $new"
	fw_setenv mtdparts "$new" || {
		echo "ERROR: fw_setenv mtdparts failed"
		return 1
	}
	got=$(fw_printenv mtdparts 2>/dev/null | cut -d= -f2-)
	[ "$got" = "$new" ] || {
		echo "ERROR: mtdparts verification failed (got '$got')"
		return 1
	}
}

flush_memory() {
	echo "Syncing and dropping caches..."
	sync
	echo 3 >/proc/sys/vm/drop_caches 2>/dev/null || true
}

stop_streamer() {
	echo "Stopping streamer..."
	if [ -x /etc/init.d/S31raptor ]; then
		/etc/init.d/S31raptor stop
	elif [ -x /etc/init.d/S31prudynt ]; then
		/etc/init.d/S31prudynt stop
	else
		killall prudynt 2>/dev/null || true
	fi
	sleep 1
}

flash_one() {
	local mtd="$1" file="$2" label="$3"
	echo "Flashing $label from $file to /dev/$mtd"
	if flashcp -A 2>&1 | grep -qE 'unrecognized|invalid option'; then
		flash_eraseall "/dev/$mtd" 2>/dev/null || true
		flashcp -v "$file" "/dev/$mtd" || {
			echo "ERROR: flash $label failed"
			return 1
		}
	else
		flashcp -v -A "$file" "/dev/$mtd" || {
			echo "ERROR: flash $label failed"
			return 1
		}
	fi
}

stop_streamer
flush_memory

# Resolve MTD names now (while rootfs is still mounted rw).
# For rootfs mode we clone busybox afterwards so we survive
# erasing the rootfs partition.
case "$mode" in
	boot)
		BOOT_MTD=$(mtd_dev boot)
		ENV_MTD=$(mtd_dev env)
		;;
	kernel)
		KERNEL_MTD=$(mtd_dev kernel)
		;;
	rootfs)
		ROOTFS_MTD=$(mtd_dev rootfs)
		DATA_MTD=$(mtd_dev data)
		ALL_MTD=$(mtd_dev all)
		;;
esac

# Rootfs mode: clone busybox to tmpfs and remount rootfs read-only
# before erasing it.  After the remount we must only use tmpfs binaries.
if [ "$mode" = "rootfs" ]; then
	echo "Preparing tmpfs environment..."
	workdir="/tmp/flash-ota.d"
	mkdir -p "$workdir"
	cp /bin/busybox "$workdir/busybox"
	for a in dd echo flash_eraseall head md5sum reboot stat sync sleep cut; do
		ln -sf "$workdir/busybox" "$workdir/$a"
	done
	export PATH="$workdir:$PATH"

	echo "Remounting rootfs read-only..."
	mount -o remount,ro / 2>/dev/null || {
		echo "Warning: remount ro failed, trying to proceed..."
	}
fi

case "$mode" in
	boot)
		[ "$#" -ge 1 ] || {
			echo "Usage: flash-ota boot <boot.bin> [env.bin]"
			exit 1
		}
		flash_one "$BOOT_MTD" "$1" "boot" || exit 1
		if [ "$#" -ge 2 ] && [ -f "$2" ]; then
			flash_one "$ENV_MTD" "$2" "env" || exit 1
		fi
		;;
	kernel)
		[ "$#" -ge 1 ] || {
			echo "Usage: flash-ota kernel <kernel.bin>"
			exit 1
		}
		flash_one "$KERNEL_MTD" "$1" "kernel" || exit 1
		;;
	rootfs)
		[ "$#" -ge 1 ] || {
			echo "Usage: flash-ota rootfs <rootfs.bin> [data.bin]"
			exit 1
		}
		rootfs_file="$1"
		data_file="$2"
		[ -f "$rootfs_file" ] || {
			echo "ERROR: $rootfs_file not found"
			exit 1
		}
		rootfs_size=$(stat -c%s "$rootfs_file")
		data_size=0
		[ -n "$data_file" ] && [ -f "$data_file" ] && data_size=$(stat -c%s "$data_file")

		read_mtd_layout

		# rootfs and data together occupy a fixed region (everything after the
		# kernel); the new data partition is always that region minus the new
		# rootfs, so the pair fits whenever the two images together do.
		new_rootfs_k=$(((rootfs_size + 65535) / 65536 * 64))
		new_data_k=$(((data_size + 65535) / 65536 * 64))
		combined_k=$((ROOTFS_K + DATA_K))
		[ $((new_rootfs_k + new_data_k)) -le "$combined_k" ] || {
			echo "ERROR: rootfs+data (${new_rootfs_k}+${new_data_k}KiB) exceed combined partitions (${combined_k}KiB)"
			exit 1
		}
		[ "$DATA_OFF_K" -eq $((ROOTFS_OFF_K + ROOTFS_K)) ] || {
			echo "ERROR: rootfs and data partitions are not adjacent, cannot flash as one region"
			exit 1
		}
		[ -n "$ALL_MTD" ] || {
			echo "ERROR: no 'all' partition available for combined flash"
			exit 1
		}

		# Repoint mtdparts before erasing anything: fw_printenv/fw_setenv
		# live on the rootfs partition about to be erased, and nothing
		# survives on the device once it is gone. If this fails, the
		# camera is still intact and bootable.
		if [ "$new_rootfs_k" -ne "$ROOTFS_K" ]; then
			set_mtdparts "$new_rootfs_k" $((combined_k - new_rootfs_k)) || exit 1
		fi

		echo "Flashing rootfs (${new_rootfs_k}KiB) + data ($((combined_k - new_rootfs_k))KiB) as one region"
		flash_eraseall "/dev/$ROOTFS_MTD" || exit 1
		flash_eraseall "/dev/$DATA_MTD" || exit 1
		write_at "$ALL_MTD" "$rootfs_file" "$ROOTFS_OFF_K" "rootfs" || exit 1
		if [ "$data_size" -gt 0 ]; then
			write_at "$ALL_MTD" "$data_file" $((ROOTFS_OFF_K + new_rootfs_k)) "data" || exit 1
		fi
		;;
	*)
		echo "Unknown mode: $mode (valid: boot, kernel, rootfs)"
		exit 1
		;;
esac

sync
echo "Flash complete. Rebooting..."
reboot -f
