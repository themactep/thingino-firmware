#!/tmp/busybox sh

export PATH="/tmp/sysupgrade"
echo "stage 2 PATH is $PATH"

echo_c() {
	echo -e "\e[38;5;$1m$2\e[0m"
}

die() {
	echo_c 160 "$1"
	exit 1
}

# Rewrite the config snapshot at the offset the new layout uses.  The image
# pass erased and rewrote that block with the image's blank 0xFF, so a plain
# dd programs it without another erase.  The 'all' partition starts at chip
# offset 0, which makes the seek arithmetic direct.
write_backup() {
	local off file mtd magic
	[ "$DO_BACKUP" = "true" ] || return 0
	off="${BACKUP_OFF:-}"
	file="${BACKUP_FILE:-}"
	[ -n "$off" ] || {
		echo_c 160 "Config backup offset is not set"
		return 1
	}
	[ -f "$file" ] || {
		echo_c 160 "Config backup file $file not found"
		return 1
	}
	[ "$off" -ge 65536 ] && [ $((off % 65536)) -eq 0 ] || {
		echo_c 160 "Config backup offset $off is not a valid 64K block"
		return 1
	}
	mtd=""
	while read -r dev _ _ name; do
		dev="${dev%:}"
		name="${name#\"}"
		name="${name%\"}"
		[ "$name" = "all" ] && {
			mtd="$dev"
			break
		}
	done <<EOF
$(tail -n +2 /proc/mtd)
EOF
	[ -n "$mtd" ] || {
		echo_c 160 "No 'all' partition to write the config backup"
		return 1
	}
	echo_c 112 "Writing config backup to /dev/$mtd at offset $off"
	dd if="$file" of="/dev/$mtd" bs=65536 seek=$((off / 65536)) count=1 2>/dev/null || {
		echo_c 160 "Config backup write failed"
		return 1
	}
	sync
	magic=$(dd if="/dev/$mtd" bs=1 skip="$off" count=10 2>/dev/null)
	[ "$magic" = "THNG_BCKUP" ] || {
		echo_c 160 "Config backup read-back failed"
		return 1
	}
	echo "Config backup restored"
}

flash_firmware() {
	echo_c 112 "\nFlashing firmware to $mtd_dev"
	local test_output
	test_output=$(flashcp -A 2>&1) || true
	case "$test_output" in
		*"unrecognized option"*)
			echo_c 112 "flashcp lacks -A support; erasing partition first"
			flash_eraseall $mtd_dev
			flashcp -v $fw_file $mtd_dev
			;;
		*)
			flashcp -v -A $fw_file $mtd_dev
			;;
	esac
}

flash_full() {
	local mtd sz name needle fw_size align_block bs sz_dec flash_size
	fw_size=$(wc -c <"$fw_file")
	align_block=32768
	needle=0
	tail -n +2 /proc/mtd >/tmp/sysupgrade/mtd.txt

	# The image is written partition by partition from offset 0; a file
	# larger than the sum of the real partitions would run past the end of
	# flash. Refuse before erasing anything.
	flash_size=0
	while read -r _ sz _ name; do
		name="${name#\"}"
		name="${name%\"}"
		[ "$name" = "all" ] && continue
		[ "$name" = "upgrade" ] && continue
		flash_size=$((flash_size + 0x$sz))
	done </tmp/sysupgrade/mtd.txt
	if [ "$fw_size" -gt "$flash_size" ]; then
		echo_c 160 "Firmware is larger than the flash: $fw_size > $flash_size"
		echo_c 160 "Refusing to flash an oversized image."
		return 1
	fi

	# The partition list is the running layout, but the copy preserves
	# absolute offsets, so the image's own layout wins even when the two
	# differ. The config snapshot is rewritten afterwards by write_backup().
	while read -r mtd sz _ name; do
		mtd="${mtd%:}"
		name="${name#\"}"
		name="${name%\"}"
		[ "$name" = "all" ] && continue
		[ "$name" = "upgrade" ] && continue
		[ "$needle" -ge "$fw_size" ] && break
		sz_dec=$((0x$sz))
		echo_c 112 "Flashing $name to /dev/$mtd ($sz_dec bytes at offset $needle)"
		flash_eraseall "/dev/$mtd" 2>/dev/null || true
		bs=$align_block
		if [ $((needle % align_block)) -ne 0 ] ||
			[ $((sz_dec % align_block)) -ne 0 ]; then
			bs=1
		fi
		if ! dd if="$fw_file" of="/dev/$mtd" bs=$bs \
			skip=$((needle / bs)) count=$((sz_dec / bs)) 2>/dev/null; then
			echo_c 160 "dd $name failed"
			return 1
		fi
		sync
		needle=$((needle + sz_dec))
	done </tmp/sysupgrade/mtd.txt

	if [ "$DO_BACKUP" = "true" ]; then
		write_backup || echo_c 160 "WARNING: config backup was not restored"
	fi
	return 0
}

WATCHDOG_DEV="${WATCHDOG_DEV:-/dev/watchdog}"
wd_stop_flag="/tmp/sysupgrade/wd.stop"
wd_active=""

takeover_watchdog() {
	[ -c "$WATCHDOG_DEV" ] || return 0

	echo_c 112 "\nTaking over hardware watchdog"

	# The Ingenic JZ_WDT driver only allows one opener at a time, so we
	# must stop the existing daemon before we can open the device.
	# SIGTERM lets the busybox watchdog daemon write the magic 'V' that
	# disarms the hardware timer, then close its fd cleanly.
	if pidof watchdog >/dev/null 2>&1; then
		killall watchdog 2>/dev/null

		local i=0
		while pidof watchdog >/dev/null 2>&1; do
			i=$((i + 1))
			if [ $i -gt 10 ]; then
				echo "Watchdog daemon did not exit, leaving it alone."
				return 0
			fi
			sleep 1
		done
	fi

	# Run the real busybox watchdog from tmpfs so erasing rootfs
	# cannot kill it. 10-second timeout means fast recovery if the
	# flash hangs; feed interval is half that (5s).
	rm -f "$wd_stop_flag"
	watchdog -T 10 -t 5 -F "$WATCHDOG_DEV" &
	wd_active="true"
	echo "Hardware watchdog is now fed from tmpfs (10s timeout)."
}

disarm_watchdog() {
	[ "true" = "$wd_active" ] || return 0
	echo "Disarming hardware watchdog."
	# SIGTERM makes the watchdog applet write 'V' and exit cleanly.
	killall watchdog 2>/dev/null
	sleep 1
	wd_active=""
}

stop_streamer() {
	echo_c 112 "\nStopping streamer in detached stage"
	if [ -x /etc/init.d/S31raptor ]; then
		/etc/init.d/S31raptor stop
	elif [ -x /etc/init.d/S31prudynt ]; then
		/etc/init.d/S31prudynt stop
	else
		killall prudynt 2>/dev/null || true
		sleep 1
		pidof prudynt >/dev/null 2>&1 && killall -9 prudynt 2>/dev/null || true
	fi
	sleep 1
}

stream_flash_progress() {
	local logfile="$1"
	local pid="$2"
	local tail_pid=""

	if command -v tail >/dev/null 2>&1; then
		tail -n 20 -f "$logfile" &
		tail_pid=$!
	else
		echo "tail not available in PATH, monitor $logfile manually."
	fi

	wait "$pid"
	local status=$?

	if [ -n "$tail_pid" ]; then
		kill "$tail_pid" 2>/dev/null
		wait "$tail_pid" 2>/dev/null
	fi

	echo ""
	return $status
}

# Detach from terminal and protect against disconnections during flash
detach_and_flash() {
	logfile="/tmp/sysupgrade-flash.log"
	: >"$logfile"

	echo_c 208 "CRITICAL PHASE: Detaching from terminal to protect against connection loss..."
	echo "Process will continue even if SSH disconnects."
	echo "Log file: $logfile"
	echo ""

	# Run in subshell detached from terminal
	(
		# Protect against all signals during flash
		trap '' HUP INT TERM

		exec >$logfile 2>&1

		echo "=== Flash operation started at $(date) ==="
		stop_streamer
		takeover_watchdog

		MAX_TRIES=3
		x=0
		times=""
		flash_fn="flash_firmware"
		[ "$mode" = "full" ] && flash_fn="flash_full"
		while :; do
			x=$((x+1))
			if $flash_fn; then
				echo "=== Flash completed successfully at $(date) ==="
				go_reboot
				exit 1
			fi
			[ $x -gt 1 ] && times=" $x times"
			echo "Flashing failed${times}."
			[ $x -gt $MAX_TRIES ] && break
			echo "Retrying in 5 seconds..."
			sleep 5
		done
		echo "Flashing failed after $MAX_TRIES attempts!"
		echo "WARNING: You may need to perform a recovery flash restore before rebooting the camera!"
		disarm_watchdog
		exit 1
	) </dev/null &

	flash_pid=$!
	echo "Flash process running with PID $flash_pid (safe to disconnect)"
	echo "Streaming flash progress (Ctrl-C stops viewing, flashing continues)..."

	stream_flash_progress "$logfile" "$flash_pid"
	flash_status=$?

	if [ $flash_status -eq 0 ]; then
		echo_c 46 "Flash completed successfully. Rebooting shortly..."
		echo "Rebooting"
	else
		echo_c 160 "Flash failed; consult $logfile for details."
	fi

	exit $flash_status
}

go_reboot() {
	echo "Rebooting in 5 seconds..."
	sleep 5
	sync
	if [ -w /proc/jz/reset/reset ]; then
		echo wdt > /proc/jz/reset/reset
	fi
	sleep 2
	reboot -f
}

mode=""
case "$1" in
	full)
		mode="full"
		shift
		fw_file="$1"
		[ -z "$fw_file" ] && die "Firmware file is not set."
		mtd_dev=""
		;;
	*)
		[ -z "$1" ] && die "Firmware file is not set."
		[ -z "$2" ] && die "Target device is not set."
		fw_file="$1"
		mtd_dev="/dev/$2"
		;;
esac

echo_c 208 "Running Stage 2 of sysupgrade."
echo "Firmware: $fw_file"
[ -n "$mtd_dev" ] && echo "Target: $mtd_dev"
echo ""
echo "You can still press Ctrl-C to abort before flashing starts."
echo ""

# Call the detached flash function which will protect the session
detach_and_flash
