#!/bin/sh

OS_RELEASE_FILE="/etc/os-release"

start() {
	echo -c 15 "Setting initial system time"

	if [ ! -f "$OS_RELEASE_FILE" ]; then
		echo -c 160 -e "No release file found, not setting system clock" >&2
		exit 1
	fi

	build=$(awk -F'=' '/^BUILD_TIMESTAMP/{print $2}' "$OS_RELEASE_FILE")

	# A clock already past the build came from a battery-backed RTC
	if [ "$(date -u +%s)" -ge "$build" ] 2>/dev/null; then
		echo -c 240 -e "- $(date) (RTC)"
	elif date -u -s "@$build" >/dev/null; then
		echo -c 240 -e "- $(date) (fail-safe)"
	else
		echo -c 160 -e "Failed to set time" >&2
		exit 1
	fi
}

case "$1" in
	start)
		start
		;;
	stop)
		# Save NTP time to a battery-backed RTC
		if [ -e /run/sync_success ] && [ -e /dev/rtc0 ] && command -v hwclock >/dev/null; then
			hwclock -w -u
		fi
		;;
	*)
		echo "Usage: $0 {start|stop}"
		exit 1
		;;
esac

exit 0
