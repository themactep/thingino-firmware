#!/bin/sh

TZCODE_FILE="/etc/TZ"
TZJSON_FILE="/usr/share/tz.json"
TZUSER_FILE="/etc/tz.user.json"
TZNAME_FILE="/etc/timezone"

start() {
	echo -c 15 "Setting timezone"

	if [ ! -f "$TZNAME_FILE" ]; then
		echo -c 240 -e "- Timezone name not found, default to GMT"
		echo "Etc/GMT" >"$TZNAME_FILE"
	fi

	echo -c 240 -e "- Timezone name: $(cat $TZNAME_FILE)"
	tzname=$(cat "$TZNAME_FILE")

	if [ ! -f "$TZJSON_FILE" ]; then
		echo -c 160 -e "$TZJSON_FILE not found" >&2
		exit 1
	fi

	# /etc/tz.user.json is the partial override layer; a user entry wins.
	tz=""
	if [ -f "$TZUSER_FILE" ]; then
		tz=$(jct "$TZUSER_FILE" get "$tzname" 2>/dev/null)
	fi
	if [ -z "$tz" ]; then
		tz=$(cat "$TZJSON_FILE" | sed 's/},{/\n/g' | sed 's/^\[{//;s/}\]$//' |
			sed 's/"n":"\([^"]*\)","v":"\([^"]*\)"/\1:\2/' |
			grep -F "${tzname}:" | head -1 | cut -d: -f2-)
	fi

	if [ -z "$tz" ]; then
		echo -c 160 -e "Timezone $tzname not found in $TZJSON_FILE" >&2
		exit 1
	fi

	if [ ! -f "$TZCODE_FILE" ]; then
		echo -c 240 -e "- Timezone code not found, default to GMT0"
		echo "GMT0" >"$TZCODE_FILE"
	fi

	if [ "$tz" != "$(cat $TZCODE_FILE)" ]; then
		echo -c 240 -e "- Set timezone to $tz"
		echo "$tz" >"$TZCODE_FILE"
	fi

	echo -c 240 -e "- Set TZ to $tz"
	TZ="$tz"

	echo -c 240 -e "- Export TZ globally"
	export TZ
}

case "$1" in
	start)
		start
		;;
	stop)
		true
		;;
	restart)
		start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac

exit 0
