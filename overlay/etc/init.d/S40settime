#!/bin/sh
# Set the clock before the rest of userspace starts.
#
# The kernel has no RTC and comes up on the firmware build time, so every
# service that logs before S49ntpd is timestamped with the build date. Do a
# blocking one-shot sync once the network is up so those timestamps are real.
#
# Runs between S40network and S41ifplugd: it needs a route to the server, and
# S41 needs a correct clock for its own messages.

NTP_DEFAULT_FILE="/etc/default/ntp.conf"
NTP_WORKING_FILE="/tmp/ntp.conf"

# Same config resolution as S49ntpd so the two cannot diverge.
get_config_file() {
	if [ -f "$NTP_WORKING_FILE" ]; then
		printf '%s' "$NTP_WORKING_FILE"
	elif [ -f "$NTP_DEFAULT_FILE" ]; then
		printf '%s' "$NTP_DEFAULT_FILE"
	fi
}

# BusyBox ntpd has no timeout option, so bound it from outside. The server is
# on the local network: if it does not answer quickly, something is wrong and
# boot should not wait for it.
SYNC_TIMEOUT=3

start() {
	echo -c 15 "Setting clock"

	# AP/portal modes have no upstream server to query.
	if [ -f /run/wlan_ap_mode ] || [ -f /run/portal_mode ]; then
		echo -c 142 -e "- AP/portal mode, skipping" >&2
		return 0
	fi

	config_file="$(get_config_file)"
	if [ -z "$config_file" ]; then
		echo -c 142 -e "- No NTP configuration, keeping build time" >&2
		return 0
	fi

	# ntpd -q -n exits after the first sync; -p overrides the server list
	# with the one already resolved in the config file.
	peer="$(awk '$1 == "server" { print $2; exit }' "$config_file" 2>/dev/null)"
	if [ -z "$peer" ]; then
		echo -c 142 -e "- No NTP server configured, keeping build time" >&2
		return 0
	fi

	echo -c 240 -e "- Syncing with $peer"
	if timeout "$SYNC_TIMEOUT" ntpd -q -n -p "$peer" >/dev/null 2>&1; then
		echo -c 240 -e "- Clock set to $(date)"
	else
		echo -c 142 -e "- Sync failed, keeping build time" >&2
	fi

	return 0
}

# The clock is not a service; there is nothing to undo.
stop() {
	true
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart)
		start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac

exit 0
