#!/bin/sh
# shellcheck disable=SC1090

USB_SCRIPT="/etc/init.d/F02failsafe-usb"
OS_RELEASE_FILE="/etc/os-release"

usb_console=$(jct /etc/thingino.json get usb.console 2>/dev/null || fw_printenv -n usb_console)

start() {
	if [ "true" = "$usb_console" ] && [ -f "$USB_SCRIPT" ]; then
		exit 0
	fi

	# Always enter failsafe if enable_failsafe is true.
	# Set the marker and return: the console shell is started by the
	# console::respawn action in inittab, not from here. Blocking a
	# ::sysinit: action would stop init from ever reading its delayed
	# reboot/halt/poweroff signals.
	if [ "true" = "$(fw_printenv -n enable_failsafe 2>/dev/null)" ]; then
		echo -c 118 "Automatically entering failsafe mode..."
		touch /tmp/.fs
		return
	fi

	echo
	echo -c 104 "Press the [f] key to enter failsafe mode"
	echo

	stty -icanon min 0 time 20 -echo
	key=$(dd bs=1 count=1 2>/dev/null)
	stty sane

	if [ "f" = "$key" ]; then
		echo -c 118 "Failsafe mode..."
		touch /tmp/.fs
		return
	fi

	if [ -f "$OS_RELEASE_FILE" ]; then
		. "$OS_RELEASE_FILE"
		echo -c 208 "Thingino firmware built for $IMAGE_ID"
		echo -c 208 "[$BUILD_ID]"
	fi

	/etc/init.d/rcS
}

case "$1" in
	start)
		start
		;;
	stop)
		true
		;;
	restart)
		true
		;;
	*)
		true
		;;
esac

exit 0
