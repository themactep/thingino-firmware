#!/bin/sh
# shellcheck disable=SC2086
# shellcheck disable=SC3043

# shellcheck source=/dev/null
. /etc/init.d/lib-log

start() {
	log -c 15 "Starting network"

	# Wake the Ethernet PHY if the board declares a reset line.
	# This runs BEFORE the portal/AP short-circuit below: the pulse is a
	# no-op on boards that do not declare gpio.eth.toggle, and the PHY
	# must be out of reset for any later ifup to succeed. The line is
	# left in the deasserted state.
	local toggle
	toggle=$(jct /etc/thingino.json get gpio.eth.toggle 2>/dev/null)
	if [ "true" = "$toggle" ]; then
		local pin active assert deassert
		pin=$(jct /etc/thingino.json get gpio.eth.pin 2>/dev/null)
		active=$(jct /etc/thingino.json get gpio.eth.active_low 2>/dev/null)
		if [ "true" = "$active" ]; then
			assert=0
			deassert=1
		else
			assert=1
			deassert=0
		fi
		gpio set $pin $deassert
		sleep 0.05
		gpio set $pin $assert
		sleep 0.05
		gpio set $pin $deassert
	fi

	if [ -f /run/wlan_ap_mode ] || [ -f /run/portal_mode ]; then
		log -c 160 -e "WiFi in AP/portal mode, skipping network bring-up" >&2
		# Ensure loopback is up (normally done by ifup -a)
		ip addr add 127.0.0.1/8 dev lo 2>/dev/null || true
		ip link set lo up 2>/dev/null || true
		exit 0
	fi

	ifup -v -a
}

stop() {
	log -c 15 "Stopping network"

	ifdown -v -a
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart)
		stop
		sleep 1
		start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac

exit 0
