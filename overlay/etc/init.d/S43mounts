#!/bin/sh

# The automatic boot-time mount is handled by the if-up.d/mount_nfs
# hook, which fires only after the link is actually up. This script is
# retained as a manual start/stop entry point for the NFS mount.

# shellcheck source=/dev/null
. /etc/init.d/lib-log

NFS_MOUNT="/mnt/nfs"

nfs_enabled="$(jct /etc/thingino.json get nfs.enabled 2>/dev/null)"
nfs_share="$(jct /etc/thingino.json get nfs.share 2>/dev/null)"

start() {
	log -c 15 "Mount $NFS_MOUNT"

	if [ "$nfs_enabled" != "true" ]; then
		log -c 142 -e "NFS mount is disabled (run '$0 force' to enable and mount)" >&2
		return 0
	fi

	if [ -z "$nfs_share" ]; then
		log -c 240 -e "- Mount share is not set"
		return 0
	fi

	if mountpoint -q "$NFS_MOUNT"; then
		log -c 160 -e "$NFS_MOUNT already mounted" >&2
		return 0
	fi

	# hard, not soft: a soft mount aborts a stalled write after ~9s and
	# returns EIO, which silently corrupts recordings (1 MiB holes where
	# the MP4 init segment lives). hard blocks instead of losing data.
	if mount -o nolock,hard,timeo=30,retrans=2 "$nfs_share" "$NFS_MOUNT"; then
		log -c 240 -e "- Mounted $nfs_share on $NFS_MOUNT"
	else
		log -c 160 -e "Failed to mount $nfs_share on $NFS_MOUNT" >&2
		exit 1
	fi
}

stop() {
	log -c 15 "Unmount $NFS_MOUNT"

	if ! mountpoint -q "$NFS_MOUNT"; then
		log -c 240 -e "- $NFS_MOUNT is not mounted"
		return 0
	fi

	if umount -l "$NFS_MOUNT"; then
		log -c 240 -e "- $NFS_MOUNT unmounted"
	else
		log -c 160 -e "Failed to unmount $nfs_share" >&2
		exit 1
	fi
}

force() {
	if ! jct /etc/thingino.json set nfs.enabled true; then
		log -c 160 -e "Failed to enable NFS mount in /etc/thingino.json" >&2
		exit 1
	fi
	nfs_enabled="true"
	start
}

case "$1" in
	start)
		start
		;;
	force)
		force
		;;
	stop)
		stop
		;;
	restart)
		stop
		sleep 2
		start
		;;
	*)
		echo "Usage: $0 {start|stop|restart|force}"
		exit 1
		;;
esac

exit 0
