#!/bin/sh
# shellcheck disable=SC2046,SC2086,SC3037,SC3043

die() {
	printf "\e[38;5;160mInit: [ERROR] %s\e[0m\n" "$1" >&2
	exit 1
}

on_exit() {
	mountpoint -q /proc && umount /proc
	exec /sbin/init "$@"
}

format_overlay() {
	dmesg | grep -q "jffs2.*: Magic bitmask.*not found" || return 0
	echo -e "\e[38;5;208mInit: Invalid JFFS2 blocks detected. Formatting required.\e[0m" >&2
	umount /overlay
	flash_eraseall -j /dev/$(awk -F: '/"data"/{print $1}' /proc/mtd)
	mount_jffs2 data /overlay
	mount_overlay || return 1
}

mount_jffs2() {
	local name mtd blk target

	name=$1
	[ -z "$name" ] && die "Missing partition name!"

	target=$2
	[ -z "$target" ] && target="/$name"

	mtd=$(awk -F: "/$name/{print \$1}" /proc/mtd)
	[ -z "$mtd" ] && die "Partition $name not found!"

	blk=$(awk -F: "/$name/{print \$1}" /proc/mtd | sed 's/mtd/mtdblock/')

	mount -t jffs2 -o noatime /dev/$blk $target 2>/dev/null || {
		echo "Init: [WARNING] $name empty or corrupt. Formatting..."
		flash_eraseall -j /dev/$mtd
		mount -t jffs2 -o noatime /dev/$blk $target ||
			die "Failed to mount /dev/$blk as $target!"
	}
}

mount_ubifs() {
	local volname target
	volname=$1
	[ -z "$volname" ] && die "Missing UBI volume name!"

	target=$2
	[ -z "$target" ] && target="/$volname"

	mount -t ubifs -o noatime ubi0:$volname $target 2>/dev/null ||
		die "Failed to mount ubi0:$volname as $target!"
}

# True when the partition root holds a flat upperdir: any entry other than the
# new container, the workdir, or the migration markers themselves.
flat_upper_present() {
	for entry in /overlay/* /overlay/.[!.]*; do
		[ -e "$entry" ] || continue
		case "$entry" in
			/overlay/root | /overlay/work | /overlay/.overlay-migrated | /overlay/.overlay-old-root | /overlay/.overlay-old-work) continue ;;
		esac
		return 0
	done
	return 1
}

# Fold a legacy flat upperdir into the shared DATA/root container. Only the
# 3.10 driver ever lands here: its upperdir is the partition root, so DATA/root
# and DATA/work are the uppers of /root and /work and must be shuffled aside,
# not consumed as the container.
migrate_flat_upper() {
	if [ -e /overlay/root ]; then
		mv /overlay/root /overlay/.overlay-old-root || return 1
	fi
	if [ -e /overlay/work ]; then
		mv /overlay/work /overlay/.overlay-old-work || return 1
	fi
	mkdir -p /overlay/root || return 1
	for entry in /overlay/* /overlay/.[!.]*; do
		[ -e "$entry" ] || continue
		case "$entry" in
			/overlay/root | /overlay/.overlay-migrated | /overlay/.overlay-old-root | /overlay/.overlay-old-work) continue ;;
		esac
		mv -- "$entry" /overlay/root/ || return 1
	done
	if [ -e /overlay/.overlay-old-root ]; then
		mv /overlay/.overlay-old-root /overlay/root/root || return 1
	fi
	if [ -e /overlay/.overlay-old-work ]; then
		mv /overlay/.overlay-old-work /overlay/root/work || return 1
	fi
	return 0
}

prepare_overlay_dirs() {
	overlay_rootdir="/overlay/root"
	overlay_workdir="/overlay/work"

	# One-time layout migration, marked so it can never rerun. Mainline
	# devices already keep the upperdir at DATA/root; only a legacy 3.10
	# partition with a flat upper needs folding in.
	if [ ! -e /overlay/.overlay-migrated ]; then
		if grep -q overlayfs /proc/filesystems && flat_upper_present; then
			migrate_flat_upper || return 1
		fi
		: >/overlay/.overlay-migrated || return 1
	fi

	mkdir -p "$overlay_rootdir" || return 1
	rm -rf "$overlay_workdir"
	mkdir -p "$overlay_workdir" || return 1
}

mount_overlay() {
	prepare_overlay_dirs || return 1

	# Legacy driver: no workdir option, accepts a subdirectory as upperdir.
	if grep -q overlayfs /proc/filesystems; then
		mount -t overlayfs -o noatime,lowerdir=/,upperdir="$overlay_rootdir" overlay /mnt && return 0
		return 1
	fi

	# Mainline driver: workdir must sit outside the upperdir.
	mount -t overlay -o noatime,lowerdir=/,upperdir="$overlay_rootdir",workdir="$overlay_workdir" overlay /mnt && return 0
	return 1
}

trap 'on_exit "$@"' EXIT

# Mount /proc
mount -t proc proc /proc ||
	die "Failed to mount /proc!"

# Skip if rootfs is NFS, MMC or RAM
grep -q 'root=.*nfs\|mmcblk\|ram' /proc/cmdline &&
	die "Not an MTD RootFS!"

# Mount data partition (single overlay covering whole filesystem)
if grep -q 'ubi\.mtd=' /proc/cmdline; then
	mount_ubifs overlay /overlay
else
	mount_jffs2 data /overlay
fi

mount_overlay || die "Failed to mount overlay!"

# Pivot root to overlay
pivot_root /mnt /mnt/rom || die "Failed to pivot_root!"
mount -o noatime,move /rom/proc /proc
mount -o noatime,move /rom/dev /dev

# Move data partition to new root
mount -o noatime,move /rom/overlay /overlay || die "Failed to move /overlay"

# Expose the writable layer at /overlay, so /overlay/<path> is the upper of
# /<path> on every overlay driver. The partition root (with work/) stays
# mounted underneath; the kernel already holds the workdir from mount time.
mount -o bind /overlay/root /overlay || die "Failed to bind /overlay"
