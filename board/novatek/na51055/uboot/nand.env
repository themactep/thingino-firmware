# thingino default environment, flash install: DTB in the fdt partition, kernel and squashfs root in
# UBI volumes. autoupdate-full.bin (NAND from the fdt partition up) on card partition 1, FAT or ext4,
# reflashes once; the erase starts at 0x40000, so the loader is never touched. U-Boot cannot write
# ext4, so the flash is marked in the environment: au_flash imports the environment it just wrote,
# sets au_applied and saves it; Linux renames the file and clears au_applied after it mounts the card.
bootdelay=1
baudrate=115200
autoload=no
console=ttyS0,115200
initrd_high=0xffffffff
fdt_high=0xffffffff
kernel_addr=0x03000000
rd_addr=0x05000000
fdt_addr=0x06000000
au_addr=0x08000000
mtdids=nand0=nand0
mtdparts=mtdparts=nand0:256k(loader),256k(fdt),256k(fdt.restore),1m(uboot),128k(uenv),-(ubi)
autoupdate=if test -n "${au_applied}"; then echo "AU: applied"; elif fatsize mmc 0:1 autoupdate-full.bin; then setenv au_fs fat; run au_flash; elif ext4size mmc 0:1 autoupdate-full.bin; then setenv au_fs ext4; run au_flash; fi
au_flash=echo "AU: flashing autoupdate-full.bin (${au_fs})"; ${au_fs}load mmc 0:1 ${au_addr} autoupdate-full.bin && nand erase 0x40000 0x7fc0000 && nand write.trimffs ${au_addr} 0x40000 ${filesize} && nand read ${au_addr} 0x1c0000 0x10000 && env import -d -c ${au_addr} 0x10000 && setenv au_applied 1 && saveenv && echo "AU: done, rebooting" && reset
nand_args=setenv bootargs console=${console} ubi.mtd=ubi ubi.block=0,rootfs root=/dev/ubiblock0_1 rootfstype=squashfs init=/init
nand_boot=nand read ${fdt_addr} 0x40000 0x40000 && ubi part ubi && ubi read ${kernel_addr} kernel && run nand_args && bootm ${kernel_addr} - ${fdt_addr}
net_args=setenv bootargs console=${console} root=/dev/ram0 rootfstype=squashfs init=/init
net_boot=dhcp && tftpboot ${kernel_addr} uImage && tftpboot ${rd_addr} rootfs.img && tftpboot ${fdt_addr} board.dtb && run net_args && bootm ${kernel_addr} ${rd_addr} ${fdt_addr}
bootcmd=run autoupdate; run nand_boot; run net_boot
