# thingino default environment, flash install: DTB in the fdt partition, kernel and squashfs root in
# UBI volumes. A card with autoupdate-full.bin (NAND from the fdt partition up) reflashes once; the
# erase starts at 0x40000, so the loader is never touched.
bootdelay=1
baudrate=115200
autoload=no
console=ttyS0,115200
initrd_high=0xffffffff
fdt_high=0xffffffff
kernel_addr=0x03000000
rd_addr=0x05000000
fdt_addr=0x06000000
au_addr=0x08000000
mtdids=nand0=nand0
mtdparts=mtdparts=nand0:256k(loader),256k(fdt),256k(fdt.restore),1m(uboot),128k(uenv),-(ubi)
autoupdate=if fatsize mmc 0:1 autoupdate-full.done; then echo "AU: already applied"; elif fatload mmc 0:1 ${au_addr} autoupdate-full.bin; then echo "AU: flashing autoupdate-full.bin"; nand erase 0x40000 0x7fc0000 && nand write.trimffs ${au_addr} 0x40000 ${filesize} && fatwrite mmc 0:1 ${au_addr} autoupdate-full.done 1 && echo "AU: done, rebooting" && reset; fi
nand_args=setenv bootargs console=${console} ubi.mtd=ubi ubi.block=0,rootfs root=/dev/ubiblock0_1 rootfstype=squashfs init=/init
nand_boot=nand read ${fdt_addr} 0x40000 0x40000 && ubi part ubi && ubi read ${kernel_addr} kernel && run nand_args && bootm ${kernel_addr} - ${fdt_addr}
net_args=setenv bootargs console=${console} root=/dev/ram0 rootfstype=squashfs init=/init
net_boot=dhcp && tftpboot ${kernel_addr} uImage && tftpboot ${rd_addr} rootfs.img && tftpboot ${fdt_addr} board.dtb && run net_args && bootm ${kernel_addr} ${rd_addr} ${fdt_addr}
# Save the full default environment once, so fw_setenv never starts from an empty one. Not ethaddr:
# the vendor eth driver falls back to one fixed MAC for every board, and Linux has the real one
envinit=if test -z "${envsaved}"; then setenv envsaved 1; setenv ethaddr; saveenv; fi
bootcmd=run envinit; run autoupdate; run nand_boot; run net_boot
