CONFIG_BOOTDELAY=1
CONFIG_USE_DEFAULT_ENV_FILE=y
CONFIG_CMD_DHCP=y
CONFIG_CMD_PING=y
CONFIG_CMD_ECHO=y
CONFIG_CMD_SETEXPR=y
CONFIG_CMD_PART=y
CONFIG_CMD_EXT4=y
# CONFIG_NVT_IVOT_SOC_FW_UPDATE_SUPPORT is not set
CONFIG_CMD_RUN=y
CONFIG_CMD_EDITENV=y
CONFIG_CMD_IMPORTENV=y
# Same bad-block reserve as the vendor kernel: U-Boot attaches UBI first and sizes the overlay volume
CONFIG_MTD_UBI_BEB_LIMIT=30
