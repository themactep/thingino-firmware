# U-Boot model config for NT98529, which the SDK generates from a board's nvt-info and
# nvt-mem-tbl dtsi. The addresses follow the vendor memory map the loader uses: the FDT at
# 0x01800000, U-Boot at 0x1E000000.
CHIP = 98529
BIN_NAME = FW98529A
BIN_NAME_T = FW98529T
EMBMEM = EMBMEM_SPI_NAND
EMBMEM_BLK_SIZE = 0x20000
BOARD_FDT_ADDR = 0x01800000
BOARD_UBOOT_ADDR = 0x1E000000
NVT_ROOTFS_TYPE = NVT_ROOTFS_TYPE_RAMDISK
NVT_LINUX_SMP = NVT_LINUX_SMP_ON
NVT_UBOOT_ENV_IN_STORG_SUPPORT = NVT_UBOOT_ENV_IN_STORG_SUPPORT_OFF
BOOT_OS = BOOT_OS_LINUX
ENCRYPT_ATF = ENCRYPT_ATF_OFF
ENCRYPT_DTS = ENCRYPT_DTS_OFF
ENCRYPT_UBOOT = ENCRYPT_UBOOT_OFF
ENCRYPT_KERNEL = ENCRYPT_KERNEL_OFF
ENCRYPT_RTOS = ENCRYPT_RTOS_OFF
ENCRYPT_OPTEE = ENCRYPT_OPTEE_OFF
ENCRYPT_ROOTFS = ENCRYPT_ROOTFS_OFF
SIGNATUREMETHOD = SIGNATUREMETHOD_OFF
CHECK_SIGNATURE_BEFORE_BOOT = CHECK_SIGNATURE_BEFORE_BOOT_OFF
