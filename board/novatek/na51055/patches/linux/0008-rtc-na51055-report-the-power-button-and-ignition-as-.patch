From 3754b4b35b4d650edf011fb8b807c54d61141df6 Mon Sep 17 00:00:00 2001
From: gtxaspec <gtxent@gmail.com>
Date: Tue, 17 Nov 2026 05:23:53 -0800
Subject: [PATCH] rtc: na51055: report the power button and ignition as keys

PWR_SW1 is reported as KEY_POWER and PWR_SW3 (ignition on the dashcam
boards) as KEY_PROG1, polled every 50 ms: SW3 has no interrupt.
---
 drivers/rtc/rtc-na51055.c | 56 +++++++++++++++++++++++++++++++++++++++
 1 file changed, 56 insertions(+)

diff --git a/drivers/rtc/rtc-na51055.c b/drivers/rtc/rtc-na51055.c
index 9f217708c..f13175ee6 100755
--- a/drivers/rtc/rtc-na51055.c
+++ b/drivers/rtc/rtc-na51055.c
@@ -25,6 +25,7 @@
 #include <linux/semaphore.h>
 #include <linux/proc_fs.h>
 #include <linux/of.h>
+#include <linux/input.h>
 
 #define DRV_VERSION		"1.11.041"
 
@@ -59,6 +60,8 @@ struct nvt_rtc_priv {
 	struct proc_dir_entry *pproc_pwbc;
 	struct proc_dir_entry *pproc_data;
 	struct delayed_work cset_work;
+	struct input_dev *input;
+	struct delayed_work pwrsw_work;
 };
 
 static void rtc_setreg(uint32_t offset, REGVALUE value)
@@ -1055,6 +1058,54 @@ static struct file_operations proc_data_fops = {
 	.write	 = data_proc_cmd_write,
 };
 
+/*
+ * PWR_SW1 is the power button and PWR_SW3 the ignition (ACC) input on the
+ * dashcam boards. Only their pin levels are readable and SW3 has no interrupt,
+ * so both are polled: KEY_POWER is held while the button is, KEY_PROG1 while
+ * ignition is on. The input core drops repeats of an unchanged state.
+ */
+#define NVT_RTC_PWRSW_POLL_MS	50
+
+static void nvt_rtc_pwrsw_poll(struct work_struct *work)
+{
+	struct nvt_rtc_priv *priv = container_of(to_delayed_work(work),
+						 struct nvt_rtc_priv, pwrsw_work);
+	union RTC_PWBCSTS_REG sts;
+
+	sts.reg = rtc_getreg(RTC_PWBCSTS_REG_OFS);
+	input_report_key(priv->input, KEY_POWER, sts.bit.pwr_sw1_pin);
+	input_report_key(priv->input, KEY_PROG1, sts.bit.pwr_sw3_pin);
+	input_sync(priv->input);
+
+	schedule_delayed_work(&priv->pwrsw_work,
+			      msecs_to_jiffies(NVT_RTC_PWRSW_POLL_MS));
+}
+
+static int nvt_rtc_pwrsw_init(struct platform_device *pdev,
+			      struct nvt_rtc_priv *priv)
+{
+	struct input_dev *input = devm_input_allocate_device(&pdev->dev);
+	int ret;
+
+	if (!input)
+		return -ENOMEM;
+
+	input->name = "nvt-rtc-pwrsw";
+	input->phys = "nvt_rtc/input0";
+	input->id.bustype = BUS_HOST;
+	input_set_capability(input, EV_KEY, KEY_POWER);
+	input_set_capability(input, EV_KEY, KEY_PROG1);
+
+	ret = input_register_device(input);
+	if (ret)
+		return ret;
+
+	priv->input = input;
+	INIT_DELAYED_WORK(&priv->pwrsw_work, nvt_rtc_pwrsw_poll);
+	schedule_delayed_work(&priv->pwrsw_work, 0);
+	return 0;
+}
+
 static int nvt_rtc_probe(struct platform_device *pdev)
 {
 	struct rtc_device *rtc;
@@ -1141,6 +1192,9 @@ static int nvt_rtc_probe(struct platform_device *pdev)
 	}
 	priv->rtc = rtc;
 
+	if (nvt_rtc_pwrsw_init(pdev, priv))
+		dev_warn(&pdev->dev, "no power switch input device\n");
+
 	return 0;
 
 out_proc_data:
@@ -1163,6 +1217,8 @@ static int nvt_rtc_remove(struct platform_device *pdev)
 {
 	struct nvt_rtc_priv *priv = platform_get_drvdata(pdev);
 
+	if (priv->input)
+		cancel_delayed_work_sync(&priv->pwrsw_work);
 	if (priv->pproc_data) {
 		proc_remove(priv->pproc_data);
 	}
