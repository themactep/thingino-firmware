From 5aa62d23c6682919fa32f3597aafb4abc79c10e9 Mon Sep 17 00:00:00 2001
From: gtxaspec <gtxent@gmail.com>
Date: Tue, 17 Nov 2026 06:05:35 -0800
Subject: [PATCH] rtc: na51055: power off without waiting for the RTC interrupt

pm_power_off runs with interrupts off, so nvt_rtc_power_control() waited
forever for the cset interrupt and the board hung powered. Poll the RTC
idle instead.
---
 .../include/plat-na51055/rtc_int.h            |  1 +
 arch/arm/plat-novatek/plat-na51055/reset.c    |  2 +-
 drivers/rtc/rtc-na51055.c                     | 32 +++++++++++++++++++
 3 files changed, 34 insertions(+), 1 deletion(-)

diff --git a/arch/arm/plat-novatek/include/plat-na51055/rtc_int.h b/arch/arm/plat-novatek/include/plat-na51055/rtc_int.h
index 7ce5bc902..98e31b9fe 100755
--- a/arch/arm/plat-novatek/include/plat-na51055/rtc_int.h
+++ b/arch/arm/plat-novatek/include/plat-na51055/rtc_int.h
@@ -40,4 +40,5 @@
 #define RTC_INT_OSC_ANALOG_CFG      RTC_INT_OSD_ANALOG_ENHANCE
 
 void nvt_rtc_power_control(int reboot_sec);
+void nvt_rtc_power_off_atomic(void);
 #endif
diff --git a/arch/arm/plat-novatek/plat-na51055/reset.c b/arch/arm/plat-novatek/plat-na51055/reset.c
index 7afb4e86e..8bbc1f0cb 100755
--- a/arch/arm/plat-novatek/plat-na51055/reset.c
+++ b/arch/arm/plat-novatek/plat-na51055/reset.c
@@ -90,7 +90,7 @@ static void nvt_power_off_done(void)
 {
 	pr_info(" Power off \n");
 #ifdef CONFIG_RTC_DRV_NA51055
-	nvt_rtc_power_control(0);
+	nvt_rtc_power_off_atomic();
 #endif
 }
 
diff --git a/drivers/rtc/rtc-na51055.c b/drivers/rtc/rtc-na51055.c
index f13175ee6..176f20f9d 100755
--- a/drivers/rtc/rtc-na51055.c
+++ b/drivers/rtc/rtc-na51055.c
@@ -260,6 +260,38 @@ void rtc_trigger_cset(void)
 	rtc_setreg(RTC_CTRL_REG_OFS, ctrl_reg.reg);
 }
 
+/*
+ * Power off from pm_power_off: interrupts are off and jiffies stand still, so
+ * nvt_rtc_power_control() would wait forever for the cset interrupt. Poll the
+ * RTC idle instead, then drop PWR_EN the same way.
+ */
+void nvt_rtc_power_off_atomic(void)
+{
+	union RTC_PWBC_REG pwbc_reg;
+	union RTC_CTRL_REG ctrl_reg;
+	int i;
+
+	for (i = 0; i < 1000; i++) {
+		ctrl_reg.reg = rtc_getreg(RTC_CTRL_REG_OFS);
+		pwbc_reg.reg = rtc_getreg(RTC_PWBC_REG_OFS);
+		if (!ctrl_reg.bit.cset && !pwbc_reg.bit.pwralarm_en &&
+		    !pwbc_reg.bit.pwralarm_dis)
+			break;
+		udelay(1000);
+	}
+
+	pwbc_reg.reg = 0x0;
+	pwbc_reg.bit.reset_sdt_timer = 1;
+	rtc_setreg(RTC_PWBC_REG_OFS, pwbc_reg.reg);
+
+	pwbc_reg.reg = 0x0;
+	pwbc_reg.bit.pwr_off = 1;
+	rtc_setreg(RTC_PWBC_REG_OFS, pwbc_reg.reg);
+
+	mdelay(1000);
+	pr_emerg("RTC power off did not take: check the 32K crystal or pad PWR_EN\n");
+}
+
 void rtc_wait_pwr_alarm_done(void)
 {
 	ulong timeout;
