# UART0 (T23 PB19 TXD / PB22 RXD, non-flow-control) -> /dev/ttyS0.
# Wired to the MCU's own debug UART (confirmed live: streams real-time
# "PIR_Interrupt" / "KEY_PRESSED" / "KEY_RELEASED" event lines whenever
# the MCU firmware detects them) -- a second, independent channel from
# the I2C control link already used by mcu_test/thingino-mcu-wdt.
# mcu_test's own I2C-based --mcu_int_flag query does not reliably
# reflect these events (confirmed live: stayed 0x0 through repeated
# confirmed PIR/button triggers across multiple reboots), so this UART
# is the only currently-known reliable on-device path to real-time PIR/
# button events. Same pin assignment as jooan_s7u_t23zn_sc2336_atbm6441
# (same T23-ISVP-Pike board family, same vendor MCU-UART convention).
CONFIG_SERIAL_JZ47XX_UART0=y
