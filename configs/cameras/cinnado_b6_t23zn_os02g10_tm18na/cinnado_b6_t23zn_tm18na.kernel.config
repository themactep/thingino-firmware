# Kernel config fragment for Cinnado B6 (T23ZN / OS02G10 / TM18NA LTE variant).
#
# This is the LTE sibling of cinnado_b6_t23zn_os02g10_atbm6461 (same board
# family: T23ZN SoC, OS02G10 sensor, "Cinnado B6" chassis/PTZ). Instead of an
# ATBM6461 WiFi/SDIO chip, this variant carries a TUGE Technologies TM18NA LTE
# module (UNISOC V8850 baseband) on USB, plus a discrete MindMotion MM32F0020B1T
# Cortex-M0 companion MCU on I2C (PIR/battery/power/watchdog housekeeping) --
# reverse-engineered from stock firmware firmware_T23ZN_20260803_2026.bin.
#
# IMPORTANT: the stock firmware disables the MCU's watchdog very early in boot
# via a dedicated recovery tool. If this is armed by default and we don't do
# the equivalent fast enough, the MCU can power-cycle the whole SoC. See
# package/thingino-mcu-wdt for the userspace side of this.

# --- USB host mode, for the TM18NA LTE module (T23 dwc2 controller) ---
# No existing Thingino board enables any CONFIG_USB option yet -- this is new
# territory for the project. drivers/usb/dwc2/dwc2_jz.c is the Ingenic glue
# driver; USB_DWC2_HOST_ONLY is the mode we want (T23 is host, TM18NA is the
# USB device/slave side per its own datasheet).
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_JZ_DWC2=y
CONFIG_USB_DWC2_HOST_ONLY=y

# --- I2C, for the MM32F0020B1T companion MCU ---
# Only I2C0 and I2C1 have a valid pinmux choice for SOC_T23 in this kernel tree
# (I2C2's only choice, I2C2_PC27_PC28, is gated on SOC_T30 and is not usable
# here). Stock firmware's normal-runtime binaries (lp_mgr, mcu_test) agree on
# bus i2c-1 for the MCU; a separate rescue-initramfs tool (disable_mcu_wdt) uses
# i2c-2, but that tool runs in a different, reduced-driver boot environment
# where bus numbering can differ -- not trusted as-is. Enabling both I2C0 and
# I2C1 here so i2cdetect can find the MCU on whichever bus Thingino's own
# driver probe order lands it on; narrow this down once confirmed on hardware.
CONFIG_I2C_V12_JZ=y
CONFIG_I2C0_V12_JZ=y
CONFIG_I2C0_PA12_PA13=y
CONFIG_I2C1_V12_JZ=y
CONFIG_I2C1_PB25_PB26=y
CONFIG_I2C_CHARDEV=y
