# Kernel config fragment for Jooan S7-U (T23ZN / ATBM6441).

# ATBM6441 driver calls warn_slowpath_fmt/warn_slowpath_null.
CONFIG_BUG=y

# print_hex_dump_bytes is compiled out when DYNAMIC_DEBUG is enabled.
# CONFIG_DYNAMIC_DEBUG is not set

CONFIG_MMC=y
CONFIG_JZMMC_V12=y

# SD card slot on MSC0 (PB bank, card detect GPIO 61 on the cmdline).
CONFIG_JZMMC_V12_MMC0=y
CONFIG_JZMMC_V12_MMC0_PB_4BIT=y
CONFIG_MMC0_MAX_FREQ=24000000

# ATBM6441 SDIO on MSC1. The board wires DAT0/DAT1 only, so 4-bit
# transfers fail with write-CRC errors; keep the PB pin group and restrict
# the bus to 1 bit.
CONFIG_JZMMC_V12_MMC1=y
CONFIG_JZMMC_V12_MMC1_PB_4BIT=y
CONFIG_JZMMC_V12_MMC1_FORCE_1BIT=y
CONFIG_MMC1_MAX_FREQ=48000000

# UART0 (T23 PB19 TXD / PB22 RXD, non-flow-control) -> /dev/ttyS0,
# wired to the ATBM6441 MCU. The pins are muxed in userspace by the
# PIR daemon; the flow-control variant is avoided because PB20/PB21 are
# PTZ tilt GPIOs.
CONFIG_SERIAL_JZ47XX_UART0=y

# FAT32 SD cards (exFAT comes from the exfat-nofuse module via BR2_THINGINO_SDCARD).
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_CODEPAGE=437
CONFIG_FAT_DEFAULT_IOCHARSET="iso8859-1"
CONFIG_NLS_ISO8859_1=y
