// Wyze Cam 4 (T41NQ, OS04D10, ATBM6062S) per-board GPIO definitions.
// Injected into the kernel 4.4+ device tree; ignored on 3.10.

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/pinctrl/ingenic-pinctrl.h>

/ {
	aliases {
		serial1 = &uart1;
	};

	chosen {
		stdout-path = "serial1:115200n8";
		bootargs = "console=ttyS1,115200 root=/dev/mtdblock4 rootfstype=squashfs init=/init mem=100M@0x0 rmem=20M@0x6400000 nmem=8M@0x7800000 panic=5";
	};

	gpio-leds {
		compatible = "gpio-leds";

		led_b {
			label = "led_b";
			gpios = <&gpb 6 GPIO_ACTIVE_LOW INGENIC_GPIO_NOBIAS>;
			default-state = "off";
		};

		led_r {
			label = "led_r";
			gpios = <&gpb 7 GPIO_ACTIVE_LOW INGENIC_GPIO_NOBIAS>;
			default-state = "off";
		};
	};
};

/* Card detect; the family tree carries the reference pin. */
&msc0 {
	ingenic,cd-gpios = <&gpb 26 GPIO_ACTIVE_LOW INGENIC_GPIO_PULLUP>;
};

/ {
	gpio-keys {
		compatible = "gpio-keys";
		label = "gpio-keys";

		reset {
			label = "reset";
			linux,code = <KEY_ENTER>;
			gpios = <&gpb 30 GPIO_ACTIVE_LOW INGENIC_GPIO_PULLUP>;
		};
	};
};

/* Fixed 16 MiB layout; the image builder and U-Boot use the same sizes. */
&sfc0 {
	#address-cells = <1>;
	#size-cells = <0>;

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <25000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "boot";
				reg = <0x0 0x40000>;
				read-only;
			};

			partition@40000 {
				label = "env";
				reg = <0x40000 0x10000>;
			};

			partition@50000 {
				label = "backup";
				reg = <0x50000 0x10000>;
			};

			partition@60000 {
				label = "kernel";
				reg = <0x60000 0x300000>;
			};

			partition@360000 {
				label = "rootfs";
				reg = <0x360000 0x600000>;
			};

			partition@960000 {
				label = "data";
				reg = <0x960000 0x6a0000>;
			};
		};
	};
};
