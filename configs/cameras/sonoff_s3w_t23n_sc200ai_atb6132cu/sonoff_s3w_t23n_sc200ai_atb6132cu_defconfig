# NAME: Sonoff S3W (T23N, SC200AI, ATBM6132CU)
# FRAG: soc-xburst1 core
BR2_INGENIC_SOC_MODEL="t23n"
BR2_ISP_CLK_220MHZ=y
BR2_PACKAGE_THINGINO_KOPT_MMC0=y
BR2_PACKAGE_THINGINO_KOPT_MMC0_PB_4BIT=y
BR2_PACKAGE_WIFI=y
BR2_PACKAGE_WIFI_ATBM6132CU=y
BR2_PACKAGE_WIFI_ATBM6132CU_6162=y
BR2_SENSOR_1_IQ_FILE="sc200ai-sonoff_s3w.bin"
BR2_SENSOR_1_NAME="sc200ai"
BR2_THINGINO_AUDIO=y
BR2_THINGINO_AUDIO_GPIO=7
BR2_THINGINO_BUTTON=y
BR2_THINGINO_LED_B_ACTIVE_LOW=true
BR2_THINGINO_LED_B_GPIO=9
BR2_THINGINO_PWM_ENABLE=y
BR2_THINGINO_SDCARD=y
FLASH_SIZE_MB=16

# The sensor answers i2c0@0x30 with chip-id 0xcb1c = SC200AI, not the SC231HAI
# (0xcb6a) this profile is named after; the stock image ships IQ for both.
# Camera name left as-is so the on-device IMAGE_ID stays OTA-compatible.
