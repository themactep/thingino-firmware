# This board has no wired Ethernet. STMMAC is built into the generic T31
# kernel config and pushes uImage past the 2688 KiB kernel partition.
# CONFIG_NET_VENDOR_STMICRO is not set
# CONFIG_STMMAC_ETH is not set

# The T31 uses the DWC2 OTG controller; the generic EHCI host driver is dead
# weight here.
# CONFIG_USB_EHCI_HCD is not set
