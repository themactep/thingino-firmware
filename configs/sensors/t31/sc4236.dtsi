/*
 * SmartSens SC4236 wiring shared by T31 boards.
 *
 * Board differences (reset/powerdown GPIOs, rail enables, a non-standard
 * bus/address/lane count) belong in the camera .dtsi as &sensor or
 * &sensor_ep overrides.
 */

#include <dt-bindings/clock/ingenic,t31-cgu.h>

/ {
	sensor_iovdd: sensor-iovdd {
		compatible = "regulator-fixed";
		regulator-name = "sensor-iovdd";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
	};

	sensor_avdd: sensor-avdd {
		compatible = "regulator-fixed";
		regulator-name = "sensor-avdd";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
		regulator-always-on;
	};

	sensor_dvdd: sensor-dvdd {
		compatible = "regulator-fixed";
		regulator-name = "sensor-dvdd";
		regulator-min-microvolt = <1200000>;
		regulator-max-microvolt = <1200000>;
		regulator-always-on;
	};
};

&i2c0 {
	sensor: camera@30 {
		compatible = "smartens,sc4236";
		reg = <0x30>;

		clocks = <&cgu T31_CLK_CIM>;
		clock-names = "xclk";
		assigned-clocks = <&cgu T31_CLK_CIM>;
		assigned-clock-rates = <24000000>;

		iovdd-supply = <&sensor_iovdd>;
		avdd-supply = <&sensor_avdd>;
		dvdd-supply = <&sensor_dvdd>;

		port {
			sensor_ep: endpoint {
				data-lanes = <1 2>;
				link-frequencies = /bits/ 64 <200000000>;
			};
		};
	};
};
