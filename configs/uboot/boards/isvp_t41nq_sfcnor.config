# DML16-Z533 (Hichip/Vanhua T41NQ) pad and USB-PHY init.
#
# The option exists in the tree but is default n and was enabled nowhere, so a
# build from a clean checkout produces a u-boot whose on-board RTL8733BU drops
# off the USB bus about two seconds after enumeration and whose SD slot never
# completes ACMD41. u-boot itself boots fine either way, which is what makes the
# omission easy to miss.
#
# Verified by disassembly: the reference binary running on the camera contains
# the pad-init writes, a build of the tree as committed does not.
CONFIG_T41_VENDOR_PAD_INIT=y

# Autoboot the way OpenIPC does it. Compared against
# OpenIPC/u-boot-gk7205v200, which is a known-working OpenIPC bootloader -
# deliberately not OpenIPC/u-boot-t41, which is unfinished and flagged
# dangerous to flash, so its choices are not evidence of anything.
#
# Goke has AUTOBOOT_KEYED off and BOOTDELAY=2: plain "hit any key to stop
# autoboot", two seconds. That is also why Ctrl-C works there - any key does.
# An earlier revision of this file used AUTOBOOT_KEYED with ENTER as a stop
# string, on the reasoning that a one second window is hard to hit. It is the
# better behaviour in isolation and it is still wrong here: the point is to
# match what an OpenIPC user already knows, and two seconds of any key is
# easier to hit than one second of the right key anyway.
# CONFIG_AUTOBOOT_KEYED is not set
CONFIG_BOOTDELAY=2
CONFIG_SYS_PROMPT="OpenIPC # "

# The environment deliberately carries no ethaddr - a shared default would put
# one MAC on every camera flashed with this image. u-boot then has no address
# at all and tftp does not run, which matters precisely when it is needed most:
# recovering a board whose environment is blank. OpenIPC ships this on for the
# same reason.
CONFIG_NET_RANDOM_ETHADDR=y

# Recovery and diagnosis over the network, which is the only route into this
# board once it is assembled.
#   TFTPPUT     - read the flash back out, so a partition can be saved before
#                 it is overwritten rather than only after it is lost
#   FS_GENERIC  - load/ls without knowing the filesystem, so an SD card can be
#                 read whether it came formatted FAT or ext
CONFIG_CMD_TFTPPUT=y
CONFIG_CMD_FS_GENERIC=y
