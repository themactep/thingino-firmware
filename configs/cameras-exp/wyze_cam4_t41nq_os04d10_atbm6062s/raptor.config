# IR-cut tuning for Wyze Cam 4 (OS04D10): this sensor's gain floors under IR,
# so the default luma trigger never sees night. Use the gain trigger with a
# high night_gain, and enable the IR-off ambient probe so the camera rechecks
# ambient light despite the LEDs staying on.
RAPTOR_IRCUT_TRIGGER="gain"
RAPTOR_IRCUT_NIGHT_GAIN="350000"
RAPTOR_IRCUT_PROBE_GAIN_PCT="95"
RAPTOR_IRCUT_PROBE_HOLDOFF_SEC="30"
RAPTOR_IRCUT_PROBE_RECHECK_SEC="120"
