# IR-cut tuning for Wyze Cam 4 (OS04D10): ric's default luma trigger with a
# night_gain above this sensor's lit-room gain, and the IR-off ambient probe
# to end the night, since IR hides ambient light from its gain.
RAPTOR_IRCUT_NIGHT_GAIN="350000"
RAPTOR_IRCUT_PROBE_GAIN_PCT="95"
RAPTOR_IRCUT_PROBE_HOLDOFF_SEC="30"
RAPTOR_IRCUT_PROBE_RECHECK_SEC="120"

# Pin spatial/temporal noise reduction to the upstream default (128) so the
# Image Quality page has values to expose on a Gen3 SoC. Runtime control goes
# through the agent settings endpoints; these pins exist so the settings
# render even before any user edit.
RAPTOR_IMAGE_SINTER="128"
RAPTOR_IMAGE_TEMPER="128"
