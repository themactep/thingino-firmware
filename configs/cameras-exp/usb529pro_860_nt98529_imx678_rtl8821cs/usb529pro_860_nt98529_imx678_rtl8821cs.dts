/dts-v1/;

/ {
	model = "Novatek NA51055";
	compatible = "novatek,na51055", "nvt,ca9";
	interrupt-parent = <0x01>;
	#address-cells = <0x01>;
	#size-cells = <0x01>;

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a9";
			reg = <0x00>;
			next-level-cache = <0x02>;
			clock-frequency = "98p";
			phandle = <0x04>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a9";
			reg = <0x01>;
			cpu-release-addr = <0xf07f8000>;
			next-level-cache = <0x02>;
			clock-frequency = "98p";
			phandle = <0x05>;
		};
	};

	cg@f0020000 {
		compatible = "nvt,core_clk";
		reg = <0xf0020000 0x1000>;
	};

	periph_clk {
		compatible = "nvt,periph_clk";
		#clock-cells = <0x00>;
		clock-output-names = "periph_clk";
		phandle = <0x03>;
	};

	global_timer@ffd00200 {
		compatible = "arm,cortex-a9-global-timer";
		reg = <0xffd00200 0x20>;
		interrupts = <0x01 0x0b 0xf01>;
		clocks = <0x03>;
	};

	private_timer@ffd00600 {
		compatible = "arm,cortex-a9-twd-timer";
		reg = <0xffd00600 0x20>;
		interrupts = <0x01 0x0d 0xf01>;
		clocks = <0x03>;
	};

	pmu {
		compatible = "arm,cortex-a9-pmu";
		interrupts = <0x00 0x70 0x04 0x00 0x71 0x04>;
		interrupt-affinity = <0x04 0x05>;
	};

	cache-controller@ffe00000 {
		compatible = "arm,pl310-cache";
		reg = <0xffe00000 0x1000>;
		interrupts = <0x00 0x60 0x04>;
		cache-unified;
		arm,shared-override;
		cache-level = <0x02>;
		arm,data-latency = <0x02 0x02 0x02>;
		arm,tag-latency = <0x02 0x02 0x02>;
		phandle = <0x02>;
	};

	interrupt-controller@0xffd00000 {
		compatible = "arm,cortex-a9-gic";
		#interrupt-cells = <0x03>;
		interrupt-controller;
		reg = <0xffd01000 0x1000 0xffd00100 0x1000>;
		phandle = <0x01>;
	};

	snoop-control-unit@0xffd00000 {
		compatible = "arm,cortex-a9-scu";
		reg = <0xffd00000 0x100>;
	};

	chosen {
		bootargs = " ";
	};

	aliases {
		mmc0 = "/mmc@f0420000";
		mmc1 = "/mmc@f0500000";
	};

	uart@f0290000 {
		compatible = "ns16550a";
		reg = <0xf0290000 0x1000>;
		interrupts = <0x00 0x2b 0x04>;
		baud = <0x1c200>;
		reg-shift = <0x02>;
		reg-io-width = <0x04>;
		no-loopback-test = <0x01>;
		clock-frequency = <0x16e3600>;
		fifo-size = <0x40>;
		uart_id = <0x00>;
	};

	uart@f0300000 {
		compatible = "ns16550a";
		reg = <0xf0300000 0x1000>;
		interrupts = <0x00 0x2c 0x04>;
		baud = <0x1c200>;
		reg-shift = <0x02>;
		reg-io-width = <0x04>;
		no-loopback-test = <0x01>;
		clock-frequency = <0x2dc6c00>;
		fifo-size = <0x40>;
		hw_flowctrl = <0x00>;
		rx_trig_level = <0x03>;
		uart_id = <0x01>;
	};

	uart@f0310000 {
		compatible = "ns16550a";
		reg = <0xf0310000 0x1000>;
		interrupts = <0x00 0x2d 0x04>;
		baud = <0x1c200>;
		reg-shift = <0x02>;
		reg-io-width = <0x04>;
		no-loopback-test = <0x01>;
		clock-frequency = <0x2dc6c00>;
		fifo-size = <0x40>;
		hw_flowctrl = <0x00>;
		rx_trig_level = <0x03>;
		uart_id = <0x02>;
	};

	uart@f0380000 {
		compatible = "ns16550a";
		reg = <0xf0380000 0x1000>;
		interrupts = <0x00 0x3f 0x04>;
		baud = <0x1c200>;
		reg-shift = <0x02>;
		reg-io-width = <0x04>;
		no-loopback-test = <0x01>;
		clock-frequency = <0x2dc6c00>;
		fifo-size = <0x40>;
		hw_flowctrl = <0x00>;
		rx_trig_level = <0x03>;
		uart_id = <0x03>;
	};

	uart@f03e0000 {
		compatible = "ns16550a";
		reg = <0xf03e0000 0x1000>;
		interrupts = <0x00 0x40 0x04>;
		baud = <0x1c200>;
		reg-shift = <0x02>;
		reg-io-width = <0x04>;
		no-loopback-test = <0x01>;
		clock-frequency = <0x2dc6c00>;
		fifo-size = <0x40>;
		hw_flowctrl = <0x00>;
		rx_trig_level = <0x03>;
		uart_id = <0x04>;
	};

	uart@f03f0000 {
		compatible = "ns16550a";
		reg = <0xf03f0000 0x1000>;
		interrupts = <0x00 0x41 0x04>;
		baud = <0x1c200>;
		reg-shift = <0x02>;
		reg-io-width = <0x04>;
		no-loopback-test = <0x01>;
		clock-frequency = <0x2dc6c00>;
		fifo-size = <0x40>;
		hw_flowctrl = <0x00>;
		rx_trig_level = <0x03>;
		uart_id = <0x05>;
	};

	cc@f0090000 {
		compatible = "kdrv_rpc";
		reg = <0xf0090000 0x300>;
		interrupts = <0x00 0x3b 0x04>;
	};

	mmc@f0420000 {
		compatible = "nvt,nvt_mmc";
		reg = <0xf0420000 0x1000>;
		interrupts = <0x00 0x1e 0x04>;
		max-frequency = <0x2dc6c00>;
		voltage-switch = <0x00>;
		max-voltage = <0xce4>;
		bus-width = <0x04>;
		neg-sample-edge = <0x00>;
		driving = <0x0a 0x0a 0x0a 0x0a 0x0a 0x0a 0x14 0x14 0x14 0x14 0x14 0x14>;
		cd_gpio = <0x78 0x00 0x00>;
	};

	mmc@f0500000 {
		compatible = "nvt,nvt_mmc2";
		reg = <0xf0500000 0x1000>;
		interrupts = <0x00 0x1f 0x04>;
		max-frequency = <0x2dc6c00>;
		voltage-switch = <0x00>;
		max-voltage = <0xce4>;
		bus-width = <0x04>;
		neg-sample-edge = <0x00>;
		driving = <0x0f 0x04 0x04 0x0f 0x04 0x04 0x0f 0x08 0x08 0x0f 0x08 0x08>;
		cd_gpio = <0x00 0x00 0x01>;
	};

	nand@f0400000 {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		compatible = "nvt,nvt_spinand";
		reg = <0xf0400000 0x1000>;
		interrupts = <0x00 0x1d 0x04>;
		clock-frequency = <0x5b8d800>;
		nvt-devname = "spi_nand.0";

		partition_loader {
			label = "loader";
			reg = <0x00 0x0 0x00 0x40000>;
			read-only;
		};

		partition_fdt {
			label = "fdt";
			reg = <0x00 0x40000 0x00 0x40000>;
		};

		partition_fdt.restore {
			label = "fdt.restore";
			reg = <0x00 0x80000 0x00 0x40000>;
		};

		partition_uboot {
			label = "uboot";
			reg = <0x00 0xc0000 0x00 0x100000>;
		};

		partition_uenv {
			label = "uenv";
			reg = <0x00 0x1c0000 0x00 0x20000>;
		};

		partition_ubi {
			label = "ubi";
			reg = <0x00 0x1e0000 0x00 0x7e20000>;
		};

		/* The loader finds U-Boot through this index (pack id -> partition) */
		nvtpack {
			ver = "NVTPACK_FW_INI_16072017";
			method = <0x01>;

			index {

				id0 {
					partition_name = "loader";
					source_file = [00];
				};

				id1 {
					partition_name = "fdt";
					source_file = "board.dtb";
				};

				id2 {
					partition_name = "fdt.restore";
					source_file = [00];
				};

				id3 {
					partition_name = "uboot";
					source_file = "u-boot.bin";
				};

				id4 {
					partition_name = "uenv";
					source_file = [00];
				};

				id5 {
					partition_name = "ubi";
					source_file = "ubi.img";
				};
			};
		};
	};

	nor@f0400000 {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		compatible = "nvt,nvt_spinor";
		reg = <0xf0400000 0x1000>;
		interrupts = <0x00 0x1d 0x04>;
		clock-frequency = <0x2dc6c00>;
		nvt-devname = "spi_nor.0";
		trace-stdtable = <0x01>;
	};

	gpio: gpio@f0070000 {
		compatible = "nvt,nvt_gpio";
		gpio-controller;
		reg = <0xf0070000 0x10000>;
		interrupts = <0x00 0x18 0x04>;
		#gpio-cells = <0x02>;
	};

	eth@f02b0000 {
		compatible = "nvt,synopsys_eth";
		reg = <0xf02b0000 0x3800>;
		interrupts = <0x00 0x22 0x04>;
		sp-clk = <0x00>;
		ref-clk-out = <0x00>;
	};

	phy@f02b3800 {
		compatible = "nvt,eth_phy";
		reg = <0xf02b3800 0x400>;
	};

	wdt@f0050000 {
		compatible = "nvt,nvt_wdt";
		reg = <0xf0050000 0x10000>;
		interrupts = <0x00 0x39 0x04>;
	};

	pwm@f0210000 {
		compatible = "nvt,nvt_kdrv_pwm";
		reg = <0xf0210000 0x2000>;
		interrupts = <0x00 0x1a 0x04>;
	};

	adc@f0260000 {
		compatible = "nvt,nvt_adc";
		reg = <0xf0260000 0x1000>;
		interrupts = <0x00 0x2f 0x04>;
		#io-channel-cells = <0x01>;
	};

	rtc@f0060000 {
		compatible = "nvt,nvt_rtc";
		reg = <0xf0060000 0x100>;
		interrupts = <0x00 0x38 0x04>;
	};

	drtc@f00b0000 {
		compatible = "nvt,nvt_drtc";
		reg = <0xf00b0000 0x100>;
	};

	crypto@f0620000 {
		compatible = "nvt,nvt_crypto";
		reg = <0xf0620000 0x100>;
		interrupts = <0x00 0x26 0x04>;
		mclk = <0x01>;
	};

	hash@f0700000 {
		compatible = "nvt,nvt_hash";
		reg = <0xf0700000 0x100>;
		interrupts = <0x00 0x1c 0x04>;
		mclk = <0x01>;
	};

	rsa@f06a0000 {
		compatible = "nvt,nvt_rsa";
		reg = <0xf06a0000 0x100>;
		interrupts = <0x00 0x14 0x04>;
		mclk = <0x01>;
	};

	top@f0010000 {
		compatible = "nvt,nvt_top";
		reg = <0xf0010000 0x2000 0xf0030000 0x2000 0xf0070000 0x10000>;

		sdio {
			pinmux = <0x01>;
		};

		sdio2 {
			pinmux = <0x01>;
		};

		sdio3 {
			pinmux = <0x00>;
		};

		nand {
			pinmux = <0x05>;
		};

		sensor {
			pinmux = <0x220>;
		};

		sensor2 {
			pinmux = <0x00>;
		};

		mipi_lvds {
			pinmux = <0xf01>;
		};

		i2c {
			pinmux = <0x41>;
		};

		sif {
			pinmux = <0x00>;
		};

		uart {
			pinmux = <0x25>;
		};

		spi {
			pinmux = <0x00>;
		};

		sdp {
			pinmux = <0x00>;
		};

		remote {
			pinmux = <0x00>;
		};

		pwm {
			pinmux = <0x00>;
		};

		pwm2 {
			pinmux = <0x00>;
		};

		ccnt {
			pinmux = <0x00>;
		};

		audio {
			pinmux = <0x00>;
		};

		lcd {
			pinmux = <0x00>;
		};

		tv {
			pinmux = <0x00>;
		};

		eth {
			pinmux = <0x12>;
		};

		misc {
			pinmux = <0x00>;
		};

		cgpio11 {
			pad_config = <0x80000000 0x4000 0x16 0x02>;
		};

		cgpio12 {
			pad_config = <0x80000004 0x4000 0x18 0x02>;
		};

		cgpio13 {
			pad_config = <0x80000008 0x4000 0x1a 0x02>;
		};

		cgpio14 {
			pad_config = <0x8000000c 0x4000 0x1c 0x02>;
		};

		cgpio15 {
			pad_config = <0x80000010 0x4000 0x1e 0x02>;
		};

		cgpio16 {
			pad_config = <0x80000014 0x4000 0x20 0x02>;
		};

		sgpio7 {
			pad_config = <0x6e 0x20000 0x6e 0x02>;
			gpio_config = <0x47 0x01>;
		};

		sgpio8 {
			pad_config = <0x70 0x20000 0x70 0x02>;
		};

		pgpio0 {
			pad_config = <0x80 0x20000 0x80 0x00>;
			gpio_config = <0x20 0x00>;
		};

		pgpio1 {
			pad_config = <0x82 0x20000 0x82 0x00>;
			gpio_config = <0x21 0x00>;
		};

		pgpio2 {
			pad_config = <0x84 0x20000 0x84 0x00>;
		};

		pgpio3 {
			pad_config = <0x86 0x20000 0x86 0x00>;
			gpio_config = <0x23 0x00>;
		};

		pgpio4 {
			pad_config = <0x88 0x20000 0x88 0x02>;
			gpio_config = <0x24 0x01>;
		};

		pgpio5 {
			pad_config = <0x8a 0x20000 0x8a 0x00>;
			gpio_config = <0x25 0x00>;
		};

		pgpio6 {
			pad_config = <0x8c 0x20000 0x8c 0x00>;
			gpio_config = <0x26 0x00>;
		};

		pgpio7 {
			pad_config = <0x8e 0x20000 0x8e 0x00>;
			gpio_config = <0x27 0x00>;
		};

		pgpio11 {
			pad_config = <0x96 0x20000 0x96 0x02>;
			gpio_config = <0x2b 0x01>;
		};

		pgpio12 {
			pad_config = <0x98 0x20000 0x98 0x00>;
			gpio_config = <0x2c 0x01>;
		};

		pgpio16 {
			pad_config = <0xa0 0x20000 0xa0 0x00>;
			gpio_config = <0x30 0x00>;
		};

		pgpio20 {
			pad_config = <0xa8 0x20000 0xa8 0x02>;
			gpio_config = <0x34 0x01>;
		};

		lgpio7 {
			pad_config = <0xee 0x20000 0xee 0x00>;
			gpio_config = <0x67 0x00>;
		};

		lgpio16 {
			pad_config = <0x100 0x20000 0x100 0x00>;
			gpio_config = <0x70 0x01>;
		};

		lgpio19 {
			pad_config = <0x106 0x20000 0x106 0x01>;
			gpio_config = <0x73 0x00>;
		};

		lgpio20 {
			pad_config = <0x108 0x20000 0x108 0x02>;
			gpio_config = <0x74 0x00>;
		};

		dgpio8 {
			pad_config = <0x10000130 0x20000 0x130 0x00>;
			gpio_config = <0x88 0x01>;
		};

		dgpio9 {
			pad_config = <0x10000132 0x20000 0x132 0x00>;
			gpio_config = <0x89 0x00>;
		};

		dgpio10 {
			pad_config = <0x10000134 0x20000 0x134 0x02>;
			gpio_config = <0x8a 0x01>;
		};

		sgpio6 {
			gpio_config = <0x46 0x01>;
		};

		lgpio1 {
			gpio_config = <0x61 0x00>;
		};

		lgpio17 {
			gpio_config = <0x71 0x00>;
		};

		pgpio19 {
			gpio_config = <0x33 0x00>;
		};
	};

	sie@f0c00000 {
		compatible = "nvt,drv_sie";
		reg = <0xf0c00000 0x900 0xf0d20000 0x900 0xf0d30000 0x900 0xf0d40000 0x900 0xf0d80000 0x900>;
		interrupts = <0x00 0x01 0x04 0x00 0x02 0x04 0x00 0x03 0x04 0x00 0x3b 0x04 0x00 0x3d 0x04>;
		power_saving = <0x00>;
	};

	tge@f0cc0000 {
		compatible = "nvt,kdrv_tge";
		reg = <0xf0cc0000 0x150>;
		interrupts = <0x00 0x16 0x04>;
	};

	rhe@f0ce0000 {
		compatible = "nvt,kdrv_rhe";
		reg = <0xf0ce0000 0x900>;
		interrupts = <0x00 0x0d 0x04>;
	};

	ime@f0c40000 {
		compatible = "nvt,kdrv_ime";
		reg = <0xf0c40000 0x1000>;
		interrupts = <0x00 0x06 0x04>;
	};

	ife2@f0d00000 {
		compatible = "nvt,kdrv_ife2";
		reg = <0xf0d00000 0x100>;
		interrupts = <0x00 0x09 0x04>;
	};

	ise@f0c90000 {
		compatible = "nvt,kdrv_ise";
		reg = <0xf0c90000 0x100>;
		interrupts = <0x00 0x15 0x04 0x00 0x55 0x04>;
	};

	ipe@f0c30000 {
		compatible = "nvt,kdrv_ipe";
		reg = <0xf0c30000 0x900>;
		interrupts = <0x00 0x05 0x04>;
	};

	ife@f0c70000 {
		compatible = "nvt,kdrv_ife";
		reg = <0xf0c70000 0x800>;
		interrupts = <0x00 0x08 0x04>;
	};

	vpe@f0cd0000 {
		compatible = "nvt,kdrv_vpe";
		reg = <0xf0cd0000 0x1040>;
		interrupts = <0x00 0x3e 0x04>;
	};

	ai_builtin@f0c60000 {
		compatible = "nvt,kdrv_ai_builtin";
		reg = <0xf0c60000 0x1cc 0xf0d50000 0x94 0xf0d60000 0x200 0xf0cb0000 0x200>;
		interrupts = <0x00 0x0e 0x04 0x00 0x0d 0x04 0x00 0x31 0x04 0x00 0x0b 0x04>;

		outstanding@0 {
			dram_number = <0x02>;

			reg0 {
				base_addr = <0xf0009100>;
			};

			reg1 {
				base_addr = <0xf0109100>;
			};

			config0 {
				osdg_config = <0x00 0x7fff>;
			};
		};
	};

	ai@f0c60000 {
		compatible = "nvt,kdrv_ai";
		reg = <0xf0c60000 0x1cc 0xf0d50000 0x94 0xf0d60000 0x200 0xf0cb0000 0x200>;
		interrupts = <0x00 0x0e 0x04 0x00 0x0d 0x04 0x00 0x31 0x04 0x00 0x0b 0x04>;

		outstanding@0 {
			dram_number = <0x02>;

			reg0 {
				base_addr = <0xf0009100>;
			};

			reg1 {
				base_addr = <0xf0109100>;
			};

			config0 {
				osdg_config = <0x00 0x7fff>;
			};
		};
	};

	md@f0c10000 {
		compatible = "nvt,kdrv_md";
		reg = <0xf0c10000 0x150>;
		interrupts = <0x00 0x2e 0x04>;
	};

	dis@f0c50000 {
		compatible = "nvt,kdrv_dis";
		reg = <0xf0c50000 0x114>;
		interrupts = <0x00 0x0a 0x04>;
	};

	coe@f0a11000 {
		compatible = "nvt,nvt_coe";
		reg = <0xf0a11000 0x2c0>;
	};

	dce@f0c20000 {
		compatible = "nvt,kdrv_dce";
		reg = <0xf0c20000 0x650>;
		interrupts = <0x00 0x07 0x04>;
	};

	ive@f0d70000 {
		compatible = "nvt,kdrv_ive";
		reg = <0xf0d70000 0x6c>;
		interrupts = <0x00 0x35 0x04>;
	};

	sde@f0d90000 {
		compatible = "nvt,kdrv_sde";
		reg = <0xf0d90000 0x90>;
		interrupts = <0x00 0x4a 0x04>;
	};

	ide@f0800000 {
		compatible = "nvt,nvt_ide";
		reg = <0xf0800000 0x1000>;
		interrupts = <0x00 0x30 0x04>;
	};

	dsi@f0840000 {
		compatible = "nvt,nvt_dsi";
		reg = <0xf0840000 0x1000>;
		interrupts = <0x00 0x32 0x04>;
	};

	csi@f0280000 {
		compatible = "nvt,nvt_csi";
		reg = <0xf0280000 0x100 0xf0330000 0x100>;
		interrupts = <0x00 0x36 0x04 0x00 0x37 0x04>;
	};

	lvds@f0270000 {
		compatible = "nvt,nvt_lvds";
		reg = <0xf0270000 0x200 0xf0370000 0x200>;
		interrupts = <0x00 0x36 0x04 0x00 0x37 0x04>;
	};

	senphy@f06b0000 {
		compatible = "nvt,nvt_senphy";
		reg = <0xf06b0000 0x100>;
	};

	ssenif@f0xx0000 {
		compatible = "nvt,nvt_ssenif";
		reg = <0xf02c0000 0x2000>;
		interrupts = <0x00 0x3d 0x04>;
	};

	sif@f0240000 {
