# NAME: Wyze Cam Pan v4 (T32NQ, SC835HAI, ATBM6162S)
# FRAG: soc-xburst1 core
BR2_INGENIC_SOC_MODEL="t32nq"
BR2_ISP_CLKA_400MHZ=y
BR2_ISP_CLKA_VPLL=y
BR2_ISP_CLKS_400MHZ=y
BR2_ISP_CLKS_VPLL=y
BR2_ISP_CLKV_400MHZ=y
BR2_ISP_CLKV_VPLL=y
BR2_ISP_CLK_225MHZ=y
BR2_ISP_CLK_MPLL=y
BR2_LINUX_KERNEL_EXT_THINGINO_KOPT=y
BR2_PACKAGE_THINGINO_KOPT_MMC0=y
BR2_PACKAGE_THINGINO_KOPT_MMC0_PB_4BIT=y
BR2_PACKAGE_THINGINO_KOPT_MMC1=y
BR2_PACKAGE_THINGINO_KOPT_MMC1_PC_4BIT=y
BR2_PACKAGE_THINGINO_KOPT_DWC2=y
BR2_PACKAGE_THINGINO_KOPT_DWC2_OTG=y
# Status LEDs. Pin/polarity record only - on PRJ007 these are INERT:
# generate_kernel_led_header.sh targets soc-<fam>/chip-<fam>/isvp/common/,
# which only exists on the older XBurst1 isvp kernels, so nothing is
# generated here. The LEDs are instantiated by the gpio-leds node in
# wyze_panv4_t32nq.dts instead. Kept so the values are recorded (and
# correct if that generator ever learns PRJ007); KOPT_LEDS is what
# actually builds the leds-gpio driver.
BR2_THINGINO_LED_R_GPIO=39
BR2_THINGINO_LED_R_ACTIVE_LOW=y
BR2_THINGINO_LED_B_GPIO=61
BR2_THINGINO_LED_B_ACTIVE_LOW=y
BR2_THINGINO_LED_W_GPIO=43
BR2_PACKAGE_THINGINO_SECUREBOOP=y
BR2_PACKAGE_THINGINO_UBOOT_FLASH_CONTROLLER_JZ_SFC=n
BR2_PACKAGE_THINGINO_UBOOT_FLASH_CONTROLLER_SFC0_NOR=y
BR2_PACKAGE_WIFI=y
BR2_PACKAGE_WIFI_ATBM6162S=y
BR2_SENSOR_1_NAME="sc835hai"
BR2_THINGINO_AUDIO=y
BR2_THINGINO_BUTTON=y
BR2_THINGINO_MOTORS=y
BR2_THINGINO_NMEM_MB=0
BR2_THINGINO_RMEM_MB=64
BR2_THINGINO_SDCARD=y
FLASH_SIZE_MB=16
KERNEL_VERSION_4=y
