# NAME: USB529Pro 860 dual dashcam, SD card boot (NT98529, IMX678, RTL8821CS)
# FRAG: soc-na51055 core-novatek
BR2_ETHERNET=y
BR2_NOVATEK_SOC_MODEL="nt98529"
BR2_PACKAGE_NOVATEK_HDAL=y
BR2_PACKAGE_NOVATEK_UBOOT=y
BR2_PACKAGE_NOVATEK_UBOOT_BOOT_SD=y
# BR2_PACKAGE_THINGINO_RAPTOR_AAC is not set
# BR2_PACKAGE_THINGINO_RAPTOR_OPUS is not set
# BR2_PACKAGE_THINGINO_RAPTOR_MP3 is not set
BR2_PACKAGE_THINGINO_KOPT_I2C_DEV=y
BR2_PACKAGE_THINGINO_KOPT_NVT_AUDIO=y
BR2_PACKAGE_THINGINO_KOPT_NVT_THERMAL=y
BR2_PACKAGE_THINGINO_RAPTOR_RSD=y
BR2_PACKAGE_THINGINO_RAPTOR_RVD=y
BR2_PACKAGE_THINGINO_STREAMER_RAPTOR=y
BR2_PACKAGE_WIFI=y
BR2_PACKAGE_WIFI_RTL8821CS=y
BR2_SENSOR_1_NAME="imx678"
BR2_SOC_VENDOR_NOVATEK=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_MKFS_OPTIONS="-O ^metadata_csum,^64bit"
BR2_TARGET_ROOTFS_EXT2_SIZE="64M"
BR2_THINGINO_BUTTON=y
BR2_THINGINO_DEV_DASHCAM=y
BR2_THINGINO_GPIO_LIST="116O"
BR2_THINGINO_TOOLCHAIN_GCC_16=y
BR2_THINGINO_TOOLCHAIN_LIBC_UCLIBC=y
BR2_THINGINO_TOOLCHAIN_TYPE_BUILDROOT=y
