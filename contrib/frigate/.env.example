# Address the authenticated web UI binds to. 0.0.0.0 exposes it on every
# interface (remote access); use 127.0.0.1 to keep it on the host only.
FRIGATE_BIND=0.0.0.0

# Host port for the authenticated web UI/API.
FRIGATE_PORT=8971

# Host ports for the go2rtc RTSP restream and WebRTC.
FRIGATE_RTSP_PORT=8554
FRIGATE_WEBRTC_PORT=8555

# Shared memory for decoded frames. Raise it for several high-res cameras.
FRIGATE_SHM_SIZE=512mb

# Thingino camera credentials. Referenced from config.yml as
# {FRIGATE_RTSP_USER} and {FRIGATE_RTSP_PASSWORD}.
FRIGATE_RTSP_USER=thingino
FRIGATE_RTSP_PASSWORD=thingino

# Container timezone.
TZ=UTC
