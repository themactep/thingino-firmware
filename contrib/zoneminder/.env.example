# Address the web UI binds to. 0.0.0.0 exposes it on every interface (remote
# access); use 127.0.0.1 to keep it on the host only.
ZM_BIND=0.0.0.0

# Host port for the ZoneMinder web UI.
ZM_PORT=8080

# Shared memory for frame buffers. Raise it for several high-res cameras.
ZM_SHM_SIZE=1g

# Container timezone.
TZ=UTC
